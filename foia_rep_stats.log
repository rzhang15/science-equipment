Non-missing cluster PIs: full=6382 foia=69

. 
. di as text ""


. di as text "cluster full_pct foia_pct"
cluster full_pct foia_pct

. forvalues c = 0/29 {
  2.     qui count if _one == 1 & cluster_30 == `c'
  3.     local n_full = r(N)
  4.     qui count if _one == 1 & cluster_30 == `c' & foia_athr == 1
  5.     local n_foia = r(N)
