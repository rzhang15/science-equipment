. * Author-level regressions for post-period cross section
. di as text "===== Author-level Δ (yr - 2013) on exposure ====="
===== Author-level Δ (yr - 2013) on exposure =====

. preserve

. keep athr_id year ppr_cnt cite_affl_wt exposure foia_athr

. reshape wide ppr_cnt cite_affl_wt, i(athr_id exposure foia_athr) j(year)
(j = 2010 2011 2012 2013 2014 2015 2016 2017 2018 2019)

Data                               Long   ->   Wide
-----------------------------------------------------------------------------
Number of observations          122,730   ->   12,273      
Number of variables                   6   ->   23          
j variable (10 values)             year   ->   (dropped)
xij variables:
                                ppr_cnt   ->   ppr_cnt2010 ppr_cnt2011 ... ppr_
> cnt2019
                           cite_affl_wt   ->   cite_affl_wt2010 cite_affl_wt201
> 1 ... cite_affl_wt2019
-----------------------------------------------------------------------------

. foreach yr in 2014 2015 2016 2017 2018 2019 {
  2.     gen dp_`yr' = ppr_cnt`yr' - ppr_cnt2013
  3.     gen dc_`yr' = cite_affl_wt`yr' - cite_affl_wt2013
  4. }

. di "----- ppr_cnt δ (should match main event study) -----"
----- ppr_cnt δ (should match main event study) -----

. foreach yr in 2014 2015 2016 2017 2018 2019 {
  2.     di "yr = `yr'"
  3.     qui reg dp_`yr' exposure, r
  4.     di "  β_ppr_" %04.0f `yr' = " " %8.4f _b[exposure] "  se = " %8.4f _se
> [exposure]
  5. }
yr = 2014
  β_ppr_2014  -0.2172  se =   0.3672
yr = 2015
  β_ppr_2015  -0.4642  se =   0.3747
yr = 2016
  β_ppr_2016  -0.1884  se =   0.3773
yr = 2017
  β_ppr_2017  -0.6728  se =   0.3844
yr = 2018
  β_ppr_2018  -0.4740  se =   0.3889
yr = 2019
  β_ppr_2019  -0.6582  se =   0.3695

. di "----- cite_affl_wt δ -----"
----- cite_affl_wt δ -----

. foreach yr in 2014 2015 2016 2017 2018 2019 {
  2.     di "yr = `yr'"
  3.     qui reg dc_`yr' exposure, r
  4.     di "  β_cite_" %04.0f `yr' = " " %8.4f _b[exposure] "  se = " %8.4f _s
> e[exposure]
  5. }
yr = 2014
  β_cite_2014  -0.3309  se =   1.2793
yr = 2015
  β_cite_2015  -1.3451  se =   1.5969
yr = 2016
