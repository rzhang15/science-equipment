. do build.do 

. set more off

. clear all

. capture log close

. program drop _all

. set scheme modern

. pause on

. set seed 8975

. set maxvar 120000


. 
. program main
  1.     herd
  2.     endowment
  3.     combine
  4. end

. 
. program herd
  1.     forval y =  2010/2013 {
  2.         import delimited using ../external/herd/herd_`y', clear
  3.         save ../temp/herd_`y', replace
  4.     }
  5.     clear
  6.     save ../temp/herd_all, replace emptyok
  7.     forval y = 2010/2013 {
  8.         append using ../temp/herd_`y', force
  9.     }
 10.     save ../temp/herd_all, replace
 11. 
.     gcontract inst_id ipeds_unitid
 12.     drop _freq
 13.     rename ipeds_unitid ipeds_id
 14.     save ../temp/ipeds_xw, replace
 15. 
.     use ../external/herd/herd_2010_2022, clear
 16.     keep if inrange(year, 2010,2013)
 17.     merge m:1 inst_id using ../temp/ipeds_xw, keep(3) nogen
 18.     collapse (mean) *fund *expend , by(ipeds_id)
 19.     save ../output/herd_pre , replace
 20. end

. 
. program endowment
  1.     * f1endmft = endowment/FTE, GASB (public); f2endmft = endowment/FTE, F
> ASB (private-nonprofit).
.     * Institutions report one or the other; coalesce into a single per-FTE en
> dowment.
.     forval y = 2010/2013 {
  2.         import delimited using ../external/ipeds/endowment_`y', clear stri
> ngcols(_all)
  3.         rename unitid ipeds_id
  4.         destring ipeds_id f1endmft f2endmft, replace force
  5.         gen endowment = f1endmft
  6.         replace endowment = f2endmft if mi(endowment) & !mi(f2endmft)
  7.         gen byte endow_src = 1 if !mi(f1endmft)
  8.         replace endow_src = 2 if mi(f1endmft) & !mi(f2endmft)
  9.         keep ipeds_id year endowment endow_src
 10.         save ../temp/endowment_`y', replace
 11.     }
 12. 
.     clear
 13.     forval y = 2010/2013 {
 14.         append using ../temp/endowment_`y', force
 15.     }
 16.     save ../temp/endowment_all, replace
 17.     gcollapse (mean) endowment (max) endow_src, by(ipeds_id)
 18.     save ../output/endowment_pre, replace
 19. end

. 
. program combine
  1.     use ../output/herd_pre, clear
  2.     merge 1:1 ipeds_id using ../output/endowment_pre, nogen
  3.     drop if mi(ipeds_id)
  4.     save ../output/combined_pre, replace
  5. end

. main
