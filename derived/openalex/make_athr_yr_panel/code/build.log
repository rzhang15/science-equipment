. program main
  1.     foreach s in all_jrnls top_jrnls all_jrnls_no_clin top_jrnls_no_clin {
  2.         local t year
  3.         *make_panel, time(`t') last(1) samp(`s') us(1)
.         *merge_ipeds, time(`t') last(1) samp(`s') us(1)
.         make_panel, time(`t') samp(`s') us(1)
  4.         merge_ipeds, time(`t') samp(`s') us(1)
  5.     }
  6. end

