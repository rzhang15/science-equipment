  3. end

. 
. * flag <var> "<cat>" ["<cat>" ...]: set <var>=1; a string matching nothing is a
. * silent no-op bug, so count matches and fail the build at the end if any are 0
. program flag
  1.     gettoken var 0 : 0
  2.     foreach c of local 0 {
  3.         quietly count if category == `"`c'"'
  4.         if r(N) == 0 {
  5.             di as error `"NO MATCH (`var'): `c'"'
  6.             global flag_nomatch = $flag_nomatch + 1
  7.         }
  8.         quietly replace `var' = 1 if category == `"`c'"'
  9.     }
 10. end

. 
. program select_good_categories
  1.     syntax, embed(string) [tier3treated]
  2.     import delimited ../external/samp/combined_full_report_gatekeeper_tfidf_expert_`embed', clear
  3.     cap rename v1 category
  4.     drop if inlist(category, "macro avg", "weighted avg", "Non-Lab", "accuracy")
  5. 
