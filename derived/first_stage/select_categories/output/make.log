317. flag bad_control "cylindrical carboys"
318. replace bad_control_reason = "unmeasurable price series: thin category (~155 purchases) pooling vessels with caps/spigots/funnels/replacement parts, plus dollar-dominant misclassification (USD 17.5k environmental chamber with carboy water-fill line)"
>  ///
>     if category == "cylindrical carboys"
319. 
. * Classification ambiguity with treated families
. flag bad_control "phosphoprotein electrophoresis reagents"
320. replace bad_control_reason = "classification uncertainty - not shock-based; specialty SDS-PAGE reagent overlapping with Tier 2 protein workflow" ///
>     if category == "phosphoprotein electrophoresis reagents"
321. flag bad_control "pipes buffers" "egta solution"
322. replace bad_control_reason = "classification ambiguity: prepared buffer solution in same family as Tier 2 process liquids (PBS/TE/HBSS/EBSS)" ///
>     if inlist(category, "pipes buffers", "egta solution")
323. flag bad_control "collagenase"
324. replace bad_control_reason = "classification ambiguity: is a cell culture dissociation reagent, a Tier 3 category (Gibco collagenase)" ///
>     if category == "collagenase"
325. 
. * Outside life-sciences consumables scope
. flag bad_control "sodium hydride"
326. replace bad_control_reason = "outside life-sciences consumables scope: synthetic-chemistry commodity, petrochemical feedstock pricing, non-life-science buyer base" ///
>     if category == "sodium hydride"
327. flag bad_control "flash chromatography columns - silica gel"
328. replace bad_control_reason = "outside life-sciences consumables scope: synthetic-chemistry product with non-life-science buyer base" ///
>     if category == "flash chromatography columns - silica gel"
329. 
. count if bad_control == 1
330. tab bad_control
331. 
. label var bad_control        "Excluded from control pool (see bad_control_reason)"
332. label var bad_control_reason "Reason category was excluded"
333. 
. *-------------------------------------------------------------------------------
. * TREATED DEFINITION AND ANALYSIS SAMPLE
. *-------------------------------------------------------------------------------
. 
. gen keep = (support >= 25 & precision >= 0.8 & recall >= 0.8)
334. 
. if "`tier3treated'" != "" {
335.     gen treated = (tier1 == 1 | tier2 == 1 | tier3 == 1)
336.     label var treated "Treated (Tiers 1-3)"
337.     local vtag all3
338. }
339. else {
340.     gen treated = (tier1 == 1 | tier2 == 1)
341.     label var treated "Treated (Tiers 1-2); tier 3 excluded from both groups"
342.     replace bad_control = 1 if tier3 == 1
343.     replace bad_control_reason = "tier 3: bundled with treated markets; excluded from control pool" ///
>         if tier3 == 1 & bad_control_reason == ""
344.     local vtag t12
345. }
346. tab treated
347. replace keep = 0 if bad_control == 1
348. gen excluded_type = cond(bad_control == 0, "", ///
>     cond(treated == 1, "excluded treated (own shock)", ///
>     cond(tier3 == 1, "tier 3 excluded from both groups", "excluded control")))
349. 
. foreach v in tier1 tier2 tier3 bad_control {
350.     quietly count if `v' == 1
351.     di "`v': " r(N) " categories"
352. }
353. if $flag_nomatch > 0 {
354.     di as error "$flag_nomatch flagged category string(s) matched nothing in the data"
355.     exit 498
356. }
357. 
. preserve
358.     keep if bad_control == 1
359.     keep category excluded_type bad_control_reason
360.     sort category
361.     export delimited using ../output/bad_control_documentation_`vtag'.csv, replace
362.     if "`vtag'" == "t12" export delimited using ../output/bad_control_documentation.csv, replace
363. restore
364. 
. save ../output/categories_`embed'_`vtag', replace
365. if "`vtag'" == "t12" save ../output/categories_`embed', replace
366. end

