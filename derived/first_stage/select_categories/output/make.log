290. flag bad_control "ldh cytotoxicity assay"
291. replace bad_control_reason = "horizontal overlap pre-merger: Pierce LDH cytotoxicity assay (Thermo) + Invitrogen/Molecular Probes cytotoxicity assay lines (Life)" ///
>     if category == "ldh cytotoxicity assay"
292. * tmb + tween temporarily left as controls: string bugs meant they were controls
. * in all original runs, so this preserves the baseline for the before/after
. * comparison. Re-flag once compared:
. *   flag bad_control "colorimetric substrates - tmb"  (Pierce TMB + Invitrogen/
. *     Novex ELISA substrates overlap; substitute for Tier 2 chemilum substrates)
. *   flag bad_control "cell lysis detergents - tween detergents"  (Pierce/
. *     Invitrogen lysis reagent overlap)
. flag bad_control "cell lysis detergents - np-40 (igepal ca-630)"
293. replace bad_control_reason = "horizontal overlap pre-merger: Pierce surfactants/lysis buffers (Thermo) + Invitrogen lysis reagents (Life)" ///
>     if category == "cell lysis detergents - np-40 (igepal ca-630)"
294. 
. * --- Substitutes for treated markets (demand spillover contaminates control) ---
. flag bad_control "human serum"
295. replace bad_control_reason = "substitute for Tier 1 FBS in cell culture; merger-induced FBS price changes shift demand" ///
>     if category == "human serum"
296. flag bad_control "centrifugation media"
297. replace bad_control_reason = "Ficoll/Percoll density-gradient cell separation substitutes for magnetic bead-based separation (Dynabeads, Life)" ///
>     if category == "centrifugation media"
298. 
. * --- US-based shocks in window ---
. flag bad_control "gene expression inducers"
299. replace bad_control_reason = "US shock: doxycycline (standard Tet-On/Off inducer) generic price spike 2013-14" ///
>     if category == "gene expression inducers"
300. flag bad_control "drug - anticoagulant"
301. replace bad_control_reason = "US shock: heparin Chinese crude API cost pressure through window; US shortage from 2017" ///
>     if category == "drug - anticoagulant"
302. flag bad_control "bacterial selection antibiotics - rifampicin"
303. replace bad_control_reason = "US shock: rifampin on FDA drug-shortage list 2013-14 and 2017" ///
>     if category == "bacterial selection antibiotics - rifampicin"
304. flag bad_control "sucrose"
305. replace bad_control_reason = "US shock: AD/CVD case vs Mexican sugar (filed Mar 2014, suspension agreements Dec 2014) + 2012 drought; also ambiguous with Tier 3 supplements-sugars" ///
>     if category == "sucrose"
306. flag bad_control "dextrose"
307. replace bad_control_reason = "US commodity shock: corn exposure, 2012 Midwest drought (parallel to ethanol); also ambiguous with Tier 3 supplements-glucose" ///
>     if category == "dextrose"
308. flag bad_control "citric acid"
309. replace bad_control_reason = "US trade shock: antidumping orders on Chinese citric acid in force through window; new AD/CVD investigations 2017, orders 2018" ///
>     if category == "citric acid"
310. flag bad_control "formic acid"
311. replace bad_control_reason = "industrial commodity priced off petrochemical feedstocks; 2014-15 oil price collapse coincides with merger" ///
>     if category == "formic acid"
312. flag bad_control "nitrogen"
313. replace bad_control_reason = "US M&A in window: Air Liquide-Airgas closed May 2016, Praxair-Linde announced 2016; prices track energy" ///
>     if category == "nitrogen"
314. flag bad_control "capillary blood collection tubes"
315. replace bad_control_reason = "US M&A in window: BD (Microtainer) dominates; BD-CareFusion closed Mar 2015 (same reason as needles/syringes)" ///
>     if category == "capillary blood collection tubes"
316. flag bad_control "crystallizing dishes"
317. replace bad_control_reason = "US M&A in window: Kimble + Wheaton + Duran merged into DWK Life Sciences 2017; Corning absorbed BD Discovery Labware Oct 2012" ///
>     if category == "crystallizing dishes"
318. 
. * --- Classification ambiguity with treated families / merged-firm dominance ---
. flag bad_control "pipes buffers" "egta solution"
319. replace bad_control_reason = "classification ambiguity: prepared buffer solution in same family as Tier 2 process liquids (PBS/TE/HBSS/EBSS)" ///
>     if inlist(category, "pipes buffers", "egta solution")
320. flag bad_control "collagenase"
321. replace bad_control_reason = "classification ambiguity: is a cell culture dissociation reagent, a Tier 3 category (Gibco collagenase)" ///
>     if category == "collagenase"
322. flag bad_control "cell culture antibiotics - blasticidin"
323. replace bad_control_reason = "Invitrogen-dominant selection antibiotic tied to Tier 3 expression plasmid/vector systems; portfolio pricing exposure" ///
>     if category == "cell culture antibiotics - blasticidin"
324. flag bad_control "cylindrical carboys"
325. replace bad_control_reason = "Nalgene (Thermo) dominates category; exposed to acquirer portfolio repricing despite no Life overlap" ///
>     if category == "cylindrical carboys"
326. 
. * --- Weaker rationale (judgment calls) ---
. flag bad_control "catalase"
327. replace bad_control_reason = "judgment call: bovine-liver-derived biologic sharing bovine supply chain with FBS/BSA" ///
>     if category == "catalase"
328. flag bad_control "sodium hydride"
329. replace bad_control_reason = "judgment call: synthetic-chemistry commodity, petrochemical feedstock pricing, non-life-science buyer base" ///
>     if category == "sodium hydride"
330. flag bad_control "dna-salmon sperm"
331. replace bad_control_reason = "judgment call: hybridization-era blocking agent in secular decline with NGS shift; nominal Invitrogen overlap" ///
>     if category == "dna-salmon sperm"
332. flag bad_control "flash chromatography columns - silica gel"
333. replace bad_control_reason = "judgment call: synthetic-chemistry product with non-life-science buyer base" ///
>     if category == "flash chromatography columns - silica gel"
334. * Version switch, placed after the named flags so specific reasons win
. if "`tier3treated'" != "" {
335.     gen treated = (tier1 == 1 | tier2 == 1 | tier3 == 1)
336.     label var treated "Treated (Tiers 1-3)"
337.     local vtag all3
338. }
339. else {
340.     gen treated = (tier1 == 1 | tier2 == 1)
341.     label var treated "Treated (Tiers 1-2); tier 3 excluded from both groups"
342.     replace bad_control = 1 if tier3 == 1
343.     replace bad_control_reason = "tier 3: bundled/undocumented overlap; excluded from control pool" ///
>         if tier3 == 1 & bad_control_reason == ""
344.     local vtag t12
345. }
346. tab treated
347. replace keep = 0 if bad_control == 1  // drop bad controls from analysis sample
348. gen excluded_type = cond(bad_control == 0, "", ///
>     cond(treated == 1, "excluded treated (own shock)", ///
>     cond(tier3 == 1, "tier 3 excluded from both groups", "excluded control")))
349. 
. foreach v in tier1 tier2 tier3 bad_control {
350.     quietly count if `v' == 1
351.     di "`v': " r(N) " categories"
352. }
353. if $flag_nomatch > 0 {
354.     di as error "$flag_nomatch flagged category string(s) matched nothing in the data"
355.     exit 498
356. }
357. 
. * --- Export bad_control documentation CSV ---
. preserve
358.     keep if bad_control == 1
359.     keep category excluded_type bad_control_reason
360.     sort category
361.     export delimited using ../output/bad_control_documentation_`vtag'.csv, replace
362.     if "`vtag'" == "t12" export delimited using ../output/bad_control_documentation.csv, replace
363. restore
364. 
. save ../output/categories_`embed'_`vtag', replace
365. if "`vtag'" == "t12" save ../output/categories_`embed', replace
366. end

. main
