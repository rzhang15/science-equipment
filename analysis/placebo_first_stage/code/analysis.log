. program main
  1.     foreach s in "" "_all3" {
  2.         global suffix `s'
  3.         indiv_did_placebo
  4.     }
  5. end

. 
. program indiv_did_placebo
  1.     // per-(iter, placebo-treated category) DiD on log_raw_price AND log_raw_spend
.     use ../external/placebo/placebo_matched_mkts$suffix, clear
  2.     qui sum iter
  3.     local n_iter = r(max)
  4. 
.     tempfile results_price results_spend pairs_i panel_i this_price this_spend
  5.     local first_iter = 1
  6. 
.     forvalues i = 1/`n_iter' {
  7.         di as text "===== iter `i' / `n_iter' ====="
  8. 
.         use ../external/placebo/placebo_matched_pairs$suffix, clear
  9.         keep if iter == `i'
 10.         save `pairs_i', replace
 11. 
.         use ../external/placebo/placebo_matched_uni_category_panel$suffix, clear
 12.         keep if iter == `i'
 13.         save `panel_i', replace
 14. 
.         use ../external/placebo/placebo_matched_mkts$suffix, clear
 15.         keep if iter == `i'
 16.         qui glevelsof category, local(categories)
 17. 
.         mat drop _all
 18.         foreach c in `categories' {
 19.             preserve
 20.             use `pairs_i', clear
 21.             qui glevelsof control_market if category == "`c'", local(match)
 22.             use `panel_i', clear
 23.             gegen uni_mkt = group(uni_id mkt)
 24.             bys uni_mkt : egen min_year = min(year)
 25.             bys uni_mkt : egen max_year = max(year)
 26.             keep if min_year < 2014 & max_year > 2014
 27.             gen post = year >= 2014
 28.             gen posttreat = treated * post
 29.             gen keep = category == "`c'"
 30.             foreach m in `match' {
 31.                 replace keep = 1 if category == "`m'"
 32.             }
 33.             keep if keep == 1
 34.             cap noi reghdfe log_raw_price posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 35.             if _rc == 0 {
 36.                 mat coef_price = nullmat(coef_price) \ (_b[posttreat], _se[posttreat])
 37.             }
 38.             else {
 39.                 mat coef_price = nullmat(coef_price) \ (., .)
 40.             }
 41.             cap noi reghdfe log_raw_spend posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 42.             if _rc == 0 {
 43.                 mat coef_spend = nullmat(coef_spend) \ (_b[posttreat], _se[posttreat])
 44.             }
 45.             else {
 46.                 mat coef_spend = nullmat(coef_spend) \ (., .)
 47.             }
 48.             restore
 49.         }
 50. 
.         // price
.         clear
 51.         svmat coef_price
 52.         rename coef_price1 b
 53.         rename coef_price2 se
 54.         gen iter = `i'
 55.         gen category = ""
 56.         local counter = 1
 57.         foreach m in `categories' {
 58.             replace category = "`m'" if _n == `counter'
 59.             local counter = `counter' + 1
 60.         }
 61.         keep iter category b se
 62.         drop if mi(b)
 63.         save `this_price', replace
 64. 
.         // spend
.         clear
 65.         svmat coef_spend
 66.         rename coef_spend1 b
 67.         rename coef_spend2 se
 68.         gen iter = `i'
 69.         gen category = ""
 70.         local counter = 1
 71.         foreach m in `categories' {
 72.             replace category = "`m'" if _n == `counter'
 73.             local counter = `counter' + 1
 74.         }
 75.         keep iter category b se
 76.         drop if mi(b)
 77.         save `this_spend', replace
 78. 
.         if `first_iter' == 1 {
 79.             use `this_price', clear
 80.             save `results_price', replace
 81.             use `this_spend', clear
 82.             save `results_spend', replace
 83.             local first_iter = 0
 84.         }
 85.         else {
 86.             use `results_price', clear
 87.             append using `this_price'
 88.             save `results_price', replace
 89.             use `results_spend', clear
 90.             append using `this_spend'
 91.             save `results_spend', replace
 92.         }
 93.     }
 94. 
.     // spend_2013 lookup -- category-level constant, dedupe across iters
.     preserve
 95.     use ../external/placebo/placebo_matched_category_panel$suffix, clear
 96.     keep if treated == 1
 97.     gcontract category spend_2013
 98.     drop _freq
 99.     duplicates drop category, force
100.     tempfile placebo_spend_xw
101.     save `placebo_spend_xw'
102.     restore
103. 
.     make_placebo_plots, results(`results_price') xw(`placebo_spend_xw') ///
>         outcome("price") ylabel("Placebo DiD coefficient (log price)") suf("")
104.     make_placebo_plots, results(`results_spend') xw(`placebo_spend_xw') ///
>         outcome("spend") ylabel("Placebo DiD coefficient (log spend)") suf("_spend")
105. end

. 
. program make_placebo_plots
  1.     syntax, results(str) xw(str) outcome(str) ylabel(str) [suf(str)]
  2. 
.     use `results', clear
  3.     merge m:1 category using `xw', keep(1 3) nogen
  4. 
.     gen lb = b - 1.96*se
  5.     gen ub = b + 1.96*se
  6.     save ../output/did_coefs_placebo`suf'$suffix, replace
  7. 
.     qui sum iter
  8.     local n_iter = r(max)
  9. 
.     // rank of coef within each iter (1 = highest b); label top categories per iter
.     preserve
 10.     gsort iter -b
 11.     by iter: gen coef_rank = _n
 12.     gen toplab = category if coef_rank <= 3
 13.     tw scatter b iter, msize(vsmall) mcolor(gs10) ///
>        || scatter b iter if coef_rank <= 3, msize(small) mcolor(cranberry) ///
>             mlabel(toplab) mlabsize(tiny) mlabcolor(cranberry) mlabposition(3) ///
>        yline(0, lcolor(gs6) lpattern(dash)) ///
>        ytitle("`ylabel'") ///
>        xtitle("Iteration") ///
>        xlab(1(1)`n_iter') ///
>        legend(off)
 14.     graph export ../output/figures/did_coefs_placebo`suf'_top_cats$suffix.pdf, replace
 15.     restore
 16. 
.     // coef-rank profile: x = within-iter rank, y = b, one line per iter
.     preserve
 17.     gsort iter -b
 18.     by iter: gen coef_rank = _n
 19.     tw line b coef_rank, by(iter, note("") legend(off)) ///
>        ytitle("`ylabel'") ///
>        xtitle("Within-iter rank (1 = highest)") ///
>        yline(0, lcolor(gs6) lpattern(dash))
 20.     graph export ../output/figures/did_coefs_placebo`suf'_rank_profile$suffix.pdf, replace
 21.     restore
 22. 
.     // distribution of point estimates across all (iter, market) pairs
.     sum b, d
 23.     local N    = r(N)
 24.     local mean : di %6.3f r(mean)
 25.     local sd   : di %6.3f r(sd)
 26.     local p25  : di %6.3f r(p25)
 27.     local p50  : di %6.3f r(p50)
 28.     local p75  : di %6.3f r(p75)
 29.     local minv : di %6.3f r(min)
 30.     local maxv : di %6.3f r(max)
 31. 
.     tw hist b, freq bin(40) color(lavender%70) ///
>         xtitle("`ylabel'") ///
>         ytitle("# of (iter, market) pairs") ///
>         xline(0, lcolor(gs6) lpattern(dash)) ///
>         legend(on order(- "N = `N'" "iters = `n_iter'" "mean = `mean'" "sd = `sd'" ///
>                           "p25 = `p25'" "p50 = `p50'" "p75 = `p75'" ///
>                           "min = `minv'" "max = `maxv'") ///
>                pos(1) ring(0) region(fcolor(none)) size(small))
 32.     graph export ../output/figures/did_coefs_placebo`suf'_hist$suffix.pdf, replace
 33. 
.     tw kdensity b, color(lavender) ///
>         xtitle("`ylabel'") ///
>         ytitle("Density") ///
>         xline(0, lcolor(gs6) lpattern(dash)) ///
>         legend(on order(- "N = `N'" "iters = `n_iter'" "mean = `mean'" "sd = `sd'") ///
>                pos(1) ring(0) region(fcolor(none)) size(small))
 34.     graph export ../output/figures/did_coefs_placebo`suf'_kdens$suffix.pdf, replace
 35. 
.     // per-iter mean coefficient (one point per placebo replication)
.     preserve
 36.     gcollapse (mean) b_mean = b (sd) b_sd = b (count) n_cats = b, by(iter)
 37.     gen lb = b_mean - 1.96*b_sd/sqrt(n_cats)
 38.     gen ub = b_mean + 1.96*b_sd/sqrt(n_cats)
 39.     hashsort b_mean
 40.     gen rank = _n
 41.     count
 42.     local nr = r(N)
 43.     tw rcap ub lb rank, msize(vsmall) || ///
>        scatter b_mean rank, msize(small) mcolor(lavender) ///
>        yline(0) ytitle("Mean `ylabel' (per iter)") ///
>        xlab(1(1)`nr') xtitle("Placebo iteration (ranked)") ///
>        legend(off)
 44.     graph export ../output/figures/did_coefs_placebo`suf'_by_iter$suffix.pdf, replace
 45.     restore
 46. end

. 
