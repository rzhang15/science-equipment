. program raw_plots
  1.     use ../external/samp/full_category_yr_tfidf$suffix, clear
  2.     gen tot_qty = raw_qty
  3.     gen tot_spend = raw_spend
  4.     replace treated = 2 if keep == 0 & treated == 1
  5.     replace treated = 3 if keep == 0 & treated == 0
  6.     collapse (mean) avg_raw_price = raw_price item_price avg_log_price raw_qty log_raw_qty avg_raw_qty = raw_qty raw_spend log_raw_spend avg_raw_spend = raw_spend (sum) tot_spend tot_qty [aw = spend_2013], by(year treated)
  7.     gen tot_price = tot_spend/tot_qty
  8.     gen log_tot_price = ln(tot_price)
  9.     gen log_tot_spend = ln(tot_spend)
 10.     gen log_tot_qty = ln(tot_qty)
 11. 
.     foreach var in avg_raw_price item_price avg_log_price tot_price log_tot_price raw_qty log_raw_qty avg_raw_qty tot_qty log_tot_qty raw_spend log_raw_spend avg_raw_spend tot_spend log_tot_spend {
 12.         gen trt_`var' = `var' if treated == 1
 13.         gen ctrl_`var' = `var' if treated == 0
 14.         gen othr_trt_`var' = `var' if treated == 2
 15.         gen othr_ctrl_`var' = `var' if treated == 3
 16.     }
 17.     foreach var in avg_log_price log_raw_qty log_raw_spend avg_raw_price raw_qty raw_spend log_tot_price log_tot_qty log_tot_spend { //avg_log_price item_price log_raw_price tot_price log_tot_price raw_qty log_raw_qty avg_log_qty tot_qty log_tot_qty 
> raw_spend log_raw_spend avg_log_spend tot_spend log_tot_spend {
 18.         if strpos("`var'", "price") > 0 {
 19.             local yname "Price"
 20.         }   
 21.         if strpos("`var'", "qty") > 0 {
 22.             local yname "Qty"
 23.         }   
 24.         if strpos("`var'", "spend") > 0 {
 25.             local yname "Spend"
 26.         }   
 27.         if strpos("`var'", "log") > 0 {
 28.             local yname = "Log " + "`yname'"
 29.         }
 30.         local yname = "Avg. " + "`yname'"
 31.         qui sum trt_`var' if year == 2013 
 32.         qui replace trt_`var' = trt_`var' - r(mean)
 33.         qui sum ctrl_`var' if year == 2013 
 34.         qui replace ctrl_`var' = ctrl_`var' - r(mean)
 35.         qui sum othr_trt_`var' if year == 2013 
 36.         qui replace othr_trt_`var' = othr_trt_`var' - r(mean)
 37.         qui sum othr_ctrl_`var' if year == 2013 
 38.         qui replace othr_ctrl_`var' = othr_ctrl_`var' - r(mean)
 39.         qui tw connected trt_`var' year , lcolor(lavender) mcolor(lavender) || connected ctrl_`var' year , lcolor(dkorange) mcolor(dkorange) ///
>           || connected othr_trt_`var' year, lcolor(lavender%40) mcolor(lavender%20) lpattern(dash) || ///
>           connected othr_ctrl_`var' year, lcolor(dkorange%40) mcolor(dkorange%20) lpattern(dash) legend(on label(1 "Treated") label(2 "Control") label(3 "Bad ML Treated") label(4 "Bad ML Control") ring(1) pos(6) rows(1) size(small)) ytitle("`yname'", si
> ze(small)) yline(0, lcolor(gs10) lpattern(solid)) ylabel(#6, labsize(small)) xlabel(2010(1)2019, labsize(small)) xtitle("Year", size(small)) tline(2013.5, lpattern(shortdash) lcolor(gs4%80)) 
 40.         qui graph export "../output/figures/raw/`var'_trends_pooled$suffix.pdf", replace
 41.     }
 42.     use ../external/merged/matched_mkts$suffix, clear
 43.     qui glevelsof category, local(categories)
 44.     foreach c in `categories' {
 45.         preserve
 46.         use ../external/merged/matched_pairs$suffix, clear 
 47.         local del_hhi
 48.         local sim_hhi
 49.         qui glevelsof control_market if category == "`c'", local(match) 
 50.         use ../external/merged/matched_category_panel$suffix, clear
 51.         gen keep = 1 if category == "`c'" 
 52.         qui glevelsof delta_hhi if category == "`c'", local(del_hhi) 
 53.         local del_hhi = round(`del_hhi', 0.001)
 54.         qui glevelsof simulated_hhi if category == "`c'", local(sim_hhi) 
 55.         local sim_hhi = round(`sim_hhi', 0.001)
 56.         local match_name ""
 57.         foreach  m in `match' {
 58.             replace keep = 1 if category == "`m'"
 59.             local match_name = "`match_name'" + ", " + strproper("`m'")
 60.         }
 61.         qui keep if keep == 1 
 62.         local name = strproper("`c'")
 63.         gen tot_qty = raw_qty
 64.         gen tot_spend = raw_spend
 65.         collapse (mean) avg_log_price item_price raw_qty log_raw_qty avg_log_qty raw_spend log_raw_spend avg_log_spend (sum) tot_spend tot_qty [aw=spend_2013], by(year treated)
 66.         gen tot_price = tot_spend/tot_qty
 67.         gen log_tot_price = ln(tot_price)
 68.         gen log_tot_spend = ln(tot_spend)
 69.         gen log_tot_qty = ln(tot_qty)
 70.         foreach var in log_tot_price log_tot_spend log_tot_qty { //avg_log_price item_price log_raw_price tot_price log_tot_price raw_qty log_raw_qty avg_log_qty tot_qty log_tot_qty raw_spend log_raw_spend avg_log_spend tot_spend log_tot_spend { 
 71.             gen trt_`var' = `var' if treated == 1
 72.             gen ctrl_`var' = `var' if treated == 0
 73.         }
 74.         foreach var in log_tot_price log_tot_qty log_tot_spend { // avg_log_price item_price log_raw_price tot_price log_tot_price raw_qty log_raw_qty avg_log_qty tot_qty log_tot_qty raw_spend log_raw_spend avg_log_spend tot_spend log_tot_spend { 
 75.             if strpos("`var'", "price") > 0 {
 76.                 local yname "Price"
 77.             }   
 78.             if strpos("`var'", "qty") > 0 {
 79.                 local yname "Qty"
 80.             }   
 81.             if strpos("`var'", "spend") > 0 {
 82.                 local yname "Spend"
 83.             }   
 84.             if strpos("`var'", "log") > 0 {
 85.                 local yname = "Log " + "`yname'"
 86.             }
 87.             local yname = "Avg. " + "`yname'"
 88.             qui sum trt_`var' if year == 2013 
 89.             qui replace trt_`var' = trt_`var' - r(mean)
 90.             qui sum ctrl_`var' if year == 2013 
 91.             qui replace ctrl_`var' = ctrl_`var' - r(mean)
 92.             qui tw connected trt_`var' year , lcolor(lavender) mcolor(lavender) || connected ctrl_`var' year , lcolor(dkorange%40) mcolor(dkorange%40) legend(on label(1 "Treated: `name'") label(2 "Control: `match_name'") ring(1) pos(6) rows(1) size(s
> mall)) ytitle("`yname'", size(small)) yline(0, lcolor(gs10) lpattern(solid)) ylabel(#6, labsize(small)) xlabel(2010(1)2019, labsize(small)) xtitle("Year", size(small)) tline(2013.5, lpattern(shortdash) lcolor(gs4%80)) title("Simulated HHI: `sim_hhi'; De
> lta HHI: `del_hhi'", size(small))
 93.             qui graph export "../output/figures/raw/`var'_trends_category`c'$suffix.pdf", replace
 94.         }
 95.         restore
 96.     }
 97. end

