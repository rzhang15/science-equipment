. program did
  1.     cap mat drop coef_price coef_spend
  2.     use ../external/samp/uni_category_yr_tfidf$suffix, clear
  3.     gegen uni_mkt = group(uni_id mkt)
  4.     bys uni_mkt : egen min_year = min(year)
  5.     bys uni_mkt : egen max_year = max(year)
  6.     keep if min_year < 2014 & max_year > 2014
  7.     gen post = 0 
  8.     replace post = 1 if year >= 2014
  9.     gen posttreat = treated * post
 10.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 11.         di "`name'"
 12.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 13.     }
 14. 
.     use ../external/merged/matched_uni_category_panel$suffix, clear
 15.     gegen uni_mkt = group(uni_id mkt)
 16.     bys uni_mkt : egen min_year = min(year)
 17.     bys uni_mkt : egen max_year = max(year)
 18.     keep if min_year < 2014 & max_year > 2014
 19.     gen post = 0
 20.     replace post = 1 if year >= 2014
 21.     gen posttreat = treated * post
 22.     foreach var in avg_log_price log_raw_qty log_raw_spend{
 23.         di "`name'"
 24.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 25.     }
 26.     use ../external/merged/matched_category_panel$suffix, clear
 27.     gen post = 0
 28.     replace post = 1 if year >= 2014
 29.     gen posttreat = treated * post
 30.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 31.         di "`name'"
 32.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(year mkt)
 33.     }
 34.     use ../external/merged/matched_mkts$suffix, clear
 35.     qui glevelsof category, local(categories)
 36.     foreach c in `categories' {
 37.         preserve
 38.         use ../external/merged/matched_pairs$suffix, clear
 39.         qui glevelsof control_market if category == "`c'", local(match)
 40.         use ../external/merged/matched_uni_category_panel$suffix, clear
 41.         gegen uni_mkt = group(uni_id mkt)
 42.         bys uni_mkt : egen min_year = min(year)
 43.         bys uni_mkt : egen max_year = max(year)
 44.         keep if min_year < 2014 & max_year > 2014
 45.         gen post = 0
 46.         replace post = 1 if year >= 2014
 47.         gen posttreat = treated * post
 48.         gen keep = 1 if category == "`c'"
 49.         foreach  m in `match' {
 50.             replace keep = 1 if category == "`m'"
 51.         }
 52.         keep if keep == 1
 53.         glevelsof category if treated == 1, local(name)
 54.         local name = strproper(`name')
 55.         di "`name'"
 56.         cap noi reghdfe avg_log_price posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 57.         if _rc == 0 {
 58.             mat coef_price = nullmat(coef_price) \ (_b[posttreat], _se[posttreat])
 59.         }
 60.         else {
 61.             mat coef_price = nullmat(coef_price) \ (., .)
 62.         }
 63.         cap noi reghdfe log_raw_spend posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 64.         if _rc == 0 {
 65.             mat coef_spend = nullmat(coef_spend) \ (_b[posttreat], _se[posttreat])
 66.         }
 67.         else {
 68.             mat coef_spend = nullmat(coef_spend) \ (., .)
 69.         }
 70.         restore
 71.     }
 72. 
.     tempfile coefs_price coefs_spend
 73.     foreach yvar in price spend {
 74.         clear
 75.         svmat coef_`yvar'
 76.         rename coef_`yvar'1 b
 77.         rename coef_`yvar'2 se
 78.         gen category = ""
 79.         local counter = 1
 80.         foreach m in `categories' {
 81.             replace category = "`m'" if _n == `counter'
 82.             local counter = `counter' + 1
 83.         }
 84.         drop if mi(b)
 85.         save `coefs_`yvar'', replace
 86.     }
 87. 
.     process_coefs, infile(`coefs_price') outcome("price")
 88.     process_coefs, infile(`coefs_spend') outcome("spend")
 89. end

