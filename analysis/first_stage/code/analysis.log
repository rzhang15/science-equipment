. program main
  1.     foreach s in "_all3" {
  2.         global suffix `s'
  3.         *raw_plots
.         did
  4.         robustness
  5.         balance_check
  6.         placebo_timing
  7.         robustness_coefplot
  8.         output_tables
  9.         event_study
 10.         *uni_fes
.     }
 11. end

