. program process_coefs
  1.     syntax, infile(str) outcome(str)
  2. 
.     use `infile', clear
  3.     merge m:1 category using ../external/samp/category_hhi_tfidf$suffix, assert(1 2 3) keep(3) nogen
  4. *    drop if delta_hhi <= -2500
.     merge m:1 category using ../external/merged/spend_xw$suffix, assert(2 3) keep(3) nogen
  5.     gen lb = b - 1.96*se
  6.     gen ub = b + 1.96*se
  7.     hashsort b
  8.     save ../output/did_coefs_`outcome'$suffix, replace
  9. 
.     sum b, d
 10.     local N    = r(N)
 11.     local mean = round(r(mean), 0.001)
 12.     local sd   = round(r(sd), 0.001)
 13.     tw kdensity b, color(lavender) ///
>         xtitle("DiD Coefficient (log `outcome')", size(small)) ///
>         ytitle("Density", size(small)) ///
>         xlab(, labsize(small)) ylab(, labsize(small)) ///
>         xline(0, lcolor(gs6) lpattern(dash)) ///
>         legend(on order(- "N = `N'" "mean = `mean'" "sd = `sd'") ///
>                pos(1) ring(0) region(fcolor(none)))
 14.     graph export ../output/figures/did_coefs_kdens_`outcome'$suffix.pdf, replace
 15.     gen rank = _n
 16.     labmask rank, values(category)
 17.     count
 18.     local n = r(N)
 19.     tw rcap ub lb rank, msize(vsmall) || scatter b rank, msize(tiny) mcolor(lavender) yline(0) ylab(-1(0.2)1, labsize(small)) ysc(titlegap(-6) outergap(0)) ytitle("DiD Estimate (log `outcome') + 95% CI", size(small)) xlab(1(1)`n', angle(45) labsize(s
> mall) valuelabel) graphregion(margin(b+35 l+5)) xtitle("") legend(off)
 20.     graph export ../output/figures/coef_rank_`outcome'$suffix.pdf, replace
 21.     hashsort spend_2013
 22.     gen rank_spend = _n
 23.     labmask rank_spend, values(category)
 24.     count
 25.     local n = r(N)
 26.     tw rcap ub lb rank_spend, msize(vsmall) || scatter b rank_spend, msize(tiny) mcolor(lavender) yline(0) ylab(-1(0.2)1, labsize(small)) ysc(titlegap(-6) outergap(0)) ytitle("DiD Estimate (log `outcome') + 95% CI", size(small)) xlab(1(1)`n', angle(4
> 5) labsize(small) valuelabel) graphregion(margin(b+35 l+5)) xtitle("") legend(off)
 27.     graph export ../output/figures/coef_spend_rank_`outcome'$suffix.pdf, replace
 28.     corr b delta_hhi [aw=spend_2013]
 29.     local corr : di %4.3f r(rho)
 30.     binscatter2 b delta_hhi [aw = spend_2013], mcolors(gs6) lcolors(ebblue) legend(on order(- "corr: `corr'") ring(0) pos(1)) xtitle("Delta HHI") ytitle("Estimated Coefficient (log `outcome')")
 31.     graph export ../output/figures/delta_hhi_corr_`outcome'$suffix.pdf, replace
 32.     corr b simulated_hhi [aw=spend_2013]
 33.     local corr : di %4.3f r(rho)
 34.     binscatter2 b simulated_hhi [aw = spend_2013], mcolors(gs6) lcolors(ebblue) legend(on order(- "corr: `corr'") ring(0) pos(1)) xtitle("Simulated HHI") ytitle("Estimated Coefficient (log `outcome')")
 35.     graph export ../output/figures/sim_hhi_corr_`outcome'$suffix.pdf, replace
 36. 
.     gen var_se = se^2
 37.     qui sum var_se
 38.     local mean_var2 = r(mean)
 39.     qui sum b
 40.     local sample_var = r(Var)
 41.     local tau2 = max(0, `sample_var' - `mean_var2')
 42.     qui sum b [aw = 1/var_se]
 43.     local mu_hat = r(mean)
 44.     di "EB shrinkage (`outcome'): mu_hat = `mu_hat', tau2 = `tau2', sample_var(b) = `sample_var', mean(se^2) = `mean_var2'"
 45.     gen w_eb  = `tau2' / (`tau2' + var_se)
 46.     gen b_eb  = w_eb * b + (1 - w_eb) * `mu_hat'
 47.     gen se_eb = sqrt(w_eb * var_se)
 48.     gen lb_eb = b_eb - 1.96 * se_eb
 49.     gen ub_eb = b_eb + 1.96 * se_eb
 50.     drop var_se
 51.     save ../output/did_coefs_eb_`outcome'$suffix, replace
 52. 
.     qui sum b_eb, d
 53.     local N_eb    = r(N)
 54.     local mean_eb = round(r(mean), 0.001)
 55.     local sd_eb   = round(r(sd), 0.001)
 56.     qui sum b, d
 57.     local sd_raw  = round(r(sd), 0.001)
 58.     local tau2_lab = round(`tau2', 0.001)
 59.     local mu_lab   = round(`mu_hat', 0.001)
 60.     tw kdensity b_eb, color(lavender) ///
>         xtitle("DiD Coefficient (log `outcome', EB-shrunk)", size(small)) ///
>         ytitle("Density", size(small)) ///
>         xlab(, labsize(small)) ylab(, labsize(small)) ///
>         xline(0, lcolor(gs6) lpattern(dash)) ///
>         legend(on order(- "N = `N_eb'" "mean = `mean_eb'" "sd = `sd_eb'" ///
>                         "raw sd = `sd_raw'" "tau2 = `tau2_lab'" "mu_hat = `mu_lab'") ///
>                pos(1) ring(0) region(fcolor(none)))
 61.     graph export ../output/figures/did_coefs_kdens_eb_`outcome'$suffix.pdf, replace
 62. 
.     tw kdensity b, color(gs10%70) lpattern(dash) || ///
>        kdensity b_eb, color(lavender) ///
>         xtitle("DiD Coefficient (log `outcome')", size(small)) ytitle("Density", size(small)) ///
>         xlab(, labsize(small)) ylab(, labsize(small)) ///
>         xline(0, lcolor(gs6) lpattern(dash)) ///
>         legend(on order(1 "Raw (sd=`sd_raw')" 2 "EB-shrunk (sd=`sd_eb')") ///
>                ring(0) pos(1) region(fcolor(none)))
 63.     graph export ../output/figures/did_coefs_kdens_overlay_`outcome'$suffix.pdf, replace
 64. 
.     drop rank
 65.     hashsort b_eb
 66.     gen rank = _n
 67.     labmask rank, values(category)
 68.     count
 69.     local n = r(N)
 70.     tw rcap ub_eb lb_eb rank, msize(vsmall) || ///
>        scatter b_eb rank, msize(tiny) mcolor(lavender) ///
>        yline(0) ylab(-1(0.2)1, labsize(small)) ysc(titlegap(-6) outergap(0)) ///
>        ytitle("EB DiD Estimate (log `outcome') + 95% CI", size(small)) ///
>        xlab(1(1)`n', angle(45) labsize(small) valuelabel) ///
>        graphregion(margin(b+35 l+5)) xtitle("") legend(off)
 71.     graph export ../output/figures/coef_rank_eb_`outcome'$suffix.pdf, replace
 72. 
.     drop rank_spend
 73.     hashsort spend_2013
 74.     gen rank_spend = _n
 75.     labmask rank_spend, values(category)
 76.     count
 77.     local n = r(N)
 78.     tw rcap ub_eb lb_eb rank_spend, msize(vsmall) || ///
>        scatter b_eb rank_spend, msize(tiny) mcolor(lavender) ///
>        yline(0) ylab(-1(0.2)1, labsize(small)) ysc(titlegap(-6) outergap(0)) ///
>        ytitle("EB DiD Estimate (log `outcome') + 95% CI", size(small)) ///
>        xlab(1(1)`n', angle(45) labsize(small) valuelabel) ///
>        graphregion(margin(b+35 l+5)) xtitle("") legend(off)
 79.     graph export ../output/figures/coef_spend_rank_eb_`outcome'$suffix.pdf, replace
 80. 
.     corr b_eb delta_hhi [aw=spend_2013]
 81.     local corr_eb : di %4.3f r(rho)
 82.     tw scatter b_eb delta_hhi [aw = spend_2013], ///
>         legend(on order(- "corr: `corr_eb'") ring(0) pos(1)) ///
>         xtitle("Delta HHI") ytitle("EB DiD Coefficient (log `outcome')")
 83.     graph export ../output/figures/delta_hhi_corr_eb_`outcome'$suffix.pdf, replace
 84. 
.     corr b_eb simulated_hhi [aw=spend_2013]
 85.     local corr_eb : di %4.3f r(rho)
 86.     binscatter2 b_eb simulated_hhi [aw = spend_2013], mcolors(gs6) lcolors(ebblue) legend(on order(- "corr: `corr_eb'") ring(0) pos(1)) xtitle("Simulated HHI") ytitle("EB DiD Coefficient (log `outcome')")
 87.     graph export ../output/figures/sim_hhi_corr_eb_`outcome'$suffix.pdf, replace
 88. end

