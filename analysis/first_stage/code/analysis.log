. program manual_event_study
  1.     syntax, lag(int) lead(int) yvar(str) ymin(real) ymax(real) ygap(real) trt_mean(real) ctrl_mean(real) name(str) fes(str) wt_var(str) cluster_var(str) [unwt(real 0)balance(real 0) file_suf(str) title(str)]
  2.     cap drop lag* lead* year_fes*
  3.     local suf ""
  4.     if `balance' == 1 local suf "bal_" 
  5.         keep if inrange(rel,`lead',`lag') | rel ==. 
  6.     assert `lag' > 0 & `lead' < 0
  7.     local abs_lag = abs(`lag')
  8.     local abs_lead = abs(`lead')
  9.     local timeframe = max(`abs_lag', `abs_lead')
 10.     forval i = 1/`timeframe' {
 11.         gen lag`i' = 1 if rel == `i'
 12.         gen lead`i' = 1 if rel == -`i'
 13.     }
 14.     gen lag0 = 1 if rel == 0
 15.     ds lead* lag*
 16.     foreach var in `r(varlist)' {
 17.         replace `var' = 0 if mi(`var')
 18.     }
 19.     local leads
 20.     local lags
 21.     forval i = 2/`abs_lead' {
 22.         local leads lead`i' `leads'
 23.     }
 24.     forval i = 0/`abs_lag' {
 25.         local lags `lags' lag`i'
 26.     }
 27.     forval i = 2010/2019 {
 28.         gen year_fes`i' = 1 if year == `i'
 29.     }
 30.     ds year_fes*
 31.     foreach var in `r(varlist)' {
 32.         replace `var' = 0 if mi(`var')
 33.     }
 34.     local years
 35.     forval i = 2010/2012 {
 36.         local years `years' year_fes`i'
 37.     }
 38.     forval i = 2014/2019 {
 39.         local years `years' year_fes`i'
 40.     }
 41.     preserve
 42.     mat drop _all 
 43.     if `unwt' == 1 {
 44.         reghdfe `yvar' `leads' `lags' lead1 `years' year_fes2013 , absorb(`fes') vce(cluster `cluster_var')
 45.     }
 46.     if `unwt' == 0{
 47.         reghdfe `yvar' `leads' `lags' lead1 `years' year_fes2013  [aw = `wt_var'], absorb(`fes') vce(cluster `cluster_var')
 48.     }
 49.     foreach var in `leads' `lags' lead1 {
 50.         mat row = _b[`var'], _se[`var']
 51.         if "`var'" == "lead1" {
 52.             mat row = 0,0
 53.         }
 54.         mat es = nullmat(es) \ row
 55.     }
 56.     foreach var in `years' year_fes2013 {
 57.         mat year_fes_row = _b[`var'], _se[`var']
 58.         if "`var'" == "year_fes2013" {
 59.             mat year_fes_row = 0,0
 60.         }
 61.         mat year_fes = nullmat(year_fes) \ year_fes_row
 62.     }
 63.     forval i =  2010/2012 {
 64.         local j = 2014-`i'
 65.         lincom year_fes`i' +  lead`j'
 66.         mat trt_coef_row = r(estimate), r(se)
 67.         mat trt_coef = nullmat(trt_coef) \ trt_coef_row
 68.     }
 69.     forval i = 2014/2019 {
 70.         local j = `i' - 2014
 71.         lincom year_fes`i' +  lag`j'
 72.         mat trt_coef_row = r(estimate), r(se)
 73.         mat trt_coef = nullmat(trt_coef) \ trt_coef_row
 74.     } 
 75.     mat trt_coef = trt_coef \ 0,0
 76.     mat es = es , year_fes, trt_coef
 77.     svmat es
 78.     keep es1 es2 es3 es4 es5 es6 
 79.     drop if mi(es1)
 80.     rename (es1 es2 es3 es4 es5 es6) (b se year_fes year_fes_se trt_coef trt_coef_se)
 81.     gen ub = b + 1.96*se
 82.     gen lb = b - 1.96*se
 83.     gen rel = `lead' if _n == 1
 84.     replace rel = rel[_n-1]+1 if _n > 1
 85.     replace rel = rel + 1 if rel >= -1 
 86.     replace rel = -1 if rel == `abs_lag' + 1
 87.     gen upper = `ymax'
 88.     gen year = rel + 2014
 89.     reg year_fes rel 
 90.     predict control_trend, xb
 91.     sum control_trend if rel == -1, d
 92.     local base =  r(mean)
 93.     gen year_fes_raw = year_fes
 94.     gen trt_coef_raw = trt_coef
 95.     replace year_fes = year_fes - control_trend + `base'
 96.     replace trt_coef = trt_coef - control_trend + `base'
 97.     gen year_fes_ub = year_fes + 1.96*year_fes_se
 98.     gen year_fes_lb = year_fes - 1.96*year_fes_se
 99.     gen trt_coef_ub = trt_coef + 1.96*trt_coef_se
100.     gen trt_coef_lb = trt_coef - 1.96*trt_coef_se 
101.     gen rel_year_fes = year + 0.1
102.     
.     hashsort rel
103.     sum ub , d
104.     local ymax = max(`ymax', round(r(max),0.1))
105.     sum lb , d
106.     local ymin = min(`ymin', round(r(min),0.1))
107.     export delimited using "../output/estimates/`suf'es_`yvar'_estimates`file_suf'$suffix.csv", replace
108.     save "../temp/`suf'es_`yvar'_estimates`file_suf'$suffix", replace
109.     sum year , d
110.     local year_min = r(min)
111.     local year_max = r(max)
112.     local legend_split legend(on order(3 "Treated Level Avg. in t = -1: `trt_mean'" 4 "Control Level Avg. in t = -1: `ctrl_mean'") pos(7) rows(2) bmargin(zero) size(small))
113.     local modes $exhibit_mode
114.     if "$exhibit_mode" == "both" local modes presentation paper
115.    /* if "`title'" == "" {
>         tw rcap ub lb rel if rel != -1 & inrange(rel, `lead', `lag') , lcolor(ebblue%70) msize(vsmall) || ///
>         scatter b rel if inrange(rel, `lead', `lag') , mcolor(ebblue) || ///
>         scatteri `ymax' -0.25 `ymax' 0.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>         xlab(`lead'(1)`lag', labsize(vsmall)) xtitle("Relative Year", size(small)) ///
>         ytitle("`name'", size(small)) ylab(`ymin'(`ygap')`ymax', labsize(vsmall)) yline(0, lcolor(gs10) lpattern(solid))  ///
>         legend(on order(- "Treated Level Avg. in t = -1: `trt_mean'" "Control Level Avg. in t = -1: `ctrl_mean'") pos(6) rows(2))  ///
>         plotregion(margin(sides))
>         graph export "../output/figures/es/`suf'es_`yvar'_`file_suf'$suffix.pdf", replace
>     }*/
.     foreach mode in `modes' {
116.         local figdir ../output/figures
117.         local legend_lvl legend(on order(- "Treated Level Avg. in t = -1: `trt_mean'" "Control Level Avg. in t = -1: `ctrl_mean'") pos(7) rows(2) bmargin(zero) size(small))
118.         if "`mode'" == "paper" {
119.             local figdir ../output/figures/paper
120.             local legend_lvl legend(off)
121.         }
122.         tw rcap ub lb year if rel != -1 & inrange(rel, `lead', `lag') , lcolor(ebblue%70) msize(vsmall) || ///
>         scatter b year if inrange(rel, `lead', `lag') , mcolor(ebblue) || ///
>         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>         xlab(`year_min'(1)`year_max') xtitle("Year") ///
>         ytitle("`name'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`ygap')`ymax') yline(0, lcolor(gs10) lpattern(solid)) ///
>         `legend_lvl' ///
>         title(`title', size(small)) plotregion(margin(sides))
123.         graph export "`figdir'/es/`suf'es_`yvar'_`file_suf'$suffix.pdf", replace
124.     }
125. 
.         tw rcap trt_coef_ub trt_coef_lb year if rel != -1 & inrange(rel, `lead', `lag') , lcolor(ebblue%70) msize(vsmall) || ///
>         rcap year_fes_ub year_fes_lb rel_year_fes if rel != -1 & inrange(rel, `lead', `lag') , lcolor(dkorange%70) lpattern(dash) msize(vsmall) || ///
>         scatter trt_coef year if inrange(rel, `lead', `lag') , mcolor(ebblue) || ///
>         scatter year_fes rel_year_fes if inrange(rel, `lead', `lag') , mcolor(dkorange) msymbol(diamond) || ///
>         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>         xlab(`year_min'(1)`year_max') xtitle("Year") ///
>         ytitle("`name'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`ygap')`ymax') yline(0, lcolor(gs10) lpattern(solid)) ///
>         `legend_split' ///
>         title(`title', size(small)) plotregion(margin(sides))
126.         graph export "../output/figures/es/split_`suf'es_`yvar'_`file_suf'$suffix.pdf", replace
127. 
.         gen trt_coef_raw_ub = trt_coef_raw + 1.96*trt_coef_se
128.         gen trt_coef_raw_lb = trt_coef_raw - 1.96*trt_coef_se
129.         gen year_fes_raw_ub = year_fes_raw + 1.96*year_fes_se
130.         gen year_fes_raw_lb = year_fes_raw - 1.96*year_fes_se
131.         sum trt_coef_raw_ub if inrange(rel, `lead', `lag'), d
132.         local rymax = r(max)
133.         sum year_fes_raw_ub if inrange(rel, `lead', `lag'), d
134.         local rymax = round(max(`rymax', r(max)) + `ygap', `ygap')
135.         sum trt_coef_raw_lb if inrange(rel, `lead', `lag'), d
136.         local rymin = r(min)
137.         sum year_fes_raw_lb if inrange(rel, `lead', `lag'), d
138.         local rymin = round(min(`rymin', r(min)) - `ygap', `ygap')
139.         tw rcap trt_coef_raw_ub trt_coef_raw_lb year if rel != -1 & inrange(rel, `lead', `lag') , lcolor(ebblue%70) msize(vsmall) || ///
>         rcap year_fes_raw_ub year_fes_raw_lb rel_year_fes if rel != -1 & inrange(rel, `lead', `lag') , lcolor(dkorange%70) lpattern(dash) msize(vsmall) || ///
>         scatter trt_coef_raw year if inrange(rel, `lead', `lag') , mcolor(ebblue) || ///
>         scatter year_fes_raw rel_year_fes if inrange(rel, `lead', `lag') , mcolor(dkorange) msymbol(diamond) || ///
>         scatteri `rymax' 2013.75 `rymax' 2014.25 , bcolor(gs12%30) recast(area) base(`rymin') ///
>         xlab(`year_min'(1)`year_max') xtitle("Year") ///
>         ytitle("`name'") ysc(titlegap(-6) outergap(0)) ylab(`rymin'(`ygap')`rymax') yline(0, lcolor(gs10) lpattern(solid)) ///
>         `legend_split' ///
>         title(`title', size(small)) plotregion(margin(sides))
140.         graph export "../output/figures/es/split_nodetrend_`suf'es_`yvar'_`file_suf'$suffix.pdf", replace
141.     restore
142. end

