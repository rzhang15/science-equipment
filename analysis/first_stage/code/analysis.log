. program robustness
  1.     use ../external/merged/matched_uni_category_panel$suffix, clear
  2.     gegen uni_mkt = group(uni_id mkt)
  3.     bys uni_mkt : egen min_year = min(year)
  4.     bys uni_mkt : egen max_year = max(year)
  5.     keep if min_year < 2014 & max_year > 2014
  6.     gen post = 0
  7.     replace post = 1 if year >= 2014
  8.     gen posttreat = treated * post
  9.     gegen uni_year = group(uni_id year)
 10.     cap mat drop pooled_did
 11.     mat b_row = J(1, 9, .)
 12.     mat se_row = J(1, 9, .)
 13.     mat n_row = J(1, 9, .)
 14.     local col = 0
 15.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 16.         cap mat drop robust_`var'
 17.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 18.         mat robust_`var' = nullmat(robust_`var') \ (_b[posttreat], _se[posttreat], e(N), e(r2))
 19.         local col = `col' + 1
 20.         mat b_row[1, `col']  = _b[posttreat]
 21.         mat se_row[1, `col'] = _se[posttreat]
 22.         mat n_row[1, `col']  = e(N)
 23.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(uni_mkt year)
 24.         mat robust_`var' = nullmat(robust_`var') \ (_b[posttreat], _se[posttreat], e(N), e(r2))
 25.         local col = `col' + 1
 26.         mat b_row[1, `col']  = _b[posttreat]
 27.         mat se_row[1, `col'] = _se[posttreat]
 28.         mat n_row[1, `col']  = e(N)
 29.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(uni_year mkt)
 30.         mat robust_`var' = nullmat(robust_`var') \ (_b[posttreat], _se[posttreat], e(N), e(r2))
 31.         local col = `col' + 1
 32.         mat b_row[1, `col']  = _b[posttreat]
 33.         mat se_row[1, `col'] = _se[posttreat]
 34.         mat n_row[1, `col']  = e(N)
 35.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(uni_mkt uni_year)
 36.         mat robust_`var' = nullmat(robust_`var') \ (_b[posttreat], _se[posttreat], e(N), e(r2))
 37.         mat colnames robust_`var' = b se N r2
 38.         mat rownames robust_`var' = baseline uni_mkt_year uni_year_mkt uni_mkt_uni_year
 39.     }
 40.     mat pooled_did = b_row \ se_row \ n_row
 41.     mat colnames pooled_did = price_base price_unimkt price_uniyr qty_base qty_unimkt qty_uniyr spend_base spend_unimkt spend_uniyr
 42.     mat rownames pooled_did = b se N
 43.     gen rel = year - 2014
 44.     replace rel = . if treated == 0
 45.     forval i = 1/5 {
 46.         gen lag`i' = 1 if rel == `i'
 47.         gen lead`i' = 1 if rel == -`i'
 48.     }
 49.     gen lag0 = 1 if rel == 0
 50.     ds lead* lag*
 51.     foreach v in `r(varlist)' {
 52.         replace `v' = 0 if mi(`v')
 53.     }
 54.     local rhs lead5 lead4 lead3 lead2 lag0 lag1 lag2 lag3 lag4 lag5
 55.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 56.         if "`var'" == "avg_log_price" local yname "Avg. Log Price"
 57.         if "`var'" == "log_raw_qty"   local yname "Log Qty"
 58.         if "`var'" == "log_raw_spend" local yname "Log Spend"
 59.         cap mat drop es_`var'
 60.         local s = 0
 61.         foreach fespec in "year uni_id mkt" "uni_mkt year" "uni_year mkt" "uni_mkt uni_year" {
 62.             local s = `s' + 1
 63.             reghdfe `var' `rhs' [aw=spend_2013], absorb(`fespec') vce(cluster mkt)
 64.             foreach lv of local rhs {
 65.                 local relval = cond(substr("`lv'",1,3)=="lea", -1*real(substr("`lv'",5,.)), real(substr("`lv'",4,.)))
 66.                 mat es_`var' = nullmat(es_`var') \ (`s', `relval', _b[`lv'], _se[`lv'])
 67.             }
 68.             mat es_`var' = nullmat(es_`var') \ (`s', -1, 0, 0)
 69.         }
 70.         mat colnames es_`var' = spec rel b se
 71.         preserve
 72.         clear
 73.         svmat es_`var', names(col)
 74.         gen lb = b - 1.96*se
 75.         gen ub = b + 1.96*se
 76.         replace rel = rel + 0.15*(spec - 2.5)
 77.         sum lb, d
 78.         local ymin = round(r(min) - 0.1, 0.1)
 79.         sum ub, d
 80.         local ymax = round(r(max) + 0.1, 0.1)
 81.         tw rcap ub lb rel if spec == 1, lcolor(lavender%70) msize(vsmall) || ///
>            scatter b rel if spec == 1, mcolor(lavender) msize(small) || ///
>            rcap ub lb rel if spec == 2, lcolor(orange%70) msize(vsmall) || ///
>            scatter b rel if spec == 2, mcolor(orange) msymbol(smdiamond) msize(small) || ///
>            rcap ub lb rel if spec == 3, lcolor(ebblue%70) msize(vsmall) || ///
>            scatter b rel if spec == 3, mcolor(ebblue) msymbol(smsquare) msize(small) || ///
>            rcap ub lb rel if spec == 4, lcolor(emerald%70) msize(vsmall) || ///
>            scatter b rel if spec == 4, mcolor(emerald) msymbol(smtriangle) msize(small) ///
>            , xlab(-5(1)5, labsize(small)) ylab(`ymin'(0.1)`ymax', labsize(small)) ///
>            yline(0, lcolor(gs10) lpattern(solid)) ///
>            xtitle("Relative Year", size(small)) ytitle("`yname'", size(small)) ///
>            legend(on order(2 "baseline" 4 "uni#mkt + year" 6 "uni#year + mkt" 8 "uni#mkt + uni#year") ///
>                   pos(6) rows(2) size(small) region(fcolor(none))) ///
>            plotregion(margin(sides))
 82.         graph export ../output/figures/robust_es_`var'$suffix.pdf, replace
 83.         restore
 84.     }
 85. end

. 
. program balance_check
  1.     use ../external/merged/matched_uni_category_panel$suffix, clear
  2.     gegen uni_mkt = group(uni_id mkt)
  3.     bys uni_mkt : egen min_year = min(year)
  4.     bys uni_mkt : egen max_year = max(year)
  5.     keep if min_year < 2014 & max_year > 2014
  6.     keep if inrange(year, 2010, 2013)
  7. 
.     cap mat drop balance
  8.     foreach var in avg_log_price log_raw_qty log_raw_spend {
  9.         qui sum `var' if treated == 1 [aw=spend_2013]
 10.         local m_t = r(mean)
 11.         qui sum `var' if treated == 0 [aw=spend_2013]
 12.         local m_c = r(mean)
 13.         qui reg `var' treated [aw=spend_2013], vce(cluster mkt)
 14.         local diff = _b[treated]
 15.         local se   = _se[treated]
 16.         local t    = `diff' / `se'
 17.         local N    = e(N)
 18.         mat balance = nullmat(balance) \ (`m_t', `m_c', `diff', `se', `t', `N')
 19.     }
 20.     mat colnames balance = mean_trt mean_ctrl diff se t N
 21.     mat rownames balance = avg_log_price log_raw_qty log_raw_spend
 22. end

. 
. program placebo_timing
  1.     use ../external/merged/matched_uni_category_panel$suffix, clear
  2.     gegen uni_mkt = group(uni_id mkt)
  3.     bys uni_mkt : egen min_year = min(year)
  4.     bys uni_mkt : egen max_year = max(year)
  5.     keep if min_year < 2014 & max_year > 2014
  6.     keep if inrange(year, 2010, 2013)
  7.     gen post_pl = (year >= 2012)
  8.     gen posttreat_pl = treated * post_pl
  9. 
.     cap mat drop placebo_timing
 10.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 11.         reghdfe `var' posttreat_pl [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 12.         mat placebo_timing = nullmat(placebo_timing) \ (_b[posttreat_pl], _se[posttreat_pl], e(N), e(r2))
 13.     }
 14.     mat colnames placebo_timing = b se N r2
 15.     mat rownames placebo_timing = avg_log_price log_raw_qty log_raw_spend
 16. end

. 
. program robustness_coefplot
  1.     foreach var in avg_log_price log_raw_qty log_raw_spend {
  2.         cap mat drop robust_coefs_`var'
  3.         mat robust_coefs_`var' = robust_`var'[1..4, 1..2]
  4.     }
  5.     use ../external/samp/uni_category_yr_tfidf$suffix, clear
  6.     gegen uni_mkt = group(uni_id mkt)
  7.     bys uni_mkt : egen min_year = min(year)
  8.     bys uni_mkt : egen max_year = max(year)
  9.     keep if min_year < 2014 & max_year > 2014
 10.     gen posttreat = treated * (year >= 2014)
 11.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 12.         reghdfe `var' posttreat [aw=spend_2013], cluster(mkt) absorb(year uni_id mkt)
 13.         mat robust_coefs_`var' = robust_coefs_`var' \ (_b[posttreat], _se[posttreat])
 14.     }
 15.     local rownames baseline uni_mkt_year uni_year_mkt uni_mkt_uni_year unmatched
 16.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 17.         if "`var'" == "avg_log_price" local tag price
 18.         if "`var'" == "log_raw_qty"   local tag qty
 19.         if "`var'" == "log_raw_spend" local tag spend
 20.         use ../external/synth/synth_stacked_panel_`tag'$suffix, clear
 21.         gen posttreat = is_treated_in_stack * (year >= 2014)
 22.         reghdfe `var' posttreat [aw=composite_weight], cluster(stack_id) absorb(year category_num)
 23.         mat robust_coefs_`var' = robust_coefs_`var' \ (_b[posttreat], _se[posttreat])
 24.     }
 25.     local rownames `rownames' synth
 26.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 27.         mat colnames robust_coefs_`var' = b se
 28.         mat rownames robust_coefs_`var' = `rownames'
 29.     }
 30.     foreach var in avg_log_price log_raw_qty log_raw_spend {
 31.         if "`var'" == "avg_log_price" local yname "Avg. Log Price"
 32.         if "`var'" == "log_raw_qty"   local yname "Log Qty"
 33.         if "`var'" == "log_raw_spend" local yname "Log Spend"
 34.         clear
 35.         svmat robust_coefs_`var', names(col)
 36.         gen lb = b - 1.96*se
 37.         gen ub = b + 1.96*se
 38.         gen pos = real(word("10 7 6 5 2 1", _n))
 39.         local ylabs 10 "{bf:Baseline}" 8 "{bf:Fixed effects}" 7 "University × Market + Year FEs" ///
>             6 "University × Year + Market FEs" 5 "University × Market + University × Year FEs" ///
>             3 "{bf:Control group}" 2 "Unmatched controls" 1 "Synthetic control"
 40.         local base = b[1]
 41.         sum lb
 42.         local xmin = floor(r(min)*10)/10
 43.         sum ub
 44.         local xmax = ceil(r(max)*10)/10
 45.         local step = cond(`xmax' - `xmin' > 0.8, 0.2, 0.1)
 46.         foreach mode in combined single {
 47.             local ylab_opt ylab(`ylabs', angle(0) labsize(small) notick nogrid)
 48.             if "`mode'" == "combined" & "`var'" != "avg_log_price" local ylab_opt ylab(1(1)10, nolabels notick nogrid)
 49.             tw rcap ub lb pos if pos == 10, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                scatter pos b if pos == 10, mcolor(dkorange) || ///
>                rcap ub lb pos if inrange(pos, 1, 9), horizontal lcolor(ebblue%70) msize(vsmall) || ///
>                scatter pos b if inrange(pos, 1, 9), mcolor(ebblue) ///
>                , xline(0, lcolor(gs12) lpattern(solid)) xline(`base', lcolor(dkorange) lpattern(dash)) ///
>                xlab(`xmin'(`step')`xmax', labsize(small) format(%3.1f) grid glpattern(dot) glcolor(gs13)) `ylab_opt' ///
>                xtitle("`yname' (95% CI)", size(small)) ytitle("") ysc(range(0.5 10.5) noline) ///
>                legend(off) plotregion(margin(sides)) name(rc_`var'_`mode', replace)
 50.         }
 51.         graph export ../output/figures/robust_coefs_`var'$suffix.pdf, replace
 52.     }
 53.     graph combine rc_avg_log_price_combined rc_log_raw_qty_combined rc_log_raw_spend_combined, ///
>         rows(1) xsize(12) ysize(4) imargin(small)
 54.     graph export ../output/figures/robust_coefs_all$suffix.pdf, replace
 55.     graph drop _all
 56. end

. 
. program output_tables
  1.     foreach tab in robust_avg_log_price robust_log_raw_qty robust_log_raw_spend pooled_did balance placebo_timing robust_coefs_avg_log_price robust_coefs_log_raw_qty robust_coefs_log_raw_spend {
  2.         qui matrix_to_txt, saving("../output/tables/`tab'$suffix.txt") matrix(`tab') ///
>             title(<tab:`tab'>) format(%20.4f) replace
  3.     }
  4.     merger_validity_tex
  5. end

. 
. program merger_validity_tex
  1.     local texfile "../output/tables/merger_validity$suffix.tex"
  2.     cap file close mv
  3.     file open mv using "`texfile'", write replace
  4. 
.     local outs "avg_log_price log_raw_qty log_raw_spend"
  5.     local lbl_avg_log_price "Avg.\ log price"
  6.     local lbl_log_raw_qty   "Log quantity"
  7.     local lbl_log_raw_spend "Log spending"
  8. 
.     local i = 0
  9.     foreach y of local outs {
 10.         local ++i
 11.         local col = cond("`y'" == "avg_log_price", 1, cond("`y'" == "log_raw_qty", 4, 7))
 12.         local b_real_`y' = pooled_did[1, `col']
 13.         local s_real_`y' = pooled_did[2, `col']
 14.         local b_pl_`y' = placebo_timing[`i', 1]
 15.         local s_pl_`y' = placebo_timing[`i', 2]
 16.         local m_t_`y'  = balance[`i', 1]
 17.         local m_c_`y'  = balance[`i', 2]
 18.         local d_`y'    = balance[`i', 3]
 19.         local sd_`y'   = balance[`i', 4]
 20.     }
 21. 
.     file write mv "% First-stage merger validity: 2010--2013 balance + placebo-timing" _n
 22.     file write mv "% DiD (fake treatment = 2012) vs real DiD (treatment = 2014, baseline spec)." _n
 23.     file write mv "\begin{table}[htbp]" _n
 24.     file write mv "\centering" _n
 25.     file write mv "\caption{First-stage merger validity: pre-treatment balance and placebo-timing DiD}" _n
 26.     file write mv "\label{tab:merger_validity_first_stage}" _n
 27.     file write mv "\begin{threeparttable}" _n
 28.     file write mv "\begin{tabular}{lccccccc}" _n
 29.     file write mv "\toprule" _n
 30.     file write mv " & \multicolumn{3}{c}{Pre-treatment balance (2010--2013)} & \multicolumn{2}{c}{Placebo 2012} & \multicolumn{2}{c}{Real 2014} \\" _n
 31.     file write mv "\cmidrule(lr){2-4} \cmidrule(lr){5-6} \cmidrule(lr){7-8}" _n
 32.     file write mv " & Trt.\ mean & Ctrl.\ mean & Diff & \(\hat{\beta}\) & SE & \(\hat{\beta}\) & SE \\" _n
 33.     file write mv "\midrule" _n
 34. 
.     foreach y of local outs {
 35.         if "`y'" == "avg_log_price" local lbl "Avg.\ log price"
 36.         if "`y'" == "log_raw_qty"   local lbl "Log quantity"
 37.         if "`y'" == "log_raw_spend" local lbl "Log spending"
 38. 
.         local t_bal = .
 39.         if !mi(`d_`y'') & !mi(`sd_`y'') & `sd_`y'' > 0 {
 40.             local t_bal = abs(`d_`y'') / `sd_`y''
 41.         }
 42.         local star_bal ""
 43.         if !mi(`t_bal') & `t_bal' >= 1.645 local star_bal "\(^{*}\)"
 44.         if !mi(`t_bal') & `t_bal' >= 1.96  local star_bal "\(^{**}\)"
 45.         if !mi(`t_bal') & `t_bal' >= 2.576 local star_bal "\(^{***}\)"
 46. 
.         local t_pl = .
 47.         if !mi(`b_pl_`y'') & !mi(`s_pl_`y'') & `s_pl_`y'' > 0 {
 48.             local t_pl = abs(`b_pl_`y'') / `s_pl_`y''
 49.         }
 50.         local star_pl ""
 51.         if !mi(`t_pl') & `t_pl' >= 1.645 local star_pl "\(^{*}\)"
 52.         if !mi(`t_pl') & `t_pl' >= 1.96  local star_pl "\(^{**}\)"
 53.         if !mi(`t_pl') & `t_pl' >= 2.576 local star_pl "\(^{***}\)"
 54. 
.         local t_real = .
 55.         if !mi(`b_real_`y'') & !mi(`s_real_`y'') & `s_real_`y'' > 0 {
 56.             local t_real = abs(`b_real_`y'') / `s_real_`y''
 57.         }
 58.         local star_real ""
 59.         if !mi(`t_real') & `t_real' >= 1.645 local star_real "\(^{*}\)"
 60.         if !mi(`t_real') & `t_real' >= 1.96  local star_real "\(^{**}\)"
 61.         if !mi(`t_real') & `t_real' >= 2.576 local star_real "\(^{***}\)"
 62. 
.         local mt : display %7.3f `m_t_`y''
 63.         local mc : display %7.3f `m_c_`y''
 64.         local d  : display %7.3f `d_`y''
 65.         local bp : display %7.3f `b_pl_`y''
 66.         local sp : display %7.3f `s_pl_`y''
 67.         local br : display %7.3f `b_real_`y''
 68.         local sr : display %7.3f `s_real_`y''
 69. 
.         file write mv "`lbl' & `mt' & `mc' & `d'`star_bal' & `bp'`star_pl' & (`sp') & `br'`star_real' & (`sr') \\" _n
 70.     }
 71. 
.     file write mv "\bottomrule" _n
 72.     file write mv "\end{tabular}" _n
 73.     file write mv "\begin{tablenotes}[flushleft]\footnotesize" _n
 74.     file write mv "\item Sample: matched treated/control markets, pooled across universities." _n
 75.     file write mv "      Balance columns report weighted means (\(\texttt{[aw=spend\_2013]}\)) of the outcome" _n
 76.     file write mv "      over 2010--2013 in treated and control markets, and their difference; SE from" _n
 77.     file write mv "      a regression of the outcome on \(\texttt{treated}\), weighted and clustered by market." _n
 78.     file write mv "      Placebo 2012 is a DiD on the pre-treatment panel (2010--2013) with fake" _n
 79.     file write mv "      post\(_t = \mathbb{1}\{t \ge 2012\}\); Real 2014 is the baseline pooled DiD on the" _n
 80.     file write mv "      full panel with post\(_t = \mathbb{1}\{t \ge 2014\}\). Both DiD specs use" _n
 81.     file write mv "      \texttt{reghdfe} with author\(\times\)market weights, year, university, and market fixed" _n
 82.     file write mv "      effects, and SE clustered by market." _n
 83.     file write mv "\item Significance: \(^{*}\) \(p<0.10\), \(^{**}\) \(p<0.05\), \(^{***}\) \(p<0.01\)." _n
 84.     file write mv "\end{tablenotes}" _n
 85.     file write mv "\end{threeparttable}" _n
 86.     file write mv "\end{table}" _n
 87.     file close mv
 88.     di as text "wrote `texfile'"
 89. end

. 
. program event_study
  1.     use ../external/samp/uni_category_yr_tfidf$suffix, clear
  2.     merge m:1 category using ../external/samp/category_hhi_tfidf$suffix, assert(1 2 3) keep(3) nogen
  3.     drop if delta_hhi <= -2000
  4.     gen rel = year - 2014
  5.     replace rel = . if treated == 0
  6.     local fes uni_id mkt
  7.     bys category: gen cat_id = _n == 1
  8.     gen time_trend = year - 2009
  9.     gen lin_time_trend = treated*time_trend
 10.     foreach yvar in price qty spend {
 11.         preserve
 12.         mat drop _all
 13.         if "`yvar'" == "price" local yname "Avg. Log Price"
 14.         if "`yvar'" == "qty" local yname "Log Qty"
 15.         if "`yvar'" == "spend" local yname "Log Spend"
 16.         qui sum raw_`yvar' if treated == 1 & year == 2013
 17.         local trt_mean = round(r(mean), 0.001)
 18.         qui sum raw_`yvar' if treated == 0 & year == 2013
 19.         local ctrl_mean = round(r(mean) + 0.001, 0.001)
 20.         if "`yvar'" == "price" {
 21.             di "hi"
 22.             manual_event_study, lag(5) lead(-4) yvar(avg_log_`yvar') ymin(-0.4) ymax(0.7) ygap(0.1) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("naive")
 23.         }
 24.         if "`yvar'" != "price" {
 25.             manual_event_study, lag(5) lead(-4) yvar(log_raw_`yvar') ymin(-0.4) ymax(0.7) ygap(0.1) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("naive")
 26.         }
 27.         restore
 28.     }
 29. 
.     use ../external/merged/matched_uni_category_panel$suffix ,clear 
 30.     merge m:1 category using ../external/samp/category_hhi_tfidf$suffix, assert(1 2 3) keep(3) nogen
 31.     drop if delta_hhi <= -2000
 32.     gegen uni_mkt = group(uni_id mkt)
 33.     bys uni_mkt : egen min_year = min(year)
 34.     bys uni_mkt : egen max_year = max(year)
 35.     keep if min_year < 2014 & max_year > 2014
 36.     gen rel = year - 2014
 37.     replace rel = . if treated == 0
 38.     local fes uni_id mkt 
 39.     bys category: gen cat_id = _n == 1
 40.     gen time_trend = year - 2009
 41.     gen lin_time_trend = treated*time_trend
 42.     foreach yvar in price qty spend {
 43.         preserve
 44.         mat drop _all
 45.         if "`yvar'" == "price" local yname "Avg. Log Price"
 46.         if "`yvar'" == "qty" local yname "Log Qty"
 47.         if "`yvar'" == "spend" local yname "Log Spend"
 48.         qui sum raw_`yvar' if treated == 1 & year == 2013
 49.         local trt_mean = round(r(mean), 0.001)
 50.         qui sum raw_`yvar' if treated == 0 & year == 2013
 51.         local ctrl_mean = round(r(mean) + 0.001, 0.001)
 52.         if "`yvar'" == "price" {
 53.             manual_event_study, lag(5) lead(-4) yvar(avg_log_`yvar') ymin(-0.4) ymax(0.7) ygap(0.1) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("pooled")
 54.         }
 55.         local fes uni_id mkt
 56.         if "`yvar'" != "price" {
 57.             manual_event_study, lag(5) lead(-4) yvar(log_raw_`yvar') ymin(-0.4) ymax(0.7) ygap(0.1) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("pooled")
 58.         }
 59.         restore
 60.     }
 61.     foreach yvar in raw_price  { 
 62.         preserve
 63.         mat drop _all
 64.         local yname "Price"
 65.         qui sum `yvar' if treated == 1 & year == 2013
 66.         local trt_mean = round(r(mean), 0.001)
 67.         qui sum `yvar' if treated == 0 & year == 2013
 68.         local ctrl_mean = round(r(mean) + 0.001, 0.001)
 69.         manual_event_study, lag(5) lead(-4) yvar(`yvar') ymin(-50) ymax(50) ygap(5) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("pooled")
 70.         restore
 71.     }
 72.     foreach yvar in raw_qty { 
 73.         preserve
 74.         mat drop _all
 75.         local yname "Qty"
 76.         qui sum `yvar' if treated == 1 & year == 2013
 77.         local trt_mean = round(r(mean), 0.001)
 78.         qui sum `yvar' if treated == 0 & year == 2013
 79.         local ctrl_mean = round(r(mean) + 0.001, 0.001)
 80.         manual_event_study, lag(5) lead(-4) yvar(`yvar') ymin(-50) ymax(50) ygap(5) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("pooled")
 81.         restore
 82.     }
 83.     foreach yvar in raw_spend { 
 84.         preserve
 85.         mat drop _all
 86.         local yname "Spend"
 87.         qui sum `yvar' if treated == 1 & year == 2013
 88.         local trt_mean = round(r(mean), 0.001)
 89.         qui sum `yvar' if treated == 0 & year == 2013
 90.         local ctrl_mean = round(r(mean) + 0.001, 0.001)
 91.         manual_event_study, lag(5) lead(-4) yvar(`yvar') ymin(-600) ymax(6000) ygap(750) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("pooled")
 92.         restore
 93.     }
 94.     /*
>     sum delta_hhi if cat_id == 1, d
>     local p25 = r(p25)
>     local p50 = r(p50)
>     local p75 = r(p75)
> 
>     gen hhi1 = delta_hhi <= `p25' 
>     gen hhi2 = inrange(delta_hhi, `p25', `p50')
>     gen hhi3 = inrange(delta_hhi, `p50', `p75')
>     gen hhi4 = delta_hhi >= `p75' 
>     forval i = 1/4 {
>         foreach yvar in price qty spend {
>             preserve
>             keep if hhi`i' == 1
>             mat drop _all 
>             if "`yvar'" == "price" local yname "Avg. Log Price"
>             if "`yvar'" == "qty" local yname "Avg. Log Qty"
>             if "`yvar'" == "spend" local yname "Avg. Log Spend"
>             qui sum raw_`yvar' if treated == 1 & year == 2013 
>             local trt_mean :  dis %6.3f r(mean)
>             qui sum raw_`yvar' if treated == 0 & year == 2013 
>             local ctrl_mean : dis %6.3f r(mean)
>             manual_event_study, lag(5) lead(-4) yvar(avg_log_`yvar') ymin(-0.2) ymax(0.6) ygap(0.1) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name("`yname' HHI Quartile `i'") fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("hhi`i'")
>             restore
>         }
>     }*/
. 
.     qui glevelsof category if treated == 1, local(categories)
 95.         foreach c in `categories' {
 96.         use ../external/merged/matched_pairs$suffix, clear 
 97.         qui glevelsof control_market if category == "`c'", local(match) 
 98.         use ../external/merged/matched_uni_category_panel$suffix, clear 
 99.         gen rel = year - 2014
100.         replace rel = . if treated == 0
101.         gen keep = 1 if category == "`c'"
102.         foreach  m in `match' {
103.             replace keep = 1 if category == "`m'"
104.         }
105.         local match_name ""
106.         foreach  m in `match' {
107.             replace keep = 1 if category == "`m'"
108.             local match_name = "`match_name'" + ", " + strproper("`m'")
109.         }
110.         keep if keep == 1
111.         glevelsof category if treated == 1, local(name)
112.         local name = strproper(`name')
113.         foreach yvar in price qty spend { 
114.             preserve
115.             mat drop _all 
116.             if "`yvar'" == "price" local yname "Avg. Log Price"
117.             if "`yvar'" == "qty" local yname "Log Qty"
118.             if "`yvar'" == "spend" local yname "Log Spend"
119.             qui sum raw_`yvar' if treated == 1 & year == 2013
120.             local trt_mean = round(r(mean), 0.001)
121.             qui sum raw_`yvar' if treated == 0 & year == 2013
122.             local ctrl_mean = round(r(mean) + 0.001, 0.001)
123.             if "`yvar'" == "price" {
124.                 manual_event_study, lag(5) lead(-4) yvar(avg_log_`yvar') ymin(-0.2) ymax(0.6) ygap(0.1) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("`c'")
125.             }
126.             if "`yvar'" != "price" {
127.                 manual_event_study, lag(5) lead(-4) yvar(log_raw_`yvar') ymin(-0.2) ymax(0.6) ygap(0.1) trt_mean(`trt_mean') ctrl_mean(`ctrl_mean')  name(`yname') fes(`fes') wt_var(spend_2013) cluster_var(mkt) file_suf("`c'")
128.             }
129.             restore
130.         }
131.     }
132.     /*
>     use "../temp/es_avg_log_price_estimateshhi1", clear 
>     gen group = 1 
>     replace rel = rel - 0.24 
>     append using ../temp/es_avg_log_price_estimateshhi2
>     replace group = 2 if mi(group)
>     replace rel = rel - 0.08 if group == 2
>     append using ../temp/es_avg_log_price_estimateshhi3
>     replace group = 3 if mi(group)
>     replace rel = rel + 0.08  if group == 3
>     append using ../temp/es_avg_log_price_estimateshhi4
>     replace group = 4 if mi(group)
>     replace rel = rel + 0.24 if group == 4
>     tw rcap ub lb rel if rel != -1.24 & group == 1,  lcolor(lavender%70) msize(small) || ///
>        scatter b rel if group == 1, mcolor(lavender%70) msize(small) || ///
>        rcap ub lb rel if rel != -1.08 & group == 2,  lcolor(orange%70) msize(small) || ///
>        scatter b rel if group == 2, mcolor(orange%70) msymbol(smdiamond) msize(small) || /// 
>        rcap ub lb rel if rel != -0.92 & group == 3,  lcolor(ebblue%70) msize(small) || ///
>        scatter b rel if group == 3, mcolor(ebblue%70) msymbol(smsquare) msize(small) || /// 
>        rcap ub lb rel if rel != -0.76 & group == 4,  lcolor(cranberry%70) msize(small) || ///
>        scatter b rel if group == 4, mcolor(cranberry%70) msymbol(smtriangle) msize(small) || /// 
>        scatteri 0.6 -0.3 0.6 0.3 , bcolor(gs12%30) recast(area) base(-0.6) ///
>        xlab(-4(1)5, labsize(small)) ylab(-0.6(0.1)0.6, labsize(vsmall)) ///
>           yline(0, lcolor(black) lpattern(solid)) ///
>           legend(on order(2 "Delta HHI Q1" 4 "Delta HHI Q2" 6 "Delta HHI Q3" 8 "Delta HHI Q4") pos(11) rows(2) ring(0) size(vsmall) region(fcolor(none))) xtitle("Relative Year", size(small)) ytitle("Avg. Log Price", size(small)) plotregion(margin(sides)
> )
>     graph export ../output/figures/es_estimates_hhi$suffix.pdf, replace
>     */
.     use "../temp/es_log_raw_spend_estimatespooled$suffix", clear
133.     gen group = "spend"
134.     replace rel = rel - 0.2 
135.     sum b if group == "spend" & rel > 0
136.     local spend_mean : dis %4.3f r(mean)
137.     append using ../temp/es_avg_log_price_estimatespooled$suffix
138.     replace group = "price" if mi(group)
139.     sum b if group == "price" & rel > 0
140.     local price_mean : dis %4.3f r(mean)
141.     append using ../temp/es_log_raw_qty_estimatespooled$suffix
142.     replace group = "qty" if mi(group)
143.     replace rel = rel + 0.2 if group == "qty"
144.     sum b if group == "qty" & rel >0.2
145.     local qty_mean : dis %4.3f r(mean)
146.     tw rcap ub lb rel if rel != -1.2 & group == "spend",  lcolor(lavender%70) msize(small) || ///
>        scatter b rel if group == "spend", mcolor(lavender%70) msize(small) || ///
>        rcap ub lb rel if rel != -1.0 & group == "price",  lcolor(orange%70) msize(small) || ///
>        scatter b rel if group == "price", mcolor(orange%70) msymbol(smdiamond) msize(small) || /// 
>        rcap ub lb rel if rel != -0.8 & group == "qty",  lcolor(ebblue%70) msize(small) || ///
>        scatter b rel if group == "qty", mcolor(ebblue%70) msymbol(smsquare) msize(small) || /// 
>        scatteri 0.6 -0.3 0.6 0.3 , bcolor(gs12%30) recast(area) base(-0.2) ///
>        xlab(-4(1)5, labsize(small)) ylab(-0.2(0.1)0.6, labsize(vsmall)) ///
>           yline(0, lcolor(black) lpattern(solid)) ///
>           legend(on order(2 "Spending (Post Period Avg: `spend_mean')" 4 "Price (Post Period Avg: `price_mean')" 6 "Quantity (Post Period Avg: `qty_mean')") pos(11) ring(0) size(small) region(fcolor(none))) xtitle("Relative Year", size(small)) ytitle("L
> og Estimates", size(small)) plotregion(margin(sides))
147.     graph export ../output/figures/es_estimatespooled$suffix.pdf, replace
148. 
. end

