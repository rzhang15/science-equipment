. program uni_fes
  1.     cap mat drop betas betas_placebo betas_lr_sr
  2.     use ../external/merged/matched_uni_category_panel$suffix, clear 
  3.     keep if inrange(year, 2015,2019)
  4.     gen post = 0 
  5.     replace post = 1 if year >= 2017
  6.     gen posttreat = treated * post
  7.     reghdfe avg_log_price posttreat [aw = spend_2013], absorb(mkt year uni_id) cluster(mkt)
  8.     glevelsof uni_id, local(unis)
  9.     foreach u in `unis' {
 10.         gen u_`u' = uni_id == `u'
 11.         gen posttreat_`u'  = posttreat * u_`u'
 12.     }
 13.     reghdfe avg_log_price posttreat_* [aw = spend_2013], absorb(mkt uni_id year) cluster(mkt) 
 14.     foreach u in `unis' {
 15.         local val = . 
 16.         local se = . 
 17.         cap local val = _b[posttreat_`u']
 18.         cap local se = _se[posttreat_`u']
 19.         mat betas_placebo = nullmat(betas_placebo) \ (`u',  `val', `se')
 20.     }
 21.     svmat betas_placebo
 22.     keep if !mi(betas_placebo1)
 23.     keep betas*
 24.     rename (betas_placebo1 betas_placebo2 betas_placebo3) (uni_id beta_u_pl se_pl)
 25.     sum beta_u_pl, d
 26.     local mean_pl = round(r(mean), 0.001)
 27.     gen lb_pl = beta_u_pl - 1.96*se_pl
 28.     gen ub_pl = beta_u_pl + 1.96*se_pl
 29.     save ../output/beta_u_placebo$suffix, replace
 30. 
.     use ../external/merged/matched_uni_category_panel$suffix, clear 
 31.     global r1 `" "east carolina university" "florida international university" "florida state university (fsu)" "georgia institute of technology" "kent state university" "texas a&m university" "texas tech university" "university of florida" "universi
> ty of central florida" "university of kentucky" "university of florida" "university of kentucky" "university of michigan at ann arbor" "university of south florida" "university of southern mississippi" "washington state university" "wayne state universi
> ty" "'
 32.     global r2 `" "central michigan university" "georgia southern university" "idaho state university" "illinois state university" "indiana university of pennsylvania" "kennesaw state university" "louisiana state university health sciences center - ne
> w orleans" "northern illinois university" "suny upstate medical university" "the university of akron" "university of michigan - dearborn" "university of new orleans" "university of north carolina-wilmington" "'
 33.     global r3 `" "grand valley state university" "lincoln university" "morehead state university" "northern kentucky university" "sul ross state university" "texas a&m international university" "western kentucky university" "western washington univer
> sity" "youngstown state university" "'
 34.     gen r1 = .
 35.     gen r2 = .
 36.     gen r3 = .
 37.     foreach u in $r1 {
 38.         replace r1 = 1 if agencyname == "`u'"        
 39.     }
 40.     foreach u in $r2 {
 41.         replace r2 = 1 if agencyname == "`u'"        
 42.     }
 43.     foreach u in $r3 {
 44.         replace r3 = 1 if agencyname == "`u'"        
 45.     }
 46.     preserve
 47.     contract uni_id agencyname r1 r2 r3
 48.     drop _freq
 49.     save ../temp/uni_list$suffix, replace
 50.     restore
 51.     gen post = 0 
 52.     replace post = 1 if year >= 2014
 53.     gen posttreat = treated * post
 54.     gen lr = inrange(year, 2016,2019) 
 55.     gen sr = inrange(year, 2014,2016)
 56.     gen posttreatlr = lr * posttreat
 57.     gen posttreatsr = sr * posttreat
 58.     reghdfe avg_log_price posttreat [aw = spend_2013], absorb(mkt year uni_id) cluster(mkt)
 59.     reghdfe avg_log_price posttreatlr posttreatsr [aw = spend_2013], absorb(mkt year uni_id) cluster(mkt)
 60.     glevelsof uni_id, local(unis)
 61.     foreach u in `unis' {
 62.         gen u_`u' = uni_id == `u'
 63.         gen posttreat_`u'  = posttreat * u_`u'
 64.         gen posttreatlr_`u'  = posttreatlr * u_`u'
 65.         gen posttreatsr_`u'  = posttreatsr * u_`u'
 66.     }
 67.     reghdfe avg_log_price posttreat_* [aw = spend_2013], absorb(mkt year) cluster(mkt) 
 68.     estimates save posttreat_beta_u$suffix, replace
 69.     foreach u in `unis' {
 70.         local val = . 
 71.         local se = . 
 72.         cap local val = _b[posttreat_`u']
 73.         cap local se = _se[posttreat_`u']
 74.         mat betas = nullmat(betas) \ (`u',  `val', `se')
 75.     }
 76.     preserve
 77.     svmat betas
 78.     keep if !mi(betas1)
 79.     keep betas*
 80.     rename (betas1 betas2 betas3) (uni_id beta_u se)
 81.     merge 1:1 uni_id using ../temp/uni_list$suffix, assert(1 3) keep(1 3) nogen
 82.     sum beta_u, d
 83.     local N = r(N)
 84.     local min : dis %6.3f r(min)
 85.     local p25 : dis %6.3f r(p25)
 86.     local p50 : dis %6.3f r(p50)
 87.     local mean : dis %6.3f  r(mean)
 88.     local p75 : dis %6.3f r(p75)
 89.     local max : dis %6.3f r(max)
 90.     local sd : dis %6.3f r(sd)
 91.     drop if mi(beta_u)
 92.     tw hist beta_u  , freq ytitle("% of Unis", size(small)) bin(50) xlab(, labsize(vsmall)) ylab(, labsize(vsmall)) xtitle("Beta_u", size(small)) legend(on order(- "N = `N'" "min = `min'" "p25 = `p25'" "p50 = `p50'" "mean = `mean'" "p75 = `p75'" "max
>  = `max'" "sd =`sd'") pos(1) ring(0))
 93.     graph export ../output/figures/beta_u_dist$suffix.pdf, replace
 94.     gen lb = beta_u - 1.96*se
 95.     gen ub = beta_u + 1.96*se
 96.     save ../output/beta_u$suffix, replace
 97.     hashsort beta_u
 98.     gen id = _n 
 99.     gen sig = ub < 0 | lb > 0
100.     count if sig == 1 
101.     local sig = r(N)
102.     sum lb, d
103.     local ymin = round(r(min),1)
104.     sum ub, d
105.     local ymax = round(r(max),1)
106.     labmask id, values(agencyname)
107.     tw rcap ub lb id if r1 == 1 , lcolor(midgreen) msize(vsmall) || scatter beta_u id if r1 == 1, mcolor(midgreen) msize(tiny) ///
>      || rcap ub lb id if r2 == 1 ,  lcolor(dkorange) msize(vsmall) || scatter beta_u id if r2 == 1, mcolor(dkorange) msize(tiny) ///
>      || rcap ub lb id if r1 == .  & r2 == . , lcolor(eltblue%90)  msize(vsmall) || scatter beta_u id if r1 == . & r2 == . , mcolor(eltblue%90) msize(tiny) ///
>       xtitle("") ytitle("Beta_u + 95% CI", size(vsmall))  ///
>       xlab(, nolabel notick labsize(tiny) valuelabel angle(45) nogrid) ylab(`ymin'(0.5)`ymax', labsize(vsmall) nogrid)  yline(0, lcolor(gs12) lwidth(vthin)) ///
>       legend(on order(1 "R1 Universities" 3 "R2 Universities" 5 "Other Universities") pos(5) ring(0) size(vsmall))
108.     graph export ../output/figures/beta_u_ci$suffix.pdf, replace
109.     restore
110. 
.     reghdfe avg_log_price posttreatlr_*  posttreatsr_* [aw = spend_2013], absorb(uni_id mkt year) cluster(mkt) 
111.     estimates save posttreat_beta_u_lrsr$suffix, replace
112.     foreach u in `unis' {
113.         local val_lr = . 
114.         local val_sr = . 
115.         local se_lr = . 
116.         local se_sr = . 
117.         cap local val_lr = _b[posttreatlr_`u']
118.         cap local val_sr = _b[posttreatsr_`u']
119.         cap local se_lr = _se[posttreatlr_`u']
120.         cap local se_sr = _se[posttreatsr_`u']
121.         mat betas_lr_sr = nullmat(betas_lr_sr) \ (`u',  `val_sr', `se_sr', `val_lr', `se_lr')
122.     }
123.     preserve
124.     svmat betas_lr_sr
125.     keep if !mi(betas_lr_sr1)
126.     keep betas_lr_sr*
127.     rename (betas_lr_sr1 betas_lr_sr2 betas_lr_sr3 betas_lr_sr4 betas_lr_sr5) (uni_id betasr_u se_sr betalr_u se_lr)
128.     foreach v in sr lr {
129.         sum beta`v'_u, d
130.         local N_`v' = r(N)
131.         local min_`v' : dis %6.3f r(min)
132.         local p25_`v' : dis %6.3f r(p25)
133.         local p50_`v' : dis %6.3f r(p50)
134.         local mean_`v' : dis %6.3f  r(mean)
135.         local p75_`v' : dis %6.3f r(p75)
136.         local max_`v' : dis %6.3f r(max)
137.         local sd_`v' : dis %6.3f r(sd)
138.         tw hist beta`v'_u  , freq bin(50) xlab(,labsize(small)) ylab(, labsize(vsmall)) ytitle("% of Unis") xtitle("Beta`v'_u") legend(on order(- "N = `N_`v''" "min = `min_`v''" "p25 = `p25_`v''" "p50 = `p50_`v''" "mean = `mean_`v''" "p75 = `p75_`v''
> " "max = `max_`v''" "sd =`sd_`v''") pos(1) ring(0))
139.         graph export ../output/figures/beta`v'_u_dist$suffix.pdf, replace
140.         gen ub_`v' = beta`v'_u + 1.96 * se_`v'
141.         gen lb_`v' = beta`v'_u - 1.96 * se_`v'
142.         gen sig_`v' = ub_`v' < 0 | lb_`v' > 0
143.         hashsort beta`v'_u
144.         gen id = _n 
145.         count if sig_`v'==1
146.         local sig_`v' = r(N)
147.         tw rcap ub_`v' lb_`v' id if sig_`v' == 0 , lcolor(gs5%70) lwidth(vvthin) msize(vsmall) || rcap ub_`v' lb_`v' id if sig_`v' == 1 , lcolor(emerald) msize(vsmall) lwidth(vthin) , xlab(1(2)82, labsize(tiny) angle(45) nogrid) ylab(-2(0.2)2, labsiz
> e(tiny) nogrid)  yline(0, lcolor(blue) lwidth(vthin)) legend(on order(- "# Sig. = `sig_`v''" "Mean = `mean_`v''" "sd = `sd_`v''") pos(5) ring(0) size(vsmall))
148.         graph export ../output/figures/beta`v'_u_ci$suffix.pdf, replace
149.         drop id
150.     }
151.     drop sig*
152.     save ../output/beta_sr_lr_u$suffix, replace
153.     restore
154.     
.     use ../output/beta_u$suffix, clear
155.     merge 1:1 uni_id using ../output/beta_sr_lr_u$suffix, assert(3) keep(3) nogen
156.     merge 1:1 uni_id using ../output/beta_u_placebo$suffix, assert(1 3) keep(3) nogen
157.     tw kdensity betalr_u, color(ebblue%90) || kdensity betasr_u, color(orange%90)  || ///
>         kdensity beta_u ,   color(lavender%80) || kdensity beta_u_pl, color(gs12) ytitle("% of Unis") xtitle("Beta_u") ///
>         legend(on order(1 "Long run (mean): `mean_lr'" 2  "Short run (mean): `mean_sr'" 3 "All (mean):  `mean'" 4 "Placebo (mean): `mean_pl'") ring(0) pos(11) region(fcolor(none)))  ///
>         xlab(, labsize(small)) xtitle("University Price Estimates", size(small)) 
158.     graph export ../output/figures/overlaid_beta_u$suffix.pdf, replace
159.     keep uni_id beta_u betasr_u betalr_u 
160.     save ../output/betas$suffix, replace
161.     use ../output/beta_u$suffix, clear
162.     merge 1:1 uni_id using ../output/beta_u_placebo$suffix, assert(1 3) keep(3) nogen
163.     tw kdensity beta_u ,   color(lavender) || kdensity beta_u_pl, color(dkorange) ytitle("% of Unis") xtitle("Beta_u") ///
>         legend(on order(1 "University Price Effect Mean: `mean'" 2 "Placebo Treated Year (mean): `mean_pl'") ring(0) pos(11) region(fcolor(none)))  ///
>         xlab(, labsize(small)) xtitle("University Price Estimates", size(small)) 
164.     graph export ../output/figures/overlaid_beta_u_simple$suffix.pdf, replace
165.     use ../output/beta_u$suffix, clear
166.     tw kdensity beta_u ,   color(lavender%80) ytitle("% of Unis", size(small)) xtitle("Beta_u", size(small)) ///
>         legend(on order(1 "Mean: `mean'") ring(0) pos(11) region(fcolor(none)))  ///
>         xlab(, labsize(small))  
167.     graph export ../output/figures/overlaid_beta_u_single$suffix.pdf, replace
168. end

