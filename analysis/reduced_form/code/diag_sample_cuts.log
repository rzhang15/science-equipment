. forval i = 1/`abs_lag' {
  2.     gen int_lag`i' = exposure if rel == `i'
  3.     replace int_lag`i' = 0 if mi(int_lag`i')
  4.     gen mshr_lag`i' = mkt_spend_shr if rel == `i'
  5.     replace mshr_lag`i' = 0 if mi(mshr_lag`i')
  6. }
