. local ileads

. local ilags

. local mleads

. local mlags

. forval i = 2/`abs_lead' {
  2.     local ileads int_lead`i' `ileads'
  3.     local mleads mshr_lead`i' `mleads'
  4. }

. forval i = 0/`abs_lag' {
  2.     local ilags `ilags' int_lag`i'
  3.     local mlags `mlags' mshr_lag`i'
  4. }

. 
. * Precompute pre-period stats used for cuts
. gen pre_pprs = ppr_cnt if year < 2014
(90,504 missing values generated)

. bys athr_id: egen pi_pre_mean  = mean(pre_pprs)

. bys athr_id: egen pi_pre_min   = min(pre_pprs)

. bys athr_id: egen pi_pre_years_active = total(pre_pprs > 0 & !mi(pre_pprs))

. bys athr_id: gen _first = _n == 1

. xtile exp_q_tmp = exposure if _first == 1, n(4)

. bys athr_id: egen exp_q = max(exp_q_tmp)

. drop exp_q_tmp

. 
. program est_and_store
  1.     syntax, name(string) [ if_expr(string) ]
  2.     if "`if_expr'" == "" local if_expr "1==1"
  3.     qui count if _first == 1 & `if_expr'
  4.     local n_pi = r(N)
  5.     qui ppmlhdfe ppr_cnt `1' if `if_expr', absorb(athr_id year) vce(cluste
> r athr_id)
  6.     estimates store `name'
  7.     di as text "  `name'  N_PI=`n_pi'"
  8. end

