. // ---------------- inlined copy of ppml_het_coefplot from analysis.do ------
> ---
. program ppml_het_coefplot
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
  5.     local wsuf ""
  6.     if "$WEIGHT_MSIM" == "1" local wsuf "_msimwt"
  7. 
.     cap confirm file "../temp/phet_results_`samp'`suf'`wsuf'.dta"
  8.     if _rc {
  9.         di as error "ppml_het_coefplot: ../temp/phet_results_`samp'`suf'`w
> suf'.dta not found — skipping"
 10.         exit 0
 11.     }
 12.     local ppml_het_yvars ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any
>  ///
>                         ppr_cnt_notlast cite_affl_wt_notlast ///
>                         avg_num_coathrs num_grants grants_per_paper grant_den
> sity ///
>                         n_first_ppr n_middle_ppr n_last_ppr
 13.     local groups young old high_pre_ppr low_pre_ppr high_grants low_grants
>  ///
>                  big_team small_team
 14.     local n_groups : word count `groups'
 15.     local lbl_young        "Young"
 16.     local lbl_old          "Old"
 17.     local lbl_high_pre_ppr "More Productive at Baseline"
 18.     local lbl_low_pre_ppr  "Less Productive at Baseline"
 19.     local lbl_high_grants  "More Grants per Paper at Baseline"
 20.     local lbl_low_grants   "Fewer Grants per Paper at Baseline"
 21.     local lbl_big_team     "Larger Team Size"
 22.     local lbl_small_team   "Smaller Team Size"
 23. 
.     foreach yvar of local ppml_het_yvars {
 24.         preserve
 25.         use "../temp/phet_results_`samp'`suf'`wsuf'.dta", clear
 26.         keep if yvar == "`yvar'" & spec == "mshrctrl"
 27.         if _N == 0 {
 28.             di as error "ppml_het_coefplot: no rows for `yvar' mshrctrl — 
> skipping"
 29.             restore
 30.             continue
 31.         }
 32.         gen y = .
 33.         local ylabs ""
 34.         local i = 0
 35.         foreach g of local groups {
 36.             local ++i
 37.             local ypos = `n_groups' + 1 - `i'
 38.             qui replace y = `ypos' if grp == "`g'"
 39.             local ylabs `ylabs' `ypos' "`lbl_`g''"
 40.         }
 41.         drop if mi(y) | mi(post_b)
 42.         if _N == 0 {
 43.             di as error "ppml_het_coefplot: `yvar' had rows but no non-mis
> sing post_b — skipping"
 44.             restore
 45.             continue
 46.         }
 47.         gen ub = post_b + 1.96*post_se
 48.         gen lb = post_b - 1.96*post_se
 49.         tw rcap ub lb y, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>            scatter y post_b, mcolor(ebblue) msize(small) ///
>            , xline(0, lcolor(gs10) lpattern(solid)) ///
>              ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>              ytitle("") xtitle("Exposure x Post", size(small)) ///
>              xlabel(, labsize(small)) ///
>              legend(off) ///
>              plotregion(margin(sides))
 50.         graph export "../output/figures/`samp'/ppml_het_coefplot_`yvar'`su
> f'`wsuf'.pdf", replace
 51.         di as text "wrote ../output/figures/`samp'/ppml_het_coefplot_`yvar
> '`suf'`wsuf'.pdf"
 52.         restore
 53.     }
 54. end

. 
. // ---------------- one-shot PPML het regeneration --------------------------
> ---
. program repop_phet_results
  1.     syntax, samp(string)
  2.     local suf "_r1_r2_public"
  3.     local wsuf ""
  4.     local wt ""
  5.     if "$WEIGHT_MSIM" == "1" {
  6.         local wt "[pw=max_sim]"
  7.         local wsuf "_msimwt"
  8.     }
  9.     di as text _newline "=========================================="
 10.     di as text "  repop_phet_results samp=`samp' WEIGHT_MSIM=$WEIGHT_MSIM"
 11.     di as text "=========================================="
 12. 
.     use ../temp/es_`samp'`suf', clear
 13.     gen rel = year - 2014
 14.     qui sum rel, d
 15.     local abs_lag  = abs(r(max))
 16.     local abs_lead = abs(r(min))
 17.     local timeframe = max(`abs_lag', `abs_lead')
 18.     forval i = 1/`timeframe' {
 19.         gen int_lag`i'   = exposure       if rel ==  `i'
 20.         gen int_lead`i'  = exposure       if rel == -`i'
 21.         gen mshr_lag`i'  = mkt_spend_shr  if rel ==  `i'
 22.         gen mshr_lead`i' = mkt_spend_shr  if rel == -`i'
 23.     }
 24.     gen int_lag0  = exposure      if rel == 0
 25.     gen mshr_lag0 = mkt_spend_shr if rel == 0
 26.     ds int_lead* int_lag* mshr_lead* mshr_lag*
 27.     foreach v in `r(varlist)' {
 28.         qui replace `v' = 0 if mi(`v')
 29.     }
 30.     local int_leads
 31.     local int_lags
 32.     local mshr_leads
 33.     local mshr_lags
 34.     forval i = 2/`abs_lead' {
 35.         local int_leads  int_lead`i'  `int_leads'
 36.         local mshr_leads mshr_lead`i' `mshr_leads'
 37.     }
 38.     forval i = 0/`abs_lag' {
 39.         local int_lags  `int_lags'  int_lag`i'
 40.         local mshr_lags `mshr_lags' mshr_lag`i'
 41.     }
 42.     // Group-suffixed interactions for the 8 groups (4 pairs) we plot.
.     foreach grp in young old high_pre_ppr low_pre_ppr high_grants low_grants 
> big_team small_team {
 43.         foreach v of local int_leads {
 44.             gen `v'_`grp' = `v' * `grp'
 45.         }
 46.         foreach v of local int_lags {
 47.             gen `v'_`grp' = `v' * `grp'
 48.         }
 49.         foreach v of local mshr_leads {
 50.             gen `v'_`grp' = `v' * `grp'
 51.         }
 52.         foreach v of local mshr_lags {
 53.             gen `v'_`grp' = `v' * `grp'
 54.         }
 55.         local leads_`grp'
 56.         local lags_`grp'
 57.         local mleads_`grp'
 58.         local mlags_`grp'
 59.         foreach v of local int_leads {
 60.             local leads_`grp' `leads_`grp'' `v'_`grp'
 61.         }
 62.         foreach v of local int_lags {
 63.             local lags_`grp' `lags_`grp'' `v'_`grp'
 64.         }
 65.         foreach v of local mshr_leads {
 66.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
 67.         }
 68.         foreach v of local mshr_lags {
 69.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
 70.         }
 71.     }
 72. 
.     // Fresh phet_results collector (overwrite any stale file).
.     cap postclose ph_handle
 73.     tempname ph_handle
 74.     postfile `ph_handle' str30 yvar str16 grp str12 spec ///
>         double(post_b post_se pre_b pre_se N r2_p) ///
>         using "../temp/phet_results_`samp'`suf'`wsuf'", replace
 75. 
.     local dummy_pairs `" "young old" "high_pre_ppr low_pre_ppr" "high_grants 
> low_grants" "big_team small_team" "'
 76.     local ppml_het_yvars ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any
>  ///
>                          ppr_cnt_notlast cite_affl_wt_notlast ///
>                          avg_num_coathrs num_grants grants_per_paper grant_de
> nsity ///
>                          n_first_ppr n_middle_ppr n_last_ppr
 77. 
.     foreach yvar of local ppml_het_yvars {
 78.         cap confirm variable `yvar'
 79.         if _rc {
 80.             di as text "skip `yvar' (not in panel)"
 81.             continue
 82.         }
 83.         foreach pair of local dummy_pairs {
 84.             local g1 : word 1 of `pair'
 85.             local g2 : word 2 of `pair'
 86.             local ppml_specs mshrctrl
 87.             if "`yvar'" == "ppr_cnt" local ppml_specs base mshrctrl
 88.             foreach spec of local ppml_specs {
 89.                 local mshr_ctrls
 90.                 if "`spec'" == "mshrctrl" {
 91.                     local mshr_ctrls `mleads_`g1'' `mlags_`g1'' `mleads_`g
> 2'' `mlags_`g2''
 92.                 }
 93.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g
> 2'' `lags_`g2'' ///
>                                `mshr_ctrls' `wt', ///
>                                absorb(athr_id year) vce(cluster athr_id)
 94.                 if _rc {
 95.                     di as error "regen: `samp' `yvar' `g1'/`g2' `spec' fai
> led (rc=`_rc'); skipping"
 96.                     continue
 97.                 }
 98.                 local Nppml  = e(N)
 99.                 local r2ppml = e(r2_p)
100.                 foreach grp in `g1' `g2' {
101.                     local n_post = `abs_lag' + 1
102.                     local n_pre  = `abs_lead' - 1
103.                     local sum_post
104.                     foreach v of local lags_`grp' {
105.                         local sum_post `sum_post' + `v'
106.                     }
107.                     local sum_post = substr("`sum_post'", 3, .)
108.                     local sum_pre
109.                     foreach v of local leads_`grp' {
110.                         local sum_pre `sum_pre' + `v'
111.                     }
112.                     local sum_pre = substr("`sum_pre'", 3, .)
113.                     local b_post = .
114.                     local se_post = .
115.                     local b_pre = .
116.                     local se_pre = .
117.                     cap qui lincom (`sum_post') / `n_post'
118.                     if _rc == 0 {
119.                         local b_post = r(estimate)
120.                         local se_post = r(se)
121.                     }
122.                     cap qui lincom (`sum_pre') / `n_pre'
123.                     if _rc == 0 {
124.                         local b_pre = r(estimate)
125.                         local se_pre = r(se)
126.                     }
127.                     post `ph_handle' ("`yvar'") ("`grp'") ("`spec'") ///
>                         (`b_post') (`se_post') (`b_pre') (`se_pre') (`Nppml')
>  (`r2ppml')
128.                 }
129.             }
130.         }
131.     }
132.     postclose `ph_handle'
133.     di as text "wrote ../temp/phet_results_`samp'`suf'`wsuf'.dta"
134. end

. 
. // ---------------- driver: 2 samples x 2 wmodes ----------------------------
> --
. foreach s in all_jrnls top_jrnls {
  2.     foreach wmode in 0 1 {
  3.         global WEIGHT_MSIM `wmode'
  4.         repop_phet_results, samp(`s')
  5.         ppml_het_coefplot,  samp(`s') r1r2(1) public(1)
  6.     }
  7. }

