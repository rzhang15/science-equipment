. // Standalone regenerator for ppml_het_coefplot_<yvar>_r1_r2_public[_msimwt].
> pdf
. // Runs the split-form PPML heterogeneity regressions on the existing
. // ../temp/es_<samp>_r1_r2_public.dta panels (no restrict_samp / event_study
. // rerun needed), overwrites ../temp/phet_results_<samp>...dta, and calls a
. // local copy of ppml_het_coefplot.
. 
. cd /n/home02/cxu75/sci_eq/analysis/reduced_form/code
/n/holylabs/pakes_lab/Lab/sci_eq/analysis/reduced_form/code

. set more off

. clear all

. set matsize 11000
set matsize ignored.
    Matrix sizes are no longer limited by c(matsize) in modern Statas.
