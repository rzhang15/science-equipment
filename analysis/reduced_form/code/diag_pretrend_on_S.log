. // -------------------------------------------------------------
. // (2) PI-LEVEL DELTA: growth_i = y_i,2013 - y_i,2010 regressed on S_i alone.
. // -------------------------------------------------------------
. di as text _newline "===== (2) PI-LEVEL: reg (y2013 - y2010) on S_i ====="

===== (2) PI-LEVEL: reg (y2013 - y2010) on S_i =====

. foreach yvar in ppr_cnt cite_affl_wt {
  2.     preserve
  3.         keep if inlist(year, 2010, 2013)
  4.         keep athr_id year mkt_spend_shr `yvar'
  5.         reshape wide `yvar', i(athr_id mkt_spend_shr) j(year)
  6.         gen d_`yvar'    = `yvar'2013 - `yvar'2010
  7.         gen ln_d_`yvar' = ln(1 + `yvar'2013) - ln(1 + `yvar'2010)
  8.         di as text _newline "--- `yvar' level delta ---"
  9.         reg d_`yvar' mkt_spend_shr, vce(robust)
 10.         di as text _newline "--- `yvar' log delta ---"
 11.         reg ln_d_`yvar' mkt_spend_shr, vce(robust)
 12.     restore
 13. }
