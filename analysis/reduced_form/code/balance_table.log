. cap mkdir ../output/tables

. cap mkdir ../output/tables/`samp'

. matrix_to_txt, saving("../output/tables/`samp'/balance_pi`suf'.txt") ///
>     matrix(balance) title(<tab:balance_pi`suf'>) format(%20.4f) replace

. matrix_to_txt, saving("../output/tables/`samp'/balance_area`suf'.txt") ///
>     matrix(balance_area) title(<tab:balance_area`suf'>) format(%20.4f) replac
> e

. 
. local bs = char(92)

. local tex_vars ppr_cnt ppr_cnt_any cite_affl_wt n_grants nih_cost_k exposure 
> mkt_spend_shr yrs_lab_2014 public nih_athr

. local tex_fmts %9.3f   %9.3f       %9.3f        %9.3f    %15.3fc    %9.3f    
> %9.3f         %9.3f        %9.3f  %9.3f

. local tex_ns   NPIs    NPIs        NPIs         NNIHMatched NNIHMatched NPIs 
> NPIs          NPIs         NPIs   NPIs

. local i = 0

. foreach v of local tex_vars {
  2.     local ++i
  3.     local fmt : word `i' of `tex_fmts'
  4.     local nmac : word `i' of `tex_ns'
  5.     local r = rownumb(balance, "`v'")
  6.     local cells_`v' ""
  7.     forval c = 1/7 {
  8.         local x = balance[`r',`c']
  9.         local f `fmt'
 10.         if `c' == 7 local f %9.3f
 11.         local cell = subinstr(trim(string(`x', "`f'")), ",", "{,}", .)
 12.         if `c' == 6 local cell (`cell')
 13.         local cells_`v' "`cells_`v'' & `cell'"
 14.     }
 15.     local cells_`v' "`cells_`v'' & `bs'`nmac'"
 16. }

. local n_low_c    = subinstr(string(`n_low',    "%12.0fc"), ",", "{,}", .)

. local n_high_c   = subinstr(string(`n_high',   "%12.0fc"), ",", "{,}", .)

. local n_low_nihc = subinstr(string(`n_low_nih',  "%12.0fc"), ",", "{,}", .)

. local n_high_nihc= subinstr(string(`n_high_nih', "%12.0fc"), ",", "{,}", .)

. local exp_med_c  = string(`exp_med', "%9.3f")

. 
. local out ../output/tables/`samp'/balance_pi`suf'.tex

. tempname fh

. file open `fh' using "`out'", write replace

. file write `fh' "\begin{table}[H]" _n

. file write `fh' "\centering" _n

. file write `fh' "\caption{Balance Across More- and Less-Exposed PIs}" _n

. file write `fh' "\label{tab:balance_pi}" _n

. file write `fh' "\setstretch{1}" _n

. file write `fh' "\setlength{\tabcolsep}{3pt}" _n

. file write `fh' "\resizebox{\textwidth}{!}{%" _n

. file write `fh' "\begin{tabular}{@{}l*{7}{d{3.3}}r@{}}" _n

. file write `fh' "\toprule" _n

. file write `fh' " & \multicolumn{2}{c}{Less exposed} & \multicolumn{2}{c}{Mor
> e exposed} & \multicolumn{2}{c}{Difference} & & \\" _n

. file write `fh' "\cmidrule(lr){2-3} \cmidrule(lr){4-5} \cmidrule(lr){6-7}" _n

. file write `fh' " & \mc{Mean} & \mc{SD} & \mc{Mean} & \mc{SD} & \mc{Coef.} & 
> \mc{(SE)} & \mc{\$p\$-value} & N \\" _n

. file write `fh' "\midrule" _n

. file write `fh' "\multicolumn{9}{l}{\textit{Panel A: Pre-period (2010--2013) 
> PI averages}} \\" _n

. file write `fh' "\quad Publications (last author) `cells_ppr_cnt' \\" _n

. file write `fh' "\quad Publications (any position) `cells_ppr_cnt_any' \\" _n

. file write `fh' "\quad Citation-weighted output `cells_cite_affl_wt' \\" _n

. file write `fh' "\quad Active NIH grants `cells_n_grants' \\" _n

. file write `fh' "\quad NIH funding (" _char(92) _char(36) " thousands) `cells
> _nih_cost_k' \\" _n

. file write `fh' "\addlinespace" _n

. file write `fh' "\multicolumn{9}{l}{\textit{Panel B: PI characteristics}} \\"
>  _n

. file write `fh' "\quad Exposure measure `cells_exposure' \\" _n

. file write `fh' "\quad Treated-market share \$S_i\$ `cells_mkt_spend_shr' \\"
>  _n

. file write `fh' "\quad Years as PI in 2014 `cells_yrs_lab_2014' \\" _n

. file write `fh' "\quad Public university `cells_public' \\" _n

. file write `fh' "\quad Matched to NIH records `cells_nih_athr' \\" _n

. file write `fh' "\bottomrule" _n

. file write `fh' "\end{tabular}%" _n

. file write `fh' "}" _n

. file write `fh' "\floatfoot{\textit{Notes:} One observation per PI in the all
> -journal R1 and R2 panel (\NPIs\ PIs, `n_low_c' less-exposed and `n_high_c' m
> ore-exposed). More-exposed PIs are those whose exposure measure is above its 
> median across PIs (`exp_med_c'); less-exposed PIs are at or below the median.
>  N is the number of PIs in each row." _n

. file write `fh' "Panel A averages each outcome over a PI's pre-merger years, 
> 2010--2013." _n

. file write `fh' "Active NIH grants and NIH funding are observed only for PIs 
> matched to NIH records (`n_low_nihc' less-exposed and `n_high_nihc' more-expo
> sed PIs)." _n

. file write `fh' "Panel B reports time-invariant PI characteristics. Years as 
> PI is the number of years since a PI's first last-authored publication, measu
> red in 2014. Public university and matched to NIH records are shares." _n

. file write `fh' "The exposure measure and treated-market share \$S_i\$ are th
> e shift-share cost increase and the pre-merger treated-market spending share 
> defined in Section~\ref{sec:exposure}, observed for FOIA PIs and imputed for 
> the rest." _n

. file write `fh' "Difference is the more-exposed minus less-exposed mean, with
>  heteroskedasticity-robust standard errors in parentheses and the \$p\$-value
>  of the two-sided test that it equals zero.}" _n

. file write `fh' "\end{table}" _n

. file close `fh'

. di as text "wrote `out'"
wrote ../output/tables/all_jrnls/balance_pi_r1_r2.tex

. 
. local d = char(36)

. local na : word count `clus_vars'

. forval r = 1/`na' {
  2.     local acells`r' ""
  3.     forval c = 1/7 {
  4.         local v = balance_area[`r',`c']
  5.         local cell = trim(string(abs(`v'), "%9.3f"))
  6.         if `v' < 0 local cell `d'-`d'`cell'
  7.         if `c' == 6 local cell (`cell')
  8.         local acells`r' "`acells`r'' & `cell'"
  9.     }
 10. }

. 
. local out ../output/tables/`samp'/balance_area`suf'.tex

. file open `fh' using "`out'", write replace

. file write `fh' "\begin{table}[H]" _n

. file write `fh' "\centering" _n

. file write `fh' "\caption{Research Areas of More- and Less-Exposed PIs}" _n

. file write `fh' "\label{tab:balance_area}" _n

. file write `fh' "\setstretch{1}" _n

. file write `fh' "\setlength{\tabcolsep}{3pt}" _n

. file write `fh' "\begin{tabular}{@{}l*{7}{r}@{}}" _n

. file write `fh' "\toprule" _n

. file write `fh' " & \multicolumn{2}{c}{Less exposed} & \multicolumn{2}{c}{Mor
> e exposed} & \multicolumn{2}{c}{Difference} & \\" _n

. file write `fh' "\cmidrule(lr){2-3} \cmidrule(lr){4-5} \cmidrule(lr){6-7}" _n

. file write `fh' " & Share & SD & Share & SD & Coef. & (SE) & \$p\$-value \\" 
> _n

. file write `fh' "\midrule" _n

. local r = 0

. foreach lab of local clus_labs {
  2.     local ++r
  3.     file write `fh' "`lab' `acells`r'' \\" _n
  4. }

. file write `fh' "\midrule" _n

. file write `fh' "Number of PIs & `n_low_c' & & `n_high_c' & & & & \\" _n

. file write `fh' "\bottomrule" _n

. file write `fh' "\end{tabular}" _n

. file write `fh' "\floatfoot{\textit{Notes:} One observation per PI in the all
> -journal R1 and R2 panel (\NPIs\ PIs). More-exposed PIs are those whose expos
> ure measure is above its median across PIs (`exp_med_c'); less-exposed PIs ar
> e at or below the median." _n

. file write `fh' "Each row is the share of PIs whose pre-period publication te
> xt falls in one of six research areas, formed by grouping the 30 topical clus
> ters of PI publication text; shares in each column sum to one." _n

. file write `fh' "Difference is the more-exposed minus less-exposed share, wit
> h heteroskedasticity-robust standard errors in parentheses and the \$p\$-valu
> e of the two-sided test that it equals zero.}" _n

. file write `fh' "\end{table}" _n

. file close `fh'

. di as text "wrote `out'"
wrote ../output/tables/all_jrnls/balance_area_r1_r2.tex

. 
. keep area high

. gen one = 1

. gcollapse (count) n = one, by(area high)

. bys high: egen tot = total(n)

. gen share = 100 * n / tot

. drop n tot

. reshape wide share, i(area) j(high)
(j = 0 1)

Data                               Long   ->   Wide
-----------------------------------------------------------------------------
Number of observations               12   ->   6           
Number of variables                   3   ->   3           
j variable (2 values)              high   ->   (dropped)
xij variables:
                                  share   ->   share0 share1
-----------------------------------------------------------------------------

. gen diff = share1 - share0

. gsort -diff

. gen pos    = `n_area' + 1 - _n

. gen pos_lo = pos + 0.19

. gen pos_hi = pos - 0.19

. gen lab0 = string(share0, "%4.1f")

. gen lab1 = string(share1, "%4.1f")

. local ylabs ""

. forval i = 1/`n_area' {
  2.     local ylabs `"`ylabs' `=pos[`i']' "`: label area `=area[`i']''""'
  3. }

. qui sum share0

. local xmax = r(max)

. qui sum share1

. local xmax = 1.12 * max(`xmax', r(max))

. tw (bar share0 pos_lo, horizontal barwidth(0.34) color(ebblue)) ///
>    (bar share1 pos_hi, horizontal barwidth(0.34) color(dkorange)) ///
>    (scatter pos_lo share0, msymbol(none) mlabel(lab0) mlabpos(3) mlabcolor(bl
> ack) mlabsize(small)) ///
>    (scatter pos_hi share1, msymbol(none) mlabel(lab1) mlabpos(3) mlabcolor(bl
> ack) mlabsize(small)), ///
>     ylabel(`ylabs', angle(0) nogrid labsize(small) notick) ytitle("") yscale(
> lstyle(none)) ///
>     xlabel(none) xtick(none) xscale(range(0 `xmax') lstyle(none)) ///
>     xtitle("Share of PIs (%)", color(black)) ///
>     legend(order(1 "Less exposed" 2 "More exposed") pos(12) ring(1) rows(1) s
> ize(small) region(lstyle(none)))

. cap mkdir ../output/figures

. cap mkdir ../output/figures/`samp'

. graph export ../output/figures/`samp'/balance_area`suf'.pdf, replace
file ../output/figures/all_jrnls/balance_area_r1_r2.pdf saved as PDF format

. 
end of do-file
