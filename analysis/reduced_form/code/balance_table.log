. program fill_stats
  1.     syntax, mat(name) vars(varlist)
  2.     local nr : word count `vars'
  3.     mat `mat' = J(`nr',9,.)
  4.     local r = 0
  5.     foreach v of local vars {
  6.         local ++r
  7.         qui sum `v' if high == 0
  8.         mat `mat'[`r',1] = r(mean)
  9.         mat `mat'[`r',2] = r(sd)
 10.         local sd_l = r(sd)
 11.         qui sum `v' if high == 1
 12.         mat `mat'[`r',3] = r(mean)
 13.         mat `mat'[`r',4] = r(sd)
 14.         local sd_h = r(sd)
 15.         qui reg `v' high, r
 16.         mat `mat'[`r',5] = _b[high]
 17.         mat `mat'[`r',6] = _se[high]
 18.         mat `mat'[`r',7] = 2 * ttail(e(df_r), abs(_b[high] / _se[high]))
 19.         mat `mat'[`r',8] = _b[high] / sqrt((`sd_l'^2 + `sd_h'^2) / 2)
 20.         mat `mat'[`r',9] = e(N)
 21.     }
 22.     mat rownames `mat' = `vars'
 23.     mat colnames `mat' = mean_low sd_low mean_high sd_high diff se p normd
> iff N
 24.     mat list `mat', format(%12.4f)
 25. end

. 
. use ../output/prepped_samples/es_`samp'`suf', clear

. gen nih_cost_k   = nih_total_cost / 1000
(59,850 missing values generated)

. gen yrs_lab_2014 = 2014 - min_year

. replace foia_athr = 0 if mi(foia_athr)
(134,330 real changes made)

. 
. local out_vars ppr_cnt ppr_cnt_any cite_affl_wt avg_num_coathrs n_grants nih_
> cost_k

. local pi_vars  exposure mkt_spend_shr yrs_lab_2014 public nih_athr foia_athr

. foreach v in `pi_vars' cluster_30 {
  2.     qui gegen _chk = sd(`v'), by(athr_id)
  3.     qui count if _chk > 0 & !mi(_chk)
  4.     if r(N) > 0 di as error "`v' varies within athr_id for " r(N) " PI-yea
> rs"
  5.     drop _chk
  6. }

. 
. keep if year < 2014
(81,090 observations deleted)

. gcollapse (mean) `out_vars' (first) `pi_vars' cluster_30, by(athr_id)

. 
. qui sum exposure, d

. local exp_med = r(p50)

. gen byte high = exposure > `exp_med'

. qui count if high == 0

. local n_low = r(N)

. qui count if high == 1

. local n_high = r(N)

. qui count if !mi(n_grants) & high == 0

. local n_low_nih = r(N)

. qui count if !mi(n_grants) & high == 1

. local n_high_nih = r(N)

. di as text "exposure median = " %8.4f `exp_med' "; PIs: less-exposed `n_low',
>  more-exposed `n_high'"
exposure median =   0.0214; PIs: less-exposed 6758, more-exposed 6757

