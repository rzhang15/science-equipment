. recode cluster_30 (2 19 21 = 1) (4 14 = 2) (7 20 = 3) (12 17 18 = 4) (0 1 6 2
> 7 = 5) ///
>                   (3 5 8 9 10 11 13 15 16 22 23 24 25 26 28 29 = 6), gen(area
> )
(13515 differences between cluster_30 and area)

. label define area 1 "Molecular and cellular biology" 2 "Materials and bioengi
> neering" ///
>                   3 "Biochemistry and chemistry" 4 "Neuroscience and cognitio
> n" ///
>                   5 "Organismal and environmental biology" 6 "Clinical and di
> sease research"

. label values area area

. local n_area 6

. local clus_vars ""

. local clus_labs ""

. forval a = 1/`n_area' {
  2.     gen byte area_`a' = area == `a' if !mi(area)
  3.     local clus_vars `clus_vars' area_`a'
  4.     local clus_labs `"`clus_labs' "`: label area `a''""'
  5. }

