. local n_top 5

. preserve

.     contract cluster_30 if !mi(cluster_30)

.     gsort -_freq

.     keep in 1/`n_top'
(20 observations deleted)

.     forval i = 1/`n_top' {
  2.         local top_clus `top_clus' `=cluster_30[`i']'
  3.     }

. restore

. di as text "top `n_top' research clusters by PI count: `top_clus'"
top 5 research clusters by PI count: 2 4 7 12 18

. local clus_vars ""

. local clus_labs ""

. foreach k of local top_clus {
  2.     gen byte clus_`k' = cluster_30 == `k' if !mi(cluster_30)
  3.     local clus_vars `clus_vars' clus_`k'
  4.     local clus_labs `"`clus_labs' "`clbl`k''""'
  5. }

. gen byte clus_other = !inlist(cluster_30, `=subinstr("`top_clus'", " ", ",", 
> .)') if !mi(cluster_30)

. local clus_vars `clus_vars' clus_other

. local clus_labs `"`clus_labs' "Other research areas""'

