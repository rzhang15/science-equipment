. *---- 4) trim top N PIs by leverage on int_lag2 ----*
. gen pre_pprs = ppr_cnt if year < 2014
(34,374 missing values generated)

. bys athr_id: egen pi_pre_mean = mean(pre_pprs)

. gen dev_2016 = ppr_cnt - pi_pre_mean if rel == 2
(51,561 missing values generated)

. gen leverage_2016 = exposure * dev_2016 if rel == 2
(51,561 missing values generated)

. bys athr_id: egen leverage_pi = max(leverage_2016)

. gsort -leverage_pi athr_id

. 
. * Rank PIs by leverage_pi and try dropping top 10 / 25 / 50 / 100.
. bys athr_id: gen _first = _n == 1

. gen lev_rank = .
(57,290 missing values generated)

. qui replace lev_rank = sum(_first) if _first == 1

. bys athr_id: egen pi_lev_rank = max(lev_rank)

. 
. foreach n in 10 25 50 100 {
  2.     preserve
  3.     di as text _newline "======= 4) drop top `n' PIs by leverage on int_la
> g2 ======="
  4.     drop if pi_lev_rank <= `n'
  5.     di as text "--- base ---"
  6.     qui ppmlhdfe ppr_cnt `ileads' `ilags', absorb(athr_id year) vce(cluste
> r athr_id)
  7.     estimates store trim`n'_base
  8.     di as text "--- +mshr ---"
  9.     qui ppmlhdfe ppr_cnt `ileads' `ilags' `mleads' `mlags', absorb(athr_id
>  year) vce(cluster athr_id)
 10.     estimates store trim`n'_mshr
 11.     restore
 12. }

