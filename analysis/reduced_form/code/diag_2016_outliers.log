. *---- 5) drop PIs whose 2016 ppr_cnt exceeds 3x their pre-period mean (Cook-s
> tyle) ----*
. gen mult_2016 = ppr_cnt / pi_pre_mean if rel == 2 & pi_pre_mean > 0
(51,561 missing values generated)

. bys athr_id: egen pi_mult = max(mult_2016)

. foreach thresh in 5 3 2 {
  2.     preserve
  3.     di as text _newline "======= 5) drop PIs with 2016/pre_mean >= `thresh
> ' ======="
  4.     count if pi_mult >= `thresh' & _first == 1
  5.     drop if pi_mult >= `thresh'
  6.     di as text "--- base ---"
  7.     qui ppmlhdfe ppr_cnt `ileads' `ilags', absorb(athr_id year) vce(cluste
> r athr_id)
  8.     estimates store mult`thresh'_base
  9.     di as text "--- +mshr ---"
 10.     qui ppmlhdfe ppr_cnt `ileads' `ilags' `mleads' `mlags', absorb(athr_id
>  year) vce(cluster athr_id)
 11.     estimates store mult`thresh'_mshr
 12.     restore
 13. }

