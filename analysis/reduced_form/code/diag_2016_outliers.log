. *---- 3) winsorize ppr_cnt at various percentiles ----*
. foreach p in 99 97 95 {
  2.     preserve
  3.     qui sum ppr_cnt, d
  4.     local cap = r(p`p')
  5.     di as text "  winsorize ppr_cnt at p`p' = " `cap'
  6.     replace ppr_cnt = `cap' if ppr_cnt > `cap' & !mi(ppr_cnt)
  7.     di as text "--- winsor p`p' base ---"
  8.     qui ppmlhdfe ppr_cnt `ileads' `ilags', absorb(athr_id year) vce(cluste
> r athr_id)
  9.     estimates store wp`p'_base
 10.     di as text "--- winsor p`p' +mshr ---"
 11.     qui ppmlhdfe ppr_cnt `ileads' `ilags' `mleads' `mlags', absorb(athr_id
>  year) vce(cluster athr_id)
 12.     estimates store wp`p'_mshr
 13.     restore
 14. }
