. program restrict_samp
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
  5. 
.     // all-authors counterpart: same file name minus the "last_" token.
.     // Contains ppr_cnt / cite_affl_wt / affl_wt counting papers where the PI
.     // appears in ANY authorship position (not just last). Also carries paper-
.     // position metrics (avg_position, avg_position_rat, n_first/middle/last_ppr,
.     // avg_team_size_(last|notlast)) once make_athr_yr_panel/build.do has been
.     // rerun — the load is wrapped in cap so the pipeline still works with the
.     // pre-position-metrics build; a global flag toggles whether position
.     // outcomes are added downstream.
.     preserve
  6.         cap use athr_id year ppr_cnt cite_affl_wt affl_wt ///
>                 avg_position avg_position_rat ///
>                 n_first_ppr n_middle_ppr n_last_ppr ///
>                 avg_team_size_last avg_team_size_notlast ///
>                 using ../external/samp/athr_panel_full_year_`samp'`suf', clear
  7.         local _pos_rc = _rc
  8.         if `_pos_rc' {
  9.             di as text "restrict_samp `samp'`suf': position vars not in panel yet — falling back to base _any outcomes. Rerun make_athr_yr_panel/code/build.do to enable them."
 10.             use athr_id year ppr_cnt cite_affl_wt affl_wt ///
>                 using ../external/samp/athr_panel_full_year_`samp'`suf', clear
 11.         }
 12.         global POSITION_OUTCOMES_AVAIL = cond(`_pos_rc' == 0, 1, 0)
 13.         rename (ppr_cnt cite_affl_wt affl_wt) (ppr_cnt_any cite_affl_wt_any affl_wt_any)
 14.         save ../temp/athr_any_`samp'`suf', replace
 15. 
.         // Per-PI min year across ALL authorship positions -- used below to
.         // build age_2014. Under the last-author panel's min_year, a PI who
.         // published as first/middle author for years before their first
.         // last-author paper looked spuriously young.
.         bys athr_id: egen min_year_any = min(year)
 16.         keep athr_id min_year_any
 17.         duplicates drop
 18.         save ../temp/athr_min_year_any_`samp'`suf', replace
 19.     restore
 20. 
.     use ../external/samp/athr_panel_full_year_last_`samp'`suf',clear
 21. *    bys athr_id: egen tot_pprs = total(ppr_cnt)
.     bys athr_id: egen max_year = max(year)
 22.     bys athr_id: egen min_year = min(year) 
 23.     keep if min_year <= 2013
 24.     keep if max_year >= 2015 
 25.     keep if inrange(year, 2010, 2019)
 26.     merge m:1 athr_id using ../temp/exposure, assert(1 2 3) keep(3) nogen
 27.     merge m:1 athr_id using ../external/real_exposure/athr_exposure_${EXPOSURE_VERSION}, assert(1 2 3) keep(1 3) nogen
 28.     merge m:1 athr_id using ../temp/athr_cluster30, keep(1 3) nogen
 29.     merge m:1 athr_id using ../temp/athr_min_year_any_`samp'`suf', keep(1 3) nogen
 30.     // Safety fallback: if a PI is somehow missing from the all-authors panel,
.     // reuse the last-author min_year so age_2014 isn't left missing.
.     replace min_year_any = min_year if mi(min_year_any)
 31.     gen foia_athr = 1 if !mi(exposure)
 32.     // Merge max_sim (universe match confidence). Real FOIA PIs get max_sim = 1
.     // — they contribute observed exposure so imputation confidence isn't
.     // meaningful. Imputed PIs keep their similarity to the nearest FOIA PI.
.     // If unmatched (rare), max_sim stays missing and is set to 0 below so the
.     // PI drops out of any [pw=max_sim] regression cleanly.
.     merge m:1 athr_id using ../temp/match_diag, keep(1 3) nogen
 33.     replace max_sim = 1 if foia_athr == 1
 34.     replace max_sim = 0 if mi(max_sim)
 35.     bys athr_id : gen athr_indicator = _n == 1
 36.     sum exposure if athr_indicator == 1, d
 37.     local mean : di %4.3f r(mean)
 38.     local sd   : di %4.3f r(sd)
 39.     sum imputed if athr_indicator == 1, d
 40.     local imputed_mean : di %4.3f r(mean)
 41.     local imputed_sd   : di %4.3f r(sd)
 42.     sum mkt_spend_shr if athr_indicator == 1, d
 43.     local mshr_mean : di %4.3f r(mean)
 44.     local mshr_sd   : di %4.3f r(sd)
 45.     sum imputed_mkt_spend_shr if athr_indicator == 1, d
 46.     local imshr_mean : di %4.3f r(mean)
 47.     local imshr_sd   : di %4.3f r(sd)
 48.     tw kdensity exposure if athr_indicator == 1   || kdensity imputed if athr_indicator == 1  , xtitle("Exposure Measure") ytitle("Density") ///
>         xlab(#15) ///
>         legend(on label(1 "FOIA PI Observed Exposure (mean = `mean', sd = `sd')") label(2 "Imputed Exposure (mean = `imputed_mean', sd = `imputed_sd')") pos(7) ring(1) size(small))
 49.     graph export ../output/figures/`samp'/exposure_dist`suf'.pdf, replace
 50.     tw kdensity mkt_spend_shr if athr_indicator == 1  || kdensity imputed_mkt_spend_shr if athr_indicator == 1, xtitle("Market Spend Share") ytitle("Density") ///
>         xlab(#15) ///
>         legend(on label(1 "FOIA PI Observed (mean = `mshr_mean', sd = `mshr_sd')") label(2 "Imputed (mean = `imshr_mean', sd = `imshr_sd')") pos(7) ring(1) size(small))
 51.     graph export ../output/figures/`samp'/mkt_spend_shr_dist`suf'.pdf, replace
 52.     replace imputed = exposure if !mi(exposure)
 53.     replace imputed_mkt_spend_shr = mkt_spend_shr if !mi(mkt_spend_shr)
 54.     drop exposure
 55.     rename imputed exposure
 56.     drop mkt_spend_shr
 57.     rename imputed_mkt_spend_shr mkt_spend_shr
 58.     bys athr_id: egen num_yrs_pre = total(year < 2014)
 59.     bys athr_id: gen tot_yrs = _N 
 60.     bys athr_id inst_id: gen plc_cntr = _n == 1
 61.     bys athr_id : egen num_place = total(plc_cntr)
 62.     drop if num_yrs <= 2
 63. *    drop if tot_yrs <= 4
.     keep if num_place==1
 64.     gegen athr = group(athr_id)
 65.     preserve
 66.     contract athr num_place athr_id exposure inst_id inst msa_comb msa_c_world min_year min_year_any type mkt_spend_shr cluster_30 max_sim foia_athr
 67.     drop _freq
 68.     save ../temp/athr_xw, replace
 69.     restore
 70.     xtset athr year
 71.     tsfill, full
 72.     drop athr_id exposure inst_id inst msa_comb msa_c_world min_year min_year_any type mkt_spend_shr cluster_30 max_sim foia_athr
 73.     merge m:1 athr using ../temp/athr_xw, assert(3) keep(3) nogen
 74.     // The last-author panel *also* carries position vars (build.do computes them
.     // for both branches). Under Stata's merge default, master-side variables
.     // override same-named using-side variables silently — so if we don't drop
.     // these first, the athr_any values would be discarded and we'd keep the
.     // degenerate last-author-panel copies (where which_athr == num_athrs
.     // makes n_first_ppr into a solo-only count, n_middle_ppr uniformly zero, etc.).
.     foreach v in n_first_ppr n_middle_ppr n_last_ppr n_solo_ppr ///
>                  avg_position avg_position_rat ///
>                  avg_team_size_last avg_team_size_notlast {
 75.         cap drop `v'
 76.     }
 77.     // Merge in all-authors counts (any authorship position) as parallel outcomes.
.     // Kept on the same tsfilled PI x year grid; missings after tsfill mean "no
.     // papers that year in the all-authors panel either" → filled to 0 below.
.     merge 1:1 athr_id year using ../temp/athr_any_`samp'`suf', keep(1 3) nogen
 78.     foreach var in ppr_cnt cite_affl_wt affl_wt ppr_cnt_any cite_affl_wt_any affl_wt_any {
 79.         replace `var' = 0 if mi(`var')
 80.     }
 81.     // Position-metric outcomes (from all-authors panel via athr_any merge):
.     //   counts: zero-fill (mi means the PI had no papers of that role that year)
.     //   means : leave missing when PI publishes nothing that year, so β on the
.     //           mean-based outcomes is intensive-margin only (same convention
.     //           as avg_num_coathrs).
.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
 82.         foreach v in n_first_ppr n_middle_ppr n_last_ppr {
 83.             replace `v' = 0 if mi(`v')
 84.         }
 85.         // Retro-fix for double-counted solo-author papers: in the build.do
.         // preceding the 2026-07-10 fix, solo papers had paper_is_first == 1
.         // AND paper_is_last == 1. The excess (which_first + n_middle + n_last -
.         // ppr_cnt_any) equals n_solo, so we subtract it from n_first to keep
.         // the "last/senior" convention consistent. Post-rebuild this line is a
.         // no-op (the sum already matches ppr_cnt_any).
.         cap confirm variable n_solo_ppr
 86.         if _rc {
 87.             gen n_solo_ppr = n_first_ppr + n_middle_ppr + n_last_ppr - ppr_cnt_any
 88.             replace n_solo_ppr = 0 if n_solo_ppr < 0
 89.             replace n_first_ppr = n_first_ppr - n_solo_ppr
 90.             replace n_first_ppr = 0 if n_first_ppr < 0
 91.         }
 92.         // avg_position, avg_position_rat, avg_team_size_last, avg_team_size_notlast
.         // remain missing when no papers of the relevant type exist that year.
.     }
 93.     // _notlast = _any - _last is deferred to AFTER the winsorization block
.     // below so the diff uses the same p99-capped components that flow into
.     // the base and _any regressions. Computing before winsorization would
.     // leave the diff carrying raw mega-cite tails while the components are
.     // capped — asymmetric outcomes.
.     gen pre_ppr_cnt = ppr_cnt if year < 2014
 94.     bys athr_id: egen pre_ppr_cnt_sum = sum(pre_ppr_cnt)
 95.     bys athr_id: egen pre_ppr_cnt_avg = mean(pre_ppr_cnt)
 96.     qui sum pre_ppr_cnt_avg if athr_indicator == 1, d
 97.     drop if pre_ppr_cnt_avg <= r(p5)
 98.     // Median split at PI level (one row per athr_id); save cut into a local
.     // because `drop if` below clears r(), which silently made high_pre_ppr = 0
.     // for everyone (`x >= .` is FALSE, so all obs became "low").
.     qui sum pre_ppr_cnt_sum if athr_indicator == 1, d
 99.     local ppr_cut = r(p50)
100.     drop if pre_ppr_cnt_sum <= r(p5)
101.     gen high_pre_ppr = pre_ppr_cnt_sum >= `ppr_cut'
102.     gen low_pre_ppr  = pre_ppr_cnt_sum <  `ppr_cut'
103.     // Career age proxy: first year in the all-authors panel (any position),
.     // not just first year as last author -- see restrict_samp preserve block.
.     gen age_2014 = 2014 - min_year_any + 30
104.     sum age_2014, d
105.     local med = r(p50)
106.     gen young = age_2014 < `med'
107.     gen old = age_2014 >= `med'
108.     gen r1 = type == "r1" 
109.     gen r2 = type == "r2" 
110.     drop if mi(exposure)  
111.     drop if mi(mkt_spend_shr) | mkt_spend_shr <= 0
112.     sum exposure if athr_indicator == 1, d
113.     gen median = exposure >= r(p50)
114.     merge 1:1 athr_id year using ../external/coathrs/avg_coathrs, keep(1 3) assert(1 2 3) nogen
115.     replace avg_num_coathrs = 0 if mi(avg_num_coathrs)
116.     // Intensive-margin only: team size is undefined in years the PI publishes
.     // nothing. Setting to missing means reghdfe/ppmlhdfe drop those rows and
.     // β on Z_it is "conditional on publishing, does exposure shift team size,"
.     // not confounded by the extensive margin. Report N alongside β so any
.     // sample composition shift is visible.
.     replace avg_num_coathrs = . if ppr_cnt == 0
117.     merge 1:1 athr_id year using ../temp/athr_yr_grnt_cnt, keep(1 3) assert(1 2 3) nogen
118.     replace num_grants = 0 if mi(num_grants)
119. 
.     // Derived grants outcomes — both sidestep the num_grants mechanical
.     // confounding by paper counts flagged in the audit.
.     //   grants_per_paper : distinct grants cited per paper in the year;
.     //     intensive-margin — β tells you whether each paper cites fewer grants
.     //     (e.g. PIs pushed toward unfunded work). Undefined when ppr_cnt == 0.
.     //   grant_density    : num_grants scaled by the PI's *pre-period* mean
.     //     ppr_cnt (constant per PI). Denominator is fixed pre-2014 so post-
.     //     period changes in ppr_cnt do not mechanically move it — β isolates
.     //     "given typical output rate, how many grants are now cited."
.     gen grants_per_paper = num_grants / ppr_cnt         if ppr_cnt > 0
120.     gen grant_density    = num_grants / pre_ppr_cnt_avg if pre_ppr_cnt_avg > 0
121. 
.     gen pre_grants_cnt = num_grants if year < 2014
122.     bys athr_id: egen pre_grants_sum = total(pre_grants_cnt)
123.     drop pre_grants_cnt
124.     // Split on pre-period grants PER PAPER (ratio of totals — robust to years
.     // with ppr_cnt == 0). pre_ppr_cnt_sum >= 5 for all remaining PIs after
.     // the p5 drop above, so denominator is safe.
.     gen pre_gpp = pre_grants_sum / pre_ppr_cnt_sum
125.     qui sum pre_gpp if athr_indicator == 1, d
126.     local g_cut = r(p50)
127.     di as text "restrict_samp `samp'`suf' pre-gpp median = `g_cut'"
128.     gen high_grants = pre_gpp >= `g_cut'
129.     gen low_grants  = pre_gpp <  `g_cut'
130. 
.     // Additional pre-period heterogeneity splits (median splits)
.     //   big_team  / small_team    : mean pre-period avg_team_size
.     //   many_coauth / few_coauth  : mean pre-period n_coauthors_yr
.     //   big_msa   / small_msa     : msa_size at 2014 (metro scientific mass)
.     gen pre_team_yr = avg_team_size if year < 2014
131.     bys athr_id: egen pre_team_avg = mean(pre_team_yr)
132.     drop pre_team_yr
133.     qui sum pre_team_avg if athr_indicator == 1, d
134.     di as text "restrict_samp `samp'`suf' pre-team median = " r(p50)
135.     gen big_team   = pre_team_avg >= r(p50)
136.     gen small_team = pre_team_avg <  r(p50)
137. 
.     gen pre_coauth_yr = n_coauthors_yr if year < 2014
138.     bys athr_id: egen pre_coauth_avg = mean(pre_coauth_yr)
139.     drop pre_coauth_yr
140.     qui sum pre_coauth_avg if athr_indicator == 1, d
141.     di as text "restrict_samp `samp'`suf' pre-n-coauth median = " r(p50)
142.     gen many_coauth = pre_coauth_avg >= r(p50)
143.     gen few_coauth  = pre_coauth_avg <  r(p50)
144. 
.     gen msa_size_2014 = msa_size if year == 2014
145.     bys athr_id: egen msa_size_at = max(msa_size_2014)
146.     drop msa_size_2014
147.     qui sum msa_size_at if athr_indicator == 1, d
148.     di as text "restrict_samp `samp'`suf' msa_size median = " r(p50)
149.     gen big_msa   = msa_size_at >= r(p50)
150.     gen small_msa = msa_size_at <  r(p50)
151. 
.     // Winsorize cite_affl_wt / affl_wt at pooled p99 to cap mega-cite outliers
.     // (e.g. A5001670387 hit cite_affl_wt=1092 in 2016 vs a p99 ~25).
.     // Same treatment for the _any counterparts so the two versions of each
.     // outcome are affected symmetrically.
.     foreach v in cite_affl_wt affl_wt cite_affl_wt_any affl_wt_any {
152.         qui sum `v', d
153.         local p99_`v' = r(p99)
154.         replace `v' = `p99_`v'' if `v' > `p99_`v'' & !mi(`v')
155.         di as text "restrict_samp `samp'`suf' winsorized `v' at p99=`p99_`v''"
156.     }
157. 
.     // _notlast = _any - _last, computed on the winsorized components so all
.     // three flavors (last / any / notlast) sit on the same scale.
.     // Interpretation: β on _notlast tells you whether the PI's collaboration
.     // participation moved; a big drop in _last with flat _notlast says the PI
.     // is losing senior-role papers but not the ones they contribute to as a
.     // middle author.
.     gen ppr_cnt_notlast      = ppr_cnt_any      - ppr_cnt
158.     gen cite_affl_wt_notlast = cite_affl_wt_any - cite_affl_wt
159.     gen affl_wt_notlast      = affl_wt_any      - affl_wt
160.     // Floor at zero — even after winsorization the diff can go slightly
.     // negative when the p99 cap for _any lands below the raw last value.
.     foreach v in ppr_cnt_notlast cite_affl_wt_notlast affl_wt_notlast {
161.         replace `v' = 0 if `v' < 0
162.     }
163.     // p99-cap the diff for symmetry with the base and _any outcomes.
.     foreach v in cite_affl_wt_notlast affl_wt_notlast {
164.         qui sum `v', d
165.         local p99_`v' = r(p99)
166.         replace `v' = `p99_`v'' if `v' > `p99_`v'' & !mi(`v')
167.         di as text "restrict_samp `samp'`suf' winsorized `v' at p99=`p99_`v''"
168.     }
169. 
.     // -- Institutional-characteristic heterogeneity ---------------------------
.     // Merge 30 pre-period university characteristics (HERD funding buckets +
.     // expenditures + endowment) keyed on OpenAlex inst_id. inst_id is constant
.     // per PI in this panel, so m:1 is safe and each ic_ variable is PI-constant.
.     // Then build both a median split (hi_/lo_) and a quartile split
.     // (q1_/mid_/q4_) at the PI level, dropping PIs with missing value only from
.     // that dimension (dummies set to missing => obs drop from the fit for that
.     // regression, panel-wide N unchanged).
.     merge m:1 inst_id using ../temp/inst_chars_pre, keep(1 3) nogen
170.     foreach a of global IC_ALIASES {
171.         cap confirm variable ic_`a'
172.         if _rc continue
173.         qui sum ic_`a' if athr_indicator == 1, d
174.         local ic_n = r(N)
175.         local ic_p50 = r(p50)
176.         local ic_p25 = r(p25)
177.         local ic_p75 = r(p75)
178.         di as text "restrict_samp `samp'`suf' ic_`a' N_pi=`ic_n' p25=`ic_p25' p50=`ic_p50' p75=`ic_p75'"
179.         gen byte hi_`a'  = ic_`a' >= `ic_p50' if !mi(ic_`a')
180.         gen byte lo_`a'  = ic_`a' <  `ic_p50' if !mi(ic_`a')
181.         gen byte q1_`a'  = ic_`a' <= `ic_p25' if !mi(ic_`a')
182.         gen byte q4_`a'  = ic_`a' >= `ic_p75' if !mi(ic_`a')
183.         gen byte mid_`a' = (ic_`a' > `ic_p25' & ic_`a' < `ic_p75') if !mi(ic_`a')
184.     }
185. 
.     // -- PI-level continuous quartile splits ----------------------------------
.     // Same three-group parameterization as inst-char quartile splits.
.     // Median counterparts (high_/low_/big_/small_/many_/few_) already exist above.
.     // Base var mapping:
.     //   pre_ppr <- pre_ppr_cnt_sum   grants <- pre_gpp
.     //   team    <- pre_team_avg      coauth <- pre_coauth_avg   msa <- msa_size_at
.     local pi_q_source pre_ppr_cnt_sum pre_gpp pre_team_avg pre_coauth_avg msa_size_at
186.     local pi_q_alias  pre_ppr        grants  team         coauth         msa
187.     local nq : word count `pi_q_alias'
188.     forvalues i = 1/`nq' {
189.         local src : word `i' of `pi_q_source'
190.         local alias : word `i' of `pi_q_alias'
191.         qui sum `src' if athr_indicator == 1, d
192.         local p25 = r(p25)
193.         local p75 = r(p75)
194.         di as text "restrict_samp `samp'`suf' `alias' p25=`p25' p75=`p75'"
195.         gen byte q1_`alias'  = `src' <= `p25' if !mi(`src')
196.         gen byte q4_`alias'  = `src' >= `p75' if !mi(`src')
197.         gen byte mid_`alias' = (`src' > `p25' & `src' < `p75') if !mi(`src')
198.     }
199. 
.     assert !mi(athr_id)
200.     assert !mi(exposure)
201.     assert !mi(mkt_spend_shr)
202.     save ../temp/es_`samp'`suf', replace
203. end

. 
. program event_study
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     // Fixed-effect choice driven by $FE_MODE. int_lead1 (and heterogeneity variants) is
.     // never included in the regressor list — under FE_MODE=author it would be dropped
.     // via collinearity with athr_id FE; under FE_MODE=inst_cluster it must be omitted
.     // manually so that rel = -1 remains the reference year.
.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     // Max-sim weighting: `wt' goes on every reghdfe/ppmlhdfe call, `wsuf' on
.     // every graph export / .dta save so the weighted and unweighted output
.     // files coexist.
.     local wt ""
 13.     local wsuf ""
 14.     if "$WEIGHT_MSIM" == "1" {
 15.         // Weight-type notes:
.         //   `wt' = [pw=max_sim]  — reghdfe/ppmlhdfe accept pw; ppmlhdfe rejects aw
.         //   `wt_bin' = [aw=max_sim] — binscatter accepts only aw / fw, not pw
.         // WLS coefficients are identical under aw vs pw (SEs are handled by
.         // vce(cluster) anyway), so mixing the two doesn't change anything
.         // substantively — it just gets past each command's accepted weight type.
.         local wt "[pw=max_sim]"
 16.         local wt_bin "[aw=max_sim]"
 17.         local wsuf "_msimwt"
 18.     }
 19.     local suf ""
 20.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
 21.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
 22.     use ../temp/es_`samp'`suf', clear
 23. 
.     gen rel = year - 2014
 24.     qui sum rel, d
 25.     local abs_lag = abs(r(max))
 26.     qui sum rel, d
 27.     local abs_lead = abs(r(min))
 28.     local timeframe = max(`abs_lag', `abs_lead')
 29.     forval i = 1/`timeframe' {
 30.         gen int_lag`i' = exposure if rel == `i'
 31.         gen int_lead`i' = exposure if rel == -`i'
 32.         gen lag`i' = 1 if rel == `i'
 33.         gen lead`i' = 1 if rel == -`i'
 34.         gen mshr_lag`i'  = mkt_spend_shr if rel == `i'
 35.         gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 36.     }
 37.     gen int_lag0 = exposure if rel == 0
 38.     gen lag0 = 1 if rel == 0
 39.     gen mshr_lag0 = mkt_spend_shr if rel == 0
 40.     ds lead* lag* int_lead* int_lag* mshr_lead* mshr_lag*
 41.     foreach var in `r(varlist)' {
 42.         replace `var' = 0 if mi(`var')
 43.     }
 44.     local leads
 45.     local int_leads
 46.     local mshr_leads
 47.     local lags
 48.     local int_lags
 49.     local mshr_lags
 50.     forval i = 2/`abs_lead' {
 51.         local leads lead`i' `leads'
 52.         local int_leads int_lead`i' `int_leads'
 53.         local mshr_leads mshr_lead`i' `mshr_leads'
 54.     }
 55.     forval i = 0/`abs_lag' {
 56.         local lags `lags' lag`i'
 57.         local int_lags `int_lags' int_lag`i'
 58.         local mshr_lags `mshr_lags' mshr_lag`i'
 59.     }
 60.     foreach v in ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any ///
>                  ppr_cnt_notlast cite_affl_wt_notlast {
 61.         gen ln_`v' = ln(1+`v')
 62.     }
 63. 
.     // pre-build group-suffixed event-time interactions for heterogeneity (used in pooled-interaction regressions below).
.     // For each group build both exposure-based (int_*) and mkt_spend_shr-based (mshr_*) interactions, so
.     // every heterogeneity spec below can be run twice: base and with sum-of-shares controls.
.     //
.     // $HET_GROUPS is the master list of all group dummies feeding heterogeneity
.     // specs. Existing 14 PI-level (median + binary categorical) groups, plus
.     // all inst-char and PI-continuous quartile-split groups built in restrict_samp.
.     // Groups whose dummy is all-missing or degenerate (all 0 or all 1) are
.     // silently skipped — this shields the inst-char specs from ipeds ids that
.     // never appear in the panel or that don't have enough non-missing PIs to
.     // form a median/quartile split.
.     local het_groups young old r1 r2 high_pre_ppr low_pre_ppr high_grants low_grants ///
>                      big_team small_team many_coauth few_coauth big_msa small_msa
 64.     foreach a of global IC_ALIASES {
 65.         local het_groups `het_groups' hi_`a' lo_`a' q1_`a' mid_`a' q4_`a'
 66.     }
 67.     foreach b of global PI_Q_BASES {
 68.         local het_groups `het_groups' q1_`b' mid_`b' q4_`b'
 69.     }
 70.     global HET_GROUPS_ACTIVE
 71.     foreach grp of local het_groups {
 72.         cap confirm variable `grp'
 73.         if _rc {
 74.             di as text "restrict_samp `samp'`suf': dummy `grp' not built — skipping interactions."
 75.             continue
 76.         }
 77.         qui sum `grp'
 78.         if r(N) == 0 | r(min) == r(max) {
 79.             di as text "restrict_samp `samp'`suf': dummy `grp' degenerate (N=" r(N) " min=" r(min) " max=" r(max) ") — skipping."
 80.             continue
 81.         }
 82.         foreach v of local int_leads {
 83.             gen `v'_`grp' = `v' * `grp'
 84.         }
 85.         foreach v of local int_lags {
 86.             gen `v'_`grp' = `v' * `grp'
 87.         }
 88.         gen int_lead1_`grp' = int_lead1 * `grp'
 89.         foreach v of local mshr_leads {
 90.             gen `v'_`grp' = `v' * `grp'
 91.         }
 92.         foreach v of local mshr_lags {
 93.             gen `v'_`grp' = `v' * `grp'
 94.         }
 95.         gen mshr_lead1_`grp' = mshr_lead1 * `grp'
 96.         local leads_`grp'
 97.         local lags_`grp'
 98.         local mleads_`grp'
 99.         local mlags_`grp'
100.         foreach v of local int_leads {
101.             local leads_`grp' `leads_`grp'' `v'_`grp'
102.         }
103.         foreach v of local int_lags {
104.             local lags_`grp' `lags_`grp'' `v'_`grp'
105.         }
106.         foreach v of local mshr_leads {
107.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
108.         }
109.         foreach v of local mshr_lags {
110.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
111.         }
112.         global HET_GROUPS_ACTIVE `"${HET_GROUPS_ACTIVE} `grp'"'
113.     }
114. 
.     local position_outcomes ""
115.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
116.         local position_outcomes n_first_ppr n_middle_ppr n_last_ppr ///
>             avg_position avg_position_rat avg_team_size_last avg_team_size_notlast
117.     }
118. 
.     // PPML heterogeneity results collector: one row per (yvar, grp, spec) written
.     // by the PPML het block inside the yvar loop below. Kept as a dta rather
.     // than named matrices to avoid Stata's 32-char matrix-name limit
.     // (e.g. phet_cite_affl_wt_notlast_high_pre_ppr_mshrctrl = 47 chars).
.     // output_tables and ppml_het_coefplot consume ../temp/phet_results_<samp>...dta.
.     tempname ph_handle
119.     postfile `ph_handle' str30 yvar str24 grp str12 spec str8 split_type ///
>         double(post_b post_se pre_b pre_se N r2_p) ///
>         using "../temp/phet_results_`samp'`suf'`wsuf'", replace
120. 
.     foreach yvar in ppr_cnt cite_affl_wt ln_ppr_cnt ln_cite_affl_wt ///
>                     ppr_cnt_any cite_affl_wt_any ln_ppr_cnt_any ln_cite_affl_wt_any ///
>                     ppr_cnt_notlast cite_affl_wt_notlast ln_ppr_cnt_notlast ln_cite_affl_wt_notlast ///
>                     avg_num_coathrs num_grants grants_per_paper grant_density ///
>                     `position_outcomes' {
121.         if "`yvar'" == "ln_spend" local var_name = "Log Spending"
122.         if "`yvar'" == "ln_spend" local gap  0.5
123.         if "`yvar'" == "cite_affl_wt" local var_name = "Citation Weighted Output"
124.         if "`yvar'" == "cite_affl_wt" local gap  1
125.         if "`yvar'" == "ppr_cnt" local var_name = "Publication Count"
126.         if "`yvar'" == "ppr_cnt" local gap 0.5
127.         if "`yvar'" == "ln_ppr_cnt"      local var_name = "Log Publication Counts"
128.         if "`yvar'" == "ln_ppr_cnt"      local gap 0.1
129.         if "`yvar'" == "ln_cite_affl_wt" local var_name = "Log Citation Weighted Output"
130.         if "`yvar'" == "ln_cite_affl_wt" local gap 0.1
131.         if "`yvar'" == "ppr_cnt"      & "`samp'" == "top_jrnls" local gap 2
132.         if "`yvar'" == "cite_affl_wt" & "`samp'" == "top_jrnls" local gap 2
133.         // _any = papers where the PI is at any authorship position (not just last).
.         // _notlast = _any - _last = papers where PI is first / middle author.
.         if "`yvar'" == "ppr_cnt_any"         local var_name = "Publication Count (any position)"
134.         if "`yvar'" == "ppr_cnt_any"         local gap 0.5
135.         if "`yvar'" == "cite_affl_wt_any"    local var_name = "Citation Weighted Output (any position)"
136.         if "`yvar'" == "cite_affl_wt_any"    local gap 1
137.         if "`yvar'" == "ln_ppr_cnt_any"      local var_name = "Log Publication Counts (any position)"
138.         if "`yvar'" == "ln_ppr_cnt_any"      local gap 0.1
139.         if "`yvar'" == "ln_cite_affl_wt_any" local var_name = "Log Citation Weighted Output (any position)"
140.         if "`yvar'" == "ln_cite_affl_wt_any" local gap 0.1
141.         if "`yvar'" == "ppr_cnt_any"         & "`samp'" == "top_jrnls" local gap 2
142.         if "`yvar'" == "cite_affl_wt_any"    & "`samp'" == "top_jrnls" local gap 2
143.         if "`yvar'" == "ppr_cnt_notlast"         local var_name = "Publication Count (non-last author)"
144.         if "`yvar'" == "ppr_cnt_notlast"         local gap 0.5
145.         if "`yvar'" == "cite_affl_wt_notlast"    local var_name = "Citation Weighted Output (non-last author)"
146.         if "`yvar'" == "cite_affl_wt_notlast"    local gap 1
147.         if "`yvar'" == "ln_ppr_cnt_notlast"      local var_name = "Log Publication Counts (non-last author)"
148.         if "`yvar'" == "ln_ppr_cnt_notlast"      local gap 0.1
149.         if "`yvar'" == "ln_cite_affl_wt_notlast" local var_name = "Log Citation Weighted Output (non-last author)"
150.         if "`yvar'" == "ln_cite_affl_wt_notlast" local gap 0.1
151.         if "`yvar'" == "ppr_cnt_notlast"         & "`samp'" == "top_jrnls" local gap 2
152.         if "`yvar'" == "cite_affl_wt_notlast"    & "`samp'" == "top_jrnls" local gap 2
153.         if "`yvar'" == "avg_num_coathrs"   local var_name = "Average Team Size"
154.         if "`yvar'" == "avg_num_coathrs"   local gap 0.5
155.         if "`yvar'" == "num_grants"        local var_name = "Number of Grants"
156.         if "`yvar'" == "num_grants"        local gap 0.5
157.         if "`yvar'" == "grants_per_paper"  local var_name = "Grants per Paper (num_grants / ppr_cnt)"
158.         if "`yvar'" == "grants_per_paper"  local gap 0.5
159.         if "`yvar'" == "grant_density"     local var_name = "Grant Density (num_grants / pre-period avg ppr)"
160.         if "`yvar'" == "grant_density"     local gap 0.5
161.         // Position-metric labels (only used when POSITION_OUTCOMES_AVAIL == 1)
.         if "`yvar'" == "n_first_ppr"           local var_name = "# First-Author Papers"
162.         if "`yvar'" == "n_first_ppr"           local gap 0.5
163.         if "`yvar'" == "n_middle_ppr"          local var_name = "# Middle-Author Papers"
164.         if "`yvar'" == "n_middle_ppr"          local gap 0.5
165.         if "`yvar'" == "n_last_ppr"            local var_name = "# Last-Author Papers"
166.         if "`yvar'" == "n_last_ppr"            local gap 0.5
167.         if "`yvar'" == "avg_position"          local var_name = "Avg Author Position (1=first, N=last)"
168.         if "`yvar'" == "avg_position"          local gap 0.5
169.         if "`yvar'" == "avg_position_rat"      local var_name = "Avg Author Position / Team Size (0-1)"
170.         if "`yvar'" == "avg_position_rat"      local gap 0.05
171.         if "`yvar'" == "avg_team_size_last"    local var_name = "Team Size (papers where PI is last)"
172.         if "`yvar'" == "avg_team_size_last"    local gap 0.5
173.         if "`yvar'" == "avg_team_size_notlast" local var_name = "Team Size (papers where PI is not last)"
174.         if "`yvar'" == "avg_team_size_notlast" local gap 0.5
175.         local poisson_name "`var_name'"
176.         if "`yvar'" == "ppr_cnt"              local poisson_name "Publications"
177.         if "`yvar'" == "cite_affl_wt"         local poisson_name "Citation-Weighted Output"
178.         if "`yvar'" == "ppr_cnt_any"          local poisson_name "Publications (any position)"
179.         if "`yvar'" == "cite_affl_wt_any"     local poisson_name "Citation-Weighted Output (any position)"
180.         if "`yvar'" == "ppr_cnt_notlast"      local poisson_name "Publications (non-last author)"
181.         if "`yvar'" == "cite_affl_wt_notlast" local poisson_name "Citation-Weighted Output (non-last author)"
182.         if "`yvar'" == "avg_num_coathrs"      local poisson_name "Coauthors"
183.         if "`yvar'" == "num_grants"           local poisson_name "Grants"
184.         if "`yvar'" == "grants_per_paper"     local poisson_name "Grants per Paper"
185.         if "`yvar'" == "grant_density"        local poisson_name "Grant Density"
186. 
.         preserve
187.         cap mat drop es
188.         sum `yvar' if rel <= -1 & exposure > 0, d
189.         local pre_mean : dis %4.3f r(mean)
190.         gunique athr_id
191.         local num_athrs = r(unique)
192.         gunique inst_id
193.         local num_insts = r(unique)
194.         cap noi reghdfe `yvar' `int_leads' `int_lags' `wt', absorb(`fes') vce(cluster `vce_cl')
195.         if _rc {
196.             di as error "event_study `samp'`suf' `yvar' base failed (rc=`_rc'); skipping this outcome."
197.             restore
198.             continue
199.         }
200.         foreach var in `int_leads' `int_lags' int_lead1 {
201.             if "`var'" == "int_lead1" {
202.                 mat row = 0,0
203.             }
204.             else {
205.                 mat row = _b[`var'], _se[`var']
206.             }
207.             mat es = nullmat(es) \ row
208.         }
209.         svmat es
210.         keep es1 es2
211.         drop if mi(es1)
212.         rename (es1 es2) (b se)
213.         gen ub = b + 1.96*se
214.         sum ub, d
215.         local ymax =round(r(max),`gap')
216.         gen lb = b - 1.96*se
217.         sum lb, d
218.         local ymin = min(-2.5,round(r(min),`gap'))
219.         if inlist("`yvar'", "ln_ppr_cnt", "ln_cite_affl_wt") local ymin = -1
220.         gen rel = -4 if _n == 1
221.         replace rel = rel[_n-1]+1 if _n > 1
222.         replace rel = rel + 1 if rel >= -1
223.         replace rel = -1 if rel == `abs_lag' + 1
224.         gen year = rel + 2014
225.         hashsort rel
226.         tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>           scatter b year, mcolor(ebblue) || ///
>           scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>           xlab(2010(1)2019) xtitle("Year") ///
>           ytitle("`var_name'") ylab(`ymin'(`gap')`ymax') ///
>           yline(0, lcolor(gs10) lpattern(solid)) ///
>           legend(on order(- "Num. PIs: `num_athrs'" "Num. Institutions: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) plotregion(margin(sides))
227.         graph export ../output/figures/`samp'/es_`yvar'`suf'`wsuf'.pdf, replace
228.         save ../temp/es_`yvar'`wsuf', replace
229.         restore
230. 
.         // alternative spec: control for mkt_spend_shr x rel-year dummies
.         preserve
231.         cap mat drop es
232.         cap noi reghdfe `yvar' `int_leads' `int_lags' `mshr_leads' `mshr_lags' `wt', ///
>                        absorb(`fes') vce(cluster `vce_cl')
233.         if _rc {
234.             di as error "event_study `samp'`suf' `yvar' mshrctrl failed (rc=`_rc'); skipping mshrctrl plot."
235.             restore
236.             // Skip only the mshrctrl plot; PPML and heterogeneity blocks below will try independently.
.         }
237.         else {
238.         foreach var in `int_leads' `int_lags' int_lead1 {
239.             if "`var'" == "int_lead1" {
240.                 mat row = 0,0
241.             }
242.             else {
243.                 mat row = _b[`var'], _se[`var']
244.             }
245.             mat es = nullmat(es) \ row
246.         }
247.         svmat es
248.         keep es1 es2
249.         drop if mi(es1)
250.         rename (es1 es2) (b se)
251.         gen ub = b + 1.96*se
252.         sum ub, d
253.         local ymax = round(r(max),`gap')
254.         gen lb = b - 1.96*se
255.         sum lb, d
256.         local ymin = min(-2.5,round(r(min),`gap'))
257.         if inlist("`yvar'", "ln_ppr_cnt", "ln_cite_affl_wt") local ymin = -1
258.         gen rel = -4 if _n == 1
259.         replace rel = rel[_n-1]+1 if _n > 1
260.         replace rel = rel + 1 if rel >= -1
261.         replace rel = -1 if rel == `abs_lag' + 1
262.         gen year = rel + 2014
263.         hashsort rel
264.         tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>           scatter b year, mcolor(ebblue) || ///
>           scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>           xlab(2010(1)2019) xtitle("Year") ///
>           ytitle("`var_name'") ylab(`ymin'(`gap')`ymax') ///
>           yline(0, lcolor(gs10) lpattern(solid)) ///
>           legend(on order(- "Num. PIs: `num_athrs'" "Num. Institutions: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) plotregion(margin(sides))
265.         graph export ../output/figures/`samp'/es_`yvar'`suf'_mshrctrl`wsuf'.pdf, replace
266.         save ../temp/es_`yvar'`suf'_mshrctrl`wsuf', replace
267.         restore
268.         }
269. 
.         // Poisson (ppmlhdfe) version — skip already-logged outcomes; coefs are semielasticities
.         if !regexm("`yvar'", "^ln_") {
270.             foreach spec in base mshrctrl {
271.                 preserve
272.                 cap mat drop es
273.                 if "`spec'" == "base" {
274.                     cap noi ppmlhdfe `yvar' `int_leads' `int_lags' `wt', ///
>                             absorb(`fes') vce(cluster `vce_cl')
275.                 }
276.                 else {
277.                     cap noi ppmlhdfe `yvar' `int_leads' `int_lags' ///
>                                            `mshr_leads' `mshr_lags' `wt', ///
>                             absorb(`fes') vce(cluster `vce_cl')
278.                 }
279.                 if _rc {
280.                     di as error "ppmlhdfe `yvar' `spec' failed (rc=`_rc'); skipping plot."
281.                     restore
282.                     continue
283.                 }
284.                 foreach var in `int_leads' `int_lags' int_lead1 {
285.                     if "`var'" == "int_lead1" {
286.                         mat row = 0,0
287.                     }
288.                     else {
289.                         mat row = _b[`var'], _se[`var']
290.                     }
291.                     mat es = nullmat(es) \ row
292.                 }
293.                 svmat es
294.                 keep es1 es2
295.                 drop if mi(es1)
296.                 rename (es1 es2) (b se)
297.                 gen ub = b + 1.96*se
298.                 sum ub, d
299.                 local ymax = round(r(max), 0.1)
300.                 gen lb = b - 1.96*se
301.                 sum lb, d
302.                 local ymin = round(r(min), 0.1)
303.                 gen rel = -4 if _n == 1
304.                 replace rel = rel[_n-1]+1 if _n > 1
305.                 replace rel = rel + 1 if rel >= -1
306.                 replace rel = -1 if rel == `abs_lag' + 1
307.                 gen year = rel + 2014
308.                 hashsort rel
309.                 local plot_suf "_ppml"
310.                 if "`spec'" == "mshrctrl" local plot_suf "_ppml_mshrctrl"
311.                 tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                   scatter b year, mcolor(ebblue) || ///
>                   scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                   xlab(2010(1)2019) xtitle("Year") ///
>                   ytitle("{&Delta} Log Expected `poisson_name'") ylab(`ymin'(0.1)`ymax') ///
>                   yline(0, lcolor(gs10) lpattern(solid)) ///
>                   legend(on order(- "Num. PIs: `num_athrs'" "Num. Institutions: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) plotregion(margin(sides))
312.                 graph export ../output/figures/`samp'/es_`yvar'`suf'`plot_suf'`wsuf'.pdf, replace
313.                 save ../temp/es_`yvar'`suf'`plot_suf'`wsuf', replace
314.                 restore
315.             }
316.         }
317. 
.         // heterogeneity by author & inst characteristics — one regression per dummy pair, split-interaction form.
.         // Run twice per pair: base (no mkt-share controls) and mshrctrl (+ mshr x rel-time x group).
.         // dummy_pairs is used by both the OLS het block below AND the PPML het
.         // block further down — defined once, out of the OLS-only gate.
.         local dummy_pairs `" "young old" "r1 r2" "high_pre_ppr low_pre_ppr" "high_grants low_grants" "big_team small_team" "many_coauth few_coauth" "big_msa small_msa" "'
318.         // Runtime saver: OLS heterogeneity runs on the four headline outcomes
.         // (publications + citation-weighted output, level and log). PPML het
.         // (below) is broader.
.         if inlist("`yvar'", "ppr_cnt", "ln_ppr_cnt", "cite_affl_wt", "ln_cite_affl_wt") {
319.         foreach pair of local dummy_pairs {
320.             local g1: word 1 of `pair'
321.             local g2: word 2 of `pair'
322.             // Human-readable label for the g1 (dummy=1) group; used as the
.             // plot subtitle so each split PDF is self-describing.
.             local g1_label ""
323.             if "`g1'" == "young"         local g1_label "Young"
324.             if "`g1'" == "r1"            local g1_label "R1"
325.             if "`g1'" == "high_pre_ppr"  local g1_label "More Productive at Baseline"
326.             if "`g1'" == "high_grants"   local g1_label "More Grants per Paper at Baseline"
327.             if "`g1'" == "big_team"      local g1_label "Larger Team Size"
328.             if "`g1'" == "many_coauth"   local g1_label "More Coauthors"
329.             if "`g1'" == "big_msa"       local g1_label "Larger MSA"
330.             // Base + interaction form: un-interacted int_lead/lag_* absorb the
.             // event-time path for the dummy=0 (`g2') group; leads_`g1'/lags_`g1'
.             // are the *differential* effect for the dummy=1 group. Only one
.             // coefplot per split is saved (the differential), since it already
.             // encodes the comparison to the dummy=0 group.
.             //
.             // For pre-period-baseline splits (high_pre_ppr, high_grants) the
.             // median split is mechanically confounded with regression-to-mean.
.             // Adding i.year#c.<baseline> lets each year have its own slope on
.             // continuous baseline productivity, absorbing the mean-reversion
.             // time-path; the surviving `leads_`g1''/`lags_`g1'' is the
.             // differential response to treatment net of "big producers
.             // naturally fall back."
.             local specs base mshrctrl
331.             local mr_baseline ""
332.             if "`g1'" == "high_pre_ppr" {
333.                 local specs `specs' mshrctrl_mr
334.                 local mr_baseline pre_ppr_cnt_sum
335.             }
336.             if "`g1'" == "high_grants" {
337.                 local specs `specs' mshrctrl_mr
338.                 local mr_baseline pre_gpp
339.             }
340.             foreach spec of local specs {
341.                 local mshr_ctrls
342.                 local plot_suf
343.                 local mr_abs
344.                 if "`spec'" == "mshrctrl" | "`spec'" == "mshrctrl_mr" {
345.                     // un-interacted mshr_lead/lag_* absorbs the base MShr
.                     // event-time; mleads_`g1'/mlags_`g1' lets high group have
.                     // its own MShr slope
.                     local mshr_ctrls `mshr_leads' `mshr_lags' `mleads_`g1'' `mlags_`g1''
346.                     local plot_suf "_mshrctrl"
347.                 }
348.                 if "`spec'" == "mshrctrl_mr" {
349.                     local mr_abs i.year#c.`mr_baseline'
350.                     local plot_suf "_mshrctrl_mr"
351.                 }
352.                 // int_lead1 (rel=-1) omitted for both base and differential —
.                 // shared reference year.
.                 cap noi reghdfe `yvar' `int_leads' `int_lags' ///
>                                `leads_`g1'' `lags_`g1'' ///
>                                `mshr_ctrls' `wt', ///
>                                absorb(`fes' `mr_abs') vce(cluster `vce_cl')
353.                 if _rc {
354.                     di as error "event_study `samp'`suf' `yvar' `g1' `spec' failed (rc=`_rc'); skipping."
355.                     continue
356.                 }
357. 
.                 // Extract the differential coefficients (only the `g1'-suffixed
.                 // ones); int_lead1_`g1' is the rel=-1 reference and pinned to 0.
.                 sum `yvar' if rel <= -1 & exposure > 0 & `g1' == 1, d
358.                 local pre_mean : dis %4.3f r(mean)
359.                 gunique athr_id if exposure > 0 & `g1' == 1
360.                 local num_athrs = r(unique)
361.                 preserve
362.                 cap mat drop es
363.                 foreach var in `leads_`g1'' `lags_`g1'' int_lead1_`g1' {
364.                     if "`var'" == "int_lead1_`g1'" {
365.                         mat row = 0,0
366.                     }
367.                     else {
368.                         mat row = _b[`var'], _se[`var']
369.                     }
370.                     mat es = nullmat(es) \ row
371.                 }
372.                 svmat es
373.                 keep es1 es2
374.                 drop if mi(es1)
375.                 rename (es1 es2) (b se)
376.                 gen ub = b + 1.96*se
377.                 sum ub, d
378.                 local ymax = round(r(max),`gap')
379.                 gen lb = b - 1.96*se
380.                 sum lb, d
381.                 local ymin = round(r(min),`gap')
382.                 if inlist("`yvar'", "ln_ppr_cnt", "ln_cite_affl_wt") local ymin = -1
383.                 gen rel = -4 if _n == 1
384.                 replace rel = rel[_n-1]+1 if _n > 1
385.                 replace rel = rel + 1 if rel >= -1
386.                 replace rel = -1 if rel == `abs_lag' + 1
387.                 gen year = rel + 2014
388.                 hashsort rel
389.                 tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>                   scatter b year, mcolor(ebblue) || ///
>                 scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                   xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                   ytitle("Exposure x Post") ylab(`ymin'(`gap')`ymax') ///
>                   subtitle("`g1_label'", pos(11) size(small)) ///
>                   legend(on order(- "Num. PIs: `num_athrs'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) ///
>                   yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
390.                 graph export ../output/figures/`samp'/es_`yvar'`suf'_`g1'`plot_suf'`wsuf'.pdf, replace
391.                 save ../temp/es_`yvar'`suf'_`g1'`plot_suf'`wsuf', replace
392.                 restore
393.             }
394.         }
395.         }  // closes OLS-only inlist gate
396. 
.         // ---- PPML heterogeneity: split-form spec matching ppml_pdid_het_binscatter.
.         //   ppmlhdfe y  leads_g1 lags_g1  leads_g2 lags_g2  [mshr_g1 mshr_g2]
.         // Under this parameterization there is no un-interacted base and
.         // g1 + g2 = 1 for every observation, so `_b[lags_g1_k]` is the LEVEL
.         // of the event-time effect for the g1 subgroup (not a differential
.         // vs g2). Post one row per (yvar, g, spec) — g takes both sides of
.         // each pair, so the coefplot below can compare g1 and g2 head-to-head.
.         //
.         // Runs for all PPML-eligible outcomes under mshrctrl; adds `base` for
.         // ppr_cnt (backwards-compat with the older single-outcome block).
.         // Skipped for already-logged (ln_*) outcomes (PPML on log outcomes is
.         // nonsense) and for average-based outcomes (avg_*), which are
.         // conditional means, not counts. mshrctrl_mr also skipped —
.         // mean-reversion i.year#c.baseline is an OLS-only diagnostic and its
.         // interpretation in the Poisson link is opaque.
.         // Per-group event-time PDFs only generated for ppr_cnt to keep runtime
.         // bounded.
.         local ppml_het_skip ln_ppr_cnt ln_cite_affl_wt ln_ppr_cnt_any ln_cite_affl_wt_any ln_ppr_cnt_notlast ln_cite_affl_wt_notlast avg_position avg_position_rat avg_team_size_last avg_team_size_notlast
397.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
398.             foreach pair of local dummy_pairs {
399.                 local g1: word 1 of `pair'
400.                 local g2: word 2 of `pair'
401.                 local ppml_specs mshrctrl
402.                 if "`yvar'" == "ppr_cnt" local ppml_specs base mshrctrl
403.                 foreach spec of local ppml_specs {
404.                     local mshr_ctrls
405.                     local plot_suf "_ppml"
406.                     if "`spec'" == "mshrctrl" {
407.                         local mshr_ctrls `mleads_`g1'' `mlags_`g1'' `mleads_`g2'' `mlags_`g2''
408.                         local plot_suf "_ppml_mshrctrl"
409.                     }
410.                     cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g2'' `lags_`g2'' ///
>                                    `mshr_ctrls' `wt', ///
>                                    absorb(`fes') vce(cluster `vce_cl')
411.                     if _rc {
412.                         di as error "event_study `samp'`suf' `yvar' `g1'/`g2' ppml `spec' failed (rc=`_rc'); skipping."
413.                         continue
414.                     }
415.                     local Nppml = e(N)
416.                     local r2ppml = e(r2_p)
417. 
.                     foreach grp in `g1' `g2' {
418.                         // Human-readable label for this group side (used as
.                         // subtitle on the per-group event-time PDF below).
.                         local grp_label ""
419.                         if "`grp'" == "young"         local grp_label "Young"
420.                         if "`grp'" == "old"           local grp_label "Old"
421.                         if "`grp'" == "r1"            local grp_label "R1"
422.                         if "`grp'" == "r2"            local grp_label "R2"
423.                         if "`grp'" == "high_pre_ppr"  local grp_label "More Productive at Baseline"
424.                         if "`grp'" == "low_pre_ppr"   local grp_label "Less Productive at Baseline"
425.                         if "`grp'" == "high_grants"   local grp_label "More Grants per Paper at Baseline"
426.                         if "`grp'" == "low_grants"    local grp_label "Fewer Grants per Paper at Baseline"
427.                         if "`grp'" == "big_team"      local grp_label "Larger Team Size"
428.                         if "`grp'" == "small_team"    local grp_label "Smaller Team Size"
429.                         if "`grp'" == "many_coauth"   local grp_label "More Coauthors"
430.                         if "`grp'" == "few_coauth"    local grp_label "Fewer Coauthors"
431.                         if "`grp'" == "big_msa"       local grp_label "Larger MSA"
432.                         if "`grp'" == "small_msa"     local grp_label "Smaller MSA"
433. 
.                         sum `yvar' if rel <= -1 & exposure > 0 & `grp' == 1, d
434.                         local pre_mean : dis %4.3f r(mean)
435.                         gunique athr_id if exposure > 0 & `grp' == 1
436.                         local num_athrs = r(unique)
437. 
.                         // Pooled post- and pre-averages of the group's
.                         // event-time β via lincom on the fitted model. Post =
.                         // mean of int_lag0..lag(abs_lag) coefs for the group;
.                         // pre = mean of the included leads (int_lead2..
.                         // lead(abs_lead)) since lead1 is the omitted reference.
.                         local n_post = `abs_lag' + 1
438.                         local n_pre  = `abs_lead' - 1
439.                         local sum_post
440.                         foreach v of local lags_`grp' {
441.                             local sum_post `sum_post' + `v'
442.                         }
443.                         local sum_post = substr("`sum_post'", 3, .)
444.                         local sum_pre
445.                         foreach v of local leads_`grp' {
446.                             local sum_pre `sum_pre' + `v'
447.                         }
448.                         local sum_pre = substr("`sum_pre'", 3, .)
449. 
.                         local b_post = .
450.                         local se_post = .
451.                         local b_pre = .
452.                         local se_pre = .
453.                         cap qui lincom (`sum_post') / `n_post'
454.                         if _rc == 0 {
455.                             local b_post = r(estimate)
456.                             local se_post = r(se)
457.                         }
458.                         cap qui lincom (`sum_pre') / `n_pre'
459.                         if _rc == 0 {
460.                             local b_pre = r(estimate)
461.                             local se_pre = r(se)
462.                         }
463. 
.                         di as text "ppml het `samp'`suf' `yvar' `grp' `spec': post_avg=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   pre_avg=" %8.4f `b_pre' ///
>                             " (se=" %8.4f `se_pre' ")   N=" %9.0f `Nppml'
464. 
.                         post `ph_handle' ("`yvar'") ("`grp'") ("`spec'") ("med") ///
>                             (`b_post') (`se_post') (`b_pre') (`se_pre') (`Nppml') (`r2ppml')
465. 
.                         // Per-group event-time PDF only for ppr_cnt (runtime + volume)
.                         if "`yvar'" != "ppr_cnt" continue
466.                         preserve
467.                         cap mat drop es
468.                         foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
469.                             if "`var'" == "int_lead1_`grp'" {
470.                                 mat row = 0,0
471.                             }
472.                             else {
473.                                 mat row = _b[`var'], _se[`var']
474.                             }
475.                             mat es = nullmat(es) \ row
476.                         }
477.                         svmat es
478.                         keep es1 es2
479.                         drop if mi(es1)
480.                         rename (es1 es2) (b se)
481.                         gen ub = b + 1.96*se
482.                         sum ub, d
483.                         local ymax = round(r(max), 0.1)
484.                         gen lb = b - 1.96*se
485.                         sum lb, d
486.                         local ymin = round(r(min), 0.1)
487.                         gen rel = -4 if _n == 1
488.                         replace rel = rel[_n-1]+1 if _n > 1
489.                         replace rel = rel + 1 if rel >= -1
490.                         replace rel = -1 if rel == `abs_lag' + 1
491.                         gen year = rel + 2014
492.                         hashsort rel
493.                         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                           scatter b year, mcolor(ebblue) || ///
>                         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                           xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                           ytitle("Exposure x Post") ylab(`ymin'(0.1)`ymax') ///
>                           subtitle("`grp_label'", pos(11) size(small)) ///
>                           legend(on order(- "Num. PIs: `num_athrs'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) ///
>                           yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
494.                         graph export ../output/figures/`samp'/es_`yvar'`suf'_`grp'`plot_suf'`wsuf'.pdf, replace
495.                         save ../temp/es_`yvar'`suf'_`grp'`plot_suf'`wsuf', replace
496.                         restore
497.                     }
498.                 }
499.             }
500.         }
501.     }
502.     postclose `ph_handle'
503. end

. 
. program pooled_did
  1.     // pooled DiD: y_it = a_i + g_t + b*(exposure_i x post_t) + e_it
.     // matches event-study sample/FE/cluster; gives a single post-period beta with SE.
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local wt ""
 13.     local wsuf ""
 14.     if "$WEIGHT_MSIM" == "1" {
 15.         // Weight-type notes:
.         //   `wt' = [pw=max_sim]  — reghdfe/ppmlhdfe accept pw; ppmlhdfe rejects aw
.         //   `wt_bin' = [aw=max_sim] — binscatter accepts only aw / fw, not pw
.         // WLS coefficients are identical under aw vs pw (SEs are handled by
.         // vce(cluster) anyway), so mixing the two doesn't change anything
.         // substantively — it just gets past each command's accepted weight type.
.         local wt "[pw=max_sim]"
 16.         local wt_bin "[aw=max_sim]"
 17.         local wsuf "_msimwt"
 18.     }
 19.     local suf ""
 20.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
 21.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
 22.     use ../temp/es_`samp'`suf', clear
 23. 
.     foreach v in cite_affl_wt ppr_cnt cite_affl_wt_any ppr_cnt_any ///
>                  cite_affl_wt_notlast ppr_cnt_notlast {
 24.         cap gen ln_`v' = ln(1+`v')
 25.     }
 26. 
.     gen post       = year >= 2014
 27.     gen Z_it       = exposure              * post
 28.     gen Z_share_it = mkt_spend_shr * post
 29. 
.     local position_outcomes ""
 30.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
 31.         local position_outcomes n_first_ppr n_middle_ppr n_last_ppr ///
>             avg_position avg_position_rat avg_team_size_last avg_team_size_notlast
 32.     }
 33.     local outcomes cite_affl_wt ppr_cnt ln_cite_affl_wt ln_ppr_cnt ///
>                    cite_affl_wt_any ppr_cnt_any ln_cite_affl_wt_any ln_ppr_cnt_any ///
>                    cite_affl_wt_notlast ppr_cnt_notlast ln_cite_affl_wt_notlast ln_ppr_cnt_notlast ///
>                    avg_num_coathrs num_grants grants_per_paper grant_density ///
>                    `position_outcomes'
 34. 
.     cap mkdir ../output/tables
 35.     cap mkdir ../output/tables/`samp'
 36. 
.     cap mat drop results
 37.     foreach yvar of local outcomes {
 38.         qui sum `yvar' if year < 2014, d
 39.         local pre_mean = r(mean)
 40. 
.         // base spec — cap noi + skip so sparse outcomes (e.g. n_first_ppr on top_jrnls)
.         // that trigger "insufficient observations" (r(2001)) don't halt the pipeline.
.         local b_b = .
 41.         local b_se = .
 42.         local b_N = .
 43.         local b_r2 = .
 44.         cap noi qui reghdfe `yvar' Z_it `wt', absorb(`fes') vce(cluster `vce_cl')
 45.         if _rc {
 46.             di as error "pooled_did `samp'`suf' `yvar' base failed (rc=`_rc'); skipping outcome."
 47.             continue
 48.         }
 49.         local b_b   = _b[Z_it]
 50.         local b_se  = _se[Z_it]
 51.         local b_N   = e(N)
 52.         local b_r2  = e(r2)
 53. 
.         // with shares
.         local s_bx = .
 54.         local s_sex = .
 55.         local s_bs = .
 56.         local s_ses = .
 57.         local s_N = .
 58.         local s_r2 = .
 59.         cap noi qui reghdfe `yvar' Z_it Z_share_it `wt', absorb(`fes') vce(cluster `vce_cl')
 60.         if _rc {
 61.             di as error "pooled_did `samp'`suf' `yvar' +share failed (rc=`_rc'); using base-only for this outcome."
 62.         }
 63.         else {
 64.             local s_bx  = _b[Z_it]
 65.             local s_sex = _se[Z_it]
 66.             local s_bs  = _b[Z_share_it]
 67.             local s_ses = _se[Z_share_it]
 68.             local s_N   = e(N)
 69.             local s_r2  = e(r2)
 70.         }
 71. 
.         di as text "pooled_did `samp'`suf' `yvar':  base b=" %7.4f `b_b' " se=" %7.4f `b_se' ///
>             "    +share b=" %7.4f `s_bx' " se=" %7.4f `s_sex' ///
>             "    share_b=" %7.4f `s_bs' " se=" %7.4f `s_ses' ///
>             "    pre-mean=" %7.4f `pre_mean'
 72. 
.         cap mat drop pdid_`yvar'
 73.         mat pdid_`yvar' = J(7,2,.)
 74.         mat pdid_`yvar'[1,1] = `b_b'
 75.         mat pdid_`yvar'[2,1] = `b_se'
 76.         mat pdid_`yvar'[5,1] = `pre_mean'
 77.         mat pdid_`yvar'[6,1] = `b_N'
 78.         mat pdid_`yvar'[7,1] = `b_r2'
 79.         mat pdid_`yvar'[1,2] = `s_bx'
 80.         mat pdid_`yvar'[2,2] = `s_sex'
 81.         mat pdid_`yvar'[3,2] = `s_bs'
 82.         mat pdid_`yvar'[4,2] = `s_ses'
 83.         mat pdid_`yvar'[5,2] = `pre_mean'
 84.         mat pdid_`yvar'[6,2] = `s_N'
 85.         mat pdid_`yvar'[7,2] = `s_r2'
 86.         mat rownames pdid_`yvar' = b_exposure se_exposure b_share se_share pre_mean N r2
 87.         mat colnames pdid_`yvar' = base with_share
 88. 
.         // accumulate one row per outcome for the summary dta
.         mat row = `b_b', `b_se', `s_bx', `s_sex', `s_bs', `s_ses', `pre_mean'
 89.         mat results = nullmat(results) \ row
 90. 
.         // Frisch-Waugh partial-regression binscatter: pooled DiD analog of ld plot
.         local var_name "`yvar'"
 91.         if "`yvar'" == "cite_affl_wt"            local var_name "Citation Weighted Output"
 92.         if "`yvar'" == "ppr_cnt"                 local var_name "Publication Count"
 93.         if "`yvar'" == "ln_cite_affl_wt"         local var_name "Log Citation Weighted Output"
 94.         if "`yvar'" == "ln_ppr_cnt"              local var_name "Log Publication Counts"
 95.         if "`yvar'" == "cite_affl_wt_any"        local var_name "Citation Weighted Output (any position)"
 96.         if "`yvar'" == "ppr_cnt_any"             local var_name "Publication Count (any position)"
 97.         if "`yvar'" == "ln_cite_affl_wt_any"     local var_name "Log Citation Weighted Output (any position)"
 98.         if "`yvar'" == "ln_ppr_cnt_any"          local var_name "Log Publication Counts (any position)"
 99.         if "`yvar'" == "cite_affl_wt_notlast"    local var_name "Citation Weighted Output (non-last author)"
100.         if "`yvar'" == "ppr_cnt_notlast"         local var_name "Publication Count (non-last author)"
101.         if "`yvar'" == "ln_cite_affl_wt_notlast" local var_name "Log Citation Weighted Output (non-last author)"
102.         if "`yvar'" == "ln_ppr_cnt_notlast"      local var_name "Log Publication Counts (non-last author)"
103.         if "`yvar'" == "avg_num_coathrs"         local var_name "Avg Coauthors"
104.         if "`yvar'" == "num_grants"              local var_name "Num Grants"
105.         if "`yvar'" == "grants_per_paper"        local var_name "Grants per Paper"
106.         if "`yvar'" == "grant_density"           local var_name "Grant Density (num_grants / pre-avg ppr)"
107.         if "`yvar'" == "n_first_ppr"             local var_name "# First-Author Papers"
108.         if "`yvar'" == "n_middle_ppr"            local var_name "# Middle-Author Papers"
109.         if "`yvar'" == "n_last_ppr"              local var_name "# Last-Author Papers"
110.         if "`yvar'" == "avg_position"            local var_name "Avg Author Position"
111.         if "`yvar'" == "avg_position_rat"        local var_name "Avg Author Position Ratio"
112.         if "`yvar'" == "avg_team_size_last"      local var_name "Team Size (last-author papers)"
113.         if "`yvar'" == "avg_team_size_notlast"   local var_name "Team Size (non-last papers)"
114. 
.         preserve
115.             cap noi qui reghdfe `yvar' `wt', absorb(`fes') residuals(_y_r)
116.             if _rc == 0 cap noi qui reghdfe Z_it `wt', absorb(`fes') residuals(_Z_r)
117.             if _rc == 0 {
118.                 local pd_b_str  : dis %7.3f `b_b'
119.                 local pd_se_str : dis %7.3f `b_se'
120.                 binscatter _y_r _Z_r `wt_bin', n(30) ///
>                     xtitle("Exposure x Post") ytitle("`var_name'") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolor(ebblue) ///
>                     note("{&beta} = `pd_b_str' (SE: `pd_se_str')") ///
>                     plotregion(margin(sides))
121.                 graph export ../output/figures/`samp'/pdid_`yvar'`suf'`wsuf'.pdf, replace
122.             }
123.             else di as error "pdid binscatter `yvar' failed; skipping plot."
124.         restore
125. 
.         preserve
126.             cap noi qui reghdfe `yvar' Z_share_it `wt', absorb(`fes') residuals(_y_r)
127.             if _rc == 0 cap noi qui reghdfe Z_it Z_share_it `wt', absorb(`fes') residuals(_Z_r)
128.             if _rc == 0 {
129.                 local pds_b_str  : dis %7.3f `s_bx'
130.                 local pds_se_str : dis %7.3f `s_sex'
131.                 binscatter _y_r _Z_r `wt_bin', n(30) ///
>                     xtitle("Exposure x Post") ytitle("`var_name'") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolor(ebblue) ///
>                     note("{&beta} = `pds_b_str' (SE: `pds_se_str')") ///
>                     plotregion(margin(sides))
132.                 graph export ../output/figures/`samp'/pdid_`yvar'`suf'_mshrctrl`wsuf'.pdf, replace
133.             }
134.             else di as error "pdid mshrctrl binscatter `yvar' failed; skipping plot."
135.         restore
136.     }
137. 
.     // small dta with both specs per outcome for quoting in figure legends or text
.     preserve
138.         clear
139.         svmat results
140.         rename (results1 results2 results3 results4 results5 results6 results7) ///
>                (b_base se_base b_exp_wshr se_exp_wshr b_shr_wshr se_shr_wshr pre_mean)
141.         gen outcome = ""
142.         local i = 1
143.         foreach yvar of local outcomes {
144.             replace outcome = "`yvar'" if _n == `i'
145.             local ++i
146.         }
147.         order outcome b_base se_base b_exp_wshr se_exp_wshr b_shr_wshr se_shr_wshr pre_mean
148.         save ../temp/pooled_did_`samp'`suf'`wsuf', replace
149.         list, sep(0) noobs abbrev(20)
150.     restore
151. end

. 
. program ppml_specs
  1.     // Poisson (ppmlhdfe) analog of pooled_did.
.     //   ppml_pdid: y_it on Z_it (+ Z_share_it), absorb(FEs from $FE_MODE)
.     // Skips ln_ outcomes; ppmlhdfe wrapped in cap noi (may drop separated obs
.     // or fail to converge). Matrix ppml_pdid_<yvar> has rows
.     // [b_x, se_x, b_share, se_share, pre_mean, N, r2_p] and cols [base, with_share].
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local wt ""
 13.     local wsuf ""
 14.     if "$WEIGHT_MSIM" == "1" {
 15.         // Weight-type notes:
.         //   `wt' = [pw=max_sim]  — reghdfe/ppmlhdfe accept pw; ppmlhdfe rejects aw
.         //   `wt_bin' = [aw=max_sim] — binscatter accepts only aw / fw, not pw
.         // WLS coefficients are identical under aw vs pw (SEs are handled by
.         // vce(cluster) anyway), so mixing the two doesn't change anything
.         // substantively — it just gets past each command's accepted weight type.
.         local wt "[pw=max_sim]"
 16.         local wt_bin "[aw=max_sim]"
 17.         local wsuf "_msimwt"
 18.     }
 19.     local suf ""
 20.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
 21.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
 22.     use ../temp/es_`samp'`suf', clear
 23. 
.     gen post = year >= 2014
 24.     gen Z_it       = exposure      * post
 25.     gen Z_share_it = mkt_spend_shr * post
 26. 
.     // PPML expects non-negative counts / weights. Position counts (n_first_ppr,
.     // n_middle_ppr, n_last_ppr) fit fine; the mean-based position metrics
.     // (avg_position, avg_team_size_*) are conditional means and belong in reghdfe/OLS only.
.     local position_outcomes ""
 27.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
 28.         local position_outcomes n_first_ppr n_middle_ppr n_last_ppr
 29.     }
 30.     local outcomes cite_affl_wt ppr_cnt affl_wt ///
>                    cite_affl_wt_any ppr_cnt_any affl_wt_any ///
>                    cite_affl_wt_notlast ppr_cnt_notlast affl_wt_notlast ///
>                    avg_num_coathrs num_grants grants_per_paper grant_density ///
>                    `position_outcomes'
 31. 
.     foreach yvar of local outcomes {
 32.         qui sum `yvar' if year < 2014, d
 33.         local pre_mean = r(mean)
 34. 
.         local b_b = .
 35.         local b_se = .
 36.         local b_N = .
 37.         local b_r2 = .
 38.         local s_bx = .
 39.         local s_sex = .
 40.         local s_bs = .
 41.         local s_ses = .
 42.         local s_N = .
 43.         local s_r2 = .
 44.         cap noi ppmlhdfe `yvar' Z_it            `wt', absorb(`fes') vce(cluster `vce_cl')
 45.         if _rc == 0 {
 46.             local b_b  = _b[Z_it]
 47.             local b_se = _se[Z_it]
 48.             local b_N  = e(N)
 49.             local b_r2 = e(r2_p)
 50.         }
 51.         else di as error "ppml_pdid `yvar' base failed (rc=`_rc')"
 52.         cap noi ppmlhdfe `yvar' Z_it Z_share_it `wt', absorb(`fes') vce(cluster `vce_cl')
 53.         if _rc == 0 {
 54.             local s_bx  = _b[Z_it]
 55.             local s_sex = _se[Z_it]
 56.             local s_bs  = _b[Z_share_it]
 57.             local s_ses = _se[Z_share_it]
 58.             local s_N   = e(N)
 59.             local s_r2  = e(r2_p)
 60.         }
 61.         else di as error "ppml_pdid `yvar' +share failed (rc=`_rc')"
 62.         cap mat drop ppml_pdid_`yvar'
 63.         mat ppml_pdid_`yvar' = J(7,2,.)
 64.         mat ppml_pdid_`yvar'[1,1] = `b_b'
 65.         mat ppml_pdid_`yvar'[2,1] = `b_se'
 66.         mat ppml_pdid_`yvar'[5,1] = `pre_mean'
 67.         mat ppml_pdid_`yvar'[6,1] = `b_N'
 68.         mat ppml_pdid_`yvar'[7,1] = `b_r2'
 69.         mat ppml_pdid_`yvar'[1,2] = `s_bx'
 70.         mat ppml_pdid_`yvar'[2,2] = `s_sex'
 71.         mat ppml_pdid_`yvar'[3,2] = `s_bs'
 72.         mat ppml_pdid_`yvar'[4,2] = `s_ses'
 73.         mat ppml_pdid_`yvar'[5,2] = `pre_mean'
 74.         mat ppml_pdid_`yvar'[6,2] = `s_N'
 75.         mat ppml_pdid_`yvar'[7,2] = `s_r2'
 76.         mat rownames ppml_pdid_`yvar' = b_exposure se_exposure b_share se_share pre_mean N r2_p
 77.         mat colnames ppml_pdid_`yvar' = base with_share
 78. 
.         di as text "ppml_specs `samp'`suf' `yvar': pdid b=" %7.4f ppml_pdid_`yvar'[1,1] ///
>             "  pre_mean=" %7.4f `pre_mean'
 79. 
.         // Figures: PPML-consistent Frisch-Waugh binscatter. Uses the IRLS
.         // working response z = xb + (y - mu)/mu with mu-weighted partial-out;
.         // slope of the plotted line equals the ppmlhdfe beta by construction.
.         local var_name "`yvar'"
 80.         if "`yvar'" == "cite_affl_wt"         local var_name "Citation Weighted Output"
 81.         if "`yvar'" == "ppr_cnt"              local var_name "Publication Count"
 82.         if "`yvar'" == "affl_wt"              local var_name "Affiliation Weighted Output"
 83.         if "`yvar'" == "cite_affl_wt_any"     local var_name "Citation Weighted Output (any position)"
 84.         if "`yvar'" == "ppr_cnt_any"          local var_name "Publication Count (any position)"
 85.         if "`yvar'" == "affl_wt_any"          local var_name "Affiliation Weighted Output (any position)"
 86.         if "`yvar'" == "cite_affl_wt_notlast" local var_name "Citation Weighted Output (non-last author)"
 87.         if "`yvar'" == "ppr_cnt_notlast"      local var_name "Publication Count (non-last author)"
 88.         if "`yvar'" == "affl_wt_notlast"      local var_name "Affiliation Weighted Output (non-last author)"
 89.         if "`yvar'" == "avg_num_coathrs"      local var_name "Avg Coauthors"
 90.         if "`yvar'" == "num_grants"           local var_name "Num Grants"
 91.         if "`yvar'" == "grants_per_paper"     local var_name "Grants per Paper"
 92.         if "`yvar'" == "grant_density"        local var_name "Grant Density"
 93.         if "`yvar'" == "n_first_ppr"          local var_name "# First-Author Papers"
 94.         if "`yvar'" == "n_middle_ppr"         local var_name "# Middle-Author Papers"
 95.         if "`yvar'" == "n_last_ppr"           local var_name "# Last-Author Papers"
 96.         local poisson_name "`var_name'"
 97.         if "`yvar'" == "ppr_cnt"              local poisson_name "Publications"
 98.         if "`yvar'" == "cite_affl_wt"         local poisson_name "Citation-Weighted Output"
 99.         if "`yvar'" == "affl_wt"              local poisson_name "Affiliation-Weighted Output"
100.         if "`yvar'" == "ppr_cnt_any"          local poisson_name "Publications (any position)"
101.         if "`yvar'" == "cite_affl_wt_any"     local poisson_name "Citation-Weighted Output (any position)"
102.         if "`yvar'" == "affl_wt_any"          local poisson_name "Affiliation-Weighted Output (any position)"
103.         if "`yvar'" == "ppr_cnt_notlast"      local poisson_name "Publications (non-last author)"
104.         if "`yvar'" == "cite_affl_wt_notlast" local poisson_name "Citation-Weighted Output (non-last author)"
105.         if "`yvar'" == "affl_wt_notlast"      local poisson_name "Affiliation-Weighted Output (non-last author)"
106.         if "`yvar'" == "avg_num_coathrs"      local poisson_name "Coauthors"
107.         if "`yvar'" == "num_grants"           local poisson_name "Grants"
108.         if "`yvar'" == "grants_per_paper"     local poisson_name "Grants per Paper"
109.         if "`yvar'" == "grant_density"        local poisson_name "Grant Density"
110. 
.         // FWL partial-out uses the IRLS working-weight _mu. Under max_sim
.         // weighting, the effective analytic weight is _mu * max_sim so the
.         // slope of the plotted binscatter still equals the weighted ppmlhdfe β.
.         preserve
111.             cap drop _y_r _Z_r _mu _z_work _dvar _fwlw
112.             cap noi ppmlhdfe `yvar' Z_it `wt', absorb(`fes') vce(cluster `vce_cl') d(_dvar)
113.             if _rc == 0 {
114.                 predict double _mu, mu
115.                 keep if !mi(_mu) & _mu > 0
116.                 gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu
117.                 gen double _fwlw = _mu
118.                 if "$WEIGHT_MSIM" == "1" replace _fwlw = _mu * max_sim
119.                 cap noi qui reghdfe _z_work [pw=_fwlw], absorb(`fes') residuals(_y_r)
120.                 if _rc == 0 cap noi qui reghdfe Z_it [pw=_fwlw], absorb(`fes') residuals(_Z_r)
121.                 if _rc {
122.                     di as error "ppml FWL `yvar' failed; skipping plot."
123.                     restore
124.                     continue
125.                 }
126.                 local pb_str  : dis %7.3f ppml_pdid_`yvar'[1,1]
127.                 local pse_str : dis %7.3f ppml_pdid_`yvar'[2,1]
128.                 binscatter _y_r _Z_r [aw=_fwlw], n(30) ///
>                     xtitle("Exposure x Post") ///
>                     ytitle("{&Delta} Log Expected `poisson_name'") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolor(ebblue) ///
>                     note("{&beta} = `pb_str' (SE: `pse_str')", size(small) pos(7) ring(1) justification(left)) ///
>                     plotregion(margin(sides))
129.                 graph export ../output/figures/`samp'/ppml_pdid_`yvar'`suf'`wsuf'.pdf, replace
130.             }
131.         restore
132. 
.         preserve
133.             cap drop _y_r _Z_r _mu _z_work _dvar _fwlw
134.             cap noi ppmlhdfe `yvar' Z_it Z_share_it `wt', absorb(`fes') vce(cluster `vce_cl') d(_dvar)
135.             if _rc == 0 {
136.                 predict double _mu, mu
137.                 keep if !mi(_mu) & _mu > 0
138.                 gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu
139.                 gen double _fwlw = _mu
140.                 if "$WEIGHT_MSIM" == "1" replace _fwlw = _mu * max_sim
141.                 cap noi qui reghdfe _z_work Z_share_it [pw=_fwlw], absorb(`fes') residuals(_y_r)
142.                 if _rc == 0 cap noi qui reghdfe Z_it Z_share_it [pw=_fwlw], absorb(`fes') residuals(_Z_r)
143.                 if _rc {
144.                     di as error "ppml FWL mshrctrl `yvar' failed; skipping plot."
145.                     restore
146.                     continue
147.                 }
148.                 local pbs_str  : dis %7.3f ppml_pdid_`yvar'[1,2]
149.                 local pses_str : dis %7.3f ppml_pdid_`yvar'[2,2]
150.                 binscatter _y_r _Z_r [aw=_fwlw], n(30) ///
>                     xtitle("Exposure x Post") ///
>                     ytitle("{&Delta} Log Expected `poisson_name'") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolor(ebblue) ///
>                     note("{&beta} = `pbs_str' (SE: `pses_str')", size(small) pos(7) ring(1) justification(left)) ///
>                     plotregion(margin(sides))
151.                 graph export ../output/figures/`samp'/ppml_pdid_`yvar'`suf'_mshrctrl`wsuf'.pdf, replace
152.             }
153.         restore
154.     }
155. end

. 
. program ppml_pdid_het_binscatter
  1.     // Per-group PPML pooled-DiD FWL binscatter of ppr_cnt on Z_it, with
.     // Z_share_it (mkt_spend_shr x post) partialled out. One figure per group
.     // per heterogeneity dimension -- same 7 dummy pairs as event_study's
.     // heterogeneity block.
.     //
.     // Match to the interacted parameterization: for each pair (g1, g2) we
.     // fit ONE PPML on the FULL sample with fully-interacted Z and share:
.     //   ppmlhdfe ppr_cnt Z_g1 Z_g2 S_g1 S_g2, absorb(FEs)
.     // where Z_g = Z_it * g and S_g = Z_share_it * g. So _b[Z_g1] and
.     // _b[Z_g2] are the group-specific β's -- identical to the split-
.     // interaction spec in event_study's heterogeneity block (up to
.     // reparameterization). This lets institution / cluster FEs pool
.     // across g1 and g2 rather than being re-estimated per subgroup, so
.     // under FE_MODE = inst_cluster(_fldyr) it recovers the interacted β
.     // rather than a subsample β.
.     //
.     // Binscatter FWL: residualize _z_work and Z_g against the OTHER
.     // interactions plus S_g and FEs, then plot on the g==1 rows -- on
.     // those rows the "other" interactions are mechanically zero, so the
.     // FWL slope of _z_work on Z_g equals _b[Z_g] exactly.
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local wt ""
 13.     local wsuf ""
 14.     if "$WEIGHT_MSIM" == "1" {
 15.         local wt "[pw=max_sim]"
 16.         local wsuf "_msimwt"
 17.     }
 18.     local suf ""
 19.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
 20.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
 21.     cap mkdir "../output/figures/`samp'/ppml_pdid_het_bs"
 22. 
.     local dummy_pairs `" "young old" "r1 r2" "high_pre_ppr low_pre_ppr" "high_grants low_grants" "big_team small_team" "many_coauth few_coauth" "big_msa small_msa" "'
 23. 
.     foreach pair of local dummy_pairs {
 24.         local g1 : word 1 of `pair'
 25.         local g2 : word 2 of `pair'
 26. 
.         preserve
 27.             use ../temp/es_`samp'`suf', clear
 28.             gen post       = year >= 2014
 29.             gen Z_it       = exposure      * post
 30.             gen Z_share_it = mkt_spend_shr * post
 31.             // Fully-interacted parameterization: one Z per group, one S per group.
.             gen Z_`g1' = Z_it       * `g1'
 32.             gen Z_`g2' = Z_it       * `g2'
 33.             gen S_`g1' = Z_share_it * `g1'
 34.             gen S_`g2' = Z_share_it * `g2'
 35. 
.             cap drop _mu _z_work _dvar _fwlw
 36.             cap noi ppmlhdfe ppr_cnt Z_`g1' Z_`g2' S_`g1' S_`g2' `wt', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
 37.             if _rc {
 38.                 di as error "ppml_pdid_het_bs `samp'`suf' `g1'/`g2' joint failed (rc=`_rc'); skipping pair."
 39.                 restore
 40.                 continue
 41.             }
 42.             local b_`g1'  = _b[Z_`g1']
 43.             local se_`g1' = _se[Z_`g1']
 44.             local b_`g2'  = _b[Z_`g2']
 45.             local se_`g2' = _se[Z_`g2']
 46. 
.             // IRLS working response + FWL weight, computed once from the joint fit.
.             predict double _mu, mu
 47.             keep if !mi(_mu) & _mu > 0
 48.             gen double _z_work = ln(_mu) + (ppr_cnt - _mu)/_mu
 49.             gen double _fwlw = _mu
 50.             if "$WEIGHT_MSIM" == "1" replace _fwlw = _mu * max_sim
 51. 
.             foreach grp in `g1' `g2' {
 52.                 // "other" = the sibling group whose Z / S are treated as controls.
.                 local other = cond("`grp'" == "`g1'", "`g2'", "`g1'")
 53. 
.                 cap drop _y_r _Z_r
 54.                 cap noi qui reghdfe _z_work Z_`other' S_`g1' S_`g2' [pw=_fwlw], ///
>                         absorb(`fes') residuals(_y_r)
 55.                 if _rc == 0 cap noi qui reghdfe Z_`grp' Z_`other' S_`g1' S_`g2' [pw=_fwlw], ///
>                         absorb(`fes') residuals(_Z_r)
 56.                 if _rc {
 57.                     di as error "ppml_pdid_het_bs FWL `grp' (paired with `other') failed; skipping plot."
 58.                     continue
 59.                 }
 60.                 local b_str  : dis %7.3f `b_`grp''
 61.                 local se_str : dis %7.3f `se_`grp''
 62.                 binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1, n(30) ///
>                     xtitle("Exposure x Post") ///
>                     ytitle("{&Delta} Log Expected Publications") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolor(ebblue) ///
>                     note("{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left)) ///
>                     plotregion(margin(sides))
 63.                 graph export ///
>                     ../output/figures/`samp'/ppml_pdid_het_bs/ppml_pdid_ppr_cnt_`grp'_mshrctrl`suf'`wsuf'.pdf, ///
>                     replace
 64.             }
 65.         restore
 66.     }
 67. end

. 
. program placebo_treatment
  1.     // Pre-period-only placebo: restrict panel to year <= 2013 (drops the actual
.     // treatment + post period entirely) and assign a fake treatment year.
.     // If parallel trends hold, beta on (exposure * placebo_post) should be ~0
.     // and statistically insignificant. Runs for placebo years 2011 and 2012.
.     // Also runs an event-study version where each pre-2014 year-relative-to-
.     // placebo gets its own exposure interaction, so you can visually inspect
.     // whether the placebo "effect" shows up at a specific year.
.     // All specifications are ppmlhdfe with the mkt_spend_shr sum-of-shares control.
.     // Matrices placebo<yr>_<yvar> have rows
.     // [b_exp, se_exp, b_share, se_share, pre_mean, N, r2_p] and one column.
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
 15. 
.     local outcomes cite_affl_wt ppr_cnt cite_affl_wt_any ppr_cnt_any ///
>                    cite_affl_wt_notlast ppr_cnt_notlast ///
>                    avg_num_coathrs num_grants grants_per_paper grant_density
 16. 
.     cap mkdir ../output/tables
 17.     cap mkdir ../output/tables/`samp'
 18.     cap mkdir ../output/figures/`samp'
 19. 
.     foreach placebo_yr in 2011 2012 {
 20.         use ../temp/es_`samp'`suf', clear
 21.         keep if year <= 2013     // strictly pre-treatment window
 22. 
.         gen placebo_post   = year >= `placebo_yr'
 23.         gen Z_placebo      = exposure      * placebo_post
 24.         gen Z_share_placebo = mkt_spend_shr * placebo_post
 25. 
.         foreach yvar of local outcomes {
 26.             qui sum `yvar' if year < `placebo_yr', d
 27.             local pre_mean = r(mean)
 28. 
.             local b     = .
 29.             local se    = .
 30.             local b_s   = .
 31.             local se_s  = .
 32.             local N     = .
 33.             local r2_p  = .
 34.             cap noi ppmlhdfe `yvar' Z_placebo Z_share_placebo, ///
>                     absorb(`fes') vce(cluster `vce_cl')
 35.             if _rc == 0 {
 36.                 local b    = _b[Z_placebo]
 37.                 local se   = _se[Z_placebo]
 38.                 local b_s  = _b[Z_share_placebo]
 39.                 local se_s = _se[Z_share_placebo]
 40.                 local N    = e(N)
 41.                 local r2_p = e(r2_p)
 42.             }
 43.             else di as error "placebo_treatment `yvar' (placebo=`placebo_yr') ppml failed (rc=`_rc')"
 44. 
.             local t = cond(`se' > 0 & !mi(`se'), `b' / `se', .)
 45.             di as text "placebo_treatment `samp'`suf' `yvar' (placebo=`placebo_yr'):" ///
>                 _newline "    ppmlhdfe (+share)  b=" %8.4f `b'   "  se=" %8.4f `se'   "  t=" %6.2f `t' ///
>                 "  b_share=" %8.4f `b_s' "  se_share=" %8.4f `se_s' ///
>                 "  pre_mean=" %8.4f `pre_mean' "  N=" %8.0f `N'
 46. 
.             cap mat drop placebo`placebo_yr'_`yvar'
 47.             mat placebo`placebo_yr'_`yvar' = J(7,1,.)
 48.             mat placebo`placebo_yr'_`yvar'[1,1] = `b'
 49.             mat placebo`placebo_yr'_`yvar'[2,1] = `se'
 50.             mat placebo`placebo_yr'_`yvar'[3,1] = `b_s'
 51.             mat placebo`placebo_yr'_`yvar'[4,1] = `se_s'
 52.             mat placebo`placebo_yr'_`yvar'[5,1] = `pre_mean'
 53.             mat placebo`placebo_yr'_`yvar'[6,1] = `N'
 54.             mat placebo`placebo_yr'_`yvar'[7,1] = `r2_p'
 55.             mat rownames placebo`placebo_yr'_`yvar' = b_exp se_exp b_share se_share pre_mean N r2_p
 56.             mat colnames placebo`placebo_yr'_`yvar' = ppmlhdfe_wshr
 57.         }
 58.     }
 59. 
.     // Placebo event study: re-run the entire event study on the FULL 2010-2019
.     // panel but with a fake treatment year as the omitted reference. Pre-placebo
.     // years should be ~0 if trends are parallel. Years between the placebo and
.     // 2014 should also be ~0 (no real treatment yet). The real effect should
.     // begin at 2014 (marked with a dashed vertical line). If the response curve
.     // jumps at the placebo year instead of 2014, that's evidence of a pre-trend
.     // problem in the real spec. Estimated by ppmlhdfe with mkt_spend_shr
.     // sum-of-shares interacted with event time as controls.
.     foreach placebo_yr in 2011 2012 {
 60.         // Placebo ES on all four headline outcome flavors so the pre-trend
.         // check covers the same outcomes we report on. Position outcomes are
.         // omitted here — placebo pre-trends on counts of first/middle papers
.         // are covered by the placebo_treatment pooled test above.
.         foreach yvar in ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any ///
>                         ppr_cnt_notlast cite_affl_wt_notlast {
 61.             if "`yvar'" == "ppr_cnt"              local poisson_name "Publications"
 62.             if "`yvar'" == "cite_affl_wt"         local poisson_name "Citation-Weighted Output"
 63.             if "`yvar'" == "ppr_cnt_any"          local poisson_name "Publications (any position)"
 64.             if "`yvar'" == "cite_affl_wt_any"     local poisson_name "Citation-Weighted Output (any position)"
 65.             if "`yvar'" == "ppr_cnt_notlast"      local poisson_name "Publications (non-last author)"
 66.             if "`yvar'" == "cite_affl_wt_notlast" local poisson_name "Citation-Weighted Output (non-last author)"
 67. 
.             use ../temp/es_`samp'`suf', clear
 68.             cap drop pl_rel pl_int_lead* pl_int_lag* pl_mshr_lead* pl_mshr_lag*
 69.             gen pl_rel = year - `placebo_yr'
 70.             qui sum pl_rel
 71.             local pl_abs_lag  = abs(r(max))
 72.             local pl_abs_lead = abs(r(min))
 73.             forval i = 1/`pl_abs_lead' {
 74.                 gen pl_int_lead`i'  = exposure      if pl_rel == -`i'
 75.                 gen pl_mshr_lead`i' = mkt_spend_shr if pl_rel == -`i'
 76.             }
 77.             forval i = 0/`pl_abs_lag' {
 78.                 gen pl_int_lag`i'  = exposure      if pl_rel == `i'
 79.                 gen pl_mshr_lag`i' = mkt_spend_shr if pl_rel == `i'
 80.             }
 81.             ds pl_int_lead* pl_int_lag* pl_mshr_lead* pl_mshr_lag*
 82.             foreach v in `r(varlist)' {
 83.                 replace `v' = 0 if mi(`v')
 84.             }
 85.             local pl_int_leads
 86.             local pl_int_lags
 87.             local pl_mshr_leads
 88.             local pl_mshr_lags
 89.             forval i = 2/`pl_abs_lead' {
 90.                 local pl_int_leads  pl_int_lead`i'  `pl_int_leads'
 91.                 local pl_mshr_leads pl_mshr_lead`i' `pl_mshr_leads'
 92.             }
 93.             forval i = 0/`pl_abs_lag' {
 94.                 local pl_int_lags  `pl_int_lags'  pl_int_lag`i'
 95.                 local pl_mshr_lags `pl_mshr_lags' pl_mshr_lag`i'
 96.             }
 97. 
.             // pl_int_lead1 / pl_mshr_lead1 (year `placebo_yr'-1) are the omitted
.             // reference for exposure and share interactions — never included in
.             // the regressor list, so rel=-1 stays the reference year.
.             cap noi ppmlhdfe `yvar' `pl_int_leads' `pl_int_lags' ///
>                                     `pl_mshr_leads' `pl_mshr_lags', ///
>                     absorb(`fes') vce(cluster `vce_cl')
 98.             if _rc {
 99.                 di as error "placebo ES ppmlhdfe `yvar' yr`placebo_yr' failed (rc=`_rc'); skipping."
100.                 continue
101.             }
102. 
.             preserve
103.             cap mat drop es
104.             foreach var in `pl_int_leads' `pl_int_lags' pl_int_lead1 {
105.                 if "`var'" == "pl_int_lead1" {
106.                     mat row = 0,0
107.                 }
108.                 else {
109.                     mat row = _b[`var'], _se[`var']
110.                 }
111.                 mat es = nullmat(es) \ row
112.             }
113.             svmat es
114.             keep es1 es2
115.             drop if mi(es1)
116.             rename (es1 es2) (b se)
117.             gen ub = b + 1.96*se
118.             gen lb = b - 1.96*se
119.             // rel mapping mirrors event_study: leads (deepest first), then
.             // lags 0..K, then the omitted reference -1 at the end.
.             gen rel = -`pl_abs_lead' if _n == 1
120.             replace rel = rel[_n-1]+1 if _n > 1
121.             replace rel = rel + 1 if rel >= -1
122.             replace rel = -1 if rel == `pl_abs_lag' + 1
123.             gen year = rel + `placebo_yr'
124.             hashsort rel
125.             sum ub, d
126.             local ymax = round(r(max), 0.1)
127.             sum lb, d
128.             local ymin = round(r(min), 0.1)
129.             local ref_yr = `placebo_yr' - 1
130.             tw rcap ub lb year if year != `ref_yr', lcolor(cranberry%70) msize(vsmall) || ///
>               scatter b year, mcolor(cranberry) ///
>               , xlab(2010(1)2019) xtitle("Year (placebo treatment at `placebo_yr')") ///
>                 ytitle("{&Delta} Log Expected `poisson_name'") ///
>                 ylab(`ymin'(0.1)`ymax') yline(0, lcolor(gs10) lpattern(solid)) ///
>                 xline(2014, lpattern(dash) lcolor(gs10)) ///
>                 title("Placebo ES: treatment shifted to `placebo_yr' (real: 2014)", size(small)) ///
>                 legend(off) plotregion(margin(sides))
131.             graph export ../output/figures/`samp'/placebo_es_`yvar'_yr`placebo_yr'`suf'.pdf, replace
132.             save ../temp/placebo_es_`yvar'_yr`placebo_yr'`suf', replace
133.             restore
134.         }
135.     }
136. end

. 
. program trim_top
  1.     // Composition check: drop the top X% of PIs by pre-period publication
.     // count (pre_ppr_cnt_sum, computed in restrict_samp), then re-estimate
.     // pdid (reghdfe) and ppml_pdid. If the main effect is driven by a few
.     // high-baseline outliers, dropping them will collapse the coefficient.
.     // Runs at trim levels {1, 5, 10, 25}; writes one matrix per (trim, yvar)
.     // for output_tables and a comparison figure per outcome.
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
 15. 
.     local outcomes cite_affl_wt ppr_cnt cite_affl_wt_any ppr_cnt_any ///
>                    cite_affl_wt_notlast ppr_cnt_notlast ///
>                    avg_num_coathrs num_grants grants_per_paper grant_density
 16.     local trims 1 5 10 25
 17. 
.     cap mkdir ../output/tables/`samp'
 18.     cap mkdir ../output/figures/`samp'
 19. 
.     foreach trim of local trims {
 20.         use ../temp/es_`samp'`suf', clear
 21.         // pre_ppr_cnt_sum is one value per PI; collapse to one row, compute
.         // the (100-trim) percentile cut, drop above.
.         bys athr_id: gen _one = _n == 1
 22.         qui sum pre_ppr_cnt_sum if _one == 1, d
 23.         local p = 100 - `trim'
 24.         qui _pctile pre_ppr_cnt_sum if _one == 1, p(`p')
 25.         local cut = r(r1)
 26.         qui gunique athr_id
 27.         local n_pre = r(unique)
 28.         drop if pre_ppr_cnt_sum > `cut'
 29.         qui gunique athr_id
 30.         local n_post = r(unique)
 31.         di as text "trim_top `samp'`suf' trim=`trim'%: cut=" %7.2f `cut' ///
>             "  PIs dropped " (`n_pre' - `n_post') " / `n_pre' (kept " %7.4f (`n_post' / `n_pre') ")"
 32. 
.         gen post       = year >= 2014
 33.         gen Z_it       = exposure      * post
 34.         gen Z_share_it = mkt_spend_shr * post
 35. 
.         foreach yvar of local outcomes {
 36.             qui sum `yvar' if year < 2014, d
 37.             local pre_mean = r(mean)
 38. 
.             local lb = .
 39.             local lse = .
 40.             local lN = .
 41.             cap noi reghdfe `yvar' Z_it, absorb(`fes') vce(cluster `vce_cl')
 42.             if _rc == 0 {
 43.                 local lb  = _b[Z_it]
 44.                 local lse = _se[Z_it]
 45.                 local lN  = e(N)
 46.             }
 47. 
.             local pb = .
 48.             local pse = .
 49.             local pN = .
 50.             cap noi ppmlhdfe `yvar' Z_it, absorb(`fes') vce(cluster `vce_cl')
 51.             if _rc == 0 {
 52.                 local pb  = _b[Z_it]
 53.                 local pse = _se[Z_it]
 54.                 local pN  = e(N)
 55.             }
 56. 
.             di as text "  trim=`trim'% `yvar': reghdfe b=" %8.4f `lb' "  se=" %8.4f `lse' ///
>                 "    ppml b=" %8.4f `pb' "  se=" %8.4f `pse' "    pre_mean=" %7.4f `pre_mean'
 57. 
.             cap mat drop trim`trim'_`yvar'
 58.             mat trim`trim'_`yvar' = J(5,2,.)
 59.             mat trim`trim'_`yvar'[1,1] = `lb'
 60.             mat trim`trim'_`yvar'[2,1] = `lse'
 61.             mat trim`trim'_`yvar'[3,1] = `pre_mean'
 62.             mat trim`trim'_`yvar'[4,1] = `lN'
 63.             mat trim`trim'_`yvar'[5,1] = `n_post'
 64.             mat trim`trim'_`yvar'[1,2] = `pb'
 65.             mat trim`trim'_`yvar'[2,2] = `pse'
 66.             mat trim`trim'_`yvar'[3,2] = `pre_mean'
 67.             mat trim`trim'_`yvar'[4,2] = `pN'
 68.             mat trim`trim'_`yvar'[5,2] = `n_post'
 69.             mat rownames trim`trim'_`yvar' = b se pre_mean N n_PIs
 70.             mat colnames trim`trim'_`yvar' = reghdfe ppmlhdfe
 71.         }
 72.         drop _one
 73.     }
 74. 
.     // Comparison figure per key outcome: linear pdid β at each trim level
.     foreach yvar in ppr_cnt cite_affl_wt {
 75.         if "`yvar'" == "ppr_cnt"      local var_name "Publication Count"
 76.         if "`yvar'" == "cite_affl_wt" local var_name "Citation Weighted Output"
 77.         local poisson_name "`var_name'"
 78.         if "`yvar'" == "ppr_cnt"      local poisson_name "Publications"
 79.         if "`yvar'" == "cite_affl_wt" local poisson_name "Citation-Weighted Output"
 80. 
.         preserve
 81.         clear
 82.         set obs 5
 83.         gen trim = 0 in 1
 84.         replace trim = 1 in 2
 85.         replace trim = 5 in 3
 86.         replace trim = 10 in 4
 87.         replace trim = 25 in 5
 88.         gen b  = .
 89.         gen se = .
 90.         // trim = 0 uses the main pdid_<yvar> matrix
.         cap confirm matrix pdid_`yvar'
 91.         if !_rc {
 92.             replace b  = pdid_`yvar'[1,1] in 1
 93.             replace se = pdid_`yvar'[2,1] in 1
 94.         }
 95.         local i = 2
 96.         foreach t of local trims {
 97.             cap confirm matrix trim`t'_`yvar'
 98.             if !_rc {
 99.                 replace b  = trim`t'_`yvar'[1,1] in `i'
100.                 replace se = trim`t'_`yvar'[2,1] in `i'
101.             }
102.             local ++i
103.         }
104.         gen ub = b + 1.96*se
105.         gen lb = b - 1.96*se
106.         tw rcap ub lb trim, lcolor(ebblue%70) msize(small) || ///
>            scatter b trim, mcolor(ebblue) msize(medium) ///
>            , xlab(0 "Full sample" 1 "Drop top 1%" 5 "5%" 10 "10%" 25 "25%", labsize(small)) ///
>              xtitle("Top-pre-pub PIs dropped") ///
>              ytitle("pdid {&beta}: `var_name'") ///
>              yline(0, lcolor(gs10) lpattern(solid)) ///
>              title("Trim-top sensitivity: `var_name'", size(small)) ///
>              legend(off) plotregion(margin(sides))
107.         graph export ../output/figures/`samp'/trim_top_`yvar'`suf'.pdf, replace
108.         restore
109. 
.         // ppml version
.         preserve
110.         clear
111.         set obs 5
112.         gen trim = 0 in 1
113.         replace trim = 1 in 2
114.         replace trim = 5 in 3
115.         replace trim = 10 in 4
116.         replace trim = 25 in 5
117.         gen b  = .
118.         gen se = .
119.         cap confirm matrix ppml_pdid_`yvar'
120.         if !_rc {
121.             replace b  = ppml_pdid_`yvar'[1,1] in 1
122.             replace se = ppml_pdid_`yvar'[2,1] in 1
123.         }
124.         local i = 2
125.         foreach t of local trims {
126.             cap confirm matrix trim`t'_`yvar'
127.             if !_rc {
128.                 replace b  = trim`t'_`yvar'[1,2] in `i'
129.                 replace se = trim`t'_`yvar'[2,2] in `i'
130.             }
131.             local ++i
132.         }
133.         gen ub = b + 1.96*se
134.         gen lb = b - 1.96*se
135.         tw rcap ub lb trim, lcolor(cranberry%70) msize(small) || ///
>            scatter b trim, mcolor(cranberry) msize(medium) ///
>            , xlab(0 "Full sample" 1 "Drop top 1%" 5 "5%" 10 "10%" 25 "25%", labsize(small)) ///
>              xtitle("Top-pre-pub PIs dropped") ///
>              ytitle("{&Delta} Log Expected `poisson_name'") ///
>              yline(0, lcolor(gs10) lpattern(solid)) ///
>              title("Trim-top sensitivity (ppml): `var_name'", size(small)) ///
>              legend(off) plotregion(margin(sides))
136.         graph export ../output/figures/`samp'/trim_top_ppml_`yvar'`suf'.pdf, replace
137.         restore
138.     }
139. end

