. program joint_outcome_test
  1.     // Three parameterizations of the same H0: exposure-on-papers = exposure-on-cite-weighted-output.
.     //   log   : reghdfe on ln(1+y). β interpreted as proportional log response; comparable
.     //           because both outcomes are on the same log scale. Existing default.
.     //   norm  : reghdfe on y / pre-period mean(y). β is "% of pre-mean per unit exposure",
.     //           so ppr and cite are on the same "% change" ruler. Raw levels version of the same test.
.     //   ppml  : ppmlhdfe on raw y. β is semi-elasticity per outcome — directly comparable
.     //           without the log(1+·) fudge and without the pre-mean normalization.
.     // Stacking pattern is identical across the three: outcome dummy + Z x outcome_cite, cluster athr_id.
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
  5.     use ../temp/es_`samp'`suf', clear
  6. 
.     foreach v in cite_affl_wt ppr_cnt {
  7.         cap gen ln_`v' = ln(1+`v')
  8.     }
  9. 
.     gen post = year >= 2014
 10.     gen Z_it = exposure * post
 11. 
.     // pre-period means used for the normalized-levels parameterization
.     qui sum ppr_cnt      if year < 2014
 12.     local mean_ppr = r(mean)
 13.     qui sum cite_affl_wt if year < 2014
 14.     local mean_cite = r(mean)
 15. 
.     keep athr_id year Z_it ppr_cnt cite_affl_wt ln_ppr_cnt ln_cite_affl_wt
 16. 
.     // Stack: outcome == 0 -> ppr row; outcome == 1 -> cite row. Each row carries
.     // all three y-parameterizations (raw for ppml, log, normalized level).
.     preserve
 17.         gen outcome = 1
 18.         gen y_raw = cite_affl_wt
 19.         gen y_ln  = ln_cite_affl_wt
 20.         gen y_nrm = cite_affl_wt / `mean_cite'
 21.         keep athr_id year Z_it outcome y_raw y_ln y_nrm
 22.         save ../temp/stack_cite_`samp'`suf', replace
 23.     restore
 24.     gen outcome = 0
 25.     gen y_raw = ppr_cnt
 26.     gen y_ln  = ln_ppr_cnt
 27.     gen y_nrm = ppr_cnt / `mean_ppr'
 28.     keep athr_id year Z_it outcome y_raw y_ln y_nrm
 29.     append using ../temp/stack_cite_`samp'`suf'
 30. 
.     egen athr_outcome = group(athr_id outcome)
 31.     egen year_outcome = group(year outcome)
 32.     gen Z_it_cite = Z_it * (outcome == 1)
 33. 
.     cap mat drop joint_`samp'`suf'
 34.     mat joint_`samp'`suf' = J(8,3,.)
 35.     mat rownames joint_`samp'`suf' = b_ppr se_ppr b_cite se_cite b_diff se_diff Wald_F p_value
 36.     mat colnames joint_`samp'`suf' = log norm_levels ppml
 37. 
.     // --- log parameterization ---
.     reghdfe y_ln Z_it Z_it_cite, absorb(athr_outcome year_outcome) vce(cluster athr_id)
 38.     local b_ppr_ln  = _b[Z_it]
 39.     local se_ppr_ln = _se[Z_it]
 40.     local b_diff_ln = _b[Z_it_cite]
 41.     local se_diff_ln = _se[Z_it_cite]
 42.     qui lincom Z_it + Z_it_cite
 43.     local b_cite_ln  = r(estimate)
 44.     local se_cite_ln = r(se)
 45.     qui test Z_it_cite
 46.     local F_ln = r(F)
 47.     local p_ln = r(p)
 48.     mat joint_`samp'`suf'[1,1] = `b_ppr_ln'
 49.     mat joint_`samp'`suf'[2,1] = `se_ppr_ln'
 50.     mat joint_`samp'`suf'[3,1] = `b_cite_ln'
 51.     mat joint_`samp'`suf'[4,1] = `se_cite_ln'
 52.     mat joint_`samp'`suf'[5,1] = `b_diff_ln'
 53.     mat joint_`samp'`suf'[6,1] = `se_diff_ln'
 54.     mat joint_`samp'`suf'[7,1] = `F_ln'
 55.     mat joint_`samp'`suf'[8,1] = `p_ln'
 56. 
.     // --- normalized-levels parameterization ---
.     reghdfe y_nrm Z_it Z_it_cite, absorb(athr_outcome year_outcome) vce(cluster athr_id)
 57.     local b_ppr_nr  = _b[Z_it]
 58.     local se_ppr_nr = _se[Z_it]
 59.     local b_diff_nr = _b[Z_it_cite]
 60.     local se_diff_nr = _se[Z_it_cite]
 61.     qui lincom Z_it + Z_it_cite
 62.     local b_cite_nr  = r(estimate)
 63.     local se_cite_nr = r(se)
 64.     qui test Z_it_cite
 65.     local F_nr = r(F)
 66.     local p_nr = r(p)
 67.     mat joint_`samp'`suf'[1,2] = `b_ppr_nr'
 68.     mat joint_`samp'`suf'[2,2] = `se_ppr_nr'
 69.     mat joint_`samp'`suf'[3,2] = `b_cite_nr'
 70.     mat joint_`samp'`suf'[4,2] = `se_cite_nr'
 71.     mat joint_`samp'`suf'[5,2] = `b_diff_nr'
 72.     mat joint_`samp'`suf'[6,2] = `se_diff_nr'
 73.     mat joint_`samp'`suf'[7,2] = `F_nr'
 74.     mat joint_`samp'`suf'[8,2] = `p_nr'
 75. 
.     // --- PPML parameterization (semi-elasticity per outcome, unit-free comparison) ---
.     local b_ppr_pp = .
 76.     local se_ppr_pp = .
 77.     local b_cite_pp = .
 78.     local se_cite_pp = .
 79.     local b_diff_pp = .
 80.     local se_diff_pp = .
 81.     local F_pp = .
 82.     local p_pp = .
 83.     cap noi ppmlhdfe y_raw Z_it Z_it_cite, absorb(athr_outcome year_outcome) vce(cluster athr_id)
 84.     if _rc == 0 {
 85.         local b_ppr_pp  = _b[Z_it]
 86.         local se_ppr_pp = _se[Z_it]
 87.         local b_diff_pp = _b[Z_it_cite]
 88.         local se_diff_pp = _se[Z_it_cite]
 89.         qui lincom Z_it + Z_it_cite
 90.         local b_cite_pp  = r(estimate)
 91.         local se_cite_pp = r(se)
 92.         qui test Z_it_cite
 93.         local F_pp = r(F)
 94.         local p_pp = r(p)
 95.     }
 96.     else di as error "joint_outcome_test ppml failed (rc=`_rc'); ppml column left missing."
 97.     mat joint_`samp'`suf'[1,3] = `b_ppr_pp'
 98.     mat joint_`samp'`suf'[2,3] = `se_ppr_pp'
 99.     mat joint_`samp'`suf'[3,3] = `b_cite_pp'
100.     mat joint_`samp'`suf'[4,3] = `se_cite_pp'
101.     mat joint_`samp'`suf'[5,3] = `b_diff_pp'
102.     mat joint_`samp'`suf'[6,3] = `se_diff_pp'
103.     mat joint_`samp'`suf'[7,3] = `F_pp'
104.     mat joint_`samp'`suf'[8,3] = `p_pp'
105. 
.     di as text "joint outcome test `samp'`suf':  H0 beta_ppr = beta_cite (same H0 in three flavors)"
106.     di as text "  --- log      : β_ln_ppr    = " %9.4f `b_ppr_ln'  "  β_ln_cite    = " %9.4f `b_cite_ln'  "  diff = " %9.4f `b_diff_ln'  "  F = " %9.4f `F_ln'  "  p = " %9.4f `p_ln'
107.     di as text "  --- norm lvl : β_ppr/mean  = " %9.4f `b_ppr_nr'  "  β_cite/mean  = " %9.4f `b_cite_nr'  "  diff = " %9.4f `b_diff_nr'  "  F = " %9.4f `F_nr'  "  p = " %9.4f `p_nr'
108.     di as text "  --- ppml     : β_ppr (sel) = " %9.4f `b_ppr_pp'  "  β_cite (sel) = " %9.4f `b_cite_pp'  "  diff = " %9.4f `b_diff_pp'  "  F = " %9.4f `F_pp'  "  p = " %9.4f `p_pp'
109. 
.     cap mkdir ../output/tables
110.     cap mkdir ../output/tables/`samp'
111.     qui matrix_to_txt, saving("../output/tables/`samp'/joint_outcome_test`suf'.txt") ///
>         matrix(joint_`samp'`suf') title(<tab:joint_outcome_test`suf'>) format(%20.4f) replace
112. end

. 
. program joint_sample_test
  1.     // Stacked DiD across the all_jrnls and top_jrnls samples (same outcome:
.     // ppr_cnt) so we get the joint covariance of beta_all and beta_top and
.     // can Wald-test H0: beta_all = beta_top. Rejecting => the paper-count
.     // response in top-tier outlets differs from the response measured across
.     // all outlets, i.e. the cut is not tier-uniform.
.     syntax, [r1r2(int 0) public(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
  5. 
.     cap confirm file ../temp/es_all_jrnls`suf'.dta
  6.     if _rc {
  7.         di as error "joint_sample_test: ../temp/es_all_jrnls`suf'.dta missing; skipping."
  8.         exit
  9.     }
 10.     cap confirm file ../temp/es_top_jrnls`suf'.dta
 11.     if _rc {
 12.         di as error "joint_sample_test: ../temp/es_top_jrnls`suf'.dta missing; skipping."
 13.         exit
 14.     }
 15. 
.     use ../temp/es_all_jrnls`suf', clear
 16.     keep athr_id year exposure ppr_cnt
 17.     rename ppr_cnt y
 18.     gen sample = 0     // all_jrnls
 19.     save ../temp/stack_all_jrnls`suf', replace
 20. 
.     use ../temp/es_top_jrnls`suf', clear
 21.     keep athr_id year exposure ppr_cnt
 22.     rename ppr_cnt y
 23.     gen sample = 1     // top_jrnls
 24.     append using ../temp/stack_all_jrnls`suf'
 25. 
.     gen post = year >= 2014
 26.     gen Z_it     = exposure * post
 27.     gen Z_it_top = Z_it * (sample == 1)
 28. 
.     egen athr_sample = group(athr_id sample)
 29.     egen year_sample = group(year sample)
 30. 
.     // Cluster on athr_id so PIs that appear in both samples are not treated
.     // as independent across rows.
.     reghdfe y Z_it Z_it_top, absorb(athr_sample year_sample) vce(cluster athr_id)
 31. 
.     local b_all   = _b[Z_it]
 32.     local se_all  = _se[Z_it]
 33.     local b_diff  = _b[Z_it_top]
 34.     local se_diff = _se[Z_it_top]
 35.     qui lincom Z_it + Z_it_top
 36.     local b_top   = r(estimate)
 37.     local se_top  = r(se)
 38. 
.     qui test Z_it_top
 39.     local F_w = r(F)
 40.     local p_w = r(p)
 41. 
.     di as text "joint sample test `suf':  H0 beta_all_jrnls = beta_top_jrnls (ppr_cnt)"
 42.     di as text "  beta_all_jrnls   = " %9.4f `b_all'  "   SE = " %9.4f `se_all'
 43.     di as text "  beta_top_jrnls   = " %9.4f `b_top'  "   SE = " %9.4f `se_top'
 44.     di as text "  diff (top - all) = " %9.4f `b_diff' "   SE = " %9.4f `se_diff'
 45.     di as text "  Wald F = " %9.4f `F_w' "   p = " %9.4f `p_w'
 46. 
.     cap mat drop joint_sample`suf'
 47.     mat joint_sample`suf' = J(8,1,.)
 48.     mat joint_sample`suf'[1,1] = `b_all'
 49.     mat joint_sample`suf'[2,1] = `se_all'
 50.     mat joint_sample`suf'[3,1] = `b_top'
 51.     mat joint_sample`suf'[4,1] = `se_top'
 52.     mat joint_sample`suf'[5,1] = `b_diff'
 53.     mat joint_sample`suf'[6,1] = `se_diff'
 54.     mat joint_sample`suf'[7,1] = `F_w'
 55.     mat joint_sample`suf'[8,1] = `p_w'
 56.     mat rownames joint_sample`suf' = b_all se_all b_top se_top b_diff se_diff Wald_F p_value
 57.     mat colnames joint_sample`suf' = stacked
 58. 
.     cap mkdir ../output/tables
 59.     qui matrix_to_txt, saving("../output/tables/joint_sample_test`suf'.txt") ///
>         matrix(joint_sample`suf') title(<tab:joint_sample_test`suf'>) format(%20.4f) replace
 60. end

. 
. program combine_es_graphs
  1.     syntax, samp(str)
  2.     // Extended outcome list mirrors event_study's outer loop. Position outcomes
.     // are attempted; combine_es_graphs already skips outcomes whose young/old
.     // .dta files are missing, so pre-position-metrics builds fall through cleanly.
.     local position_outcomes n_first_ppr n_middle_ppr n_last_ppr ///
>         avg_position avg_position_rat avg_team_size_last avg_team_size_notlast
  3.     foreach yvar in cite_affl_wt ppr_cnt ln_cite_affl_wt ln_ppr_cnt ///
>                     cite_affl_wt_any ppr_cnt_any ln_cite_affl_wt_any ln_ppr_cnt_any ///
>                     cite_affl_wt_notlast ppr_cnt_notlast ln_cite_affl_wt_notlast ln_ppr_cnt_notlast ///
>                     avg_num_coathrs num_grants grants_per_paper grant_density ///
>                     `position_outcomes' {
  4.         // Base outcome labels
.         if "`yvar'" == "cite_affl_wt"    local var_name = "Citation Weighted Output"
  5.         if "`yvar'" == "cite_affl_wt"    local gap  1
  6.         if "`yvar'" == "ppr_cnt"         local var_name = "Publication Count"
  7.         if "`yvar'" == "ppr_cnt"         local gap 0.5
  8.         if "`yvar'" == "ln_ppr_cnt"      local var_name = "Log Publication Counts"
  9.         if "`yvar'" == "ln_ppr_cnt"      local gap 0.1
 10.         if "`yvar'" == "ln_cite_affl_wt" local var_name = "Log Citation Weighted Output"
 11.         if "`yvar'" == "ln_cite_affl_wt" local gap 0.1
 12.         if "`yvar'" == "ppr_cnt"      & "`samp'" == "top_jrnls" local gap 2
 13.         if "`yvar'" == "cite_affl_wt" & "`samp'" == "top_jrnls" local gap 2
 14.         // _any labels
.         if "`yvar'" == "ppr_cnt_any"         local var_name = "Publication Count (any position)"
 15.         if "`yvar'" == "ppr_cnt_any"         local gap 0.5
 16.         if "`yvar'" == "cite_affl_wt_any"    local var_name = "Citation Weighted Output (any position)"
 17.         if "`yvar'" == "cite_affl_wt_any"    local gap 1
 18.         if "`yvar'" == "ln_ppr_cnt_any"      local var_name = "Log Publication Counts (any position)"
 19.         if "`yvar'" == "ln_ppr_cnt_any"      local gap 0.1
 20.         if "`yvar'" == "ln_cite_affl_wt_any" local var_name = "Log Citation Weighted Output (any position)"
 21.         if "`yvar'" == "ln_cite_affl_wt_any" local gap 0.1
 22.         if "`yvar'" == "ppr_cnt_any"      & "`samp'" == "top_jrnls" local gap 2
 23.         if "`yvar'" == "cite_affl_wt_any" & "`samp'" == "top_jrnls" local gap 2
 24.         // _notlast labels
.         if "`yvar'" == "ppr_cnt_notlast"         local var_name = "Publication Count (non-last author)"
 25.         if "`yvar'" == "ppr_cnt_notlast"         local gap 0.5
 26.         if "`yvar'" == "cite_affl_wt_notlast"    local var_name = "Citation Weighted Output (non-last author)"
 27.         if "`yvar'" == "cite_affl_wt_notlast"    local gap 1
 28.         if "`yvar'" == "ln_ppr_cnt_notlast"      local var_name = "Log Publication Counts (non-last author)"
 29.         if "`yvar'" == "ln_ppr_cnt_notlast"      local gap 0.1
 30.         if "`yvar'" == "ln_cite_affl_wt_notlast" local var_name = "Log Citation Weighted Output (non-last author)"
 31.         if "`yvar'" == "ln_cite_affl_wt_notlast" local gap 0.1
 32.         if "`yvar'" == "ppr_cnt_notlast"      & "`samp'" == "top_jrnls" local gap 2
 33.         if "`yvar'" == "cite_affl_wt_notlast" & "`samp'" == "top_jrnls" local gap 2
 34.         // Coauthor / grant labels (variable is avg_num_coathrs, not avg_coathrs)
.         if "`yvar'" == "avg_num_coathrs" local var_name = "Average Team Size"
 35.         if "`yvar'" == "avg_num_coathrs" local gap 0.5
 36.         if "`yvar'" == "num_grants"        local var_name = "Number of Grants"
 37.         if "`yvar'" == "num_grants"        local gap 0.5
 38.         if "`yvar'" == "grants_per_paper"  local var_name = "Grants per Paper"
 39.         if "`yvar'" == "grants_per_paper"  local gap 0.5
 40.         if "`yvar'" == "grant_density"     local var_name = "Grant Density"
 41.         if "`yvar'" == "grant_density"     local gap 0.5
 42.         // Position labels
.         if "`yvar'" == "n_first_ppr"           local var_name = "# First-Author Papers"
 43.         if "`yvar'" == "n_first_ppr"           local gap 0.5
 44.         if "`yvar'" == "n_middle_ppr"          local var_name = "# Middle-Author Papers"
 45.         if "`yvar'" == "n_middle_ppr"          local gap 0.5
 46.         if "`yvar'" == "n_last_ppr"            local var_name = "# Last-Author Papers"
 47.         if "`yvar'" == "n_last_ppr"            local gap 0.5
 48.         if "`yvar'" == "avg_position"          local var_name = "Avg Author Position (1=first, N=last)"
 49.         if "`yvar'" == "avg_position"          local gap 0.5
 50.         if "`yvar'" == "avg_position_rat"      local var_name = "Avg Author Position / Team Size (0-1)"
 51.         if "`yvar'" == "avg_position_rat"      local gap 0.05
 52.         if "`yvar'" == "avg_team_size_last"    local var_name = "Team Size (papers where PI is last)"
 53.         if "`yvar'" == "avg_team_size_last"    local gap 0.5
 54.         if "`yvar'" == "avg_team_size_notlast" local var_name = "Team Size (papers where PI is not last)"
 55.         if "`yvar'" == "avg_team_size_notlast" local gap 0.5
 56.         cap confirm file ../temp/es_`yvar'_r1_r2_public_young.dta
 57.         if _rc {
 58.             di as text "combine_es_graphs: es_`yvar'_r1_r2_public_young.dta missing; skipping."
 59.             continue
 60.         }
 61.         cap confirm file ../temp/es_`yvar'_r1_r2_public_old.dta
 62.         if _rc {
 63.             di as text "combine_es_graphs: es_`yvar'_r1_r2_public_old.dta missing; skipping."
 64.             continue
 65.         }
 66.         use "../temp/es_`yvar'_r1_r2_public_young", clear
 67.         gen group = "young"                                                                             
 68.         replace rel = rel - 0.1                                                                         
 69.         sum b if group == "young" & rel > 0                                                             
 70.         local young_mean : dis %4.3f r(mean)                                                            
 71.         append using ../temp/es_`yvar'_r1_r2_public_old
 72.         replace group = "old" if mi(group)                                                            
 73. 
.         sum b if group == "old" & rel > 0
 74.         local old_mean : dis %4.3f r(mean)
 75.         cap drop year
 76.         gen year = rel + 2014
 77.         tw rcap ub lb year if year != 2012.9 & group == "young",  lcolor(lavender%60) msize(small) || ///
>            scatter b year if group == "young", mcolor(lavender%60) msize(small) || ///
>            rcap ub lb year if year != 2013   & group == "old",  lcolor(dkorange) msize(small) || ///
>            scatter b year if group == "old", mcolor(dkorange) msymbol(smdiamond) msize(small)  ///
>            xlab(2010(1)2019) ylab(#8) ///
>               yline(0, lcolor(black) lpattern(solid)) ///
>               legend(on order(2 "Below Median Age (Post Period Avg: `young_mean')" 4 "Above Median Age (Post Period Avg: `old_mean')" ) pos(7) ring(1) size(small) region(fcolor(none))) xtitle("Year") ytitle("`var_name'") plotregion(margin(sides))
 78.         graph export ../output/figures/`samp'/es_`yvar'_age_split.pdf, replace
 79.     }
 80. end

. 
. program robustness
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
 15.     cap mkdir "../output/figures/`samp'/robustness"
 16.     cap mkdir "../output/tables"
 17.     cap mkdir "../output/tables/`samp'"
 18.     cap mkdir "../output/tables/`samp'/robustness"
 19. 
.     // Main (pooled, no-heterogeneity) event study stress tests:
.     //     base / + age x year controls / drop late-exit PIs
.     // Applied to the same set of headline outcomes we would report in the paper.
.     foreach yvar in ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any ///
>                     ppr_cnt_notlast cite_affl_wt_notlast {
 20.         if "`yvar'" == "ppr_cnt"              local var_name "Publication Count"
 21.         if "`yvar'" == "cite_affl_wt"         local var_name "Citation Weighted Output"
 22.         if "`yvar'" == "ppr_cnt_any"          local var_name "Publication Count (any position)"
 23.         if "`yvar'" == "cite_affl_wt_any"     local var_name "Citation Weighted Output (any position)"
 24.         if "`yvar'" == "ppr_cnt_notlast"      local var_name "Publication Count (non-last author)"
 25.         if "`yvar'" == "cite_affl_wt_notlast" local var_name "Citation Weighted Output (non-last author)"
 26.         if regexm("`yvar'", "^ppr_cnt")      local gap 0.5
 27.         if regexm("`yvar'", "^cite_affl_wt") local gap 1
 28.         if regexm("`yvar'", "^ppr_cnt")      & "`samp'" == "top_jrnls" local gap 2
 29.         if regexm("`yvar'", "^cite_affl_wt") & "`samp'" == "top_jrnls" local gap 2
 30. 
.         foreach spec in base ageCtrl noattrit {
 31.             if "`spec'" == "base"     local title "Base (replicates main)"
 32.             if "`spec'" == "ageCtrl"  local title "Age x year controls"
 33.             if "`spec'" == "noattrit" local title "PIs with last real pub year >= 2018"
 34. 
.             use ../temp/es_`samp'`suf', clear
 35.             cap drop rel int_lead* int_lag*
 36.             gen rel = year - 2014
 37.             qui sum rel
 38.             local abs_lag  = abs(r(max))
 39.             local abs_lead = abs(r(min))
 40.             forval i = 1/`abs_lead' {
 41.                 gen int_lead`i' = exposure if rel == -`i'
 42.             }
 43.             forval i = 1/`abs_lag' {
 44.                 gen int_lag`i'  = exposure if rel == `i'
 45.             }
 46.             gen int_lag0 = exposure if rel == 0
 47.             ds int_lead* int_lag*
 48.             foreach var in `r(varlist)' {
 49.                 replace `var' = 0 if mi(`var')
 50.             }
 51.             if "`spec'" == "noattrit" {
 52.                 bys athr_id: egen latest_pub = max(cond(ppr_cnt > 0, year, .))
 53.                 keep if latest_pub >= 2018
 54.                 drop latest_pub
 55.             }
 56.             qui sum rel
 57.             local abs_lag  = abs(r(max))
 58.             local abs_lead = abs(r(min))
 59.             local int_leads
 60.             local int_lags
 61.             forval i = 2/`abs_lead' {
 62.                 local int_leads int_lead`i' `int_leads'
 63.             }
 64.             forval i = 0/`abs_lag' {
 65.                 local int_lags `int_lags' int_lag`i'
 66.             }
 67.             local addctrl
 68.             if "`spec'" == "ageCtrl" local addctrl c.age_2014#i.year
 69. 
.             cap noi reghdfe `yvar' `int_leads' `int_lags' int_lead1 `addctrl', ///
>                     absorb(`fes') vce(cluster `vce_cl')
 70.             if _rc {
 71.                 di as error "robustness `samp'`suf' `yvar' `spec' failed (rc=`_rc'); skipping."
 72.                 continue
 73.             }
 74.             local ref_b = _b[int_lead1]
 75.             di as text "robustness `yvar' `spec': ref _b[int_lead1] = `ref_b'"
 76.             gunique athr_id
 77.             local n_pi = r(unique)
 78. 
.             preserve
 79.             cap mat drop es
 80.             foreach var in `int_leads' `int_lags' int_lead1 {
 81.                 mat row = _b[`var'] - `ref_b', _se[`var']
 82.                 if "`var'" == "int_lead1" mat row = 0,0
 83.                 mat es = nullmat(es) \ row
 84.             }
 85.             svmat es
 86.             keep es1 es2
 87.             drop if mi(es1)
 88.             rename (es1 es2) (b se)
 89.             gen ub = b + 1.96*se
 90.             gen lb = b - 1.96*se
 91.             gen rel = -4 if _n == 1
 92.             replace rel = rel[_n-1]+1 if _n > 1
 93.             replace rel = rel + 1 if rel >= -1
 94.             replace rel = -1 if rel == `abs_lag' + 1
 95.             gen year = rel + 2014
 96.             hashsort rel
 97.             // persist coefs to .dta so a downstream plot crash doesn't lose results
.             save ../temp/robust_es_main_`yvar'_`spec'_`samp'`suf', replace
 98.             sum ub, d
 99.             local ymax = round(r(max),`gap')
100.             sum lb, d
101.             local ymin = round(r(min),`gap')
102.             if inlist("`yvar'", "ln_ppr_cnt", "ln_cite_affl_wt") local ymin = -1
103.             cap graph drop _all
104.             cap noi tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>               scatter b year, mcolor(ebblue) ///
>               , xlab(2010(1)2019) xtitle("Year") ytitle("`var_name'") ///
>                 ylab(`ymin'(`gap')`ymax') yline(0, lcolor(gs10) lpattern(solid)) ///
>                 title("Main ES: `title' (N PIs = `n_pi')", size(small)) ///
>                 legend(off) plotregion(margin(sides))
105.             cap noi graph export ../output/figures/`samp'/robustness/es_`yvar'_main_`spec'`suf'.pdf, replace
106.             restore
107.         }
108.     }
109. 
. end

. 
. program output_tables
  1.     // dumps the base vs. + market-share DiD matrices built by long_diff,
.     // first_diff, and pooled_did. Each matrix has rows = coefs/SEs + N/R2
.     // (+ pre_mean for pooled) and cols = base / with_share.
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local wsuf ""
  3.     if "$WEIGHT_MSIM" == "1" local wsuf "_msimwt"
  4.     local suf ""
  5.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
  6.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
  7.     cap mkdir ../output/tables
  8.     cap mkdir ../output/tables/`samp'
  9.     local position_outcomes ""
 10.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
 11.         local position_outcomes n_first_ppr n_middle_ppr n_last_ppr ///
>             avg_position avg_position_rat avg_team_size_last avg_team_size_notlast
 12.     }
 13.     local outcomes cite_affl_wt ppr_cnt ln_cite_affl_wt ln_ppr_cnt ///
>                    cite_affl_wt_any ppr_cnt_any ln_cite_affl_wt_any ln_ppr_cnt_any ///
>                    cite_affl_wt_notlast ppr_cnt_notlast ln_cite_affl_wt_notlast ln_ppr_cnt_notlast ///
>                    avg_num_coathrs num_grants grants_per_paper grant_density ///
>                    `position_outcomes'
 14.     // main() clears matrices between weighting modes, so matrices that don't
.     // exist in the current run are silently skipped via cap confirm.
.     foreach prog in pdid ppml_pdid placebo2011 placebo2012 trim1 trim5 trim10 trim25 {
 15.         foreach yvar of local outcomes {
 16.             cap confirm matrix `prog'_`yvar'
 17.             if !_rc {
 18.                 qui matrix_to_txt, saving("../output/tables/`samp'/`prog'_`yvar'`suf'`wsuf'.txt") ///
>                     matrix(`prog'_`yvar') title(<tab:`prog'_`yvar'`suf'`wsuf'>) format(%20.4f) replace
 19.             }
 20.         }
 21.     }
 22. 
.     // PPML heterogeneity results collected in ../temp/phet_results_<samp><suf><wsuf>.dta
.     // by event_study (long-format: one row per yvar × grp × spec). Dump as a single
.     // long-format tab-separated file for easy inspection.
.     cap confirm file "../temp/phet_results_`samp'`suf'`wsuf'.dta"
 23.     if !_rc {
 24.         preserve
 25.         use "../temp/phet_results_`samp'`suf'`wsuf'.dta", clear
 26.         export delimited using "../output/tables/`samp'/phet_results`suf'`wsuf'.txt", replace delim(tab)
 27.         restore
 28.     }
 29.     ppml_het_coefplot, samp(`samp') r1r2(`r1r2') public(`public')
 30. end

. 
. program ppml_het_coefplot
  1.     // Coefficient plot of PPML heterogeneity results (mshrctrl spec) across
.     // all PPML-eligible outcomes and all 14 heterogeneity groups (both sides
.     // of each of the 7 pairs). One PDF per outcome; groups on the y-axis,
.     // LEVEL β_post (semi-elasticity of exposure×post for that subgroup) with
.     // 95% CIs on the x-axis. Same estimand as ppml_pdid_het_binscatter — the
.     // low-side counterpart is shown alongside so readers can compare levels.
.     // Reads results from ../temp/phet_results_<samp>...dta populated by event_study.
.     syntax, samp(string) [, r1r2(int 0) public(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1) local suf "_r1_r2_public"
  5.     local wsuf ""
  6.     if "$WEIGHT_MSIM" == "1" local wsuf "_msimwt"
  7. 
.     cap confirm file "../temp/phet_results_`samp'`suf'`wsuf'.dta"
  8.     if _rc {
  9.         di as error "ppml_het_coefplot: ../temp/phet_results_`samp'`suf'`wsuf'.dta not found — skipping"
 10.         exit 0
 11.     }
 12. 
.     local ppml_het_yvars ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any ///
>                         ppr_cnt_notlast cite_affl_wt_notlast ///
>                         avg_num_coathrs num_grants grants_per_paper grant_density ///
>                         n_first_ppr n_middle_ppr n_last_ppr
 13.     // Under the split-form PPML spec, β for each side of a pair is the LEVEL
.     // effect for that subgroup — both sides are informative. Order: pairs
.     // together, "focal" (dummy=1) side first within each pair, so paired
.     // rows are visually adjacent.
.     local groups young old high_pre_ppr low_pre_ppr high_grants low_grants ///
>                  big_team small_team
 14.     local n_groups : word count `groups'
 15. 
.     // Panel titles
.     local ttl_ppr_cnt              "All papers"
 16.     local ttl_cite_affl_wt         "Citations"
 17.     local ttl_ppr_cnt_any          "Papers (any pos.)"
 18.     local ttl_cite_affl_wt_any     "Citations (any pos.)"
 19.     local ttl_ppr_cnt_notlast      "Papers (non-last)"
 20.     local ttl_cite_affl_wt_notlast "Citations (non-last)"
 21.     local ttl_avg_num_coathrs      "Avg. coauthors"
 22.     local ttl_num_grants           "Num. grants"
 23.     local ttl_grants_per_paper     "Grants / paper"
 24.     local ttl_grant_density        "Grant density"
 25.     local ttl_n_first_ppr          "First-author papers"
 26.     local ttl_n_middle_ppr         "Middle-author papers"
 27.     local ttl_n_last_ppr           "Last-author papers"
 28. 
.     // Human-readable y-axis labels (keyed on group name). Both sides of
.     // each pair need a label since both are plotted under the level spec.
.     local lbl_young        "Young"
 29.     local lbl_old          "Old"
 30.     local lbl_r1           "R1"
 31.     local lbl_r2           "R2"
 32.     local lbl_high_pre_ppr "More Productive at Baseline"
 33.     local lbl_low_pre_ppr  "Less Productive at Baseline"
 34.     local lbl_high_grants  "More Grants per Paper at Baseline"
 35.     local lbl_low_grants   "Fewer Grants per Paper at Baseline"
 36.     local lbl_big_team     "Larger Team Size"
 37.     local lbl_small_team   "Smaller Team Size"
 38.     local lbl_many_coauth  "More Coauthors"
 39.     local lbl_few_coauth   "Fewer Coauthors"
 40.     local lbl_big_msa      "Larger MSA"
 41.     local lbl_small_msa    "Smaller MSA"
 42. 
.     foreach yvar of local ppml_het_yvars {
 43.         preserve
 44.         use "../temp/phet_results_`samp'`suf'`wsuf'.dta", clear
 45.         keep if yvar == "`yvar'" & spec == "mshrctrl"
 46.         if _N == 0 {
 47.             di as error "ppml_het_coefplot: no rows for `yvar' mshrctrl — skipping"
 48.             restore
 49.             continue
 50.         }
 51. 
.         // Attach y position by group ordering, and build ylabels list.
.         gen y = .
 52.         local ylabs ""
 53.         local i = 0
 54.         foreach g of local groups {
 55.             local ++i
 56.             local ypos = `n_groups' + 1 - `i'
 57.             qui replace y = `ypos' if grp == "`g'"
 58.             local ylabs `ylabs' `ypos' "`lbl_`g''"
 59.         }
 60.         drop if mi(y) | mi(post_b)
 61.         if _N == 0 {
 62.             di as error "ppml_het_coefplot: `yvar' had rows but no non-missing post_b — skipping"
 63.             restore
 64.             continue
 65.         }
 66.         gen ub = post_b + 1.96*post_se
 67.         gen lb = post_b - 1.96*post_se
 68. 
.         tw rcap ub lb y, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>            scatter y post_b, mcolor(ebblue) msize(small) ///
>            , xline(0, lcolor(gs10) lpattern(solid)) ///
>              ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>              ytitle("") xtitle("Exposure x Post", size(small)) ///
>              xlabel(, labsize(small)) ///
>              legend(off) ///
>              plotregion(margin(sides))
 69.         graph export "../output/figures/`samp'/ppml_het_coefplot_`yvar'`suf'`wsuf'.pdf", replace
 70.         di as text "wrote ../output/figures/`samp'/ppml_het_coefplot_`yvar'`suf'`wsuf'.pdf"
 71.         restore
 72.     }
 73. end

. 
. **
. main
(encoding automatically selected: ISO-8859-2)
(3 vars, 1,500,300 obs)
