. program gather_external_data
  1.     import delimited ../external/exposure/final_imputed_shift_share_${EXPOSURE_VERSION}${EXPOSURE_FILTER}, clear
  2.     rename exposure_ss imputed
  3.     rename sum_imputed_shares imputed_mkt_spend_shr
  4.     save ../temp/exposure, replace
  5. 
.     use ../external/grants/pi_grants_clean, clear
  6.     bys athr_id year: gen num_grants = _N
  7.     contract athr_id year num_grants
  8.     drop _freq
  9.     save ../temp/athr_yr_grnt_cnt, replace
 10. 
.     use ../external/foias/merged_foias_with_pis,  clear
 11.     drop if mi(athr_id)
 12.     gen year = year(date(date, "YMD"))
 13.     merge m:1 category using ../external/categories/categories_tfidf, assert(1 2 3) keep(1 3)
 14.     gen nonlab = 1 if _merge == 1
 15.     replace nonlab = 0 if mi(nonlab)
 16.     drop if nonlab == 0
 17.     gcollapse (sum) spend, by(athr_id uni year)
 18.     save ../temp/foia_spend, replace
 19. 
.     // author -> us_cluster_fields 30-cluster assignment (used when FE_MODE = "inst_cluster" or "inst_cluster_fldyr")
.     cap confirm file ../temp/athr_cluster30.dta
 20.     if _rc {
 21.         import delimited ../external/cluster/author_static_clusters_30.csv, clear varnames(1)
 22.         cap tostring athr_id, replace
 23.         rename cluster_label cluster_30
 24.         save ../temp/athr_cluster30, replace
 25.     }
 26. 
.     // Universe PI match-quality diagnostics (max_sim = best cosine similarity
.     // between the universe PI and any FOIA PI). Keyed on athr_id; keeps
.     // athr_id + max_sim only. Real FOIA PIs are handled in restrict_samp
.     // where max_sim is forced to 1 (they anchor themselves).
.     use athr_id max_sim using ../external/exposure/match_diagnostics_restricted, clear
 27.     save ../temp/match_diag, replace
 28. 
. end

