. forval c = 1/6 {
  2.     foreach p in w n {
  3.         local r  = cond("`p'" == "w", 1, 3)
  4.         local b  = funcform[`r',`c']
  5.         local se = funcform[`r'+1,`c']
  6.         local t  = abs(`b'/`se')
  7.         local st`p'`c' = cond(`t' >= 2.576, "^{***}", cond(`t' >= 1.960, "
> ^{**}", cond(`t' >= 1.645, "^{*}", "")))
  8.         local b`p'`c'  = trim(string(`b', "%6.3f"))
  9.         local se`p'`c' = trim(string(`se', "%6.3f"))
 10.     }
 11.     local dc`c' = trim(string(funcform[5,`c'], "%4.1f"))
 12.     local nn`c' = subinstr(trim(string(funcform[7,`c'], "%12.0fc")), ",", 
> "{,}", .)
 13. }

. 
