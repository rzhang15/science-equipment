. local proj_b  = _b[exposure]

. local proj_s  = _b[mkt_spend_shr]

. local proj_r2 = e(r2)

. 
. mat plb = J(13, 2, .)

. local c = 0

. foreach x in exposure exposure_pl {
  2.     local ++c
  3.     gen Z_it = `x' * post
  4.     ppmlhdfe ppr_cnt Z_it Zs_it, absorb(athr_id year) vce(cluster athr_id)
>  d
  5.     local b = _b[Z_it]
  6.     mat plb[1, `c']  = `b'
  7.     mat plb[2, `c']  = _se[Z_it]
  8.     mat plb[3, `c']  = _b[Zs_it]
  9.     mat plb[4, `c']  = _se[Zs_it]
 10.     mat plb[10, `c'] = e(N)
 11.     qui sum `x' if e(sample)
 12.     mat plb[5, `c'] = r(mean)
 13.     mat plb[6, `c'] = 100 * (1 - exp(`b' * r(mean)))
 14.     predict double mu, mu
 15.     gen double mu_cf = mu * exp(-`b' * Z_it) if e(sample) & post
 16.     gen double loss  = mu_cf - mu
 17.     qui sum loss
 18.     local tot_loss = r(sum)
 19.     mat plb[7, `c'] = `tot_loss'
 20.     qui sum mu_cf
 21.     mat plb[8, `c'] = 100 * `tot_loss' / r(sum)
 22.     qui sum ppr_cnt if year < 2014 & e(sample)
 23.     mat plb[9, `c'] = r(mean)
 24.     drop Z_it mu mu_cf loss
 25. }
