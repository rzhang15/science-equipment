      4. Maximum number of variables is set to 120,000; see help set_maxvar.

. do robustness_summary.do 

. set more off

. clear all

. capture log close

. set scheme modern

. version 17

. 
. local samp      all_jrnls

. local suf       _r1_r2

. local hisim_pct 50

. 
. local specs base noshare clyr hisim precision positive ols olsln

. local rows  h_top base ///
>             h_ident noshare clyr ///
>             h_expo  hisim precision positive ///
>             h_form  ols olsln

. 
. local lab_h_top     ""

. local lab_base      "{bf:Baseline}"

. local lab_h_ident   "{bf:Identification}"

. local lab_noshare   "No treated-share control"

. local lab_clyr      "Research cluster × year FEs"

. local lab_h_expo    "{bf:Exposure measurement}"

. local lab_hisim     "High-similarity imputations only"

. local lab_precision "Weighted by imputation precision"

. local lab_positive  "Positive exposure only"

. local lab_h_form    "{bf:Functional form}"

. local lab_ols       "OLS, levels"

. local lab_olsln     "OLS, log(1 + y)"

. 
. program prep_panel
  1.     syntax, hisim(integer)
  2.     gen post = year >= 2014
  3.     gen Z_it  = exposure      * post
  4.     gen Zs_it = mkt_spend_shr * post
  5.     gen ln_ppr_cnt = ln(1 + ppr_cnt)
  6.     bys athr_id: gen byte _one = _n == 1
  7.     qui _pctile max_sim if _one == 1 & foia_athr != 1, p(`=100 - `hisim'')
  8.     gen byte hisim = max_sim >= r(r1)
  9.     drop _one
 10. end

. 
. local n : word count `specs'

. mat rs = J(`n', 8, .)

. local i = 0

. foreach s of local specs {
  2.     local ++i
  3.     local file es_`samp'`suf'
  4.     local cmd  ppmlhdfe
  5.     local yvar ppr_cnt
  6.     local xvar Z_it
  7.     local ctrl Zs_it
  8.     local cond 1
  9.     local wt   ""
 10.     local fes  athr_id year
 11.     local vce  athr_id
 12.     local form ppml
 13.     if "`s'" == "noshare"   local ctrl ""
 14.     if "`s'" == "clyr"      local fes athr_id i.cluster_30#i.year
 15.     if "`s'" == "hisim"     local cond hisim == 1
 16.     if "`s'" == "precision" local wt [pw=max_sim]
 17.     if "`s'" == "positive"  local cond exposure > 0
 18.     if "`s'" == "ols" {
 19.         local cmd  reghdfe
 20.         local form ols
 21.     }
 22.     if "`s'" == "olsln" {
 23.         local cmd  reghdfe
 24.         local yvar ln_ppr_cnt
 25.         local form olsln
 26.     }
 27. 
.     use ../output/prepped_samples/`file', clear
 28.     prep_panel, hisim(`hisim_pct')
 29.     di as text _newline "robustness_summary `s': `cmd' `yvar' `xvar' `ctrl
> ' if `cond' `wt', absorb(`fes')"
 30.     `cmd' `yvar' `xvar' `ctrl' if `cond' `wt', absorb(`fes') vce(cluster `
> vce')
 31.     local b  = _b[`xvar']
 32.     local se = _se[`xvar']
 33.     local meanwt = cond("`wt'" != "", "[aw=max_sim]", "")
 34.     qui sum exposure `meanwt' if e(sample)
 35.     local xbar = r(mean)
 36.     qui sum ppr_cnt if year < 2014 & e(sample)
 37.     local ymn = r(mean)
 38.     if "`form'" == "ppml" {
 39.         local scale 1
 40.         local decl = 100 * (1 - exp(`b'*`xbar'))
 41.     }
 42.     if "`form'" == "ols" {
 43.         local scale = 1/`ymn'
 44.         local decl = -100 * `b' * `xbar' / `ymn'
 45.     }
 46.     if "`form'" == "olsln" {
 47.         local scale = (1 + `ymn')/`ymn'
 48.         local decl = 100 * (1 - exp(`b'*`xbar')) * (1 + `ymn') / `ymn'
 49.     }
 50.     mat rs[`i',1] = `b'
 51.     mat rs[`i',2] = `se'
 52.     mat rs[`i',3] = `b'*`scale'
 53.     mat rs[`i',4] = `se'*`scale'
 54.     mat rs[`i',5] = `decl'
 55.     mat rs[`i',6] = `xbar'
 56.     mat rs[`i',7] = `ymn'
 57.     mat rs[`i',8] = e(N)
 58. }

