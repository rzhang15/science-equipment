. global SAMPSUF "_r1_r2"

. 
. program main
  1.     cap mkdir ../output/tables
  2.     cap mkdir ../output/figures/all_jrnls
  3.     build_measures
  4.     grant_level_checks
  5.     athr_year_trends
  6.     es_compare
  7. end

. 
. * ---------------------------------------------------------------------------
. * Application type is the leading digit of full_project_num:
. *   1 new, 2 competing renewal, 3 ADMINISTRATIVE SUPPLEMENT,
. *   5 non-competing continuation, 7 change of institution, 9 change of activity.
. * classify_grants never inspects it, so supplements are currently invisible to
. * the pipeline. Everything below reconstructs what they are doing.
. * ---------------------------------------------------------------------------
. program build_measures
  1.     use athr_id year grant_key row_key full_project_num subproject_id ///
>         core_project_num research total_cost project_start ///
>         using ../external/nih_grants/nih_grants_by_athr_id, clear
  2.     drop if mi(year)
  3.     gen byte appl_type  = real(substr(strtrim(full_project_num), 1, 1))
  4.     gen byte supplement = appl_type == 3
  5.     gen int start_year  = year(project_start)
  6.     duplicates drop athr_id year row_key, force
  7.     compress
  8.     save ../temp/diag_supp_long, replace
  9. end

. 
. * ---------------------------------------------------------------------------
. * Does the supplement share trend, and can a supplement inflate n_grants?
. *
. * n_grants tags one row per (athr_id, year, grant_key), and grant_key is
. * core_project_num + subproject_id. A supplement shares its parent's
. * core_project_num, so it SHOULD collapse into the parent and add nothing to
. * the count. Two ways that fails, both checked here:
. *   (a) the supplement is the only row for that grant_key in that FY -- the
. *       parent has no record that year, so the supplement single-handedly
. *       makes the award look active;
. *   (b) subproject_id differs between parent and supplement rows, splitting one
. *       award into two grant_keys and double-counting it.
. * ---------------------------------------------------------------------------
. program grant_level_checks
  1.     use ../temp/diag_supp_long, clear
  2.     keep if research
  3. 
.     di as text _n "===== application type mix among research rows, by FY ====="
  4.     table year appl_type, nformat(%9.0fc)
  5.     di as text _n "===== supplement share of research rows, by FY ====="
  6.     table year, stat(mean supplement) stat(freq) nformat(%9.4f)
  7. 
.     * (a) grant-years carried entirely by supplement rows
.     bys athr_id year grant_key: egen byte all_supp = min(supplement)
  8.     bys athr_id year grant_key: gen byte gk_tag = _n == 1
  9.     di as text _n "===== share of counted grant-years with NO parent row ====="
 10.     table year if gk_tag == 1, stat(mean all_supp) stat(freq) nformat(%9.4f)
 11. 
.     * Is a parent-less supplement-year extending an award past its last real
.     * year? Flag grant_keys present as non-supplement in t-1 but only as a
.     * supplement in t.
.     preserve
 12.         keep if gk_tag == 1
 13.         keep athr_id year grant_key all_supp
 14.         gen byte real_yr = all_supp == 0
 15.         xtset, clear
 16.         bys athr_id grant_key (year): gen byte prev_real = real_yr[_n-1] == 1 & year == year[_n-1] + 1
 17.         gen byte tail_ext = all_supp == 1 & prev_real == 1
 18.         di as text _n "===== supplement-only years that extend a live award ====="
 19.         table year, stat(mean tail_ext) stat(sum tail_ext) nformat(%9.4f)
 20.     restore
 21. 
.     * (b) one core project split across grant_keys by subproject_id
.     bys athr_id year core_project_num grant_key: gen byte kt = _n == 1
 22.     bys athr_id year core_project_num: egen n_keys = total(kt)
 23.     bys athr_id year core_project_num: egen byte any_supp = max(supplement)
 24.     di as text _n "===== core-project-years split into >1 grant_key ====="
 25.     table year if kt == 1, stat(mean n_keys) nformat(%9.4f)
 26.     di as text _n "  ... of which involve a supplement row:"
 27.     table year if kt == 1 & n_keys > 1, stat(mean any_supp) stat(freq) nformat(%9.4f)
 28. 
.     * n_new_grants is read off whichever row wins the tag within grant_key-year.
.     * If project_start varies across those rows, the flag is arbitrary and a
.     * supplement can be miscoded as a brand-new award.
.     bys athr_id year grant_key: egen sy_min = min(start_year)
 29.     bys athr_id year grant_key: egen sy_max = max(start_year)
 30.     gen byte sy_amb = sy_min != sy_max & !mi(sy_min) & !mi(sy_max)
 31.     di as text _n "===== grant-years where project_start is ambiguous across rows ====="
 32.     table year if gk_tag == 1, stat(mean sy_amb) stat(freq) nformat(%9.4f)
 33.     di as text _n "===== do supplement rows carry their own start date? ====="
 34.     table supplement, stat(mean sy_amb) stat(freq) nformat(%9.4f)
 35. end

. 
. * ---------------------------------------------------------------------------
. * Author-year measures with and without supplement rows.
. * ---------------------------------------------------------------------------
. program athr_year_trends
  1.     use ../temp/diag_supp_long, clear
  2. 
.     egen byte tag_all = tag(athr_id year grant_key) if research
  3.     egen byte tag_ns  = tag(athr_id year grant_key) if research & !supplement
  4.     gen byte g_all  = tag_all == 1
  5.     gen byte g_ns   = tag_ns  == 1
  6.     gen byte new_all = g_all & start_year == year
  7.     gen byte new_ns  = g_ns  & start_year == year
  8.     gen double c_all = total_cost if research
  9.     gen double c_ns  = total_cost if research & !supplement
 10.     gen byte supp_row = research & supplement
 11. 
.     gcollapse (sum) n_grants_all = g_all  (sum) n_grants_ns = g_ns ///
>               (sum) n_new_all    = new_all (sum) n_new_ns   = new_ns ///
>               (sum) cost_all     = c_all  (sum) cost_ns     = c_ns ///
>               (sum) n_supp_rows  = supp_row, by(athr_id year) fast
 12.     save ../temp/diag_supp_athr_yr, replace
 13. 
.     use ../output/prepped_samples/es_all_jrnls${SAMPSUF}, clear
 14.     merge 1:1 athr_id year using ../temp/diag_supp_athr_yr, keep(1 3) gen(_msupp)
 15.     gen byte reporter_matched = 0
 16.     bys athr_id: egen _any = max(_msupp == 3)
 17.     replace reporter_matched = 1 if _any == 1
 18.     drop _any _msupp
 19.     keep if reporter_matched == 1
 20.     foreach v in n_grants_all n_grants_ns n_new_all n_new_ns cost_all cost_ns n_supp_rows {
 21.         replace `v' = 0 if mi(`v')
 22.     }
 23.     gen double supp_effect = n_grants_all - n_grants_ns
 24. 
.     bys athr_id (year): gen byte pi_tag = _n == 1
 25.     xtile _q = exposure if pi_tag == 1, nq(4)
 26.     bys athr_id: egen exp_q4 = max(_q)
 27.     drop _q
 28.     compress
 29.     save ../temp/diag_supp_samp, replace
 30. 
.     di as text _n "===== analysis-sample PIs: with vs without supplements ====="
 31.     table year, stat(mean n_grants_all) stat(mean n_grants_ns) ///
>                 stat(mean supp_effect) stat(mean n_supp_rows) nformat(%9.4f)
 32.     di as text _n "===== supplement contribution by exposure quartile ====="
 33.     table year exp_q4 if inlist(exp_q4, 1, 4), ///
>         stat(mean supp_effect) stat(mean n_supp_rows) nformat(%9.4f)
 34. 
.     preserve
 35.         gcollapse (mean) n_grants_all n_grants_ns n_new_all n_new_ns ///
>                          cost_all cost_ns n_supp_rows, by(year exp_q4) fast
 36.         sort exp_q4 year
 37.         export delimited using ../output/tables/diag_supp_trends.csv, replace
 38.         foreach y in n_grants_all n_grants_ns n_new_all n_new_ns n_supp_rows {
 39.             if "`y'" == "n_grants_all" local yt "# active grants (supplements in)"
 40.             if "`y'" == "n_grants_ns"  local yt "# active grants (supplements out)"
 41.             if "`y'" == "n_new_all"    local yt "# new grants (supplements in)"
 42.             if "`y'" == "n_new_ns"     local yt "# new grants (supplements out)"
 43.             if "`y'" == "n_supp_rows"  local yt "# supplement rows per PI-year"
 44.             tw (line `y' year if exp_q4 == 1, lcolor(ebblue) lwidth(medthick)) ///
>                (line `y' year if exp_q4 == 4, lcolor(dkorange) lwidth(medthick)), ///
>                xlab(2010(1)2019) xtitle("Year") ytitle("`yt'") ///
>                xline(2014, lpattern(dash) lcolor(gs10)) ///
>                legend(order(1 "Q1 exposure" 2 "Q4 exposure") pos(6) ring(1) rows(1)) ///
>                plotregion(margin(sides))
 45.             graph export ../output/figures/all_jrnls/diag_supp_`y'.pdf, replace
 46.         }
 47.     restore
 48. end

. 
. program es_compare
  1.     use ../temp/diag_supp_samp, clear
  2.     bys athr_id: egen ever_g = max(n_grants_all)
  3.     keep if ever_g > 0 & !mi(ever_g)
  4. 
.     gen rel = year - 2014
  5.     forval i = 1/4 {
  6.         gen int_lead`i'  = exposure      if rel == -`i'
  7.         gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
  8.     }
  9.     forval i = 0/5 {
 10.         gen int_lag`i'  = exposure      if rel == `i'
 11.         gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 12.     }
 13.     ds int_lead* int_lag* mshr_lead* mshr_lag*
 14.     foreach v in `r(varlist)' {
 15.         replace `v' = 0 if mi(`v')
 16.     }
 17.     save ../temp/diag_supp_es, replace
 18. 
.     foreach y in n_grants_all n_grants_ns n_new_all n_new_ns cost_all cost_ns {
 19.         run_one, y(`y')
 20.     }
 21. end

. 
. program run_one
  1.     syntax, y(string)
  2.     use ../temp/diag_supp_es, clear
  3.     local rhs int_lead4 int_lead3 int_lead2 int_lag0 int_lag1 int_lag2 int_lag3 int_lag4 int_lag5
  4.     local ctl mshr_lead4 mshr_lead3 mshr_lead2 mshr_lag0 mshr_lag1 mshr_lag2 mshr_lag3 mshr_lag4 mshr_lag5
  5. 
.     di as text _n "===== ES `y' ====="
  6.     cap noi reghdfe `y' `rhs' `ctl', absorb(athr_id year) vce(cluster athr_id)
  7.     if _rc {
  8.         di as error "  reghdfe failed rc=" _rc
  9.         exit
 10.     }
 11.     qui gunique athr_id if e(sample)
 12.     local npi = r(unique)
 13. 
.     cap mat drop es
 14.     foreach v of local rhs {
 15.         mat es = nullmat(es) \ (_b[`v'], _se[`v'])
 16.     }
 17.     preserve
 18.         clear
 19.         svmat es
 20.         rename (es1 es2) (b se)
 21.         gen year = 2009 + _n
 22.         replace year = year + 1 if _n >= 4
 23.         gen ub = b + 1.96*se
 24.         gen lb = b - 1.96*se
 25.         set obs `=_N+1'
 26.         replace year = 2013 if mi(year)
 27.         foreach v in b se ub lb {
 28.             replace `v' = 0 if year == 2013
 29.         }
 30.         sort year
 31.         gen yvar = "`y'"
 32.         export delimited using ../output/tables/diag_supp_es_`y'.csv, replace
 33.         list year b se ub lb, sep(0) noobs
 34. 
.         tw (rcap ub lb year, lcolor(ebblue%70) msize(vsmall)) ///
>            (scatter b year, mcolor(ebblue)), ///
>            xlab(2010(1)2019) xtitle("Year") ytitle("`y'") ///
>            yline(0, lcolor(gs10)) xline(2013.5, lpattern(dash) lcolor(gs10)) ///
>            legend(order(- "Num. PIs: `npi'") pos(7) ring(1) size(small)) ///
>            plotregion(margin(sides))
 35.         graph export ../output/figures/all_jrnls/diag_supp_es_`y'.pdf, replace
 36.     restore
 37. end

