. program gather_inst_chars
  1.     // Build ../temp/inst_chars_pre.dta keyed by OpenAlex inst_id, holding 30
.     // pre-period university characteristics (funding buckets + expenditures +
.     // endowment). Source: derived/inst_chars/output/combined_pre.dta (keyed on
.     // ipeds_id) merged onto the netscratch ipeds<->openalex crosswalk.
.     // Vars are renamed to short (`ic_<alias>`, <=8 char) aliases so downstream
.     // interaction names like `mshr_lead4_q4_<alias>` stay under Stata's 32-char
.     // variable-name limit.
.     import delimited "/n/netscratch/pakes_lab/Lab/sci_eq/college/ipeds_openalex.csv", ///
>         clear varn(1) stringcols(_all)
  2.     keep ipeds_id inst_id
  3.     drop if inst_id == "" | ipeds_id == ""
  4.     destring ipeds_id, replace
  5.     duplicates drop
  6.     tempfile xw
  7.     save `xw'
  8. 
.     use "/n/holylabs/pakes_lab/Lab/sci_eq/derived/inst_chars/output/combined_pre.dta", clear
  9.     merge 1:1 ipeds_id using `xw', keep(3) nogen
 10.     drop ipeds_id
 11. 
.     rename contracts_fund      ic_contr
 12.     rename fed_ls_bio_fund     ic_fdlsb
 13.     rename fed_ls_fund         ic_fdls
 14.     rename fed_ls_hs_fund      ic_fdlsh
 15.     rename grants_fund         ic_gntsf
 16.     rename hhs_ls_bio_fund     ic_hhlsb
 17.     rename hhs_ls_fund         ic_hhls
 18.     rename hhs_ls_hs_fund      ic_hhlsh
 19.     rename nonfed_ls_bio_fund  ic_nflsb
 20.     rename nonfed_ls_fund      ic_nfls
 21.     rename nonfed_ls_hs_fund   ic_nflsh
 22.     rename subrecipient_fund   ic_subrf
 23.     rename tot_bus_fund        ic_busf
 24.     rename tot_fed_fund        ic_fedf
 25.     rename tot_fund            ic_tfnd
 26.     rename tot_inst_fund       ic_instf
 27.     rename tot_nonprof_fund    ic_nonpf
 28.     rename tot_state_fund      ic_statf
 29.     rename ls_fund             ic_lsf
 30.     rename hs_fund             ic_hsf
 31.     rename bio_fund            ic_biof
 32.     rename applied_expend      ic_applx
 33.     rename applied_fed_expend  ic_apfx
 34.     rename basic_expend        ic_basx
 35.     rename basic_fed_expend    ic_bfx
 36.     rename clin_trial_expend   ic_clinx
 37.     rename dev_expend          ic_devx
 38.     rename ls_cap_expend       ic_lscx
 39.     rename med_sch_expend      ic_medx
 40.     rename endownment          ic_endow
 41. 
