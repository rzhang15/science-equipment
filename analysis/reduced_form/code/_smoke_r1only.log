. do /tmp/_smoke_r1only.do 

. set more off

. tempfile stripped

. !sed -e '/^clear all$/d' -e '/^capture log close$/d' -e '/^set scheme modern$
> /d' -e 's/^main$/di as text "STUB-END"/' /n/holylabs/pakes_lab/Lab/sci_eq/ana
> lysis/reduced_form/code/analysis.do > `stripped'


