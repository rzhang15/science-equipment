. program define_group_labels
  1.     // Sets $LBL_<groupname> for every dummy used in a heterogeneity spec.
.     // Called once at the top of main so all plot-labeling code can look up
.     // human-readable labels via ${LBL_<grp>} without repeating chains of
.     // if-`grp'=="X" checks.
.     // Existing PI-level splits (median).
.     global LBL_young        "Young"
  2.     global LBL_old          "Old"
  3.     global LBL_r1           "R1"
  4.     global LBL_r2           "R2"
  5.     global LBL_high_pre_ppr "More Productive at Baseline"
  6.     global LBL_low_pre_ppr  "Less Productive at Baseline"
  7.     global LBL_high_grants  "More Grants per Paper at Baseline"
  8.     global LBL_low_grants   "Fewer Grants per Paper at Baseline"
  9.     global LBL_big_team     "Larger Team Size"
 10.     global LBL_small_team   "Smaller Team Size"
 11.     global LBL_many_coauth  "More Coauthors"
 12.     global LBL_few_coauth   "Fewer Coauthors"
 13.     global LBL_big_msa      "Larger MSA"
 14.     global LBL_small_msa    "Smaller MSA"
 15. 
.     // PI-level continuous chars, Q1 vs Q4 (mid = Q2 U Q3, plotted as nuisance).
.     global LBL_q1_pre_ppr   "Q1 Pre-Period Productivity"
 16.     global LBL_q4_pre_ppr   "Q4 Pre-Period Productivity"
 17.     global LBL_mid_pre_ppr  "Mid Pre-Period Productivity"
 18.     global LBL_q1_grants    "Q1 Grants per Paper"
 19.     global LBL_q4_grants    "Q4 Grants per Paper"
 20.     global LBL_mid_grants   "Mid Grants per Paper"
 21.     global LBL_q1_team      "Q1 Team Size"
 22.     global LBL_q4_team      "Q4 Team Size"
 23.     global LBL_mid_team     "Mid Team Size"
 24.     global LBL_q1_coauth    "Q1 Coauthors"
 25.     global LBL_q4_coauth    "Q4 Coauthors"
 26.     global LBL_mid_coauth   "Mid Coauthors"
 27.     global LBL_q1_msa       "Q1 MSA Size"
 28.     global LBL_q4_msa       "Q4 MSA Size"
 29.     global LBL_mid_msa      "Mid MSA Size"
 30. 
.     // Inst-char labels (source: HERD funding buckets + expenditures + endowment).
.     // Keyed on the same short alias used in the dummy names.
.     local ic_lbl_contr "Total Contract Funding"
 31.     local ic_lbl_fdlsb "Federal Life-Sci Biology Funding"
 32.     local ic_lbl_fdls  "Federal Life-Sci Funding"
 33.     local ic_lbl_fdlsh "Federal Life-Sci Health-Sci Funding"
 34.     local ic_lbl_gntsf "Grants Funding"
 35.     local ic_lbl_hhlsb "HHS Life-Sci Biology Funding"
 36.     local ic_lbl_hhls  "HHS Life-Sci Funding"
 37.     local ic_lbl_hhlsh "HHS Life-Sci Health-Sci Funding"
 38.     local ic_lbl_nflsb "Non-Federal Life-Sci Biology Funding"
 39.     local ic_lbl_nfls  "Non-Federal Life-Sci Funding"
 40.     local ic_lbl_nflsh "Non-Federal Life-Sci Health-Sci Funding"
 41.     local ic_lbl_subrf "Subrecipient Funding"
 42.     local ic_lbl_busf  "Business Funding"
 43.     local ic_lbl_fedf  "Total Federal Funding"
 44.     local ic_lbl_tfnd  "Total R&D Funding"
 45.     local ic_lbl_instf "Institutional Funding"
 46.     local ic_lbl_nonpf "Non-Profit Funding"
 47.     local ic_lbl_statf "State Funding"
 48.     local ic_lbl_lsf   "Life-Sci Funding"
 49.     local ic_lbl_hsf   "Health-Sci Funding"
 50.     local ic_lbl_biof  "Biology Funding"
 51.     local ic_lbl_applx "Applied Research Expenditures"
 52.     local ic_lbl_apfx  "Federal Applied Research Expenditures"
 53.     local ic_lbl_basx  "Basic Research Expenditures"
 54.     local ic_lbl_bfx   "Federal Basic Research Expenditures"
 55.     local ic_lbl_clinx "Clinical Trial Expenditures"
 56.     local ic_lbl_devx  "Development Expenditures"
 57.     local ic_lbl_lscx  "Life-Sci Capital Expenditures"
 58.     local ic_lbl_medx  "Medical School Expenditures"
 59.     local ic_lbl_endow "Endowment"
 60.     foreach a of global IC_ALIASES {
 61.         global LBL_hi_`a'  "High `ic_lbl_`a''"
 62.         global LBL_lo_`a'  "Low `ic_lbl_`a''"
 63.         global LBL_q1_`a'  "Q1 `ic_lbl_`a''"
 64.         global LBL_q4_`a'  "Q4 `ic_lbl_`a''"
 65.         global LBL_mid_`a' "Mid `ic_lbl_`a''"
 66.     }
 67. 
.     // Pair lists (see IC_ALIASES / PI_Q_BASES globals above).
.     // Convention (matches the existing PI-level median pairs high_/low_):
.     //   pair = "focal_group  base_group"
.     //   Median:   "hi_<x>  lo_<x>"    -> base absorbs low, β_g1 = High-Low diff
.     //   Quartile: "q4_<x>  q1_<x>"    -> base absorbs Q1,  β_g1 = Q4-Q1 diff
.     // For the three-group PPML quartile fit, mid_<x> is added as a nuisance
.     // interaction alongside the pair; both q1 and q4 level β's are extracted.
.     global IC_PAIRS_MED
 68.     global IC_PAIRS_Q
 69.     foreach a of global IC_ALIASES {
 70.         global IC_PAIRS_MED `"${IC_PAIRS_MED} "hi_`a' lo_`a'" "'
 71.         global IC_PAIRS_Q   `"${IC_PAIRS_Q} "q4_`a' q1_`a'" "'
 72.     }
 73.     global PI_PAIRS_Q
 74.     foreach b of global PI_Q_BASES {
 75.         global PI_PAIRS_Q `"${PI_PAIRS_Q} "q4_`b' q1_`b'" "'
 76.     }
 77. end

