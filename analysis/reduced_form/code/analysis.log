. program robustness
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     if (`no_clin' == 1) local suf "_no_clin`suf'"
 18.     cap mkdir "../output/figures/`samp'/robustness"
 19.     cap mkdir "../output/tables"
 20.     cap mkdir "../output/tables/`samp'"
 21.     cap mkdir "../output/tables/`samp'/robustness"
 22. 
.     // Stress tests on the main mshrctrl ES: +age×year controls / drop PIs without a real pub after 2018
.     local outcomes ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any ///
>                    ppr_cnt_notlast cite_affl_wt_notlast
 23.     if "$QUICK_TOPJRNL" == "1" local outcomes ppr_cnt
 24. 
.     foreach yvar of local outcomes {
 25.         if "`yvar'" == "ppr_cnt"              local var_name "Publication Count"
 26.         if "`yvar'" == "cite_affl_wt"         local var_name "Citation Weighted Output"
 27.         if "`yvar'" == "ppr_cnt_any"          local var_name "Publication Count (any position)"
 28.         if "`yvar'" == "cite_affl_wt_any"     local var_name "Citation Weighted Output (any position)"
 29.         if "`yvar'" == "ppr_cnt_notlast"      local var_name "Publication Count (non-last author)"
 30.         if "`yvar'" == "cite_affl_wt_notlast" local var_name "Citation Weighted Output (non-last author)"
 31.         local poisson_name "`var_name'"
 32.         if "`yvar'" == "ppr_cnt"              local poisson_name "Publications"
 33.         if "`yvar'" == "cite_affl_wt"         local poisson_name "Citation-Weighted Output"
 34.         if "`yvar'" == "ppr_cnt_any"          local poisson_name "Publications (any position)"
 35.         if "`yvar'" == "cite_affl_wt_any"     local poisson_name "Citation-Weighted Output (any position)"
 36.         if "`yvar'" == "ppr_cnt_notlast"      local poisson_name "Publications (non-last author)"
 37.         if "`yvar'" == "cite_affl_wt_notlast" local poisson_name "Citation-Weighted Output (non-last author)"
 38.         local ppml_ytit "Output-Cost Elasticity"
 39.         if regexm("`yvar'", "^ppr_cnt")      local gap 0.5
 40.         if regexm("`yvar'", "^cite_affl_wt") local gap 1
 41.         if regexm("`yvar'", "^ppr_cnt")      & "`samp'" == "top_jrnls" local gap 2
 42.         if regexm("`yvar'", "^cite_affl_wt") & "`samp'" == "top_jrnls" local gap 2
 43. 
.         foreach spec in ageCtrl noattrit {
 44.             if "`spec'" == "ageCtrl"  local title "Age x year controls"
 45.             if "`spec'" == "noattrit" local title "PIs with last real pub year >= 2018"
 46. 
.             use ../output/prepped_samples/es_`samp'`suf', clear
 47.             cap drop rel int_lead* int_lag* mshr_lead* mshr_lag*
 48.             gen rel = year - 2014
 49.             qui sum rel
 50.             local abs_lag  = abs(r(max))
 51.             local abs_lead = abs(r(min))
 52.             forval i = 1/`abs_lead' {
 53.                 gen int_lead`i'  = exposure      if rel == -`i'
 54.                 gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 55.             }
 56.             forval i = 1/`abs_lag' {
 57.                 gen int_lag`i'  = exposure      if rel == `i'
 58.                 gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 59.             }
 60.             gen int_lag0  = exposure      if rel == 0
 61.             gen mshr_lag0 = mkt_spend_shr if rel == 0
 62.             ds int_lead* int_lag* mshr_lead* mshr_lag*
 63.             foreach var in `r(varlist)' {
 64.                 replace `var' = 0 if mi(`var')
 65.             }
 66.             if "`spec'" == "noattrit" {
 67.                 bys athr_id: egen latest_pub = max(cond(ppr_cnt > 0, year, .))
 68.                 * [F11-adjacent] guard: missing latest_pub must NOT pass a >= test
.                 keep if latest_pub >= 2018 & !mi(latest_pub)
 69.                 drop latest_pub
 70.             }
 71.             qui sum rel
 72.             local abs_lag  = abs(r(max))
 73.             local abs_lead = abs(r(min))
 74.             local int_leads
 75.             local int_lags
 76.             local mshr_leads
 77.             local mshr_lags
 78.             forval i = 2/`abs_lead' {
 79.                 local int_leads int_lead`i' `int_leads'
 80.                 local mshr_leads mshr_lead`i' `mshr_leads'
 81.             }
 82.             forval i = 0/`abs_lag' {
 83.                 local int_lags `int_lags' int_lag`i'
 84.                 local mshr_lags `mshr_lags' mshr_lag`i'
 85.             }
 86.             local addctrl
 87.             if "`spec'" == "ageCtrl" local addctrl c.age_2014#i.year
 88. 
.             // Poisson is the reported estimator; OLS runs only for ppr_cnt
.             local ests ppmlhdfe
 89.             if "`yvar'" == "ppr_cnt" local ests reghdfe ppmlhdfe
 90. 
.             foreach est of local ests {
 91.             local esuf ""
 92.             if "`est'" == "ppmlhdfe" local esuf "_ppml"
 93. 
.             * [F4] int_lead1 is OMITTED as the reference (was included with
.             * post-hoc re-centering, which made every plotted SE wrong for
.             * the b_j - b_lead1 contrast).
.             cap noi `est' `yvar' `int_leads' `int_lags' `mshr_leads' `mshr_lags' `addctrl', ///
>                     absorb(`fes') vce(cluster `vce_cl')
 94.             local rc = _rc
 95.             if `rc' {
 96.                 di as error "robustness `samp'`suf' `yvar' `spec' `est' failed (rc=`rc'); skipping."
 97.                 continue
 98.             }
 99.             gunique athr_id if e(sample)
100.             local n_pi = r(unique)
101. 
.             preserve
102.             cap mat drop es
103.             foreach var in `int_leads' `int_lags' int_lead1 {
104.                 if "`var'" == "int_lead1" {
105.                     mat row = 0,0
106.                 }
107.                 else {
108.                     cap mat row = _b[`var'], _se[`var']
109.                     if _rc mat row = ., .
110.                 }
111.                 mat es = nullmat(es) \ row
112.             }
113.             svmat es
114.             keep es1 es2
115.             drop if mi(es1)
116.             rename (es1 es2) (b se)
117.             gen ub = b + 1.96*se
118.             gen lb = b - 1.96*se
119.             gen rel = -`abs_lead' if _n == 1
120.             replace rel = rel[_n-1]+1 if _n > 1
121.             replace rel = rel + 1 if rel >= -1
122.             replace rel = -1 if rel == `abs_lag' + 1
123.             gen year = rel + 2014
124.             hashsort rel
125.             save ../temp/robust_es_main_`yvar'`esuf'_`spec'_`samp'`suf', replace
126.             local ytit "`var_name'"
127.             local ylabopt ""
128.             if "`est'" == "ppmlhdfe" {
129.                 local ytit "`ppml_ytit'"
130.                 local ylabopt "ylab(#6)"
131.             }
132.             else {
133.                 sum ub, d
134.                 local ymax = round(r(max),`gap')
135.                 sum lb, d
136.                 local ymin = round(r(min),`gap')
137.                 if `ymin' > 0 local ymin = 0
138.                 local ylabopt "ylab(`ymin'(`gap')`ymax')"
139.             }
140.             cap graph drop _all
141.             cap noi tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>               scatter b year, mcolor(ebblue) ///
>               , xlab(2010(1)2019) xtitle("Year") ytitle("`ytit'") ///
>                 `ylabopt' yline(0, lcolor(gs10) lpattern(solid)) ///
>                 title("Main ES: `title' (N PIs = `n_pi')", size(small)) ///
>                 legend(off) plotregion(margin(sides))
142.             cap noi graph export ../output/figures/`samp'/robustness/es_`yvar'_main`esuf'_`spec'`suf'.pdf, replace
143.             restore
144.             }
145.         }
146.     }
147. 
. end

