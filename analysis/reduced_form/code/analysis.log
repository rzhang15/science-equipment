. do "/n/holylabs/pakes_lab/Lab/sci_eq/analysis/reduced_form/code/analysis.do" 

. set more off

. clear all

. capture log close

. program drop _all

. set scheme modern

. preliminaries

. version 17

. 
. * EXPOSURE_VERSION : hc | all | treated_hc
. * EXPOSURE_FILTER  : "" | _cf | _cf2 | _cf5
. * FE_MODE          : author | inst_cluster | inst_cluster_fldyr
. *                    (inst_cluster modes absorb cluster_30: PIs unmatched to
. *                    the cluster file have cluster_30 missing and are silently
. *                    dropped by reghdfe/ppmlhdfe under those modes.)
. * QUICK_TOPJRNL    : 1 = top_jrnls sample, ppr_cnt only, single pass (pub=0, unweighted)
. global EXPOSURE_VERSION "hc"

. global EXPOSURE_FILTER  "_cf"

. global FE_MODE "author"

. global WEIGHT_MSIM 1

. global QUICK_TOPJRNL 0

. 
. program main
  1.     gather_external_data
  2.     if "$QUICK_TOPJRNL" == "1" {
  3.         cap mkdir "../output/figures/top_jrnls"
  4.         restrict_samp, samp(top_jrnls) r1r2(1) public(0) 
  5.         global WEIGHT_MSIM 0
  6.         di as text _newline "=========================================="
  7.         di as text "  RUNNING sample=top_jrnls ppr_cnt only (QUICK_TOPJRNL)"
  8.         di as text "=========================================="
  9.         mat drop _all
 10.         event_study,       samp(top_jrnls) r1r2(1) public(0)
 11.         pooled_did,        samp(top_jrnls) r1r2(1) public(0)
 12.         ppml_specs,        samp(top_jrnls) r1r2(1) public(0)
 13.         placebo_treatment, samp(top_jrnls) r1r2(1) public(0)
 14.         trim_top,          samp(top_jrnls) r1r2(1) public(0)
 15.         robustness,        samp(top_jrnls) r1r2(1) public(0)
 16.         output_tables,     samp(top_jrnls) r1r2(1) public(0)
 17.         exit
 18.     }
 19.     foreach pub in 0 1 {
 20.         foreach s in all_jrnls {
 21.             cap mkdir "../output/figures/`s'"
 22.             restrict_samp, samp(`s') r1r2(1) public(`pub')
 23.             foreach wmode in 0 1 {
 24.                 global WEIGHT_MSIM `wmode'
 25.                 di as text _newline "=========================================="
 26.                 di as text "  RUNNING sample=`s' WEIGHT_MSIM=`wmode' PUBLIC=`pub'"
 27.                 di as text "=========================================="
 28.                 mat drop _all
 29.                 event_study, samp(`s') r1r2(1) public(`pub')
 30.                 pooled_did, samp(`s') r1r2(1) public(`pub')
 31.                 ppml_specs, samp(`s') r1r2(1) public(`pub')
 32.                 if `wmode' == 0 {
 33.                     placebo_treatment, samp(`s') r1r2(1) public(`pub')
 34.                     trim_top, samp(`s') r1r2(1) public(`pub')
 35.                     robustness, samp(`s') r1r2(1) public(`pub')
 36.                 }
 37.                 output_tables, samp(`s') r1r2(1) public(`pub')
 38.             }
 39.             global WEIGHT_MSIM 0
 40.         }
 41.        * joint_outcome_test, samp(all_jrnls) r1r2(1) public(`pub')
. 
.         restrict_samp, samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 42.         foreach wmode in 0 1 {
 43.             global WEIGHT_MSIM `wmode'
 44.             di as text _newline "=========================================="
 45.             di as text "  RUNNING sample=all_jrnls WEIGHT_MSIM=`wmode' PUBLIC=`pub' (R1-only)"
 46.             di as text "=========================================="
 47.             mat drop _all
 48.             event_study, samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 49.             pooled_did,  samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 50.             ppml_specs,  samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 51.             if `wmode' == 0 {
 52.                 placebo_treatment, samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 53.                 trim_top,          samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 54.                 robustness,        samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 55.             }
 56.             output_tables, samp(all_jrnls) r1r2(1) public(`pub') r1_only(1)
 57.         }
 58.         global WEIGHT_MSIM 0
 59.     }
 60. end

. 
. program gather_external_data
  1.     import delimited ../external/exposure/final_imputed_shift_share_${EXPOSURE_VERSION}${EXPOSURE_FILTER}, clear
  2.     rename exposure_ss imputed
  3.     rename sum_imputed_shares imputed_mkt_spend_shr
  4.     save ../temp/exposure, replace
  5. 
.     * Author-year NIH measures straight from the grant-level build. The
.     * *_with_nih panels merge these onto the last-author publication panel with
.     * keep(1 3), so a funded PI-year with no last-author paper is dropped there
.     * and would be zero-filled downstream (see derived/nih/match_pi_athr).
.     cap use athr_id year n_grants n_new_grants nih_total_cost ///
>             using ../external/nih_grants/nih_athr_year, clear
  6.     if _rc {
  7.         di as error "gather_external_data: nih_athr_year not found -- NIH outcomes SKIPPED (rerun derived/nih/match_pi_athr)."
  8.     }
  9.     else {
 10.         gen byte has_nih = n_grants > 0
 11.         duplicates drop athr_id year, force
 12.         save ../temp/nih_athr_yr, replace
 13. 
.         * nih_pi_name is left blank without a RePORTER match: that is the flag.
.         use athr_id nih_pi_name using ../external/nih_grants/nih_names_by_athr, clear
 14.         gen byte nih_matched = !mi(nih_pi_name)
 15.         drop nih_pi_name
 16.         merge 1:1 athr_id using ../external/nih_grants/nih_totals_by_athr, ///
>             keepusing(n_grants_ever nih_cost_ever) keep(1 3) nogen
 17.         save ../temp/nih_athr_level, replace
 18.     }
 19. 
.     import delimited ../external/cluster/author_static_clusters_30_ls.csv, clear varnames(1)
 20.     cap tostring athr_id, replace
 21.     rename cluster_label cluster_30
 22.     save ../temp/athr_cluster30, replace
 23. 
.     use athr_id max_sim using ../external/exposure/match_diagnostics, clear
 24.     save ../temp/match_diag, replace
 25. 
.     * Observed FOIA exposure held aside before any panel gate, so the "observed"
.     * curve in the distribution figures is the same 213 PIs in every variant.
.     * Drawn from the merged panel it moved with min_year/max_year, r1_only and
.     * EXPOSURE_FILTER even though the FOIA set never changes.
.     use athr_id exposure mkt_spend_shr using ../external/real_exposure/athr_exposure_${EXPOSURE_VERSION}, clear
 26.     rename (exposure mkt_spend_shr) (exposure_all mkt_spend_shr_all)
 27.     save ../temp/foia_observed_exposure, replace
 28. end

. 
. program restrict_samp
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     if (`no_clin' == 1) local suf "_no_clin`suf'"
  8. 
.     // No "_r1" panel — R1-only reads the R1+R2 file then filters type=="r1"
.     local input_suf ""
  9.     if (`r1r2' == 1 & `public' == 0) local input_suf "_r1_r2"
 10.     if (`r1r2' == 1 & `public' == 1) local input_suf "_r1_r2_public"
 11.     if (`r1_only' == 1 & `public' == 0) local input_suf "_r1_r2"
 12.     if (`r1_only' == 1 & `public' == 1) local input_suf "_r1_r2_public"
 13.     if (`no_clin' == 1) local input_suf "_no_clin`input_suf'"
 14. 
.     preserve
 15.         cap use athr_id year ppr_cnt cite_affl_wt affl_wt ///
>                 avg_position avg_position_rat ///
>                 n_first_ppr n_middle_ppr n_last_ppr ///
>                 avg_team_size_last avg_team_size_notlast ///
>                 using ../external/samp/athr_panel_full_year_`samp'`input_suf', clear
 16.         local _pos_rc = _rc
 17.         if `_pos_rc' {
 18.             di as text "restrict_samp `samp'`suf': position vars not in panel yet — falling back to base _any outcomes. Rerun make_athr_yr_panel/code/build.do to enable them."
 19.             use athr_id year ppr_cnt cite_affl_wt affl_wt ///
>                 using ../external/samp/athr_panel_full_year_`samp'`input_suf', clear
 20.         }
 21.         global POSITION_OUTCOMES_AVAIL = cond(`_pos_rc' == 0, 1, 0)
 22.         rename (ppr_cnt cite_affl_wt affl_wt) (ppr_cnt_any cite_affl_wt_any affl_wt_any)
 23.         save ../temp/athr_any_`samp'`input_suf', replace
 24. 
.         // Use all-position min_year for age_2014 — last-only would count a PI as spuriously young
.         bys athr_id: egen min_year_any = min(year)
 25.         keep athr_id min_year_any
 26.         duplicates drop
 27.         save ../temp/athr_min_year_any_`samp'`input_suf', replace
 28.     restore
 29. 
.     use ../external/samp/athr_panel_full_year_last_`samp'`input_suf',clear
 30.     if `r1_only' == 1 {
 31.         keep if type == "r1"
 32.         di as text "restrict_samp `samp'`suf' (r1_only=1): kept N=" _N " R1-only rows"
 33.     }
 34.     bys athr_id: egen max_year = max(year)
 35.     bys athr_id: egen min_year = min(year)
 36.     keep if min_year <= 2013
 37.     keep if max_year >= 2015
 38.     keep if inrange(year, 2010, 2019)
 39.     * keep(1 3), not keep(3): 13 FOIA PIs have observed exposure but no imputed
.     * row (they are not in the cleaned US life-science corpus, so they never
.     * enter universe_ids). keep(3) dropped them here, before the
.     * "replace imputed = exposure" below would have used their observed value
.     * anyway. They skew high -- mean 0.0403 vs 0.0260 for the 195 survivors.
.     merge m:1 athr_id using ../temp/exposure, keep(1 3) nogen
 40.     merge m:1 athr_id using ../external/real_exposure/athr_exposure_${EXPOSURE_VERSION}, keep(1 3) nogen
 41.     keep if !mi(imputed) | !mi(exposure)
 42.     merge m:1 athr_id using ../temp/athr_cluster30, keep(1 3) nogen
 43.     merge m:1 athr_id using ../temp/athr_min_year_any_`samp'`input_suf', keep(1 3) nogen
 44.     replace min_year_any = min_year if mi(min_year_any)
 45.     gen foia_athr = 1 if !mi(exposure)
 46.     // Real FOIA PIs anchor themselves (max_sim=1); unmatched (rare) get 0 so they drop from pw regs
.     merge m:1 athr_id using ../temp/match_diag, keep(1 3) nogen
 47.     replace max_sim = 1 if foia_athr == 1
 48.     replace max_sim = 0 if mi(max_sim)
 49.     bys athr_id : gen athr_indicator = _n == 1
 50.     * Observed curve comes from ../temp/foia_observed_exposure (all 213 PIs,
.     * pre-gate) so it is invariant across samp/suf/EXPOSURE_FILTER. The imputed
.     * curve is sample-specific by design -- that is the object being compared.
.     preserve
 51.         keep if athr_indicator == 1
 52.         keep athr_id imputed imputed_mkt_spend_shr
 53.         append using ../temp/foia_observed_exposure
 54.         sum exposure_all, d
 55.         local mean : di %4.3f r(mean)
 56.         local sd   : di %4.3f r(sd)
 57.         sum imputed, d
 58.         local imputed_mean : di %4.3f r(mean)
 59.         local imputed_sd   : di %4.3f r(sd)
 60.         sum mkt_spend_shr_all, d
 61.         local mshr_mean : di %4.3f r(mean)
 62.         local mshr_sd   : di %4.3f r(sd)
 63.         sum imputed_mkt_spend_shr, d
 64.         local imshr_mean : di %4.3f r(mean)
 65.         local imshr_sd   : di %4.3f r(sd)
 66.         tw kdensity exposure_all, lcolor(ebblue)   || kdensity imputed, lcolor(dkorange)   xtitle("Exposure Measure") ytitle("Density") ///
>             xlab(#15) ///
>             legend(on label(1 "FOIA PI Observed Exposure (mean = `mean', sd = `sd')") label(2 "Imputed Exposure (mean = `imputed_mean', sd = `imputed_sd')") pos(7) ring(1) size(small))
 67.         graph export ../output/figures/`samp'/exposure_dist`suf'.pdf, replace
 68.         tw kdensity mkt_spend_shr_all, lcolor(ebblue)  || kdensity imputed_mkt_spend_shr, lcolor(dkorange)   xtitle("Market Spend Share") ytitle("Density") ///
>             xlab(#15) ///
>             legend(on label(1 "FOIA PI Observed (mean = `mshr_mean', sd = `mshr_sd')") label(2 "Imputed (mean = `imshr_mean', sd = `imshr_sd')") pos(7) ring(1) size(small))
 69.         graph export ../output/figures/`samp'/mkt_spend_shr_dist`suf'.pdf, replace
 70.     restore
 71.     replace imputed = exposure if !mi(exposure)
 72.     replace imputed_mkt_spend_shr = mkt_spend_shr if !mi(mkt_spend_shr)
 73.     drop exposure
 74.     rename imputed exposure
 75.     drop mkt_spend_shr
 76.     rename imputed_mkt_spend_shr mkt_spend_shr
 77.     bys athr_id: egen num_yrs_pre = total(year < 2014)
 78.     bys athr_id: egen num_yrs_post = total(year >= 2014)
 79.     bys athr_id: gen tot_yrs = _N
 80.     bys athr_id inst_id: gen plc_cntr = _n == 1
 81.     bys athr_id : egen num_place = total(plc_cntr)
 82.     * [F5] spelled out (was `num_yrs', which relied on abbreviation)
.     drop if num_yrs_pre <= 2 
 83.    * drop if num_yrs_post < 2
. *    drop if tot_yrs <= 4
.     keep if num_place==1
 84.     gegen athr = group(athr_id)
 85.     preserve
 86.     contract athr num_place athr_id exposure inst_id inst msa_comb msa_c_world min_year min_year_any type public mkt_spend_shr cluster_30 max_sim foia_athr
 87.     drop _freq
 88.     save ../temp/athr_xw, replace
 89.     restore
 90.     xtset athr year
 91.     tsfill, full
 92.     drop athr_id exposure inst_id inst msa_comb msa_c_world min_year min_year_any type public mkt_spend_shr cluster_30 max_sim foia_athr
 93.     merge m:1 athr using ../temp/athr_xw, assert(3) keep(3) nogen
 94.     // Drop position vars from master before athr_any merge — Stata silently keeps master, and the last-only versions are degenerate
.     foreach v in n_first_ppr n_middle_ppr n_last_ppr n_solo_ppr ///
>                  avg_position avg_position_rat ///
>                  avg_team_size_last avg_team_size_notlast {
 95.         cap drop `v'
 96.     }
 97.     merge 1:1 athr_id year using ../temp/athr_any_`samp'`input_suf', keep(1 3) nogen
 98.     foreach var in ppr_cnt cite_affl_wt affl_wt ppr_cnt_any cite_affl_wt_any affl_wt_any {
 99.         replace `var' = 0 if mi(`var')
100.     }
101.     foreach var in n_first_ppr n_middle_ppr n_last_ppr {
102.         cap confirm variable `var'
103.         if !_rc replace `var' = 0 if mi(`var')
104.     }
105.     gen pre_ppr_cnt = ppr_cnt if year < 2014
106.     bys athr_id: egen pre_ppr_cnt_sum = sum(pre_ppr_cnt)
107.     bys athr_id: egen pre_ppr_cnt_avg = mean(pre_ppr_cnt)
108.     // Both p5 cuts from the pre-trim distribution so the drops don't compound
.     qui sum pre_ppr_cnt_avg if athr_indicator == 1, d
109.     local p5_avg = r(p5)
110.     qui sum pre_ppr_cnt_sum if athr_indicator == 1, d
111.     local p5_sum = r(p5)
112.     drop if pre_ppr_cnt_avg <= `p5_avg'
113.     drop if pre_ppr_cnt_sum <= `p5_sum'
114.     gen age_2014 = 2014 - min_year_any + 30
115.     drop if mi(exposure)
116.     drop if mi(mkt_spend_shr) | mkt_spend_shr <= 0
117.     merge 1:1 athr_id year using ../external/coathrs/avg_coathrs, keep(1 3) nogen
118.     replace avg_num_coathrs = 0 if mi(avg_num_coathrs)
119.     // [F6] Intensive margin: undefined when the PI publishes nothing that
.     // year IN ANY POSITION (was keyed to last-author ppr_cnt only).
.     replace avg_num_coathrs = . if ppr_cnt_any == 0
120.     * NIH outcomes are estimated only on PIs who match RePORTER AND hold at
.     * least one research award 2010-19. A PI who never matches, or whose measure
.     * is zero in every year, carries no NIH information: set the measures
.     * missing so those PIs drop from the NIH regressions only. Within a retained
.     * PI, zero years are real and are kept.
.     cap confirm file ../temp/nih_athr_yr.dta
121.     if _rc di as error "restrict_samp `samp'`suf': ../temp/nih_athr_yr missing -- NIH outcomes unavailable this run."
122.     else {
123.         merge 1:1 athr_id year using ../temp/nih_athr_yr, keep(1 3) nogen
124.         merge m:1 athr_id using ../temp/nih_athr_level, keep(1 3) nogen
125.         replace nih_matched = 0 if mi(nih_matched)
126.         * The source file has no publication filter, so a non-merging year for
.         * a matched PI really is a year with no award record.
.         foreach v in n_grants n_new_grants nih_total_cost has_nih {
127.             replace `v' = 0 if mi(`v') & nih_matched == 1
128.         }
129.         foreach v in n_grants n_new_grants has_nih {
130.             replace `v' = . if nih_matched != 1 | mi(n_grants_ever) | n_grants_ever == 0
131.         }
132.         replace nih_total_cost = . if nih_matched != 1 | mi(nih_cost_ever) | nih_cost_ever == 0
133.         qui gunique athr_id if !mi(n_grants)
134.         di as text "restrict_samp `samp'`suf': " r(unique) " PIs in the NIH grant-count sample"
135.         qui gunique athr_id if !mi(nih_total_cost)
136.         di as text "restrict_samp `samp'`suf': " r(unique) " PIs in the NIH award-amount sample"
137.     }
138. 
.     * PI-level flag for the RePORTER-matched, grant-holding sample
.     cap confirm variable n_grants
139.     if _rc {
140.         gen byte nih_athr = 0
141.     }
142.     else {
143.         bys athr_id: egen byte nih_athr = max(!mi(n_grants))
144.     }
145. 
.     gen ppr_cnt_notlast      = ppr_cnt_any      - ppr_cnt
146.     gen cite_affl_wt_notlast = cite_affl_wt_any - cite_affl_wt
147.     gen affl_wt_notlast      = affl_wt_any      - affl_wt
148.     foreach v in ppr_cnt_notlast cite_affl_wt_notlast affl_wt_notlast {
149.         replace `v' = 0 if `v' < 0
150.     }
151.     foreach v in cite_affl_wt affl_wt cite_affl_wt_any affl_wt_any ///
>                  cite_affl_wt_notlast affl_wt_notlast {
152.         // p99 cut from pre-period only so the truncation point is unaffected by treatment
.         qui sum `v' if year < 2014, d
153.         local p99_`v' = r(p99)
154.         replace `v' = `p99_`v'' if `v' > `p99_`v'' & !mi(`v')
155.         di as text "restrict_samp `samp'`suf' winsorized `v' at pre-period p99=`p99_`v''"
156.     }
157. 
.     assert !mi(athr_id)
158.     assert !mi(exposure)
159.     assert !mi(mkt_spend_shr)
160.     cap mkdir ../output/prepped_samples
161.     compress
162.     save ../output/prepped_samples/es_`samp'`suf', replace
163. end

. 
. program event_study
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local wt ""
 13.     local wsuf ""
 14.     if "$WEIGHT_MSIM" == "1" {
 15.         local wt "[pw=max_sim]"
 16.         local wsuf "_msimwt"
 17.     }
 18.     local suf ""
 19.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 20.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 21.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 22.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 23.     if (`no_clin' == 1) local suf "_no_clin`suf'"
 24.     use ../output/prepped_samples/es_`samp'`suf', clear
 25. 
.     gen rel = year - 2014
 26.     qui sum rel, d
 27.     local abs_lag  = abs(r(max))
 28.     local abs_lead = abs(r(min))
 29.     * [F12] Only the observed window is generated; unused time dummies removed.
.     forval i = 1/`abs_lead' {
 30.         gen int_lead`i'  = exposure      if rel == -`i'
 31.         gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 32.     }
 33.     forval i = 0/`abs_lag' {
 34.         gen int_lag`i'  = exposure      if rel == `i'
 35.         gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 36.     }
 37.     ds int_lead* int_lag* mshr_lead* mshr_lag*
 38.     foreach var in `r(varlist)' {
 39.         replace `var' = 0 if mi(`var')
 40.     }
 41.     local int_leads
 42.     local mshr_leads
 43.     local int_lags
 44.     local mshr_lags
 45.     forval i = 2/`abs_lead' {
 46.         local int_leads int_lead`i' `int_leads'
 47.         local mshr_leads mshr_lead`i' `mshr_leads'
 48.     }
 49.     forval i = 0/`abs_lag' {
 50.         local int_lags `int_lags' int_lag`i'
 51.         local mshr_lags `mshr_lags' mshr_lag`i'
 52.     }
 53.     foreach v in ppr_cnt cite_affl_wt ppr_cnt_any cite_affl_wt_any ///
>                  ppr_cnt_notlast cite_affl_wt_notlast {
 54.         gen ln_`v' = ln(1+`v')
 55.     }
 56. 
.     local position_outcomes ""
 57.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
 58.         local position_outcomes n_middle_ppr avg_position avg_team_size_last avg_team_size_notlast
 59.     }
 60. 
.     local outcomes ppr_cnt cite_affl_wt ln_ppr_cnt ppr_cnt_any cite_affl_wt_any ///
>                    ppr_cnt_notlast cite_affl_wt_notlast avg_num_coathrs n_grants nih_total_cost ///
>                    `position_outcomes'
 61.     if "$QUICK_TOPJRNL" == "1" local outcomes ppr_cnt ln_ppr_cnt
 62. 
.     foreach yvar of local outcomes {
 63.         if "`yvar'" == "cite_affl_wt" local var_name = "Citation Weighted Output"
 64.         if "`yvar'" == "cite_affl_wt" local gap  1
 65.         if "`yvar'" == "ppr_cnt" local var_name = "Publication Count"
 66.         if "`yvar'" == "ppr_cnt" local gap 0.5
 67.         if "`yvar'" == "ln_ppr_cnt"      local var_name = "Log Publication Counts"
 68.         if "`yvar'" == "ln_ppr_cnt"      local gap 0.1
 69.         if "`yvar'" == "ppr_cnt"      & "`samp'" == "top_jrnls" local gap 2
 70.         if "`yvar'" == "cite_affl_wt" & "`samp'" == "top_jrnls" local gap 2
 71.         if "`yvar'" == "ppr_cnt_any"         local var_name = "Publication Count (any position)"
 72.         if "`yvar'" == "ppr_cnt_any"         local gap 0.5
 73.         if "`yvar'" == "cite_affl_wt_any"    local var_name = "Citation Weighted Output (any position)"
 74.         if "`yvar'" == "cite_affl_wt_any"    local gap 1
 75.         if "`yvar'" == "ppr_cnt_any"         & "`samp'" == "top_jrnls" local gap 2
 76.         if "`yvar'" == "cite_affl_wt_any"    & "`samp'" == "top_jrnls" local gap 2
 77.         if "`yvar'" == "ppr_cnt_notlast"         local var_name = "Publication Count (non-last author)"
 78.         if "`yvar'" == "ppr_cnt_notlast"         local gap 0.5
 79.         if "`yvar'" == "cite_affl_wt_notlast"    local var_name = "Citation Weighted Output (non-last author)"
 80.         if "`yvar'" == "cite_affl_wt_notlast"    local gap 1
 81.         if "`yvar'" == "ppr_cnt_notlast"         & "`samp'" == "top_jrnls" local gap 2
 82.         if "`yvar'" == "cite_affl_wt_notlast"    & "`samp'" == "top_jrnls" local gap 2
 83.         if "`yvar'" == "avg_num_coathrs"   local var_name = "Average Team Size"
 84.         if "`yvar'" == "avg_num_coathrs"   local gap 0.5
 85.         if "`yvar'" == "n_grants"          local var_name = "# Active NIH Research Grants"
 86.         if "`yvar'" == "n_grants"          local gap 0.5
 87.         if "`yvar'" == "nih_total_cost"    local var_name = "NIH Award Amount ($)"
 88.         if "`yvar'" == "nih_total_cost"    local gap 50000
 89.         if "`yvar'" == "n_first_ppr"           local var_name = "# First-Author Papers"
 90.         if "`yvar'" == "n_first_ppr"           local gap 0.5
 91.         if "`yvar'" == "n_middle_ppr"          local var_name = "# Middle-Author Papers"
 92.         if "`yvar'" == "n_middle_ppr"          local gap 0.5
 93.         if "`yvar'" == "n_last_ppr"            local var_name = "# Last-Author Papers"
 94.         if "`yvar'" == "n_last_ppr"            local gap 0.5
 95.         if "`yvar'" == "avg_position"          local var_name = "Avg Author Position (1=first, N=last)"
 96.         if "`yvar'" == "avg_position"          local gap 0.5
 97.         if "`yvar'" == "avg_position_rat"      local var_name = "Avg Author Position / Team Size (0-1)"
 98.         if "`yvar'" == "avg_position_rat"      local gap 0.05
 99.         if "`yvar'" == "avg_team_size_last"    local var_name = "Team Size (papers where PI is last)"
100.         if "`yvar'" == "avg_team_size_last"    local gap 0.5
101.         if "`yvar'" == "avg_team_size_notlast" local var_name = "Team Size (papers where PI is not last)"
102.         if "`yvar'" == "avg_team_size_notlast" local gap 0.5
103.         local poisson_name "`var_name'"
104.         if "`yvar'" == "ppr_cnt"              local poisson_name "Publications"
105.         if "`yvar'" == "cite_affl_wt"         local poisson_name "Citation-Weighted Output"
106.         if "`yvar'" == "ppr_cnt_any"          local poisson_name "Publications (any position)"
107.         if "`yvar'" == "cite_affl_wt_any"     local poisson_name "Citation-Weighted Output (any position)"
108.         if "`yvar'" == "ppr_cnt_notlast"      local poisson_name "Publications (non-last author)"
109.         if "`yvar'" == "cite_affl_wt_notlast" local poisson_name "Citation-Weighted Output (non-last author)"
110.         if "`yvar'" == "avg_num_coathrs"      local poisson_name "Coauthors"
111.         if "`yvar'" == "n_grants"             local poisson_name "Active NIH Research Grants"
112.         if "`yvar'" == "nih_total_cost"       local poisson_name "NIH Award Dollars"
113.         local ppml_ytit "Output-Cost Elasticity"
114.         if inlist("`yvar'", "n_grants", "n_new_grants", "nih_total_cost") ///
>             local ppml_ytit "{&Delta} Log Expected `poisson_name'"
115. 
.         // PPML is the reported estimator everywhere; OLS runs only for the
.         // ppr_cnt OLS-vs-Poisson comparison and for outcomes PPML can't take
.         // (logs and conditional-mean outcomes).
.         local ppml_ok = !regexm("`yvar'", "^ln_") & (!regexm("`yvar'", "^avg_") | "`yvar'" == "avg_num_coathrs")
116.         local ols_ok  = inlist("`yvar'", "ppr_cnt", "ln_ppr_cnt") | !`ppml_ok'
117. 
.         if `ols_ok' {
118.         preserve
119.         cap mat drop es
120.         cap noi reghdfe `yvar' `int_leads' `int_lags' `mshr_leads' `mshr_lags' `wt', ///
>                        absorb(`fes') vce(cluster `vce_cl')
121.         local rc = _rc
122.         if `rc' {
123.             di as error "event_study `samp'`suf' `yvar' mshrctrl failed (rc=`rc'); skipping mshrctrl plot."
124.             restore
125.         }
126.         else {
127.         gunique athr_id if e(sample)
128.         local num_athrs = r(unique)
129.         gunique inst_id if e(sample)
130.         local num_insts = r(unique)
131.         sum `yvar' if rel <= -1 & e(sample), d
132.         local pre_mean : dis %4.3f r(mean)
133.         foreach var in `int_leads' `int_lags' int_lead1 {
134.             if "`var'" == "int_lead1" {
135.                 mat row = 0,0
136.             }
137.             else {
138.                 mat row = _b[`var'], _se[`var']
139.             }
140.             mat es = nullmat(es) \ row
141.         }
142.         svmat es
143.         keep es1 es2
144.         drop if mi(es1)
145.         rename (es1 es2) (b se)
146.         gen ub = b + 1.96*se
147.         sum ub, d
148.         local ymax = round(r(max),`gap')
149.         gen lb = b - 1.96*se
150.         sum lb, d
151.         local ymin = round(r(min),`gap')
152.         if `ymin' > 0 local ymin = 0
153.         if inlist("`yvar'", "ln_ppr_cnt", "ln_cite_affl_wt") local ymin = -1
154.         gen rel = -`abs_lead' if _n == 1
155.         replace rel = rel[_n-1]+1 if _n > 1
156.         replace rel = rel + 1 if rel >= -1
157.         replace rel = -1 if rel == `abs_lag' + 1
158.         gen year = rel + 2014
159.         hashsort rel
160.         tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>           scatter b year, mcolor(ebblue) || ///
>           scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>           xlab(2010(1)2019) xtitle("Year") ///
>           ytitle("`var_name'") ylab(`ymin'(`gap')`ymax') ///
>           yline(0, lcolor(gs10) lpattern(solid)) ///
>           legend(on order(- "Num. PIs: `num_athrs'" "Num. Institutions: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) plotregion(margin(sides))
161.         graph export ../output/figures/`samp'/es_`yvar'`suf'_mshrctrl`wsuf'.pdf, replace
162.         save ../temp/es_`yvar'`suf'_mshrctrl`wsuf', replace
163.         restore
164.         }
165.         }
166. 
.         if `ppml_ok' {
167.             preserve
168.             cap mat drop es
169.             cap noi ppmlhdfe `yvar' `int_leads' `int_lags' ///
>                                    `mshr_leads' `mshr_lags' `wt', ///
>                     absorb(`fes') vce(cluster `vce_cl')
170.             local rc = _rc
171.             if `rc' {
172.                 di as error "ppmlhdfe `yvar' mshrctrl failed (rc=`rc'); skipping plot."
173.                 restore
174.             }
175.             else {
176.             gunique athr_id if e(sample)
177.             local num_athrs = r(unique)
178.             gunique inst_id if e(sample)
179.             local num_insts = r(unique)
180.             sum `yvar' if rel <= -1 & e(sample), d
181.             local pre_mean : dis %4.3f r(mean)
182.             foreach var in `int_leads' `int_lags' int_lead1 {
183.                 if "`var'" == "int_lead1" {
184.                     mat row = 0,0
185.                 }
186.                 else {
187.                     mat row = _b[`var'], _se[`var']
188.                 }
189.                 mat es = nullmat(es) \ row
190.             }
191.             svmat es
192.             keep es1 es2
193.             drop if mi(es1)
194.             rename (es1 es2) (b se)
195.             gen ub = b + 1.96*se
196.             sum ub, d
197.             local ymax = round(r(max), 0.1)
198.             gen lb = b - 1.96*se
199.             sum lb, d
200.             local ymin = round(r(min), 0.1)
201.             if `ymin' > 0 local ymin = 0
202.             gen rel = -`abs_lead' if _n == 1
203.             replace rel = rel[_n-1]+1 if _n > 1
204.             replace rel = rel + 1 if rel >= -1
205.             replace rel = -1 if rel == `abs_lag' + 1
206.             gen year = rel + 2014
207.             hashsort rel
208.             tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>               scatter b year, mcolor(ebblue) || ///
>               scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>               xlab(2010(1)2019) xtitle("Year") ///
>               ytitle("`ppml_ytit'") ylab(`ymin'(0.1)`ymax') ///
>               yline(0, lcolor(gs10) lpattern(solid)) ///
>               legend(on order(- "Num. PIs: `num_athrs'" "Num. Institutions: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) plotregion(margin(sides))
209.             graph export ../output/figures/`samp'/es_`yvar'`suf'_ppml_mshrctrl`wsuf'.pdf, replace
210.             save ../temp/es_`yvar'`suf'_ppml_mshrctrl`wsuf', replace
211.             restore
212.             }
213.         }
214. 
.         // FOIA PIs only (observed, non-imputed exposure), PPML with share controls
.         if "`yvar'" == "ppr_cnt" {
215.             preserve
216.             keep if foia_athr == 1
217.             cap mat drop es
218.             cap noi ppmlhdfe `yvar' `int_leads' `int_lags' ///
>                                    `mshr_leads' `mshr_lags' `wt', ///
>                     absorb(`fes') vce(cluster `vce_cl')
219.             local rc = _rc
220.             if `rc' {
221.                 di as error "ppmlhdfe `yvar' foia-only mshrctrl failed (rc=`rc'); skipping plot."
222.                 restore
223.             }
224.             else {
225.             gunique athr_id if e(sample)
226.             local num_athrs = r(unique)
227.             gunique inst_id if e(sample)
228.             local num_insts = r(unique)
229.             sum `yvar' if rel <= -1 & e(sample), d
230.             local pre_mean : dis %4.3f r(mean)
231.             foreach var in `int_leads' `int_lags' int_lead1 {
232.                 if "`var'" == "int_lead1" {
233.                     mat row = 0,0
234.                 }
235.                 else {
236.                     // small FOIA-only sample: a collinear term can drop out of e(b)
.                     cap mat row = _b[`var'], _se[`var']
237.                     if _rc mat row = ., .
238.                 }
239.                 mat es = nullmat(es) \ row
240.             }
241.             svmat es
242.             keep es1 es2
243.             drop if mi(es1)
244.             rename (es1 es2) (b se)
245.             gen ub = b + 1.96*se
246.             sum ub, d
247.             local ymax = r(max)
248.             gen lb = b - 1.96*se
249.             sum lb, d
250.             local ymin = min(r(min), 0)
251.             gen rel = -`abs_lead' if _n == 1
252.             replace rel = rel[_n-1]+1 if _n > 1
253.             replace rel = rel + 1 if rel >= -1
254.             replace rel = -1 if rel == `abs_lag' + 1
255.             gen year = rel + 2014
256.             hashsort rel
257.             tw rcap ub lb year if year != 2013, lcolor(dkorange%70) msize(vsmall) || ///
>               scatter b year, mcolor(dkorange) || ///
>               scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>               xlab(2010(1)2019) xtitle("Year") ///
>               ytitle("`ppml_ytit'") ylab(#6) ///
>               yline(0, lcolor(gs10) lpattern(solid)) ///
>               title("FOIA PIs only (observed exposure)", size(small)) ///
>               legend(on order(- "Num. PIs: `num_athrs'" "Num. Institutions: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) plotregion(margin(sides))
258.             graph export ../output/figures/`samp'/es_`yvar'`suf'_ppml_mshrctrl_foia`wsuf'.pdf, replace
259.             save ../temp/es_`yvar'`suf'_ppml_mshrctrl_foia`wsuf', replace
260.             restore
261.             }
262.         }
263. 
.         // NIH-matched PIs only (RePORTER match with >=1 research award), PPML with share controls
.         if inlist("`yvar'", "ppr_cnt", "cite_affl_wt") {
264.             preserve
265.             keep if nih_athr == 1
266.             cap mat drop es
267.             cap noi ppmlhdfe `yvar' `int_leads' `int_lags' ///
>                                    `mshr_leads' `mshr_lags' `wt', ///
>                     absorb(`fes') vce(cluster `vce_cl')
268.             local rc = _rc
269.             if `rc' {
270.                 di as error "ppmlhdfe `yvar' nih-only mshrctrl failed (rc=`rc'); skipping plot."
271.                 restore
272.             }
273.             else {
274.             gunique athr_id if e(sample)
275.             local num_athrs = r(unique)
276.             gunique inst_id if e(sample)
277.             local num_insts = r(unique)
278.             sum `yvar' if rel <= -1 & e(sample), d
279.             local pre_mean : dis %4.3f r(mean)
280.             foreach var in `int_leads' `int_lags' int_lead1 {
281.                 if "`var'" == "int_lead1" {
282.                     mat row = 0,0
283.                 }
284.                 else {
285.                     cap mat row = _b[`var'], _se[`var']
286.                     if _rc mat row = ., .
287.                 }
288.                 mat es = nullmat(es) \ row
289.             }
290.             svmat es
291.             keep es1 es2
292.             drop if mi(es1)
293.             rename (es1 es2) (b se)
294.             gen ub = b + 1.96*se
295.             sum ub, d
296.             local ymax = r(max)
297.             gen lb = b - 1.96*se
298.             sum lb, d
299.             local ymin = min(r(min), 0)
300.             gen rel = -`abs_lead' if _n == 1
301.             replace rel = rel[_n-1]+1 if _n > 1
302.             replace rel = rel + 1 if rel >= -1
303.             replace rel = -1 if rel == `abs_lag' + 1
304.             gen year = rel + 2014
305.             hashsort rel
306.             tw rcap ub lb year if year != 2013, lcolor(lavender%70) msize(vsmall) || ///
>               scatter b year, mcolor(lavender) || ///
>               scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>               xlab(2010(1)2019) xtitle("Year") ///
>               ytitle("`ppml_ytit'") ylab(#6) ///
>               yline(0, lcolor(gs10) lpattern(solid)) ///
>               title("NIH-matched PIs only", size(small)) ///
>               legend(on order(- "Num. PIs: `num_athrs'" "Num. Institutions: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) plotregion(margin(sides))
307.             graph export ../output/figures/`samp'/es_`yvar'`suf'_ppml_mshrctrl_nih`wsuf'.pdf, replace
308.             save ../temp/es_`yvar'`suf'_ppml_mshrctrl_nih`wsuf', replace
309.             restore
310.             }
311.         }
312.     }
313. end

. 
. program pooled_did
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local wt ""
 13.     local wsuf ""
 14.     if "$WEIGHT_MSIM" == "1" {
 15.         // ppmlhdfe rejects aw, binscatter rejects pw — mixing is fine, β identical
.         local wt "[pw=max_sim]"
 16.         local wt_bin "[aw=max_sim]"
 17.         local wsuf "_msimwt"
 18.     }
 19.     local suf ""
 20.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 21.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 22.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 23.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 24.     if (`no_clin' == 1) local suf "_no_clin`suf'"
 25.     use ../output/prepped_samples/es_`samp'`suf', clear
 26. 
.     foreach v in cite_affl_wt ppr_cnt cite_affl_wt_any ppr_cnt_any ///
>                  cite_affl_wt_notlast ppr_cnt_notlast {
 27.         cap gen ln_`v' = ln(1+`v')
 28.     }
 29. 
.     gen post       = year >= 2014
 30.     gen Z_it       = exposure              * post
 31.     gen Z_share_it = mkt_spend_shr * post
 32. 
.     local position_outcomes ""
 33.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
 34.         local position_outcomes n_middle_ppr avg_position avg_team_size_last avg_team_size_notlast
 35.     }
 36.     local outcomes cite_affl_wt ppr_cnt ln_ppr_cnt ///
>                    cite_affl_wt_any ppr_cnt_any cite_affl_wt_notlast ppr_cnt_notlast  ///
>                    avg_num_coathrs n_grants nih_total_cost ///
>                    `position_outcomes'
 37.     if "$QUICK_TOPJRNL" == "1" local outcomes ppr_cnt ln_ppr_cnt
 38. 
.     cap mkdir ../output/tables
 39.     cap mkdir ../output/tables/`samp'
 40. 
.     cap mat drop results
 41.     * [F1] label bookkeeping: rows and labels now appended together
.     local kept_outcomes
 42.     // OLS is reported only for the ppr_cnt OLS-vs-Poisson comparison; every
.     // other outcome ppml_specs covers is Poisson-only.
.     local ppml_covered cite_affl_wt cite_affl_wt_any ppr_cnt_any ///
>                        cite_affl_wt_notlast ppr_cnt_notlast ///
>                        avg_num_coathrs n_grants nih_total_cost n_middle_ppr
 43.     foreach yvar of local outcomes {
 44.         if `: list yvar in ppml_covered' continue
 45. 
.         local b_b = .
 46.         local b_se = .
 47.         local b_N = .
 48.         local b_r2 = .
 49.         local b_pmn = .
 50. 
.         local s_bx = .
 51.         local s_sex = .
 52.         local s_bs = .
 53.         local s_ses = .
 54.         local s_N = .
 55.         local s_r2 = .
 56. 
.         // Base (no share) only for ppr_cnt — the with/without-share comparison
.         if "`yvar'" == "ppr_cnt" {
 57.             cap noi qui reghdfe `yvar' Z_it `wt', absorb(`fes') vce(cluster `vce_cl')
 58.             local rc = _rc
 59.             if `rc' == 0 {
 60.                 local b_b  = _b[Z_it]
 61.                 local b_se = _se[Z_it]
 62.                 local b_N  = e(N)
 63.                 local b_r2 = e(r2)
 64.                 qui sum `yvar' if year < 2014 & e(sample)
 65.                 local b_pmn = r(mean)
 66.             }
 67.             else di as error "pooled_did `samp'`suf' `yvar' base failed (rc=`rc')."
 68.         }
 69. 
.         cap noi qui reghdfe `yvar' Z_it Z_share_it `wt', absorb(`fes') vce(cluster `vce_cl')
 70.         local rc = _rc
 71.         if `rc' {
 72.             di as error "pooled_did `samp'`suf' `yvar' +share failed (rc=`rc'); skipping outcome."
 73.             continue
 74.         }
 75.         local s_bx  = _b[Z_it]
 76.         local s_sex = _se[Z_it]
 77.         local s_bs  = _b[Z_share_it]
 78.         local s_ses = _se[Z_share_it]
 79.         local s_N   = e(N)
 80.         local s_r2  = e(r2)
 81.         qui sum `yvar' if year < 2014 & e(sample)
 82.         local pre_mean = r(mean)
 83. 
.         di as text "pooled_did `samp'`suf' `yvar':  base b=" %7.4f `b_b' " se=" %7.4f `b_se' ///
>             "    +share b=" %7.4f `s_bx' " se=" %7.4f `s_sex' ///
>             "    share_b=" %7.4f `s_bs' " se=" %7.4f `s_ses' ///
>             "    pre-mean=" %7.4f `pre_mean'
 84. 
.         cap mat drop pdid_`yvar'
 85.         mat pdid_`yvar' = J(7,2,.)
 86.         mat pdid_`yvar'[1,1] = `b_b'
 87.         mat pdid_`yvar'[2,1] = `b_se'
 88.         mat pdid_`yvar'[5,1] = `b_pmn'
 89.         mat pdid_`yvar'[6,1] = `b_N'
 90.         mat pdid_`yvar'[7,1] = `b_r2'
 91.         mat pdid_`yvar'[1,2] = `s_bx'
 92.         mat pdid_`yvar'[2,2] = `s_sex'
 93.         mat pdid_`yvar'[3,2] = `s_bs'
 94.         mat pdid_`yvar'[4,2] = `s_ses'
 95.         mat pdid_`yvar'[5,2] = `pre_mean'
 96.         mat pdid_`yvar'[6,2] = `s_N'
 97.         mat pdid_`yvar'[7,2] = `s_r2'
 98.         mat rownames pdid_`yvar' = b_exposure se_exposure b_share se_share pre_mean N r2
 99.         mat colnames pdid_`yvar' = base with_share
100. 
.         mat row = `b_b', `b_se', `s_bx', `s_sex', `s_bs', `s_ses', `pre_mean'
101.         mat results = nullmat(results) \ row
102.         local kept_outcomes `kept_outcomes' `yvar'
103. 
.         local var_name "`yvar'"
104.         if "`yvar'" == "cite_affl_wt"            local var_name "Citation Weighted Output"
105.         if "`yvar'" == "ppr_cnt"                 local var_name "Publication Count"
106.         if "`yvar'" == "ln_cite_affl_wt"         local var_name "Log Citation Weighted Output"
107.         if "`yvar'" == "ln_ppr_cnt"              local var_name "Log Publication Counts"
108.         if "`yvar'" == "cite_affl_wt_any"        local var_name "Citation Weighted Output (any position)"
109.         if "`yvar'" == "ppr_cnt_any"             local var_name "Publication Count (any position)"
110.         if "`yvar'" == "ln_cite_affl_wt_any"     local var_name "Log Citation Weighted Output (any position)"
111.         if "`yvar'" == "ln_ppr_cnt_any"          local var_name "Log Publication Counts (any position)"
112.         if "`yvar'" == "cite_affl_wt_notlast"    local var_name "Citation Weighted Output (non-last author)"
113.         if "`yvar'" == "ppr_cnt_notlast"         local var_name "Publication Count (non-last author)"
114.         if "`yvar'" == "ln_cite_affl_wt_notlast" local var_name "Log Citation Weighted Output (non-last author)"
115.         if "`yvar'" == "ln_ppr_cnt_notlast"      local var_name "Log Publication Counts (non-last author)"
116.         if "`yvar'" == "avg_num_coathrs"         local var_name "Avg Coauthors"
117.         if "`yvar'" == "n_grants"                local var_name "# Active NIH Research Grants"
118.         if "`yvar'" == "nih_total_cost"          local var_name "NIH Award Amount ($)"
119.         if "`yvar'" == "n_first_ppr"             local var_name "# First-Author Papers"
120.         if "`yvar'" == "n_middle_ppr"            local var_name "# Middle-Author Papers"
121.         if "`yvar'" == "n_last_ppr"              local var_name "# Last-Author Papers"
122.         if "`yvar'" == "avg_position"            local var_name "Avg Author Position"
123.         if "`yvar'" == "avg_position_rat"        local var_name "Avg Author Position Ratio"
124.         if "`yvar'" == "avg_team_size_last"      local var_name "Team Size (last-author papers)"
125.         if "`yvar'" == "avg_team_size_notlast"   local var_name "Team Size (non-last papers)"
126. 
.         // pdid FWL binscatter figures commented out; uncomment to reproduce.
.         /*
>         preserve
>             cap noi qui reghdfe `yvar' Z_share_it `wt', absorb(`fes') residuals(_y_r)
>             if _rc == 0 cap noi qui reghdfe Z_it Z_share_it `wt', absorb(`fes') residuals(_Z_r)
>             if _rc == 0 {
>                 local pds_b_str  : dis %7.3f `s_bx'
>                 local pds_se_str : dis %7.3f `s_sex'
>                 binscatter _y_r _Z_r `wt_bin', n(30) ///
>                     xtitle("Exposure x Post") ytitle("`var_name'") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                     note("{&beta} = `pds_b_str' (SE: `pds_se_str')") ///
>                     plotregion(margin(sides))
>                 graph export ../output/figures/`samp'/pdid_`yvar'`suf'_mshrctrl`wsuf'.pdf, replace
>             }
>             else di as error "pdid mshrctrl binscatter `yvar' failed; skipping plot."
>         restore
>         */
.     }
127. 
.     preserve
128.         clear
129.         svmat results
130.         rename (results1 results2 results3 results4 results5 results6 results7) ///
>                (b_base se_base b_exp_wshr se_exp_wshr b_shr_wshr se_shr_wshr pre_mean)
131.         gen outcome = ""
132.         local i = 1
133.         foreach yvar of local kept_outcomes {
134.             replace outcome = "`yvar'" if _n == `i'
135.             local ++i
136.         }
137.         order outcome b_base se_base b_exp_wshr se_exp_wshr b_shr_wshr se_shr_wshr pre_mean
138.         save ../temp/pooled_did_`samp'`suf'`wsuf', replace
139.         list, sep(0) noobs abbrev(20)
140.     restore
141. end

. 
. program ppml_specs
  1.     // ppmlhdfe analog of pooled_did; may drop separated obs or fail to converge (hence cap noi)
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local wt ""
 13.     local wsuf ""
 14.     if "$WEIGHT_MSIM" == "1" {
 15.         // ppmlhdfe rejects aw, binscatter rejects pw — mixing is fine, β identical
.         local wt "[pw=max_sim]"
 16.         local wt_bin "[aw=max_sim]"
 17.         local wsuf "_msimwt"
 18.     }
 19.     local suf ""
 20.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 21.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 22.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 23.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 24.     if (`no_clin' == 1) local suf "_no_clin`suf'"
 25.     use ../output/prepped_samples/es_`samp'`suf', clear
 26. 
.     gen post = year >= 2014
 27.     gen Z_it       = exposure      * post
 28.     gen Z_share_it = mkt_spend_shr * post
 29. 
.     // Mean-based POSITION metrics (avg_position, avg_team_size_*) excluded.
.     // avg_num_coathrs is deliberately kept: PPML is a valid pseudo-likelihood
.     // for any nonnegative outcome, and this mirrors the headline coauthor spec.
.     local position_outcomes ""
 30.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
 31.         local position_outcomes n_middle_ppr
 32.     }
 33.     local outcomes cite_affl_wt ppr_cnt ///
>                    cite_affl_wt_any ppr_cnt_any ///
>                    cite_affl_wt_notlast ppr_cnt_notlast ///
>                    avg_num_coathrs n_grants nih_total_cost ///
>                    `position_outcomes'
 34.     if "$QUICK_TOPJRNL" == "1" local outcomes ppr_cnt
 35. 
.     foreach yvar of local outcomes {
 36.         foreach v in _mu_b _mu_s _dvarb _dvars {
 37.             cap drop `v'
 38.         }
 39.         local b_b = .
 40.         local b_se = .
 41.         local b_N = .
 42.         local b_r2 = .
 43.         local b_pmn = .
 44.         local s_bx = .
 45.         local s_sex = .
 46.         local s_bs = .
 47.         local s_ses = .
 48.         local s_N = .
 49.         local s_r2 = .
 50.         local s_pmn = .
 51.         // Base (no share) only for ppr_cnt — feeds the rf_main "no share" column.
.         // d() + predict mu here so the FWL binscatters below reuse the fit
.         // instead of re-estimating.
.         if "`yvar'" == "ppr_cnt" {
 52.             cap noi ppmlhdfe `yvar' Z_it            `wt', absorb(`fes') vce(cluster `vce_cl') d(_dvarb)
 53.             local rc = _rc
 54.             if `rc' == 0 {
 55.                 local b_b  = _b[Z_it]
 56.                 local b_se = _se[Z_it]
 57.                 local b_N  = e(N)
 58.                 local b_r2 = e(r2_p)
 59.                 qui sum `yvar' if year < 2014 & e(sample)
 60.                 local b_pmn = r(mean)
 61.                 predict double _mu_b, mu
 62.             }
 63.             else di as error "ppml_pdid `yvar' base failed (rc=`rc')"
 64.         }
 65.         cap noi ppmlhdfe `yvar' Z_it Z_share_it `wt', absorb(`fes') vce(cluster `vce_cl') d(_dvars)
 66.         local rc = _rc
 67.         if `rc' == 0 {
 68.             local s_bx  = _b[Z_it]
 69.             local s_sex = _se[Z_it]
 70.             local s_bs  = _b[Z_share_it]
 71.             local s_ses = _se[Z_share_it]
 72.             local s_N   = e(N)
 73.             local s_r2  = e(r2_p)
 74.             qui sum `yvar' if year < 2014 & e(sample)
 75.             local s_pmn = r(mean)
 76.             predict double _mu_s, mu
 77.         }
 78.         else di as error "ppml_pdid `yvar' +share failed (rc=`rc')"
 79.         cap mat drop ppml_pdid_`yvar'
 80.         mat ppml_pdid_`yvar' = J(7,2,.)
 81.         mat ppml_pdid_`yvar'[1,1] = `b_b'
 82.         mat ppml_pdid_`yvar'[2,1] = `b_se'
 83.         mat ppml_pdid_`yvar'[5,1] = `b_pmn'
 84.         mat ppml_pdid_`yvar'[6,1] = `b_N'
 85.         mat ppml_pdid_`yvar'[7,1] = `b_r2'
 86.         mat ppml_pdid_`yvar'[1,2] = `s_bx'
 87.         mat ppml_pdid_`yvar'[2,2] = `s_sex'
 88.         mat ppml_pdid_`yvar'[3,2] = `s_bs'
 89.         mat ppml_pdid_`yvar'[4,2] = `s_ses'
 90.         mat ppml_pdid_`yvar'[5,2] = `s_pmn'
 91.         mat ppml_pdid_`yvar'[6,2] = `s_N'
 92.         mat ppml_pdid_`yvar'[7,2] = `s_r2'
 93.         mat rownames ppml_pdid_`yvar' = b_exposure se_exposure b_share se_share pre_mean N r2_p
 94.         mat colnames ppml_pdid_`yvar' = base with_share
 95. 
.         di as text "ppml_specs `samp'`suf' `yvar': pdid b=" %7.4f ppml_pdid_`yvar'[1,1] ///
>             "  pre_mean=" %7.4f `s_pmn'
 96. 
.         local var_name "`yvar'"
 97.         if "`yvar'" == "cite_affl_wt"         local var_name "Citation Weighted Output"
 98.         if "`yvar'" == "ppr_cnt"              local var_name "Publication Count"
 99.         if "`yvar'" == "affl_wt"              local var_name "Affiliation Weighted Output"
100.         if "`yvar'" == "cite_affl_wt_any"     local var_name "Citation Weighted Output (any position)"
101.         if "`yvar'" == "ppr_cnt_any"          local var_name "Publication Count (any position)"
102.         if "`yvar'" == "affl_wt_any"          local var_name "Affiliation Weighted Output (any position)"
103.         if "`yvar'" == "cite_affl_wt_notlast" local var_name "Citation Weighted Output (non-last author)"
104.         if "`yvar'" == "ppr_cnt_notlast"      local var_name "Publication Count (non-last author)"
105.         if "`yvar'" == "affl_wt_notlast"      local var_name "Affiliation Weighted Output (non-last author)"
106.         if "`yvar'" == "avg_num_coathrs"      local var_name "Avg Coauthors"
107.         if "`yvar'" == "n_grants"             local var_name "# Active NIH Research Grants"
108.         if "`yvar'" == "nih_total_cost"       local var_name "NIH Award Amount ($)"
109.         if "`yvar'" == "n_first_ppr"          local var_name "# First-Author Papers"
110.         if "`yvar'" == "n_middle_ppr"         local var_name "# Middle-Author Papers"
111.         if "`yvar'" == "n_last_ppr"           local var_name "# Last-Author Papers"
112.         local poisson_name "`var_name'"
113.         if "`yvar'" == "ppr_cnt"              local poisson_name "Publications"
114.         if "`yvar'" == "cite_affl_wt"         local poisson_name "Citation-Weighted Output"
115.         if "`yvar'" == "affl_wt"              local poisson_name "Affiliation-Weighted Output"
116.         if "`yvar'" == "ppr_cnt_any"          local poisson_name "Publications (any position)"
117.         if "`yvar'" == "cite_affl_wt_any"     local poisson_name "Citation-Weighted Output (any position)"
118.         if "`yvar'" == "affl_wt_any"          local poisson_name "Affiliation-Weighted Output (any position)"
119.         if "`yvar'" == "ppr_cnt_notlast"      local poisson_name "Publications (non-last author)"
120.         if "`yvar'" == "cite_affl_wt_notlast" local poisson_name "Citation-Weighted Output (non-last author)"
121.         if "`yvar'" == "affl_wt_notlast"      local poisson_name "Affiliation-Weighted Output (non-last author)"
122.         if "`yvar'" == "avg_num_coathrs"      local poisson_name "Coauthors"
123.         if "`yvar'" == "n_grants"             local poisson_name "Active NIH Research Grants"
124.         if "`yvar'" == "nih_total_cost"       local poisson_name "NIH Award Dollars"
125. 
.         // Base FWL binscatter only for ppr_cnt (mirrors the base ppmlhdfe gate above)
.         if "`yvar'" == "ppr_cnt" {
126.         preserve
127.             cap confirm variable _mu_b
128.             if _rc == 0 {
129.                 keep if !mi(_mu_b) & _mu_b > 0
130.                 gen double _z_work = ln(_mu_b) + (`yvar' - _mu_b)/_mu_b
131.                 gen double _fwlw = _mu_b
132.                 if "$WEIGHT_MSIM" == "1" replace _fwlw = _mu_b * max_sim
133.                 cap noi qui reghdfe _z_work [pw=_fwlw], absorb(`fes') residuals(_y_r)
134.                 if _rc == 0 cap noi qui reghdfe Z_it [pw=_fwlw], absorb(`fes') residuals(_Z_r)
135.                 * [F10]+flow: failure skips only THIS plot, not the rest of
.                 * the yvar iteration (was `continue', which also skipped the
.                 * mshrctrl binscatter below)
.                 if _rc {
136.                     di as error "ppml FWL `yvar' failed; skipping plot."
137.                 }
138.                 else {
139.                     local pb_str  : dis %7.3f ppml_pdid_`yvar'[1,1]
140.                     local pse_str : dis %7.3f ppml_pdid_`yvar'[2,1]
141.                     binscatter _y_r _Z_r [aw=_fwlw], n(30) ///
>                         xtitle("Exposure x Post") ///
>                         ytitle("{&Delta} Log Expected `poisson_name'") ///
>                         xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                         msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                         note("{&beta} = `pb_str' (SE: `pse_str')", size(small) pos(7) ring(1) justification(left)) ///
>                         plotregion(margin(sides))
142.                     graph export ../output/figures/`samp'/ppml_pdid_`yvar'`suf'`wsuf'.pdf, replace
143.                 }
144.             }
145.         restore
146.         }
147. 
.         preserve
148.             cap confirm variable _mu_s
149.             if _rc == 0 {
150.                 keep if !mi(_mu_s) & _mu_s > 0
151.                 gen double _z_work = ln(_mu_s) + (`yvar' - _mu_s)/_mu_s
152.                 gen double _fwlw = _mu_s
153.                 if "$WEIGHT_MSIM" == "1" replace _fwlw = _mu_s * max_sim
154.                 cap noi qui reghdfe _z_work Z_share_it [pw=_fwlw], absorb(`fes') residuals(_y_r)
155.                 if _rc == 0 cap noi qui reghdfe Z_it Z_share_it [pw=_fwlw], absorb(`fes') residuals(_Z_r)
156.                 if _rc {
157.                     di as error "ppml FWL mshrctrl `yvar' failed; skipping plot."
158.                 }
159.                 else {
160.                     local pbs_str  : dis %7.3f ppml_pdid_`yvar'[1,2]
161.                     local pses_str : dis %7.3f ppml_pdid_`yvar'[2,2]
162.                     binscatter _y_r _Z_r [aw=_fwlw], n(30) ///
>                         xtitle("Exposure x Post") ///
>                         ytitle("{&Delta} Log Expected `poisson_name'") ///
>                         xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                         msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                         note("{&beta} = `pbs_str' (SE: `pses_str')", size(small) pos(7) ring(1) justification(left)) ///
>                         plotregion(margin(sides))
163.                     graph export ../output/figures/`samp'/ppml_pdid_`yvar'`suf'_mshrctrl`wsuf'.pdf, replace
164.                 }
165.             }
166.         restore
167. 
.         // NIH-matched PIs only (RePORTER match with >=1 research award).
.         // n_grants / nih_total_cost already estimate on this sample by construction.
.         if !inlist("`yvar'", "n_grants", "nih_total_cost") {
168.         preserve
169.             keep if nih_athr == 1
170.             local n_b    = .
171.             local n_se   = .
172.             local n_N    = .
173.             local n_r2   = .
174.             local n_pmn  = .
175.             local ns_bx  = .
176.             local ns_sex = .
177.             local ns_bs  = .
178.             local ns_ses = .
179.             local ns_N   = .
180.             local ns_r2  = .
181.             local ns_pmn = .
182.             if "`yvar'" == "ppr_cnt" {
183.                 cap noi ppmlhdfe `yvar' Z_it `wt', absorb(`fes') vce(cluster `vce_cl')
184.                 if _rc == 0 {
185.                     local n_b   = _b[Z_it]
186.                     local n_se  = _se[Z_it]
187.                     local n_N   = e(N)
188.                     local n_r2  = e(r2_p)
189.                     qui sum `yvar' if year < 2014 & e(sample)
190.                     local n_pmn = r(mean)
191.                 }
192.                 else di as error "ppml_pdid `yvar' nih-only base failed"
193.             }
194.             foreach v in _mu_ns _dvarns {
195.                 cap drop `v'
196.             }
197.             // d() so the NIH-only FWL binscatter below can predict mu
.             cap noi ppmlhdfe `yvar' Z_it Z_share_it `wt', absorb(`fes') vce(cluster `vce_cl') d(_dvarns)
198.             if _rc == 0 {
199.                 local ns_bx  = _b[Z_it]
200.                 local ns_sex = _se[Z_it]
201.                 local ns_bs  = _b[Z_share_it]
202.                 local ns_ses = _se[Z_share_it]
203.                 local ns_N   = e(N)
204.                 local ns_r2  = e(r2_p)
205.                 qui sum `yvar' if year < 2014 & e(sample)
206.                 local ns_pmn = r(mean)
207.                 cap noi predict double _mu_ns, mu
208.                 if _rc di as error "ppml_pdid `yvar' nih-only: predict mu failed -- binscatter SKIPPED."
209.             }
210.             else di as error "ppml_pdid `yvar' nih-only +share failed"
211.             cap mat drop nih_ppml_`yvar'
212.             mat nih_ppml_`yvar' = J(7,2,.)
213.             mat nih_ppml_`yvar'[1,1] = `n_b'
214.             mat nih_ppml_`yvar'[2,1] = `n_se'
215.             mat nih_ppml_`yvar'[5,1] = `n_pmn'
216.             mat nih_ppml_`yvar'[6,1] = `n_N'
217.             mat nih_ppml_`yvar'[7,1] = `n_r2'
218.             mat nih_ppml_`yvar'[1,2] = `ns_bx'
219.             mat nih_ppml_`yvar'[2,2] = `ns_sex'
220.             mat nih_ppml_`yvar'[3,2] = `ns_bs'
221.             mat nih_ppml_`yvar'[4,2] = `ns_ses'
222.             mat nih_ppml_`yvar'[5,2] = `ns_pmn'
223.             mat nih_ppml_`yvar'[6,2] = `ns_N'
224.             mat nih_ppml_`yvar'[7,2] = `ns_r2'
225.             mat rownames nih_ppml_`yvar' = b_exposure se_exposure b_share se_share pre_mean N r2_p
226.             mat colnames nih_ppml_`yvar' = base with_share
227. 
.             qui gunique athr_id
228.             di as text "ppml_specs `samp'`suf' `yvar' (NIH-matched only, " r(unique) " PIs): pdid b=" ///
>                 %7.4f `ns_bx' "  pre_mean=" %7.4f `ns_pmn'
229. 
.             cap confirm variable _mu_ns
230.             if _rc == 0 {
231.                 keep if !mi(_mu_ns) & _mu_ns > 0
232.                 gen double _z_work = ln(_mu_ns) + (`yvar' - _mu_ns)/_mu_ns
233.                 gen double _fwlw = _mu_ns
234.                 if "$WEIGHT_MSIM" == "1" replace _fwlw = _mu_ns * max_sim
235.                 cap noi qui reghdfe _z_work Z_share_it [pw=_fwlw], absorb(`fes') residuals(_y_r)
236.                 if _rc == 0 cap noi qui reghdfe Z_it Z_share_it [pw=_fwlw], absorb(`fes') residuals(_Z_r)
237.                 if _rc {
238.                     di as error "ppml FWL nih-only `yvar' failed; skipping plot."
239.                 }
240.                 else {
241.                     local pbn_str  : dis %7.3f nih_ppml_`yvar'[1,2]
242.                     local psen_str : dis %7.3f nih_ppml_`yvar'[2,2]
243.                     binscatter _y_r _Z_r [aw=_fwlw], n(30) ///
>                         xtitle("Exposure x Post") ///
>                         ytitle("{&Delta} Log Expected `poisson_name'") ///
>                         xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                         msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                         title("NIH-matched PIs only", size(small)) ///
>                         note("{&beta} = `pbn_str' (SE: `psen_str')", size(small) pos(7) ring(1) justification(left)) ///
>                         plotregion(margin(sides))
244.                     graph export ../output/figures/`samp'/ppml_pdid_`yvar'`suf'_mshrctrl_nih`wsuf'.pdf, replace
245.                 }
246.             }
247.         restore
248.         }
249.     }
250. end

. 
. program placebo_treatment
  1.     // Fake-treatment placebo on year<=2013 subsample: β on Z_placebo should be ~0 if parallel trends hold
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     if (`no_clin' == 1) local suf "_no_clin`suf'"
 18. 
.     local outcomes ppr_cnt
 19. 
.     cap mkdir ../output/tables
 20.     cap mkdir ../output/tables/`samp'
 21.     cap mkdir ../output/figures/`samp'
 22. 
.     foreach placebo_yr in 2011 2012 {
 23.         use ../output/prepped_samples/es_`samp'`suf', clear
 24.         keep if year <= 2013     // strictly pre-treatment window
 25. 
.         gen placebo_post   = year >= `placebo_yr'
 26.         gen Z_placebo      = exposure      * placebo_post
 27.         gen Z_share_placebo = mkt_spend_shr * placebo_post
 28. 
.         foreach yvar of local outcomes {
 29.             local b     = .
 30.             local se    = .
 31.             local b_s   = .
 32.             local se_s  = .
 33.             local N     = .
 34.             local r2_p  = .
 35.             local pre_mean = .
 36.             cap noi ppmlhdfe `yvar' Z_placebo Z_share_placebo, ///
>                     absorb(`fes') vce(cluster `vce_cl')
 37.             local rc = _rc
 38.             if `rc' == 0 {
 39.                 local b    = _b[Z_placebo]
 40.                 local se   = _se[Z_placebo]
 41.                 local b_s  = _b[Z_share_placebo]
 42.                 local se_s = _se[Z_share_placebo]
 43.                 local N    = e(N)
 44.                 local r2_p = e(r2_p)
 45.                 qui sum `yvar' if year < `placebo_yr' & e(sample)
 46.                 local pre_mean = r(mean)
 47.             }
 48.             else di as error "placebo_treatment `yvar' (placebo=`placebo_yr') ppml failed (rc=`rc')"
 49. 
.             local t = cond(`se' > 0 & !mi(`se'), `b' / `se', .)
 50.             di as text "placebo_treatment `samp'`suf' `yvar' (placebo=`placebo_yr'):" ///
>                 _newline "    ppmlhdfe (+share)  b=" %8.4f `b'   "  se=" %8.4f `se'   "  t=" %6.2f `t' ///
>                 "  b_share=" %8.4f `b_s' "  se_share=" %8.4f `se_s' ///
>                 "  pre_mean=" %8.4f `pre_mean' "  N=" %8.0f `N'
 51. 
.             cap mat drop placebo`placebo_yr'_`yvar'
 52.             mat placebo`placebo_yr'_`yvar' = J(7,1,.)
 53.             mat placebo`placebo_yr'_`yvar'[1,1] = `b'
 54.             mat placebo`placebo_yr'_`yvar'[2,1] = `se'
 55.             mat placebo`placebo_yr'_`yvar'[3,1] = `b_s'
 56.             mat placebo`placebo_yr'_`yvar'[4,1] = `se_s'
 57.             mat placebo`placebo_yr'_`yvar'[5,1] = `pre_mean'
 58.             mat placebo`placebo_yr'_`yvar'[6,1] = `N'
 59.             mat placebo`placebo_yr'_`yvar'[7,1] = `r2_p'
 60.             mat rownames placebo`placebo_yr'_`yvar' = b_exp se_exp b_share se_share pre_mean N r2_p
 61.             mat colnames placebo`placebo_yr'_`yvar' = ppmlhdfe_wshr
 62.         }
 63.     }
 64. 
.     // Full-panel placebo ES: fake treatment year as omitted reference; real effect should still start at 2014 (dashed line)
.     foreach placebo_yr in 2011 2012 {
 65.         foreach yvar in ppr_cnt {
 66.             local poisson_name "Publications"
 67.             local ppml_ytit "Output-Cost Elasticity"
 68. 
.             use ../output/prepped_samples/es_`samp'`suf', clear
 69.             cap drop pl_rel pl_int_lead* pl_int_lag* pl_mshr_lead* pl_mshr_lag*
 70.             gen pl_rel = year - `placebo_yr'
 71.             qui sum pl_rel
 72.             local pl_abs_lag  = abs(r(max))
 73.             local pl_abs_lead = abs(r(min))
 74.             forval i = 1/`pl_abs_lead' {
 75.                 gen pl_int_lead`i'  = exposure      if pl_rel == -`i'
 76.                 gen pl_mshr_lead`i' = mkt_spend_shr if pl_rel == -`i'
 77.             }
 78.             forval i = 0/`pl_abs_lag' {
 79.                 gen pl_int_lag`i'  = exposure      if pl_rel == `i'
 80.                 gen pl_mshr_lag`i' = mkt_spend_shr if pl_rel == `i'
 81.             }
 82.             ds pl_int_lead* pl_int_lag* pl_mshr_lead* pl_mshr_lag*
 83.             foreach v in `r(varlist)' {
 84.                 replace `v' = 0 if mi(`v')
 85.             }
 86.             local pl_int_leads
 87.             local pl_int_lags
 88.             local pl_mshr_leads
 89.             local pl_mshr_lags
 90.             forval i = 2/`pl_abs_lead' {
 91.                 local pl_int_leads  pl_int_lead`i'  `pl_int_leads'
 92.                 local pl_mshr_leads pl_mshr_lead`i' `pl_mshr_leads'
 93.             }
 94.             forval i = 0/`pl_abs_lag' {
 95.                 local pl_int_lags  `pl_int_lags'  pl_int_lag`i'
 96.                 local pl_mshr_lags `pl_mshr_lags' pl_mshr_lag`i'
 97.             }
 98. 
.             // pl_int_lead1 / pl_mshr_lead1 are the omitted reference — excluded so rel=-1 stays the reference year
.             cap noi ppmlhdfe `yvar' `pl_int_leads' `pl_int_lags' ///
>                                     `pl_mshr_leads' `pl_mshr_lags', ///
>                     absorb(`fes') vce(cluster `vce_cl')
 99.             local rc = _rc
100.             if `rc' {
101.                 di as error "placebo ES ppmlhdfe `yvar' yr`placebo_yr' failed (rc=`rc'); skipping."
102.                 continue
103.             }
104. 
.             preserve
105.             cap mat drop es
106.             foreach var in `pl_int_leads' `pl_int_lags' pl_int_lead1 {
107.                 if "`var'" == "pl_int_lead1" {
108.                     mat row = 0,0
109.                 }
110.                 else {
111.                     mat row = _b[`var'], _se[`var']
112.                 }
113.                 mat es = nullmat(es) \ row
114.             }
115.             svmat es
116.             keep es1 es2
117.             drop if mi(es1)
118.             rename (es1 es2) (b se)
119.             gen ub = b + 1.96*se
120.             gen lb = b - 1.96*se
121.             gen rel = -`pl_abs_lead' if _n == 1
122.             replace rel = rel[_n-1]+1 if _n > 1
123.             replace rel = rel + 1 if rel >= -1
124.             replace rel = -1 if rel == `pl_abs_lag' + 1
125.             gen year = rel + `placebo_yr'
126.             hashsort rel
127.             sum ub, d
128.             local ymax = round(r(max), 0.1)
129.             sum lb, d
130.             local ymin = round(r(min), 0.1)
131.             if `ymin' > 0 local ymin = 0
132.             local ref_yr = `placebo_yr' - 1
133.             tw rcap ub lb year if year != `ref_yr', lcolor(dkorange%70) msize(vsmall) || ///
>               scatter b year, mcolor(dkorange) ///
>               , xlab(2010(1)2019) xtitle("Year (placebo treatment at `placebo_yr')") ///
>                 ytitle("`ppml_ytit'") ///
>                 ylab(`ymin'(0.1)`ymax') yline(0, lcolor(gs10) lpattern(solid)) ///
>                 xline(2014, lpattern(dash) lcolor(gs10)) ///
>                 title("Placebo ES: treatment shifted to `placebo_yr' (real: 2014)", size(small)) ///
>                 legend(off) plotregion(margin(sides))
134.             graph export ../output/figures/`samp'/placebo_es_`yvar'_yr`placebo_yr'`suf'.pdf, replace
135.             save ../temp/placebo_es_`yvar'_yr`placebo_yr'`suf', replace
136.             restore
137.         }
138.     }
139. end

. 
. program trim_top
  1.     // Composition check: drop top {1,5,10,25}% of PIs by pre_ppr_cnt_sum, re-estimate.
.     // [F3] trim=0 (full sample) is estimated here too, with the SAME
.     // with-share spec, so the sensitivity figures have a comparable baseline.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     if (`no_clin' == 1) local suf "_no_clin`suf'"
 18. 
.     local outcomes ppr_cnt
 19.     local trims 0 1 5 10 25
 20. 
.     cap mkdir ../output/tables/`samp'
 21.     cap mkdir ../output/figures/`samp'
 22. 
.     foreach trim of local trims {
 23.         use ../output/prepped_samples/es_`samp'`suf', clear
 24.         qui gunique athr_id
 25.         local n_pre = r(unique)
 26.         if `trim' > 0 {
 27.             bys athr_id: gen _one = _n == 1
 28.             local p = 100 - `trim'
 29.             qui _pctile pre_ppr_cnt_sum if _one == 1, p(`p')
 30.             local cut = r(r1)
 31.             drop if pre_ppr_cnt_sum > `cut'
 32.             drop _one
 33.             qui gunique athr_id
 34.             local n_post = r(unique)
 35.             di as text "trim_top `samp'`suf' trim=`trim'%: cut=" %7.2f `cut' ///
>                 "  PIs dropped " (`n_pre' - `n_post') " / `n_pre' (kept " %7.4f (`n_post' / `n_pre') ")"
 36.         }
 37.         else {
 38.             local n_post = `n_pre'
 39.             di as text "trim_top `samp'`suf' trim=0: full sample, N PIs = `n_post'"
 40.         }
 41. 
.         gen post       = year >= 2014
 42.         gen Z_it       = exposure      * post
 43.         gen Z_share_it = mkt_spend_shr * post
 44. 
.         foreach yvar of local outcomes {
 45.             local lb = .
 46.             local lse = .
 47.             local lN = .
 48.             local l_pmn = .
 49.             cap noi reghdfe `yvar' Z_it Z_share_it, absorb(`fes') vce(cluster `vce_cl')
 50.             if _rc == 0 {
 51.                 local lb  = _b[Z_it]
 52.                 local lse = _se[Z_it]
 53.                 local lN  = e(N)
 54.                 qui sum `yvar' if year < 2014 & e(sample)
 55.                 local l_pmn = r(mean)
 56.             }
 57. 
.             local pb = .
 58.             local pse = .
 59.             local pN = .
 60.             local p_pmn = .
 61.             cap noi ppmlhdfe `yvar' Z_it Z_share_it, absorb(`fes') vce(cluster `vce_cl')
 62.             if _rc == 0 {
 63.                 local pb  = _b[Z_it]
 64.                 local pse = _se[Z_it]
 65.                 local pN  = e(N)
 66.                 qui sum `yvar' if year < 2014 & e(sample)
 67.                 local p_pmn = r(mean)
 68.             }
 69. 
.             di as text "  trim=`trim'% `yvar': reghdfe b=" %8.4f `lb' "  se=" %8.4f `lse' ///
>                 "    ppml b=" %8.4f `pb' "  se=" %8.4f `pse' "    pre_mean=" %7.4f `l_pmn'
 70. 
.             cap mat drop trim`trim'_`yvar'
 71.             mat trim`trim'_`yvar' = J(5,2,.)
 72.             mat trim`trim'_`yvar'[1,1] = `lb'
 73.             mat trim`trim'_`yvar'[2,1] = `lse'
 74.             mat trim`trim'_`yvar'[3,1] = `l_pmn'
 75.             mat trim`trim'_`yvar'[4,1] = `lN'
 76.             mat trim`trim'_`yvar'[5,1] = `n_post'
 77.             mat trim`trim'_`yvar'[1,2] = `pb'
 78.             mat trim`trim'_`yvar'[2,2] = `pse'
 79.             mat trim`trim'_`yvar'[3,2] = `p_pmn'
 80.             mat trim`trim'_`yvar'[4,2] = `pN'
 81.             mat trim`trim'_`yvar'[5,2] = `n_post'
 82.             mat rownames trim`trim'_`yvar' = b se pre_mean N n_PIs
 83.             mat colnames trim`trim'_`yvar' = reghdfe ppmlhdfe
 84.         }
 85.     }
 86. 
.     foreach yvar in ppr_cnt {
 87.         local var_name "Publication Count"
 88.         local poisson_name "Publications"
 89.         local ppml_ytit "Output-Cost Elasticity"
 90. 
.         * [F3] both figures read trim`t' matrices only — baseline (trim=0) is
.         * now the same with-share spec as every trimmed point.
.         preserve
 91.         clear
 92.         set obs 5
 93.         gen trim = .
 94.         gen b  = .
 95.         gen se = .
 96.         local i = 1
 97.         foreach t of local trims {
 98.             replace trim = `t' in `i'
 99.             cap confirm matrix trim`t'_`yvar'
100.             if !_rc {
101.                 replace b  = trim`t'_`yvar'[1,1] in `i'
102.                 replace se = trim`t'_`yvar'[2,1] in `i'
103.             }
104.             local ++i
105.         }
106.         gen ub = b + 1.96*se
107.         gen lb = b - 1.96*se
108.         tw rcap ub lb trim, lcolor(ebblue%70) msize(small) || ///
>            scatter b trim, mcolor(ebblue) msize(medium) ///
>            , xlab(0 "Full sample" 1 "Drop top 1%" 5 "5%" 10 "10%" 25 "25%", labsize(small)) ///
>              xtitle("Top-pre-pub PIs dropped") ///
>              ytitle("pdid {&beta}: `var_name'") ///
>              yline(0, lcolor(gs10) lpattern(solid)) ///
>              title("Trim-top sensitivity: `var_name'", size(small)) ///
>              legend(off) plotregion(margin(sides))
109.         graph export ../output/figures/`samp'/trim_top_`yvar'`suf'.pdf, replace
110.         restore
111. 
.         preserve
112.         clear
113.         set obs 5
114.         gen trim = .
115.         gen b  = .
116.         gen se = .
117.         local i = 1
118.         foreach t of local trims {
119.             replace trim = `t' in `i'
120.             cap confirm matrix trim`t'_`yvar'
121.             if !_rc {
122.                 replace b  = trim`t'_`yvar'[1,2] in `i'
123.                 replace se = trim`t'_`yvar'[2,2] in `i'
124.             }
125.             local ++i
126.         }
127.         gen ub = b + 1.96*se
128.         gen lb = b - 1.96*se
129.         tw rcap ub lb trim, lcolor(dkorange%70) msize(small) || ///
>            scatter b trim, mcolor(dkorange) msize(medium) ///
>            , xlab(0 "Full sample" 1 "Drop top 1%" 5 "5%" 10 "10%" 25 "25%", labsize(small)) ///
>              xtitle("Top-pre-pub PIs dropped") ///
>              ytitle("`ppml_ytit'") ///
>              yline(0, lcolor(gs10) lpattern(solid)) ///
>              title("Trim-top sensitivity (ppml): `var_name'", size(small)) ///
>              legend(off) plotregion(margin(sides))
130.         graph export ../output/figures/`samp'/trim_top_ppml_`yvar'`suf'.pdf, replace
131.         restore
132.     }
133. end

. 
. program joint_outcome_test
  1.     // H0: β_ppr = β_cite, tested three ways (log, y/pre-mean, ppml semi-elasticity)
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) no_clin(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     if (`no_clin' == 1) local suf "_no_clin`suf'"
  8.     use ../output/prepped_samples/es_`samp'`suf', clear
  9. 
.     foreach v in cite_affl_wt ppr_cnt {
 10.         cap gen ln_`v' = ln(1+`v')
 11.     }
 12. 
.     gen post = year >= 2014
 13.     gen Z_it = exposure * post
 14.     gen Z_share_it = mkt_spend_shr * post
 15. 
.     qui sum ppr_cnt      if year < 2014
 16.     local mean_ppr = r(mean)
 17.     qui sum cite_affl_wt if year < 2014
 18.     local mean_cite = r(mean)
 19. 
.     keep athr_id year Z_it Z_share_it ppr_cnt cite_affl_wt ln_ppr_cnt ln_cite_affl_wt
 20. 
.     preserve
 21.         gen outcome = 1
 22.         gen y_raw = cite_affl_wt
 23.         gen y_ln  = ln_cite_affl_wt
 24.         gen y_nrm = cite_affl_wt / `mean_cite'
 25.         keep athr_id year Z_it Z_share_it outcome y_raw y_ln y_nrm
 26.         save ../temp/stack_cite_`samp'`suf', replace
 27.     restore
 28.     gen outcome = 0
 29.     gen y_raw = ppr_cnt
 30.     gen y_ln  = ln_ppr_cnt
 31.     gen y_nrm = ppr_cnt / `mean_ppr'
 32.     keep athr_id year Z_it Z_share_it outcome y_raw y_ln y_nrm
 33.     append using ../temp/stack_cite_`samp'`suf'
 34. 
.     egen athr_outcome = group(athr_id outcome)
 35.     egen year_outcome = group(year outcome)
 36.     gen Z_it_cite = Z_it * (outcome == 1)
 37.     gen Z_share_it_cite = Z_share_it * (outcome == 1)
 38. 
.     cap mat drop joint_`samp'`suf'
 39.     mat joint_`samp'`suf' = J(8,3,.)
 40.     mat rownames joint_`samp'`suf' = b_ppr se_ppr b_cite se_cite b_diff se_diff Wald_F p_value
 41.     mat colnames joint_`samp'`suf' = log norm_levels ppml
 42. 
.     reghdfe y_ln Z_it Z_it_cite Z_share_it Z_share_it_cite, absorb(athr_outcome year_outcome) vce(cluster athr_id)
 43.     local b_ppr_ln  = _b[Z_it]
 44.     local se_ppr_ln = _se[Z_it]
 45.     local b_diff_ln = _b[Z_it_cite]
 46.     local se_diff_ln = _se[Z_it_cite]
 47.     qui lincom Z_it + Z_it_cite
 48.     local b_cite_ln  = r(estimate)
 49.     local se_cite_ln = r(se)
 50.     qui test Z_it_cite
 51.     local F_ln = r(F)
 52.     local p_ln = r(p)
 53.     mat joint_`samp'`suf'[1,1] = `b_ppr_ln'
 54.     mat joint_`samp'`suf'[2,1] = `se_ppr_ln'
 55.     mat joint_`samp'`suf'[3,1] = `b_cite_ln'
 56.     mat joint_`samp'`suf'[4,1] = `se_cite_ln'
 57.     mat joint_`samp'`suf'[5,1] = `b_diff_ln'
 58.     mat joint_`samp'`suf'[6,1] = `se_diff_ln'
 59.     mat joint_`samp'`suf'[7,1] = `F_ln'
 60.     mat joint_`samp'`suf'[8,1] = `p_ln'
 61. 
.     reghdfe y_nrm Z_it Z_it_cite Z_share_it Z_share_it_cite, absorb(athr_outcome year_outcome) vce(cluster athr_id)
 62.     local b_ppr_nr  = _b[Z_it]
 63.     local se_ppr_nr = _se[Z_it]
 64.     local b_diff_nr = _b[Z_it_cite]
 65.     local se_diff_nr = _se[Z_it_cite]
 66.     qui lincom Z_it + Z_it_cite
 67.     local b_cite_nr  = r(estimate)
 68.     local se_cite_nr = r(se)
 69.     qui test Z_it_cite
 70.     local F_nr = r(F)
 71.     local p_nr = r(p)
 72.     mat joint_`samp'`suf'[1,2] = `b_ppr_nr'
 73.     mat joint_`samp'`suf'[2,2] = `se_ppr_nr'
 74.     mat joint_`samp'`suf'[3,2] = `b_cite_nr'
 75.     mat joint_`samp'`suf'[4,2] = `se_cite_nr'
 76.     mat joint_`samp'`suf'[5,2] = `b_diff_nr'
 77.     mat joint_`samp'`suf'[6,2] = `se_diff_nr'
 78.     mat joint_`samp'`suf'[7,2] = `F_nr'
 79.     mat joint_`samp'`suf'[8,2] = `p_nr'
 80. 
.     local b_ppr_pp = .
 81.     local se_ppr_pp = .
 82.     local b_cite_pp = .
 83.     local se_cite_pp = .
 84.     local b_diff_pp = .
 85.     local se_diff_pp = .
 86.     local F_pp = .
 87.     local p_pp = .
 88.     cap noi ppmlhdfe y_raw Z_it Z_it_cite Z_share_it Z_share_it_cite, absorb(athr_outcome year_outcome) vce(cluster athr_id)
 89.     local rc = _rc
 90.     if `rc' == 0 {
 91.         local b_ppr_pp  = _b[Z_it]
 92.         local se_ppr_pp = _se[Z_it]
 93.         local b_diff_pp = _b[Z_it_cite]
 94.         local se_diff_pp = _se[Z_it_cite]
 95.         qui lincom Z_it + Z_it_cite
 96.         local b_cite_pp  = r(estimate)
 97.         local se_cite_pp = r(se)
 98.         qui test Z_it_cite
 99.         local F_pp = r(F)
100.         local p_pp = r(p)
101.     }
102.     else di as error "joint_outcome_test ppml failed (rc=`rc'); ppml column left missing."
103.     mat joint_`samp'`suf'[1,3] = `b_ppr_pp'
104.     mat joint_`samp'`suf'[2,3] = `se_ppr_pp'
105.     mat joint_`samp'`suf'[3,3] = `b_cite_pp'
106.     mat joint_`samp'`suf'[4,3] = `se_cite_pp'
107.     mat joint_`samp'`suf'[5,3] = `b_diff_pp'
108.     mat joint_`samp'`suf'[6,3] = `se_diff_pp'
109.     mat joint_`samp'`suf'[7,3] = `F_pp'
110.     mat joint_`samp'`suf'[8,3] = `p_pp'
111. 
.     di as text "joint outcome test `samp'`suf':  H0 beta_ppr = beta_cite (same H0 in three flavors)"
112.     di as text "  --- log      : β_ln_ppr    = " %9.4f `b_ppr_ln'  "  β_ln_cite    = " %9.4f `b_cite_ln'  "  diff = " %9.4f `b_diff_ln'  "  F = " %9.4f `F_ln'  "  p = " %9.4f `p_ln'
113.     di as text "  --- norm lvl : β_ppr/mean  = " %9.4f `b_ppr_nr'  "  β_cite/mean  = " %9.4f `b_cite_nr'  "  diff = " %9.4f `b_diff_nr'  "  F = " %9.4f `F_nr'  "  p = " %9.4f `p_nr'
114.     di as text "  --- ppml     : β_ppr (sel) = " %9.4f `b_ppr_pp'  "  β_cite (sel) = " %9.4f `b_cite_pp'  "  diff = " %9.4f `b_diff_pp'  "  F = " %9.4f `F_pp'  "  p = " %9.4f `p_pp'
115. 
.     cap mkdir ../output/tables
116.     cap mkdir ../output/tables/`samp'
117.     qui matrix_to_txt, saving("../output/tables/`samp'/joint_outcome_test`suf'.txt") ///
>         matrix(joint_`samp'`suf') title(<tab:joint_outcome_test`suf'>) format(%20.4f) replace
118. end

