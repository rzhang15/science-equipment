. *---- 5) PPML on subsets to see who drives the 2016 spike -------------------
> -*
. qui sum rel

. local abs_lead = abs(r(min))

. local abs_lag  = r(max)

. forval i = 1/`abs_lag' {
  2.     gen int_lag`i' = exposure if rel == `i'
  3.     replace int_lag`i' = 0 if mi(int_lag`i')
  4. }
(63,522 missing values generated)
(63,522 real changes made)
(63,522 missing values generated)
(63,522 real changes made)
(63,522 missing values generated)
(63,522 real changes made)
(63,522 missing values generated)
(63,522 real changes made)
(63,522 missing values generated)
(63,522 real changes made)

. forval i = 1/`abs_lead' {
  2.     gen int_lead`i' = exposure if rel == -`i'
  3.     replace int_lead`i' = 0 if mi(int_lead`i')
  4. }
(63,522 missing values generated)
(63,522 real changes made)
(63,522 missing values generated)
(63,522 real changes made)
(63,522 missing values generated)
(63,522 real changes made)
(63,522 missing values generated)
(63,522 real changes made)

. gen int_lag0 = exposure if rel == 0
(63,522 missing values generated)

. replace int_lag0 = 0 if mi(int_lag0)
(63,522 real changes made)

. local ileads

. local ilags

. forval i = 2/`abs_lead' {
  2.     local ileads int_lead`i' `ileads'
  3. }

. forval i = 0/`abs_lag' {
  2.     local ilags `ilags' int_lag`i'
  3. }

. 
