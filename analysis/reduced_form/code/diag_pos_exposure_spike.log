. local ileads

. local ilags

. local mleads

. local mlags

. forval i = 2/`abs_lead' {
  2.     local ileads int_lead`i'  `ileads'
  3.     local mleads mshr_lead`i' `mleads'
  4. }

. forval i = 0/`abs_lag' {
  2.     local ilags  `ilags'  int_lag`i'
  3.     local mlags  `mlags'  mshr_lag`i'
  4. }

