. di as text _newline "======= 4) ppmlhdfe on full sample vs positive exposure 
> ======="

======= 4) ppmlhdfe on full sample vs positive exposure =======

. gen rel = year - 2014

. qui sum rel

. local abs_lead = abs(r(min))

. local abs_lag  = r(max)

. forval i = 1/`abs_lag' {
  2.     gen int_lag`i'  = exposure      if rel == `i'
  3.     gen mshr_lag`i' = mkt_spend_shr if rel == `i'
  4.     replace int_lag`i'  = 0 if mi(int_lag`i')
  5.     replace mshr_lag`i' = 0 if mi(mshr_lag`i')
  6. }
