. //------------------------------------------------------------------
. // 2. Build event-time interactions (mirror event_study exactly)
. //------------------------------------------------------------------
. gen rel = year - 2014

. qui sum rel

. local abs_lead = abs(r(min))

. local abs_lag  = abs(r(max))

. forval i = 1/`abs_lead' {
  2.     gen int_lead`i'  = exposure       * (rel == -`i')
  3.     gen mshr_lead`i' = mkt_spend_shr  * (rel == -`i')
  4. }

. forval i = 0/`abs_lag' {
  2.     gen int_lag`i'  = exposure       * (rel == `i')
  3.     gen mshr_lag`i' = mkt_spend_shr  * (rel == `i')
  4. }

. local int_leads

. local mshr_leads

. forval i = 2/`abs_lead' {
  2.     local int_leads  int_lead`i'  `int_leads'
  3.     local mshr_leads mshr_lead`i' `mshr_leads'
  4. }

. local int_lags

. local mshr_lags

. forval i = 0/`abs_lag' {
  2.     local int_lags  `int_lags'  int_lag`i'
  3.     local mshr_lags `mshr_lags' mshr_lag`i'
  4. }

. 
. //------------------------------------------------------------------
. // 3. Per-year collinearity of int_lag_k and mshr_lag_k over the panel
. //------------------------------------------------------------------
. di as text _newline "=== PER-YEAR CORR(int_lag_k, mshr_lag_k) OVER FULL PANEL ==="

=== PER-YEAR CORR(int_lag_k, mshr_lag_k) OVER FULL PANEL ===

. forval i = 0/`abs_lag' {
  2.     qui corr int_lag`i' mshr_lag`i'
  3.     di as text "  rel=`i' (year=`=`i'+2014'):  corr = " %6.4f r(rho)
  4. }
  rel=0 (year=2014):  corr = 0.8274
