  rel=3 (year=2017):  corr = 0.8274
  rel=4 (year=2018):  corr = 0.8274
  rel=5 (year=2019):  corr = 0.8274

. 
. //------------------------------------------------------------------
. // 4. Coefficient sensitivity per year: base vs +mshr controls
. //------------------------------------------------------------------
. foreach yvar in cite_affl_wt ppr_cnt {
  2.     di as text _newline "=== `yvar': PER-YEAR SENSITIVITY TO ADDING mshr CONTROLS ==="
  3. 
.     qui reghdfe `yvar' `int_leads' `int_lags' int_lead1, ///
>                 absorb(athr_id year) vce(cluster athr_id)
  4.     forval i = 0/`abs_lag' {
  5.         local b_base_`i'  = _b[int_lag`i']
  6.         local se_base_`i' = _se[int_lag`i']
  7.     }
  8.     // partial R^2 numerator (SSE_base)
.     local sse_base = e(rss)
  9. 
.     qui reghdfe `yvar' `int_leads' `int_lags' int_lead1 ///
>                        `mshr_leads' `mshr_lags' mshr_lead1, ///
>                 absorb(athr_id year) vce(cluster athr_id)
 10.     forval i = 0/`abs_lag' {
 11.         local b_ctrl_`i'  = _b[int_lag`i']
 12.         local se_ctrl_`i' = _se[int_lag`i']
 13.         local mb_`i'      = _b[mshr_lag`i']
 14.         local mse_`i'     = _se[mshr_lag`i']
 15.     }
 16. 
.     di as text " rel  yr    b_base    se_base    b_ctrl    se_ctrl   Δb/base     mshr_b    mshr_se   se_ratio"
 17.     forval i = 0/`abs_lag' {
 18.         local yr = `i' + 2014
 19.         local delta_pct = ((`b_ctrl_`i'' - `b_base_`i'') / `b_base_`i'') * 100
 20.         local se_ratio  = `se_ctrl_`i'' / `se_base_`i''
 21.         di as text " " %2.0f `i' "  " %4.0f `yr' ///
>             "  " %8.4f `b_base_`i''  "  " %8.4f `se_base_`i'' ///
>             "  " %8.4f `b_ctrl_`i''  "  " %8.4f `se_ctrl_`i'' ///
>             "  " %7.1f `delta_pct' " %" ///
>             "  " %8.4f `mb_`i''      "  " %8.4f `mse_`i'' ///
>             "  " %5.2f `se_ratio' "x"
 22.     }
 23. }

