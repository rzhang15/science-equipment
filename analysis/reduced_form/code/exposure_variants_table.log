. 
. * Panel B: number of nearest FOIA PIs used in the imputation (baseline k = 3)
> .
. * Imputed PIs take exposure and S_i from the _cf_k`k' file; FOIA PIs keep obs
> erved values.
. mat expk = J(9,5,.)

. forval k = 1/5 {
  2.     import delimited "../external/exposure/final_imputed_shift_share_hc_al
> l3_cf_k`k'.csv", clear
  3.     keep athr_id exposure_ss sum_imputed_shares
  4.     save ../temp/exposure_k`k', replace
  5. 
.     use ../output/prepped_samples/es_`samp'`suf', clear
  6.     merge m:1 athr_id using ../temp/exposure_k`k', keep(1 3)
  7.     keep if foia_athr == 1 | _merge == 3
  8.     replace exposure      = exposure_ss        if foia_athr != 1
  9.     replace mkt_spend_shr = sum_imputed_shares if foia_athr != 1
 10.     drop _merge exposure_ss sum_imputed_shares
 11.     gen post  = year >= 2014
 12.     gen Z_it  = exposure      * post
 13.     gen Zs_it = mkt_spend_shr * post
 14. 
.     ppmlhdfe ppr_cnt Z_it Zs_it, absorb(athr_id year) vce(cluster athr_id)
 15.     mat expk[1,`k'] = _b[Z_it]
 16.     mat expk[2,`k'] = _se[Z_it]
 17.     local b = _b[Z_it]
 18.     qui sum exposure if e(sample)
 19.     local xbar = r(mean)
 20.     qui sum ppr_cnt if year < 2014 & e(sample)
 21.     mat expk[5,`k'] = 100 * (1 - exp(`b'*`xbar'))
 22.     mat expk[6,`k'] = r(mean)
 23.     mat expk[7,`k'] = e(N)
 24.     mat expk[8,`k'] = `xbar'
 25. 
.     ppmlhdfe ppr_cnt Z_it, absorb(athr_id year) vce(cluster athr_id)
 26.     mat expk[3,`k'] = _b[Z_it]
 27.     mat expk[4,`k'] = _se[Z_it]
 28.     mat expk[9,`k'] = e(N)
 29. }
