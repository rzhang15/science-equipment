. matrix_to_txt, saving("../output/tables/`samp'/robustness/exposure_variants_k
> `suf'.txt") ///
>     matrix(expk) title(<tab:exposure_variants_k`suf'>) format(%20.4f) replace
(file ../output/tables/all_jrnls/robustness/exposure_variants_k_r1_r2.txt not
    found)

. 
. forval c = 1/5 {
  2.     foreach p in w n {
  3.         local r  = cond("`p'" == "w", 1, 3)
  4.         local b  = expvar[`r',`c']
  5.         local se = expvar[`r'+1,`c']
  6.         if `b' == . {
  7.             local b`p'`c' ""
  8.             continue
  9.         }
 10.         local t  = abs(`b'/`se')
 11.         local st`p'`c' = cond(`t' >= 2.576, "^{***}", cond(`t' >= 1.960, "
> ^{**}", cond(`t' >= 1.645, "^{*}", "")))
 12.         local b`p'`c'  = trim(string(`b', "%6.3f"))
 13.         local se`p'`c' = trim(string(`se', "%6.3f"))
 14.     }
 15.     local dc`c' = trim(string(expvar[5,`c'], "%4.1f"))
 16.     local pm`c' = trim(string(expvar[6,`c'], "%5.2f"))
 17.     local nn`c' = subinstr(trim(string(expvar[7,`c'], "%12.0fc")), ",", "{
> ,}", .)
 18. }

. forval k = 1/5 {
  2.     foreach p in w n {
  3.         local r  = cond("`p'" == "w", 1, 3)
  4.         local b  = expk[`r',`k']
  5.         local se = expk[`r'+1,`k']
  6.         local t  = abs(`b'/`se')
  7.         local kst`p'`k' = cond(`t' >= 2.576, "^{***}", cond(`t' >= 1.960, 
> "^{**}", cond(`t' >= 1.645, "^{*}", "")))
  8.         local kb`p'`k'  = trim(string(`b', "%6.3f"))
  9.         local kse`p'`k' = trim(string(`se', "%6.3f"))
 10.     }
 11.     local kdc`k' = trim(string(expk[5,`k'], "%4.1f"))
 12.     local kpm`k' = trim(string(expk[6,`k'], "%5.2f"))
 13.     local knn`k' = subinstr(trim(string(expk[7,`k'], "%12.0fc")), ",", "{,
> }", .)
 14. }

. 
. local out ../output/tables/`samp'/robustness/rf_exposure_variants`suf'.tex

