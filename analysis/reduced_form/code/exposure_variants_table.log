> \" _n

. file write `fh' " &          & shares       & exposure & weighted   & similar
> ity \\" _n

. file write `fh' "\midrule" _n

. file write `fh' "\multicolumn{6}{l}{\textit{Panel A: Exposure construction}} 
> \\[2pt]" _n

. file write `fh' "\multicolumn{6}{l}{\textit{Post \$\times\$ Exposure}} \\[2pt
> ]" _n

. file write `fh' "\quad With \$S_i\$ control   & \$\RFCoef`stw1'`d' & \$`bw2'`
> stw2'`d' & \$`bw3'`stw3'`d' & \$`bw4'`stw4'`d' & \$`bw5'`stw5'`d' \\" _n

. file write `fh' "                          & \$(\RFCoefSd)\$ & \$(`sew2')\$ &
>  \$(`sew3')\$ & \$(`sew4')\$ & \$(`sew5')\$ \\" _n

. file write `fh' "\quad No \$S_i\$ control     & \$\RFCoefRaw`stn1'`d' & --- &
>  \$`bn3'`stn3'`d' & \$`bn4'`stn4'`d' & \$`bn5'`stn5'`d' \\" _n

. file write `fh' "                          & \$(\RFCoefRawSd)\$ &  & \$(`sen3
> ')\$ & \$(`sen4')\$ & \$(`sen5')\$ \\" _n

. file write `fh' "\addlinespace" _n

. file write `fh' "Implied output decline (\%) & \OutputDecline & `dc2' & `dc3'
