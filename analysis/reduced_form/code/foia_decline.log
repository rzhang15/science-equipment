. do foia_decline.do 

. set more off

. clear all

. capture log close

. program drop _all

. set scheme modern

. preliminaries

. version 17

. 
. * Publication decline for the FOIA PIs that survive into es_all_jrnls_r1_r2.
. *
. * ATTRITION_CUT drops PIs whose LAST last-author paper ever is before that year.
. * max_year runs past the 2010-2019 estimation window (out to 2025), so the gate
. * uses post-window information and does not select on the in-window outcome.
. * 0 = keep everyone.
. * FOIA PIs carry observed (non-imputed) exposure, so this is invariant to the
. * EXPOSURE_FILTER the prepped sample was built under. The full-sample beta
. * reported alongside is NOT: it needs a real (non-placebo) prepped sample.
. 
. global ATTRITION_CUT 2020

. 
. program main
  1.     build_panels
  2.     attrition_sensitivity
  3.     estimate_betas
  4.     author_level_decline
  5.     decline_scatter
  6. end

. 
. program build_panels
  1.     use ../output/prepped_samples/es_all_jrnls_r1_r2, clear
  2.     gen post = year >= 2014
  3.     gen Z_it       = exposure      * post
  4.     gen Z_share_it = mkt_spend_shr * post
  5.     save ../temp/foia_decline_full_all, replace
  6.     apply_attrition
  7.     save ../temp/foia_decline_full, replace
  8. 
.     use ../temp/foia_decline_full_all, clear
  9.     keep if foia_athr == 1
 10.     save ../temp/foia_decline_panel_all, replace
 11.     apply_attrition
 12.     save ../temp/foia_decline_panel, replace
 13. end

. 
. program apply_attrition
  1.     if $ATTRITION_CUT <= 0 exit
  2.     qui gunique athr_id
  3.     local n0 = r(unique)
  4.     drop if max_year < $ATTRITION_CUT
  5.     qui gunique athr_id
  6.     di as text "attrition gate (max_year >= $ATTRITION_CUT): kept " r(unique) " of `n0' PIs"
  7. end

. 
. program attrition_sensitivity
  1.     foreach c in 0 2020 2021 2022 {
  2.         use ../temp/foia_decline_panel_all, clear
  3.         if `c' > 0 drop if max_year < `c'
  4.         qui gunique athr_id
  5.         local n = r(unique)
  6.         cap noi qui ppmlhdfe ppr_cnt Z_it Z_share_it, absorb(athr_id year) vce(cluster athr_id)
  7.         if _rc {
  8.             di as error "attrition_sensitivity cut=`c' failed"
  9.             continue
 10.         }
 11.         di as text "cut=`c'  N PIs=" %4.0f `n' "  b=" %8.4f _b[Z_it] ///
>             "  se=" %7.4f _se[Z_it] "  t=" %6.2f _b[Z_it]/_se[Z_it]
 12.     }
 13. end

. 
. program estimate_betas
  1.     mat foia_decline = J(6,2,.)
  2. 
.     use ../temp/foia_decline_panel, clear
  3.     ppmlhdfe ppr_cnt Z_it Z_share_it, absorb(athr_id year) vce(cluster athr_id)
  4.     scalar b_foia = _b[Z_it]
  5.     mat foia_decline[1,1] = _b[Z_it]
  6.     mat foia_decline[2,1] = _se[Z_it]
  7.     mat foia_decline[3,1] = _b[Z_share_it]
  8.     mat foia_decline[4,1] = _se[Z_share_it]
  9.     qui sum ppr_cnt if year < 2014 & e(sample)
 10.     mat foia_decline[5,1] = r(mean)
 11.     qui gunique athr_id
 12.     mat foia_decline[6,1] = r(unique)
 13. 
.     use ../temp/foia_decline_full, clear
 14.     ppmlhdfe ppr_cnt Z_it Z_share_it, absorb(athr_id year) vce(cluster athr_id)
 15.     scalar b_full = _b[Z_it]
 16.     mat foia_decline[1,2] = _b[Z_it]
 17.     mat foia_decline[2,2] = _se[Z_it]
 18.     mat foia_decline[3,2] = _b[Z_share_it]
 19.     mat foia_decline[4,2] = _se[Z_share_it]
 20.     qui sum ppr_cnt if year < 2014 & e(sample)
 21.     mat foia_decline[5,2] = r(mean)
 22.     qui gunique athr_id
 23.     mat foia_decline[6,2] = r(unique)
 24. 
.     mat rownames foia_decline = b_exposure se_exposure b_share se_share pre_mean n_pis
 25.     mat colnames foia_decline = foia_only full_samp
 26.     cap mkdir ../output/tables
 27.     qui matrix_to_txt, saving("../output/tables/foia_decline_betas.txt") ///
>         matrix(foia_decline) title(<tab:foia_decline_betas>) format(%20.6f) replace
 28. 
.     di as text _newline "beta(FOIA-only) = " %7.4f b_foia "   beta(full samp) = " %7.4f b_full
 29. end

. 
. program author_level_decline
  1.     use ../temp/foia_decline_panel, clear
  2.     gen _pre  = ppr_cnt if year <  2014
  3.     gen _post = ppr_cnt if year >= 2014
  4.     bys athr_id: egen pre_mean  = mean(_pre)
  5.     bys athr_id: egen post_mean = mean(_post)
  6. 
.     qui sum _pre
  7.     local agg_pre = r(mean)
  8.     qui sum _post
  9.     local agg_post = r(mean)
 10.     local agg_ratio = `agg_post' / `agg_pre'
 11.     di as text "FOIA sample pooled pre mean = " %5.3f `agg_pre' ///
>         "  post mean = " %5.3f `agg_post' "  ratio = " %5.3f `agg_ratio'
 12. 
.     gen double realized_ratio = post_mean / pre_mean if pre_mean > 0
 13.     gen double realized_pct     = 100 * (realized_ratio - 1)
 14.     gen double realized_pct_adj = 100 * (realized_ratio / `agg_ratio' - 1)
 15.     gen double pred_chg = b_foia * exposure
 16.     gen double pred_pct = 100 * (exp(b_foia * exposure) - 1)
 17. 
.     gsort athr_id -athr_name
 18.     by athr_id: replace athr_name = athr_name[1]
 19.     by athr_id: keep if _n == 1
 20.     gisid athr_id
 21. 
.     gen byte declined_raw = realized_pct < 0     if !mi(realized_pct)
 22.     gen byte declined_adj = realized_pct_adj < 0 if !mi(realized_pct_adj)
 23.     gen byte pred_decline = pred_pct < 0         if !mi(pred_pct)
 24. 
.     keep athr_name inst athr_id age_2014 cluster_30 exposure mkt_spend_shr ///
>          pre_mean post_mean realized_pct realized_pct_adj ///
>          pred_chg pred_pct declined_raw declined_adj pred_decline
 25.     order athr_name inst athr_id age_2014 cluster_30 exposure mkt_spend_shr ///
>           pre_mean post_mean realized_pct realized_pct_adj pred_pct ///
>           declined_raw declined_adj pred_decline
 26. 
.     gsort -exposure
 27.     save ../temp/foia_ppr_decline, replace
 28.     export delimited using ../output/foia_ppr_decline.csv, replace
 29. 
.     count
 30.     di as text _newline "=== FOIA PIs: " r(N)
 31.     count if pred_decline == 1
 32.     di as text "predicted decline (b x exposure < 0): " r(N)
 33.     count if declined_raw == 1
 34.     di as text "realized raw decline (post < pre): " r(N)
 35.     count if declined_adj == 1
 36.     di as text "realized decline vs FOIA-sample trend: " r(N)
 37.     tab pred_decline declined_adj, row
 38. 
.     qui corr pred_pct realized_pct_adj
 39.     di as text "corr(predicted, realized-adjusted) = " %6.3f r(rho)
 40. 
.     di as text _newline "=== 15 largest predicted declines ==="
 41.     gsort pred_pct
 42.     list athr_name inst exposure pred_pct realized_pct realized_pct_adj in 1/15, ///
>         noobs abbrev(22) sep(0)
 43. 
.     di as text _newline "=== 15 largest realized declines (trend-adjusted) ==="
 44.     gsort realized_pct_adj
 45.     list athr_name inst exposure pred_pct realized_pct realized_pct_adj in 1/15, ///
>         noobs abbrev(22) sep(0)
 46. end

. 
. program decline_scatter
  1.     cap mkdir ../output/figures/all_jrnls
  2.     use ../temp/foia_ppr_decline, clear
  3.     local bstr : di %6.3f b_foia
  4.     twoway (scatter realized_pct_adj exposure, mcolor(ebblue%60) msymbol(O)) ///
>            (function 100*(exp(b_foia*x)-1), range(exposure) lcolor(dkorange) lwidth(medthick)), ///
>         xtitle("Observed exposure") ///
>         ytitle("Realized {&Delta} papers vs FOIA trend (%)") ///
>         legend(order(1 "FOIA PI" 2 "PPML fit") pos(6) rows(1)) ///
>         note("{&beta} = `bstr' (FOIA-only PPML, author + year FE)", size(small) pos(7) ring(1) justification(left))
  5.     graph export ../output/figures/all_jrnls/foia_decline_scatter.pdf, replace
  6. end

. 
