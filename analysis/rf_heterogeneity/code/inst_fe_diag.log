. local ic_ln ""

. foreach v of local ic_all_raw {
  2.     cap confirm variable `v'
  3.     if _rc {
  4.         di as text "-- `v' not in inst_chars; skipping"
  5.         continue
  6.     }
  7.     qui gen ln_`v' = ln(`v') if `v' > 0
  8.     local ic_ln `ic_ln' ln_`v'
  9. }

