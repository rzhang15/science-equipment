. 
. * Early- vs late-career differential from the joint pooled-DiD PPML that
. * event_study_het fits (split_type med_pi). Three tests per outcome:
. *   (1) median split, lincom Z_young - Z_old off the joint VCE
. *   (2) continuous Z x lab-age interaction (one coefficient, no binning)
. *   (3) both again with PI age redefined off the first last-author paper that
. *       was NOT solo-authored (min_year_nonsolo, built here from the
. *       untruncated last-author panel)
. * Reads the panels analysis.do already wrote to ../temp/, so no rebuild.
. 
. local fes athr_id year

. local vce_cl athr_id

. 
. foreach suf in _r1_r2 {
  2.     cap confirm file "../temp/es_all_jrnls`suf'.dta"
  3.     if _rc {
  4.         di as error "../temp/es_all_jrnls`suf'.dta missing -- run analysis.do 
> first."
  5.         continue
  6.     }
  7. 
.     * n_solo_ppr is degenerate in the last-author panel (num_athrs == 1 by
.     * construction, so it equals ppr_cnt); avg_team_size = mean coauthors is
.     * genuine, so >0 flags a year with a non-solo last-author paper.
.     use athr_id year avg_team_size using ///
>         ../external/samp/athr_panel_full_year_last_all_jrnls`suf', clear
  8.     gen _nonsolo_yr = year if avg_team_size > 0.001 & !mi(avg_team_size)
  9.     gcollapse (min) min_year_nonsolo = _nonsolo_yr, by(athr_id)
 10.     save ../temp/min_year_nonsolo`suf', replace
 11. 
.     * Career clock excluding solo papers: first year with a non-solo paper in
.     * any author position.
.     use athr_id year ppr_cnt n_solo_ppr using ///
>         ../external/samp/athr_panel_full_year_all_jrnls`suf', clear
 12.     gen _ns_any_yr = year if ppr_cnt - n_solo_ppr > 0.001
 13.     gcollapse (min) min_year_any_ns = _ns_any_yr, by(athr_id)
 14.     save ../temp/min_year_any_ns`suf', replace
 15. 
.     * Last-author papers excluding solo ones. n_solo_ppr is genuine in the
.     * all-position panel (num_athrs is real there), where n_last_ppr is the
.     * same count as ppr_cnt in the analysis panel.
.     use athr_id year n_last_ppr n_solo_ppr using ///
>         ../external/samp/athr_panel_full_year_all_jrnls`suf', clear
 16.     gen ppr_cnt_nonsolo = n_last_ppr - n_solo_ppr
 17.     keep athr_id year n_last_ppr ppr_cnt_nonsolo
 18.     save ../temp/nonsolo_ppr`suf', replace
 19. 
.     use athr_id year ppr_cnt cite_affl_wt exposure mkt_spend_shr ///
>         min_year min_year_any young old young_nih old_nih ///
>         using ../temp/es_all_jrnls`suf', clear
 20.     merge m:1 athr_id using ../temp/min_year_nonsolo`suf', keep(1 3) nogen
 21.     merge m:1 athr_id using ../temp/min_year_any_ns`suf', keep(1 3) nogen
 22.     merge 1:1 athr_id year using ../temp/nonsolo_ppr`suf', keep(1 3) nogen
 23.     foreach v in n_last_ppr ppr_cnt_nonsolo {
 24.         replace `v' = 0 if mi(`v')
 25.     }
 26.     * Nonzero only if the panel was built with reduced_form's DROP_SOLO on, in
.     * which case ppr_cnt is already the non-solo count and the two are the same.
.     qui count if ppr_cnt != n_last_ppr
 27.     di as text "  rows where ppr_cnt != n_last_ppr (all-position panel): " r(N
> )
 28.     qui sum ppr_cnt_nonsolo
 29.     local ns_tot = r(sum)
 30.     qui sum ppr_cnt
 31.     local solo_shr = 100*(1 - `ns_tot'/r(sum))
 32.     di as text "  solo papers are " %5.2f `solo_shr' "% of last-author papers 
> in this sample"
 33. 
.     cap drop athr_indicator
 34.     bys athr_id: gen athr_indicator = _n == 1
 35.     qui sum min_year_nonsolo if athr_indicator == 1, d
 36.     local nsmed = r(p50)
 37.     qui count if athr_indicator == 1 & mi(min_year_nonsolo)
 38.     local n_allsolo = r(N)
 39.     qui count if athr_indicator == 1
 40.     di as result _n "== all_jrnls`suf': min_year_nonsolo median = `nsmed'; `n_
> allsolo' of " ///
>         r(N) " PIs have no non-solo last-author paper =="
 41.     tabstat min_year min_year_nonsolo min_year_any min_year_any_ns if athr_ind
> icator == 1, ///
>         stats(n mean p10 p25 p50 p75 p90) col(stat) format(%9.1f)
 42.     gen byte young_ns = min_year_nonsolo >  `nsmed' if !mi(min_year_nonsolo)
 43.     gen byte old_ns   = min_year_nonsolo <= `nsmed' if !mi(min_year_nonsolo)
 44.     qui count if athr_indicator == 1 & young != young_ns & !mi(young) & !mi(yo
> ung_ns)
 45.     di as text "  PIs that switch side under the non-solo definition: " r(N)
 46. 
.     qui sum min_year_any if athr_indicator == 1, d
 47.     local anymed = r(p50)
 48.     di as text "  min_year_any (first pub ever) median = `anymed'"
 49.     gen byte young_any = min_year_any >  `anymed' if !mi(min_year_any)
 50.     gen byte old_any   = min_year_any <= `anymed' if !mi(min_year_any)
 51.     qui count if athr_indicator == 1 & young != young_any & !mi(young) & !mi(y
> oung_any)
 52.     di as text "  PIs that switch side under the first-pub-ever definition: " 
> r(N)
 53. 
.     qui sum min_year_any_ns if athr_indicator == 1, d
 54.     local anynsmed = r(p50)
 55.     di as text "  min_year_any_ns (first non-solo pub, any position) median = 
> `anynsmed'"
 56.     gen byte young_anyns = min_year_any_ns >  `anynsmed' if !mi(min_year_any_n
> s)
 57.     gen byte old_anyns   = min_year_any_ns <= `anynsmed' if !mi(min_year_any_n
> s)
 58.     qui count if athr_indicator == 1 & young_any != young_anyns & !mi(young_an
> y) & !mi(young_anyns)
 59.     di as text "  PIs that switch side once solo papers are dropped from the c
> areer clock: " r(N)
 60. 
.     gen lab_age     = 2014 - min_year
 61.     gen lab_age_ns  = 2014 - min_year_nonsolo
 62.     gen career_age  = 2014 - min_year_any
 63. 
.     * Lab-age split dropping PIs whose first indexed paper was already
.     * last-authored (gap <= 0), for whom min_year cannot measure independence.
.     gen gap = min_year - min_year_any
 64.     qui count if athr_indicator == 1 & gap <= 0
 65.     local n_nogap = r(N)
 66.     qui count if athr_indicator == 1
 67.     di as text "  PIs with gap <= 0 (first paper is last-authored): `n_nogap' 
> of " r(N)
 68.     qui sum min_year if athr_indicator == 1 & gap >= 1, d
 69.     local gapmed = r(p50)
 70.     gen byte young_g = min_year >  `gapmed' if !mi(min_year) & gap >= 1 & !mi(
> gap)
 71.     gen byte old_g   = min_year <= `gapmed' if !mi(min_year) & gap >= 1 & !mi(
> gap)
 72. 
.     * Young on both the lab-age and career-age clocks vs old on both; PIs the
.     * two clocks disagree on are missing and drop out of the fit.
.     gen byte young_both = young == 1 & young_any == 1 ///
>         if young == young_any & !mi(young) & !mi(young_any)
 73.     gen byte old_both   = young == 0 & young_any == 0 ///
>         if young == young_any & !mi(young) & !mi(young_any)
 74. 
.     gen post       = year >= 2014
 75.     gen Z_it       = exposure      * post
 76.     gen Z_share_it = mkt_spend_shr * post
 77. 
.     * ---- (1)/(3a) median splits
.     cap matrix drop SPLITS
 78.     local split_rows
 79.     local pairs `" "young old" "young_ns old_ns" "young_g old_g" "young_any ol
> d_any" "young_anyns old_anyns" "young_both old_both" "young_nih old_nih" "'
 80.     foreach pair of local pairs {
 81.         local g1 : word 1 of `pair'
 82.         local g2 : word 2 of `pair'
 83.         cap confirm variable `g1'
 84.         local rc1 = _rc
 85.         cap confirm variable `g2'
 86.         if `rc1' | _rc {
 87.             di as text "  `g1'/`g2' not built -- skipping pair."
 88.             continue
 89.         }
 90.         foreach yvar in ppr_cnt {
 91.             cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
 92.             gen Z_`g1' = Z_it       * `g1'
 93.             gen Z_`g2' = Z_it       * `g2'
 94.             gen S_`g1' = Z_share_it * `g1'
 95.             gen S_`g2' = Z_share_it * `g2'
 96.             gen PT_`g1' = post * `g1'
 97. 
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                 absorb(`fes') vce(cluster `vce_cl')
 98.             local rc = _rc
 99.             if `rc' {
100.                 di as error "test_young_old`suf' `yvar' `g1'/`g2': ppml failed
>  (rc=`rc'); skipping."
101.                 continue
102.             }
103.             local b1  = _b[Z_`g1']
104.             local se1 = _se[Z_`g1']
105.             local b2  = _b[Z_`g2']
106.             local se2 = _se[Z_`g2']
107.             local Nfit = e(N)
108. 
.             lincom Z_`g1' - Z_`g2'
109.             local b_diff  = r(estimate)
110.             local se_diff = r(se)
111.             local p_diff  = r(p)
112.             local t_diff = `b_diff'/`se_diff'
113.             local p_one  = `p_diff'/2
114.             local se_ind = sqrt(`se1'^2 + `se2'^2)
115.             local p_ind  = 2*normal(-abs(`b_diff'/`se_ind'))
116. 
.             di as result _n "== all_jrnls`suf' `yvar' `g1' vs `g2' (N=`Nfit') =="
117.             di as text "  `g1': b=" %8.4f `b1' " (se=" %7.4f `se1' ")"
118.             di as text "  `g2': b=" %8.4f `b2' " (se=" %7.4f `se2' ")"
119.             di as text "  diff, joint VCE:  b=" %8.4f `b_diff' " se=" %7.4f `s
> e_diff' ///
>                 " t=" %6.3f `t_diff' " p=" %6.4f `p_diff' " (one-sided " %6.4f `p
> _one' ")"
120.             di as text "  diff, indep. SEs: se=" %7.4f `se_ind' " p=" %6.4f `p
> _ind'
121. 
.             matrix SPLITS = nullmat(SPLITS) \ ///
>                 (`b1', `se1', `b2', `se2', `b_diff', `se_diff', `p_diff', `p_one'
> , `Nfit')
122.             local split_rows `split_rows' `g1'
123.         }
124.     }
125. 
.     * ---- (2)/(3b) continuous age gradient: one coefficient, all PIs
.     foreach agevar in lab_age lab_age_ns career_age {
126.         cap confirm variable `agevar'
127.         if _rc {
128.             di as text "  `agevar' not built -- skipping gradient."
129.             continue
130.         }
131.         foreach yvar in ppr_cnt {
132.             cap drop age_c Z_age S_age PT_age
