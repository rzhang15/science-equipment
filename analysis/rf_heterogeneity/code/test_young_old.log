. 
. * Early- vs late-career differential from the joint pooled-DiD PPML that
. * event_study_het fits (split_type med_pi). Three tests per outcome:
. *   (1) median split, lincom Z_young - Z_old off the joint VCE
. *   (2) continuous Z x lab-age interaction (one coefficient, no binning)
. *   (3) both again with PI age redefined off the first last-author paper that
. *       was NOT solo-authored (min_year_nonsolo, built here from the
. *       untruncated last-author panel)
. * Reads the panels analysis.do already wrote to ../temp/, so no rebuild.
. 
. local fes athr_id year

. local vce_cl athr_id

. 
. foreach suf in _r1_r2 _r1_r2_public {
  2.     cap confirm file "../temp/es_all_jrnls`suf'.dta"
  3.     if _rc {
  4.         di as error "../temp/es_all_jrnls`suf'.dta missing -- run analysis.do first."
  5.         continue
  6.     }
  7. 
.     * n_solo_ppr is degenerate in the last-author panel (num_athrs == 1 by
.     * construction, so it equals ppr_cnt); avg_team_size = mean coauthors is
.     * genuine, so >0 flags a year with a non-solo last-author paper.
.     use athr_id year avg_team_size using ///
>         ../external/samp/athr_panel_full_year_last_all_jrnls`suf', clear
  8.     gen _nonsolo_yr = year if avg_team_size > 0.001 & !mi(avg_team_size)
  9.     gcollapse (min) min_year_nonsolo = _nonsolo_yr, by(athr_id)
 10.     save ../temp/min_year_nonsolo`suf', replace
 11. 
.     * Last-author papers excluding solo ones. n_solo_ppr is genuine in the
.     * all-position panel (num_athrs is real there), where n_last_ppr is the
.     * same count as ppr_cnt in the analysis panel.
.     use athr_id year n_last_ppr n_solo_ppr using ///
>         ../external/samp/athr_panel_full_year_all_jrnls`suf', clear
 12.     gen ppr_cnt_nonsolo = n_last_ppr - n_solo_ppr
 13.     keep athr_id year n_last_ppr ppr_cnt_nonsolo
 14.     save ../temp/nonsolo_ppr`suf', replace
 15. 
.     use athr_id year ppr_cnt cite_affl_wt exposure mkt_spend_shr ///
>         min_year min_year_any young old young_nih old_nih ///
>         using ../temp/es_all_jrnls`suf', clear
 16.     merge m:1 athr_id using ../temp/min_year_nonsolo`suf', keep(1 3) nogen
 17.     merge 1:1 athr_id year using ../temp/nonsolo_ppr`suf', keep(1 3) nogen
 18.     foreach v in n_last_ppr ppr_cnt_nonsolo {
 19.         replace `v' = 0 if mi(`v')
 20.     }
 21.     * Nonzero only if the panel was built with reduced_form's DROP_SOLO on, in
.     * which case ppr_cnt is already the non-solo count and the two are the same.
.     qui count if ppr_cnt != n_last_ppr
 22.     di as text "  rows where ppr_cnt != n_last_ppr (all-position panel): " r(N)
 23.     qui sum ppr_cnt_nonsolo
 24.     local ns_tot = r(sum)
 25.     qui sum ppr_cnt
 26.     local solo_shr = 100*(1 - `ns_tot'/r(sum))
 27.     di as text "  solo papers are " %5.2f `solo_shr' "% of last-author papers in this sample"
 28. 
.     cap drop athr_indicator
 29.     bys athr_id: gen athr_indicator = _n == 1
 30.     qui sum min_year_nonsolo if athr_indicator == 1, d
 31.     local nsmed = r(p50)
 32.     qui count if athr_indicator == 1 & mi(min_year_nonsolo)
 33.     local n_allsolo = r(N)
 34.     qui count if athr_indicator == 1
 35.     di as result _n "== all_jrnls`suf': min_year_nonsolo median = `nsmed'; `n_allsolo' of " ///
>         r(N) " PIs have no non-solo last-author paper =="
 36.     tabstat min_year min_year_nonsolo min_year_any if athr_indicator == 1, ///
>         stats(n mean p10 p25 p50 p75 p90) col(stat) format(%9.1f)
 37.     gen byte young_ns = min_year_nonsolo >  `nsmed' if !mi(min_year_nonsolo)
 38.     gen byte old_ns   = min_year_nonsolo <= `nsmed' if !mi(min_year_nonsolo)
 39.     qui count if athr_indicator == 1 & young != young_ns & !mi(young) & !mi(young_ns)
 40.     di as text "  PIs that switch side under the non-solo definition: " r(N)
 41. 
.     qui sum min_year_any if athr_indicator == 1, d
 42.     local anymed = r(p50)
 43.     di as text "  min_year_any (first pub ever) median = `anymed'"
 44.     gen byte young_any = min_year_any >  `anymed' if !mi(min_year_any)
 45.     gen byte old_any   = min_year_any <= `anymed' if !mi(min_year_any)
 46.     qui count if athr_indicator == 1 & young != young_any & !mi(young) & !mi(young_any)
 47.     di as text "  PIs that switch side under the first-pub-ever definition: " r(N)
 48. 
.     * True first-publication year from the full world corpus, so PIs whose early
.     * career predates this corpus are not counted as young. Built by
.     * derived/openalex/make_athr_yr_panel/code/diag_first_pub_world.do (hand-run;
.     * lives in that project's temp/, so it disappears on the next make there).
.     cap confirm file "../external/world/diag_first_any_world.dta"
 49.     if !_rc {
 50.         merge m:1 athr_id using ../external/world/diag_first_any_world, keep(1 3) nogen
 51.         gen career_age_w = 2014 - first_any_world
 52.         qui sum first_any_world if athr_indicator == 1, d
 53.         local wmed = r(p50)
 54.         gen byte young_w = first_any_world >  `wmed' if !mi(first_any_world)
 55.         gen byte old_w   = first_any_world <= `wmed' if !mi(first_any_world)
 56.         gen trunc_yrs = min_year_any - first_any_world
 57.         qui count if athr_indicator == 1 & trunc_yrs > 0 & !mi(trunc_yrs)
 58.         di as text "  PIs with truncated career start (trunc_yrs > 0): " r(N)
 59.         qui count if athr_indicator == 1 & young_any != young_w & !mi(young_any) & !mi(young_w)
 60.         di as text "  PIs that switch side once career truncation is fixed: " r(N)
 61.     }
 62.     else di as error "  ../external/world/diag_first_any_world.dta missing -- young_w/old_w SKIPPED. Rerun diag_first_pub_world.do."
 63. 
.     * Same correction on the lab-start side: first_last_world is the first
.     * last-author paper anywhere, so it recovers PIs whose early independent
.     * work sits outside this corpus.
.     cap confirm file "../external/world/diag_first_last_world.dta"
 64.     if !_rc {
 65.         merge m:1 athr_id using ../external/world/diag_first_last_world, keep(1 3) nogen
 66.         gen lab_age_w = 2014 - first_last_world
 67.         qui sum first_last_world if athr_indicator == 1, d
 68.         local wlmed = r(p50)
 69.         gen byte young_wl = first_last_world >  `wlmed' if !mi(first_last_world)
 70.         gen byte old_wl   = first_last_world <= `wlmed' if !mi(first_last_world)
 71.         gen trunc_lab = min_year - first_last_world
 72.         qui count if athr_indicator == 1 & trunc_lab > 0 & !mi(trunc_lab)
 73.         di as text "  PIs whose lab start is recorded too late (trunc_lab > 0): " r(N)
 74.         qui count if athr_indicator == 1 & young != young_wl & !mi(young) & !mi(young_wl)
 75.         di as text "  PIs that switch side once lab truncation is fixed: " r(N)
 76.     }
 77.     else di as error "  ../external/world/diag_first_last_world.dta missing -- young_wl/old_wl SKIPPED."
 78. 
.     * Lab-age split on PIs whose panel dates both match the world corpus exactly:
.     * no institution-move artifact, no coverage gap, no merged author id. The
.     * subsample where min_year is a credible lab-start date.
.     cap confirm variable first_last_world
 79.     if !_rc {
 80.         gen byte clean_dates = (min_year == first_last_world) & (min_year_any == first_any_world) ///
>             if !mi(first_last_world) & !mi(first_any_world)
 81.         qui count if athr_indicator == 1 & clean_dates == 1
 82.         di as text "  PIs with both dates verified against the world corpus: " r(N)
 83.         qui sum min_year if athr_indicator == 1 & clean_dates == 1, d
 84.         local cmed = r(p50)
 85.         gen byte young_c = min_year >  `cmed' if !mi(min_year) & clean_dates == 1
 86.         gen byte old_c   = min_year <= `cmed' if !mi(min_year) & clean_dates == 1
 87.     }
 88. 
.     gen lab_age     = 2014 - min_year
 89.     gen lab_age_ns  = 2014 - min_year_nonsolo
 90.     gen career_age  = 2014 - min_year_any
 91. 
.     * Apprenticeship gap. gap <= 0 means the PI's first indexed paper was already
.     * last-authored, so min_year cannot be measuring independence for them.
.     gen gap = min_year - min_year_any
 92.     qui count if athr_indicator == 1 & gap <= 0
 93.     local n_nogap = r(N)
 94.     qui count if athr_indicator == 1
 95.     di as text "  PIs with gap <= 0 (lab age undefined in practice): `n_nogap' of " r(N)
 96.     qui sum min_year if athr_indicator == 1 & gap >= 1, d
 97.     local gapmed = r(p50)
 98.     gen byte young_g = min_year >  `gapmed' if !mi(min_year) & gap >= 1 & !mi(gap)
 99.     gen byte old_g   = min_year <= `gapmed' if !mi(min_year) & gap >= 1 & !mi(gap)
100. 
.     gen post       = year >= 2014
101.     gen Z_it       = exposure      * post
102.     gen Z_share_it = mkt_spend_shr * post
103. 
.     * ---- (1)/(3a) median splits
.     local pairs `" "young old" "young_ns old_ns" "young_any old_any" "young_w old_w" "young_wl old_wl" "young_c old_c" "young_g old_g" "young_nih old_nih" "'
104.     foreach pair of local pairs {
105.         local g1 : word 1 of `pair'
106.         local g2 : word 2 of `pair'
107.         cap confirm variable `g1'
108.         local rc1 = _rc
109.         cap confirm variable `g2'
110.         if `rc1' | _rc {
111.             di as text "  `g1'/`g2' not built -- skipping pair."
112.             continue
113.         }
114.         foreach yvar in ppr_cnt ppr_cnt_nonsolo cite_affl_wt {
115.             cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
116.             gen Z_`g1' = Z_it       * `g1'
117.             gen Z_`g2' = Z_it       * `g2'
118.             gen S_`g1' = Z_share_it * `g1'
119.             gen S_`g2' = Z_share_it * `g2'
120.             gen PT_`g1' = post * `g1'
121. 
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                 absorb(`fes') vce(cluster `vce_cl')
122.             local rc = _rc
123.             if `rc' {
124.                 di as error "test_young_old`suf' `yvar' `g1'/`g2': ppml failed (rc=`rc'); skipping."
125.                 continue
126.             }
127.             local b1  = _b[Z_`g1']
128.             local se1 = _se[Z_`g1']
129.             local b2  = _b[Z_`g2']
130.             local se2 = _se[Z_`g2']
131.             local Nfit = e(N)
132. 
.             lincom Z_`g1' - Z_`g2'
133.             local b_diff  = r(estimate)
134.             local se_diff = r(se)
135.             local p_diff  = r(p)
136.             local t_diff = `b_diff'/`se_diff'
137.             local p_one  = `p_diff'/2
138.             local se_ind = sqrt(`se1'^2 + `se2'^2)
139.             local p_ind  = 2*normal(-abs(`b_diff'/`se_ind'))
140. 
.             di as result _n "== all_jrnls`suf' `yvar' `g1' vs `g2' (N=`Nfit') =="
141.             di as text "  `g1': b=" %8.4f `b1' " (se=" %7.4f `se1' ")"
142.             di as text "  `g2': b=" %8.4f `b2' " (se=" %7.4f `se2' ")"
143.             di as text "  diff, joint VCE:  b=" %8.4f `b_diff' " se=" %7.4f `se_diff' ///
>                 " t=" %6.3f `t_diff' " p=" %6.4f `p_diff' " (one-sided " %6.4f `p_one' ")"
144.             di as text "  diff, indep. SEs: se=" %7.4f `se_ind' " p=" %6.4f `p_ind'
145.         }
146.     }
147. 
.     * ---- (2)/(3b) continuous age gradient: one coefficient, all PIs
.     foreach agevar in lab_age lab_age_ns career_age career_age_w lab_age_w {
148.         cap confirm variable `agevar'
149.         if _rc {
150.             di as text "  `agevar' not built -- skipping gradient."
151.             continue
152.         }
153.         foreach yvar in ppr_cnt ppr_cnt_nonsolo cite_affl_wt {
154.             cap drop age_c Z_age S_age PT_age
155.             qui sum `agevar' if athr_indicator == 1, d
156.             local age_mean = r(mean)
157.             gen age_c  = (`agevar' - `age_mean')/10
158.             gen Z_age  = Z_it       * age_c
159.             gen S_age  = Z_share_it * age_c
160.             gen PT_age = post       * age_c
161. 
.             cap noi ppmlhdfe `yvar' Z_it Z_age Z_share_it S_age PT_age, ///
>                 absorb(`fes') vce(cluster `vce_cl')
162.             local rc = _rc
163.             if `rc' {
164.                 di as error "test_young_old`suf' `yvar' `agevar' gradient: ppml failed (rc=`rc'); skipping."
165.                 continue
166.             }
167.             local Nfit = e(N)
168.             local b_z   = _b[Z_it]
169.             local se_z  = _se[Z_it]
170.             local b_ga  = _b[Z_age]
171.             local se_ga = _se[Z_age]
172.             local t_ga  = `b_ga'/`se_ga'
173.             local p_ga  = 2*normal(-abs(`t_ga'))
174.             local p_ga1 = `p_ga'/2
175. 
.             di as result _n "== all_jrnls`suf' `yvar' continuous gradient in `agevar' (N=`Nfit') =="
176.             di as text "  Z at mean lab age (" %4.1f `age_mean' " yrs): b=" %8.4f `b_z' ///
>                 " (se=" %7.4f `se_z' ")"
177.             di as text "  Z x lab age (per decade): b=" %8.4f `b_ga' " (se=" %7.4f `se_ga' ///
>                 ") t=" %6.3f `t_ga' " p=" %6.4f `p_ga' " (one-sided " %6.4f `p_ga1' ")"
178.         }
179.     }
180. 
.     * ---- (5) 2x2 career age x lab age. The two switcher cells disagree about
.     * which clock a PI is young on, so they identify which clock the effect
.     * actually follows.
.     cap drop yc_yl oc_ol oc_yl yc_ol
181.     gen byte yc_yl = (young_any == 1 & young == 1) if !mi(young_any) & !mi(young)
182.     gen byte oc_ol = (young_any == 0 & young == 0) if !mi(young_any) & !mi(young)
183.     gen byte oc_yl = (young_any == 0 & young == 1) if !mi(young_any) & !mi(young)
184.     gen byte yc_ol = (young_any == 1 & young == 0) if !mi(young_any) & !mi(young)
185.     foreach c in yc_yl oc_ol oc_yl yc_ol {
186.         qui count if athr_indicator == 1 & `c' == 1
187.         di as text "  cell `c': " r(N) " PIs"
188.     }
189.     foreach yvar in ppr_cnt cite_affl_wt {
190.         foreach c in yc_yl oc_ol oc_yl yc_ol {
191.             cap drop Z_`c' S_`c' PT_`c'
192.             gen Z_`c'  = Z_it       * `c'
193.             gen S_`c'  = Z_share_it * `c'
194.             gen PT_`c' = post       * `c'
195.         }
196.         cap noi ppmlhdfe `yvar' Z_yc_yl Z_oc_ol Z_oc_yl Z_yc_ol ///
>                                 S_yc_yl S_oc_ol S_oc_yl S_yc_ol ///
>                                 PT_yc_yl PT_oc_yl PT_yc_ol, ///
>             absorb(`fes') vce(cluster `vce_cl')
197.         local rc = _rc
198.         if `rc' {
199.             di as error "test_young_old`suf' `yvar' 2x2: ppml failed (rc=`rc'); skipping."
200.             continue
201.         }
202.         di as result _n "== all_jrnls`suf' `yvar' 2x2 career x lab age (N=" e(N) ") =="
203.         di as text "  young career, young lab : b=" %8.4f _b[Z_yc_yl] " (se=" %7.4f _se[Z_yc_yl] ")"
204.         di as text "  young career, OLD lab   : b=" %8.4f _b[Z_yc_ol] " (se=" %7.4f _se[Z_yc_ol] ")   <- gap 0"
205.         di as text "  OLD career, young lab   : b=" %8.4f _b[Z_oc_yl] " (se=" %7.4f _se[Z_oc_yl] ")   <- long apprenticeship"
206.         di as text "  OLD career, OLD lab     : b=" %8.4f _b[Z_oc_ol] " (se=" %7.4f _se[Z_oc_ol] ")"
207.         local clabs `" "career effect within young labs" "career effect within old labs" "lab effect within young careers" "lab effect within old careers" "unambiguous y
> oung vs old (switchers dropped)" "'
208.         local cvars `" "Z_yc_yl Z_oc_yl" "Z_yc_ol Z_oc_ol" "Z_yc_yl Z_yc_ol" "Z_oc_yl Z_oc_ol" "Z_yc_yl Z_oc_ol" "'
209.         forval k = 1/5 {
210.             local dtxt  : word `k' of `clabs'
211.             local dpair : word `k' of `cvars'
212.             local v1 : word 1 of `dpair'
213.             local v2 : word 2 of `dpair'
214.             cap noi lincom `v1' - `v2'
215.             if _rc continue
216.             local b_d  = r(estimate)
217.             local se_d = r(se)
218.             local p_d  = r(p)
219.             di as text "  `dtxt': b=" %8.4f `b_d' " (se=" %7.4f `se_d' ") p=" %6.4f `p_d'
220.         }
221.     }
222. 
.     * ---- (4) horse race: both age measures in one fit
.     foreach yvar in ppr_cnt ppr_cnt_nonsolo cite_affl_wt {
223.         cap drop lab_c car_c Z_lab Z_car S_lab S_car PT_lab PT_car
224.         qui sum lab_age if athr_indicator == 1, d
225.         local lab_mean = r(mean)
226.         qui sum career_age if athr_indicator == 1, d
227.         local car_mean = r(mean)
228.         gen lab_c  = (lab_age    - `lab_mean')/10
229.         gen car_c  = (career_age - `car_mean')/10
230.         gen Z_lab  = Z_it       * lab_c
231.         gen Z_car  = Z_it       * car_c
232.         gen S_lab  = Z_share_it * lab_c
233.         gen S_car  = Z_share_it * car_c
234.         gen PT_lab = post       * lab_c
235.         gen PT_car = post       * car_c
236. 
.         cap noi ppmlhdfe `yvar' Z_it Z_lab Z_car Z_share_it S_lab S_car PT_lab PT_car, ///
>             absorb(`fes') vce(cluster `vce_cl')
237.         local rc = _rc
238.         if `rc' {
239.             di as error "test_young_old`suf' `yvar' horse race: ppml failed (rc=`rc'); skipping."
240.             continue
241.         }
242.         local Nfit = e(N)
243.         local b_lab  = _b[Z_lab]
244.         local se_lab = _se[Z_lab]
245.         local b_car  = _b[Z_car]
246.         local se_car = _se[Z_car]
247.         local p_lab  = 2*normal(-abs(`b_lab'/`se_lab'))
248.         local p_car  = 2*normal(-abs(`b_car'/`se_car'))
249.         lincom Z_car - Z_lab
250.         local b_hr  = r(estimate)
251.         local se_hr = r(se)
252.         local p_hr  = r(p)
253.         * Reparametrised: lab_age = career_age - gap, so the fit is equivalent to
.         * (b_lab+b_car) on career age holding the apprenticeship gap fixed, and
.         * (-b_lab) on the gap itself.
.         lincom Z_lab + Z_car
254.         local b_cg  = r(estimate)
255.         local se_cg = r(se)
256.         local p_cg  = r(p)
257. 
.         di as result _n "== all_jrnls`suf' `yvar' horse race: lab age vs career age (N=`Nfit') =="
258.         di as text "  Z x lab age    (per decade): b=" %8.4f `b_lab' " (se=" %7.4f `se_lab' ") p=" %6.4f `p_lab'
259.         di as text "  Z x career age (per decade): b=" %8.4f `b_car' " (se=" %7.4f `se_car' ") p=" %6.4f `p_car'
260.         di as text "  career - lab: b=" %8.4f `b_hr' " (se=" %7.4f `se_hr' ") p=" %6.4f `p_hr'
261.         di as text "  career age holding gap fixed: b=" %8.4f `b_cg' " (se=" %7.4f `se_cg' ") p=" %6.4f `p_cg'
262.         local b_gap = -`b_lab'
263.         di as text "  apprenticeship gap (per decade): b=" %8.4f `b_gap' " (se=" %7.4f `se_lab' ") p=" %6.4f `p_lab'
264.     }
265. }
