185.         local clabs `" "career effect within young labs" "career effect within
>  old labs" "lab effect within young careers" "lab effect within old careers" "una
> mbiguous young vs old (switchers dropped)" "'
186.         local cvars `" "Z_yc_yl Z_oc_yl" "Z_yc_ol Z_oc_ol" "Z_yc_yl Z_yc_ol" "
> Z_oc_yl Z_oc_ol" "Z_yc_yl Z_oc_ol" "'
187.         forval k = 1/5 {
188.             local dtxt  : word `k' of `clabs'
189.             local dpair : word `k' of `cvars'
190.             local v1 : word 1 of `dpair'
191.             local v2 : word 2 of `dpair'
192.             cap noi lincom `v1' - `v2'
193.             if _rc continue
194.             local b_d  = r(estimate)
195.             local se_d = r(se)
196.             local p_d  = r(p)
