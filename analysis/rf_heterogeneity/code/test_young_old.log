. 
. * Early- vs late-career differential from the joint pooled-DiD PPML that
. * event_study_het fits (split_type med_pi). Three tests per outcome:
. *   (1) median split, lincom Z_young - Z_old off the joint VCE
. *   (2) continuous Z x lab-age interaction (one coefficient, no binning)
. *   (3) both again with PI age redefined off the first last-author paper that
. *       was NOT solo-authored (min_year_nonsolo, built here from the
. *       untruncated last-author panel)
. * Reads the panels analysis.do already wrote to ../temp/, so no rebuild.
. 
. local fes athr_id year

. local vce_cl athr_id

. 
. foreach suf in _r1_r2 {
  2.     cap confirm file "../temp/es_all_jrnls`suf'.dta"
  3.     if _rc {
  4.         di as error "../temp/es_all_jrnls`suf'.dta missing -- run analysis.do first."
  5.         continue
  6.     }
  7. 
.     * n_solo_ppr is degenerate in the last-author panel (num_athrs == 1 by
.     * construction, so it equals ppr_cnt); avg_team_size = mean coauthors is
.     * genuine, so >0 flags a year with a non-solo last-author paper.
.     use athr_id year avg_team_size using ///
>         ../external/samp/athr_panel_full_year_last_all_jrnls`suf', clear
  8.     gen _nonsolo_yr = year if avg_team_size > 0.001 & !mi(avg_team_size)
  9.     gcollapse (min) min_year_nonsolo = _nonsolo_yr, by(athr_id)
 10.     save ../temp/min_year_nonsolo`suf', replace
 11. 
.     * Career clock excluding solo papers: first year with a non-solo paper in
.     * any author position.
.     use athr_id year ppr_cnt n_solo_ppr using ///
>         ../external/samp/athr_panel_full_year_all_jrnls`suf', clear
 12.     gen _ns_any_yr = year if ppr_cnt - n_solo_ppr > 0.001
 13.     gcollapse (min) min_year_any_ns = _ns_any_yr, by(athr_id)
 14.     save ../temp/min_year_any_ns`suf', replace
 15. 
.     * Last-author papers excluding solo ones. n_solo_ppr is genuine in the
.     * all-position panel (num_athrs is real there), where n_last_ppr is the
.     * same count as ppr_cnt in the analysis panel.
.     use athr_id year n_last_ppr n_solo_ppr using ///
>         ../external/samp/athr_panel_full_year_all_jrnls`suf', clear
 16.     gen ppr_cnt_nonsolo = n_last_ppr - n_solo_ppr
 17.     keep athr_id year n_last_ppr ppr_cnt_nonsolo
 18.     save ../temp/nonsolo_ppr`suf', replace
 19. 
.     use athr_id year ppr_cnt cite_affl_wt exposure mkt_spend_shr ///
>         min_year min_year_any young old young_nih old_nih ///
>         using ../temp/es_all_jrnls`suf', clear
 20.     merge m:1 athr_id using ../temp/min_year_nonsolo`suf', keep(1 3) nogen
 21.     merge m:1 athr_id using ../temp/min_year_any_ns`suf', keep(1 3) nogen
 22.     merge 1:1 athr_id year using ../temp/nonsolo_ppr`suf', keep(1 3) nogen
 23.     foreach v in n_last_ppr ppr_cnt_nonsolo {
 24.         replace `v' = 0 if mi(`v')
 25.     }
 26.     * Nonzero only if the panel was built with reduced_form's DROP_SOLO on, in
.     * which case ppr_cnt is already the non-solo count and the two are the same.
.     qui count if ppr_cnt != n_last_ppr
 27.     di as text "  rows where ppr_cnt != n_last_ppr (all-position panel): " r(N)
 28.     qui sum ppr_cnt_nonsolo
 29.     local ns_tot = r(sum)
 30.     qui sum ppr_cnt
 31.     local solo_shr = 100*(1 - `ns_tot'/r(sum))
 32.     di as text "  solo papers are " %5.2f `solo_shr' "% of last-author papers in this sample"
 33. 
.     cap drop athr_indicator
 34.     bys athr_id: gen athr_indicator = _n == 1
 35.     qui sum min_year_nonsolo if athr_indicator == 1, d
 36.     local nsmed = r(p50)
 37.     qui count if athr_indicator == 1 & mi(min_year_nonsolo)
 38.     local n_allsolo = r(N)
 39.     qui count if athr_indicator == 1
 40.     di as result _n "== all_jrnls`suf': min_year_nonsolo median = `nsmed'; `n_allsolo' of " ///
>         r(N) " PIs have no non-solo last-author paper =="
 41.     tabstat min_year min_year_nonsolo min_year_any min_year_any_ns if athr_indicator == 1, ///
>         stats(n mean p10 p25 p50 p75 p90) col(stat) format(%9.1f)
 42.     gen byte young_ns = min_year_nonsolo >  `nsmed' if !mi(min_year_nonsolo)
 43.     gen byte old_ns   = min_year_nonsolo <= `nsmed' if !mi(min_year_nonsolo)
 44.     qui count if athr_indicator == 1 & young != young_ns & !mi(young) & !mi(young_ns)
 45.     di as text "  PIs that switch side under the non-solo definition: " r(N)
 46. 
.     qui sum min_year_any if athr_indicator == 1, d
 47.     local anymed = r(p50)
 48.     di as text "  min_year_any (first pub ever) median = `anymed'"
 49.     gen byte young_any = min_year_any >  `anymed' if !mi(min_year_any)
 50.     gen byte old_any   = min_year_any <= `anymed' if !mi(min_year_any)
 51.     qui count if athr_indicator == 1 & young != young_any & !mi(young) & !mi(young_any)
 52.     di as text "  PIs that switch side under the first-pub-ever definition: " r(N)
 53. 
.     qui sum min_year_any_ns if athr_indicator == 1, d
 54.     local anynsmed = r(p50)
 55.     di as text "  min_year_any_ns (first non-solo pub, any position) median = `anynsmed'"
 56.     gen byte young_anyns = min_year_any_ns >  `anynsmed' if !mi(min_year_any_ns)
 57.     gen byte old_anyns   = min_year_any_ns <= `anynsmed' if !mi(min_year_any_ns)
 58.     qui count if athr_indicator == 1 & young_any != young_anyns & !mi(young_any) & !mi(young_anyns)
 59.     di as text "  PIs that switch side once solo papers are dropped from the career clock: " r(N)
 60. 
.     gen lab_age     = 2014 - min_year
 61.     gen lab_age_ns  = 2014 - min_year_nonsolo
 62.     gen career_age  = 2014 - min_year_any
 63. 
.     * Lab-age split dropping PIs whose first indexed paper was already
.     * last-authored (gap <= 0), for whom min_year cannot measure independence.
.     gen gap = min_year - min_year_any
 64.     qui count if athr_indicator == 1 & gap <= 0
 65.     local n_nogap = r(N)
 66.     qui count if athr_indicator == 1
 67.     di as text "  PIs with gap <= 0 (first paper is last-authored): `n_nogap' of " r(N)
 68.     qui sum min_year if athr_indicator == 1 & gap >= 1, d
 69.     local gapmed = r(p50)
 70.     gen byte young_g = min_year >  `gapmed' if !mi(min_year) & gap >= 1 & !mi(gap)
 71.     gen byte old_g   = min_year <= `gapmed' if !mi(min_year) & gap >= 1 & !mi(gap)
 72. 
.     * Young on both the lab-age and career-age clocks vs old on both; PIs the
.     * two clocks disagree on are missing and drop out of the fit.
.     gen byte young_both = young == 1 & young_any == 1 ///
>         if young == young_any & !mi(young) & !mi(young_any)
 73.     gen byte old_both   = young == 0 & young_any == 0 ///
>         if young == young_any & !mi(young) & !mi(young_any)
 74. 
.     gen post       = year >= 2014
 75.     gen Z_it       = exposure      * post
 76.     gen Z_share_it = mkt_spend_shr * post
 77. 
.     * ---- (1)/(3a) median splits
.     cap matrix drop SPLITS
 78.     local split_rows
 79.     local pairs `" "young old" "young_ns old_ns" "young_g old_g" "young_any old_any" "young_anyns old_anyns" "young_both old_both" "young_nih old_nih" "'
 80.     foreach pair of local pairs {
 81.         local g1 : word 1 of `pair'
 82.         local g2 : word 2 of `pair'
 83.         cap confirm variable `g1'
 84.         local rc1 = _rc
 85.         cap confirm variable `g2'
 86.         if `rc1' | _rc {
 87.             di as text "  `g1'/`g2' not built -- skipping pair."
 88.             continue
 89.         }
 90.         foreach yvar in ppr_cnt {
 91.             cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
 92.             gen Z_`g1' = Z_it       * `g1'
 93.             gen Z_`g2' = Z_it       * `g2'
 94.             gen S_`g1' = Z_share_it * `g1'
 95.             gen S_`g2' = Z_share_it * `g2'
 96.             gen PT_`g1' = post * `g1'
 97. 
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                 absorb(`fes') vce(cluster `vce_cl')
 98.             local rc = _rc
 99.             if `rc' {
100.                 di as error "test_young_old`suf' `yvar' `g1'/`g2': ppml failed (rc=`rc'); skipping."
101.                 continue
102.             }
103.             local b1  = _b[Z_`g1']
104.             local se1 = _se[Z_`g1']
105.             local b2  = _b[Z_`g2']
106.             local se2 = _se[Z_`g2']
107.             local Nfit = e(N)
108. 
.             lincom Z_`g1' - Z_`g2'
109.             local b_diff  = r(estimate)
110.             local se_diff = r(se)
111.             local p_diff  = r(p)
112.             local t_diff = `b_diff'/`se_diff'
113.             local p_one  = `p_diff'/2
114.             local se_ind = sqrt(`se1'^2 + `se2'^2)
115.             local p_ind  = 2*normal(-abs(`b_diff'/`se_ind'))
116. 
.             di as result _n "== all_jrnls`suf' `yvar' `g1' vs `g2' (N=`Nfit') =="
117.             di as text "  `g1': b=" %8.4f `b1' " (se=" %7.4f `se1' ")"
118.             di as text "  `g2': b=" %8.4f `b2' " (se=" %7.4f `se2' ")"
119.             di as text "  diff, joint VCE:  b=" %8.4f `b_diff' " se=" %7.4f `se_diff' ///
>                 " t=" %6.3f `t_diff' " p=" %6.4f `p_diff' " (one-sided " %6.4f `p_one' ")"
120.             di as text "  diff, indep. SEs: se=" %7.4f `se_ind' " p=" %6.4f `p_ind'
121. 
.             matrix SPLITS = nullmat(SPLITS) \ ///
>                 (`b1', `se1', `b2', `se2', `b_diff', `se_diff', `p_diff', `p_one', `Nfit')
122.             local split_rows `split_rows' `g1'
123.         }
124.     }
125. 
.     * ---- (2)/(3b) continuous age gradient: one coefficient, all PIs
.     foreach agevar in lab_age lab_age_ns career_age {
126.         cap confirm variable `agevar'
127.         if _rc {
128.             di as text "  `agevar' not built -- skipping gradient."
129.             continue
130.         }
131.         foreach yvar in ppr_cnt {
132.             cap drop age_c Z_age S_age PT_age
133.             qui sum `agevar' if athr_indicator == 1, d
134.             local age_mean = r(mean)
135.             gen age_c  = (`agevar' - `age_mean')/10
136.             gen Z_age  = Z_it       * age_c
137.             gen S_age  = Z_share_it * age_c
138.             gen PT_age = post       * age_c
139. 
.             cap noi ppmlhdfe `yvar' Z_it Z_age Z_share_it S_age PT_age, ///
>                 absorb(`fes') vce(cluster `vce_cl')
140.             local rc = _rc
141.             if `rc' {
142.                 di as error "test_young_old`suf' `yvar' `agevar' gradient: ppml failed (rc=`rc'); skipping."
143.                 continue
144.             }
145.             local Nfit = e(N)
146.             local b_z   = _b[Z_it]
147.             local se_z  = _se[Z_it]
148.             local b_ga  = _b[Z_age]
149.             local se_ga = _se[Z_age]
150.             local t_ga  = `b_ga'/`se_ga'
151.             local p_ga  = 2*normal(-abs(`t_ga'))
152.             local p_ga1 = `p_ga'/2
153. 
.             di as result _n "== all_jrnls`suf' `yvar' continuous gradient in `agevar' (N=`Nfit') =="
154.             di as text "  Z at mean lab age (" %4.1f `age_mean' " yrs): b=" %8.4f `b_z' ///
>                 " (se=" %7.4f `se_z' ")"
155.             di as text "  Z x lab age (per decade): b=" %8.4f `b_ga' " (se=" %7.4f `se_ga' ///
>                 ") t=" %6.3f `t_ga' " p=" %6.4f `p_ga' " (one-sided " %6.4f `p_ga1' ")"
156.         }
157.     }
158. 
.     * ---- (5) 2x2 career age x lab age. The two switcher cells disagree about
.     * which clock a PI is young on, so they identify which clock the effect
.     * actually follows.
.     cap drop yc_yl oc_ol oc_yl yc_ol
159.     gen byte yc_yl = (young_any == 1 & young == 1) if !mi(young_any) & !mi(young)
160.     gen byte oc_ol = (young_any == 0 & young == 0) if !mi(young_any) & !mi(young)
161.     gen byte oc_yl = (young_any == 0 & young == 1) if !mi(young_any) & !mi(young)
162.     gen byte yc_ol = (young_any == 1 & young == 0) if !mi(young_any) & !mi(young)
163.     foreach c in yc_yl oc_ol oc_yl yc_ol {
164.         qui count if athr_indicator == 1 & `c' == 1
165.         di as text "  cell `c': " r(N) " PIs"
166.     }
167.     foreach yvar in ppr_cnt {
168.         foreach c in yc_yl oc_ol oc_yl yc_ol {
169.             cap drop Z_`c' S_`c' PT_`c'
170.             gen Z_`c'  = Z_it       * `c'
171.             gen S_`c'  = Z_share_it * `c'
172.             gen PT_`c' = post       * `c'
173.         }
174.         cap noi ppmlhdfe `yvar' Z_yc_yl Z_oc_ol Z_oc_yl Z_yc_ol ///
>                                 S_yc_yl S_oc_ol S_oc_yl S_yc_ol ///
>                                 PT_yc_yl PT_oc_yl PT_yc_ol, ///
>             absorb(`fes') vce(cluster `vce_cl')
175.         local rc = _rc
176.         if `rc' {
177.             di as error "test_young_old`suf' `yvar' 2x2: ppml failed (rc=`rc'); skipping."
178.             continue
179.         }
180.         di as result _n "== all_jrnls`suf' `yvar' 2x2 career x lab age (N=" e(N) ") =="
181.         di as text "  young career, young lab : b=" %8.4f _b[Z_yc_yl] " (se=" %7.4f _se[Z_yc_yl] ")"
182.         di as text "  young career, OLD lab   : b=" %8.4f _b[Z_yc_ol] " (se=" %7.4f _se[Z_yc_ol] ")   <- gap 0"
183.         di as text "  OLD career, young lab   : b=" %8.4f _b[Z_oc_yl] " (se=" %7.4f _se[Z_oc_yl] ")   <- long apprenticeship"
184.         di as text "  OLD career, OLD lab     : b=" %8.4f _b[Z_oc_ol] " (se=" %7.4f _se[Z_oc_ol] ")"
185.         local clabs `" "career effect within young labs" "career effect within old labs" "lab effect within young careers" "lab effect within old careers" "unambiguous young vs old (switchers 
> dropped)" "'
186.         local cvars `" "Z_yc_yl Z_oc_yl" "Z_yc_ol Z_oc_ol" "Z_yc_yl Z_yc_ol" "Z_oc_yl Z_oc_ol" "Z_yc_yl Z_oc_ol" "'
187.         forval k = 1/5 {
188.             local dtxt  : word `k' of `clabs'
189.             local dpair : word `k' of `cvars'
190.             local v1 : word 1 of `dpair'
191.             local v2 : word 2 of `dpair'
192.             cap noi lincom `v1' - `v2'
193.             if _rc continue
194.             local b_d  = r(estimate)
195.             local se_d = r(se)
196.             local p_d  = r(p)
197.             di as text "  `dtxt': b=" %8.4f `b_d' " (se=" %7.4f `se_d' ") p=" %6.4f `p_d'
198.         }
199.     }
200. 
.     * ---- (4) horse race: both age measures in one fit
.     foreach yvar in ppr_cnt {
201.         cap drop lab_c car_c Z_lab Z_car S_lab S_car PT_lab PT_car
202.         qui sum lab_age if athr_indicator == 1, d
203.         local lab_mean = r(mean)
204.         qui sum career_age if athr_indicator == 1, d
205.         local car_mean = r(mean)
206.         gen lab_c  = (lab_age    - `lab_mean')/10
207.         gen car_c  = (career_age - `car_mean')/10
208.         gen Z_lab  = Z_it       * lab_c
209.         gen Z_car  = Z_it       * car_c
210.         gen S_lab  = Z_share_it * lab_c
211.         gen S_car  = Z_share_it * car_c
212.         gen PT_lab = post       * lab_c
213.         gen PT_car = post       * car_c
214. 
.         cap noi ppmlhdfe `yvar' Z_it Z_lab Z_car Z_share_it S_lab S_car PT_lab PT_car, ///
>             absorb(`fes') vce(cluster `vce_cl')
215.         local rc = _rc
216.         if `rc' {
217.             di as error "test_young_old`suf' `yvar' horse race: ppml failed (rc=`rc'); skipping."
218.             continue
219.         }
220.         local Nfit = e(N)
221.         local b_lab  = _b[Z_lab]
222.         local se_lab = _se[Z_lab]
223.         local b_car  = _b[Z_car]
224.         local se_car = _se[Z_car]
225.         local p_lab  = 2*normal(-abs(`b_lab'/`se_lab'))
226.         local p_car  = 2*normal(-abs(`b_car'/`se_car'))
227.         lincom Z_car - Z_lab
228.         local b_hr  = r(estimate)
229.         local se_hr = r(se)
230.         local p_hr  = r(p)
231.         * Reparametrised: lab_age = career_age - gap, so the fit is equivalent to
.         * (b_lab+b_car) on career age holding the apprenticeship gap fixed, and
.         * (-b_lab) on the gap itself.
.         lincom Z_lab + Z_car
232.         local b_cg  = r(estimate)
233.         local se_cg = r(se)
234.         local p_cg  = r(p)
235. 
.         di as result _n "== all_jrnls`suf' `yvar' horse race: lab age vs career age (N=`Nfit') =="
236.         di as text "  Z x lab age    (per decade): b=" %8.4f `b_lab' " (se=" %7.4f `se_lab' ") p=" %6.4f `p_lab'
237.         di as text "  Z x career age (per decade): b=" %8.4f `b_car' " (se=" %7.4f `se_car' ") p=" %6.4f `p_car'
238.         di as text "  career - lab: b=" %8.4f `b_hr' " (se=" %7.4f `se_hr' ") p=" %6.4f `p_hr'
239.         di as text "  career age holding gap fixed: b=" %8.4f `b_cg' " (se=" %7.4f `se_cg' ") p=" %6.4f `p_cg'
240.         local b_gap = -`b_lab'
241.         di as text "  apprenticeship gap (per decade): b=" %8.4f `b_gap' " (se=" %7.4f `se_lab' ") p=" %6.4f `p_lab'
242.     }
243. 
.     if "`split_rows'" != "" {
244.         matrix colnames SPLITS = b_young se_young b_old se_old b_diff se_diff p_diff p_1sided N
245.         matrix rownames SPLITS = `split_rows'
246.         di as result _n "== all_jrnls`suf' ppr_cnt: young - old summary across age splits =="
247.         matlist SPLITS, format(%9.4f) lines(oneline)
248.     }
249. }
