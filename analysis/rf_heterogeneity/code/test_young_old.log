.     * ---- (4) horse race: both age measures in one fit
.     foreach yvar in ppr_cnt {
201.         cap drop lab_c car_c Z_lab Z_car S_lab S_car PT_lab PT_car
202.         qui sum lab_age if athr_indicator == 1, d
203.         local lab_mean = r(mean)
204.         qui sum career_age if athr_indicator == 1, d
205.         local car_mean = r(mean)
206.         gen lab_c  = (lab_age    - `lab_mean')/10
207.         gen car_c  = (career_age - `car_mean')/10
208.         gen Z_lab  = Z_it       * lab_c
209.         gen Z_car  = Z_it       * car_c
210.         gen S_lab  = Z_share_it * lab_c
211.         gen S_car  = Z_share_it * car_c
212.         gen PT_lab = post       * lab_c
213.         gen PT_car = post       * car_c
214. 
.         cap noi ppmlhdfe `yvar' Z_it Z_lab Z_car Z_share_it S_lab S_car PT_lab PT
> _car, ///
>             absorb(`fes') vce(cluster `vce_cl')
215.         local rc = _rc
216.         if `rc' {
217.             di as error "test_young_old`suf' `yvar' horse race: ppml failed (r
> c=`rc'); skipping."
218.             continue
219.         }
220.         local Nfit = e(N)
221.         local b_lab  = _b[Z_lab]
222.         local se_lab = _se[Z_lab]
223.         local b_car  = _b[Z_car]
224.         local se_car = _se[Z_car]
225.         local p_lab  = 2*normal(-abs(`b_lab'/`se_lab'))
226.         local p_car  = 2*normal(-abs(`b_car'/`se_car'))
227.         lincom Z_car - Z_lab
228.         local b_hr  = r(estimate)
229.         local se_hr = r(se)
230.         local p_hr  = r(p)
231.         * Reparametrised: lab_age = career_age - gap, so the fit is equivalent
>  to
.         * (b_lab+b_car) on career age holding the apprenticeship gap fixed, and
.         * (-b_lab) on the gap itself.
.         lincom Z_lab + Z_car
232.         local b_cg  = r(estimate)
233.         local se_cg = r(se)
234.         local p_cg  = r(p)
235. 
.         di as result _n "== all_jrnls`suf' `yvar' horse race: lab age vs career a
> ge (N=`Nfit') =="
236.         di as text "  Z x lab age    (per decade): b=" %8.4f `b_lab' " (se=" %
> 7.4f `se_lab' ") p=" %6.4f `p_lab'
237.         di as text "  Z x career age (per decade): b=" %8.4f `b_car' " (se=" %
> 7.4f `se_car' ") p=" %6.4f `p_car'
238.         di as text "  career - lab: b=" %8.4f `b_hr' " (se=" %7.4f `se_hr' ") 
> p=" %6.4f `p_hr'
239.         di as text "  career age holding gap fixed: b=" %8.4f `b_cg' " (se=" %
> 7.4f `se_cg' ") p=" %6.4f `p_cg'
240.         local b_gap = -`b_lab'
241.         di as text "  apprenticeship gap (per decade): b=" %8.4f `b_gap' " (se
> =" %7.4f `se_lab' ") p=" %6.4f `p_lab'
242.     }
243. 
.     if "`split_rows'" != "" {
244.         matrix colnames SPLITS = b_young se_young b_old se_old b_diff se_diff 
> p_diff p_1sided N
