. local int_leads

. local mshr_leads

. local int_lags

. local mshr_lags

. forval i = 2/`abs_lead' {
  2.     local int_leads  int_lead`i'  `int_leads'
  3.     local mshr_leads mshr_lead`i' `mshr_leads'
  4. }

. forval i = 0/`abs_lag' {
  2.     local int_lags  `int_lags'  int_lag`i'
  3.     local mshr_lags `mshr_lags' mshr_lag`i'
  4. }

. 
. gen post       = year >= 2014

. gen Z_it       = exposure      * post

. gen Z_share_it = mkt_spend_shr * post

. 
. foreach pair of local pairs {
  2.     foreach grp of local pair {
  3.         qui sum `grp'
  4.         if r(N) == 0 | r(min) == r(max) {
  5.             di as error "run_age_nih: `grp' degenerate -- aborting."
  6.             exit 459
  7.         }
  8.         foreach v of local int_leads {
  9.             gen `v'_`grp' = `v' * `grp'
 10.             local leads_`grp' `leads_`grp'' `v'_`grp'
 11.         }
 12.         foreach v of local int_lags {
 13.             gen `v'_`grp' = `v' * `grp'
 14.             local lags_`grp' `lags_`grp'' `v'_`grp'
 15.         }
 16.         foreach v of local mshr_leads {
 17.             gen `v'_`grp' = `v' * `grp'
 18.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
 19.         }
 20.         foreach v of local mshr_lags {
 21.             gen `v'_`grp' = `v' * `grp'
 22.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
 23.         }
 24.         gen int_lead1_`grp' = int_lead1 * `grp'
 25.         gen Z_`grp'  = Z_it       * `grp'
 26.         gen S_`grp'  = Z_share_it * `grp'
 27.         gen PT_`grp' = post       * `grp'
 28.     }
 29. }
