. tempname ph

. postfile `ph' str30 yvar str24 grp str12 split_type ///
>     double(post_b post_se N r2_p n_pis) ///
>     using "../temp/age_nih_results", replace

. 
. foreach yvar of local yvars {
  2.     local ylab "`yvar'"
  3.     if "`yvar'" == "n_grants"       local ylab "Active NIH Research Grants"
  4.     if "`yvar'" == "nih_total_cost" local ylab "NIH Award Dollars"
  5. 
.     foreach pair of local pairs {
  6.         local g1 : word 1 of `pair'
  7.         local g2 : word 2 of `pair'
  8.         local st = cond("`g1'" == "young", "med_pi", "med_pi_nih")
  9. 
.         di as text _n "==== pooled DiD PPML: `yvar' `g1' vs `g2' ===="
 10.         cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>             absorb(`fes') vce(cluster `vce_cl')
 11.         if _rc {
 12.             di as error "run_age_nih: pooled DiD `yvar' `g1'/`g2' failed; skipping."
 13.             continue
 14.         }
 15.         local Nppml  = e(N)
 16.         local r2ppml = e(r2_p)
 17.         foreach grp in `g1' `g2' {
 18.             gunique athr_id if e(sample) & `grp' == 1
 19.             local n_pis = r(unique)
 20.             gunique inst_id if e(sample) & `grp' == 1
 21.             local n_insts = r(unique)
 22.             local b  = _b[Z_`grp']
 23.             local se = _se[Z_`grp']
 24.             di as text "PDID `yvar' `grp': b=" %8.4f `b' " se=" %8.4f `se' ///
>                 "  N=" %9.0f `Nppml' " PIs=`n_pis' Insts=`n_insts'"
 25.             post `ph' ("`yvar'") ("`grp'") ("`st'") ///
>                 (`b') (`se') (`Nppml') (`r2ppml') (`n_pis')
 26.         }
 27.         cap noi lincom Z_`g1' - Z_`g2'
 28.         if !_rc di as text "DIFF `yvar' `g1'-`g2': b=" %8.4f r(estimate) ///
>             " se=" %8.4f r(se) " p=" %6.4f r(p)
 29. 
.         di as text _n "==== event study PPML: `yvar' `g1' vs `g2' ===="
 30.         cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g2'' `lags_`g2'' ///
>             `mleads_`g1'' `mlags_`g1'' `mleads_`g2'' `mlags_`g2'' PT_`g1', ///
>             absorb(`fes') vce(cluster `vce_cl')
 31.         if _rc {
 32.             di as error "run_age_nih: ES `yvar' `g1'/`g2' failed; skipping plots."
 33.             continue
 34.         }
 35.         foreach grp in `g1' `g2' {
 36.             local grp_label = "${LBL_`grp'}"
 37.             gunique athr_id if e(sample) & `grp' == 1
 38.             local num_athrs = r(unique)
 39.             gunique inst_id if e(sample) & `grp' == 1
 40.             local num_insts = r(unique)
 41.             sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
 42.             local pre_mean : dis %6.3f r(mean)
 43.             preserve
 44.             cap mat drop es
 45.             foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
 46.                 if "`var'" == "int_lead1_`grp'" mat row = 0,0
 47.                 else mat row = _b[`var'], _se[`var']
 48.                 mat es = nullmat(es) \ row
 49.             }
 50.             svmat es
 51.             keep es1 es2
 52.             drop if mi(es1)
 53.             rename (es1 es2) (b se)
 54.             gen ub = b + 1.96*se
 55.             qui sum ub
 56.             local ymax = round(r(max), 0.1)
 57.             gen lb = b - 1.96*se
 58.             qui sum lb
 59.             local ymin = round(r(min), 0.1)
 60.             if `ymin' > 0 local ymin = 0
 61.             gen rel = -`abs_lead' if _n == 1
 62.             replace rel = rel[_n-1]+1 if _n > 1
 63.             replace rel = rel + 1 if rel >= -1
 64.             replace rel = -1 if rel == `abs_lag' + 1
 65.             gen year = rel + 2014
 66.             hashsort rel
 67.             tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                scatter b year, mcolor(ebblue) || ///
>             scatteri `ymax' 2013.75 `ymax' 2014.25, bcolor(gs12%30) recast(area) base(`ymin') ///
>                xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                ytitle("Exposure x Post") ylab(`ymin'(0.1)`ymax') ///
>                subtitle("`grp_label' -- `ylab'", pos(11) size(small)) ///
>                legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") ///
>                       pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>                yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
 68.             graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'_agenih.pdf, replace
 69.             restore
 70.         }
 71.     }
 72. }

