 opened on:   4 Aug 2026, 10:40:21

. 
. local samp   all_jrnls

. local sufs   _r1_r2 _r1_r2_public

. local fes    athr_id year

. local vce_cl athr_id

. local yvars  n_grants nih_total_cost

. local pairs `" "young old" "young_nih old_nih" "'

. 
. cap mkdir "../output/figures/`samp'"

. cap mkdir "../output/figures/`samp'/es_ppml"

. cap mkdir "../output/tables/`samp'"

. 
. global LBL_young     "Early-Career Scientists"

. global LBL_old       "Late-Career Scientists"

. global LBL_young_nih "Early-Career Scientists (NIH-Matched PIs)"

. global LBL_old_nih   "Late-Career Scientists (NIH-Matched PIs)"

. 
. foreach suf of local sufs {
  2. 
. di as text _n(2) "################ run_age_nih: `samp'`suf' ################"
  3. 
. cap confirm file ../temp/es_`samp'`suf'.dta
  4. if _rc {
  5.     di as error "run_age_nih: ../temp/es_`samp'`suf'.dta not found -- run add_het_splits for this sample first; skipping."
  6.     continue
  7. }
  8. use ../temp/es_`samp'`suf', clear
  9. 
. gen rel = year - 2014
 10. qui sum rel, d
 11. local abs_lag  = abs(r(max))
 12. local abs_lead = abs(r(min))
 13. 
. forval i = 1/`abs_lead' {
 14.     gen int_lead`i'  = exposure      if rel == -`i'
 15.     gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 16. }
 17. forval i = 0/`abs_lag' {
 18.     gen int_lag`i'  = exposure      if rel == `i'
 19.     gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 20. }
 21. ds int_lead* int_lag* mshr_lead* mshr_lag*
 22. foreach var in `r(varlist)' {
 23.     replace `var' = 0 if mi(`var')
 24. }
 25. local int_leads
 26. local mshr_leads
 27. local int_lags
 28. local mshr_lags
 29. forval i = 2/`abs_lead' {
 30.     local int_leads  int_lead`i'  `int_leads'
 31.     local mshr_leads mshr_lead`i' `mshr_leads'
 32. }
 33. forval i = 0/`abs_lag' {
 34.     local int_lags  `int_lags'  int_lag`i'
 35.     local mshr_lags `mshr_lags' mshr_lag`i'
 36. }
 37. 
. gen post       = year >= 2014
 38. gen Z_it       = exposure      * post
 39. gen Z_share_it = mkt_spend_shr * post
 40. 
. local skip 0
 41. foreach pair of local pairs {
 42.     foreach grp of local pair {
 43.         cap confirm variable `grp'
 44.         if _rc {
 45.             di as error "run_age_nih `suf': `grp' not in panel -- skipping this sample."
 46.             local skip 1
 47.             continue, break
 48.         }
 49.         qui sum `grp'
 50.         if r(N) == 0 | r(min) == r(max) {
 51.             di as error "run_age_nih `suf': `grp' degenerate -- skipping this sample."
 52.             local skip 1
 53.             continue, break
 54.         }
 55.         * cleared per suffix: these accumulate, and stale terms from the
.         * previous sample would enter the next sample's ES spec.
.         local leads_`grp'
 56.         local lags_`grp'
 57.         local mleads_`grp'
 58.         local mlags_`grp'
 59.         foreach v of local int_leads {
 60.             gen `v'_`grp' = `v' * `grp'
 61.             local leads_`grp' `leads_`grp'' `v'_`grp'
 62.         }
 63.         foreach v of local int_lags {
 64.             gen `v'_`grp' = `v' * `grp'
 65.             local lags_`grp' `lags_`grp'' `v'_`grp'
 66.         }
 67.         foreach v of local mshr_leads {
 68.             gen `v'_`grp' = `v' * `grp'
 69.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
 70.         }
 71.         foreach v of local mshr_lags {
 72.             gen `v'_`grp' = `v' * `grp'
 73.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
 74.         }
 75.         gen int_lead1_`grp' = int_lead1 * `grp'
 76.         gen Z_`grp'  = Z_it       * `grp'
 77.         gen S_`grp'  = Z_share_it * `grp'
 78.         gen PT_`grp' = post       * `grp'
 79.     }
 80.     if `skip' continue, break
 81. }
 82. if `skip' continue
 83. 
. tempname ph
 84. postfile `ph' str30 yvar str24 grp str12 split_type ///
>     double(post_b post_se N r2_p n_pis) ///
>     using "../temp/age_nih_results`suf'", replace
 85. 
. foreach yvar of local yvars {
 86.     local ylab "`yvar'"
 87.     if "`yvar'" == "n_grants"       local ylab "Active NIH Research Grants"
 88.     if "`yvar'" == "nih_total_cost" local ylab "NIH Award Dollars"
 89.     local gap = cond("`yvar'" == "nih_total_cost", 0.4, 0.1)
 90. 
.     foreach pair of local pairs {
 91.         local g1 : word 1 of `pair'
 92.         local g2 : word 2 of `pair'
 93.         local st = cond("`g1'" == "young", "med_pi", "med_pi_nih")
 94. 
.         di as text _n "==== pooled DiD PPML: `yvar' `g1' vs `g2' (`suf') ===="
 95.         cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>             absorb(`fes') vce(cluster `vce_cl')
 96.         if _rc {
 97.             di as error "run_age_nih`suf': pooled DiD `yvar' `g1'/`g2' failed; skipping."
 98.             continue
 99.         }
100.         local Nppml  = e(N)
101.         local r2ppml = e(r2_p)
102.         foreach grp in `g1' `g2' {
103.             gunique athr_id if e(sample) & `grp' == 1
104.             local n_pis = r(unique)
105.             gunique inst_id if e(sample) & `grp' == 1
106.             local n_insts = r(unique)
107.             local b  = _b[Z_`grp']
108.             local se = _se[Z_`grp']
109.             di as text "PDID `yvar' `grp': b=" %8.4f `b' " se=" %8.4f `se' ///
>                 "  N=" %9.0f `Nppml' " PIs=`n_pis' Insts=`n_insts'"
110.             post `ph' ("`yvar'") ("`grp'") ("`st'") ///
>                 (`b') (`se') (`Nppml') (`r2ppml') (`n_pis')
111.         }
112.         cap noi lincom Z_`g1' - Z_`g2'
113.         if !_rc di as text "DIFF `yvar' `g1'-`g2': b=" %8.4f r(estimate) ///
>             " se=" %8.4f r(se) " p=" %6.4f r(p)
114. 
.         di as text _n "==== event study PPML: `yvar' `g1' vs `g2' (`suf') ===="
115.         cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g2'' `lags_`g2'' ///
>             `mleads_`g1'' `mlags_`g1'' `mleads_`g2'' `mlags_`g2'' PT_`g1', ///
>             absorb(`fes') vce(cluster `vce_cl')
116.         if _rc {
117.             di as error "run_age_nih`suf': ES `yvar' `g1'/`g2' failed; skipping plots."
118.             continue
119.         }
120.         foreach grp in `g1' `g2' {
121.             local grp_label = "${LBL_`grp'}"
122.             gunique athr_id if e(sample) & `grp' == 1
123.             local num_athrs = r(unique)
124.             gunique inst_id if e(sample) & `grp' == 1
125.             local num_insts = r(unique)
126.             sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
127.             local pre_mean : dis %6.3f r(mean)
128.             if "`yvar'" == "nih_total_cost" ///
>                 local pre_mean = string(r(mean), "%12.0fc")
129.             preserve
130.             cap mat drop es
131.             foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
132.                 if "`var'" == "int_lead1_`grp'" mat row = 0,0
133.                 else mat row = _b[`var'], _se[`var']
134.                 mat es = nullmat(es) \ row
135.             }
136.             svmat es
137.             keep es1 es2
138.             drop if mi(es1)
139.             rename (es1 es2) (b se)
140.             gen ub = b + 1.96*se
141.             qui sum ub
142.             local ymax = round(r(max), `gap')
143.             gen lb = b - 1.96*se
144.             qui sum lb
145.             local ymin = round(r(min), `gap')
146.             if `ymin' > 0 local ymin = 0
147.             gen rel = -`abs_lead' if _n == 1
148.             replace rel = rel[_n-1]+1 if _n > 1
149.             replace rel = rel + 1 if rel >= -1
150.             replace rel = -1 if rel == `abs_lag' + 1
151.             gen year = rel + 2014
152.             hashsort rel
153.             tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                scatter b year, mcolor(ebblue) || ///
>             scatteri `ymax' 2013.75 `ymax' 2014.25, bcolor(gs12%30) recast(area) base(`ymin') ///
>                xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                ytitle("{&Delta} Log Expected `ylab'") ylab(`ymin'(`gap')`ymax') ///
>                subtitle("`grp_label' -- `ylab'", pos(11) size(small)) ///
>                legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") ///
>                       pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>                yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
154.             graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'_agenih.pdf, replace
155.             restore
156.         }
157.     }
158. }
159. postclose `ph'
160. 
. use ../temp/age_nih_results`suf', clear
161. di as text _n "==== age_nih_results`suf' ===="
162. list, sepby(yvar) noobs
163. export delimited using "../output/tables/`samp'/age_nih_results`suf'.txt", replace delim(tab)
164. 
. }


