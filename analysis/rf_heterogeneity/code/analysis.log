417.                         local all_lags  `all_lags'  `lags_`grp''
418.                         local all_mshr  `all_mshr'  `mleads_`grp'' `mlags_`grp''
419.                     }
420.                     local plot_suf "_ppml_`aspec'_mshrctrl"
421.                     cap noi ppmlhdfe `yvar' `all_leads' `all_lags' ///
>                                             `all_mshr' `PTs', ///
>                                             absorb(`fes') vce(cluster `vce_cl')
422.                     if _rc {
423.                         di as error "event_study_het `samp'`suf' `yvar' `aspec' joint ES for PDFs failed; skipping ES plots."
424.                     }
425.                     else {
426.                         foreach grp of local agrps {
427.                             local grp_label = "${LBL_`grp'}"
428.                             if "`grp_label'" == "" local grp_label "`grp'"
429.                             gunique athr_id if e(sample) & `grp' == 1
430.                             local num_athrs = r(unique)
431.                             gunique inst_id if e(sample) & `grp' == 1
432.                             local num_insts = r(unique)
433.                             sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
434.                             local pre_mean : dis %4.3f r(mean)
435.                             preserve
436.                             cap mat drop es
437.                             foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
438.                                 if "`var'" == "int_lead1_`grp'" {
439.                                     mat row = 0,0
440.                                 }
441.                                 else {
442.                                     mat row = _b[`var'], _se[`var']
443.                                 }
444.                                 mat es = nullmat(es) \ row
445.                             }
446.                             svmat es
447.                             keep es1 es2
448.                             drop if mi(es1)
449.                             rename (es1 es2) (b se)
450.                             gen ub = b + 1.96*se
451.                             gen lb = b - 1.96*se
452.                             local ymax = 1.2
453.                             local ymin = -2.2
454.                             local pgap 0.2
455.                             gen rel = -`abs_lead' if _n == 1
456.                             replace rel = rel[_n-1]+1 if _n > 1
457.                             replace rel = rel + 1 if rel >= -1
458.                             replace rel = -1 if rel == `abs_lag' + 1
459.                             gen year = rel + 2014
460.                             hashsort rel
461.                             local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. insts: `num_insts'" "Pre-period avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
462.                             local fdir ../output/figures/`samp'/es_ppml
463.                             foreach fmode of global FIG_MODES {
464.                                 if "`fmode'" == "paper" {
465.                                     local stats_leg legend(off)
466.                                     cap mkdir "`fdir'"
467.                                 }
468.                                 tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                                   scatter b year, mcolor(ebblue) || ///
>                                 scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                                   xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                                   ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                                   `stats_leg' ///
>                                   yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
469.                                 fig_export, path("`fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf") mode(`fmode')
470.                             }
471.                             save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
472.                             restore
473.                         }
474.                     }
475.                 }
476.                 }
477.             }
478. 
.             local qmethods
479.             if "$HET_RUN_QUARTILES" == "1" local qmethods pw
480.             if "$HET_RUN_QUARTILES" == "1" & "$HET_INCLUDE_INSTWTD" == "1" local qmethods inst pw
481.             foreach qmethod of local qmethods {
482.             local quart_all
483.             if "`qmethod'" == "inst" {
484.                 foreach pair of global IC_PAIRS_Q {
485.                     local quart_all `"`quart_all' `"`pair'"' "'
486.                 }
487.                 local st_tag "quart"
488.                 local qplot_suf "_ppml_q_mshrctrl"
489.             }
490.             else {
491.                 foreach pair of global IC_PAIRS_Q_PW {
492.                     local quart_all `"`quart_all' `"`pair'"' "'
493.                 }
494.                 local st_tag "quart_pi"
495.                 local qplot_suf "_ppml_qpi_mshrctrl"
496.             }
497.             foreach pair of global PI_PAIRS_Q {
498.                 local quart_all `"`quart_all' `"`pair'"' "'
499.             }
500.             foreach pair of local quart_all {
501.                 local g1: word 1 of `pair'
502.                 local g2: word 2 of `pair'
503.                 if substr("`g1'", 1, 4) == "q4w_" {
504.                     local base = substr("`g1'", 5, .)
505.                     local gm "midw_`base'"
506.                 }
507.                 else {
508.                     local base = substr("`g1'", 4, .)
509.                     local gm "mid_`base'"
510.                 }
511.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
512.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
513.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `gm' ") == 0 continue
514. 
.                 cap drop Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm'
515.                 gen Z_`g1' = Z_it       * `g1'
516.                 gen Z_`g2' = Z_it       * `g2'
517.                 gen Z_`gm' = Z_it       * `gm'
518.                 gen S_`g1' = Z_share_it * `g1'
519.                 gen S_`g2' = Z_share_it * `g2'
520.                 gen S_`gm' = Z_share_it * `gm'
521.                 gen PT_`g1' = post * `g1'
522.                 gen PT_`gm' = post * `gm'
523.                 if "`yvar'" == "nih_total_cost" {
524.                     preserve
525.                     nih_award_period_means
526.                 }
527.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm', ///
>                                         absorb(`pooled_fes') vce(cluster `pooled_vce_cl')
528.                 local rc = _rc
529.                 if `rc' {
530.                     if "`yvar'" == "nih_total_cost" restore
531.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
532.                     continue
533.                 }
534.                 local Nppml = e(N)
535.                 local r2ppml = e(r2_p)
536.                 foreach grp in `g1' `g2' {
537.                     gunique athr_id if e(sample) & `grp' == 1
538.                     local num_athrs = r(unique)
539.                     gunique inst_id if e(sample) & `grp' == 1
540.                     local num_insts = r(unique)
541.                     local b_post  = _b[Z_`grp']
542.                     local se_post = _se[Z_`grp']
543.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
544.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
545.                 }
546. 
.                 if "`yvar'" == "nih_total_cost" restore
547.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' ///
>                                  `mleads_`g2'' `mlags_`g2'' ///
>                                  `mleads_`gm'' `mlags_`gm''
548.                 local plot_suf "`qplot_suf'"
549.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' ///
>                                         `leads_`g2'' `lags_`g2'' ///
>                                         `leads_`gm'' `lags_`gm'' ///
>                                         `mshr_ctrls' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
550.                 if _rc {
551.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
552.                     continue
553.                 }
554.                 foreach grp in `g1' `g2' {
555.                     local grp_label = "${LBL_`grp'}"
556.                     if "`grp_label'" == "" local grp_label "`grp'"
557.                     gunique athr_id if e(sample) & `grp' == 1
558.                     local num_athrs = r(unique)
559.                     gunique inst_id if e(sample) & `grp' == 1
560.                     local num_insts = r(unique)
561.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
562.                     local pre_mean : dis %4.3f r(mean)
563.                     preserve
564.                     cap mat drop es
565.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
566.                         if "`var'" == "int_lead1_`grp'" {
567.                             mat row = 0,0
568.                         }
569.                         else {
570.                             mat row = _b[`var'], _se[`var']
571.                         }
572.                         mat es = nullmat(es) \ row
573.                     }
574.                     svmat es
575.                     keep es1 es2
576.                     drop if mi(es1)
577.                     rename (es1 es2) (b se)
578.                     gen ub = b + 1.96*se
579.                     gen lb = b - 1.96*se
580.                     local ymax = 1.2
581.                     local ymin = -2.2
582.                     local pgap 0.2
583.                     gen rel = -`abs_lead' if _n == 1
584.                     replace rel = rel[_n-1]+1 if _n > 1
585.                     replace rel = rel + 1 if rel >= -1
586.                     replace rel = -1 if rel == `abs_lag' + 1
587.                     gen year = rel + 2014
588.                     hashsort rel
589.                     local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. insts: `num_insts'" "Pre-period avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
590.                     local fdir ../output/figures/`samp'/es_ppml
591.                     foreach fmode of global FIG_MODES {
592.                         if "`fmode'" == "paper" {
593.                             local stats_leg legend(off)
594.                             cap mkdir "`fdir'"
595.                         }
596.                         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                           scatter b year, mcolor(ebblue) || ///
>                         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                           xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                           ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                           `stats_leg' ///
>                           yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
597.                         fig_export, path("`fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf") mode(`fmode')
598.                     }
599.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
600.                     restore
601.                 }
602.             }
603.             }
604. 
.             foreach a of global JOINT_AE_CHARS {
605.                 cap confirm variable y_hi_`a'
606.                 if _rc continue
607.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
608.                     cap drop Z_`grp' S_`grp' PT_`grp'
609.                     gen Z_`grp' = Z_it       * `grp'
610.                     gen S_`grp' = Z_share_it * `grp'
611.                     gen PT_`grp' = post * `grp'
612.                 }
613.                 if "`yvar'" == "nih_total_cost" {
614.                     preserve
615.                     nih_award_period_means
616.                 }
617.                 cap noi ppmlhdfe `yvar' Z_y_hi_`a' Z_y_lo_`a' Z_o_hi_`a' Z_o_lo_`a' ///
>                                         S_y_hi_`a' S_y_lo_`a' S_o_hi_`a' S_o_lo_`a' ///
>                                         PT_y_hi_`a' PT_y_lo_`a' PT_o_hi_`a', ///
>                                         absorb(`pooled_fes') vce(cluster `pooled_vce_cl')
618.                 if _rc {
619.                     if "`yvar'" == "nih_total_cost" restore
620.                     di as error "event_study_het `samp'`suf' `yvar' joint-ae `a' ppml failed; skipping."
621.                     continue
622.                 }
623.                 local Nppml = e(N)
624.                 local r2ppml = e(r2_p)
625.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
626.                     gunique athr_id if e(sample) & `grp' == 1
627.                     local num_athrs = r(unique)
628.                     gunique inst_id if e(sample) & `grp' == 1
629.                     local num_insts = r(unique)
630.                     local b_post  = _b[Z_`grp']
631.                     local se_post = _se[Z_`grp']
632.                     di as text "joint-ae PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
633.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_ae") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
634.                 }
635.                 foreach age in y o {
636.                     cap noi lincom Z_`age'_hi_`a' - Z_`age'_lo_`a'
637.                     if _rc continue
638.                     local b_diff  = r(estimate)
639.                     local se_diff = r(se)
640.                     local p_diff  = r(p)
641.                     di as text "joint-ae DIFF `samp'`suf' `yvar' `age'_`a': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
642.                     post `ph_handle' ("`yvar'") ("`age'_diff_`a'") ("mshrctrl") ("joint_ae_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
643.                 }
644.                 foreach hl in hi lo {
645.                     cap noi lincom Z_o_`hl'_`a' - Z_y_`hl'_`a'
646.                     if _rc continue
647.                     local b_gap  = r(estimate)
648.                     local se_gap = r(se)
649.                     local p_gap  = r(p)
650.                     di as text "joint-ae GAP `samp'`suf' `yvar' `hl'_`a' (late - early): b=" %8.4f `b_gap' ///
>                         " (se=" %8.4f `se_gap' ") p=" %6.4f `p_gap'
651.                     post `ph_handle' ("`yvar'") ("`hl'_gap_`a'") ("mshrctrl") ("joint_ae_gap") ///
>                         (`b_gap') (`se_gap') (`p_gap') (.) (`Nppml') (`r2ppml')
652.                 }
653.                 if "`yvar'" == "nih_total_cost" restore
654.             }
655. 
.         }
656.         postclose `ph_handle'
657. 
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
658.             cap noi ppml_pdid_het_binscatter, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
659.         }
660.         cap noi ppml_het_coefplot, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
661.     }
662. 
.     preserve
663.     clear
664.     foreach yvar of local yvar_list {
665.         cap append using ../temp/phet_results_`samp'`suf'_`yvar'
666.     }
667.     save ../temp/phet_results_`samp'`suf', replace
668.     restore
669. end

. 
. program ppml_pdid_het_binscatter
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     if "`yvar'" == "" local yvar ppr_cnt
  3.     local fes athr_id year
  4.     local vce_cl athr_id
  5.     if "$FE_MODE" == "inst_cluster" {
  6.         local fes inst_id cluster_30 year
  7.         local vce_cl inst_id
  8.     }
  9.     if "$FE_MODE" == "inst_cluster_fldyr" {
 10.         local fes inst_id i.cluster_30#i.year
 11.         local vce_cl inst_id
 12.     }
 13.     local suf ""
 14.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 15.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 16.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 17.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 18.     cap mkdir "../output/figures/`samp'/ppml_pdid_het_bs"
 19. 
.     local bs_lbl "`yvar'"
 20.     if "`yvar'" == "ppr_cnt"           local bs_lbl "publications"
 21.     if "`yvar'" == "cite_affl_wt"      local bs_lbl "citation-weighted output"
 22.     if "`yvar'" == "avg_num_coathrs"   local bs_lbl "coauthors"
 23.     if "`yvar'" == "n_grants"          local bs_lbl "active NIH research grants"
 24.     if "`yvar'" == "n_new_grants"      local bs_lbl "new NIH research grants"
 25.     if "`yvar'" == "nih_total_cost"    local bs_lbl "NIH award dollars"
 26.     if "`yvar'" == "n_middle_ppr"      local bs_lbl "middle-author papers"
 27.     if "`yvar'" == "ppr_cnt_nonsolo"   local bs_lbl "publications (excl. solo)"
 28. 
.     local dummy_pairs `" "young old" "young_ns old_ns" "young_any old_any" "young_nih old_nih" "young_surv old_surv" "young_sb old_sb" "y_longtrain y_shorttrain" "r1 r2" "pub_inst priv_inst" "high_nihg low_nihg" "high_nihd low_nihd" "new_lab est_lab" "b
> ig_msa small_msa" "yhigh_nihd ylow_nihd" "yq4_nihd yq1_nihd" ${IC_PAIRS_MED_PW} "'
 29.     if "$HET_INCLUDE_INSTWTD" == "1" local dummy_pairs `" `dummy_pairs' ${IC_PAIRS_MED} "'
 30. 
.     preserve
 31.         use ../temp/es_`samp'`suf', clear
 32.         gen post       = year >= 2014
 33.         gen Z_it       = exposure      * post
 34.         gen Z_share_it = mkt_spend_shr * post
 35.         if "`yvar'" == "nih_total_cost" {
 36.             nih_award_period_means
 37.             local fes athr_id year
 38.             local vce_cl athr_id
 39.             local bs_lbl "average annual NIH award dollars"
 40.         }
 41. 
.         foreach pair of local dummy_pairs {
 42.             local g1 : word 1 of `pair'
 43.             local g2 : word 2 of `pair'
 44. 
.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
 45.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
 46. 
.             foreach v in Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1' _mu _z_work _dvar _fwlw _y_r _Z_r {
 47.                 cap drop `v'
 48.             }
 49.             gen Z_`g1' = Z_it       * `g1'
 50.             gen Z_`g2' = Z_it       * `g2'
 51.             gen S_`g1' = Z_share_it * `g1'
 52.             gen S_`g2' = Z_share_it * `g2'
 53.             gen PT_`g1' = post * `g1'
 54. 
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
 55.             local rc = _rc
 56.             if `rc' {
 57.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `g1'/`g2' joint failed (rc=`rc'); skipping pair."
 58.                 continue
 59.             }
 60.             local b_`g1'  = _b[Z_`g1']
 61.             local se_`g1' = _se[Z_`g1']
 62.             local b_`g2'  = _b[Z_`g2']
 63.             local se_`g2' = _se[Z_`g2']
 64. 
.             predict double _mu, mu
 65.             gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
 66.             gen double _fwlw = _mu if !mi(_mu) & _mu > 0
 67. 
.             foreach grp in `g1' `g2' {
 68.                 local other = cond("`grp'" == "`g1'", "`g2'", "`g1'")
 69. 
.                 foreach v in _y_r _Z_r {
 70.                     cap drop `v'
 71.                 }
 72.                 cap noi qui reghdfe _z_work Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_y_r)
 73.                 if _rc == 0 cap noi qui reghdfe Z_`grp' Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_Z_r)
 74.                 if _rc {
 75.                     di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
 76.                     continue
 77.                 }
 78.                 gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 79.                 local n_pis = r(unique)
 80.                 gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 81.                 local n_insts = r(unique)
 82.                 local b_str  : dis %7.3f `b_`grp''
 83.                 local se_str : dis %7.3f `se_`grp''
 84.                 local bs_note `"note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
 85.                 local fdir ../output/figures/`samp'/ppml_pdid_het_bs
 86.                 foreach fmode of global FIG_MODES {
 87.                     if "`fmode'" == "paper" {
 88.                         local bs_note `"note("{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
 89.                         cap mkdir "`fdir'"
 90.                     }
 91.                     binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                         xtitle("Exposure x post") ///
>                         ytitle("{&Delta} log expected `bs_lbl'") ysc(titlegap(0) outergap(0)) ///
>                         xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                         msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                         `bs_note' ///
>                         plotregion(margin(sides))
 92.                     fig_export, path("`fdir'/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf") mode(`fmode')
 93.                 }
 94.             }
 95.         }
 96. 
.         foreach aspec in age3 ageq4 {
 97.             if "`aspec'" == "age3"  local agrps lab_lt10 lab_10_20 lab_20p
 98.             if "`aspec'" == "ageq4" local agrps q1_labage q2_labage q3_labage q4_labage
 99.             local aok 1
100.             foreach grp of local agrps {
101.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `grp' ") == 0 local aok 0
102.             }
103.             if `aok' {
104.             foreach v in _mu _z_work _dvar _fwlw _y_r _Z_r {
105.                 cap drop `v'
106.             }
107.             local nb : word count `agrps'
108.             local abase : word `nb' of `agrps'
109.             local Zs
110.             local Ss
111.             local PTs
112.             foreach grp of local agrps {
113.                 cap drop Z_`grp'
114.                 cap drop S_`grp'
115.                 cap drop PT_`grp'
116.                 gen Z_`grp' = Z_it       * `grp'
117.                 gen S_`grp' = Z_share_it * `grp'
118.                 local Zs `Zs' Z_`grp'
119.                 local Ss `Ss' S_`grp'
120.                 if "`grp'" != "`abase'" {
121.                     gen PT_`grp' = post * `grp'
122.                     local PTs `PTs' PT_`grp'
123.                 }
124.             }
125. 
.             cap noi ppmlhdfe `yvar' `Zs' `Ss' `PTs', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
126.             local rc = _rc
127.             if `rc' {
128.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `aspec' joint failed (rc=`rc'); skipping."
129.             }
130.             else {
131.                 foreach grp of local agrps {
132.                     local b_`grp'  = _b[Z_`grp']
133.                     local se_`grp' = _se[Z_`grp']
134.                 }
135. 
.                 predict double _mu, mu
136.                 gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
137.                 gen double _fwlw = _mu if !mi(_mu) & _mu > 0
138. 
.                 foreach grp of local agrps {
139.                     local others
140.                     foreach o of local agrps {
141.                         if "`o'" != "`grp'" local others `others' Z_`o'
142.                     }
143.                     foreach v in _y_r _Z_r {
144.                         cap drop `v'
145.                     }
146.                     cap noi qui reghdfe _z_work `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_y_r)
147.                     if _rc == 0 cap noi qui reghdfe Z_`grp' `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_Z_r)
148.                     if _rc {
149.                         di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
150.                         continue
151.                     }
152.                     gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
153.                     local n_pis = r(unique)
154.                     gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
155.                     local n_insts = r(unique)
156.                     local b_str  : dis %7.3f `b_`grp''
157.                     local se_str : dis %7.3f `se_`grp''
158.                     local bs_note `"note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
159.                     local fdir ../output/figures/`samp'/ppml_pdid_het_bs
160.                     foreach fmode of global FIG_MODES {
161.                         if "`fmode'" == "paper" {
162.                             local bs_note `"note("{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
163.                             cap mkdir "`fdir'"
164.                         }
165.                         binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                             xtitle("Exposure x post") ///
>                             ytitle("{&Delta} log expected `bs_lbl'") ysc(titlegap(0) outergap(0)) ///
>                             xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                             msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                             `bs_note' ///
>                             plotregion(margin(sides))
166.                         fig_export, path("`fdir'/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf") mode(`fmode')
167.                     }
168.                 }
169.             }
170.             }
171.         }
172.     restore
173. end

. 
. program ppml_age_gradient
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     cap mkdir "../output/figures/`samp'"
 18. 
.     local yvar_list ppr_cnt cite_affl_wt
 19.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 20.     local ppml_skip avg_position avg_team_size_last avg_team_size_notlast
 21. 
.     use ../temp/es_`samp'`suf', clear
 22.     gen post       = year >= 2014
 23.     gen Z_it       = exposure      * post
 24.     gen Z_share_it = mkt_spend_shr * post
 25. 
.     local binw = $HET_AGE_BINW
 26.     foreach agevar in lab_age_any_2014 lab_age_2014 lab_age_ns_2014 {
 27.     cap confirm variable `agevar'
 28.     if _rc {
 29.         di as error "ppml_age_gradient `samp'`suf': `agevar' not in panel -- skipped."
 30.         continue
 31.     }
 32.     local gpfx labanygrad
 33.     local gtmp lab_any_gradient
 34.     local gxtit "Years since first publication in 2014"
 35.     if "`agevar'" == "lab_age_2014" {
 36.         local gpfx labgrad
 37.         local gtmp lab_gradient
 38.         local gxtit "Years running lab in 2014"
 39.     }
 40.     if "`agevar'" == "lab_age_ns_2014" {
 41.         local gpfx labnsgrad
 42.         local gtmp lab_ns_gradient
 43.         local gxtit "Years running lab in 2014 (excl. solo papers)"
 44.     }
 45.     cap drop agebin
 46.     gen _agebin_pi = floor(min(max(`agevar', 0), $HET_AGE_TOPCODE) / `binw') + 1 if athr_indicator == 1
 47.     bys athr_id: egen agebin = max(_agebin_pi)
 48.     drop _agebin_pi
 49.     qui sum agebin if athr_indicator == 1
 50.     local K = r(max)
 51.     while `K' > 1 {
 52.         gunique athr_id if agebin == `K' & athr_indicator == 1
 53.         if r(unique) >= $HET_AGE_BIN_MINPI continue, break
 54.         replace agebin = `K' - 1 if agebin == `K'
 55.         local --K
 56.     }
 57. 
.     local zvars
 58.     local svars
 59.     local bins_used
 60.     forval k = 1/`K' {
 61.         qui count if agebin == `k' & athr_indicator == 1
 62.         if r(N) == 0 {
 63.             di as error "ppml_age_gradient `samp'`suf': age bin `k' empty -- skipped."
 64.             continue
 65.         }
 66.         cap drop Z_a`k'
 67.         cap drop S_a`k'
 68.         gen Z_a`k' = Z_it       * (agebin == `k')
 69.         gen S_a`k' = Z_share_it * (agebin == `k')
 70.         local zvars `zvars' Z_a`k'
 71.         local svars `svars' S_a`k'
 72.         local bins_used `bins_used' `k'
 73.     }
 74.     local ptvars
 75.     local nb : word count `bins_used'
 76.     forval i = 1/`=`nb'-1' {
 77.         local k : word `i' of `bins_used'
 78.         cap drop PT_a`k'
 79.         gen PT_a`k' = post * (agebin == `k')
 80.         local ptvars `ptvars' PT_a`k'
 81.     }
 82. 
.     foreach yvar of local yvar_list {
 83.         if strpos(" `ppml_skip' ", " `yvar' ") > 0 {
 84.             di as text "ppml_age_gradient: `yvar' not a count outcome -- skipped."
 85.             continue
 86.         }
 87.         local pooled_fes `fes'
 88.         local pooled_vce_cl `vce_cl'
 89.         if "`yvar'" == "nih_total_cost" {
 90.             * Plotting below already uses preserve/restore in this program.
.             tempfile annual_nih_age
 91.             quietly save `annual_nih_age', replace
 92.             nih_award_period_means
 93.             local pooled_fes athr_id year
 94.             local pooled_vce_cl athr_id
 95.         }
 96.         local ppml_ytit "Output-cost elasticity"
 97.         if "`yvar'" == "n_grants"       local ppml_ytit "{&Delta} log expected active NIH research grants"
 98.         if "`yvar'" == "n_new_grants"   local ppml_ytit "{&Delta} log expected new NIH research grants"
 99.         if "`yvar'" == "nih_total_cost" local ppml_ytit "{&Delta} log expected average annual NIH award dollars"
100. 
.         cap noi ppmlhdfe `yvar' `zvars' `svars' `ptvars' if !mi(agebin), ///
>             absorb(`pooled_fes') vce(cluster `pooled_vce_cl')
101.         local rc = _rc
102.         if `rc' {
103.             if "`yvar'" == "nih_total_cost" use `annual_nih_age', clear
104.             di as error "ppml_age_gradient `samp'`suf' `yvar' failed (rc=`rc'); skipping."
105.             continue
106.         }
107.         gunique athr_id if e(sample)
108.         local n_pis = r(unique)
109.         gunique inst_id if e(sample)
110.         local n_insts = r(unique)
111.         cap mat drop AG
112.         foreach k of local bins_used {
113.             if _se[Z_a`k'] == 0 {
114.                 di as error "ppml_age_gradient `samp'`suf' `yvar': Z_a`k' dropped/degenerate -- omitted from plot."
115.                 continue
116.             }
117.             qui sum `agevar' if athr_indicator == 1 & agebin == `k'
118.             mat AG = nullmat(AG) \ (`k', r(mean), (`k' - 0.5) * `binw', r(N), _b[Z_a`k'], _se[Z_a`k'])
119.         }
120.         preserve
121.         clear
122.         svmat AG
123.         rename (AG1 AG2 AG3 AG4 AG5 AG6) (bin age_mean age_mid n_pis b se)
124.         gen ub = b + 1.96*se
125.         gen lb = b - 1.96*se
126.         save ../temp/`gtmp'_`samp'`suf'_`yvar', replace
127.         qui reg b age_mid [aw=1/(se*se)]
128.         local slope_lbl = "Slope: " + strtrim(string(_b[age_mid], "%7.3f")) + " (" + strtrim(string(_se[age_mid], "%7.3f")) + ")"
129.         local xlab
130.         forval i = 1/`=_N' {
131.             local k = bin[`i']
132.             local lo = (`k' - 1) * `binw'
133.             if `k' == `K' local xlab `xlab' `=age_mid[`i']' "`lo'+"
134.             else          local xlab `xlab' `=age_mid[`i']' "`lo'-`=`lo' + `binw' - 1'"
135.         }
136.         local ygap 0.3
137.         qui sum ub
138.         local ymax : di %5.2f ceil(r(max) / `ygap') * `ygap'
139.         qui sum lb
140.         local ymin : di %5.2f floor(r(min) / `ygap') * `ygap'
141.         if `ymin' > 0 local ymin = 0
142.         if `ymax' < 0 local ymax = 0
143.         local stats_leg `"legend(on order(- "Num. PIs: `n_pis'" "Num. insts: `n_insts'" "`slope_lbl'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
144.         local fdir ../output/figures/`samp'
145.         foreach fmode of global FIG_MODES {
146.             if "`fmode'" == "paper" {
147.                 local stats_leg `"legend(on order(- "`slope_lbl'") pos(7) ring(1) rows(1) bmargin(zero) size(small))"'
148.                 cap mkdir "`fdir'"
149.             }
150.             local slope_col = cond("`fmode'" == "paper", "gs8", "dkorange")
151.             tw rcap ub lb age_mid, lcolor(ebblue%70) msize(vsmall) || ///
>                scatter b age_mid, mcolor(ebblue) || ///
>                lfit b age_mid [aw=1/(se*se)], lcolor(`slope_col') lpattern(dash) ///
>                xlab(`xlab', noticks) xsc(r(0 `=`K' * `binw'')) xtitle("`gxtit'") ytitle("`ppml_ytit'") ysc(titlegap(1) outergap(0)) ///
>                ylab(`ymin'(`ygap')`ymax') ///
>                yline(0, lcolor(gs10) lpattern(solid)) ///
>                `stats_leg' ///
>                plotregion(margin(sides))
152.             fig_export, path("`fdir'/`gpfx'_`yvar'`suf'_ppml_mshrctrl.pdf") mode(`fmode')
153.         }
154.         restore
155.         if "`yvar'" == "nih_total_cost" use `annual_nih_age', clear
156.     }
157.     }
158. end

. 
. program desc_exposure_by_age
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir "../output/figures/`samp'"
  8. 
.     use ../temp/es_`samp'`suf', clear
  9.     cap confirm variable nih_pi
 10.     if _rc gen byte nih_pi = .
 11.     egen long inst_num = group(inst_id)
 12.     gcollapse (firstnm) exposure young nih_pi inst_num, by(athr_id)
 13.     drop if mi(young) | mi(exposure)
 14. 
.     local tag_all ""
 15.     local tag_nih "_nih"
 16.     local cond_all "1"
 17.     local cond_nih "nih_pi == 1"
 18.     foreach s in all nih {
 19.         qui count if `cond_`s'' & young == 1
 20.         local n_y = r(N)
 21.         qui count if `cond_`s'' & young == 0
 22.         local n_o = r(N)
 23.         if `n_y' == 0 | `n_o' == 0 {
 24.             di as error "desc_exposure_by_age `samp'`suf' [`s']: empty group -- SKIPPED."
 25.             continue
 26.         }
 27.         qui sum exposure if `cond_`s'' & young == 1, d
 28.         local mu_y = strtrim(string(r(mean), "%6.3f"))
 29.         local md_y = strtrim(string(r(p50),  "%6.3f"))
 30.         qui sum exposure if `cond_`s'' & young == 0, d
 31.         local mu_o = strtrim(string(r(mean), "%6.3f"))
 32.         local md_o = strtrim(string(r(p50),  "%6.3f"))
 33.         di as text _n "desc_exposure_by_age `samp'`suf' [`s']: N young = `n_y' (mean=`mu_y' p50=`md_y'), N old = `n_o' (mean=`mu_o' p50=`md_o')"
 34.         cap noi ksmirnov exposure if `cond_`s'', by(young)
 35.         qui reg exposure young if `cond_`s'', vce(cluster inst_num)
 36.         di as text "  young-old diff = " %8.4f _b[young] " (se " %8.4f _se[young] ")"
 37. 
.         qui sum exposure if `cond_`s'', d
 38.         local xcap = r(p99)
 39.         cap drop _kx _kd_y _kd_o _kd_c
 40.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 41.         kdensity exposure if `cond_`s'' & young == 1 & exposure <= `xcap', at(_kx) gen(_kd_y) nograph
 42.         kdensity exposure if `cond_`s'' & young == 0 & exposure <= `xcap', at(_kx) gen(_kd_o) nograph
 43.         gen _kd_c = min(_kd_y, _kd_o)
 44.         local leg_y "Early-Career (N=`n_y'): mean=`mu_y'"
 45.         local leg_o "Late-Career (N=`n_o'): mean=`mu_o'"
 46.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 47.         local fdir ../output/figures/`samp'
 48.         foreach fmode of global FIG_MODES {
 49.             if "`fmode'" == "paper" {
 50.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
 51.                 cap mkdir "`fdir'"
 52.             }
 53.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("Exposure measure") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
 54.             fig_export, path("`fdir'/desc_kd_exposure`tag_`s''`suf'.pdf") mode(`fmode')
 55.         }
 56.         cap drop _kx _kd_y _kd_o _kd_c
 57.     }
 58. end

. 
. program desc_pre_output_by_age
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir "../output/figures/`samp'"
  8. 
.     use ../temp/es_`samp'`suf', clear
  9.     keep if year < 2014
 10.     qui sum year
 11.     local y0 = r(min)
 12.     local y1 = r(max)
 13. 
.     local sum_src   ppr_cnt cite_affl_wt n_first_ppr n_last_ppr
 14.     local sum_alias ppr_tot cite         first       last
 15.     local mean_src   ppr_cnt
 16.     local mean_alias ppr_yr
 17.     local lbl_ppr_tot "total papers"
 18.     local lbl_ppr_yr  "papers per year"
 19.     local lbl_cite    "affiliation-weighted citations"
 20.     local lbl_first   "first-authored papers"
 21.     local lbl_last    "last-authored papers"
 22.     local fmt_ppr_tot %6.1f
 23.     local fmt_ppr_yr  %5.2f
 24.     local fmt_cite    %8.1f
 25.     local fmt_first   %6.1f
 26.     local fmt_last    %6.1f
 27. 
.     local coll_sum
 28.     local coll_mean
 29.     local keep_alias
 30.     foreach stat in sum mean {
 31.         local nsrc : word count ``stat'_src'
 32.         forvalues i = 1/`nsrc' {
 33.             local src : word `i' of ``stat'_src'
 34.             local a   : word `i' of ``stat'_alias'
 35.             cap confirm variable `src'
 36.             if _rc {
 37.                 di as error "desc_pre_output_by_age `samp'`suf': `src' not in panel -- `a' density SKIPPED."
 38.                 continue
 39.             }
 40.             local coll_`stat' `coll_`stat'' pre_`a'=`src'
 41.             local keep_alias `keep_alias' `a'
 42.         }
 43.     }
 44.     if "`keep_alias'" == "" {
 45.         di as error "desc_pre_output_by_age `samp'`suf': no outcomes available -- nothing plotted."
 46.         exit
 47.     }
 48.     local coll_sum_part = cond("`coll_sum'" == "", "", "(sum) `coll_sum'")
 49.     local coll_mean_part = cond("`coll_mean'" == "", "", "(mean) `coll_mean'")
 50. 
.     egen long inst_num = group(inst_id)
 51.     gcollapse `coll_sum_part' `coll_mean_part' (firstnm) young inst_num, by(athr_id)
 52.     drop if mi(young)
 53. 
.     qui count if young == 1
 54.     local n_y = r(N)
 55.     qui count if young == 0
 56.     local n_o = r(N)
 57.     di as text _n "desc_pre_output_by_age `samp'`suf': pre-period = `y0'-`y1', N young = `n_y', N old = `n_o'"
 58. 
.     foreach a of local keep_alias {
 59.         local f "`fmt_`a''"
 60.         qui sum pre_`a' if young == 1, d
 61.         local mu_y = strtrim(string(r(mean), "`f'"))
 62.         local md_y = strtrim(string(r(p50),  "`f'"))
 63.         qui sum pre_`a' if young == 0, d
 64.         local mu_o = strtrim(string(r(mean), "`f'"))
 65.         local md_o = strtrim(string(r(p50),  "`f'"))
 66.         local leg_y "Early-Career (N=`n_y'): mean=`mu_y'"
 67.         local leg_o "Late-Career (N=`n_o'): mean=`mu_o'"
 68.         di as text "  `a': young mean=`mu_y' p50=`md_y' | old mean=`mu_o' p50=`md_o'"
 69.         cap noi ksmirnov pre_`a', by(young)
 70.         qui reg pre_`a' young, vce(cluster inst_num)
 71.         di as text "  `a': young-old diff = " %8.3f _b[young] " (se " %8.3f _se[young] ")"
 72. 
.         gen double ln_pre_`a' = ln(1 + pre_`a')
 73.         qui sum ln_pre_`a'
 74.         cap drop _kx _kd_y _kd_o _kd_c
 75.         gen _kx = r(min) + (r(max) - r(min)) * (_n - 1) / 199 if _n <= 200
 76.         kdensity ln_pre_`a' if young == 1, at(_kx) gen(_kd_y) nograph
 77.         kdensity ln_pre_`a' if young == 0, at(_kx) gen(_kd_o) nograph
 78.         gen _kd_c = min(_kd_y, _kd_o)
 79.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 80.         local fdir ../output/figures/`samp'
 81.         foreach fmode of global FIG_MODES {
 82.             if "`fmode'" == "paper" {
 83.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
 84.                 cap mkdir "`fdir'"
 85.             }
 86.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("ln(1 + pre-period `lbl_`a'', `y0'-`y1')") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
 87.             fig_export, path("`fdir'/desc_kd_pre_`a'_ln`suf'.pdf") mode(`fmode')
 88.         }
 89. 
.         qui sum pre_`a', d
 90.         local xcap = r(p95)
 91.         cap drop _kx _kd_y _kd_o _kd_c
 92.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 93.         kdensity pre_`a' if young == 1 & pre_`a' <= `xcap', at(_kx) gen(_kd_y) nograph
 94.         kdensity pre_`a' if young == 0 & pre_`a' <= `xcap', at(_kx) gen(_kd_o) nograph
 95.         gen _kd_c = min(_kd_y, _kd_o)
 96.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 97.         local fdir ../output/figures/`samp'
 98.         foreach fmode of global FIG_MODES {
 99.             if "`fmode'" == "paper" {
100.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
101.                 cap mkdir "`fdir'"
102.             }
103.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("Pre-period `lbl_`a'', `y0'-`y1' (x capped at pooled p95)") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
104.             fig_export, path("`fdir'/desc_kd_pre_`a'_raw`suf'.pdf") mode(`fmode')
105.         }
106.         cap drop _kx _kd_y _kd_o _kd_c
107.     }
108. 
.     save ../temp/desc_pre_output_`samp'`suf', replace
109. end

. 
. program horse_race_nih
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17. 
.     cap confirm file "../temp/es_`samp'`suf'.dta"
 18.     if _rc {
 19.         di as error "horse_race_nih `samp'`suf': ../temp/es_`samp'`suf'.dta not found -- run add_het_splits first."
 20.         exit
 21.     }
 22.     use ../temp/es_`samp'`suf', clear
 23.     foreach v in young low_nihd {
 24.         cap confirm variable `v'
 25.         if _rc {
 26.             di as error "horse_race_nih `samp'`suf': `v' not in panel -- SKIPPED."
 27.             exit
 28.         }
 29.     }
 30.     keep if !mi(young) & !mi(low_nihd)
 31.     foreach v in young low_nihd {
 32.         qui sum `v'
 33.         if r(N) == 0 | r(min) == r(max) {
 34.             di as error "horse_race_nih `samp'`suf': `v' degenerate on the PI sample -- SKIPPED."
 35.             exit
 36.         }
 37.     }
 38. 
.     gen post       = year >= 2014
 39.     gen Z_it       = exposure      * post
 40.     gen Z_share_it = mkt_spend_shr * post
 41.     gen Z_early    = Z_it * young
 42.     gen Z_lownih   = Z_it * low_nihd
 43.     gen PT_early   = post * young
 44.     gen PT_lownih  = post * low_nihd
 45. 
.     local yvar_list ppr_cnt cite_affl_wt
 46.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 47.     local nyv : word count `yvar_list'
 48. 
.     mat hrace`suf' = J(22, `nyv', .)
 49.     mat rownames hrace`suf' = b_z_base_career se_z_base_career b_z_early_alone se_z_early_alone ///
>                               b_z_base_fund se_z_base_fund b_z_lownih_alone se_z_lownih_alone ///
>                               b_z_base se_z_base b_z_early se_z_early b_z_lownih se_z_lownih ///
>                               early_shift lownih_shift b_diff se_diff p_eq ///
>                               N n_pis n_pis_early
 50.     mat colnames hrace`suf' = `yvar_list'
 51. 
.     tempfile annual_horse_race
 52.     save `annual_horse_race', replace
 53.     local col 0
 54.     foreach yvar of local yvar_list {
 55.         local ++col
 56.         use `annual_horse_race', clear
 57.         if "`yvar'" == "nih_total_cost" nih_award_period_means
 58.         cap drop hr_samp
 59.         cap noi ppmlhdfe `yvar' Z_it Z_early Z_lownih PT_early PT_lownih Z_share_it, ///
>             absorb(`fes') vce(cluster `vce_cl')
 60.         local rc = _rc
 61.         if `rc' {
 62.             di as error "horse_race_nih `samp'`suf' `yvar' joint spec failed (rc=`rc'); column left missing."
 63.             continue
 64.         }
 65.         gen byte hr_samp = e(sample)
 66.         local Nppml = e(N)
 67.         local b_base     = _b[Z_it]
 68.         local se_base    = _se[Z_it]
 69.         local b_early    = _b[Z_early]
 70.         local se_early   = _se[Z_early]
 71.         local b_lownih   = _b[Z_lownih]
 72.         local se_lownih  = _se[Z_lownih]
 73.         qui lincom Z_early - Z_lownih
 74.         local b_diff  = r(estimate)
 75.         local se_diff = r(se)
 76.         qui test Z_early = Z_lownih
 77.         local p_eq = r(p)
 78.         gunique athr_id if hr_samp
 79.         local n_pis = r(unique)
 80.         gunique athr_id if hr_samp & young == 1
 81.         local n_early = r(unique)
 82. 
.         cap noi ppmlhdfe `yvar' Z_it Z_early PT_early Z_share_it if hr_samp, ///
>             absorb(`fes') vce(cluster `vce_cl')
 83.         local rc = _rc
 84.         if `rc' {
 85.             di as error "horse_race_nih `samp'`suf' `yvar' career-only spec failed (rc=`rc'); column left missing."
 86.             continue
 87.         }
 88.         local b_base_c   = _b[Z_it]
 89.         local se_base_c  = _se[Z_it]
 90.         local b_early_a  = _b[Z_early]
 91.         local se_early_a = _se[Z_early]
 92. 
.         cap noi ppmlhdfe `yvar' Z_it Z_lownih PT_lownih Z_share_it if hr_samp, ///
>             absorb(`fes') vce(cluster `vce_cl')
 93.         local rc = _rc
 94.         if `rc' {
 95.             di as error "horse_race_nih `samp'`suf' `yvar' funding-only spec failed (rc=`rc'); column left missing."
 96.             continue
 97.         }
 98.         local b_base_f    = _b[Z_it]
 99.         local se_base_f   = _se[Z_it]
100.         local b_lownih_a  = _b[Z_lownih]
101.         local se_lownih_a = _se[Z_lownih]
102. 
.         mat hrace`suf'[1,`col']  = `b_base_c'
103.         mat hrace`suf'[2,`col']  = `se_base_c'
104.         mat hrace`suf'[3,`col']  = `b_early_a'
105.         mat hrace`suf'[4,`col']  = `se_early_a'
106.         mat hrace`suf'[5,`col']  = `b_base_f'
107.         mat hrace`suf'[6,`col']  = `se_base_f'
108.         mat hrace`suf'[7,`col']  = `b_lownih_a'
109.         mat hrace`suf'[8,`col']  = `se_lownih_a'
110.         mat hrace`suf'[9,`col']  = `b_base'
111.         mat hrace`suf'[10,`col'] = `se_base'
112.         mat hrace`suf'[11,`col'] = `b_early'
113.         mat hrace`suf'[12,`col'] = `se_early'
114.         mat hrace`suf'[13,`col'] = `b_lownih'
115.         mat hrace`suf'[14,`col'] = `se_lownih'
116.         mat hrace`suf'[15,`col'] = `b_early' - `b_early_a'
117.         mat hrace`suf'[16,`col'] = `b_lownih' - `b_lownih_a'
118.         mat hrace`suf'[17,`col'] = `b_diff'
119.         mat hrace`suf'[18,`col'] = `se_diff'
120.         mat hrace`suf'[19,`col'] = `p_eq'
121.         mat hrace`suf'[20,`col'] = `Nppml'
122.         mat hrace`suf'[21,`col'] = `n_pis'
123.         mat hrace`suf'[22,`col'] = `n_early'
124. 
.         mat hrp_`yvar' = (`b_early_a', `se_early_a' \ `b_lownih_a', `se_lownih_a' \ ///
>                           `b_early', `se_early' \ `b_lownih', `se_lownih')
125. 
.         di as text "horse_race_nih `samp'`suf' `yvar' (PI sample, N = " %9.0f `Nppml' ", PIs = `n_pis', early = `n_early'):"
126.         di as text "  career only   : Z x Early     = " %9.4f `b_early_a'  "  (se " %7.4f `se_early_a' ")"
127.         di as text "  funding only  : Z x LowNIH    = " %9.4f `b_lownih_a' "  (se " %7.4f `se_lownih_a' ")"
128.         di as text "  horse race    : Z x Early     = " %9.4f `b_early'    "  (se " %7.4f `se_early' ")   shift = " %8.4f `=`b_early' - `b_early_a''
129.         di as text "                  Z x LowNIH    = " %9.4f `b_lownih'   "  (se " %7.4f `se_lownih' ")   shift = " %8.4f `=`b_lownih' - `b_lownih_a''
130.         di as text "  early - lownih (joint) = " %9.4f `b_diff' "  (se " %7.4f `se_diff' ")   p(equal) = " %6.4f `p_eq'
131.     }
132. 
.     cap mkdir ../output/tables
133.     cap mkdir ../output/tables/`samp'
134.     qui matrix_to_txt, saving("../output/tables/`samp'/horse_race_nih`suf'.txt") ///
>         matrix(hrace`suf') title(<tab:horse_race_nih`suf'>) format(%20.4f) replace
135. 
.     cap mkdir "../output/figures/`samp'/coefplot_evavg"
136.     clear
137.     foreach yvar of local yvar_list {
138.         cap confirm matrix hrp_`yvar'
139.         if _rc continue
140.         clear
141.         svmat double hrp_`yvar', names(col)
142.         rename (c1 c2) (b se)
143.         gen ub = b + 1.96*se
144.         gen lb = b - 1.96*se
145.         gen byte career = inlist(_n, 1, 3)
146.         gen y = cond(_n == 1, 4.7, cond(_n == 2, 3.7, cond(_n == 3, 2, 1)))
147.         qui sum lb
148.         local xmin = floor(r(min)/0.5)*0.5
149.         qui sum ub
150.         local xmax = ceil(r(max)/0.5)*0.5
151.         local ylabs `"4.7 "Early-career {&minus} late-career PIs" 3.7 "Below {&minus} above median NIH funding" 2 "Early-career {&minus} late-career PIs, given funding" 1 "Below {&minus} above median NIH, given career stage""'
152.         tw rcap ub lb y if career == 1, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>            scatter y b if career == 1, mcolor(ebblue) msize(small) || ///
>            rcap ub lb y if career == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>            scatter y b if career == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>            , xline(0, lcolor(gs10) lpattern(solid)) ///
>              yline(2.85, lcolor(gs12) lpattern(dash)) ///
>              ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>              ytitle("") xtitle("Output-cost elasticity", size(medsmall)) ///
>              xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>              legend(off) ///
>              ysize(4) xsize(8) yscale(range(0.6 5.1)) ///
>              plotregion(margin(l=zero r=zero b=zero t=vsmall))
153.         fig_export, path("../output/figures/`samp'/coefplot_evavg/horse_race_nih_coefplot_`yvar'`suf'.pdf") xsize(8) ysize(4)
154.         di as text "wrote ../output/figures/`samp'/coefplot_evavg/horse_race_nih_coefplot_`yvar'`suf'.pdf"
155.     }
156. end

. 
. program output_het_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir ../output/tables
  8.     cap mkdir ../output/tables/`samp'
  9. 
.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
 10.     if !_rc {
 11.         preserve
 12.         use "../temp/phet_results_`samp'`suf'.dta", clear
 13.         export delimited using "../output/tables/`samp'/phet_results`suf'.txt", replace delim(tab)
 14.         restore
 15.     }
 16. end

. 
. program output_split_diff_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
  8.     if _rc {
  9.         di as error "output_split_diff_tables `samp'`suf': phet_results not found -- skipping."
 10.         exit 0
 11.     }
 12.     cap mkdir ../output/tables
 13.     cap mkdir ../output/tables/`samp'
 14. 
.     local pairs `"${COEFPLOT_PI_PAIRS}"'
 15.     foreach a of global IC_ALIASES {
 16.         local pairs `"`pairs' "hiw_`a' low_`a'" "'
 17.     }
 18. 
.     foreach yvar in ppr_cnt cite_affl_wt {
 19.         preserve
 20.         use "../temp/phet_results_`samp'`suf'.dta", clear
 21.         keep if yvar == "`yvar'" & spec == "mshrctrl" & inlist(split_type, "med_pi", "med_pi_diff")
 22.         cap mat drop sdiff
 23.         local rows
 24.         foreach pair of local pairs {
 25.             local g1 : word 1 of `pair'
 26.             local g2 : word 2 of `pair'
 27.             qui count if grp == "`g1'_diff" & split_type == "med_pi_diff"
 28.             if r(N) == 0 continue
 29.             foreach g in `g1' `g2' {
 30.                 qui sum post_b  if grp == "`g'" & split_type == "med_pi"
 31.                 local b_`g'  = r(mean)
 32.                 qui sum post_se if grp == "`g'" & split_type == "med_pi"
 33.                 local se_`g' = r(mean)
 34.             }
 35.             qui sum post_b  if grp == "`g1'_diff" & split_type == "med_pi_diff"
 36.             local b_diff = r(mean)
 37.             qui sum post_se if grp == "`g1'_diff" & split_type == "med_pi_diff"
 38.             local se_diff = r(mean)
 39.             qui sum pre_b   if grp == "`g1'_diff" & split_type == "med_pi_diff"
 40.             local p_diff = r(mean)
 41.             qui sum N       if grp == "`g1'_diff" & split_type == "med_pi_diff"
 42.             local Nfit = r(mean)
 43.             mat sdiff = nullmat(sdiff) \ ///
>                 (`b_`g1'', `se_`g1'', `b_`g2'', `se_`g2'', `b_diff', `se_diff', `p_diff', `Nfit')
 44.             local rows `rows' `g1'
 45.         }
 46.         restore
 47.         if "`rows'" == "" continue
 48.         mat colnames sdiff = b_g1 se_g1 b_g2 se_g2 b_diff se_diff p_diff N
 49.         mat rownames sdiff = `rows'
 50.         di as result _n "== split_diff `samp'`suf' `yvar': g1 - g2 off the joint VCE (rows = g1 of each coefplot pair) =="
 51.         matlist sdiff, format(%9.4f) lines(oneline)
 52.         qui matrix_to_txt, saving("../output/tables/`samp'/split_diff_`yvar'`suf'.txt") ///
>             matrix(sdiff) title(<tab:split_diff_`yvar'`suf'>) format(%20.4f) replace
 53.     }
 54. end

. 
. program matched_career_comparison
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     cap mkdir "../output/figures/`samp'"
 18.     cap mkdir "../output/figures/`samp'/matched"
 19. 
.     use ../temp/es_`samp'`suf', clear
 20.     foreach v in young old nih_pi cluster_30 pre_ppr_cnt_sum pre_nihd lab_age_2014 {
 21.         cap confirm variable `v'
 22.         if _rc {
 23.             di as error "matched_career_comparison `samp'`suf': `v' not in panel -- SKIPPED."
 24.             exit
 25.         }
 26.     }
 27.     keep if !mi(young)
 28.     foreach v in post post1 post2 cell cs w_cem out_bin fund_bin {
 29.         cap drop `v'
 30.     }
 31.     gen _pre_cite = cite_affl_wt if year < 2014
 32.     bys athr_id: egen pre_cite_sum = total(_pre_cite)
 33.     drop _pre_cite
 34.     gen byte any_award = nih_pi == 1 & !mi(pre_nihd)
 35.     gen double ln_nihd = cond(any_award == 1, ln(1 + pre_nihd), 0) if nih_pi == 1
 36.     gen double ln_pre_out = ln(pre_ppr_cnt_sum)
 37.     gen byte post  = year >= 2014
 38.     gen byte post1 = inrange(year, 2014, 2016)
 39.     gen byte post2 = inrange(year, 2017, 2019)
 40.     foreach g in young old {
 41.         gen Z_`g' = exposure      * post * `g'
 42.         gen S_`g' = mkt_spend_shr * post * `g'
 43.         foreach k in 1 2 {
 44.             gen Z`k'_`g' = exposure      * post`k' * `g'
 45.             gen S`k'_`g' = mkt_spend_shr * post`k' * `g'
 46.         }
 47.     }
 48.     gen PT_young  = post  * young
 49.     gen PT1_young = post1 * young
 50.     gen PT2_young = post2 * young
 51.     save ../temp/matched_panel_`samp'`suf', replace
 52. 
.     local bal_vars_all lab_age_2014 pre_ppr_cnt_sum pre_cite_sum exposure mkt_spend_shr
 53.     local bal_vars_nih `bal_vars_all' ln_nihd any_award
 54.     foreach u in nih all {
 55.         use ../temp/matched_panel_`samp'`suf', clear
 56.         keep if athr_indicator == 1
 57.         if "`u'" == "nih" keep if nih_pi == 1
 58.         xtile out_bin = pre_ppr_cnt_sum, nq($HET_MATCH_OUT_BINS)
 59.         if "`u'" == "nih" {
 60.             xtile fund_bin = pre_nihd if any_award == 1, nq($HET_MATCH_FUND_BINS)
 61.             replace fund_bin = 0 if any_award == 0
 62.             egen long cell = group(cluster_30 out_bin fund_bin)
 63.         }
 64.         else {
 65.             gen byte fund_bin = .
 66.             egen long cell = group(cluster_30 out_bin)
 67.         }
 68.         bys cell: egen n_y_cell = total(young == 1)
 69.         bys cell: egen n_o_cell = total(young == 0)
 70.         gen byte cs = n_y_cell > 0 & n_o_cell > 0
 71.         qui count if cs == 1 & young == 1
 72.         local N_y = r(N)
 73.         qui count if cs == 1 & young == 0
 74.         local N_o = r(N)
 75.         gen double w_cem = cond(young == 1, 1, (n_y_cell / n_o_cell) * (`N_o' / `N_y')) if cs == 1
 76.         gunique cell
 77.         local n_cells = r(unique)
 78.         gunique cell if cs == 1
 79.         local n_cells_cs = r(unique)
 80.         qui count if young == 1
 81.         local n_y_all = r(N)
 82.         qui count if young == 0
 83.         local n_o_all = r(N)
 84.         di as text "matched_career_comparison `samp'`suf' [`u']: `n_cells' cells (`n_cells_cs' with both career stages); " ///
>             "early-career PIs in common support `N_y'/`n_y_all', late-career `N_o'/`n_o_all'"
 85.         mat mcs_`u'`suf' = (`n_cells', `n_cells_cs', `n_y_all', `N_y', `n_o_all', `N_o', ., ., ., .)
 86.         mat colnames mcs_`u'`suf' = n_cells n_cells_cs n_young n_young_cs n_old n_old_cs ps_lo ps_hi ps_share_young ps_share_old
 87. 
.         cap mat drop mbal_`u'`suf'
 88.         local bal_rows
 89.         foreach v of local bal_vars_`u' {
 90.             qui sum `v' if young == 1
 91.             local m_y0 = r(mean)
 92.             local v_y0 = r(Var)
 93.             qui sum `v' if young == 0
 94.             local m_o0 = r(mean)
 95.             local v_o0 = r(Var)
 96.             local sd_pool = sqrt((`v_y0' + `v_o0') / 2)
 97.             if `sd_pool' == 0 continue
 98.             qui sum `v' if young == 1 & cs == 1
 99.             local m_y1 = r(mean)
100.             qui sum `v' [aw=w_cem] if young == 0 & cs == 1
101.             local m_o1 = r(mean)
102.             mat mbal_`u'`suf' = nullmat(mbal_`u'`suf') \ ///
>                 (`m_y0', `m_o0', (`m_y0' - `m_o0') / `sd_pool', `m_y1', `m_o1', (`m_y1' - `m_o1') / `sd_pool')
103.             local bal_rows `bal_rows' `v'
104.         }
105.         qui levelsof cluster_30, local(clusters)
106.         local sum_abs0 0
107.         local sum_abs1 0
108.         local max_abs0 0
109.         local max_abs1 0
110.         local n_cl 0
111.         foreach c of local clusters {
112.             cap drop _cl
113.             gen byte _cl = cluster_30 == `c'
114.             qui sum _cl if young == 1
115.             local m_y0 = r(mean)
116.             local v_y0 = r(Var)
117.             qui sum _cl if young == 0
118.             local m_o0 = r(mean)
119.             local v_o0 = r(Var)
120.             local sd_pool = sqrt((`v_y0' + `v_o0') / 2)
121.             if `sd_pool' == 0 continue
122.             qui sum _cl if young == 1 & cs == 1
123.             local m_y1 = r(mean)
124.             qui sum _cl [aw=w_cem] if young == 0 & cs == 1
125.             local m_o1 = r(mean)
126.             local a0 = abs((`m_y0' - `m_o0') / `sd_pool')
127.             local a1 = abs((`m_y1' - `m_o1') / `sd_pool')
128.             local sum_abs0 = `sum_abs0' + `a0'
129.             local sum_abs1 = `sum_abs1' + `a1'
130.             local max_abs0 = max(`max_abs0', `a0')
131.             local max_abs1 = max(`max_abs1', `a1')
132.             local ++n_cl
133.         }
134.         cap drop _cl
135.         if `n_cl' > 0 {
136.             mat mbal_`u'`suf' = mbal_`u'`suf' \ (., ., `sum_abs0' / `n_cl', ., ., `sum_abs1' / `n_cl')
137.             mat mbal_`u'`suf' = mbal_`u'`suf' \ (., ., `max_abs0', ., ., `max_abs1')
138.             local bal_rows `bal_rows' topic_mean_abs topic_max_abs
139.         }
140.         mat rownames mbal_`u'`suf' = `bal_rows'
141.         mat colnames mbal_`u'`suf' = mean_early mean_late smd mean_early_cs mean_late_rw smd_rw
142.         di as result _n "== balance `samp'`suf' [`u']: early minus late, standardized; before | common support with late-career reweighted =="
143.         matlist mbal_`u'`suf', format(%9.3f) lines(oneline)
144. 
.         if "`u'" == "nih" {
145.             cap noi logit young i.cluster_30 c.ln_pre_out c.ln_nihd i.any_award, iterate(100)
146.             local rc = _rc
147.             if `rc' di as error "matched_career_comparison `samp'`suf': propensity logit failed (rc=`rc'); overlap figure skipped."
148.             else {
149.                 predict double ps, pr
150.                 qui sum ps if young == 1
151.                 local ps_y_lo = r(min)
152.                 local ps_y_hi = r(max)
153.                 qui sum ps if young == 0
154.                 local ps_lo = max(`ps_y_lo', r(min))
155.                 local ps_hi = min(`ps_y_hi', r(max))
156.                 qui count if young == 1 & inrange(ps, `ps_lo', `ps_hi')
157.                 local sh_y = r(N) / `n_y_all'
158.                 qui count if young == 0 & inrange(ps, `ps_lo', `ps_hi')
159.                 local sh_o = r(N) / `n_o_all'
160.                 di as text "matched_career_comparison `samp'`suf' [nih]: propensity-score overlap [" %5.3f `ps_lo' ", " %5.3f `ps_hi' ///
>                     "] holds " %5.1f 100 * `sh_y' "% of early-career and " %5.1f 100 * `sh_o' "% of late-career PIs"
161.                 mat mcs_`u'`suf'[1, 7]  = `ps_lo'
162.                 mat mcs_`u'`suf'[1, 8]  = `ps_hi'
163.                 mat mcs_`u'`suf'[1, 9]  = `sh_y'
164.                 mat mcs_`u'`suf'[1, 10] = `sh_o'
165.                 cap drop _kx _kd_y _kd_o _kd_c
166.                 gen _kx = (_n - 1) / 199 if _n <= 200
167.                 kdensity ps if young == 1, at(_kx) gen(_kd_y) nograph
168.                 kdensity ps if young == 0, at(_kx) gen(_kd_o) nograph
169.                 gen _kd_c = min(_kd_y, _kd_o)
170.                 tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                    (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                    (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                    (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                    , xtitle("Estimated probability of being early-career") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                      xlab(0(0.2)1) ///
>                      legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small)) ///
>                      plotregion(margin(sides))
171.                 fig_export, path("../output/figures/`samp'/matched/pscore_overlap`suf'.pdf")
172.                 cap drop _kx _kd_y _kd_o _kd_c ps
173.             }
174. 
.             preserve
175.             clear
176.             local nb = rowsof(mbal_nih`suf')
177.             local rn : rownames mbal_nih`suf'
178.             svmat double mbal_nih`suf', names(col)
179.             gen str32 rowname = ""
180.             forval i = 1/`nb' {
181.                 replace rowname = "`: word `i' of `rn''" in `i'
182.             }
183.             drop if inlist(rowname, "lab_age_2014", "topic_max_abs")
184.             gen y = _N - _n + 1
185.             local ylabs
186.             forval i = 1/`=_N' {
187.                 local rname = rowname[`i']
188.                 local lbl "`rname'"
189.                 if "`rname'" == "pre_ppr_cnt_sum" local lbl "Pre-merger last-author papers"
190.                 if "`rname'" == "pre_cite_sum"    local lbl "Pre-merger citation-weighted output"
191.                 if "`rname'" == "ln_nihd"         local lbl "Log baseline NIH funding"
192.                 if "`rname'" == "any_award"       local lbl "Any baseline NIH research award"
193.                 if "`rname'" == "exposure"        local lbl "Exposure"
194.                 if "`rname'" == "mkt_spend_shr"   local lbl "Treated-market spending share"
195.                 if "`rname'" == "topic_mean_abs"  local lbl "Research topic (mean abs. diff. across clusters)"
196.                 local ylabs `"`ylabs' `=y[`i']' "`lbl'""'
197.             }
198.             qui sum smd
199.             local xmin = min(-0.5, floor(r(min) / 0.25) * 0.25)
200.             local xmax = max(0.5, ceil(r(max) / 0.25) * 0.25)
201.             tw scatter y smd, mcolor(dkorange) msymbol(D) msize(small) || ///
>                scatter y smd_rw, mcolor(ebblue) msymbol(O) msize(small) ///
>                , xline(0, lcolor(gs10) lpattern(solid)) xline(-0.1 0.1, lcolor(gs12) lpattern(dash)) ///
>                  ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ytitle("") ///
>                  xtitle("Standardized difference, early minus late career", size(medsmall)) ///
>                  xlabel(`xmin'(0.25)`xmax', labsize(small)) ///
>                  legend(order(1 "Before matching" 2 "After matching") pos(6) ring(1) rows(1) size(small)) ///
>                  ysize(4) xsize(8) yscale(range(0.5 `=_N + 0.5')) ///
>                  plotregion(margin(l=zero r=zero b=zero t=vsmall))
202.             fig_export, path("../output/figures/`samp'/matched/balance`suf'.pdf") xsize(8) ysize(4)
203.             restore
204.         }
205.         keep athr_id cell out_bin fund_bin cs w_cem
206.         save ../temp/matched_w_`u'_`samp'`suf', replace
207.     }
208. 
.     local yvar_list ppr_cnt cite_affl_wt
209.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
210.     local specs all_unm nih_unm nih_cs nih_cem all_cem
211.     local per_specs all_unm nih_unm nih_cem
212.     foreach yvar of local yvar_list {
213.         if "`yvar'" == "nih_total_cost" {
214.             di as text "matched_career_comparison: `yvar' uses period means elsewhere -- skipped."
215.             continue
216.         }
217.         mat mcar_`yvar'`suf' = J(5, 11, .)
218.         mat rownames mcar_`yvar'`suf' = `specs'
219.         mat colnames mcar_`yvar'`suf' = b_young se_young b_old se_old b_diff se_diff p_diff N n_pis_young n_pis_old n_cells
220.         mat mper_`yvar'`suf' = J(3, 21, .)
221.         mat rownames mper_`yvar'`suf' = `per_specs'
222.         mat colnames mper_`yvar'`suf' = b_young1 se_young1 b_old1 se_old1 b_diff1 se_diff1 p_diff1 ///
>                                         b_young2 se_young2 b_old2 se_old2 b_diff2 se_diff2 p_diff2 ///
>                                         b_gapchg se_gapchg p_gapchg b_young21 se_young21 p_young21 N
223.         local r 0
224.         foreach spec of local specs {
225.             local ++r
226.             local u = substr("`spec'", 1, 3)
227.             use ../temp/matched_panel_`samp'`suf', clear
228.             merge m:1 athr_id using ../temp/matched_w_`u'_`samp'`suf', keep(3) nogen
229.             local wt ""
230.             if inlist("`spec'", "nih_cs", "nih_cem", "all_cem") keep if cs == 1
231.             if inlist("`spec'", "nih_cem", "all_cem") local wt "[pw=w_cem]"
232.             cap noi ppmlhdfe `yvar' Z_young Z_old S_young S_old PT_young `wt', ///
>                 absorb(`fes') vce(cluster `vce_cl')
233.             local rc = _rc
234.             if `rc' {
235.                 di as error "matched_career_comparison `samp'`suf' `yvar' `spec' pooled ppml failed (rc=`rc'); row left missing."
236.                 continue
237.             }
238.             local Nppml = e(N)
239.             gunique athr_id if e(sample) & young == 1
240.             local n_y = r(unique)
241.             gunique athr_id if e(sample) & young == 0
242.             local n_o = r(unique)
243.             gunique cell if e(sample)
244.             local n_cells = r(unique)
245.             local b_y  = _b[Z_young]
246.             local se_y = _se[Z_young]
247.             local b_o  = _b[Z_old]
248.             local se_o = _se[Z_old]
249.             qui lincom Z_young - Z_old
250.             mat mcar_`yvar'`suf'[`r', 1]  = `b_y'
251.             mat mcar_`yvar'`suf'[`r', 2]  = `se_y'
252.             mat mcar_`yvar'`suf'[`r', 3]  = `b_o'
253.             mat mcar_`yvar'`suf'[`r', 4]  = `se_o'
254.             mat mcar_`yvar'`suf'[`r', 5]  = r(estimate)
255.             mat mcar_`yvar'`suf'[`r', 6]  = r(se)
256.             mat mcar_`yvar'`suf'[`r', 7]  = r(p)
257.             mat mcar_`yvar'`suf'[`r', 8]  = `Nppml'
258.             mat mcar_`yvar'`suf'[`r', 9]  = `n_y'
259.             mat mcar_`yvar'`suf'[`r', 10] = `n_o'
260.             mat mcar_`yvar'`suf'[`r', 11] = `n_cells'
261.             di as text "matched PPML `samp'`suf' `yvar' `spec': early=" %8.4f `b_y' " (" %6.4f `se_y' ")  late=" %8.4f `b_o' ///
>                 " (" %6.4f `se_o' ")  diff=" %8.4f r(estimate) " (" %6.4f r(se) ") p=" %6.4f r(p) ///
>                 "  N=" %9.0f `Nppml' " PIs=`n_y'/`n_o' cells=`n_cells'"
262. 
.             if strpos(" `per_specs' ", " `spec' ") == 0 continue
263.             local pr : list posof "`spec'" in per_specs
264.             cap noi ppmlhdfe `yvar' Z1_young Z1_old Z2_young Z2_old S1_young S1_old S2_young S2_old ///
>                 PT1_young PT2_young `wt', absorb(`fes') vce(cluster `vce_cl')
265.             local rc = _rc
266.             if `rc' {
267.                 di as error "matched_career_comparison `samp'`suf' `yvar' `spec' window ppml failed (rc=`rc'); persistence row left missing."
268.                 continue
269.             }
270.             mat mper_`yvar'`suf'[`pr', 21] = e(N)
271.             foreach k in 1 2 {
272.                 local c0 = cond(`k' == 1, 0, 7)
273.                 mat mper_`yvar'`suf'[`pr', `c0' + 1] = _b[Z`k'_young]
274.                 mat mper_`yvar'`suf'[`pr', `c0' + 2] = _se[Z`k'_young]
275.                 mat mper_`yvar'`suf'[`pr', `c0' + 3] = _b[Z`k'_old]
276.                 mat mper_`yvar'`suf'[`pr', `c0' + 4] = _se[Z`k'_old]
277.                 qui lincom Z`k'_young - Z`k'_old
278.                 mat mper_`yvar'`suf'[`pr', `c0' + 5] = r(estimate)
279.                 mat mper_`yvar'`suf'[`pr', `c0' + 6] = r(se)
280.                 mat mper_`yvar'`suf'[`pr', `c0' + 7] = r(p)
281.             }
282.             qui lincom (Z2_young - Z2_old) - (Z1_young - Z1_old)
283.             mat mper_`yvar'`suf'[`pr', 15] = r(estimate)
284.             mat mper_`yvar'`suf'[`pr', 16] = r(se)
285.             mat mper_`yvar'`suf'[`pr', 17] = r(p)
286.             qui lincom Z2_young - Z1_young
287.             mat mper_`yvar'`suf'[`pr', 18] = r(estimate)
288.             mat mper_`yvar'`suf'[`pr', 19] = r(se)
289.             mat mper_`yvar'`suf'[`pr', 20] = r(p)
290.             di as text "matched PPML windows `samp'`suf' `yvar' `spec': 2014-16 early=" %8.4f _b[Z1_young] " late=" %8.4f _b[Z1_old] ///
>                 "  2017-19 early=" %8.4f _b[Z2_young] " late=" %8.4f _b[Z2_old] ///
>                 "  gap change=" %8.4f mper_`yvar'`suf'[`pr', 15] " (" %6.4f mper_`yvar'`suf'[`pr', 16] ") p=" %6.4f mper_`yvar'`suf'[`pr', 17]
291.         }
292. 
.         matched_coefplot, samp(`samp') yvar(`yvar') suf(`suf')
293.     }
294. end

. 
. program matched_coefplot
  1.     syntax, samp(string) yvar(string) [suf(string)]
  2.     cap confirm matrix mcar_`yvar'`suf'
  3.     if _rc exit 0
  4.     preserve
  5.     clear
  6.     set obs 10
  7.     gen byte row   = ceil(_n / 2)
  8.     gen byte early = mod(_n, 2) == 1
  9.     gen double b  = .
 10.     gen double se = .
 11.     local i 0
 12.     foreach spec in all_unm nih_unm nih_cem {
 13.         local ++i
 14.         local rr = rownumb(mcar_`yvar'`suf', "`spec'")
 15.         qui replace b  = mcar_`yvar'`suf'[`rr', 1] if row == `i' & early == 1
 16.         qui replace se = mcar_`yvar'`suf'[`rr', 2] if row == `i' & early == 1
 17.         qui replace b  = mcar_`yvar'`suf'[`rr', 3] if row == `i' & early == 0
 18.         qui replace se = mcar_`yvar'`suf'[`rr', 4] if row == `i' & early == 0
 19.     }
 20.     local rr = rownumb(mper_`yvar'`suf', "nih_cem")
 21.     foreach k in 1 2 {
 22.         local ++i
 23.         local c0 = cond(`k' == 1, 0, 7)
 24.         qui replace b  = mper_`yvar'`suf'[`rr', `c0' + 1] if row == `i' & early == 1
 25.         qui replace se = mper_`yvar'`suf'[`rr', `c0' + 2] if row == `i' & early == 1
 26.         qui replace b  = mper_`yvar'`suf'[`rr', `c0' + 3] if row == `i' & early == 0
 27.         qui replace se = mper_`yvar'`suf'[`rr', `c0' + 4] if row == `i' & early == 0
 28.     }
 29.     drop if mi(b)
 30.     if _N > 0 {
 31.         gen ub = b + 1.96 * se
 32.         gen lb = b - 1.96 * se
 33.         gen double y = cond(row <= 3, 8 - row, 7.5 - row) + cond(early == 1, 0.15, -0.15)
 34.         local ylabs `"7 "All PIs" 6 "PIs with NIH records" 5 "Matched on topic, pre-merger output, and NIH funding" 3.5 "Matched, 2014-2016" 2.5 "Matched, 2017-2019""'
 35.         qui sum lb
 36.         local xmin = floor(r(min) / 0.5) * 0.5
 37.         qui sum ub
 38.         local xmax = ceil(r(max) / 0.5) * 0.5
 39.         tw rcap ub lb y if early == 1, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>            scatter y b if early == 1, mcolor(ebblue) msize(small) || ///
>            rcap ub lb y if early == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>            scatter y b if early == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>            , xline(0, lcolor(gs10) lpattern(solid)) yline(4.25, lcolor(gs12) lpattern(dash)) ///
>              ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ytitle("") ///
>              xtitle("Output-cost elasticity", size(medsmall)) xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>              legend(order(2 "${LBL_young}" 4 "${LBL_old}") pos(6) ring(1) rows(1) size(small)) ///
>              ysize(4) xsize(8) yscale(range(1.9 7.6)) ///
>              plotregion(margin(l=zero r=zero b=zero t=vsmall))
 40.         fig_export, path("../output/figures/`samp'/matched/coefplot_`yvar'`suf'.pdf") xsize(8) ysize(4)
 41.     }
 42.     restore
 43. end

. 
. program _mc_fmt, rclass
  1.     args b se
  2.     if mi(`b') | mi(`se') {
  3.         return local b_s "--"
  4.         return local se_s ""
  5.         exit
  6.     }
  7.     local t = abs(`b' / `se')
  8.     local st = cond(`t' >= 2.576, "^{***}", cond(`t' >= 1.960, "^{**}", cond(`t' >= 1.645, "^{*}", "")))
  9.     local b_s  : dis %7.3f `b'
 10.     local se_s : dis %7.3f `se'
 11.     return local b_s  "$`b_s'`st'$"
 12.     return local se_s "($`se_s'$)"
 13. end

. 
. program _mc_num, rclass
  1.     args v fmt
  2.     if mi(`v') {
  3.         return local s ""
  4.         exit
  5.     }
  6.     local s : dis `fmt' `v'
  7.     local s = strtrim("`s'")
  8.     return local s "`s'"
  9. end

. 
. program write_matched_tex
  1.     syntax, samp(string) yvar(string) [suf(string)]
  2.     cap confirm matrix mcar_`yvar'`suf'
  3.     if _rc exit 0
  4.     local out ../output/tables/`samp'/matched_career_`yvar'`suf'.tex
  5.     local lbl_all_unm "All PIs"
  6.     local lbl_nih_unm "PIs with NIH records"
  7.     local lbl_nih_cs  "\quad Common support on topic $\times$ output $\times$ funding"
  8.     local lbl_nih_cem "\quad Common support, late-career reweighted"
  9.     local lbl_all_cem "All PIs, common support on topic $\times$ output, reweighted"
 10.     local plbl_all_unm "All PIs"
 11.     local plbl_nih_cem "Matched PIs"
 12.     tempname fh
 13.     file open `fh' using "`out'", write replace
 14.     file write `fh' "\begin{table}[htbp]" _n
 15.     file write `fh' "\centering" _n
 16.     file write `fh' "\caption{Career Stage and the Output Response among Comparable PIs}" _n
 17.     file write `fh' "\label{tab:matched_career_`yvar'`suf'}" _n
 18.     file write `fh' "\begin{tabular}{lcccc}" _n
 19.     file write `fh' "\toprule" _n
 20.     file write `fh' " & Early-career PIs & Late-career PIs & Difference & PIs (early / late) \\" _n
 21.     file write `fh' "\midrule" _n
 22.     file write `fh' "\multicolumn{5}{l}{\textit{Panel A: Pooled post-period, 2014--2019}} \\" _n
 23.     foreach spec in all_unm nih_unm nih_cs nih_cem all_cem {
 24.         local rr = rownumb(mcar_`yvar'`suf', "`spec'")
 25.         if mi(mcar_`yvar'`suf'[`rr', 1]) continue
 26.         local line_b  "`lbl_`spec''"
 27.         local line_se ""
 28.         forval j = 1(2)5 {
 29.             _mc_fmt `=mcar_`yvar'`suf'[`rr', `j']' `=mcar_`yvar'`suf'[`rr', `j' + 1]'
 30.             local line_b  "`line_b' & `r(b_s)'"
 31.             local line_se "`line_se' & `r(se_s)'"
 32.         }
 33.         _mc_num `=mcar_`yvar'`suf'[`rr', 9]' %9.0fc
 34.         local n_y "`r(s)'"
 35.         _mc_num `=mcar_`yvar'`suf'[`rr', 10]' %9.0fc
 36.         local n_o "`r(s)'"
 37.         file write `fh' "`line_b' & `n_y' / `n_o' \\" _n
 38.         file write `fh' "`line_se' & \\" _n
 39.     }
 40.     cap confirm matrix mper_`yvar'`suf'
 41.     if !_rc {
 42.         file write `fh' "\addlinespace" _n
 43.         file write `fh' "\multicolumn{5}{l}{\textit{Panel B: Persistence of the career-stage gap}} \\" _n
 44.         foreach spec in all_unm nih_cem {
 45.             local rr = rownumb(mper_`yvar'`suf', "`spec'")
 46.             if mi(mper_`yvar'`suf'[`rr', 1]) continue
 47.             local rc_ = rownumb(mcar_`yvar'`suf', "`spec'")
 48.             _mc_num `=mcar_`yvar'`suf'[`rc_', 9]' %9.0fc
 49.             local n_y "`r(s)'"
 50.             _mc_num `=mcar_`yvar'`suf'[`rc_', 10]' %9.0fc
 51.             local n_o "`r(s)'"
 52.             foreach k in 1 2 {
 53.                 local c0 = cond(`k' == 1, 0, 7)
 54.                 local win = cond(`k' == 1, "2014--2016", "2017--2019")
 55.                 local line_b  "`plbl_`spec'', `win'"
 56.                 local line_se ""
 57.                 forval j = 1(2)5 {
 58.                     _mc_fmt `=mper_`yvar'`suf'[`rr', `c0' + `j']' `=mper_`yvar'`suf'[`rr', `c0' + `j' + 1]'
 59.                     local line_b  "`line_b' & `r(b_s)'"
 60.                     local line_se "`line_se' & `r(se_s)'"
 61.                 }
 62.                 file write `fh' "`line_b' & `n_y' / `n_o' \\" _n
 63.                 file write `fh' "`line_se' & \\" _n
 64.             }
 65.             _mc_fmt `=mper_`yvar'`suf'[`rr', 15]' `=mper_`yvar'`suf'[`rr', 16]'
 66.             file write `fh' "\quad Change in gap, 2017--19 minus 2014--16 & & & `r(b_s)' & \\" _n
 67.             file write `fh' " & & & `r(se_s)' & \\" _n
 68.             file write `fh' "\addlinespace" _n
 69.         }
 70.     }
 71.     file write `fh' "\bottomrule" _n
 72.     file write `fh' "\end{tabular}" _n
 73.     file write `fh' "\end{table}" _n
 74.     file close `fh'
 75.     di as text "wrote `out'"
 76. end

. 
. program write_matched_balance_tex
  1.     syntax, samp(string) [suf(string)]
  2.     cap confirm matrix mbal_nih`suf'
  3.     if _rc exit 0
  4.     local out ../output/tables/`samp'/matched_balance`suf'.tex
  5.     local lbl_lab_age_2014    "Years running lab in 2014"
  6.     local lbl_pre_ppr_cnt_sum "Pre-merger last-author papers, 2010--2013"
  7.     local lbl_pre_cite_sum    "Pre-merger citation-weighted output"
  8.     local lbl_exposure        "Exposure"
  9.     local lbl_mkt_spend_shr   "Treated-market spending share"
 10.     local lbl_ln_nihd         "Log baseline NIH funding (zero if no award)"
 11.     local lbl_any_award       "Any baseline NIH research award"
 12.     local lbl_topic_mean_abs  "Research topic, mean abs.\ std.\ diff.\ across clusters"
 13.     local lbl_topic_max_abs   "Research topic, max abs.\ std.\ diff.\ across clusters"
 14.     local fmt_lab_age_2014    %9.1f
 15.     local fmt_pre_ppr_cnt_sum %9.1f
 16.     local fmt_pre_cite_sum    %9.1f
 17.     local fmt_exposure        %9.3f
 18.     local fmt_mkt_spend_shr   %9.3f
 19.     local fmt_ln_nihd         %9.2f
 20.     local fmt_any_award       %9.2f
 21.     tempname fh
 22.     file open `fh' using "`out'", write replace
 23.     file write `fh' "\begin{table}[htbp]" _n
 24.     file write `fh' "\centering" _n
 25.     file write `fh' "\caption{Covariate Balance: Early- versus Late-Career PIs with NIH Records}" _n
 26.     file write `fh' "\label{tab:matched_balance`suf'}" _n
 27.     file write `fh' "\begin{tabular}{lcccccc}" _n
 28.     file write `fh' "\toprule" _n
 29.     file write `fh' " & \multicolumn{3}{c}{All PIs with NIH records} & \multicolumn{3}{c}{Common support, late-career reweighted} \\" _n
 30.     file write `fh' "\cmidrule(lr){2-4} \cmidrule(lr){5-7}" _n
 31.     file write `fh' " & Early & Late & Std.\ diff. & Early & Late & Std.\ diff. \\" _n
 32.     file write `fh' "\midrule" _n
 33.     local rn : rownames mbal_nih`suf'
 34.     local nb = rowsof(mbal_nih`suf')
 35.     forval i = 1/`nb' {
 36.         local v : word `i' of `rn'
 37.         local lbl "`lbl_`v''"
 38.         if "`lbl'" == "" local lbl "`v'"
 39.         local f "`fmt_`v''"
 40.         if "`f'" == "" local f %9.3f
 41.         local line "`lbl'"
 42.         forval j = 1/6 {
 43.             local cf = cond(inlist(`j', 3, 6), "%9.3f", "`f'")
 44.             _mc_num `=mbal_nih`suf'[`i', `j']' `cf'
 45.             local line "`line' & `r(s)'"
 46.         }
 47.         file write `fh' "`line' \\" _n
 48.     }
 49.     cap confirm matrix mcs_nih`suf'
 50.     if !_rc {
 51.         file write `fh' "\midrule" _n
 52.         _mc_num `=mcs_nih`suf'[1, 3]' %9.0fc
 53.         local a "`r(s)'"
 54.         _mc_num `=mcs_nih`suf'[1, 5]' %9.0fc
 55.         local b "`r(s)'"
 56.         _mc_num `=mcs_nih`suf'[1, 4]' %9.0fc
 57.         local c "`r(s)'"
 58.         _mc_num `=mcs_nih`suf'[1, 6]' %9.0fc
 59.         local d "`r(s)'"
 60.         file write `fh' "PIs & `a' & `b' & & `c' & `d' & \\" _n
 61.         _mc_num `=mcs_nih`suf'[1, 1]' %9.0fc
 62.         local a "`r(s)'"
 63.         _mc_num `=mcs_nih`suf'[1, 2]' %9.0fc
 64.         local b "`r(s)'"
 65.         file write `fh' "Matching cells (topic $\times$ pre-merger output $\times$ NIH funding) & \multicolumn{3}{c}{`a'} & \multicolumn{3}{c}{`b' with both career stages} \\" _n
 66.     }
 67.     file write `fh' "\bottomrule" _n
 68.     file write `fh' "\end{tabular}" _n
 69.     file write `fh' "\end{table}" _n
 70.     file close `fh'
 71.     di as text "wrote `out'"
 72. end

. 
. program output_matched_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir ../output/tables
  8.     cap mkdir ../output/tables/`samp'
  9.     foreach m in mcs_nih mcs_all mbal_nih mbal_all {
 10.         cap confirm matrix `m'`suf'
 11.         if _rc continue
 12.         qui matrix_to_txt, saving("../output/tables/`samp'/matched_`m'`suf'.txt") ///
>             matrix(`m'`suf') title(<tab:matched_`m'`suf'>) format(%20.4f) replace
 13.     }
 14.     local yvar_list ppr_cnt cite_affl_wt
 15.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 16.     foreach yvar of local yvar_list {
 17.         foreach m in mcar mper {
 18.             cap confirm matrix `m'_`yvar'`suf'
 19.             if _rc continue
 20.             qui matrix_to_txt, saving("../output/tables/`samp'/matched_`m'_`yvar'`suf'.txt") ///
>                 matrix(`m'_`yvar'`suf') title(<tab:matched_`m'_`yvar'`suf'>) format(%20.4f) replace
 21.         }
 22.         write_matched_tex, samp(`samp') yvar(`yvar') suf(`suf')
 23.     }
 24.     write_matched_balance_tex, samp(`samp') suf(`suf')
 25. end

. 
. program ppml_het_coefplot
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     if "`yvar'" != "" {
  8.         local resfile "../temp/phet_results_`samp'`suf'_`yvar'.dta"
  9.     }
 10.     else {
 11.         local resfile "../temp/phet_results_`samp'`suf'.dta"
 12.     }
 13.     cap confirm file "`resfile'"
 14.     if _rc {
 15.         di as error "ppml_het_coefplot: `resfile' not found -- skipping"
 16.         exit 0
 17.     }
 18. 
.     local ppml_het_yvars ppr_cnt ppr_cnt_nonsolo cite_affl_wt avg_num_coathrs ///
>                         n_grants n_new_grants nih_total_cost ///
>                         n_middle_ppr
 19.     if "`yvar'" != "" local ppml_het_yvars `yvar'
 20. 
.     local ic_fund_aliases tfnd lsf
 21.     local ic_expx_aliases endow
 22.     if $HET_IC_FULL == 1 {
 23.         local ic_fund_aliases contr fdlsb fdls fdlsh gntsf hhlsb hhls hhlsh nflsb nfls nflsh subrf busf fedf tfnd instf nonpf statf lsf hsf biof
 24.         local ic_expx_aliases applx apfx basx bfx clinx devx lscx medx endow
 25.     }
 26. 
.     local st_list med_pi joint_ae
 27.     if "$HET_INCLUDE_INSTWTD" == "1" local st_list med `st_list'
 28.     if "$HET_RUN_QUARTILES" == "1" {
 29.         local st_list `st_list' quart_pi
 30.         if "$HET_INCLUDE_INSTWTD" == "1" local st_list `st_list' quart
 31.     }
 32.     foreach st of local st_list {
 33.         local groups_core
 34.         local groups_core_any
 35.         if strpos("`st'", "joint_") == 1 {
 36.             local groups_pi
 37.             local groups_ic_fund
 38.             local groups_ic_expx
 39.         }
 40.         else if "`st'" == "med" {
 41.             local groups_pi
 42.             foreach pair of global COEFPLOT_PI_PAIRS {
 43.                 local groups_pi `groups_pi' `pair'
 44.             }
 45.             local groups_ic_fund
 46.             foreach a of local ic_fund_aliases {
 47.                 local groups_ic_fund `groups_ic_fund' hi_`a' lo_`a'
 48.             }
 49.             local groups_ic_expx
 50.             foreach a of local ic_expx_aliases {
 51.                 local groups_ic_expx `groups_ic_expx' hi_`a' lo_`a'
 52.             }
 53.             local groups_core young old hi_tfnd lo_tfnd hi_endow lo_endow
 54.         }
 55.         else if "`st'" == "med_pi" {
 56.             local groups_pi
 57.             foreach pair of global COEFPLOT_PI_PAIRS {
 58.                 local groups_pi `groups_pi' `pair'
 59.             }
 60.             local groups_ic_fund
 61.             foreach a of local ic_fund_aliases {
 62.                 local groups_ic_fund `groups_ic_fund' hiw_`a' low_`a'
 63.             }
 64.             local groups_ic_expx
 65.             foreach a of local ic_expx_aliases {
 66.                 local groups_ic_expx `groups_ic_expx' hiw_`a' low_`a'
 67.             }
 68.             local groups_core young old hiw_tfnd low_tfnd hiw_endow low_endow
 69.             local groups_core_any young old young_any old_any hiw_tfnd low_tfnd hiw_endow low_endow
 70.         }
 71.         else if "`st'" == "quart" {
 72.             local groups_pi
 73.             foreach b of global PI_Q_BASES {
 74.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 75.             }
 76.             local groups_ic_fund
 77.             foreach a of local ic_fund_aliases {
 78.                 local groups_ic_fund `groups_ic_fund' q4_`a' q1_`a'
 79.             }
 80.             local groups_ic_expx
 81.             foreach a of local ic_expx_aliases {
 82.                 local groups_ic_expx `groups_ic_expx' q4_`a' q1_`a'
 83.             }
 84.         }
 85.         else {
 86.             local groups_pi
 87.             foreach b of global PI_Q_BASES {
 88.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 89.             }
 90.             local groups_ic_fund
 91.             foreach a of local ic_fund_aliases {
 92.                 local groups_ic_fund `groups_ic_fund' q4w_`a' q1w_`a'
 93.             }
 94.             local groups_ic_expx
 95.             foreach a of local ic_expx_aliases {
 96.                 local groups_ic_expx `groups_ic_expx' q4w_`a' q1w_`a'
 97.             }
 98.         }
 99. 
.         foreach spec_tag in mshrctrl {
100.             local spec_folder = cond($HET_IC_FULL == 1, "coefplot_evavg_full", "coefplot_evavg")
101.             cap mkdir "../output/figures/`samp'/`spec_folder'"
102. 
.         local groups_all `groups_pi' `groups_ic_fund' `groups_ic_expx'
103.         foreach panel in pi ic_fund ic_expx core core_any all {
104.             local groups `groups_`panel''
105.             local n_groups : word count `groups'
106.             if `n_groups' == 0 continue
107. 
.             foreach yv of local ppml_het_yvars {
108.                 preserve
109.                 use "`resfile'", clear
110.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
111.                 if _N == 0 {
112.                     restore
113.                     continue
114.                 }
115. 
.                 local groups_present
116.                 foreach g of local groups {
117.                     qui count if grp == "`g'" & !mi(post_b)
118.                     if r(N) > 0 local groups_present `groups_present' `g'
119.                 }
120.                 local groups `groups_present'
121.                 local n_groups : word count `groups'
122.                 if `n_groups' == 0 {
123.                     restore
124.                     continue
125.                 }
126. 
.                 local within 0.6
127.                 local between 1.25
128.                 local npairs = ceil(`n_groups'/2)
129.                 gen double y = .
130.                 local ylabs ""
131.                 local i = 0
132.                 foreach g of local groups {
133.                     local ++i
134.                     local pair = int((`i'-1)/2)
135.                     local ypos = (`n_groups' - `i')*`within' + (`npairs' - 1 - `pair')*(`between' - `within') + 1
136.                     qui replace y = `ypos' if grp == "`g'"
137.                     local lbl = "${LBL_`g'}"
138.                     if "`lbl'" == "" local lbl "`g'"
139.                     if length("`lbl'") > 40 local lbl = substr("`lbl'", 1, 37) + "..."
140.                     local ylabs `"`ylabs' `ypos' "`lbl'""'
141.                 }
142.                 drop if mi(y) | mi(post_b)
143.                 if _N == 0 {
144.                     restore
145.                     continue
146.                 }
147.                 gen ub = post_b + 1.96*post_se
148.                 gen lb = post_b - 1.96*post_se
149. 
.                 qui sum lb
150.                 local xmin = min(-2, floor(r(min)/0.5)*0.5)
151.                 qui sum ub
152.                 local xmax = max(1, ceil(r(max)/0.5)*0.5)
153.                 local xstep 0.5
154. 
.                 local ysize = round(0.28 * ((`n_groups' - 1)*`within' + (`npairs' - 1)*(`between' - `within') + 1), 0.1)
155.                 local ysize = max(2, min(14, `ysize'))
156.                 local xsize 6
157. 
.                 gen byte hl = inlist(grp, "young", "old", "young_any", "old_any") & strpos("`panel'", "core") == 1
158.                 local hl_plots
159.                 qui count if hl == 1
160.                 if r(N) > 0 {
161.                     local hl_plots `" || rcap ub lb y if hl == 1, horizontal lcolor(dkorange%70) msize(half_tiny) || scatter y post_b if hl == 1, mcolor(dkorange) msize(tiny)"'
162.                 }
163. 
.                 tw rcap ub lb y if hl == 0, horizontal lcolor(ebblue%70) msize(half_tiny) || ///
>                    scatter y post_b if hl == 0, mcolor(ebblue) msize(tiny) `hl_plots' ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(medsmall) noticks nogrid) ///
>                      ytitle("") xtitle("Output-cost elasticity", size(medium)) ///
>                      xlabel(`xmin'(`xstep')`xmax', labsize(small)) ///
>                      legend(off) ///
>                      ysize(`ysize') xsize(`xsize') ///
>                      yscale(range(0.9 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
164.                 fig_export, path("../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf") xsize(`xsize') ysize(`ysize')
165.                 di as text "wrote ../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf"
166.                 restore
167.             }
168.         }
169. 
.         if "`st'" == "joint_ae" {
170.             local pfx_len   1
171.             local hi_pfx    y
172.             local lo_pfx    o
173.             local hi_leg    "Early-career"
174.             local lo_leg    "Late-career"
175.             local filename_stem joint_ae_paired
176.             local hilo_pos = `pfx_len' + 2
177.             local char_pos = `pfx_len' + 5
178.             foreach yv of local ppml_het_yvars {
179.                 preserve
180.                 use "`resfile'", clear
181.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
182.                 if _N == 0 {
183.                     restore
184.                     continue
185.                 }
186.                 gen str2  pfx_c  = substr(grp, 1, `pfx_len')
187.                 gen str2  hilo_c = substr(grp, `hilo_pos', 2)
188.                 gen str12 char_c = substr(grp, `char_pos', .)
189.                 gen byte  is_hi_side = (pfx_c == "`hi_pfx'")
190.                 gen char_idx = .
191.                 local ii = 0
192.                 foreach a of global IC_ALIASES {
193.                     local ++ii
194.                     qui replace char_idx = `ii' if char_c == "`a'"
195.                 }
196.                 qui drop if mi(char_idx)
197.                 if _N == 0 {
198.                     restore
199.                     continue
200.                 }
201.                 qui sum char_idx
202.                 local nchars = r(max)
203.                 gen double y_group = (`nchars' + 1 - char_idx) * 3.2
204.                 gen double y_pos   = y_group ///
>                     + cond(hilo_c == "hi" & is_hi_side == 1,  1.0, ///
>                       cond(hilo_c == "hi" & is_hi_side == 0,  0.4, ///
>                       cond(hilo_c == "lo" & is_hi_side == 1, -0.4, -1.0)))
205.                 gen ub = post_b + 1.96*post_se
206.                 gen lb = post_b - 1.96*post_se
207. 
.                 local ylabs
208.                 forvalues i = 1/`nchars' {
209.                     qui levelsof char_c if char_idx == `i', local(cname) clean
210.                     local clbl = "${LBL_ic_`cname'}"
211.                     if "`clbl'" == "" local clbl "`cname'"
212.                     local base = (`nchars' + 1 - `i') * 3.2
213.                     local pos_hi = `base' + 1.0
214.                     local pos_lo = `base' - 0.4
215.                     local ylabs `"`ylabs' `pos_hi' "High `clbl'""'
216.                     local ylabs `"`ylabs' `pos_lo' "Low `clbl'""'
217.                 }
218. 
.                 qui sum lb
219.                 local xmin = floor(r(min)/0.5)*0.5
220.                 qui sum ub
221.                 local xmax = ceil(r(max)/0.5)*0.5
222. 
.                 tw rcap ub lb y_pos if is_hi_side == 1, horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>                    scatter y_pos post_b if is_hi_side == 1, mcolor(ebblue) msize(small)              || ///
>                    rcap ub lb y_pos if is_hi_side == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                    scatter y_pos post_b if is_hi_side == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Output-cost elasticity", size(medsmall)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(order(2 "`hi_leg'" 4 "`lo_leg'") pos(6) ring(1) rows(1) span size(small)) ///
>                      xsize(4) ysize(`=max(8, `nchars'*1.6) * 4/9') ///
>                      yscale(range(2.1 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
223.                 fig_export, path("../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`filename_stem'`suf'.pdf")
224.                 di as text "wrote `filename_stem' coefplot for `yv' `spec_tag'"
225.                 restore
226.             }
227.             joint_ae_panel_coefplot, resfile("`resfile'") yvars(`ppml_het_yvars') samp(`samp') ///
>                 suf(`suf') spec_folder(`spec_folder') spec_tag(`spec_tag')
228.         }
229. 
.         }
230.     }
231. end

. 
. program joint_ae_panel_coefplot
  1.     syntax, resfile(string) yvars(string) samp(string) spec_folder(string) spec_tag(string) [suf(string)]
  2.     foreach a of global JOINT_AE_CHARS {
  3.         local clbl = "${LBL_ic_`a'}"
  4.         if "`clbl'" == "" local clbl "`a'"
  5.         foreach yv of local yvars {
  6.             preserve
  7.             use "`resfile'", clear
  8.             keep if yvar == "`yv'" & spec == "`spec_tag'" & split_type == "joint_ae"
  9.             keep if inlist(grp, "y_hi_`a'", "o_hi_`a'", "y_lo_`a'", "o_lo_`a'")
 10.             qui count if split_type == "joint_ae" & !mi(post_b)
 11.             if r(N) < 4 {
 12.                 restore
 13.                 continue
 14.             }
 15.             gen byte early = substr(grp, 1, 1) == "y"
 16.             gen ub = post_b + 1.96*post_se
 17.             gen lb = post_b - 1.96*post_se
 18. 
.             gen double x = .
 19.             replace x = 1   if grp == "y_hi_`a'"
 20.             replace x = 2   if grp == "o_hi_`a'"
 21.             replace x = 3.5 if grp == "y_lo_`a'"
 22.             replace x = 4.5 if grp == "o_lo_`a'"
 23.             local lbl_hi "${LBL_hiw_`a'}"
 24.             local lbl_lo "${LBL_low_`a'}"
 25.             if "`a'" == "nihd" {
 26.                 local lbl_hi "${LBL_high_nihd}"
 27.                 local lbl_lo "${LBL_low_nihd}"
 28.             }
 29.             gen double b_early = post_b if early == 1
 30.             gen double b_late  = post_b if early == 0
 31.             sort x
 32. 
.             qui sum lb
 33.             local ymin = min(-2, floor(r(min)/0.5)*0.5)
 34.             qui sum ub
 35.             local ymax = max(1, ceil(r(max)/0.5)*0.5)
 36.             local ystep 0.5
 37. 
.             foreach fmode of global FIG_MODES {
 38.                 local late_col = cond("`fmode'" == "paper", "gs8", "dkorange")
 39.                 tw rcap ub lb x if early == 1, lcolor(ebblue%70) msize(vsmall) || ///
>                    rcap ub lb x if early == 0, lcolor(`late_col'%70) msize(vsmall) || ///
>                    connected b_early x, cmissing(n) lcolor(ebblue%70) mcolor(ebblue) || ///
>                    connected b_late  x, cmissing(n) lcolor(`late_col'%70) mcolor(`late_col') ///
>                    , yline(0, lcolor(gs10) lpattern(solid)) ///
>                      xline(2.75, lcolor(gs12) lpattern(dash)) ///
>                      xlabel(1.5 "`lbl_hi'" 4 "`lbl_lo'", labsize(medsmall) noticks nogrid) ///
>                      xsc(r(0.5 5)) xtitle("") ///
>                      ylabel(`ymin'(`ystep')`ymax') ytitle("Output-cost elasticity", size(medium)) ysc(titlegap(1) outergap(0)) ///
>                      legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(6) ring(1) rows(1) symxsize(*0.4) size(small)) ///
>                      plotregion(margin(sides))
 40.                 fig_export, path("../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_joint_ae_panel_`a'`suf'.pdf") mode(`fmode')
 41.             }
 42.             di as text "wrote ../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_joint_ae_panel_`a'`suf'.pdf"
 43.             restore
 44.         }
 45.     }
 46. end

