 43.     local ic_lbl_hhls  "HHS Life-Sci Funding"
 44.     local ic_lbl_hhlsh "HHS Life-Sci Health-Sci Funding"
 45.     local ic_lbl_nflsb "Non-Federal Life-Sci Biology Funding"
 46.     local ic_lbl_nfls  "Non-Federal Life-Sci Funding"
