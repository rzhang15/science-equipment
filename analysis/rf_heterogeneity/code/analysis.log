. program main
  1.     if $HET_COEFPLOTS_ONLY == 1 {
  2.         define_group_labels
  3.         ppml_het_coefplot, samp(all_jrnls) r1r2(1) public(0)
  4.         ppml_het_coefplot, samp(all_jrnls) r1r2(1) public(1)
  5.         exit
  6.     }
  7.     if $HET_MATCHED_ONLY == 1 {
  8.         cap mkdir ../temp
  9.         cap mkdir "../output/figures/all_jrnls"
 10.         gather_inst_chars
 11.         define_group_labels
 12.         add_het_splits, samp(all_jrnls) r1r2(1) public(0)
 13.         matched_career_comparison, samp(all_jrnls) r1r2(1) public(0)
 14.         output_matched_tables, samp(all_jrnls) r1r2(1) public(0)
 15.         exit
 16.     }
 17.     gather_inst_chars
 18.     define_group_labels
 19.     local s all_jrnls
 20.     if $HET_SPLITS_ONLY == 1 {
 21.         add_het_splits, samp(`s') r1r2(1) public(0)
 22.         add_het_splits, samp(`s') r1r2(1) public(1)
 23.         di as text "NIH_SPLITS_REBUILT ($NIH_BASELINE_MEASURE)"
 24.         exit
 25.     }
 26.     cap mkdir "../output/figures/`s'"
 27.     if $HET_HORSERACE_ONLY == 1 {
 28.         cap mkdir ../temp
 29.         * Rebuild groups so switching measures never reuses stale labels.
.         add_het_splits, samp(`s') r1r2(1) public(0)
 30.         add_het_splits, samp(`s') r1r2(1) public(1)
 31.         desc_exposure_by_age, samp(`s') r1r2(1) public(0)
 32.         desc_exposure_by_age, samp(`s') r1r2(1) public(1)
 33.     }
 34.     if $HET_HORSERACE_ONLY == 0 {
 35.         add_het_splits, samp(`s') r1r2(1) public(0)
 36.         desc_pre_output_by_age, samp(`s') r1r2(1) public(0)
 37.         desc_exposure_by_age, samp(`s') r1r2(1) public(0)
 38.         event_study_het, samp(`s') r1r2(1) public(0)
 39.         ppml_age_gradient, samp(`s') r1r2(1) public(0)
 40.     }
 41.     horse_race_nih, samp(`s') r1r2(1) public(0)
 42.     output_het_tables, samp(`s') r1r2(1) public(0)
 43.     output_split_diff_tables, samp(`s') r1r2(1) public(0)
 44.     if $HET_HORSERACE_ONLY == 0 {
 45.         matched_career_comparison, samp(`s') r1r2(1) public(0)
 46.         output_matched_tables, samp(`s') r1r2(1) public(0)
 47.     }
 48. 
.     if $HET_HORSERACE_ONLY == 0 {
 49.         add_het_splits, samp(all_jrnls) r1r2(1) public(1)
 50.         desc_pre_output_by_age, samp(all_jrnls) r1r2(1) public(1)
 51.         desc_exposure_by_age, samp(all_jrnls) r1r2(1) public(1)
 52.         event_study_het, samp(all_jrnls) r1r2(1) public(1)
 53.         ppml_age_gradient, samp(all_jrnls) r1r2(1) public(1)
 54.     }
 55.     horse_race_nih, samp(all_jrnls) r1r2(1) public(1)
 56.     output_het_tables, samp(all_jrnls) r1r2(1) public(1)
 57.     output_split_diff_tables, samp(all_jrnls) r1r2(1) public(1)
 58.     if $HET_HORSERACE_ONLY == 0 {
 59.         matched_career_comparison, samp(all_jrnls) r1r2(1) public(1)
 60.         output_matched_tables, samp(all_jrnls) r1r2(1) public(1)
 61.     }
 62. end

