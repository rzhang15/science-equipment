. program main
  1.     if $HET_COEFPLOTS_ONLY == 1 {
  2.         define_group_labels
  3.         ppml_het_coefplot, samp(all_jrnls) r1r2(1) public(0)
  4.         ppml_het_coefplot, samp(all_jrnls) r1r2(1) public(1)
  5.         exit
  6.     }
  7.     gather_inst_chars
  8.     define_group_labels
  9.     local s all_jrnls
 10.     if $HET_SPLITS_ONLY == 1 {
 11.         add_het_splits, samp(`s') r1r2(1) public(0)
 12.         add_het_splits, samp(`s') r1r2(1) public(1)
 13.         di as text "NIH_SPLITS_REBUILT ($NIH_BASELINE_MEASURE)"
 14.         exit
 15.     }
 16.     cap mkdir "../output/figures/`s'"
 17.     if $HET_HORSERACE_ONLY == 1 {
 18.         cap mkdir ../temp
 19.         * Rebuild groups so switching measures never reuses stale labels.
.         add_het_splits, samp(`s') r1r2(1) public(0)
 20.         add_het_splits, samp(`s') r1r2(1) public(1)
 21.         desc_exposure_by_age, samp(`s') r1r2(1) public(0)
 22.         desc_exposure_by_age, samp(`s') r1r2(1) public(1)
 23.     }
 24.     if $HET_HORSERACE_ONLY == 0 {
 25.         add_het_splits, samp(`s') r1r2(1) public(0)
 26.         desc_pre_output_by_age, samp(`s') r1r2(1) public(0)
 27.         desc_exposure_by_age, samp(`s') r1r2(1) public(0)
 28.         event_study_het, samp(`s') r1r2(1) public(0)
 29.         ppml_age_gradient, samp(`s') r1r2(1) public(0)
 30.     }
 31.     horse_race_nih, samp(`s') r1r2(1) public(0)
 32.     output_het_tables, samp(`s') r1r2(1) public(0)
 33.     output_split_diff_tables, samp(`s') r1r2(1) public(0)
 34. 
.     if $HET_HORSERACE_ONLY == 0 {
 35.         add_het_splits, samp(all_jrnls) r1r2(1) public(1)
 36.         desc_pre_output_by_age, samp(all_jrnls) r1r2(1) public(1)
 37.         desc_exposure_by_age, samp(all_jrnls) r1r2(1) public(1)
 38.         event_study_het, samp(all_jrnls) r1r2(1) public(1)
 39.         ppml_age_gradient, samp(all_jrnls) r1r2(1) public(1)
 40.     }
 41.     horse_race_nih, samp(all_jrnls) r1r2(1) public(1)
 42.     output_het_tables, samp(all_jrnls) r1r2(1) public(1)
 43.     output_split_diff_tables, samp(all_jrnls) r1r2(1) public(1)
 44. end

