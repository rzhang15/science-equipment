. program main
  1.     gather_inst_chars
  2.     define_group_labels
  3.     local s all_jrnls
  4.     cap mkdir "../output/figures/`s'"
  5.     if $HET_HORSERACE_ONLY == 0 {
  6.         add_het_splits, samp(`s') r1r2(1) public(0)
  7.         desc_pre_output_by_age, samp(`s') r1r2(1) public(0)
  8.         event_study_het, samp(`s') r1r2(1) public(0)
  9.         ppml_age_gradient, samp(`s') r1r2(1) public(0)
 10.     }
 11.     horse_race_nih, samp(`s') r1r2(1) public(0)
 12.     output_het_tables, samp(`s') r1r2(1) public(0)
 13.     output_split_diff_tables, samp(`s') r1r2(1) public(0)
 14. 
.     if $HET_HORSERACE_ONLY == 0 {
 15.         add_het_splits, samp(all_jrnls) r1r2(1) public(1)
 16.         desc_pre_output_by_age, samp(all_jrnls) r1r2(1) public(1)
 17.         event_study_het, samp(all_jrnls) r1r2(1) public(1)
 18.         ppml_age_gradient, samp(all_jrnls) r1r2(1) public(1)
 19.     }
 20.     horse_race_nih, samp(all_jrnls) r1r2(1) public(1)
 21.     output_het_tables, samp(all_jrnls) r1r2(1) public(1)
 22.     output_split_diff_tables, samp(all_jrnls) r1r2(1) public(1)
 23. end

