331.                         local num_athrs = r(unique)
332.                         gunique inst_id if e(sample) & `grp' == 1
333.                         local num_insts = r(unique)
334.                         local b_post  = _b[Z_`grp']
335.                         local se_post = _se[Z_`grp']
336.                         di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `aspec': b=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
337.                         post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`aspec'") ///
>                             (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
338.                     }
339. 
.                     * --- Joint event-study PPML for per-group ES PDFs only (not posted) ---
.                     local all_leads
340.                     local all_lags
341.                     local all_mshr
342.                     foreach grp of local agrps {
343.                         local all_leads `all_leads' `leads_`grp''
344.                         local all_lags  `all_lags'  `lags_`grp''
345.                         local all_mshr  `all_mshr'  `mleads_`grp'' `mlags_`grp''
346.                     }
347.                     local plot_suf "_ppml_`aspec'_mshrctrl"
348.                     cap noi ppmlhdfe `yvar' `all_leads' `all_lags' ///
>                                             `all_mshr' `PTs', ///
>                                             absorb(`fes') vce(cluster `vce_cl')
349.                     if _rc {
