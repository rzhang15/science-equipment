. program add_het_splits
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     use ../external/prepped_samples/es_`samp'`suf', clear
  8. 
.     * NIH eligibility comes from the fuzzy-name crosswalk, before award
.     * filters. Retained-award names alone omit matched PIs with no retained
.     * research awards. Never infer a name match from funding or future awards.
.     tempfile nih_name_matches
  9.     preserve
 10.         import delimited ../external/nih/pi_athr_crosswalk.csv, ///
>             clear varnames(1) stringcols(_all)
 11.         keep athr_id
 12.         drop if mi(athr_id)
 13.         duplicates drop athr_id, force
 14.         gen byte nih_name_matched = 1
 15.         save `nih_name_matches', replace
 16.     restore
 17.     cap drop nih_name_matched
 18.     merge m:1 athr_id using `nih_name_matches', keep(1 3) nogen
 19.     replace nih_name_matched = 0 if mi(nih_name_matched)
 20. 
.     * Recover recorded annual research awards masked by reduced_form's
.     * baseline-positive restriction. Zero is no retained award record for a
.     * matched PI; unmatched PIs have missing NIH outcomes.
.     drop nih_total_cost n_grants n_new_grants has_nih
 21.     merge 1:1 athr_id year using ../external/nih/nih_athr_year, ///
>         keep(1 3) keepusing(nih_total_cost n_grants n_new_grants) nogen
 22.     foreach v in nih_total_cost n_grants n_new_grants {
 23.         replace `v' = 0 if mi(`v') & nih_name_matched == 1
 24.         replace `v' = . if nih_name_matched != 1
 25.     }
 26.     gen byte has_nih = n_grants > 0 if nih_name_matched == 1
 27. 
.     cap drop athr_indicator
 28.     bys athr_id : gen athr_indicator = _n == 1
 29. 
.     if "$LAB_CLOCK" == "athr_age" {
 30.         merge m:1 athr_id using ../external/athr_age/athr_age, ///
>             keep(1 3) keepusing(first_last) nogen
 31.         cap confirm variable min_year_nonsolo
 32.         if !_rc replace min_year = min(first_last, min_year_nonsolo)
 33.         else {
 34.             di as error "add_het_splits `samp'`suf': min_year_nonsolo not in panel -- lab clock = first_last only"
 35.             replace min_year = first_last
 36.         }
 37.         qui count if athr_indicator == 1 & mi(min_year)
 38.         di as text "add_het_splits `samp'`suf': lab clock = min(athr_age first_last, min_year_nonsolo); " ///
>             r(N) " PIs with neither drop from lab-age splits"
 39.         drop first_last
 40.     }
 41. 
.     qui sum min_year if athr_indicator == 1, d
 42.     local lastyr_med = r(p50)
 43.     di as text "add_het_splits `samp'`suf' min_year (first last-author yr) median = `lastyr_med'"
 44.     gen young = min_year >  `lastyr_med' if !mi(min_year)
 45.     gen old   = min_year <= `lastyr_med' if !mi(min_year)
 46. 
.     cap confirm variable min_year_nonsolo
 47.     if !_rc {
 48.         qui sum min_year_nonsolo if athr_indicator == 1, d
 49.         local nsyr_med = r(p50)
 50.         qui count if athr_indicator == 1 & mi(min_year_nonsolo)
 51.         di as text "add_het_splits `samp'`suf' min_year_nonsolo median = `nsyr_med'; " r(N) " PIs with no non-solo last-author paper"
 52.         gen byte young_ns = min_year_nonsolo >  `nsyr_med' if !mi(min_year_nonsolo)
 53.         gen byte old_ns   = min_year_nonsolo <= `nsyr_med' if !mi(min_year_nonsolo)
 54.         gen lab_age_ns_2014 = 2014 - min_year_nonsolo
 55.     }
 56.     else di as error "add_het_splits `samp'`suf': min_year_nonsolo not in panel -- young_ns/old_ns SKIPPED (rerun reduced_form/code/analysis.do)."
 57. 
.     cap confirm variable min_year_any
 58.     if !_rc {
 59.         qui sum min_year_any if athr_indicator == 1, d
 60.         local anyyr_med = r(p50)
 61.         di as text "add_het_splits `samp'`suf' min_year_any (first pub ever) median = `anyyr_med'"
 62.         gen byte young_any = min_year_any >  `anyyr_med' if !mi(min_year_any)
 63.         gen byte old_any   = min_year_any <= `anyyr_med' if !mi(min_year_any)
 64.         gen lab_age_any_2014 = 2014 - min_year_any
 65.     }
 66.     else di as error "add_het_splits `samp'`suf': min_year_any not in panel -- young_any/old_any SKIPPED."
 67. 
.     gen r1 = type == "r1" if !mi(type)
 68.     gen r2 = type == "r2" if !mi(type)
 69.     gen byte pub_inst  = public == 1 if !mi(public)
 70.     gen byte priv_inst = public == 0 if !mi(public)
 71. 
.     * Baselines come from all four FY2010-2013 NIH years, with absent
.     * award-years counted as zero, before publication-panel restrictions.
.     * Read the authoritative baselines directly; reduced_form need not rerun.
.     foreach v in nih_grants_baseline nih_funding_baseline nih_funding_baseline_pi {
 72.         cap drop `v'
 73.     }
 74.     merge m:1 athr_id using ../external/nih/nih_baseline_by_athr, ///
>         keep(1 3) keepusing(nih_grants_baseline nih_funding_baseline nih_funding_baseline_pi) nogen
 75.     local funding_src nih_funding_baseline
 76.     if "$NIH_BASELINE_MEASURE" == "pi" local funding_src nih_funding_baseline_pi
 77.     gen str4 nih_baseline_measure = "$NIH_BASELINE_MEASURE"
 78.     di as text "NIH funding groups use `funding_src' ($NIH_BASELINE_MEASURE)"
 79.     local nih_src   nih_grants_baseline `funding_src'
 80.     local nih_alias nihg     nihd
 81.     forvalues i = 1/2 {
 82.         local src : word `i' of `nih_src'
 83.         local alias : word `i' of `nih_alias'
 84.         cap confirm variable `src'
 85.         if _rc {
 86.             di as error "add_het_splits `samp'`suf': `src' missing -- rebuild NIH and reduced_form prepped samples."
 87.             exit 111
 88.         }
 89.         gen double pre_`alias' = `src' if nih_name_matched == 1 & !mi(`src') & `src' > 0
 90.         local src pre_`alias'
 91.         qui sum `src' if athr_indicator == 1, d
 92.         local nih_n = r(N)
 93.         local nih_p50 = r(p50)
 94.         di as text "add_het_splits `samp'`suf' `alias' N_pi=`nih_n' p50=`nih_p50'"
 95.         gen byte high_`alias' = `src' >= `nih_p50' if !mi(`src')
 96.         gen byte low_`alias'  = `src' <  `nih_p50' if !mi(`src')
 97.         * Within name-matched PIs, no recorded baseline research awards
.         * enter the low group.
.         replace high_`alias' = 0 if mi(pre_`alias') & nih_name_matched == 1
 98.         replace low_`alias' = 1 if mi(pre_`alias') & nih_name_matched == 1
 99.         assert high_`alias' + low_`alias' == 1 if nih_name_matched == 1
100.         assert mi(high_`alias') & mi(low_`alias') if nih_name_matched != 1
101.         qui count if athr_indicator == 1 & low_`alias' == 1
102.         di as text "add_het_splits `samp'`suf' `alias' low (name-matched, includes no baseline awards): " r(N) " PIs"
103.     }
104. 
.     cap confirm variable pre_nihd
105.     if !_rc {
106.         qui sum pre_nihd if athr_indicator == 1 & young == 1, d
107.         local ynih_n = r(N)
108.         local ynih_med = r(p50)
109.         local ynih_p25 = r(p25)
110.         local ynih_p75 = r(p75)
111.         di as text "add_het_splits `samp'`suf' young-only nihd N_pi=`ynih_n' p25=`ynih_p25' p50=`ynih_med' p75=`ynih_p75'"
112.         gen byte yhigh_nihd = pre_nihd >= `ynih_med' if !mi(pre_nihd) & young == 1
113.         gen byte ylow_nihd  = pre_nihd <  `ynih_med' if !mi(pre_nihd) & young == 1
114.         replace yhigh_nihd = 0 if mi(pre_nihd) & young == 1 & nih_name_matched == 1
115.         replace ylow_nihd = 1 if mi(pre_nihd) & young == 1 & nih_name_matched == 1
116.         gen byte yq4_nihd = pre_nihd >= `ynih_p75' if !mi(pre_nihd) & young == 1 ///
>                             & (pre_nihd >= `ynih_p75' | pre_nihd <= `ynih_p25')
117.         gen byte yq1_nihd = 1 - yq4_nihd
118.     }
119. 
.     cap drop nih_pi
120.     gen byte nih_pi = nih_name_matched
121.     qui count if nih_pi == 1 & athr_indicator == 1
122.     di as text "add_het_splits `samp'`suf' NIH name-matched PIs = " r(N)
123.     gen byte young_nih = young if nih_pi == 1 & !mi(young)
124.     gen byte old_nih   = old   if nih_pi == 1 & !mi(old)
125. 
.     cap confirm file ../external/prepped_samples/exit_`samp'`suf'.dta
126.     if !_rc {
127.         cap drop exit_2022
128.         merge m:1 athr_id using ../external/prepped_samples/exit_`samp'`suf', ///
>             keep(1 3) keepusing(exit_2022) nogen
129.         gen byte surv_samp = (young == 0) | (young == 1 & exit_2022 == 0) if !mi(young) & !mi(exit_2022)
130.         gen byte young_surv = young if surv_samp == 1
131.         gen byte old_surv   = old   if surv_samp == 1
132.         gen byte young_sb   = young if exit_2022 == 0 & !mi(young)
133.         gen byte old_sb     = old   if exit_2022 == 0 & !mi(old)
134.         qui count if athr_indicator == 1 & young == 1 & exit_2022 == 1
135.         local n_drop = r(N)
136.         qui count if athr_indicator == 1 & young_surv == 1
137.         di as text "add_het_splits `samp'`suf': survivor split drops `n_drop' early-career PIs with no last-author paper in 2020-22; " ///
>             r(N) " early-career survivors kept"
138.         drop surv_samp
139.     }
140.     else di as error "add_het_splits `samp'`suf': exit_`samp'`suf' not in prepped_samples -- young_surv/old_surv SKIPPED (rerun reduced_form)."
141. 
.     cap confirm file ../external/athr_age/athr_age.dta
142.     if !_rc {
143.         cap drop first_pub
144.         merge m:1 athr_id using ../external/athr_age/athr_age, keep(1 3) keepusing(first_pub) nogen
145.         gen train_yrs = min_year - first_pub
146.         qui count if athr_indicator == 1 & young == 1 & train_yrs < 0
147.         local n_neg = r(N)
148.         replace train_yrs = . if train_yrs < 0
149.         qui sum train_yrs if athr_indicator == 1 & young == 1, d
150.         local train_med = r(p50)
151.         gen byte y_longtrain  = train_yrs >  `train_med' if young == 1 & !mi(train_yrs)
152.         gen byte y_shorttrain = train_yrs <= `train_med' if young == 1 & !mi(train_yrs)
153.         qui count if athr_indicator == 1 & y_longtrain == 1
154.         local n_long = r(N)
155.         qui count if athr_indicator == 1 & y_shorttrain == 1
156.         di as text "add_het_splits `samp'`suf': early-career training split (first OpenAlex article to first last-author paper) at median `train_med' yrs: " ///
>             "`n_long' long, " r(N) " short; `n_neg' early-career PIs with first_pub after min_year set missing"
157.         drop first_pub
158.     }
159.     else di as error "add_het_splits `samp'`suf': athr_age not in external -- y_longtrain/y_shorttrain SKIPPED."
160. 
.     cap confirm variable msa_size
161.     if !_rc {
162.         gen msa_size_2014 = msa_size if year == 2014
163.         bys athr_id: egen msa_size_at = max(msa_size_2014)
164.         drop msa_size_2014
165.     }
166. 
.     merge m:1 inst_id using ../temp/inst_chars_pre, keep(1 3) nogen
167.     cap drop inst_indicator
168.     bys inst_id : gen inst_indicator = _n == 1
169.     foreach a of global IC_ALIASES {
170.         cap confirm variable ic_`a'
171.         if _rc continue
172.         qui sum ic_`a' if inst_indicator == 1, d
173.         local ic_n = r(N)
174.         local ic_p50 = r(p50)
175.         local ic_p25 = r(p25)
176.         local ic_p75 = r(p75)
177.         di as text "add_het_splits `samp'`suf' ic_`a' inst-wtd N_inst=`ic_n' p25=`ic_p25' p50=`ic_p50' p75=`ic_p75'"
178.         gen byte hi_`a'  = ic_`a' >= `ic_p50' if !mi(ic_`a')
179.         gen byte lo_`a'  = ic_`a' <  `ic_p50' if !mi(ic_`a')
180.         gen byte q1_`a'  = ic_`a' <= `ic_p25' if !mi(ic_`a')
181.         gen byte q4_`a'  = ic_`a' >= `ic_p75' if !mi(ic_`a')
182.         gen byte mid_`a' = (ic_`a' > `ic_p25' & ic_`a' < `ic_p75') if !mi(ic_`a')
183.         qui sum ic_`a' if athr_indicator == 1, d
184.         local ic_p25w = r(p25)
185.         local ic_p50w = r(p50)
186.         local ic_p75w = r(p75)
187.         di as text "add_het_splits `samp'`suf' ic_`a' pi-wtd N_pi=" r(N) " p25=`ic_p25w' p50=`ic_p50w' p75=`ic_p75w'"
188.         gen byte hiw_`a'  = ic_`a' >= `ic_p50w' if !mi(ic_`a')
189.         gen byte low_`a'  = ic_`a' <  `ic_p50w' if !mi(ic_`a')
190.         gen byte q1w_`a'  = ic_`a' <= `ic_p25w' if !mi(ic_`a')
191.         gen byte q4w_`a'  = ic_`a' >= `ic_p75w' if !mi(ic_`a')
192.         gen byte midw_`a' = (ic_`a' > `ic_p25w' & ic_`a' < `ic_p75w') if !mi(ic_`a')
193.     }
194. 
.     local pi_q_source pre_ppr_cnt_sum pre_nihg pre_nihd
195.     local pi_q_alias  pre_ppr        nihg     nihd
196.     local nq : word count `pi_q_alias'
197.     forvalues i = 1/`nq' {
198.         local src : word `i' of `pi_q_source'
199.         local alias : word `i' of `pi_q_alias'
200.         cap confirm variable `src'
201.         if _rc {
202.             di as error "add_het_splits `samp'`suf': `src' unavailable -- `alias' quartiles SKIPPED."
203.             continue
204.         }
205.         qui sum `src' if athr_indicator == 1, d
206.         local p25 = r(p25)
207.         local p75 = r(p75)
208.         di as text "add_het_splits `samp'`suf' `alias' p25=`p25' p75=`p75'"
209.         gen byte q1_`alias'  = `src' <= `p25' if !mi(`src')
210.         gen byte q4_`alias'  = `src' >= `p75' if !mi(`src')
211.         gen byte mid_`alias' = (`src' > `p25' & `src' < `p75') if !mi(`src')
212.     }
213. 
.     foreach a of global IC_ALIASES {
214.         cap confirm variable hiw_`a'
215.         if _rc continue
216.         gen byte y_hi_`a' = (young == 1 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
217.         gen byte y_lo_`a' = (young == 1 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
218.         gen byte o_hi_`a' = (young == 0 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
219.         gen byte o_lo_`a' = (young == 0 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
220.     }
221.     cap confirm variable high_nihd
222.     if !_rc {
223.         gen byte y_hi_nihd = (young == 1 & high_nihd == 1) if !mi(young) & !mi(high_nihd)
224.         gen byte y_lo_nihd = (young == 1 & high_nihd == 0) if !mi(young) & !mi(high_nihd)
225.         gen byte o_hi_nihd = (young == 0 & high_nihd == 1) if !mi(young) & !mi(high_nihd)
226.         gen byte o_lo_nihd = (young == 0 & high_nihd == 0) if !mi(young) & !mi(high_nihd)
227.     }
228. 
.     cap confirm variable min_year
229.     if !_rc {
230.         gen lab_age_2014 = 2014 - min_year
231.         qui sum lab_age_2014 if athr_indicator == 1, d
232.         local lab_med = r(p50)
233.         di as text "add_het_splits `samp'`suf' lab_age median = `lab_med'"
234.         gen byte new_lab = lab_age_2014 <  `lab_med' if !mi(lab_age_2014)
235.         gen byte est_lab = lab_age_2014 >= `lab_med' if !mi(lab_age_2014)
236.         gen byte lab_lt10  = lab_age_2014 < 10             if !mi(lab_age_2014)
237.         gen byte lab_10_20 = inrange(lab_age_2014, 10, 19) if !mi(lab_age_2014)
238.         gen byte lab_20p   = lab_age_2014 >= 20            if !mi(lab_age_2014)
239.         qui sum lab_age_2014 if athr_indicator == 1, d
240.         di as text "add_het_splits `samp'`suf' lab_age quartile cuts: p25=" r(p25) " p50=" r(p50) " p75=" r(p75)
241.         xtile _labq_pi = lab_age_2014 if athr_indicator == 1, nq(4)
242.         bys athr_id: egen _labq = max(_labq_pi)
243.         forval q = 1/4 {
244.             gen byte q`q'_labage = _labq == `q' if !mi(_labq)
245.         }
246.         drop _labq_pi _labq
247.     }
248.     cap confirm variable msa_size_at
249.     if !_rc {
250.         qui sum msa_size_at if athr_indicator == 1, d
251.         local msa_med = r(p50)
252.         gen byte big_msa   = msa_size_at >= `msa_med' if !mi(msa_size_at)
253.         gen byte small_msa = msa_size_at <  `msa_med' if !mi(msa_size_at)
254.     }
255. 
.     compress
256.     save ../temp/es_`samp'`suf', replace
257. end

. 
. program nih_award_period_means
  1.     * Called only for pooled NIH-dollar specifications. Keep the same eligible
.     * PIs in both windows; no-award years are already zero in the annual panel.
.     * Reject incomplete windows rather than averaging only observed/funded years.
.     keep if !mi(nih_total_cost)
  2.     assert inrange(year, 2010, 2019)
  3.     assert nih_total_cost >= 0
  4.     isid athr_id year
  5.     assert post == (year >= 2014)
  6.     quietly ds, has(type numeric)
  7.     local numeric `r(varlist)'
  8.     local exclude athr_id inst_id year post nih_total_cost
  9.     local carry : list numeric - exclude
 10.     collapse (sum) nih_total_cost (count) nih_period_years=year ///
>              (firstnm) `carry' inst_id, by(athr_id post)
 11.     assert nih_period_years == cond(post, 6, 4)
 12.     bysort athr_id: assert _N == 2
 13.     replace nih_total_cost = nih_total_cost / cond(post, 6, 4)
 14.     * Existing FE code uses year; here it indexes the two periods.
.     gen int year = cond(post, 2014, 2010)
 15.     label var nih_total_cost "Mean annual NIH award dollars: FY2010-2013 / FY2014-2019"
 16.     label var nih_period_years "Calendar years contributing to period mean"
 17. end

. 
. program event_study_het
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     use ../temp/es_`samp'`suf', clear
 18. 
.     gen rel = year - 2014
 19.     qui sum rel, d
 20.     local abs_lag = abs(r(max))
 21.     local abs_lead = abs(r(min))
 22.     forval i = 1/`abs_lead' {
 23.         gen int_lead`i'  = exposure      if rel == -`i'
 24.         gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 25.     }
 26.     forval i = 0/`abs_lag' {
 27.         gen int_lag`i'  = exposure      if rel == `i'
 28.         gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 29.     }
 30.     ds int_lead* int_lag* mshr_lead* mshr_lag*
 31.     foreach var in `r(varlist)' {
 32.         replace `var' = 0 if mi(`var')
 33.     }
 34.     local int_leads
 35.     local mshr_leads
 36.     local int_lags
 37.     local mshr_lags
 38.     forval i = 2/`abs_lead' {
 39.         local int_leads int_lead`i' `int_leads'
 40.         local mshr_leads mshr_lead`i' `mshr_leads'
 41.     }
 42.     forval i = 0/`abs_lag' {
 43.         local int_lags `int_lags' int_lag`i'
 44.         local mshr_lags `mshr_lags' mshr_lag`i'
 45.     }
 46.     foreach v in ppr_cnt cite_affl_wt {
 47.         gen ln_`v' = ln(1+`v')
 48.     }
 49. 
.     local het_groups young old young_ns old_ns young_any old_any r1 r2 pub_inst priv_inst ///
>                      high_nihg low_nihg high_nihd low_nihd ///
>                      young_nih old_nih young_surv old_surv young_sb old_sb y_longtrain y_shorttrain new_lab est_lab big_msa small_msa ///
>                      yhigh_nihd ylow_nihd yq4_nihd yq1_nihd ///
>                      lab_lt10 lab_10_20 lab_20p ///
>                      q1_labage q2_labage q3_labage q4_labage
 50.     foreach a of global IC_ALIASES {
 51.         local het_groups `het_groups' hiw_`a' low_`a'
 52.         if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' hi_`a' lo_`a'
 53.         if "$HET_RUN_QUARTILES" == "1" {
 54.             local het_groups `het_groups' q1w_`a' midw_`a' q4w_`a'
 55.             if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' q1_`a' mid_`a' q4_`a'
 56.         }
 57.     }
 58.     if "$HET_RUN_QUARTILES" == "1" {
 59.         foreach b of global PI_Q_BASES {
 60.             local het_groups `het_groups' q1_`b' mid_`b' q4_`b'
 61.         }
 62.     }
 63.     global HET_GROUPS_ACTIVE
 64.     foreach grp of local het_groups {
 65.         cap confirm variable `grp'
 66.         if _rc {
 67.             di as text "event_study_het `samp'`suf': dummy `grp' not built -- skipping."
 68.             continue
 69.         }
 70.         qui sum `grp'
 71.         if r(N) == 0 | r(min) == r(max) {
 72.             di as text "event_study_het `samp'`suf': dummy `grp' degenerate -- skipping."
 73.             continue
 74.         }
 75.         foreach v of local int_leads {
 76.             gen `v'_`grp' = `v' * `grp'
 77.         }
 78.         foreach v of local int_lags {
 79.             gen `v'_`grp' = `v' * `grp'
 80.         }
 81.         gen int_lead1_`grp' = int_lead1 * `grp'
 82.         foreach v of local mshr_leads {
 83.             gen `v'_`grp' = `v' * `grp'
 84.         }
 85.         foreach v of local mshr_lags {
 86.             gen `v'_`grp' = `v' * `grp'
 87.         }
 88.         local leads_`grp'
 89.         local lags_`grp'
 90.         local mleads_`grp'
 91.         local mlags_`grp'
 92.         foreach v of local int_leads {
 93.             local leads_`grp' `leads_`grp'' `v'_`grp'
 94.         }
 95.         foreach v of local int_lags {
 96.             local lags_`grp' `lags_`grp'' `v'_`grp'
 97.         }
 98.         foreach v of local mshr_leads {
 99.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
100.         }
101.         foreach v of local mshr_lags {
102.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
103.         }
104.         global HET_GROUPS_ACTIVE `"${HET_GROUPS_ACTIVE} `grp'"'
105.     }
106. 
.     if "$POSITION_OUTCOMES_AVAIL" == "" {
107.         cap confirm variable n_first_ppr
108.         global POSITION_OUTCOMES_AVAIL = cond(_rc == 0, 1, 0)
109.     }
110.     local position_outcomes ""
111.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
112.         local position_outcomes n_middle_ppr avg_position avg_team_size_last avg_team_size_notlast
113.     }
114. 
.     cap drop post Z_it Z_share_it
115.     gen post       = year >= 2014
116.     gen Z_it       = exposure      * post
117.     gen Z_share_it = mkt_spend_shr * post
118. 
.     local pi_pairs `" "young old" "young_ns old_ns" "young_any old_any" "young_nih old_nih" "young_surv old_surv" "young_sb old_sb" "y_longtrain y_shorttrain" "r1 r2" "pub_inst priv_inst" "high_nihg low_nihg" "high_nihd low_nihd" "new_lab est_lab" "big_
> msa small_msa" "yhigh_nihd ylow_nihd" "yq4_nihd yq1_nihd" "'
119.     global DUMMY_PAIRS_MED    `" `pi_pairs' ${IC_PAIRS_MED} "'
120.     global DUMMY_PAIRS_MED_PW `" `pi_pairs' ${IC_PAIRS_MED_PW} "'
121. 
.     local ppml_het_skip avg_position avg_team_size_last avg_team_size_notlast
122. 
.     mat drop _all
123.     local yvar_list ppr_cnt ppr_cnt_nonsolo cite_affl_wt avg_num_coathrs ///
>                     n_grants n_new_grants nih_total_cost ///
>                     `position_outcomes'
124.     if "$DEBUG_YVAR" != "" {
125.         local yvar_list $DEBUG_YVAR
126.         di as text "DEBUG_YVAR set -- restricting yvar loop to: $DEBUG_YVAR"
127.     }
128. 
.     foreach yvar of local yvar_list {
129.         local pooled_fes `fes'
130.         local pooled_vce_cl `vce_cl'
131.         if "`yvar'" == "nih_total_cost" {
132.             local pooled_fes athr_id year
133.             local pooled_vce_cl athr_id
134.         }
135.         tempname ph_handle
136.         postfile `ph_handle' str30 yvar str24 grp str12 spec str20 split_type ///
>             double(post_b post_se pre_b pre_se N r2_p) ///
>             using "../temp/phet_results_`samp'`suf'_`yvar'", replace
137.         local gap 0.5
138.         if regexm("`yvar'", "^cite_affl_wt") local gap 1
139.         local ppml_ytit "Output-cost elasticity"
140.         if "`yvar'" == "n_grants"       local ppml_ytit "{&Delta} log expected active NIH research grants"
141.         if "`yvar'" == "n_new_grants"   local ppml_ytit "{&Delta} log expected new NIH research grants"
142.         if "`yvar'" == "nih_total_cost" local ppml_ytit "{&Delta} log expected NIH award dollars"
143. 
.         if "$HET_RUN_OLS" == "1" & inlist("`yvar'", "ppr_cnt", "cite_affl_wt") {
144.             foreach pair of global DUMMY_PAIRS_MED {
145.                 local g1: word 1 of `pair'
146.                 local g2: word 2 of `pair'
147.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
148.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
149.                 local g1_label = "${LBL_`g1'}"
150.                 if "`g1_label'" == "" local g1_label "`g1'"
151.                 local mshr_ctrls `mshr_leads' `mshr_lags' `mleads_`g1'' `mlags_`g1''
152.                 local plot_suf "_mshrctrl"
153.                 cap drop PT_`g1'
154.                 gen PT_`g1' = post * `g1'
155.                 cap noi reghdfe `yvar' `int_leads' `int_lags' ///
>                                `leads_`g1'' `lags_`g1'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
156.                 local rc = _rc
157.                 if `rc' {
158.                     di as error "event_study_het `samp'`suf' `yvar' `g1' failed (rc=`rc'); skipping."
159.                     continue
160.                 }
161.                 gunique athr_id if e(sample) & `g1' == 1
162.                 local num_athrs = r(unique)
163.                 gunique inst_id if e(sample) & `g1' == 1
164.                 local num_insts = r(unique)
165.                 sum `yvar' if rel <= -1 & e(sample) & `g1' == 1, d
166.                 local pre_mean : dis %4.3f r(mean)
167.                 preserve
168.                 cap mat drop es
169.                 foreach var in `leads_`g1'' `lags_`g1'' int_lead1_`g1' {
170.                     if "`var'" == "int_lead1_`g1'" {
171.                         mat row = 0,0
172.                     }
173.                     else {
174.                         mat row = _b[`var'], _se[`var']
175.                     }
176.                     mat es = nullmat(es) \ row
177.                 }
178.                 svmat es
179.                 keep es1 es2
180.                 drop if mi(es1)
181.                 rename (es1 es2) (b se)
182.                 gen ub = b + 1.96*se
183.                 sum ub, d
184.                 local ymax = round(r(max),`gap')
185.                 gen lb = b - 1.96*se
186.                 sum lb, d
187.                 local ymin = round(r(min),`gap')
188.                 if `ymin' > 0 local ymin = 0
189.                 gen rel = -`abs_lead' if _n == 1
190.                 replace rel = rel[_n-1]+1 if _n > 1
191.                 replace rel = rel + 1 if rel >= -1
192.                 replace rel = -1 if rel == `abs_lag' + 1
193.                 gen year = rel + 2014
194.                 hashsort rel
195.                 local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. insts: `num_insts'" "Pre-period avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
196.                 local fdir ../output/figures/`samp'
197.                 foreach fmode of global FIG_MODES {
198.                     if "`fmode'" == "paper" {
199.                         local stats_leg legend(off)
200.                         cap mkdir "`fdir'"
201.                     }
202.                     tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>                       scatter b year, mcolor(ebblue) || ///
>                     scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                       xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                       ytitle("Output-cost elasticity") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`gap')`ymax') ///
>                       `stats_leg' ///
>                       yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
203.                     fig_export, path("`fdir'/es_`yvar'`suf'_`g1'`plot_suf'.pdf") mode(`fmode')
204.                 }
205.                 save ../temp/es_`yvar'`suf'_`g1'`plot_suf', replace
206.                 restore
207.             }
208. 
.         }
209. 
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
210.             cap mkdir "../output/figures/`samp'/es_ppml"
211.             local mmethods pw
212.             if "$HET_INCLUDE_INSTWTD" == "1" local mmethods inst pw
213.             foreach mmethod of local mmethods {
214.             local pairs_current
215.             if "`mmethod'" == "inst" {
216.                 foreach pair of global DUMMY_PAIRS_MED {
217.                     local pairs_current `"`pairs_current' `"`pair'"' "'
218.                 }
219.                 local st_tag "med"
220.                 local mplot_suf "_ppml_mshrctrl"
221.             }
222.             else {
223.                 foreach pair of global DUMMY_PAIRS_MED_PW {
224.                     local pairs_current `"`pairs_current' `"`pair'"' "'
225.                 }
226.                 local st_tag "med_pi"
227.                 local mplot_suf "_ppml_medpi_mshrctrl"
228.             }
229.             foreach pair of local pairs_current {
230.                 local g1: word 1 of `pair'
231.                 local g2: word 2 of `pair'
232.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
233.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
234. 
.                 cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
235.                 gen Z_`g1' = Z_it       * `g1'
236.                 gen Z_`g2' = Z_it       * `g2'
237.                 gen S_`g1' = Z_share_it * `g1'
238.                 gen S_`g2' = Z_share_it * `g2'
239.                 gen PT_`g1' = post * `g1'
240.                 if "`yvar'" == "nih_total_cost" {
241.                     preserve
242.                     nih_award_period_means
243.                 }
244.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                                absorb(`pooled_fes') vce(cluster `pooled_vce_cl')
245.                 local rc = _rc
246.                 if `rc' {
247.                     if "`yvar'" == "nih_total_cost" restore
248.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
249.                     continue
250.                 }
251.                 local Nppml = e(N)
252.                 local r2ppml = e(r2_p)
253.                 foreach grp in `g1' `g2' {
254.                     gunique athr_id if e(sample) & `grp' == 1
255.                     local num_athrs = r(unique)
256.                     gunique inst_id if e(sample) & `grp' == 1
257.                     local num_insts = r(unique)
258.                     local b_post  = _b[Z_`grp']
259.                     local se_post = _se[Z_`grp']
260.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
261.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
262.                 }
263. 
.                 cap noi lincom Z_`g1' - Z_`g2'
264.                 if !_rc {
265.                     local b_diff  = r(estimate)
266.                     local se_diff = r(se)
267.                     local p_diff  = r(p)
268.                     di as text "pooled-DiD int PPML DIFF `samp'`suf' `yvar' `g1'-`g2' `st_tag': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
269.                     post `ph_handle' ("`yvar'") ("`g1'_diff") ("mshrctrl") ("`st_tag'_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
270.                 }
271. 
.                 if "`yvar'" == "nih_total_cost" restore
272.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' `mleads_`g2'' `mlags_`g2''
273.                 local plot_suf "`mplot_suf'"
274.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g2'' `lags_`g2'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
275.                 if _rc {
276.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
277.                     continue
278.                 }
279.                 foreach grp in `g1' `g2' {
280.                     local grp_label = "${LBL_`grp'}"
281.                     if "`grp_label'" == "" local grp_label "`grp'"
282.                     gunique athr_id if e(sample) & `grp' == 1
283.                     local num_athrs = r(unique)
284.                     gunique inst_id if e(sample) & `grp' == 1
285.                     local num_insts = r(unique)
286.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
287.                     local pre_mean : dis %4.3f r(mean)
288.                     preserve
289.                     cap mat drop es
290.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
291.                         if "`var'" == "int_lead1_`grp'" {
292.                             mat row = 0,0
293.                         }
294.                         else {
295.                             mat row = _b[`var'], _se[`var']
296.                         }
297.                         mat es = nullmat(es) \ row
298.                     }
299.                     svmat es
300.                     keep es1 es2
301.                     drop if mi(es1)
302.                     rename (es1 es2) (b se)
303.                     local pgap 0.2
304.                     gen ub = b + 1.96*se
305.                     gen lb = b - 1.96*se
306.                     local ymax = 1.2
307.                     local ymin = -2.2
308.                     gen rel = -`abs_lead' if _n == 1
309.                     replace rel = rel[_n-1]+1 if _n > 1
310.                     replace rel = rel + 1 if rel >= -1
311.                     replace rel = -1 if rel == `abs_lag' + 1
312.                     gen year = rel + 2014
313.                     hashsort rel
314.                     local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. insts: `num_insts'" "Pre-period avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
315.                     local fdir ../output/figures/`samp'/es_ppml
316.                     foreach fmode of global FIG_MODES {
317.                         if "`fmode'" == "paper" {
318.                             local stats_leg legend(off)
319.                             cap mkdir "`fdir'"
320.                         }
321.                         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                           scatter b year, mcolor(ebblue) || ///
>                         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                           xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                           ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                           `stats_leg' ///
>                           yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
322.                         fig_export, path("`fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf") mode(`fmode')
323.                     }
324.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
325.                     restore
326.                 }
327.                 if "`g1'" == "young" & "`g2'" == "old" {
328.                     preserve
329.                     use ../temp/es_`yvar'`suf'_young`plot_suf', clear
330.                     gen grp = 1
331.                     append using ../temp/es_`yvar'`suf'_old`plot_suf'
332.                     replace grp = 2 if mi(grp)
333.                     replace year = year - 0.1 if grp == 1
334.                     replace year = year + 0.1 if grp == 2
335.                     local ymax = 1.2
336.                     local ymin = -2.2
337.                     local pgap 0.2
338.                     local fdir ../output/figures/`samp'/es_ppml
339.                     foreach fmode of global FIG_MODES {
340.                         if "`fmode'" == "paper" {
341.                             cap mkdir "`fdir'"
342.                         }
343.                         foreach hide in 0 1 {
344.                             local ocol dkorange
345.                             local ocol_ci dkorange%70
346.                             local olbl "${LBL_old}"
347.                             local fsuf young_old
348.                             if `hide' {
349.                                 local ocol none
350.                                 local ocol_ci none
351.                                 local olbl " "
352.                                 local fsuf young_old_hideold
353.                             }
354.                             tw rcap ub lb year if rel != -1 & grp == 1, lcolor(ebblue%70) msize(vsmall) || ///
>                               scatter b year if grp == 1, mcolor(ebblue) || ///
>                               rcap ub lb year if rel != -1 & grp == 2, lcolor(`ocol_ci') msize(vsmall) || ///
>                               scatter b year if grp == 2, mcolor(`ocol') || ///
>                             scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                               xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                               ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                               legend(on order(2 "${LBL_young}" 4 "`olbl'") pos(6) ring(1) rows(1) size(small)) ///
>                               yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
355.                             fig_export, path("`fdir'/es_`yvar'`suf'_`fsuf'`plot_suf'.pdf") mode(`fmode')
356.                         }
357.                     }
358.                     restore
359.                 }
360.             }
361.             }
362. 
.             foreach aspec in age3 ageq4 {
363.                 if "`aspec'" == "age3"  local agrps lab_lt10 lab_10_20 lab_20p
364.                 if "`aspec'" == "ageq4" local agrps q1_labage q2_labage q3_labage q4_labage
365.                 local aok 1
366.                 foreach grp of local agrps {
367.                     if strpos(" ${HET_GROUPS_ACTIVE} ", " `grp' ") == 0 local aok 0
368.                 }
369.                 if `aok' {
370.                 local nb : word count `agrps'
371.                 local abase : word `nb' of `agrps'
372.                 local Zs
373.                 local Ss
374.                 local PTs
375.                 foreach grp of local agrps {
376.                     cap drop Z_`grp'
377.                     cap drop S_`grp'
378.                     cap drop PT_`grp'
379.                     gen Z_`grp' = Z_it       * `grp'
380.                     gen S_`grp' = Z_share_it * `grp'
381.                     local Zs `Zs' Z_`grp'
382.                     local Ss `Ss' S_`grp'
383.                     if "`grp'" != "`abase'" {
384.                         gen PT_`grp' = post * `grp'
385.                         local PTs `PTs' PT_`grp'
386.                     }
387.                 }
388.                 if "`yvar'" == "nih_total_cost" {
389.                     preserve
390.                     nih_award_period_means
391.                 }
392.                 cap noi ppmlhdfe `yvar' `Zs' `Ss' `PTs', ///
>                                absorb(`pooled_fes') vce(cluster `pooled_vce_cl')
393.                 local rc = _rc
394.                 if `rc' {
395.                     if "`yvar'" == "nih_total_cost" restore
396.                     di as error "event_study_het `samp'`suf' `yvar' `aspec' pooled-DiD int ppml failed (rc=`rc'); skipping."
397.                 }
398.                 else {
399.                     local Nppml = e(N)
400.                     local r2ppml = e(r2_p)
401.                     foreach grp of local agrps {
402.                         gunique athr_id if e(sample) & `grp' == 1
403.                         local num_athrs = r(unique)
404.                         gunique inst_id if e(sample) & `grp' == 1
405.                         local num_insts = r(unique)
406.                         local b_post  = _b[Z_`grp']
407.                         local se_post = _se[Z_`grp']
408.                         di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `aspec': b=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
409.                         post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`aspec'") ///
>                             (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
410.                     }
