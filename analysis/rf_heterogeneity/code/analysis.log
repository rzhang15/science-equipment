351.                     }
352.                     else {
353.                         foreach grp of local agrps {
354.                             local grp_label = "${LBL_`grp'}"
355.                             if "`grp_label'" == "" local grp_label "`grp'"
356.                             gunique athr_id if e(sample) & `grp' == 1
357.                             local num_athrs = r(unique)
358.                             gunique inst_id if e(sample) & `grp' == 1
359.                             local num_insts = r(unique)
360.                             sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
361.                             local pre_mean : dis %4.3f r(mean)
362.                             preserve
363.                             cap mat drop es
364.                             foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
365.                                 if "`var'" == "int_lead1_`grp'" {
366.                                     mat row = 0,0
367.                                 }
368.                                 else {
369.                                     mat row = _b[`var'], _se[`var']
370.                                 }
371.                                 mat es = nullmat(es) \ row
372.                             }
373.                             svmat es
374.                             keep es1 es2
375.                             drop if mi(es1)
376.                             rename (es1 es2) (b se)
377.                             gen ub = b + 1.96*se
378.                             sum ub, d
379.                             local ymax = round(r(max), 0.1)
380.                             gen lb = b - 1.96*se
381.                             sum lb, d
382.                             local ymin = round(r(min), 0.1)
383.                             if `ymin' > 0 local ymin = 0
384.                             gen rel = -`abs_lead' if _n == 1
385.                             replace rel = rel[_n-1]+1 if _n > 1
386.                             replace rel = rel + 1 if rel >= -1
387.                             replace rel = -1 if rel == `abs_lag' + 1
388.                             gen year = rel + 2014
389.                             hashsort rel
390.                             tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                               scatter b year, mcolor(ebblue) || ///
>                             scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                               xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                               ytitle("`ppml_ytit'") ylab(`ymin'(0.1)`ymax') ///
>                               subtitle("`grp_label'", pos(11) size(small)) ///
>                               legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>                               yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
391.                             graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
392.                             save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
393.                             restore
394.                         }
395.                     }
396.                 }
397.                 }
398.             }
399. 
.             * ---- PPML quartile split (inst-weighted + PI-weighted variants) ----
.             * Gated by HET_RUN_QUARTILES; off by default per user request.
.             local qmethods
400.             if "$HET_RUN_QUARTILES" == "1" local qmethods pw
401.             if "$HET_RUN_QUARTILES" == "1" & "$HET_INCLUDE_INSTWTD" == "1" local qmethods inst pw
402.             foreach qmethod of local qmethods {
403.             local quart_all
404.             if "`qmethod'" == "inst" {
405.                 foreach pair of global IC_PAIRS_Q {
406.                     local quart_all `"`quart_all' `"`pair'"' "'
407.                 }
408.                 local st_tag "quart"
409.                 local qplot_suf "_ppml_q_mshrctrl"
410.             }
411.             else {
412.                 foreach pair of global IC_PAIRS_Q_PW {
413.                     local quart_all `"`quart_all' `"`pair'"' "'
414.                 }
415.                 local st_tag "quart_pi"
416.                 local qplot_suf "_ppml_qpi_mshrctrl"
417.             }
418.             * PI-continuous quartiles run under BOTH methods (same dummies
.             * either way) so quart and quart_pi coefplots each fill their
.             * pi panel — mirrors pi_pairs in DUMMY_PAIRS_MED / _MED_PW.
.             foreach pair of global PI_PAIRS_Q {
419.                 local quart_all `"`quart_all' `"`pair'"' "'
420.             }
421.             foreach pair of local quart_all {
422.                 local g1: word 1 of `pair'
423.                 local g2: word 2 of `pair'
424.                 * mid-group name: q4w_<char> -> midw_<char>; q4_<base> -> mid_<base>
.                 if substr("`g1'", 1, 4) == "q4w_" {
425.                     local base = substr("`g1'", 5, .)
426.                     local gm "midw_`base'"
427.                 }
428.                 else {
429.                     local base = substr("`g1'", 4, .)
430.                     local gm "mid_`base'"
431.                 }
432.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
433.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
434.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `gm' ") == 0 continue
435. 
.                 * --- Pooled-DiD PPML with fully-interacted Z and share (Q4/Mid/Q1); posted as "mshrctrl" ---
.                 * [H11] Q1 x post is the omitted base
.                 cap drop Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm'
436.                 gen Z_`g1' = Z_it       * `g1'
437.                 gen Z_`g2' = Z_it       * `g2'
438.                 gen Z_`gm' = Z_it       * `gm'
439.                 gen S_`g1' = Z_share_it * `g1'
440.                 gen S_`g2' = Z_share_it * `g2'
441.                 gen S_`gm' = Z_share_it * `gm'
442.                 gen PT_`g1' = post * `g1'
443.                 gen PT_`gm' = post * `gm'
444.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
445.                 local rc = _rc
446.                 if `rc' {
447.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
448.                     continue
449.                 }
450.                 local Nppml = e(N)
451.                 local r2ppml = e(r2_p)
452.                 foreach grp in `g1' `g2' {
453.                     gunique athr_id if e(sample) & `grp' == 1
454.                     local num_athrs = r(unique)
455.                     gunique inst_id if e(sample) & `grp' == 1
456.                     local num_insts = r(unique)
457.                     local b_post  = _b[Z_`grp']
458.                     local se_post = _se[Z_`grp']
459.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
460.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
461.                 }
462. 
.                 * --- Joint event-study PPML for per-group ES PDFs only (not posted) ---
.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' ///
>                                  `mleads_`g2'' `mlags_`g2'' ///
>                                  `mleads_`gm'' `mlags_`gm''
463.                 local plot_suf "`qplot_suf'"
464.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' ///
>                                         `leads_`g2'' `lags_`g2'' ///
>                                         `leads_`gm'' `lags_`gm'' ///
>                                         `mshr_ctrls' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
465.                 if _rc {
466.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
467.                     continue
468.                 }
469.                 foreach grp in `g1' `g2' {
470.                     local grp_label = "${LBL_`grp'}"
471.                     if "`grp_label'" == "" local grp_label "`grp'"
472.                     gunique athr_id if e(sample) & `grp' == 1
473.                     local num_athrs = r(unique)
474.                     gunique inst_id if e(sample) & `grp' == 1
475.                     local num_insts = r(unique)
476.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
477.                     local pre_mean : dis %4.3f r(mean)
478.                     preserve
479.                     cap mat drop es
480.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
481.                         if "`var'" == "int_lead1_`grp'" {
482.                             mat row = 0,0
483.                         }
484.                         else {
485.                             mat row = _b[`var'], _se[`var']
486.                         }
487.                         mat es = nullmat(es) \ row
488.                     }
489.                     svmat es
490.                     keep es1 es2
491.                     drop if mi(es1)
492.                     rename (es1 es2) (b se)
493.                     gen ub = b + 1.96*se
494.                     sum ub, d
495.                     local ymax = round(r(max), 0.1)
496.                     gen lb = b - 1.96*se
497.                     sum lb, d
498.                     local ymin = round(r(min), 0.1)
499.                     if `ymin' > 0 local ymin = 0
500.                     gen rel = -`abs_lead' if _n == 1
501.                     replace rel = rel[_n-1]+1 if _n > 1
502.                     replace rel = rel + 1 if rel >= -1
503.                     replace rel = -1 if rel == `abs_lag' + 1
504.                     gen year = rel + 2014
505.                     hashsort rel
506.                     tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                       scatter b year, mcolor(ebblue) || ///
>                     scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                       xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                       ytitle("`ppml_ytit'") ylab(`ymin'(0.1)`ymax') ///
>                       subtitle("`grp_label'", pos(11) size(small)) ///
>                       legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>                       yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
507.                     graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
508.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
509.                     restore
510.                 }
511.             }
512.             }  // close foreach qmethod
513. 
.             * ---- PPML young x hiw_<char> joint 2x2 for every ic char.
.             * One pooled-DiD interaction fit per char; posts 4 rows per char.
.             foreach a of global IC_ALIASES {
514.                 cap confirm variable y_hi_`a'
515.                 if _rc continue
516.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
517.                     cap drop Z_`grp' S_`grp' PT_`grp'
518.                     gen Z_`grp' = Z_it       * `grp'
519.                     gen S_`grp' = Z_share_it * `grp'
520.                     gen PT_`grp' = post * `grp'
521.                 }
522.                 * [H11] o_lo x post is the omitted base (the four PTs sum to post)
.                 cap noi ppmlhdfe `yvar' Z_y_hi_`a' Z_y_lo_`a' Z_o_hi_`a' Z_o_lo_`a' ///
>                                         S_y_hi_`a' S_y_lo_`a' S_o_hi_`a' S_o_lo_`a' ///
>                                         PT_y_hi_`a' PT_y_lo_`a' PT_o_hi_`a', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
523.                 if _rc {
524.                     di as error "event_study_het `samp'`suf' `yvar' joint-ae `a' ppml failed; skipping."
525.                     continue
526.                 }
527.                 local Nppml = e(N)
528.                 local r2ppml = e(r2_p)
529.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
530.                     gunique athr_id if e(sample) & `grp' == 1
531.                     local num_athrs = r(unique)
532.                     gunique inst_id if e(sample) & `grp' == 1
533.                     local num_insts = r(unique)
534.                     local b_post  = _b[Z_`grp']
535.                     local se_post = _se[Z_`grp']
536.                     di as text "joint-ae PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
537.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_ae") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
538.                 }
539.                 * Hi-vs-Lo differential per age; SEs via lincom use full VCE.
.                 foreach age in y o {
540.                     cap noi lincom Z_`age'_hi_`a' - Z_`age'_lo_`a'
541.                     if _rc continue
542.                     local b_diff  = r(estimate)
543.                     local se_diff = r(se)
544.                     local p_diff  = r(p)
545.                     di as text "joint-ae DIFF `samp'`suf' `yvar' `age'_`a': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
546.                     post `ph_handle' ("`yvar'") ("`age'_diff_`a'") ("mshrctrl") ("joint_ae_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
547.                 }
548.             }
549. 
.             * ---- PPML joint 2x2 for each PI-split axis (baseline productivity,
.             * coauthors) crossed with each inst char. One fit per (axis, char).
.             foreach axis of global PI_CHAR_ALIASES {
550.                 local hp "${PI_CHAR_HIPFX_`axis'}"
551.                 local lp "${PI_CHAR_LOPFX_`axis'}"
552.                 foreach a of global IC_ALIASES {
553.                     cap confirm variable `hp'_hi_`a'
554.                     if _rc continue
555.                     foreach grp in `hp'_hi_`a' `hp'_lo_`a' `lp'_hi_`a' `lp'_lo_`a' {
556.                         cap drop Z_`grp' S_`grp' PT_`grp'
557.                         gen Z_`grp' = Z_it       * `grp'
558.                         gen S_`grp' = Z_share_it * `grp'
559.                         gen PT_`grp' = post * `grp'
560.                     }
561.                     * [H11] `lp'_lo x post is the omitted base
.                     cap noi ppmlhdfe `yvar' ///
>                         Z_`hp'_hi_`a' Z_`hp'_lo_`a' Z_`lp'_hi_`a' Z_`lp'_lo_`a' ///
>                         S_`hp'_hi_`a' S_`hp'_lo_`a' S_`lp'_hi_`a' S_`lp'_lo_`a' ///
>                         PT_`hp'_hi_`a' PT_`hp'_lo_`a' PT_`lp'_hi_`a', ///
>                         absorb(`fes') vce(cluster `vce_cl')
562.                     if _rc {
563.                         di as error "event_study_het `samp'`suf' `yvar' joint-ae-`axis' `a' ppml failed; skipping."
564.                         continue
565.                     }
566.                     local Nppml = e(N)
567.                     local r2ppml = e(r2_p)
568.                     foreach grp in `hp'_hi_`a' `hp'_lo_`a' `lp'_hi_`a' `lp'_lo_`a' {
569.                         gunique athr_id if e(sample) & `grp' == 1
570.                         local num_athrs = r(unique)
571.                         gunique inst_id if e(sample) & `grp' == 1
572.                         local num_insts = r(unique)
573.                         local b_post  = _b[Z_`grp']
574.                         local se_post = _se[Z_`grp']
575.                         di as text "joint-ae-`axis' PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
576.                         post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_ae_`axis'") ///
>                             (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
577.                     }
578.                     * Within-tier hp-vs-lp: low-res row is the thin cell that would carry the reversal claim.
.                     foreach side in hi lo {
579.                         cap noi lincom Z_`hp'_`side'_`a' - Z_`lp'_`side'_`a'
580.                         if _rc continue
581.                         local b_diff  = r(estimate)
582.                         local se_diff = r(se)
583.                         local t_diff  = cond(`se_diff' > 0, `b_diff'/`se_diff', .)
584.                         local p_diff  = r(p)
585.                         local ci_l    = r(lb)
586.                         local ci_h    = r(ub)
587.                         di as text "joint-ae-`axis' DIFF `samp'`suf' `yvar' `side'res_`a' (`hp'-`lp'): " ///
>                             "b=" %8.4f `b_diff' " se=" %8.4f `se_diff' ///
>                             " t=" %6.2f `t_diff' " p=" %6.4f `p_diff' ///
>                             " CI95=[" %6.3f `ci_l' "," %6.3f `ci_h' "]"
588.                         post `ph_handle' ("`yvar'") ("`side'res_diff_`a'") ("mshrctrl") ("joint_ae_`axis'_diff") ///
>                             (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
589.                     }
590.                 }
591.             }
592. 
.             * ---- PI-split x PI-split joint 2x2s. One PPML per spec: four
.             * cell coefficients (4th cell x post is the omitted base [H11])
.             * posted under split_type = <jt>, plus four lincom contrasts
.             * (c1-c2, c3-c4, c1-c3, c2-c4) posted under <jt>_diff. Spec =
.             * "<jt> c1 c2 c3 c4 dname1 dname2 dname3 dname4".
.             local joint_specs
593.             local joint_specs `" `joint_specs' "joint_agepr y_hp y_lp o_hp o_lp y_diff_pr o_diff_pr hp_diff_age lp_diff_age" "'
594.             local joint_specs `" `joint_specs' "joint_agenih y_hn y_ln o_hn o_ln y_diff_nihd o_diff_nihd hi_diff_age lo_diff_age" "'
595.             local joint_specs `" `joint_specs' "joint_prnih hp_hn hp_ln lp_hn lp_ln hp_diff_nihd lp_diff_nihd hn_diff_pr ln_diff_pr" "'
596.             local joint_specs `" `joint_specs' "joint_ageteam y_bt y_sm o_bt o_sm y_diff_team o_diff_team bt_diff_age sm_diff_age" "'
597.             local joint_specs `" `joint_specs' "joint_tmnih bt_hn bt_ln sm_hn sm_ln bt_diff_nihd sm_diff_nihd hn_diff_team ln_diff_team" "'
598.             local joint_specs `" `joint_specs' "joint_tmpr bt_hp bt_lp sm_hp sm_lp bt_diff_pr sm_diff_pr hp_diff_team lp_diff_team" "'
599.             local joint_specs `" `joint_specs' "joint_agenet y_bn y_sn o_bn o_sn y_diff_net o_diff_net bn_diff_age sn_diff_age" "'
600.             local joint_specs `" `joint_specs' "joint_agelab y_nl y_el o_nl o_el y_diff_lab o_diff_lab nl_diff_age el_diff_age" "'
601.             local joint_specs `" `joint_specs' "joint_agecrwd y_ci y_si o_ci o_si y_diff_crwd o_diff_crwd ci_diff_age si_diff_age" "'
602.             local joint_specs `" `joint_specs' "joint_agemsa y_bmsa y_smsa o_bmsa o_smsa y_diff_msa o_diff_msa bmsa_diff_age smsa_diff_age" "'
603.             foreach js of local joint_specs {
604.                 local jt : word 1 of `js'
605.                 forvalues k = 1/4 {
606.                     local c`k'  : word `=1+`k'' of `js'
607.                     local dn`k' : word `=5+`k'' of `js'
608.                 }
609.                 * Skip if any cell is missing or empty (e.g. NIH cells off the
.                 * matched sample, degenerate joint cells).
.                 local jt_bad 0
610.                 foreach grp in `c1' `c2' `c3' `c4' {
611.                     cap confirm variable `grp'
612.                     if _rc {
613.                         local jt_bad 1
614.                         continue, break
615.                     }
616.                     qui count if `grp' == 1
617.                     if r(N) == 0 local jt_bad 1
618.                 }
619.                 if `jt_bad' {
620.                     di as text "event_study_het `samp'`suf' `yvar': `jt' cells missing/empty -- skipping."
621.                     continue
622.                 }
623.                 foreach grp in `c1' `c2' `c3' `c4' {
624.                     cap drop Z_`grp' S_`grp' PT_`grp'
625.                     gen Z_`grp' = Z_it       * `grp'
626.                     gen S_`grp' = Z_share_it * `grp'
627.                     gen PT_`grp' = post * `grp'
628.                 }
629.                 cap noi ppmlhdfe `yvar' Z_`c1' Z_`c2' Z_`c3' Z_`c4' ///
>                                         S_`c1' S_`c2' S_`c3' S_`c4' ///
>                                         PT_`c1' PT_`c2' PT_`c3', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
630.                 if _rc {
631.                     di as error "event_study_het `samp'`suf' `yvar' `jt' ppml failed; skipping."
632.                     continue
633.                 }
634.                 local Nppml = e(N)
635.                 local r2ppml = e(r2_p)
636.                 foreach grp in `c1' `c2' `c3' `c4' {
637.                     gunique athr_id if e(sample) & `grp' == 1
638.                     local num_athrs = r(unique)
639.                     gunique inst_id if e(sample) & `grp' == 1
640.                     local num_insts = r(unique)
641.                     local b_post  = _b[Z_`grp']
642.                     local se_post = _se[Z_`grp']
643.                     di as text "`jt' PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
644.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`jt'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
645.                 }
646.                 * Within-first-axis and within-second-axis contrasts; SEs via
.                 * lincom use the full VCE.
.                 foreach d in "`dn1' Z_`c1' Z_`c2'" "`dn2' Z_`c3' Z_`c4'" ///
>                              "`dn3' Z_`c1' Z_`c3'" "`dn4' Z_`c2' Z_`c4'" {
647.                     local dname : word 1 of `d'
648.                     local d1    : word 2 of `d'
649.                     local d2    : word 3 of `d'
650.                     cap noi lincom `d1' - `d2'
651.                     if _rc continue
652.                     local b_diff  = r(estimate)
653.                     local se_diff = r(se)
654.                     local p_diff  = r(p)
655.                     di as text "`jt' DIFF `samp'`suf' `yvar' `dname': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
656.                     post `ph_handle' ("`yvar'") ("`dname'") ("mshrctrl") ("`jt'_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
657.                 }
658.             }
659. 
.         }
660.         postclose `ph_handle'
661. 
.         * pdid binscatter + coefplot for this yvar, so PDFs land continuously
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
662.             cap noi ppml_pdid_het_binscatter, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
663.         }
664.         cap noi ppml_het_coefplot, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
665.     }
666. 
.     * Combine per-yvar phet_results files into master (consumed by output_het_tables).
.     preserve
667.     clear
668.     foreach yvar of local yvar_list {
669.         cap append using ../temp/phet_results_`samp'`suf'_`yvar'
670.     }
671.     save ../temp/phet_results_`samp'`suf', replace
672.     restore
673. end

. 
. program ppml_pdid_het_binscatter
  1.     * Joint PPML pooled-DiD FWL binscatter of `yvar' on Z_it, mshr partialled.
.     * Fit ppmlhdfe on FULL sample with fully-interacted Z and share, then
.     * residualize _z_work and Z_grp against the sibling group + shares + FEs.
.     * On grp==1 rows the sibling interactions are 0 so FWL slope = _b[Z_grp].
.     * NOTE: residualization runs on the full sample while the plot keeps
.     * grp==1 rows, so the binned slope approximates the (exactly displayed)
.     * joint-fit coefficient.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     if "`yvar'" == "" local yvar ppr_cnt
  3.     local fes athr_id year
  4.     local vce_cl athr_id
  5.     if "$FE_MODE" == "inst_cluster" {
  6.         local fes inst_id cluster_30 year
  7.         local vce_cl inst_id
  8.     }
  9.     if "$FE_MODE" == "inst_cluster_fldyr" {
 10.         local fes inst_id i.cluster_30#i.year
 11.         local vce_cl inst_id
 12.     }
 13.     local suf ""
 14.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 15.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 16.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 17.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 18.     cap mkdir "../output/figures/`samp'/ppml_pdid_het_bs"
 19. 
.     * [H9] y-axis label per outcome (was hard-coded "Publications")
.     local bs_lbl "`yvar'"
 20.     if "`yvar'" == "ppr_cnt"           local bs_lbl "Publications"
 21.     if "`yvar'" == "cite_affl_wt"      local bs_lbl "Citation-Weighted Output"
 22.     if "`yvar'" == "avg_num_coathrs"   local bs_lbl "Coauthors"
 23.     if "`yvar'" == "n_grants"          local bs_lbl "Active NIH Research Grants"
 24.     if "`yvar'" == "n_new_grants"      local bs_lbl "New NIH Research Grants"
 25.     if "`yvar'" == "nih_total_cost"    local bs_lbl "NIH Award Dollars"
 26.     if "`yvar'" == "n_middle_ppr"      local bs_lbl "Middle-Author Papers"
 27. 
.     local dummy_pairs `" "young old" "young_nih old_nih" "r1 r2" "pub_inst priv_inst" "high_pre_ppr low_pre_ppr" "big_team small_team" "high_nihg low_nihg" "high_nihd low_nihd" "big_net small_net" "new_lab est_lab" "crwd_inst sprs_inst" "big_msa small_m
> sa" "yhigh_nihd ylow_nihd" "yq4_nihd yq1_nihd" ${IC_PAIRS_MED_PW} "'
 28.     if "$HET_INCLUDE_INSTWTD" == "1" local dummy_pairs `" `dummy_pairs' ${IC_PAIRS_MED} "'
 29. 
.     * Load panel once; per-pair vars are cap-dropped and rebuilt in place.
.     preserve
 30.         use ../temp/es_`samp'`suf', clear
 31.         gen post       = year >= 2014
 32.         gen Z_it       = exposure      * post
 33.         gen Z_share_it = mkt_spend_shr * post
 34. 
.         foreach pair of local dummy_pairs {
 35.             local g1 : word 1 of `pair'
 36.             local g2 : word 2 of `pair'
 37. 
.             * HET_GROUPS_ACTIVE (set by event_study_het before this is called)
.             * screens missing AND degenerate dummies — a no-obs group would
.             * crash binscatter and abort the remaining pairs.
.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
 38.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
 39. 
.             * one at a time — a `drop' list is all-or-nothing, and a missing
.             * Z_<grp> would leave _mu/_dvar alive to crash d() below
.             foreach v in Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1' _mu _z_work _dvar _fwlw _y_r _Z_r {
 40.                 cap drop `v'
 41.             }
 42.             gen Z_`g1' = Z_it       * `g1'
 43.             gen Z_`g2' = Z_it       * `g2'
 44.             gen S_`g1' = Z_share_it * `g1'
 45.             gen S_`g2' = Z_share_it * `g2'
 46.             gen PT_`g1' = post * `g1'
 47. 
.             * [H11] PT matches the posted pooled-DiD spec so displayed beta agrees
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
 48.             local rc = _rc
 49.             if `rc' {
 50.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `g1'/`g2' joint failed (rc=`rc'); skipping pair."
 51.                 continue
 52.             }
 53.             local b_`g1'  = _b[Z_`g1']
 54.             local se_`g1' = _se[Z_`g1']
 55.             local b_`g2'  = _b[Z_`g2']
 56.             local se_`g2' = _se[Z_`g2']
 57. 
.             * IRLS working response + FWL weight from the joint fit.
.             predict double _mu, mu
 58.             gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
 59.             gen double _fwlw = _mu if !mi(_mu) & _mu > 0
 60. 
.             foreach grp in `g1' `g2' {
 61.                 local other = cond("`grp'" == "`g1'", "`g2'", "`g1'")
 62. 
.                 foreach v in _y_r _Z_r {
 63.                     cap drop `v'
 64.                 }
 65.                 cap noi qui reghdfe _z_work Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_y_r)
 66.                 if _rc == 0 cap noi qui reghdfe Z_`grp' Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_Z_r)
 67.                 if _rc {
 68.                     di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
 69.                     continue
 70.                 }
 71.                 gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 72.                 local n_pis = r(unique)
 73.                 gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 74.                 local n_insts = r(unique)
 75.                 local b_str  : dis %7.3f `b_`grp''
 76.                 local se_str : dis %7.3f `se_`grp''
 77.                 binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                     xtitle("Exposure x Post") ///
>                     ytitle("{&Delta} Log Expected `bs_lbl'") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                     note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left)) ///
>                     plotregion(margin(sides))
 78.                 graph export ///
>                     ../output/figures/`samp'/ppml_pdid_het_bs/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf, ///
>                     replace
 79.             }
 80.         }
 81. 
.         * ---- Multi-group lab-age splits: joint fit, per-group FWL binscatter ----
.         foreach aspec in age3 ageq4 {
 82.             if "`aspec'" == "age3"  local agrps lab_lt10 lab_10_20 lab_20p
 83.             if "`aspec'" == "ageq4" local agrps q1_labage q2_labage q3_labage q4_labage
 84.             local aok 1
 85.             foreach grp of local agrps {
 86.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `grp' ") == 0 local aok 0
 87.             }
 88.             if `aok' {
 89.             foreach v in _mu _z_work _dvar _fwlw _y_r _Z_r {
 90.                 cap drop `v'
 91.             }
 92.             local nb : word count `agrps'
 93.             local abase : word `nb' of `agrps'
 94.             local Zs
 95.             local Ss
 96.             local PTs
 97.             foreach grp of local agrps {
 98.                 cap drop Z_`grp'
 99.                 cap drop S_`grp'
100.                 cap drop PT_`grp'
101.                 gen Z_`grp' = Z_it       * `grp'
102.                 gen S_`grp' = Z_share_it * `grp'
103.                 local Zs `Zs' Z_`grp'
104.                 local Ss `Ss' S_`grp'
105.                 if "`grp'" != "`abase'" {
106.                     gen PT_`grp' = post * `grp'
107.                     local PTs `PTs' PT_`grp'
108.                 }
109.             }
110. 
.             * [H11] PT matches the posted `aspec' pooled-DiD spec (most senior group x post is the base)
.             cap noi ppmlhdfe `yvar' `Zs' `Ss' `PTs', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
111.             local rc = _rc
112.             if `rc' {
113.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `aspec' joint failed (rc=`rc'); skipping."
114.             }
115.             else {
116.                 foreach grp of local agrps {
117.                     local b_`grp'  = _b[Z_`grp']
118.                     local se_`grp' = _se[Z_`grp']
119.                 }
120. 
.                 predict double _mu, mu
121.                 gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
122.                 gen double _fwlw = _mu if !mi(_mu) & _mu > 0
123. 
.                 foreach grp of local agrps {
124.                     local others
125.                     foreach o of local agrps {
126.                         if "`o'" != "`grp'" local others `others' Z_`o'
127.                     }
128.                     foreach v in _y_r _Z_r {
129.                         cap drop `v'
130.                     }
131.                     cap noi qui reghdfe _z_work `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_y_r)
132.                     if _rc == 0 cap noi qui reghdfe Z_`grp' `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_Z_r)
133.                     if _rc {
134.                         di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
135.                         continue
136.                     }
137.                     gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
138.                     local n_pis = r(unique)
139.                     gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
140.                     local n_insts = r(unique)
141.                     local b_str  : dis %7.3f `b_`grp''
142.                     local se_str : dis %7.3f `se_`grp''
143.                     binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                         xtitle("Exposure x Post") ///
>                         ytitle("{&Delta} Log Expected `bs_lbl'") ///
>                         xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                         msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                         note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left)) ///
>                         plotregion(margin(sides))
144.                     graph export ///
>                         ../output/figures/`samp'/ppml_pdid_het_bs/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf, ///
>                         replace
145.                 }
146.             }
147.             }
148.         }
149.     restore
150. end

. 
. program ppml_age_gradient
  1.     * Age gradient of the pooled-DiD beta: one joint PPML with Z_it and the
.     * share control fully interacted with career-age bins (HET_AGE_NBINS
.     * PI-level quantiles of age_2014), plotted as each bin's beta vs the bin's
.     * mean age. Same spec as the posted "mshrctrl" median splits, K bins
.     * instead of 2.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     cap mkdir "../output/figures/`samp'"
 18. 
.     local yvar_list ppr_cnt cite_affl_wt
 19.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 20.     local ppml_skip avg_position avg_team_size_last avg_team_size_notlast
 21. 
.     use ../temp/es_`samp'`suf', clear
 22.     gen post       = year >= 2014
 23.     gen Z_it       = exposure      * post
 24.     gen Z_share_it = mkt_spend_shr * post
 25. 
.     local K = $HET_AGE_NBINS
 26.     * Two age bases: career age (first any-position pub, +30) writes agegrad_*;
.     * lab age (years since first last-author pub) writes labgrad_*.
.     foreach agevar in age_2014 lab_age_2014 {
 27.     cap confirm variable `agevar'
 28.     if _rc {
 29.         di as error "ppml_age_gradient `samp'`suf': `agevar' not in panel -- skipped."
 30.         continue
 31.     }
 32.     local gpfx agegrad
 33.     local gtmp age_gradient
 34.     local gxtit "Career Age in 2014"
 35.     if "`agevar'" == "lab_age_2014" {
 36.         local gpfx labgrad
 37.         local gtmp lab_gradient
 38.         local gxtit "Years Running Lab in 2014"
 39.     }
 40.     cap drop agebin
 41.     xtile _agebin_pi = `agevar' if athr_indicator == 1, n(`K')
 42.     bys athr_id: egen agebin = max(_agebin_pi)
 43.     drop _agebin_pi
 44. 
.     local zvars
 45.     local svars
 46.     local bins_used
 47.     forval k = 1/`K' {
 48.         qui count if agebin == `k' & athr_indicator == 1
 49.         if r(N) == 0 {
 50.             di as error "ppml_age_gradient `samp'`suf': age bin `k' empty -- skipped."
 51.             continue
 52.         }
 53.         cap drop Z_a`k'
 54.         cap drop S_a`k'
 55.         gen Z_a`k' = Z_it       * (agebin == `k')
 56.         gen S_a`k' = Z_share_it * (agebin == `k')
 57.         local zvars `zvars' Z_a`k'
 58.         local svars `svars' S_a`k'
 59.         local bins_used `bins_used' `k'
 60.     }
 61.     * post x bin shifts for all but the last bin: the full set sums to post,
.     * collinear with year FE (last bin's post shift is the absorbed base).
.     local ptvars
 62.     local nb : word count `bins_used'
 63.     forval i = 1/`=`nb'-1' {
 64.         local k : word `i' of `bins_used'
 65.         cap drop PT_a`k'
 66.         gen PT_a`k' = post * (agebin == `k')
 67.         local ptvars `ptvars' PT_a`k'
 68.     }
 69. 
.     foreach yvar of local yvar_list {
 70.         if strpos(" `ppml_skip' ", " `yvar' ") > 0 {
 71.             di as text "ppml_age_gradient: `yvar' not a count outcome -- skipped."
 72.             continue
 73.         }
 74.         local ppml_ytit "Output-Cost Elasticity"
 75.         if "`yvar'" == "n_grants"       local ppml_ytit "{&Delta} Log Expected Active NIH Research Grants"
 76.         if "`yvar'" == "n_new_grants"   local ppml_ytit "{&Delta} Log Expected New NIH Research Grants"
 77.         if "`yvar'" == "nih_total_cost" local ppml_ytit "{&Delta} Log Expected NIH Award Dollars"
 78. 
.         cap noi ppmlhdfe `yvar' `zvars' `svars' `ptvars' if !mi(agebin), ///
>             absorb(`fes') vce(cluster `vce_cl')
 79.         local rc = _rc
 80.         if `rc' {
 81.             di as error "ppml_age_gradient `samp'`suf' `yvar' failed (rc=`rc'); skipping."
 82.             continue
 83.         }
 84.         gunique athr_id if e(sample)
 85.         local n_pis = r(unique)
 86.         gunique inst_id if e(sample)
 87.         local n_insts = r(unique)
 88.         cap mat drop AG
 89.         foreach k of local bins_used {
 90.             if _se[Z_a`k'] == 0 {
 91.                 di as error "ppml_age_gradient `samp'`suf' `yvar': Z_a`k' dropped/degenerate -- omitted from plot."
 92.                 continue
 93.             }
 94.             qui sum `agevar' if athr_indicator == 1 & agebin == `k'
 95.             mat AG = nullmat(AG) \ (`k', r(mean), r(N), _b[Z_a`k'], _se[Z_a`k'])
 96.         }
 97.         preserve
 98.         clear
 99.         svmat AG
100.         rename (AG1 AG2 AG3 AG4 AG5) (bin age_mean n_pis b se)
101.         gen ub = b + 1.96*se
102.         gen lb = b - 1.96*se
103.         save ../temp/`gtmp'_`samp'`suf'_`yvar', replace
104.         tw rcap ub lb age_mean, lcolor(ebblue%70) msize(vsmall) || ///
>            scatter b age_mean, mcolor(ebblue) || ///
>            lfit b age_mean [aw=1/(se*se)], lcolor(dkorange) lpattern(dash) ///
>            xtitle("`gxtit'") ytitle("`ppml_ytit'") ///
>            yline(0, lcolor(gs10) lpattern(solid)) ///
>            legend(on order(- "Num. PIs: `n_pis'" "Num. Insts: `n_insts'") pos(7) ring(1) rows(2) bmargin(zero) size(small)) ///
>            plotregion(margin(sides))
105.         graph export ../output/figures/`samp'/`gpfx'_`yvar'`suf'_ppml_mshrctrl.pdf, replace
106.         restore
107.     }
108.     }
109. end

. 
. program desc_pre_output_by_age
  1.     * PI-level pre-period research-output densities, young vs old.
.     * Log-scale and raw (x capped at pooled p95) overlays per outcome.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir "../output/figures/`samp'"
  8. 
.     use ../temp/es_`samp'`suf', clear
  9.     keep if year < 2014
 10.     qui sum year
 11.     local y0 = r(min)
 12.     local y1 = r(max)
 13. 
.     * Productivity: total pre-period papers and papers per pre-period year.
.     * Citations and authorship-position counts ride along as totals.
.     local sum_src   ppr_cnt cite_affl_wt n_first_ppr n_last_ppr
 14.     local sum_alias ppr_tot cite         first       last
 15.     local mean_src   ppr_cnt
 16.     local mean_alias ppr_yr
 17.     local lbl_ppr_tot "Total Papers"
 18.     local lbl_ppr_yr  "Papers per Year"
 19.     local lbl_cite    "Affiliation-Weighted Citations"
 20.     local lbl_first   "First-Authored Papers"
 21.     local lbl_last    "Last-Authored Papers"
 22.     local fmt_ppr_tot %6.1f
 23.     local fmt_ppr_yr  %5.2f
 24.     local fmt_cite    %8.1f
 25.     local fmt_first   %6.1f
 26.     local fmt_last    %6.1f
 27. 
.     local coll_sum
 28.     local coll_mean
 29.     local keep_alias
 30.     foreach stat in sum mean {
 31.         local nsrc : word count ``stat'_src'
 32.         forvalues i = 1/`nsrc' {
 33.             local src : word `i' of ``stat'_src'
 34.             local a   : word `i' of ``stat'_alias'
 35.             cap confirm variable `src'
 36.             if _rc {
 37.                 di as error "desc_pre_output_by_age `samp'`suf': `src' not in panel -- `a' density SKIPPED."
 38.                 continue
 39.             }
 40.             local coll_`stat' `coll_`stat'' pre_`a'=`src'
 41.             local keep_alias `keep_alias' `a'
 42.         }
 43.     }
 44.     if "`keep_alias'" == "" {
 45.         di as error "desc_pre_output_by_age `samp'`suf': no outcomes available -- nothing plotted."
 46.         exit
 47.     }
 48.     local coll_sum_part = cond("`coll_sum'" == "", "", "(sum) `coll_sum'")
 49.     local coll_mean_part = cond("`coll_mean'" == "", "", "(mean) `coll_mean'")
 50. 
.     egen long inst_num = group(inst_id)
 51.     gcollapse `coll_sum_part' `coll_mean_part' (firstnm) young inst_num, by(athr_id)
 52.     drop if mi(young)
 53. 
.     qui count if young == 1
 54.     local n_y = r(N)
 55.     qui count if young == 0
 56.     local n_o = r(N)
 57.     di as text _n "desc_pre_output_by_age `samp'`suf': pre-period = `y0'-`y1', N young = `n_y', N old = `n_o'"
 58. 
.     foreach a of local keep_alias {
 59.         local f "`fmt_`a''"
 60.         qui sum pre_`a' if young == 1, d
 61.         local mu_y = strtrim(string(r(mean), "`f'"))
 62.         local md_y = strtrim(string(r(p50),  "`f'"))
 63.         qui sum pre_`a' if young == 0, d
 64.         local mu_o = strtrim(string(r(mean), "`f'"))
 65.         local md_o = strtrim(string(r(p50),  "`f'"))
 66.         local leg_y "Early-Career (N=`n_y'): mean=`mu_y'"
 67.         local leg_o "Late-Career (N=`n_o'): mean=`mu_o'"
 68.         di as text "  `a': young mean=`mu_y' p50=`md_y' | old mean=`mu_o' p50=`md_o'"
 69.         cap noi ksmirnov pre_`a', by(young)
 70.         qui reg pre_`a' young, vce(cluster inst_num)
 71.         di as text "  `a': young-old diff = " %8.3f _b[young] " (se " %8.3f _se[young] ")"
 72. 
.         gen double ln_pre_`a' = ln(1 + pre_`a')
 73.         * both densities on one common x grid so rarea can shade the gap
.         qui sum ln_pre_`a'
 74.         cap drop _kx _kd_y _kd_o _kd_c
 75.         gen _kx = r(min) + (r(max) - r(min)) * (_n - 1) / 199 if _n <= 200
 76.         kdensity ln_pre_`a' if young == 1, at(_kx) gen(_kd_y) nograph
 77.         kdensity ln_pre_`a' if young == 0, at(_kx) gen(_kd_o) nograph
 78.         gen _kd_c = min(_kd_y, _kd_o)
 79.         tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>            (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>            (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>            (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>            , xtitle("ln(1 + Pre-Period `lbl_`a'', `y0'-`y1')") ytitle("Density") ///
>              legend(order(3 "`leg_y'" 4 "`leg_o'") ///
>                     pos(2) ring(0) rows(2) size(small)) ///
>              plotregion(margin(sides))
 80.         graph export ../output/figures/`samp'/desc_kd_pre_`a'_ln`suf'.pdf, replace
 81. 
.         qui sum pre_`a', d
 82.         local xcap = r(p95)
 83.         cap drop _kx _kd_y _kd_o _kd_c
 84.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 85.         kdensity pre_`a' if young == 1 & pre_`a' <= `xcap', at(_kx) gen(_kd_y) nograph
 86.         kdensity pre_`a' if young == 0 & pre_`a' <= `xcap', at(_kx) gen(_kd_o) nograph
 87.         gen _kd_c = min(_kd_y, _kd_o)
 88.         tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>            (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>            (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>            (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>            , xtitle("Pre-Period `lbl_`a'', `y0'-`y1' (x capped at pooled p95)") ytitle("Density") ///
>              legend(order(3 "`leg_y'" 4 "`leg_o'") ///
>                     pos(2) ring(0) rows(2) size(small)) ///
>              plotregion(margin(sides))
 89.         graph export ../output/figures/`samp'/desc_kd_pre_`a'_raw`suf'.pdf, replace
 90.         cap drop _kx _kd_y _kd_o _kd_c
 91.     }
 92. 
.     save ../temp/desc_pre_output_`samp'`suf', replace
 93. end

. 
. program horse_race_nih
  1.     * Experience-vs-money horse race on the NIH-matched sample: one PPML with
.     * Z_it interacted with young (early-career) AND low_nihd (below-median
.     * baseline NIH funding) jointly, plus the post x dummy shifts and the
.     * uninteracted share control. Base Z_it = late-career, above-median-NIH.
.     * Reports both triple-interaction betas and the Wald test of equality.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17. 
.     cap confirm file "../temp/es_`samp'`suf'.dta"
 18.     if _rc {
 19.         di as error "horse_race_nih `samp'`suf': ../temp/es_`samp'`suf'.dta not found -- run add_het_splits first."
 20.         exit
 21.     }
 22.     use ../temp/es_`samp'`suf', clear
 23.     foreach v in young low_nihd nih_pi {
 24.         cap confirm variable `v'
 25.         if _rc {
 26.             di as error "horse_race_nih `samp'`suf': `v' not in panel -- SKIPPED."
 27.             exit
 28.         }
 29.     }
 30.     keep if nih_pi == 1 & !mi(young) & !mi(low_nihd)
 31.     foreach v in young low_nihd {
 32.         qui sum `v'
 33.         if r(N) == 0 | r(min) == r(max) {
 34.             di as error "horse_race_nih `samp'`suf': `v' degenerate on the NIH-matched sample -- SKIPPED."
 35.             exit
 36.         }
 37.     }
 38. 
.     gen post       = year >= 2014
 39.     gen Z_it       = exposure      * post
 40.     gen Z_share_it = mkt_spend_shr * post
 41.     gen Z_early    = Z_it * young
 42.     gen Z_lownih   = Z_it * low_nihd
 43.     gen PT_early   = post * young
 44.     gen PT_lownih  = post * low_nihd
 45. 
.     local yvar_list ppr_cnt cite_affl_wt
 46.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 47.     local nyv : word count `yvar_list'
 48. 
.     mat hrace`suf' = J(14, `nyv', .)
 49.     mat rownames hrace`suf' = b_z_base se_z_base b_z_early se_z_early ///
>                               b_z_lownih se_z_lownih b_diff se_diff ///
>                               stat_eq p_eq N n_pis n_pis_early n_pis_lownih
 50.     mat colnames hrace`suf' = `yvar_list'
 51. 
.     local col 0
 52.     foreach yvar of local yvar_list {
 53.         local ++col
 54.         cap noi ppmlhdfe `yvar' Z_it Z_early Z_lownih PT_early PT_lownih Z_share_it, ///
>             absorb(`fes') vce(cluster `vce_cl')
 55.         local rc = _rc
 56.         if `rc' {
 57.             di as error "horse_race_nih `samp'`suf' `yvar' failed (rc=`rc'); column left missing."
 58.             continue
 59.         }
 60.         local Nppml = e(N)
 61.         local b_early   = _b[Z_early]
 62.         local se_early  = _se[Z_early]
 63.         local b_lownih  = _b[Z_lownih]
 64.         local se_lownih = _se[Z_lownih]
 65.         gunique athr_id if e(sample)
 66.         local n_pis = r(unique)
 67.         gunique athr_id if e(sample) & young == 1
 68.         local n_early = r(unique)
 69.         gunique athr_id if e(sample) & low_nihd == 1
 70.         local n_lownih = r(unique)
 71.         qui lincom Z_early - Z_lownih
 72.         local b_diff  = r(estimate)
 73.         local se_diff = r(se)
 74.         qui test Z_early = Z_lownih
 75.         local stat_eq = cond(r(F) < ., r(F), r(chi2))
 76.         local p_eq = r(p)
 77. 
.         mat hrace`suf'[1,`col']  = _b[Z_it]
 78.         mat hrace`suf'[2,`col']  = _se[Z_it]
 79.         mat hrace`suf'[3,`col']  = `b_early'
 80.         mat hrace`suf'[4,`col']  = `se_early'
 81.         mat hrace`suf'[5,`col']  = `b_lownih'
 82.         mat hrace`suf'[6,`col']  = `se_lownih'
 83.         mat hrace`suf'[7,`col']  = `b_diff'
 84.         mat hrace`suf'[8,`col']  = `se_diff'
 85.         mat hrace`suf'[9,`col']  = `stat_eq'
 86.         mat hrace`suf'[10,`col'] = `p_eq'
 87.         mat hrace`suf'[11,`col'] = `Nppml'
 88.         mat hrace`suf'[12,`col'] = `n_pis'
 89.         mat hrace`suf'[13,`col'] = `n_early'
 90.         mat hrace`suf'[14,`col'] = `n_lownih'
 91. 
.         di as text "horse_race_nih `samp'`suf' `yvar' (NIH-matched sample):"
 92.         di as text "  Z x EarlyCareer     = " %9.4f `b_early'  "  (se " %7.4f `se_early' ")"
 93.         di as text "  Z x BelowMedianNIH  = " %9.4f `b_lownih' "  (se " %7.4f `se_lownih' ")"
 94.         di as text "  diff (early-lownih) = " %9.4f `b_diff'   "  (se " %7.4f `se_diff' ")   H0 equal: stat = " %8.4f `stat_eq' "  p = " %6.4f `p_eq'
 95.         di as text "  base Z (late-career x above-median) = " %9.4f _b[Z_it] "  (se " %7.4f _se[Z_it] ")"
 96.         di as text "  N = " %9.0f `Nppml' "  PIs = `n_pis' (early = `n_early', below-median NIH = `n_lownih')"
 97.     }
 98. 
.     cap mkdir ../output/tables
 99.     cap mkdir ../output/tables/`samp'
100.     qui matrix_to_txt, saving("../output/tables/`samp'/horse_race_nih`suf'.txt") ///
>         matrix(hrace`suf') title(<tab:horse_race_nih`suf'>) format(%20.4f) replace
101. end

