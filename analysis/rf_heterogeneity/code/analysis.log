. program output_het_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir ../output/tables
  8.     cap mkdir ../output/tables/`samp'
  9. 
.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
 10.     if !_rc {
 11.         preserve
 12.         use "../temp/phet_results_`samp'`suf'.dta", clear
 13.         export delimited using "../output/tables/`samp'/phet_results`suf'.txt", replace delim(tab)
 14.         restore
 15.     }
 16. end

. 
. program ppml_het_coefplot
  1.     * Three panels per yvar (pi / ic_fund / ic_expx).
.     * If yvar() is supplied, plot only that outcome; otherwise loop all.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     * When called inline per-yvar, read the per-yvar postfile; otherwise the combined master.
.     if "`yvar'" != "" {
  8.         local resfile "../temp/phet_results_`samp'`suf'_`yvar'.dta"
  9.     }
 10.     else {
 11.         local resfile "../temp/phet_results_`samp'`suf'.dta"
 12.     }
 13.     cap confirm file "`resfile'"
 14.     if _rc {
 15.         di as error "ppml_het_coefplot: `resfile' not found -- skipping"
 16.         exit 0
 17.     }
 18. 
.     local ppml_het_yvars ppr_cnt cite_affl_wt avg_num_coathrs ///
>                         n_grants n_new_grants nih_total_cost ///
>                         n_middle_ppr
 19.     if "`yvar'" != "" local ppml_het_yvars `yvar'
 20. 
.     local ic_fund_aliases tfnd lsf
 21.     local ic_expx_aliases endow
 22.     if $HET_IC_FULL == 1 {
 23.         local ic_fund_aliases contr fdlsb fdls fdlsh gntsf hhlsb hhls hhlsh nflsb nfls nflsh subrf busf fedf tfnd instf nonpf statf lsf hsf biof
 24.         local ic_expx_aliases applx apfx basx bfx clinx devx lscx medx endow
 25.     }
 26. 
.     * joint_ae_<axis> types track PI_CHAR_ALIASES so dropping an axis there
.     * removes its coefplot too.
.     local axis_sts
 27.     foreach axis of global PI_CHAR_ALIASES {
 28.         local axis_sts `axis_sts' joint_ae_`axis'
 29.     }
 30.     local st_list med_pi joint_ae `axis_sts' joint_agepr joint_agenih joint_prnih ///
>                   joint_ageteam joint_tmnih joint_tmpr ///
>                   joint_agenet joint_agelab joint_agecrwd joint_agemsa
 31.     if "$HET_INCLUDE_INSTWTD" == "1" local st_list med `st_list'
 32.     if "$HET_RUN_QUARTILES" == "1" {
 33.         local st_list `st_list' quart_pi
 34.         if "$HET_INCLUDE_INSTWTD" == "1" local st_list `st_list' quart
 35.     }
 36.     foreach st of local st_list {
 37.         if strpos("`st'", "joint_") == 1 {
 38.             * Custom paired rendering used instead of the standard panel loop.
.             * Leaving all groups empty causes the standard loop to skip.
.             local groups_pi
 39.             local groups_ic_fund
 40.             local groups_ic_expx
 41.         }
 42.         else if "`st'" == "med" {
 43.             local groups_pi     young old r1 r2 pub_inst priv_inst ///
>                                 high_pre_ppr low_pre_ppr ///
>                                 high_nihd low_nihd ///
>                                 big_msa small_msa
 44.             local groups_ic_fund
 45.             foreach a of local ic_fund_aliases {
 46.                 local groups_ic_fund `groups_ic_fund' hi_`a' lo_`a'
 47.             }
 48.             local groups_ic_expx
 49.             foreach a of local ic_expx_aliases {
 50.                 local groups_ic_expx `groups_ic_expx' hi_`a' lo_`a'
 51.             }
 52.         }
 53.         else if "`st'" == "med_pi" {
 54.             * PI-weighted inst-char medians. PI-level splits are the same
.             * variables as under med so they render in the pi panel too.
.             local groups_pi     young old r1 r2 pub_inst priv_inst ///
>                                 high_pre_ppr low_pre_ppr ///
>                                 high_nihd low_nihd ///
>                                 big_msa small_msa
 55.             local groups_ic_fund
 56.             foreach a of local ic_fund_aliases {
 57.                 local groups_ic_fund `groups_ic_fund' hiw_`a' low_`a'
 58.             }
 59.             local groups_ic_expx
 60.             foreach a of local ic_expx_aliases {
 61.                 local groups_ic_expx `groups_ic_expx' hiw_`a' low_`a'
 62.             }
 63.         }
 64.         else if "`st'" == "quart" {
 65.             local groups_pi
 66.             foreach b of global PI_Q_BASES {
 67.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 68.             }
 69.             local groups_ic_fund
 70.             foreach a of local ic_fund_aliases {
 71.                 local groups_ic_fund `groups_ic_fund' q4_`a' q1_`a'
 72.             }
 73.             local groups_ic_expx
 74.             foreach a of local ic_expx_aliases {
 75.                 local groups_ic_expx `groups_ic_expx' q4_`a' q1_`a'
 76.             }
 77.         }
 78.         else {
 79.             * quart_pi -- PI-weighted quartiles for inst chars, PI-continuous
.             * quartiles for PI bases.
.             local groups_pi
 80.             foreach b of global PI_Q_BASES {
 81.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 82.             }
 83.             local groups_ic_fund
 84.             foreach a of local ic_fund_aliases {
 85.                 local groups_ic_fund `groups_ic_fund' q4w_`a' q1w_`a'
 86.             }
 87.             local groups_ic_expx
 88.             foreach a of local ic_expx_aliases {
 89.                 local groups_ic_expx `groups_ic_expx' q4w_`a' q1w_`a'
 90.             }
 91.         }
 92. 
.         foreach spec_tag in mshrctrl {
 93.             local spec_folder = cond($HET_IC_FULL == 1, "coefplot_evavg_full", "coefplot_evavg")
 94.             cap mkdir "../output/figures/`samp'/`spec_folder'"
 95. 
.         * Combined panel stacks pi + ic_fund + ic_expx so the paper can show
.         * one coefplot per (yvar, spec, st) instead of three per-panel PDFs.
.         local groups_all `groups_pi' `groups_ic_fund' `groups_ic_expx'
 96.         foreach panel in pi ic_fund ic_expx all {
 97.             local groups `groups_`panel''
 98.             local n_groups : word count `groups'
 99.             if `n_groups' == 0 continue
100. 
.             foreach yv of local ppml_het_yvars {
101.                 preserve
102.                 use "`resfile'", clear
103.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
104.                 if _N == 0 {
105.                     restore
106.                     continue
107.                 }
108. 
.                 * Groups come in high/low pairs; add a gap between pairs so
.                 * each pair reads as one block.
.                 local pair_gap 0.7
109.                 local npairs = ceil(`n_groups'/2)
110.                 gen double y = .
111.                 local ylabs ""
112.                 local i = 0
113.                 foreach g of local groups {
114.                     local ++i
115.                     local pair = int((`i'-1)/2)
116.                     local ypos = (`n_groups' - `i') + (`npairs' - 1 - `pair')*`pair_gap' + 1
117.                     qui replace y = `ypos' if grp == "`g'"
118.                     local lbl = "${LBL_`g'}"
119.                     if "`lbl'" == "" local lbl "`g'"
120.                     if length("`lbl'") > 40 local lbl = substr("`lbl'", 1, 37) + "..."
121.                     local ylabs `"`ylabs' `ypos' "`lbl'""'
122.                 }
123.                 drop if mi(y) | mi(post_b)
124.                 if _N == 0 {
125.                     restore
126.                     continue
127.                 }
128.                 gen ub = post_b + 1.96*post_se
129.                 gen lb = post_b - 1.96*post_se
130. 
.                 qui sum lb
131.                 local xmin = floor(r(min)/0.5)*0.5
132.                 qui sum ub
133.                 local xmax = ceil(r(max)/0.5)*0.5
134. 
.                 * Adaptive canvas: bigger for more rows. Matches old reduced_form format.
.                 local ysize 6
135.                 if `n_groups' > 20 local ysize 10
136.                 if `n_groups' > 40 local ysize 14
137.                 * Grow the canvas by the added inter-pair whitespace.
.                 local ysize = round(`ysize' * (`n_groups' + (`npairs'-1)*`pair_gap')/`n_groups', 0.1)
138.                 local labsize small
139.                 if `n_groups' > 20 local labsize vsmall
140. 
.                 tw rcap ub lb y, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>                    scatter y post_b, mcolor(ebblue) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(`labsize') noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(off) ///
>                      ysize(`ysize') xsize(7) ///
>                      yscale(range(0.9 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
141.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf", ///
>                     replace
142.                 di as text "wrote ../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf"
143.                 restore
144.             }
145.         }
146. 
.         * ----- Custom paired coefplot: inst chars on y-axis (High/Low rows),
.         *       one blue + one orange marker per row. Splitting axis and
.         *       prefix widths depend on `st':
.         *         joint_ae         -- age (1-char y/o prefix)
.         *         joint_ae_<axis>  -- PI split (2-char hp/lp or mc/fc prefix)
.         if "`st'" == "joint_ae" | strpos("`st'", "joint_ae_") == 1 {
147.             if "`st'" == "joint_ae" {
148.                 local pfx_len   1
149.                 local hi_pfx    y
150.                 local lo_pfx    o
151.                 local hi_leg    "Early-Career"
152.                 local lo_leg    "Late-Career"
153.                 local filename_stem joint_ae_paired
154.             }
155.             else {
156.                 local axis : subinstr local st "joint_ae_" "", all
157.                 local pfx_len   2
158.                 local hi_pfx    "${PI_CHAR_HIPFX_`axis'}"
159.                 local lo_pfx    "${PI_CHAR_LOPFX_`axis'}"
160.                 local hi_leg    "${PI_CHAR_HILEG_`axis'}"
161.                 local lo_leg    "${PI_CHAR_LOLEG_`axis'}"
162.                 local filename_stem "joint_ae_`axis'_paired"
163.             }
164.             local hilo_pos = `pfx_len' + 2
165.             local char_pos = `pfx_len' + 5
166.             foreach yv of local ppml_het_yvars {
167.                 preserve
168.                 use "`resfile'", clear
169.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
170.                 if _N == 0 {
171.                     restore
172.                     continue
173.                 }
174.                 gen str2  pfx_c  = substr(grp, 1, `pfx_len')
175.                 gen str2  hilo_c = substr(grp, `hilo_pos', 2)
176.                 gen str12 char_c = substr(grp, `char_pos', .)
177.                 gen byte  is_hi_side = (pfx_c == "`hi_pfx'")
178.                 gen char_idx = .
179.                 local ii = 0
180.                 foreach a of global IC_ALIASES {
181.                     local ++ii
182.                     qui replace char_idx = `ii' if char_c == "`a'"
183.                 }
184.                 qui drop if mi(char_idx)
185.                 if _N == 0 {
186.                     restore
187.                     continue
188.                 }
189.                 qui sum char_idx
190.                 local nchars = r(max)
191.                 * Row layout: within-pair (blue+orange same hi/lo) 0.6;
.                 * between hi-row and lo-row of same char = 0.8; between
.                 * chars = 1.2. Base spacing 3.2 per char.
.                 gen double y_group = (`nchars' + 1 - char_idx) * 3.2
192.                 gen double y_pos   = y_group ///
>                     + cond(hilo_c == "hi" & is_hi_side == 1,  1.0, ///
>                       cond(hilo_c == "hi" & is_hi_side == 0,  0.4, ///
>                       cond(hilo_c == "lo" & is_hi_side == 1, -0.4, -1.0)))
193.                 gen ub = post_b + 1.96*post_se
194.                 gen lb = post_b - 1.96*post_se
195. 
.                 local ylabs
196.                 forvalues i = 1/`nchars' {
197.                     qui levelsof char_c if char_idx == `i', local(cname) clean
198.                     local clbl = "${LBL_ic_`cname'}"
199.                     if "`clbl'" == "" local clbl "`cname'"
200.                     local base = (`nchars' + 1 - `i') * 3.2
201.                     local pos_hi = `base' + 1.0
202.                     local pos_lo = `base' - 0.4
203.                     local ylabs `"`ylabs' `pos_hi' "High `clbl'""'
204.                     local ylabs `"`ylabs' `pos_lo' "Low `clbl'""'
205.                 }
206. 
.                 qui sum lb
207.                 local xmin = floor(r(min)/0.5)*0.5
208.                 qui sum ub
209.                 local xmax = ceil(r(max)/0.5)*0.5
210. 
.                 tw rcap ub lb y_pos if is_hi_side == 1, horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>                    scatter y_pos post_b if is_hi_side == 1, mcolor(ebblue) msize(small)              || ///
>                    rcap ub lb y_pos if is_hi_side == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                    scatter y_pos post_b if is_hi_side == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(order(2 "`hi_leg'" 4 "`lo_leg'") pos(6) ring(1) rows(1) span size(small)) ///
>                      ysize(`=max(8, `nchars'*1.6)') xsize(9) ///
>                      yscale(range(2.1 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
211.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`filename_stem'`suf'.pdf", ///
>                     replace
212.                 di as text "wrote `filename_stem' coefplot for `yv' `spec_tag'"
213.                 restore
214.             }
215.         }
216. 
.         * ----- Age x baseline-productivity 2x2 (no inst char).
.         *       Two rows: High Baseline Productivity / Low Baseline Productivity.
.         *       Blue = Early-Career, Orange = Late-Career.
.         if "`st'" == "joint_agepr" {
217.             foreach yv of local ppml_het_yvars {
218.                 preserve
219.                 use "`resfile'", clear
220.                 keep if yvar == "`yv'" & split_type == "joint_agepr" & spec == "`spec_tag'"
221.                 if _N == 0 {
222.                     restore
223.                     continue
224.                 }
225.                 gen byte is_young = (substr(grp, 1, 1) == "y")
226.                 gen str2 pr_c    = substr(grp, 3, 2)
227.                 gen double y_pos = cond(pr_c == "hp",  2, 1) ///
>                                    + cond(is_young == 1,  0.3, -0.3)
228.                 gen ub = post_b + 1.96*post_se
229.                 gen lb = post_b - 1.96*post_se
230. 
.                 local ylabs `"2 "High Baseline Productivity" 1 "Low Baseline Productivity""'
231. 
.                 qui sum lb
232.                 local xmin = floor(r(min)/0.5)*0.5
233.                 qui sum ub
234.                 local xmax = ceil(r(max)/0.5)*0.5
235. 
.                 tw rcap ub lb y_pos if is_young == 1, horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>                    scatter y_pos post_b if is_young == 1, mcolor(ebblue) msize(small)              || ///
>                    rcap ub lb y_pos if is_young == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                    scatter y_pos post_b if is_young == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(order(2 "Early-Career" 4 "Late-Career") pos(6) ring(1) rows(1) span size(small)) ///
>                      ysize(5) xsize(7) ///
>                      yscale(range(0.62 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
236.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_joint_agepr`suf'.pdf", ///
>                     replace
237.                 di as text "wrote joint_agepr coefplot for `yv' `spec_tag'"
238.                 restore
239.             }
240.         }
241. 
.         * ----- Generic 4-cell joint coefplots (PI-split x PI-split): one row
.         *       per cell, first-axis pairs blocked. Cells ordered hi-hi,
.         *       hi-lo, lo-hi, lo-lo; lab1/lab2 = first axis, lab3/lab4 =
.         *       second axis.
.         local generic_jts joint_agenih joint_prnih joint_ageteam joint_tmnih joint_tmpr ///
>                           joint_agenet joint_agelab joint_agecrwd joint_agemsa
242.         if strpos(" `generic_jts' ", " `st' ") > 0 {
243.             if "`st'" == "joint_agenih" {
244.                 local cells y_hn y_ln o_hn o_ln
245.                 local lab1 "Early-Career Scientists"
246.                 local lab2 "Late-Career Scientists"
247.                 local lab3 "More NIH Funding at Baseline"
248.                 local lab4 "Less NIH Funding at Baseline"
249.             }
250.             if "`st'" == "joint_agenet" {
251.                 local cells y_bn y_sn o_bn o_sn
252.                 local lab1 "Early-Career Scientists"
253.                 local lab2 "Late-Career Scientists"
254.                 local lab3 "Larger Coauthor Network"
255.                 local lab4 "Smaller Coauthor Network"
256.             }
257.             if "`st'" == "joint_agelab" {
258.                 local cells y_nl y_el o_nl o_el
259.                 local lab1 "Early-Career Scientists"
260.                 local lab2 "Late-Career Scientists"
261.                 local lab3 "Newer Labs"
262.                 local lab4 "Established Labs"
263.             }
264.             if "`st'" == "joint_agecrwd" {
265.                 local cells y_ci y_si o_ci o_si
266.                 local lab1 "Early-Career Scientists"
267.                 local lab2 "Late-Career Scientists"
268.                 local lab3 "More Same-Field PIs at Inst."
269.                 local lab4 "Fewer Same-Field PIs at Inst."
270.             }
271.             if "`st'" == "joint_agemsa" {
272.                 local cells y_bmsa y_smsa o_bmsa o_smsa
273.                 local lab1 "Early-Career Scientists"
274.                 local lab2 "Late-Career Scientists"
275.                 local lab3 "Larger MSAs"
276.                 local lab4 "Smaller MSAs"
277.             }
278.             if "`st'" == "joint_prnih" {
279.                 local cells hp_hn hp_ln lp_hn lp_ln
280.                 local lab1 "More Productive at Baseline"
281.                 local lab2 "Less Productive at Baseline"
282.                 local lab3 "More NIH Funding at Baseline"
283.                 local lab4 "Less NIH Funding at Baseline"
284.             }
285.             if "`st'" == "joint_ageteam" {
286.                 local cells y_bt y_sm o_bt o_sm
287.                 local lab1 "Early-Career Scientists"
288.                 local lab2 "Late-Career Scientists"
289.                 local lab3 "Larger Team Size"
290.                 local lab4 "Smaller Team Size"
291.             }
292.             if "`st'" == "joint_tmnih" {
293.                 local cells bt_hn bt_ln sm_hn sm_ln
294.                 local lab1 "Larger Team Size"
295.                 local lab2 "Smaller Team Size"
296.                 local lab3 "More NIH Funding at Baseline"
297.                 local lab4 "Less NIH Funding at Baseline"
298.             }
299.             if "`st'" == "joint_tmpr" {
300.                 local cells bt_hp bt_lp sm_hp sm_lp
301.                 local lab1 "Larger Team Size"
302.                 local lab2 "Smaller Team Size"
303.                 local lab3 "More Productive at Baseline"
304.                 local lab4 "Less Productive at Baseline"
305.             }
306.             foreach yv of local ppml_het_yvars {
307.                 preserve
308.                 use "`resfile'", clear
309.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
310.                 if _N == 0 {
311.                     restore
312.                     continue
313.                 }
314.                 gen double y_pos = .
315.                 replace y_pos = 4.7 if grp == word("`cells'", 1)
316.                 replace y_pos = 3.7 if grp == word("`cells'", 2)
317.                 replace y_pos = 2   if grp == word("`cells'", 3)
318.                 replace y_pos = 1   if grp == word("`cells'", 4)
319.                 drop if mi(y_pos) | mi(post_b)
320.                 if _N == 0 {
321.                     restore
322.                     continue
323.                 }
324.                 gen ub = post_b + 1.96*post_se
325.                 gen lb = post_b - 1.96*post_se
326. 
.                 qui sum lb
327.                 local xmin = floor(r(min)/0.5)*0.5
328.                 qui sum ub
329.                 local xmax = ceil(r(max)/0.5)*0.5
330. 
.                 tw rcap ub lb y_pos, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>                    scatter y_pos post_b, mcolor(ebblue) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(4.7 `""`lab1'" "`lab3'""' ///
>                             3.7 `""`lab1'" "`lab4'""' ///
>                             2   `""`lab2'" "`lab3'""' ///
>                             1   `""`lab2'" "`lab4'""', ///
>                             angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(off) ///
>                      ysize(5) xsize(7) ///
>                      yscale(range(0.9 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
331.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'`suf'.pdf", ///
>                     replace
332.                 di as text "wrote `st' coefplot for `yv' `spec_tag'"
333.                 restore
334.             }
335.         }
336.         }  // close foreach spec_tag
337.     }
338. end

