. program add_het_splits
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     use ../external/prepped_samples/es_`samp'`suf', clear
  8. 
.     cap drop athr_indicator
  9.     bys athr_id : gen athr_indicator = _n == 1
 10. 
.     * Neither source alone is complete: the raw pull misses works OpenAlex has
.     * reassigned to other author ids since the corpus snapshot, and the corpus
.     * is journal- and US-R1/R2-truncated. Earliest observation in either wins.
.     if "$LAB_CLOCK" == "athr_age" {
 11.         merge m:1 athr_id using ../external/athr_age/athr_age, ///
>             keep(1 3) keepusing(first_last) nogen
 12.         cap confirm variable min_year_nonsolo
 13.         if !_rc replace min_year = min(first_last, min_year_nonsolo)
 14.         else {
 15.             di as error "add_het_splits `samp'`suf': min_year_nonsolo not in panel -- lab clock = first_last only"
 16.             replace min_year = first_last
 17.         }
 18.         qui count if athr_indicator == 1 & mi(min_year)
 19.         di as text "add_het_splits `samp'`suf': lab clock = min(athr_age first_last, min_year_nonsolo); " ///
>             r(N) " PIs with neither drop from lab-age splits"
 20.         drop first_last
 21.     }
 22. 
.     qui sum pre_ppr_cnt_sum if athr_indicator == 1, d
 23.     local ppr_cut = r(p50)
 24.     gen high_pre_ppr = pre_ppr_cnt_sum >= `ppr_cut' if !mi(pre_ppr_cnt_sum)
 25.     gen low_pre_ppr  = pre_ppr_cnt_sum <  `ppr_cut' if !mi(pre_ppr_cnt_sum)
 26. 
.     * young/old split on first last-author year (min_year), not career age
.     qui sum min_year if athr_indicator == 1, d
 27.     local lastyr_med = r(p50)
 28.     di as text "add_het_splits `samp'`suf' min_year (first last-author yr) median = `lastyr_med'"
 29.     gen young = min_year >  `lastyr_med' if !mi(min_year)
 30.     gen old   = min_year <= `lastyr_med' if !mi(min_year)
 31. 
.     * Same split on the first last-author year that excludes solo-author papers.
.     cap confirm variable min_year_nonsolo
 32.     if !_rc {
 33.         qui sum min_year_nonsolo if athr_indicator == 1, d
 34.         local nsyr_med = r(p50)
 35.         qui count if athr_indicator == 1 & mi(min_year_nonsolo)
 36.         di as text "add_het_splits `samp'`suf' min_year_nonsolo median = `nsyr_med'; " r(N) " PIs with no non-solo last-author paper"
 37.         gen byte young_ns = min_year_nonsolo >  `nsyr_med' if !mi(min_year_nonsolo)
 38.         gen byte old_ns   = min_year_nonsolo <= `nsyr_med' if !mi(min_year_nonsolo)
 39.         gen lab_age_ns_2014 = 2014 - min_year_nonsolo
 40.     }
 41.     else di as error "add_het_splits `samp'`suf': min_year_nonsolo not in panel -- young_ns/old_ns SKIPPED (rerun reduced_form/code/analysis.do)."
 42. 
.     * Same split on the first publication ever, any author position (min_year_any).
.     cap confirm variable min_year_any
 43.     if !_rc {
 44.         qui sum min_year_any if athr_indicator == 1, d
 45.         local anyyr_med = r(p50)
 46.         di as text "add_het_splits `samp'`suf' min_year_any (first pub ever) median = `anyyr_med'"
 47.         gen byte young_any = min_year_any >  `anyyr_med' if !mi(min_year_any)
 48.         gen byte old_any   = min_year_any <= `anyyr_med' if !mi(min_year_any)
 49.     }
 50.     else di as error "add_het_splits `samp'`suf': min_year_any not in panel -- young_any/old_any SKIPPED."
 51. 
.     gen r1 = type == "r1" if !mi(type)
 52.     gen r2 = type == "r2" if !mi(type)
 53. 
.     * Baseline NIH scale: pre-2014 means of the derived author-year measures
.     * (n_grants, nih_total_cost from derived/nih/match_pi_athr). Both are missing
.     * for PIs excluded upstream, so the NIH splits estimate on the NIH sample.
.     local nih_src   n_grants nih_total_cost
 54.     local nih_alias nihg     nihd
 55.     forvalues i = 1/2 {
 56.         local src : word `i' of `nih_src'
 57.         local alias : word `i' of `nih_alias'
 58.         cap confirm variable `src'
 59.         if _rc {
 60.             di as error "add_het_splits `samp'`suf': `src' not in panel -- `alias' split SKIPPED (rerun reduced_form/restrict_samp)."
 61.             continue
 62.         }
 63.         gen pre_`alias'_yr = `src' if year < 2014
 64.         bys athr_id: egen pre_`alias' = mean(pre_`alias'_yr)
 65.         drop pre_`alias'_yr
 66.         local src pre_`alias'
 67.         qui sum `src' if athr_indicator == 1, d
 68.         local nih_n = r(N)
 69.         local nih_p50 = r(p50)
 70.         di as text "add_het_splits `samp'`suf' `alias' N_pi=`nih_n' p50=`nih_p50'"
 71.         gen byte high_`alias' = `src' >= `nih_p50' if !mi(`src')
 72.         gen byte low_`alias'  = `src' <  `nih_p50' if !mi(`src')
 73.     }
 74. 
.     * Young-only NIH funding split: pre_nihd median re-cut WITHIN young
.     * NIH-matched PIs. Dummies stay missing for old PIs, so every fit using
.     * the pair estimates on the young sample only.
.     cap confirm variable pre_nihd
 75.     if !_rc {
 76.         qui sum pre_nihd if athr_indicator == 1 & young == 1, d
 77.         local ynih_n = r(N)
 78.         local ynih_med = r(p50)
 79.         local ynih_p25 = r(p25)
 80.         local ynih_p75 = r(p75)
 81.         di as text "add_het_splits `samp'`suf' young-only nihd N_pi=`ynih_n' p25=`ynih_p25' p50=`ynih_med' p75=`ynih_p75'"
 82.         gen byte yhigh_nihd = pre_nihd >= `ynih_med' if !mi(pre_nihd) & young == 1
 83.         gen byte ylow_nihd  = pre_nihd <  `ynih_med' if !mi(pre_nihd) & young == 1
 84.         * Q1-vs-Q4 tails of the same young-only distribution; middle 50%
.         * left missing so pair fits compare tails only.
.         gen byte yq4_nihd = pre_nihd >= `ynih_p75' if !mi(pre_nihd) & young == 1 ///
>                             & (pre_nihd >= `ynih_p75' | pre_nihd <= `ynih_p25')
 85.         gen byte yq1_nihd = 1 - yq4_nihd
 86.     }
 87. 
.     * Age split restricted to PIs matched to RePORTER (n_grants non-missing).
.     * Dummies stay missing off the NIH sample, so every fit using them drops
.     * unmatched PIs rather than pooling them into the base category.
.     * nih_matched comes from reduced_form (RePORTER PI-name match). Fall back to
.     * an n_grants-based proxy only if the panel predates it.
.     cap drop nih_pi
 88.     cap confirm variable nih_matched
 89.     if !_rc {
 90.         bys athr_id: egen byte nih_pi = max(nih_matched == 1)
 91.     }
 92.     else {
 93.         cap confirm variable n_grants
 94.         if !_rc bys athr_id: egen byte nih_pi = max(!mi(n_grants))
 95.     }
 96.     cap confirm variable nih_pi
 97.     if !_rc {
 98.         qui count if nih_pi == 1 & athr_indicator == 1
 99.         di as text "add_het_splits `samp'`suf' NIH-matched PIs = " r(N)
100.         gen byte young_nih = young if nih_pi == 1 & !mi(young)
101.         gen byte old_nih   = old   if nih_pi == 1 & !mi(old)
102.     }
103.     else di as error "add_het_splits `samp'`suf': no NIH match flag in panel -- young_nih/old_nih SKIPPED."
104. 
.     cap confirm variable msa_size
105.     if !_rc {
106.         gen msa_size_2014 = msa_size if year == 2014
107.         bys athr_id: egen msa_size_at = max(msa_size_2014)
108.         drop msa_size_2014
109.     }
110. 
.     merge m:1 inst_id using ../temp/inst_chars_pre, keep(1 3) nogen
111.     cap drop inst_indicator
112.     bys inst_id : gen inst_indicator = _n == 1
113.     foreach a of global IC_ALIASES {
114.         cap confirm variable ic_`a'
115.         if _rc continue
116.         * Inst-weighted cutoffs (each institution counts once).
.         qui sum ic_`a' if inst_indicator == 1, d
117.         local ic_n = r(N)
118.         local ic_p50 = r(p50)
119.         local ic_p25 = r(p25)
120.         local ic_p75 = r(p75)
121.         di as text "add_het_splits `samp'`suf' ic_`a' inst-wtd N_inst=`ic_n' p25=`ic_p25' p50=`ic_p50' p75=`ic_p75'"
122.         gen byte hi_`a'  = ic_`a' >= `ic_p50' if !mi(ic_`a')
123.         gen byte lo_`a'  = ic_`a' <  `ic_p50' if !mi(ic_`a')
124.         gen byte q1_`a'  = ic_`a' <= `ic_p25' if !mi(ic_`a')
125.         gen byte q4_`a'  = ic_`a' >= `ic_p75' if !mi(ic_`a')
126.         gen byte mid_`a' = (ic_`a' > `ic_p25' & ic_`a' < `ic_p75') if !mi(ic_`a')
127.         * PI-weighted cutoffs (each PI counts once; big institutions dominate).
.         qui sum ic_`a' if athr_indicator == 1, d
128.         local ic_p25w = r(p25)
129.         local ic_p50w = r(p50)
130.         local ic_p75w = r(p75)
131.         di as text "add_het_splits `samp'`suf' ic_`a' pi-wtd N_pi=" r(N) " p25=`ic_p25w' p50=`ic_p50w' p75=`ic_p75w'"
132.         gen byte hiw_`a'  = ic_`a' >= `ic_p50w' if !mi(ic_`a')
133.         gen byte low_`a'  = ic_`a' <  `ic_p50w' if !mi(ic_`a')
134.         gen byte q1w_`a'  = ic_`a' <= `ic_p25w' if !mi(ic_`a')
135.         gen byte q4w_`a'  = ic_`a' >= `ic_p75w' if !mi(ic_`a')
136.         gen byte midw_`a' = (ic_`a' > `ic_p25w' & ic_`a' < `ic_p75w') if !mi(ic_`a')
137.     }
138. 
.     local pi_q_source pre_ppr_cnt_sum pre_nihg pre_nihd
139.     local pi_q_alias  pre_ppr        nihg     nihd
140.     local nq : word count `pi_q_alias'
141.     forvalues i = 1/`nq' {
142.         local src : word `i' of `pi_q_source'
143.         local alias : word `i' of `pi_q_alias'
144.         cap confirm variable `src'
145.         if _rc {
146.             di as error "add_het_splits `samp'`suf': `src' unavailable -- `alias' quartiles SKIPPED."
147.             continue
148.         }
149.         qui sum `src' if athr_indicator == 1, d
150.         local p25 = r(p25)
151.         local p75 = r(p75)
152.         di as text "add_het_splits `samp'`suf' `alias' p25=`p25' p75=`p75'"
153.         gen byte q1_`alias'  = `src' <= `p25' if !mi(`src')
154.         gen byte q4_`alias'  = `src' >= `p75' if !mi(`src')
155.         gen byte mid_`alias' = (`src' > `p25' & `src' < `p75') if !mi(`src')
156.     }
157. 
.     * Joint young x hiw_<char> 2x2 for every ic char (PI-weighted median cutoff).
.     foreach a of global IC_ALIASES {
158.         cap confirm variable hiw_`a'
159.         if _rc continue
160.         gen byte y_hi_`a' = (young == 1 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
161.         gen byte y_lo_`a' = (young == 1 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
162.         gen byte o_hi_`a' = (young == 0 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
163.         gen byte o_lo_`a' = (young == 0 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
164.     }
165. 
.     * Non-funding mechanism splits for the young result.
.     * (1) Lab age: years since first last-authored paper (min_year), distinct
.     * from career age (min_year_any, which age_2014 is built on) -- lab
.     * capital vintage: recently-started labs have not accumulated equipment.
.     cap confirm variable min_year
166.     if !_rc {
167.         gen lab_age_2014 = 2014 - min_year
168.         qui sum lab_age_2014 if athr_indicator == 1, d
169.         local lab_med = r(p50)
170.         di as text "add_het_splits `samp'`suf' lab_age median = `lab_med'"
171.         gen byte new_lab = lab_age_2014 <  `lab_med' if !mi(lab_age_2014)
172.         gen byte est_lab = lab_age_2014 >= `lab_med' if !mi(lab_age_2014)
173.         gen byte lab_lt10  = lab_age_2014 < 10             if !mi(lab_age_2014)
174.         gen byte lab_10_20 = inrange(lab_age_2014, 10, 19) if !mi(lab_age_2014)
175.         gen byte lab_20p   = lab_age_2014 >= 20            if !mi(lab_age_2014)
176.         qui sum lab_age_2014 if athr_indicator == 1, d
177.         di as text "add_het_splits `samp'`suf' lab_age quartile cuts: p25=" r(p25) " p50=" r(p50) " p75=" r(p75)
178.         xtile _labq_pi = lab_age_2014 if athr_indicator == 1, nq(4)
179.         bys athr_id: egen _labq = max(_labq_pi)
180.         forval q = 1/4 {
181.             gen byte q`q'_labage = _labq == `q' if !mi(_labq)
182.         }
183.         drop _labq_pi _labq
184.     }
185.     * (2) MSA size -- thick local equipment / core-facility market. NOTE
.     * msa_size_at is missing for ~27% of PIs (no 2014 MSA row).
.     cap confirm variable msa_size_at
186.     if !_rc {
187.         qui sum msa_size_at if athr_indicator == 1, d
188.         local msa_med = r(p50)
189.         gen byte big_msa   = msa_size_at >= `msa_med' if !mi(msa_size_at)
190.         gen byte small_msa = msa_size_at <  `msa_med' if !mi(msa_size_at)
191.     }
192. 
.     compress
193.     save ../temp/es_`samp'`suf', replace
194. end

. 
. program event_study_het
  1.     * Split-interaction PPML het regressions (+ OLS if HET_RUN_OLS=1).
.     * Writes ../temp/phet_results_<samp><suf>.dta.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     use ../temp/es_`samp'`suf', clear
 18. 
.     gen rel = year - 2014
 19.     qui sum rel, d
 20.     local abs_lag = abs(r(max))
 21.     local abs_lead = abs(r(min))
 22.     * [H8] only the observed window; unused time dummies removed
.     forval i = 1/`abs_lead' {
 23.         gen int_lead`i'  = exposure      if rel == -`i'
 24.         gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 25.     }
 26.     forval i = 0/`abs_lag' {
 27.         gen int_lag`i'  = exposure      if rel == `i'
 28.         gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 29.     }
 30.     ds int_lead* int_lag* mshr_lead* mshr_lag*
 31.     foreach var in `r(varlist)' {
 32.         replace `var' = 0 if mi(`var')
 33.     }
 34.     local int_leads
 35.     local mshr_leads
 36.     local int_lags
 37.     local mshr_lags
 38.     forval i = 2/`abs_lead' {
 39.         local int_leads int_lead`i' `int_leads'
 40.         local mshr_leads mshr_lead`i' `mshr_leads'
 41.     }
 42.     forval i = 0/`abs_lag' {
 43.         local int_lags `int_lags' int_lag`i'
 44.         local mshr_lags `mshr_lags' mshr_lag`i'
 45.     }
 46.     foreach v in ppr_cnt cite_affl_wt {
 47.         gen ln_`v' = ln(1+`v')
 48.     }
 49. 
.     * Skip dummies that are missing or degenerate (all 0 / all 1) so
.     * downstream loops don't try to fit collinear specs.
.     local het_groups young old young_ns old_ns young_any old_any r1 r2 ///
>                      high_pre_ppr low_pre_ppr high_nihg low_nihg high_nihd low_nihd ///
>                      young_nih old_nih new_lab est_lab big_msa small_msa ///
>                      yhigh_nihd ylow_nihd yq4_nihd yq1_nihd ///
>                      lab_lt10 lab_10_20 lab_20p ///
>                      q1_labage q2_labage q3_labage q4_labage
 50.     * Only groups the active config actually fits get lead/lag interactions.
.     foreach a of global IC_ALIASES {
 51.         local het_groups `het_groups' hiw_`a' low_`a'
 52.         if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' hi_`a' lo_`a'
 53.         if "$HET_RUN_QUARTILES" == "1" {
 54.             local het_groups `het_groups' q1w_`a' midw_`a' q4w_`a'
 55.             if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' q1_`a' mid_`a' q4_`a'
 56.         }
 57.     }
 58.     if "$HET_RUN_QUARTILES" == "1" {
 59.         foreach b of global PI_Q_BASES {
 60.             local het_groups `het_groups' q1_`b' mid_`b' q4_`b'
 61.         }
 62.     }
 63.     global HET_GROUPS_ACTIVE
 64.     foreach grp of local het_groups {
 65.         cap confirm variable `grp'
 66.         if _rc {
 67.             di as text "event_study_het `samp'`suf': dummy `grp' not built -- skipping."
 68.             continue
 69.         }
 70.         qui sum `grp'
 71.         if r(N) == 0 | r(min) == r(max) {
 72.             di as text "event_study_het `samp'`suf': dummy `grp' degenerate -- skipping."
 73.             continue
 74.         }
 75.         foreach v of local int_leads {
 76.             gen `v'_`grp' = `v' * `grp'
 77.         }
 78.         foreach v of local int_lags {
 79.             gen `v'_`grp' = `v' * `grp'
 80.         }
 81.         gen int_lead1_`grp' = int_lead1 * `grp'
 82.         foreach v of local mshr_leads {
 83.             gen `v'_`grp' = `v' * `grp'
 84.         }
 85.         foreach v of local mshr_lags {
 86.             gen `v'_`grp' = `v' * `grp'
 87.         }
 88.         local leads_`grp'
 89.         local lags_`grp'
 90.         local mleads_`grp'
 91.         local mlags_`grp'
 92.         foreach v of local int_leads {
 93.             local leads_`grp' `leads_`grp'' `v'_`grp'
 94.         }
 95.         foreach v of local int_lags {
 96.             local lags_`grp' `lags_`grp'' `v'_`grp'
 97.         }
 98.         foreach v of local mshr_leads {
 99.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
100.         }
101.         foreach v of local mshr_lags {
102.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
103.         }
104.         global HET_GROUPS_ACTIVE `"${HET_GROUPS_ACTIVE} `grp'"'
105.     }
106. 
.     if "$POSITION_OUTCOMES_AVAIL" == "" {
107.         cap confirm variable n_first_ppr
108.         global POSITION_OUTCOMES_AVAIL = cond(_rc == 0, 1, 0)
109.     }
110.     local position_outcomes ""
111.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
112.         local position_outcomes n_middle_ppr avg_position avg_team_size_last avg_team_size_notlast
113.     }
114. 
.     * Pooled DiD building blocks (used by the coefplot-feeding fits below).
.     cap drop post Z_it Z_share_it
115.     gen post       = year >= 2014
116.     gen Z_it       = exposure      * post
117.     gen Z_share_it = mkt_spend_shr * post
118. 
.     local pi_pairs `" "young old" "young_ns old_ns" "young_any old_any" "young_nih old_nih" "r1 r2" "high_pre_ppr low_pre_ppr" "high_nihg low_nihg" "high_nihd low_nihd" "new_lab est_lab" "big_msa small_msa" "yhigh_nihd ylow_nihd" "yq4_nihd yq1_nihd" "'
119.     global DUMMY_PAIRS_MED    `" `pi_pairs' ${IC_PAIRS_MED} "'
120.     * PI-level splits included in both med and med_pi so PI-char coefplots
.     * still emit when HET_INCLUDE_INSTWTD=0 (only PI-weighted median runs).
.     global DUMMY_PAIRS_MED_PW `" `pi_pairs' ${IC_PAIRS_MED_PW} "'
121. 
.     * Skip PPML on avg_* outcomes (conditional means, not counts).
.     local ppml_het_skip avg_position avg_team_size_last avg_team_size_notlast
122. 
.     mat drop _all
123.     * Write per-yvar phet_results files (postfile has no append option); combine into
.     * master ../temp/phet_results_<samp><suf>.dta after the loop.
.     local yvar_list ppr_cnt ppr_cnt_nonsolo cite_affl_wt avg_num_coathrs ///
>                     n_grants n_new_grants nih_total_cost ///
>                     `position_outcomes'
124.     if "$DEBUG_YVAR" != "" {
125.         local yvar_list $DEBUG_YVAR
126.         di as text "DEBUG_YVAR set -- restricting yvar loop to: $DEBUG_YVAR"
127.     }
128. 
.     foreach yvar of local yvar_list {
129.         tempname ph_handle
130.         postfile `ph_handle' str30 yvar str24 grp str12 spec str20 split_type ///
>             double(post_b post_se pre_b pre_se N r2_p) ///
>             using "../temp/phet_results_`samp'`suf'_`yvar'", replace
131.         local gap 0.5
132.         if regexm("`yvar'", "^cite_affl_wt") local gap 1
133.         local ppml_ytit "Output-Cost Elasticity"
134.         if "`yvar'" == "n_grants"       local ppml_ytit "{&Delta} Log Expected Active NIH Research Grants"
135.         if "`yvar'" == "n_new_grants"   local ppml_ytit "{&Delta} Log Expected New NIH Research Grants"
136.         if "`yvar'" == "nih_total_cost" local ppml_ytit "{&Delta} Log Expected NIH Award Dollars"
137. 
.         * ---- OLS median het (gated by $HET_RUN_OLS, headline outcomes only)
.         * leads_g1/lags_g1 are the differential vs the dummy=0 (`g2') group
.         * absorbed by un-interacted int_lead/int_lag.
.         if "$HET_RUN_OLS" == "1" & inlist("`yvar'", "ppr_cnt", "cite_affl_wt") {
138.             foreach pair of global DUMMY_PAIRS_MED {
139.                 local g1: word 1 of `pair'
140.                 local g2: word 2 of `pair'
141.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
142.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
143.                 local g1_label = "${LBL_`g1'}"
144.                 if "`g1_label'" == "" local g1_label "`g1'"
145.                 local mshr_ctrls `mshr_leads' `mshr_lags' `mleads_`g1'' `mlags_`g1''
146.                 local plot_suf "_mshrctrl"
147.                 cap drop PT_`g1'
148.                 gen PT_`g1' = post * `g1'
149.                 cap noi reghdfe `yvar' `int_leads' `int_lags' ///
>                                `leads_`g1'' `lags_`g1'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
150.                 local rc = _rc
151.                 if `rc' {
152.                     di as error "event_study_het `samp'`suf' `yvar' `g1' failed (rc=`rc'); skipping."
153.                     continue
154.                 }
155.                 gunique athr_id if e(sample) & `g1' == 1
156.                 local num_athrs = r(unique)
157.                 gunique inst_id if e(sample) & `g1' == 1
158.                 local num_insts = r(unique)
159.                 sum `yvar' if rel <= -1 & e(sample) & `g1' == 1, d
160.                 local pre_mean : dis %4.3f r(mean)
161.                 preserve
162.                 cap mat drop es
163.                 foreach var in `leads_`g1'' `lags_`g1'' int_lead1_`g1' {
164.                     if "`var'" == "int_lead1_`g1'" {
165.                         mat row = 0,0
166.                     }
167.                     else {
168.                         mat row = _b[`var'], _se[`var']
169.                     }
170.                     mat es = nullmat(es) \ row
171.                 }
172.                 svmat es
173.                 keep es1 es2
174.                 drop if mi(es1)
175.                 rename (es1 es2) (b se)
176.                 gen ub = b + 1.96*se
177.                 sum ub, d
178.                 local ymax = round(r(max),`gap')
179.                 gen lb = b - 1.96*se
180.                 sum lb, d
181.                 local ymin = round(r(min),`gap')
182.                 if `ymin' > 0 local ymin = 0
183.                 gen rel = -`abs_lead' if _n == 1
184.                 replace rel = rel[_n-1]+1 if _n > 1
185.                 replace rel = rel + 1 if rel >= -1
186.                 replace rel = -1 if rel == `abs_lag' + 1
187.                 gen year = rel + 2014
188.                 hashsort rel
189.                 local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
190.                 local es_sub subtitle("`g1_label'", pos(11) size(small))
191.                 local fdir ../output/figures/`samp'
192.                 foreach fmode of global FIG_MODES {
193.                     if "`fmode'" == "paper" {
194.                         local stats_leg legend(off)
195.                         local es_sub
196.                         local fdir ../output/figures/`samp'/paper
197.                         cap mkdir "`fdir'"
198.                     }
199.                     tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>                       scatter b year, mcolor(ebblue) || ///
>                     scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                       xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                       ytitle("Exposure x Post") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`gap')`ymax') ///
>                       `es_sub' ///
>                       `stats_leg' ///
>                       yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
200.                     graph export `fdir'/es_`yvar'`suf'_`g1'`plot_suf'.pdf, replace
201.                 }
202.                 save ../temp/es_`yvar'`suf'_`g1'`plot_suf', replace
203.                 restore
204.             }
205. 
.         }
206. 
.         * ---- PPML heterogeneity ----
.         * Posts "mshrctrl": joint pooled DiD with fully-interacted Z_it and Z_share_it
.         * on the full sample. grp coefficient = _b[Z_grp]; matches ppml_pdid_het_binscatter.
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
207.             cap mkdir "../output/figures/`samp'/es_ppml"
208.             * ---- PPML median split (inst-weighted + PI-weighted variants) ----
.             local mmethods pw
209.             if "$HET_INCLUDE_INSTWTD" == "1" local mmethods inst pw
210.             foreach mmethod of local mmethods {
211.             local pairs_current
212.             if "`mmethod'" == "inst" {
213.                 foreach pair of global DUMMY_PAIRS_MED {
214.                     local pairs_current `"`pairs_current' `"`pair'"' "'
215.                 }
216.                 local st_tag "med"
217.                 local mplot_suf "_ppml_mshrctrl"
218.             }
219.             else {
220.                 foreach pair of global DUMMY_PAIRS_MED_PW {
221.                     local pairs_current `"`pairs_current' `"`pair'"' "'
222.                 }
223.                 local st_tag "med_pi"
224.                 local mplot_suf "_ppml_medpi_mshrctrl"
225.             }
226.             foreach pair of local pairs_current {
227.                 local g1: word 1 of `pair'
228.                 local g2: word 2 of `pair'
229.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
230.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
231. 
.                 * --- Pooled-DiD PPML with fully-interacted Z and share; posted as "mshrctrl" ---
.                 * [H11] PT_`g1' absorbs the group-level post shift; `g2' x post is the base
.                 cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
232.                 gen Z_`g1' = Z_it       * `g1'
233.                 gen Z_`g2' = Z_it       * `g2'
234.                 gen S_`g1' = Z_share_it * `g1'
235.                 gen S_`g2' = Z_share_it * `g2'
236.                 gen PT_`g1' = post * `g1'
237.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
238.                 local rc = _rc
239.                 if `rc' {
240.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
241.                     continue
242.                 }
243.                 local Nppml = e(N)
244.                 local r2ppml = e(r2_p)
245.                 foreach grp in `g1' `g2' {
246.                     gunique athr_id if e(sample) & `grp' == 1
247.                     local num_athrs = r(unique)
248.                     gunique inst_id if e(sample) & `grp' == 1
249.                     local num_insts = r(unique)
250.                     local b_post  = _b[Z_`grp']
251.                     local se_post = _se[Z_`grp']
252.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
253.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
254.                 }
255. 
.                 cap noi lincom Z_`g1' - Z_`g2'
256.                 if !_rc {
257.                     local b_diff  = r(estimate)
258.                     local se_diff = r(se)
259.                     local p_diff  = r(p)
260.                     di as text "pooled-DiD int PPML DIFF `samp'`suf' `yvar' `g1'-`g2' `st_tag': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
261.                     post `ph_handle' ("`yvar'") ("`g1'_diff") ("mshrctrl") ("`st_tag'_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
262.                 }
263. 
.                 * --- Joint event-study PPML for per-group ES PDFs only (not posted) ---
.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' `mleads_`g2'' `mlags_`g2''
264.                 local plot_suf "`mplot_suf'"
265.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g2'' `lags_`g2'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
266.                 if _rc {
267.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
268.                     continue
269.                 }
270.                 foreach grp in `g1' `g2' {
271.                     local grp_label = "${LBL_`grp'}"
272.                     if "`grp_label'" == "" local grp_label "`grp'"
273.                     gunique athr_id if e(sample) & `grp' == 1
274.                     local num_athrs = r(unique)
275.                     gunique inst_id if e(sample) & `grp' == 1
276.                     local num_insts = r(unique)
277.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
278.                     local pre_mean : dis %4.3f r(mean)
279.                     preserve
280.                     cap mat drop es
281.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
282.                         if "`var'" == "int_lead1_`grp'" {
283.                             mat row = 0,0
284.                         }
285.                         else {
286.                             mat row = _b[`var'], _se[`var']
287.                         }
288.                         mat es = nullmat(es) \ row
289.                     }
290.                     svmat es
291.                     keep es1 es2
292.                     drop if mi(es1)
293.                     rename (es1 es2) (b se)
294.                     local pgap 0.3
295.                     gen ub = b + 1.96*se
296.                     gen lb = b - 1.96*se
297.                     local ymax = 1.5
298.                     local ymin = -3
299.                     gen rel = -`abs_lead' if _n == 1
300.                     replace rel = rel[_n-1]+1 if _n > 1
301.                     replace rel = rel + 1 if rel >= -1
302.                     replace rel = -1 if rel == `abs_lag' + 1
303.                     gen year = rel + 2014
304.                     hashsort rel
305.                     local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
306.                     local es_sub subtitle("`grp_label'", pos(11) size(small))
307.                     local fdir ../output/figures/`samp'/es_ppml
308.                     foreach fmode of global FIG_MODES {
309.                         if "`fmode'" == "paper" {
310.                             local stats_leg legend(off)
311.                             local es_sub
312.                             local fdir ../output/figures/`samp'/es_ppml/paper
313.                             cap mkdir "`fdir'"
314.                         }
315.                         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                           scatter b year, mcolor(ebblue) || ///
>                         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                           xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                           ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ///
>                           `es_sub' ///
>                           `stats_leg' ///
>                           yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
316.                         graph export `fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
317.                     }
318.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
319.                     restore
320.                 }
321.             }
322.             }  // close foreach mmethod
323. 
.             * ---- Multi-group lab-age splits: 3-way (<10/10-19/20+) and quartiles ----
.             foreach aspec in age3 ageq4 {
324.                 if "`aspec'" == "age3"  local agrps lab_lt10 lab_10_20 lab_20p
325.                 if "`aspec'" == "ageq4" local agrps q1_labage q2_labage q3_labage q4_labage
326.                 local aok 1
327.                 foreach grp of local agrps {
328.                     if strpos(" ${HET_GROUPS_ACTIVE} ", " `grp' ") == 0 local aok 0
329.                 }
330.                 if `aok' {
331.                 * [H11] the last (most senior) group x post is the omitted base
.                 local nb : word count `agrps'
332.                 local abase : word `nb' of `agrps'
333.                 local Zs
334.                 local Ss
335.                 local PTs
336.                 foreach grp of local agrps {
337.                     cap drop Z_`grp'
338.                     cap drop S_`grp'
339.                     cap drop PT_`grp'
340.                     gen Z_`grp' = Z_it       * `grp'
341.                     gen S_`grp' = Z_share_it * `grp'
342.                     local Zs `Zs' Z_`grp'
343.                     local Ss `Ss' S_`grp'
344.                     if "`grp'" != "`abase'" {
345.                         gen PT_`grp' = post * `grp'
346.                         local PTs `PTs' PT_`grp'
347.                     }
348.                 }
349.                 cap noi ppmlhdfe `yvar' `Zs' `Ss' `PTs', ///
>                                absorb(`fes') vce(cluster `vce_cl')
350.                 local rc = _rc
351.                 if `rc' {
352.                     di as error "event_study_het `samp'`suf' `yvar' `aspec' pooled-DiD int ppml failed (rc=`rc'); skipping."
353.                 }
354.                 else {
355.                     local Nppml = e(N)
356.                     local r2ppml = e(r2_p)
357.                     foreach grp of local agrps {
358.                         gunique athr_id if e(sample) & `grp' == 1
359.                         local num_athrs = r(unique)
360.                         gunique inst_id if e(sample) & `grp' == 1
361.                         local num_insts = r(unique)
362.                         local b_post  = _b[Z_`grp']
363.                         local se_post = _se[Z_`grp']
364.                         di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `aspec': b=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
365.                         post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`aspec'") ///
>                             (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
366.                     }
367. 
.                     * --- Joint event-study PPML for per-group ES PDFs only (not posted) ---
.                     local all_leads
368.                     local all_lags
369.                     local all_mshr
370.                     foreach grp of local agrps {
371.                         local all_leads `all_leads' `leads_`grp''
372.                         local all_lags  `all_lags'  `lags_`grp''
373.                         local all_mshr  `all_mshr'  `mleads_`grp'' `mlags_`grp''
374.                     }
375.                     local plot_suf "_ppml_`aspec'_mshrctrl"
376.                     cap noi ppmlhdfe `yvar' `all_leads' `all_lags' ///
>                                             `all_mshr' `PTs', ///
>                                             absorb(`fes') vce(cluster `vce_cl')
377.                     if _rc {
378.                         di as error "event_study_het `samp'`suf' `yvar' `aspec' joint ES for PDFs failed; skipping ES plots."
379.                     }
380.                     else {
381.                         foreach grp of local agrps {
382.                             local grp_label = "${LBL_`grp'}"
383.                             if "`grp_label'" == "" local grp_label "`grp'"
384.                             gunique athr_id if e(sample) & `grp' == 1
385.                             local num_athrs = r(unique)
386.                             gunique inst_id if e(sample) & `grp' == 1
387.                             local num_insts = r(unique)
388.                             sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
389.                             local pre_mean : dis %4.3f r(mean)
390.                             preserve
391.                             cap mat drop es
392.                             foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
393.                                 if "`var'" == "int_lead1_`grp'" {
394.                                     mat row = 0,0
395.                                 }
396.                                 else {
397.                                     mat row = _b[`var'], _se[`var']
398.                                 }
399.                                 mat es = nullmat(es) \ row
400.                             }
401.                             svmat es
402.                             keep es1 es2
403.                             drop if mi(es1)
404.                             rename (es1 es2) (b se)
405.                             gen ub = b + 1.96*se
406.                             sum ub, d
407.                             local ymax = round(r(max), 0.1)
408.                             gen lb = b - 1.96*se
409.                             sum lb, d
410.                             local ymin = round(r(min), 0.1)
411.                             if `ymin' > 0 local ymin = 0
412.                             gen rel = -`abs_lead' if _n == 1
413.                             replace rel = rel[_n-1]+1 if _n > 1
414.                             replace rel = rel + 1 if rel >= -1
415.                             replace rel = -1 if rel == `abs_lag' + 1
416.                             gen year = rel + 2014
417.                             hashsort rel
418.                             local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
419.                             local es_sub subtitle("`grp_label'", pos(11) size(small))
420.                             local fdir ../output/figures/`samp'/es_ppml
421.                             foreach fmode of global FIG_MODES {
422.                                 if "`fmode'" == "paper" {
423.                                     local stats_leg legend(off)
424.                                     local es_sub
425.                                     local fdir ../output/figures/`samp'/es_ppml/paper
426.                                     cap mkdir "`fdir'"
427.                                 }
428.                                 tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                                   scatter b year, mcolor(ebblue) || ///
>                                 scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                                   xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                                   ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(0.1)`ymax') ///
>                                   `es_sub' ///
>                                   `stats_leg' ///
>                                   yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
429.                                 graph export `fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
430.                             }
431.                             save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
432.                             restore
433.                         }
434.                     }
435.                 }
436.                 }
437.             }
438. 
.             * ---- PPML quartile split (inst-weighted + PI-weighted variants) ----
.             * Gated by HET_RUN_QUARTILES; off by default per user request.
.             local qmethods
439.             if "$HET_RUN_QUARTILES" == "1" local qmethods pw
440.             if "$HET_RUN_QUARTILES" == "1" & "$HET_INCLUDE_INSTWTD" == "1" local qmethods inst pw
441.             foreach qmethod of local qmethods {
442.             local quart_all
443.             if "`qmethod'" == "inst" {
444.                 foreach pair of global IC_PAIRS_Q {
445.                     local quart_all `"`quart_all' `"`pair'"' "'
446.                 }
447.                 local st_tag "quart"
448.                 local qplot_suf "_ppml_q_mshrctrl"
449.             }
450.             else {
451.                 foreach pair of global IC_PAIRS_Q_PW {
452.                     local quart_all `"`quart_all' `"`pair'"' "'
453.                 }
454.                 local st_tag "quart_pi"
455.                 local qplot_suf "_ppml_qpi_mshrctrl"
456.             }
457.             * PI-continuous quartiles run under BOTH methods (same dummies
.             * either way) so quart and quart_pi coefplots each fill their
.             * pi panel — mirrors pi_pairs in DUMMY_PAIRS_MED / _MED_PW.
.             foreach pair of global PI_PAIRS_Q {
458.                 local quart_all `"`quart_all' `"`pair'"' "'
459.             }
460.             foreach pair of local quart_all {
461.                 local g1: word 1 of `pair'
462.                 local g2: word 2 of `pair'
463.                 * mid-group name: q4w_<char> -> midw_<char>; q4_<base> -> mid_<base>
.                 if substr("`g1'", 1, 4) == "q4w_" {
464.                     local base = substr("`g1'", 5, .)
465.                     local gm "midw_`base'"
466.                 }
467.                 else {
468.                     local base = substr("`g1'", 4, .)
469.                     local gm "mid_`base'"
470.                 }
471.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
472.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
473.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `gm' ") == 0 continue
474. 
.                 * --- Pooled-DiD PPML with fully-interacted Z and share (Q4/Mid/Q1); posted as "mshrctrl" ---
.                 * [H11] Q1 x post is the omitted base
.                 cap drop Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm'
475.                 gen Z_`g1' = Z_it       * `g1'
476.                 gen Z_`g2' = Z_it       * `g2'
477.                 gen Z_`gm' = Z_it       * `gm'
478.                 gen S_`g1' = Z_share_it * `g1'
479.                 gen S_`g2' = Z_share_it * `g2'
480.                 gen S_`gm' = Z_share_it * `gm'
481.                 gen PT_`g1' = post * `g1'
482.                 gen PT_`gm' = post * `gm'
483.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
484.                 local rc = _rc
485.                 if `rc' {
486.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
487.                     continue
488.                 }
489.                 local Nppml = e(N)
490.                 local r2ppml = e(r2_p)
491.                 foreach grp in `g1' `g2' {
492.                     gunique athr_id if e(sample) & `grp' == 1
493.                     local num_athrs = r(unique)
494.                     gunique inst_id if e(sample) & `grp' == 1
495.                     local num_insts = r(unique)
496.                     local b_post  = _b[Z_`grp']
497.                     local se_post = _se[Z_`grp']
498.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
499.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
500.                 }
501. 
.                 * --- Joint event-study PPML for per-group ES PDFs only (not posted) ---
.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' ///
>                                  `mleads_`g2'' `mlags_`g2'' ///
>                                  `mleads_`gm'' `mlags_`gm''
502.                 local plot_suf "`qplot_suf'"
503.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' ///
>                                         `leads_`g2'' `lags_`g2'' ///
>                                         `leads_`gm'' `lags_`gm'' ///
>                                         `mshr_ctrls' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
504.                 if _rc {
505.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
506.                     continue
507.                 }
508.                 foreach grp in `g1' `g2' {
509.                     local grp_label = "${LBL_`grp'}"
510.                     if "`grp_label'" == "" local grp_label "`grp'"
511.                     gunique athr_id if e(sample) & `grp' == 1
512.                     local num_athrs = r(unique)
513.                     gunique inst_id if e(sample) & `grp' == 1
514.                     local num_insts = r(unique)
515.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
516.                     local pre_mean : dis %4.3f r(mean)
517.                     preserve
518.                     cap mat drop es
519.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
520.                         if "`var'" == "int_lead1_`grp'" {
521.                             mat row = 0,0
522.                         }
523.                         else {
524.                             mat row = _b[`var'], _se[`var']
525.                         }
526.                         mat es = nullmat(es) \ row
527.                     }
528.                     svmat es
529.                     keep es1 es2
530.                     drop if mi(es1)
531.                     rename (es1 es2) (b se)
532.                     gen ub = b + 1.96*se
533.                     sum ub, d
534.                     local ymax = round(r(max), 0.1)
535.                     gen lb = b - 1.96*se
536.                     sum lb, d
537.                     local ymin = round(r(min), 0.1)
538.                     if `ymin' > 0 local ymin = 0
539.                     gen rel = -`abs_lead' if _n == 1
540.                     replace rel = rel[_n-1]+1 if _n > 1
541.                     replace rel = rel + 1 if rel >= -1
542.                     replace rel = -1 if rel == `abs_lag' + 1
543.                     gen year = rel + 2014
544.                     hashsort rel
545.                     local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
546.                     local es_sub subtitle("`grp_label'", pos(11) size(small))
547.                     local fdir ../output/figures/`samp'/es_ppml
548.                     foreach fmode of global FIG_MODES {
549.                         if "`fmode'" == "paper" {
550.                             local stats_leg legend(off)
551.                             local es_sub
552.                             local fdir ../output/figures/`samp'/es_ppml/paper
553.                             cap mkdir "`fdir'"
554.                         }
555.                         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                           scatter b year, mcolor(ebblue) || ///
>                         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                           xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                           ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(0.1)`ymax') ///
>                           `es_sub' ///
>                           `stats_leg' ///
>                           yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
556.                         graph export `fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
557.                     }
558.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
559.                     restore
560.                 }
561.             }
562.             }  // close foreach qmethod
563. 
.             * ---- PPML young x hiw_<char> joint 2x2 for every ic char.
.             * One pooled-DiD interaction fit per char; posts 4 rows per char.
.             foreach a of global IC_ALIASES {
564.                 cap confirm variable y_hi_`a'
565.                 if _rc continue
566.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
567.                     cap drop Z_`grp' S_`grp' PT_`grp'
568.                     gen Z_`grp' = Z_it       * `grp'
569.                     gen S_`grp' = Z_share_it * `grp'
570.                     gen PT_`grp' = post * `grp'
571.                 }
572.                 * [H11] o_lo x post is the omitted base (the four PTs sum to post)
.                 cap noi ppmlhdfe `yvar' Z_y_hi_`a' Z_y_lo_`a' Z_o_hi_`a' Z_o_lo_`a' ///
>                                         S_y_hi_`a' S_y_lo_`a' S_o_hi_`a' S_o_lo_`a' ///
>                                         PT_y_hi_`a' PT_y_lo_`a' PT_o_hi_`a', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
573.                 if _rc {
574.                     di as error "event_study_het `samp'`suf' `yvar' joint-ae `a' ppml failed; skipping."
575.                     continue
576.                 }
577.                 local Nppml = e(N)
578.                 local r2ppml = e(r2_p)
579.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
580.                     gunique athr_id if e(sample) & `grp' == 1
581.                     local num_athrs = r(unique)
582.                     gunique inst_id if e(sample) & `grp' == 1
583.                     local num_insts = r(unique)
584.                     local b_post  = _b[Z_`grp']
585.                     local se_post = _se[Z_`grp']
586.                     di as text "joint-ae PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
587.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_ae") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
588.                 }
589.                 * Hi-vs-Lo differential per age; SEs via lincom use full VCE.
.                 foreach age in y o {
590.                     cap noi lincom Z_`age'_hi_`a' - Z_`age'_lo_`a'
591.                     if _rc continue
592.                     local b_diff  = r(estimate)
593.                     local se_diff = r(se)
594.                     local p_diff  = r(p)
595.                     di as text "joint-ae DIFF `samp'`suf' `yvar' `age'_`a': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
596.                     post `ph_handle' ("`yvar'") ("`age'_diff_`a'") ("mshrctrl") ("joint_ae_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
597.                 }
598.             }
599. 
.         }
600.         postclose `ph_handle'
601. 
.         * pdid binscatter + coefplot for this yvar, so PDFs land continuously
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
602.             cap noi ppml_pdid_het_binscatter, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
603.         }
604.         cap noi ppml_het_coefplot, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
605.     }
606. 
.     * Combine per-yvar phet_results files into master (consumed by output_het_tables).
.     preserve
607.     clear
608.     foreach yvar of local yvar_list {
609.         cap append using ../temp/phet_results_`samp'`suf'_`yvar'
610.     }
611.     save ../temp/phet_results_`samp'`suf', replace
612.     restore
613. end

. 
. program ppml_pdid_het_binscatter
  1.     * Joint PPML pooled-DiD FWL binscatter of `yvar' on Z_it, mshr partialled.
.     * Fit ppmlhdfe on FULL sample with fully-interacted Z and share, then
.     * residualize _z_work and Z_grp against the sibling group + shares + FEs.
.     * On grp==1 rows the sibling interactions are 0 so FWL slope = _b[Z_grp].
.     * NOTE: residualization runs on the full sample while the plot keeps
.     * grp==1 rows, so the binned slope approximates the (exactly displayed)
.     * joint-fit coefficient.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     if "`yvar'" == "" local yvar ppr_cnt
  3.     local fes athr_id year
  4.     local vce_cl athr_id
  5.     if "$FE_MODE" == "inst_cluster" {
  6.         local fes inst_id cluster_30 year
  7.         local vce_cl inst_id
  8.     }
  9.     if "$FE_MODE" == "inst_cluster_fldyr" {
 10.         local fes inst_id i.cluster_30#i.year
 11.         local vce_cl inst_id
 12.     }
 13.     local suf ""
 14.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 15.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 16.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 17.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 18.     cap mkdir "../output/figures/`samp'/ppml_pdid_het_bs"
 19. 
.     * [H9] y-axis label per outcome (was hard-coded "Publications")
.     local bs_lbl "`yvar'"
 20.     if "`yvar'" == "ppr_cnt"           local bs_lbl "Publications"
 21.     if "`yvar'" == "cite_affl_wt"      local bs_lbl "Citation-Weighted Output"
 22.     if "`yvar'" == "avg_num_coathrs"   local bs_lbl "Coauthors"
 23.     if "`yvar'" == "n_grants"          local bs_lbl "Active NIH Research Grants"
 24.     if "`yvar'" == "n_new_grants"      local bs_lbl "New NIH Research Grants"
 25.     if "`yvar'" == "nih_total_cost"    local bs_lbl "NIH Award Dollars"
 26.     if "`yvar'" == "n_middle_ppr"      local bs_lbl "Middle-Author Papers"
 27.     if "`yvar'" == "ppr_cnt_nonsolo"   local bs_lbl "Publications (Excl. Solo)"
 28. 
.     local dummy_pairs `" "young old" "young_ns old_ns" "young_any old_any" "young_nih old_nih" "r1 r2" "high_pre_ppr low_pre_ppr" "high_nihg low_nihg" "high_nihd low_nihd" "new_lab est_lab" "big_msa small_msa" "yhigh_nihd ylow_nihd" "yq4_nihd yq1_nihd" 
> ${IC_PAIRS_MED_PW} "'
 29.     if "$HET_INCLUDE_INSTWTD" == "1" local dummy_pairs `" `dummy_pairs' ${IC_PAIRS_MED} "'
 30. 
.     * Load panel once; per-pair vars are cap-dropped and rebuilt in place.
.     preserve
 31.         use ../temp/es_`samp'`suf', clear
 32.         gen post       = year >= 2014
 33.         gen Z_it       = exposure      * post
 34.         gen Z_share_it = mkt_spend_shr * post
 35. 
.         foreach pair of local dummy_pairs {
 36.             local g1 : word 1 of `pair'
 37.             local g2 : word 2 of `pair'
 38. 
.             * HET_GROUPS_ACTIVE (set by event_study_het before this is called)
.             * screens missing AND degenerate dummies — a no-obs group would
.             * crash binscatter and abort the remaining pairs.
.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
 39.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
 40. 
.             * one at a time — a `drop' list is all-or-nothing, and a missing
.             * Z_<grp> would leave _mu/_dvar alive to crash d() below
.             foreach v in Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1' _mu _z_work _dvar _fwlw _y_r _Z_r {
 41.                 cap drop `v'
 42.             }
 43.             gen Z_`g1' = Z_it       * `g1'
 44.             gen Z_`g2' = Z_it       * `g2'
 45.             gen S_`g1' = Z_share_it * `g1'
 46.             gen S_`g2' = Z_share_it * `g2'
 47.             gen PT_`g1' = post * `g1'
 48. 
.             * [H11] PT matches the posted pooled-DiD spec so displayed beta agrees
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
 49.             local rc = _rc
 50.             if `rc' {
 51.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `g1'/`g2' joint failed (rc=`rc'); skipping pair."
 52.                 continue
 53.             }
 54.             local b_`g1'  = _b[Z_`g1']
 55.             local se_`g1' = _se[Z_`g1']
 56.             local b_`g2'  = _b[Z_`g2']
 57.             local se_`g2' = _se[Z_`g2']
 58. 
.             * IRLS working response + FWL weight from the joint fit.
.             predict double _mu, mu
 59.             gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
 60.             gen double _fwlw = _mu if !mi(_mu) & _mu > 0
 61. 
.             foreach grp in `g1' `g2' {
 62.                 local other = cond("`grp'" == "`g1'", "`g2'", "`g1'")
 63. 
.                 foreach v in _y_r _Z_r {
 64.                     cap drop `v'
 65.                 }
 66.                 cap noi qui reghdfe _z_work Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_y_r)
 67.                 if _rc == 0 cap noi qui reghdfe Z_`grp' Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_Z_r)
 68.                 if _rc {
 69.                     di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
 70.                     continue
 71.                 }
 72.                 gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 73.                 local n_pis = r(unique)
 74.                 gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 75.                 local n_insts = r(unique)
 76.                 local b_str  : dis %7.3f `b_`grp''
 77.                 local se_str : dis %7.3f `se_`grp''
 78.                 local bs_note `"note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
 79.                 local fdir ../output/figures/`samp'/ppml_pdid_het_bs
 80.                 foreach fmode of global FIG_MODES {
 81.                     if "`fmode'" == "paper" {
 82.                         local bs_note `"note("{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
 83.                         local fdir ../output/figures/`samp'/ppml_pdid_het_bs/paper
 84.                         cap mkdir "`fdir'"
 85.                     }
 86.                     binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                         xtitle("Exposure x Post") ///
>                         ytitle("{&Delta} Log Expected `bs_lbl'") ysc(titlegap(0) outergap(0)) ///
>                         xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                         msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                         `bs_note' ///
>                         plotregion(margin(sides))
 87.                     graph export ///
>                         `fdir'/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf, ///
>                         replace
 88.                 }
 89.             }
 90.         }
 91. 
.         * ---- Multi-group lab-age splits: joint fit, per-group FWL binscatter ----
.         foreach aspec in age3 ageq4 {
 92.             if "`aspec'" == "age3"  local agrps lab_lt10 lab_10_20 lab_20p
 93.             if "`aspec'" == "ageq4" local agrps q1_labage q2_labage q3_labage q4_labage
 94.             local aok 1
 95.             foreach grp of local agrps {
 96.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `grp' ") == 0 local aok 0
 97.             }
 98.             if `aok' {
 99.             foreach v in _mu _z_work _dvar _fwlw _y_r _Z_r {
100.                 cap drop `v'
101.             }
102.             local nb : word count `agrps'
103.             local abase : word `nb' of `agrps'
104.             local Zs
105.             local Ss
106.             local PTs
107.             foreach grp of local agrps {
108.                 cap drop Z_`grp'
109.                 cap drop S_`grp'
110.                 cap drop PT_`grp'
111.                 gen Z_`grp' = Z_it       * `grp'
112.                 gen S_`grp' = Z_share_it * `grp'
113.                 local Zs `Zs' Z_`grp'
114.                 local Ss `Ss' S_`grp'
115.                 if "`grp'" != "`abase'" {
116.                     gen PT_`grp' = post * `grp'
117.                     local PTs `PTs' PT_`grp'
118.                 }
119.             }
120. 
.             * [H11] PT matches the posted `aspec' pooled-DiD spec (most senior group x post is the base)
.             cap noi ppmlhdfe `yvar' `Zs' `Ss' `PTs', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
121.             local rc = _rc
122.             if `rc' {
123.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `aspec' joint failed (rc=`rc'); skipping."
124.             }
125.             else {
126.                 foreach grp of local agrps {
127.                     local b_`grp'  = _b[Z_`grp']
128.                     local se_`grp' = _se[Z_`grp']
129.                 }
130. 
.                 predict double _mu, mu
131.                 gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
132.                 gen double _fwlw = _mu if !mi(_mu) & _mu > 0
133. 
.                 foreach grp of local agrps {
134.                     local others
135.                     foreach o of local agrps {
136.                         if "`o'" != "`grp'" local others `others' Z_`o'
137.                     }
138.                     foreach v in _y_r _Z_r {
139.                         cap drop `v'
140.                     }
141.                     cap noi qui reghdfe _z_work `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_y_r)
142.                     if _rc == 0 cap noi qui reghdfe Z_`grp' `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_Z_r)
143.                     if _rc {
144.                         di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
145.                         continue
146.                     }
147.                     gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
148.                     local n_pis = r(unique)
149.                     gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
150.                     local n_insts = r(unique)
151.                     local b_str  : dis %7.3f `b_`grp''
152.                     local se_str : dis %7.3f `se_`grp''
153.                     local bs_note `"note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
154.                     local fdir ../output/figures/`samp'/ppml_pdid_het_bs
155.                     foreach fmode of global FIG_MODES {
156.                         if "`fmode'" == "paper" {
157.                             local bs_note `"note("{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
158.                             local fdir ../output/figures/`samp'/ppml_pdid_het_bs/paper
159.                             cap mkdir "`fdir'"
160.                         }
161.                         binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                             xtitle("Exposure x Post") ///
>                             ytitle("{&Delta} Log Expected `bs_lbl'") ysc(titlegap(0) outergap(0)) ///
>                             xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                             msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                             `bs_note' ///
>                             plotregion(margin(sides))
162.                         graph export ///
>                             `fdir'/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf, ///
>                             replace
163.                     }
164.                 }
165.             }
166.             }
167.         }
168.     restore
169. end

. 
. program ppml_age_gradient
  1.     * Age gradient of the pooled-DiD beta: one joint PPML with Z_it and the
.     * share control fully interacted with career-age bins (HET_AGE_NBINS
.     * PI-level quantiles of age_2014), plotted as each bin's beta vs the bin's
.     * mean age. Same spec as the posted "mshrctrl" median splits, K bins
.     * instead of 2.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     cap mkdir "../output/figures/`samp'"
 18. 
.     local yvar_list ppr_cnt cite_affl_wt
 19.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 20.     local ppml_skip avg_position avg_team_size_last avg_team_size_notlast
 21. 
.     use ../temp/es_`samp'`suf', clear
 22.     gen post       = year >= 2014
 23.     gen Z_it       = exposure      * post
 24.     gen Z_share_it = mkt_spend_shr * post
 25. 
.     local K = $HET_AGE_NBINS
 26.     * Two age bases: career age (first any-position pub, +30) writes agegrad_*;
.     * lab age (years since first last-author pub) writes labgrad_*.
.     foreach agevar in age_2014 lab_age_2014 lab_age_ns_2014 {
 27.     cap confirm variable `agevar'
 28.     if _rc {
 29.         di as error "ppml_age_gradient `samp'`suf': `agevar' not in panel -- skipped."
 30.         continue
 31.     }
 32.     local gpfx agegrad
 33.     local gtmp age_gradient
 34.     local gxtit "Career Age in 2014"
 35.     if "`agevar'" == "lab_age_2014" {
 36.         local gpfx labgrad
 37.         local gtmp lab_gradient
 38.         local gxtit "Years Running Lab in 2014"
 39.     }
 40.     if "`agevar'" == "lab_age_ns_2014" {
 41.         local gpfx labnsgrad
 42.         local gtmp lab_ns_gradient
 43.         local gxtit "Years Running Lab in 2014 (Excl. Solo Papers)"
 44.     }
 45.     cap drop agebin
 46.     xtile _agebin_pi = `agevar' if athr_indicator == 1, n(`K')
 47.     bys athr_id: egen agebin = max(_agebin_pi)
 48.     drop _agebin_pi
 49. 
.     local zvars
 50.     local svars
 51.     local bins_used
 52.     forval k = 1/`K' {
 53.         qui count if agebin == `k' & athr_indicator == 1
 54.         if r(N) == 0 {
 55.             di as error "ppml_age_gradient `samp'`suf': age bin `k' empty -- skipped."
 56.             continue
 57.         }
 58.         cap drop Z_a`k'
 59.         cap drop S_a`k'
 60.         gen Z_a`k' = Z_it       * (agebin == `k')
 61.         gen S_a`k' = Z_share_it * (agebin == `k')
 62.         local zvars `zvars' Z_a`k'
 63.         local svars `svars' S_a`k'
 64.         local bins_used `bins_used' `k'
 65.     }
 66.     * post x bin shifts for all but the last bin: the full set sums to post,
.     * collinear with year FE (last bin's post shift is the absorbed base).
.     local ptvars
 67.     local nb : word count `bins_used'
 68.     forval i = 1/`=`nb'-1' {
 69.         local k : word `i' of `bins_used'
 70.         cap drop PT_a`k'
 71.         gen PT_a`k' = post * (agebin == `k')
 72.         local ptvars `ptvars' PT_a`k'
 73.     }
 74. 
.     foreach yvar of local yvar_list {
 75.         if strpos(" `ppml_skip' ", " `yvar' ") > 0 {
 76.             di as text "ppml_age_gradient: `yvar' not a count outcome -- skipped."
 77.             continue
 78.         }
 79.         local ppml_ytit "Output-Cost Elasticity"
 80.         if "`yvar'" == "n_grants"       local ppml_ytit "{&Delta} Log Expected Active NIH Research Grants"
 81.         if "`yvar'" == "n_new_grants"   local ppml_ytit "{&Delta} Log Expected New NIH Research Grants"
 82.         if "`yvar'" == "nih_total_cost" local ppml_ytit "{&Delta} Log Expected NIH Award Dollars"
 83. 
.         cap noi ppmlhdfe `yvar' `zvars' `svars' `ptvars' if !mi(agebin), ///
>             absorb(`fes') vce(cluster `vce_cl')
 84.         local rc = _rc
 85.         if `rc' {
 86.             di as error "ppml_age_gradient `samp'`suf' `yvar' failed (rc=`rc'); skipping."
 87.             continue
 88.         }
 89.         gunique athr_id if e(sample)
 90.         local n_pis = r(unique)
 91.         gunique inst_id if e(sample)
 92.         local n_insts = r(unique)
 93.         cap mat drop AG
 94.         foreach k of local bins_used {
 95.             if _se[Z_a`k'] == 0 {
 96.                 di as error "ppml_age_gradient `samp'`suf' `yvar': Z_a`k' dropped/degenerate -- omitted from plot."
 97.                 continue
 98.             }
 99.             qui sum `agevar' if athr_indicator == 1 & agebin == `k'
100.             mat AG = nullmat(AG) \ (`k', r(mean), r(N), _b[Z_a`k'], _se[Z_a`k'])
101.         }
102.         preserve
103.         clear
104.         svmat AG
105.         rename (AG1 AG2 AG3 AG4 AG5) (bin age_mean n_pis b se)
106.         gen ub = b + 1.96*se
107.         gen lb = b - 1.96*se
108.         save ../temp/`gtmp'_`samp'`suf'_`yvar', replace
109.         local stats_leg `"legend(on order(- "Num. PIs: `n_pis'" "Num. Insts: `n_insts'") pos(7) ring(1) rows(2) bmargin(zero) size(small))"'
110.         local fdir ../output/figures/`samp'
111.         foreach fmode of global FIG_MODES {
112.             if "`fmode'" == "paper" {
113.                 local stats_leg legend(off)
114.                 local fdir ../output/figures/`samp'/paper
115.                 cap mkdir "`fdir'"
116.             }
117.             tw rcap ub lb age_mean, lcolor(ebblue%70) msize(vsmall) || ///
>                scatter b age_mean, mcolor(ebblue) || ///
>                lfit b age_mean [aw=1/(se*se)], lcolor(dkorange) lpattern(dash) ///
>                xtitle("`gxtit'") ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ///
>                yline(0, lcolor(gs10) lpattern(solid)) ///
>                `stats_leg' ///
>                plotregion(margin(sides))
118.             graph export `fdir'/`gpfx'_`yvar'`suf'_ppml_mshrctrl.pdf, replace
119.         }
120.         restore
121.     }
122.     }
123. end

. 
. program desc_pre_output_by_age
  1.     * PI-level pre-period research-output densities, young vs old.
.     * Log-scale and raw (x capped at pooled p95) overlays per outcome.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir "../output/figures/`samp'"
  8. 
.     use ../temp/es_`samp'`suf', clear
  9.     keep if year < 2014
 10.     qui sum year
 11.     local y0 = r(min)
 12.     local y1 = r(max)
 13. 
.     * Productivity: total pre-period papers and papers per pre-period year.
.     * Citations and authorship-position counts ride along as totals.
.     local sum_src   ppr_cnt cite_affl_wt n_first_ppr n_last_ppr
 14.     local sum_alias ppr_tot cite         first       last
 15.     local mean_src   ppr_cnt
 16.     local mean_alias ppr_yr
 17.     local lbl_ppr_tot "Total Papers"
 18.     local lbl_ppr_yr  "Papers per Year"
 19.     local lbl_cite    "Affiliation-Weighted Citations"
 20.     local lbl_first   "First-Authored Papers"
 21.     local lbl_last    "Last-Authored Papers"
 22.     local fmt_ppr_tot %6.1f
 23.     local fmt_ppr_yr  %5.2f
 24.     local fmt_cite    %8.1f
 25.     local fmt_first   %6.1f
 26.     local fmt_last    %6.1f
 27. 
.     local coll_sum
 28.     local coll_mean
 29.     local keep_alias
 30.     foreach stat in sum mean {
 31.         local nsrc : word count ``stat'_src'
 32.         forvalues i = 1/`nsrc' {
 33.             local src : word `i' of ``stat'_src'
 34.             local a   : word `i' of ``stat'_alias'
 35.             cap confirm variable `src'
 36.             if _rc {
 37.                 di as error "desc_pre_output_by_age `samp'`suf': `src' not in panel -- `a' density SKIPPED."
 38.                 continue
 39.             }
 40.             local coll_`stat' `coll_`stat'' pre_`a'=`src'
 41.             local keep_alias `keep_alias' `a'
 42.         }
 43.     }
 44.     if "`keep_alias'" == "" {
 45.         di as error "desc_pre_output_by_age `samp'`suf': no outcomes available -- nothing plotted."
 46.         exit
 47.     }
 48.     local coll_sum_part = cond("`coll_sum'" == "", "", "(sum) `coll_sum'")
 49.     local coll_mean_part = cond("`coll_mean'" == "", "", "(mean) `coll_mean'")
 50. 
.     egen long inst_num = group(inst_id)
 51.     gcollapse `coll_sum_part' `coll_mean_part' (firstnm) young inst_num, by(athr_id)
 52.     drop if mi(young)
 53. 
.     qui count if young == 1
 54.     local n_y = r(N)
 55.     qui count if young == 0
 56.     local n_o = r(N)
 57.     di as text _n "desc_pre_output_by_age `samp'`suf': pre-period = `y0'-`y1', N young = `n_y', N old = `n_o'"
 58. 
.     foreach a of local keep_alias {
 59.         local f "`fmt_`a''"
 60.         qui sum pre_`a' if young == 1, d
 61.         local mu_y = strtrim(string(r(mean), "`f'"))
 62.         local md_y = strtrim(string(r(p50),  "`f'"))
 63.         qui sum pre_`a' if young == 0, d
 64.         local mu_o = strtrim(string(r(mean), "`f'"))
 65.         local md_o = strtrim(string(r(p50),  "`f'"))
 66.         local leg_y "Early-Career (N=`n_y'): mean=`mu_y'"
 67.         local leg_o "Late-Career (N=`n_o'): mean=`mu_o'"
 68.         di as text "  `a': young mean=`mu_y' p50=`md_y' | old mean=`mu_o' p50=`md_o'"
 69.         cap noi ksmirnov pre_`a', by(young)
 70.         qui reg pre_`a' young, vce(cluster inst_num)
 71.         di as text "  `a': young-old diff = " %8.3f _b[young] " (se " %8.3f _se[young] ")"
 72. 
.         gen double ln_pre_`a' = ln(1 + pre_`a')
 73.         * both densities on one common x grid so rarea can shade the gap
.         qui sum ln_pre_`a'
 74.         cap drop _kx _kd_y _kd_o _kd_c
 75.         gen _kx = r(min) + (r(max) - r(min)) * (_n - 1) / 199 if _n <= 200
 76.         kdensity ln_pre_`a' if young == 1, at(_kx) gen(_kd_y) nograph
 77.         kdensity ln_pre_`a' if young == 0, at(_kx) gen(_kd_o) nograph
 78.         gen _kd_c = min(_kd_y, _kd_o)
 79.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 80.         local fdir ../output/figures/`samp'
 81.         foreach fmode of global FIG_MODES {
 82.             if "`fmode'" == "paper" {
 83.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
 84.                 local fdir ../output/figures/`samp'/paper
 85.                 cap mkdir "`fdir'"
 86.             }
 87.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("ln(1 + Pre-Period `lbl_`a'', `y0'-`y1')") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
 88.             graph export `fdir'/desc_kd_pre_`a'_ln`suf'.pdf, replace
 89.         }
 90. 
.         qui sum pre_`a', d
 91.         local xcap = r(p95)
 92.         cap drop _kx _kd_y _kd_o _kd_c
 93.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 94.         kdensity pre_`a' if young == 1 & pre_`a' <= `xcap', at(_kx) gen(_kd_y) nograph
 95.         kdensity pre_`a' if young == 0 & pre_`a' <= `xcap', at(_kx) gen(_kd_o) nograph
 96.         gen _kd_c = min(_kd_y, _kd_o)
 97.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 98.         local fdir ../output/figures/`samp'
 99.         foreach fmode of global FIG_MODES {
100.             if "`fmode'" == "paper" {
101.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
102.                 local fdir ../output/figures/`samp'/paper
103.                 cap mkdir "`fdir'"
104.             }
105.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("Pre-Period `lbl_`a'', `y0'-`y1' (x capped at pooled p95)") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
106.             graph export `fdir'/desc_kd_pre_`a'_raw`suf'.pdf, replace
107.         }
108.         cap drop _kx _kd_y _kd_o _kd_c
109.     }
110. 
.     save ../temp/desc_pre_output_`samp'`suf', replace
111. end

. 
. program horse_race_nih
  1.     * Experience-vs-money horse race on the NIH-matched sample: one PPML with
.     * Z_it interacted with young (early-career) AND low_nihd (below-median
.     * baseline NIH funding) jointly, plus the post x dummy shifts and the
.     * uninteracted share control. Base Z_it = late-career, above-median-NIH.
.     * Reports both triple-interaction betas and the Wald test of equality.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17. 
.     cap confirm file "../temp/es_`samp'`suf'.dta"
 18.     if _rc {
 19.         di as error "horse_race_nih `samp'`suf': ../temp/es_`samp'`suf'.dta not found -- run add_het_splits first."
 20.         exit
 21.     }
 22.     use ../temp/es_`samp'`suf', clear
 23.     foreach v in young low_nihd nih_pi {
 24.         cap confirm variable `v'
 25.         if _rc {
 26.             di as error "horse_race_nih `samp'`suf': `v' not in panel -- SKIPPED."
 27.             exit
 28.         }
 29.     }
 30.     keep if nih_pi == 1 & !mi(young) & !mi(low_nihd)
 31.     foreach v in young low_nihd {
 32.         qui sum `v'
 33.         if r(N) == 0 | r(min) == r(max) {
 34.             di as error "horse_race_nih `samp'`suf': `v' degenerate on the NIH-matched sample -- SKIPPED."
 35.             exit
 36.         }
 37.     }
 38. 
.     gen post       = year >= 2014
 39.     gen Z_it       = exposure      * post
 40.     gen Z_share_it = mkt_spend_shr * post
 41.     gen Z_early    = Z_it * young
 42.     gen Z_lownih   = Z_it * low_nihd
 43.     gen PT_early   = post * young
 44.     gen PT_lownih  = post * low_nihd
 45. 
.     local yvar_list ppr_cnt cite_affl_wt
 46.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 47.     local nyv : word count `yvar_list'
 48. 
.     mat hrace`suf' = J(14, `nyv', .)
 49.     mat rownames hrace`suf' = b_z_base se_z_base b_z_early se_z_early ///
>                               b_z_lownih se_z_lownih b_diff se_diff ///
>                               stat_eq p_eq N n_pis n_pis_early n_pis_lownih
 50.     mat colnames hrace`suf' = `yvar_list'
 51. 
.     local col 0
 52.     foreach yvar of local yvar_list {
 53.         local ++col
 54.         cap noi ppmlhdfe `yvar' Z_it Z_early Z_lownih PT_early PT_lownih Z_share_it, ///
>             absorb(`fes') vce(cluster `vce_cl')
 55.         local rc = _rc
 56.         if `rc' {
 57.             di as error "horse_race_nih `samp'`suf' `yvar' failed (rc=`rc'); column left missing."
 58.             continue
 59.         }
 60.         local Nppml = e(N)
 61.         local b_early   = _b[Z_early]
 62.         local se_early  = _se[Z_early]
 63.         local b_lownih  = _b[Z_lownih]
 64.         local se_lownih = _se[Z_lownih]
 65.         gunique athr_id if e(sample)
 66.         local n_pis = r(unique)
 67.         gunique athr_id if e(sample) & young == 1
 68.         local n_early = r(unique)
 69.         gunique athr_id if e(sample) & low_nihd == 1
 70.         local n_lownih = r(unique)
 71.         qui lincom Z_early - Z_lownih
 72.         local b_diff  = r(estimate)
 73.         local se_diff = r(se)
 74.         qui test Z_early = Z_lownih
 75.         local stat_eq = cond(r(F) < ., r(F), r(chi2))
 76.         local p_eq = r(p)
 77. 
.         mat hrace`suf'[1,`col']  = _b[Z_it]
 78.         mat hrace`suf'[2,`col']  = _se[Z_it]
 79.         mat hrace`suf'[3,`col']  = `b_early'
 80.         mat hrace`suf'[4,`col']  = `se_early'
 81.         mat hrace`suf'[5,`col']  = `b_lownih'
 82.         mat hrace`suf'[6,`col']  = `se_lownih'
 83.         mat hrace`suf'[7,`col']  = `b_diff'
 84.         mat hrace`suf'[8,`col']  = `se_diff'
 85.         mat hrace`suf'[9,`col']  = `stat_eq'
 86.         mat hrace`suf'[10,`col'] = `p_eq'
 87.         mat hrace`suf'[11,`col'] = `Nppml'
 88.         mat hrace`suf'[12,`col'] = `n_pis'
 89.         mat hrace`suf'[13,`col'] = `n_early'
 90.         mat hrace`suf'[14,`col'] = `n_lownih'
 91. 
.         di as text "horse_race_nih `samp'`suf' `yvar' (NIH-matched sample):"
 92.         di as text "  Z x EarlyCareer     = " %9.4f `b_early'  "  (se " %7.4f `se_early' ")"
 93.         di as text "  Z x BelowMedianNIH  = " %9.4f `b_lownih' "  (se " %7.4f `se_lownih' ")"
 94.         di as text "  diff (early-lownih) = " %9.4f `b_diff'   "  (se " %7.4f `se_diff' ")   H0 equal: stat = " %8.4f `stat_eq' "  p = " %6.4f `p_eq'
 95.         di as text "  base Z (late-career x above-median) = " %9.4f _b[Z_it] "  (se " %7.4f _se[Z_it] ")"
 96.         di as text "  N = " %9.0f `Nppml' "  PIs = `n_pis' (early = `n_early', below-median NIH = `n_lownih')"
 97.     }
 98. 
.     cap mkdir ../output/tables
 99.     cap mkdir ../output/tables/`samp'
100.     qui matrix_to_txt, saving("../output/tables/`samp'/horse_race_nih`suf'.txt") ///
>         matrix(hrace`suf') title(<tab:horse_race_nih`suf'>) format(%20.4f) replace
101. end

. 
. program output_het_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir ../output/tables
  8.     cap mkdir ../output/tables/`samp'
  9. 
.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
 10.     if !_rc {
 11.         preserve
 12.         use "../temp/phet_results_`samp'`suf'.dta", clear
 13.         export delimited using "../output/tables/`samp'/phet_results`suf'.txt", replace delim(tab)
 14.         restore
 15.     }
 16. end

. 
. program output_split_diff_tables
  1.     * Group-difference test for every split on the main het coefplot: b, se for
.     * each group and lincom g1 - g2 off the joint pooled-DiD PPML VCE (the
.     * med_pi_diff rows event_study_het posts).
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
  8.     if _rc {
  9.         di as error "output_split_diff_tables `samp'`suf': phet_results not found -- skipping."
 10.         exit 0
 11.     }
 12.     cap mkdir ../output/tables
 13.     cap mkdir ../output/tables/`samp'
 14. 
.     local pairs `"${COEFPLOT_PI_PAIRS}"'
 15.     foreach a of global IC_ALIASES {
 16.         local pairs `"`pairs' "hiw_`a' low_`a'" "'
 17.     }
 18. 
.     foreach yvar in ppr_cnt cite_affl_wt {
 19.         preserve
 20.         use "../temp/phet_results_`samp'`suf'.dta", clear
 21.         keep if yvar == "`yvar'" & spec == "mshrctrl" & inlist(split_type, "med_pi", "med_pi_diff")
 22.         cap mat drop sdiff
 23.         local rows
 24.         foreach pair of local pairs {
 25.             local g1 : word 1 of `pair'
 26.             local g2 : word 2 of `pair'
 27.             qui count if grp == "`g1'_diff" & split_type == "med_pi_diff"
 28.             if r(N) == 0 continue
 29.             foreach g in `g1' `g2' {
 30.                 qui sum post_b  if grp == "`g'" & split_type == "med_pi"
 31.                 local b_`g'  = r(mean)
 32.                 qui sum post_se if grp == "`g'" & split_type == "med_pi"
 33.                 local se_`g' = r(mean)
 34.             }
 35.             qui sum post_b  if grp == "`g1'_diff" & split_type == "med_pi_diff"
 36.             local b_diff = r(mean)
 37.             qui sum post_se if grp == "`g1'_diff" & split_type == "med_pi_diff"
 38.             local se_diff = r(mean)
 39.             qui sum pre_b   if grp == "`g1'_diff" & split_type == "med_pi_diff"
 40.             local p_diff = r(mean)
 41.             qui sum N       if grp == "`g1'_diff" & split_type == "med_pi_diff"
 42.             local Nfit = r(mean)
 43.             mat sdiff = nullmat(sdiff) \ ///
>                 (`b_`g1'', `se_`g1'', `b_`g2'', `se_`g2'', `b_diff', `se_diff', `p_diff', `Nfit')
 44.             local rows `rows' `g1'
 45.         }
 46.         restore
 47.         if "`rows'" == "" continue
 48.         mat colnames sdiff = b_g1 se_g1 b_g2 se_g2 b_diff se_diff p_diff N
 49.         mat rownames sdiff = `rows'
 50.         di as result _n "== split_diff `samp'`suf' `yvar': g1 - g2 off the joint VCE (rows = g1 of each coefplot pair) =="
 51.         matlist sdiff, format(%9.4f) lines(oneline)
 52.         qui matrix_to_txt, saving("../output/tables/`samp'/split_diff_`yvar'`suf'.txt") ///
>             matrix(sdiff) title(<tab:split_diff_`yvar'`suf'>) format(%20.4f) replace
 53.     }
 54. end

. 
. program ppml_het_coefplot
  1.     * Three panels per yvar (pi / ic_fund / ic_expx).
.     * If yvar() is supplied, plot only that outcome; otherwise loop all.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     * When called inline per-yvar, read the per-yvar postfile; otherwise the combined master.
.     if "`yvar'" != "" {
  8.         local resfile "../temp/phet_results_`samp'`suf'_`yvar'.dta"
  9.     }
 10.     else {
 11.         local resfile "../temp/phet_results_`samp'`suf'.dta"
 12.     }
 13.     cap confirm file "`resfile'"
 14.     if _rc {
 15.         di as error "ppml_het_coefplot: `resfile' not found -- skipping"
 16.         exit 0
 17.     }
 18. 
.     local ppml_het_yvars ppr_cnt ppr_cnt_nonsolo cite_affl_wt avg_num_coathrs ///
>                         n_grants n_new_grants nih_total_cost ///
>                         n_middle_ppr
 19.     if "`yvar'" != "" local ppml_het_yvars `yvar'
 20. 
.     local ic_fund_aliases tfnd lsf
 21.     local ic_expx_aliases endow
 22.     if $HET_IC_FULL == 1 {
 23.         local ic_fund_aliases contr fdlsb fdls fdlsh gntsf hhlsb hhls hhlsh nflsb nfls nflsh subrf busf fedf tfnd instf nonpf statf lsf hsf biof
 24.         local ic_expx_aliases applx apfx basx bfx clinx devx lscx medx endow
 25.     }
 26. 
.     local st_list med_pi joint_ae
 27.     if "$HET_INCLUDE_INSTWTD" == "1" local st_list med `st_list'
 28.     if "$HET_RUN_QUARTILES" == "1" {
 29.         local st_list `st_list' quart_pi
 30.         if "$HET_INCLUDE_INSTWTD" == "1" local st_list `st_list' quart
 31.     }
 32.     foreach st of local st_list {
 33.         if strpos("`st'", "joint_") == 1 {
 34.             * Custom paired rendering used instead of the standard panel loop.
.             * Leaving all groups empty causes the standard loop to skip.
.             local groups_pi
 35.             local groups_ic_fund
 36.             local groups_ic_expx
 37.         }
 38.         else if "`st'" == "med" {
 39.             local groups_pi
 40.             foreach pair of global COEFPLOT_PI_PAIRS {
 41.                 local groups_pi `groups_pi' `pair'
 42.             }
 43.             local groups_ic_fund
 44.             foreach a of local ic_fund_aliases {
 45.                 local groups_ic_fund `groups_ic_fund' hi_`a' lo_`a'
 46.             }
 47.             local groups_ic_expx
 48.             foreach a of local ic_expx_aliases {
 49.                 local groups_ic_expx `groups_ic_expx' hi_`a' lo_`a'
 50.             }
 51.         }
 52.         else if "`st'" == "med_pi" {
 53.             * PI-weighted inst-char medians. PI-level splits are the same
.             * variables as under med so they render in the pi panel too.
.             local groups_pi
 54.             foreach pair of global COEFPLOT_PI_PAIRS {
 55.                 local groups_pi `groups_pi' `pair'
 56.             }
 57.             local groups_ic_fund
 58.             foreach a of local ic_fund_aliases {
 59.                 local groups_ic_fund `groups_ic_fund' hiw_`a' low_`a'
 60.             }
 61.             local groups_ic_expx
 62.             foreach a of local ic_expx_aliases {
 63.                 local groups_ic_expx `groups_ic_expx' hiw_`a' low_`a'
 64.             }
 65.         }
 66.         else if "`st'" == "quart" {
 67.             local groups_pi
 68.             foreach b of global PI_Q_BASES {
 69.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 70.             }
 71.             local groups_ic_fund
 72.             foreach a of local ic_fund_aliases {
 73.                 local groups_ic_fund `groups_ic_fund' q4_`a' q1_`a'
 74.             }
 75.             local groups_ic_expx
 76.             foreach a of local ic_expx_aliases {
 77.                 local groups_ic_expx `groups_ic_expx' q4_`a' q1_`a'
 78.             }
 79.         }
 80.         else {
 81.             * quart_pi -- PI-weighted quartiles for inst chars, PI-continuous
.             * quartiles for PI bases.
.             local groups_pi
 82.             foreach b of global PI_Q_BASES {
 83.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 84.             }
 85.             local groups_ic_fund
 86.             foreach a of local ic_fund_aliases {
 87.                 local groups_ic_fund `groups_ic_fund' q4w_`a' q1w_`a'
 88.             }
 89.             local groups_ic_expx
 90.             foreach a of local ic_expx_aliases {
 91.                 local groups_ic_expx `groups_ic_expx' q4w_`a' q1w_`a'
 92.             }
 93.         }
 94. 
.         foreach spec_tag in mshrctrl {
 95.             local spec_folder = cond($HET_IC_FULL == 1, "coefplot_evavg_full", "coefplot_evavg")
 96.             cap mkdir "../output/figures/`samp'/`spec_folder'"
 97. 
.         * Combined panel stacks pi + ic_fund + ic_expx so the paper can show
.         * one coefplot per (yvar, spec, st) instead of three per-panel PDFs.
.         local groups_all `groups_pi' `groups_ic_fund' `groups_ic_expx'
 98.         foreach panel in pi ic_fund ic_expx all {
 99.             local groups `groups_`panel''
100.             local n_groups : word count `groups'
101.             if `n_groups' == 0 continue
102. 
.             foreach yv of local ppml_het_yvars {
103.                 preserve
104.                 use "`resfile'", clear
105.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
106.                 if _N == 0 {
107.                     restore
108.                     continue
109.                 }
110. 
.                 * Splits not yet rebuilt upstream have no rows here; drop them
.                 * so they leave no blank labelled row on the axis.
.                 local groups_present
111.                 foreach g of local groups {
112.                     qui count if grp == "`g'" & !mi(post_b)
113.                     if r(N) > 0 local groups_present `groups_present' `g'
114.                 }
115.                 local groups `groups_present'
116.                 local n_groups : word count `groups'
117.                 if `n_groups' == 0 {
118.                     restore
119.                     continue
120.                 }
121. 
.                 * Groups come in high/low pairs; add a gap between pairs so
.                 * each pair reads as one block.
.                 local pair_gap 0.7
122.                 local npairs = ceil(`n_groups'/2)
123.                 gen double y = .
124.                 local ylabs ""
125.                 local i = 0
126.                 foreach g of local groups {
127.                     local ++i
128.                     local pair = int((`i'-1)/2)
129.                     local ypos = (`n_groups' - `i') + (`npairs' - 1 - `pair')*`pair_gap' + 1
130.                     qui replace y = `ypos' if grp == "`g'"
131.                     local lbl = "${LBL_`g'}"
132.                     if "`lbl'" == "" local lbl "`g'"
133.                     if length("`lbl'") > 40 local lbl = substr("`lbl'", 1, 37) + "..."
134.                     local ylabs `"`ylabs' `ypos' "`lbl'""'
135.                 }
136.                 drop if mi(y) | mi(post_b)
137.                 if _N == 0 {
138.                     restore
139.                     continue
140.                 }
141.                 gen ub = post_b + 1.96*post_se
142.                 gen lb = post_b - 1.96*post_se
143. 
.                 qui sum lb
144.                 local xmin = floor(r(min)/0.5)*0.5
145.                 qui sum ub
146.                 local xmax = ceil(r(max)/0.5)*0.5
147. 
.                 * Adaptive canvas: bigger for more rows. Matches old reduced_form format.
.                 local ysize 6
148.                 if `n_groups' > 20 local ysize 10
149.                 if `n_groups' > 40 local ysize 14
150.                 * Grow the canvas by the added inter-pair whitespace.
.                 local ysize = round(`ysize' * (`n_groups' + (`npairs'-1)*`pair_gap')/`n_groups', 0.1)
151.                 local labsize small
152.                 if `n_groups' > 20 local labsize vsmall
153. 
.                 tw rcap ub lb y, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>                    scatter y post_b, mcolor(ebblue) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(`labsize') noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(off) ///
>                      ysize(`ysize') xsize(7) ///
>                      yscale(range(0.9 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
154.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf", ///
>                     replace
155.                 di as text "wrote ../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf"
156.                 restore
157.             }
158.         }
159. 
.         * ----- Custom paired coefplot: inst chars on y-axis (High/Low rows),
.         *       one blue + one orange marker per row; age is the splitting
.         *       axis (1-char y/o prefix).
.         if "`st'" == "joint_ae" {
160.             local pfx_len   1
161.             local hi_pfx    y
162.             local lo_pfx    o
163.             local hi_leg    "Early-Career"
164.             local lo_leg    "Late-Career"
165.             local filename_stem joint_ae_paired
166.             local hilo_pos = `pfx_len' + 2
167.             local char_pos = `pfx_len' + 5
168.             foreach yv of local ppml_het_yvars {
169.                 preserve
170.                 use "`resfile'", clear
171.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
172.                 if _N == 0 {
173.                     restore
174.                     continue
175.                 }
176.                 gen str2  pfx_c  = substr(grp, 1, `pfx_len')
177.                 gen str2  hilo_c = substr(grp, `hilo_pos', 2)
178.                 gen str12 char_c = substr(grp, `char_pos', .)
179.                 gen byte  is_hi_side = (pfx_c == "`hi_pfx'")
180.                 gen char_idx = .
181.                 local ii = 0
182.                 foreach a of global IC_ALIASES {
183.                     local ++ii
184.                     qui replace char_idx = `ii' if char_c == "`a'"
185.                 }
186.                 qui drop if mi(char_idx)
187.                 if _N == 0 {
188.                     restore
189.                     continue
190.                 }
191.                 qui sum char_idx
192.                 local nchars = r(max)
193.                 * Row layout: within-pair (blue+orange same hi/lo) 0.6;
.                 * between hi-row and lo-row of same char = 0.8; between
.                 * chars = 1.2. Base spacing 3.2 per char.
.                 gen double y_group = (`nchars' + 1 - char_idx) * 3.2
194.                 gen double y_pos   = y_group ///
>                     + cond(hilo_c == "hi" & is_hi_side == 1,  1.0, ///
>                       cond(hilo_c == "hi" & is_hi_side == 0,  0.4, ///
>                       cond(hilo_c == "lo" & is_hi_side == 1, -0.4, -1.0)))
195.                 gen ub = post_b + 1.96*post_se
196.                 gen lb = post_b - 1.96*post_se
197. 
.                 local ylabs
198.                 forvalues i = 1/`nchars' {
199.                     qui levelsof char_c if char_idx == `i', local(cname) clean
200.                     local clbl = "${LBL_ic_`cname'}"
201.                     if "`clbl'" == "" local clbl "`cname'"
202.                     local base = (`nchars' + 1 - `i') * 3.2
203.                     local pos_hi = `base' + 1.0
204.                     local pos_lo = `base' - 0.4
205.                     local ylabs `"`ylabs' `pos_hi' "High `clbl'""'
206.                     local ylabs `"`ylabs' `pos_lo' "Low `clbl'""'
207.                 }
208. 
.                 qui sum lb
209.                 local xmin = floor(r(min)/0.5)*0.5
210.                 qui sum ub
211.                 local xmax = ceil(r(max)/0.5)*0.5
212. 
.                 tw rcap ub lb y_pos if is_hi_side == 1, horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>                    scatter y_pos post_b if is_hi_side == 1, mcolor(ebblue) msize(small)              || ///
>                    rcap ub lb y_pos if is_hi_side == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                    scatter y_pos post_b if is_hi_side == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(order(2 "`hi_leg'" 4 "`lo_leg'") pos(6) ring(1) rows(1) span size(small)) ///
>                      ysize(`=max(8, `nchars'*1.6)') xsize(9) ///
>                      yscale(range(2.1 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
213.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`filename_stem'`suf'.pdf", ///
>                     replace
214.                 di as text "wrote `filename_stem' coefplot for `yv' `spec_tag'"
215.                 restore
216.             }
217.         }
218. 
.         }  // close foreach spec_tag
219.     }
220. end

