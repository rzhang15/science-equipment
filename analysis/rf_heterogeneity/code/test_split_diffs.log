  log type:  text
 opened on:  25 Aug 2026, 18:14:11

. 
. * Group-difference test for every split on the main het coefplot, off the
. * joint pooled-DiD PPML that event_study_het fits (split_type med_pi).
. * Reads the panel analysis.do already wrote to ../temp/, so no rebuild.
. 
. local fes athr_id year

. local vce_cl athr_id

. local pairs `" "young old" "r1 r2" "high_pre_ppr low_pre_ppr" "high_nihd low_nihd" "big_msa small_msa" "hiw_tfnd low_tfnd" "hiw_lsf low_lsf" "hiw_endow low_endow" "'

. 
. foreach suf in _r1_r2 {
  2.     cap confirm file "../temp/es_all_jrnls`suf'.dta"
  3.     if _rc {
  4.         di as error "../temp/es_all_jrnls`suf'.dta missing -- run analysis.do first."
  5.         continue
  6.     }
  7.     local dummies
  8.     foreach pair of local pairs {
  9.         local dummies `dummies' `pair'
 10.     }
 11.     use athr_id year ppr_cnt exposure mkt_spend_shr `dummies' ///
>         using ../temp/es_all_jrnls`suf', clear
 12. 
.     gen post       = year >= 2014
 13.     gen Z_it       = exposure      * post
 14.     gen Z_share_it = mkt_spend_shr * post
 15. 
.     cap matrix drop SPLITS
 16.     local split_rows
 17.     foreach pair of local pairs {
 18.         local g1 : word 1 of `pair'
 19.         local g2 : word 2 of `pair'
 20.         cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
 21.         gen Z_`g1'  = Z_it       * `g1'
 22.         gen Z_`g2'  = Z_it       * `g2'
 23.         gen S_`g1'  = Z_share_it * `g1'
 24.         gen S_`g2'  = Z_share_it * `g2'
 25.         gen PT_`g1' = post * `g1'
 26. 
.         cap noi ppmlhdfe ppr_cnt Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>             absorb(`fes') vce(cluster `vce_cl')
 27.         if _rc {
 28.             di as error "test_split_diffs`suf' `g1'/`g2': ppml failed (rc=" _rc "); skipping."
 29.             continue
 30.         }
 31.         local b1   = _b[Z_`g1']
 32.         local se1  = _se[Z_`g1']
 33.         local b2   = _b[Z_`g2']
 34.         local se2  = _se[Z_`g2']
 35.         local Nfit = e(N)
 36.         lincom Z_`g1' - Z_`g2'
 37.         local b_diff  = r(estimate)
 38.         local se_diff = r(se)
 39.         local p_diff  = r(p)
 40. 
.         di as result _n "== all_jrnls`suf' ppr_cnt `g1' vs `g2' (N=`Nfit') =="
 41.         di as text "  `g1': b=" %8.4f `b1' " (se=" %7.4f `se1' ")"
 42.         di as text "  `g2': b=" %8.4f `b2' " (se=" %7.4f `se2' ")"
 43.         di as text "  diff, joint VCE:  b=" %8.4f `b_diff' " se=" %7.4f `se_diff' " p=" %6.4f `p_diff'
 44. 
.         matrix SPLITS = nullmat(SPLITS) \ ///
>             (`b1', `se1', `b2', `se2', `b_diff', `se_diff', `p_diff', `Nfit')
 45.         local split_rows `split_rows' `g1'
 46.     }
 47. 
.     if "`split_rows'" != "" {
 48.         matrix colnames SPLITS = b_g1 se_g1 b_g2 se_g2 b_diff se_diff p_diff N
 49.         matrix rownames SPLITS = `split_rows'
 50.         di as result _n "== all_jrnls`suf' ppr_cnt: g1 - g2 summary across coefplot splits (rows = g1) =="
 51.         matlist SPLITS, format(%9.4f) lines(oneline)
 52.     }
 53. }
