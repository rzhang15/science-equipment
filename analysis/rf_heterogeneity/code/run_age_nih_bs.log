  log type:  text
 opened on:  30 Jul 2026, 14:05:34

. 
. local samp   all_jrnls

. local suf    _r1_r2

. local fes    athr_id year

. local vce_cl athr_id

. local yvars  n_grants nih_total_cost

. local pairs  `" "young old" "young_nih old_nih" "'

. 
. use ../temp/es_`samp'`suf', clear

. gen post       = year >= 2014

. gen Z_it       = exposure      * post

. gen Z_share_it = mkt_spend_shr * post

. 
. cap mkdir "../output/figures/`samp'/ppml_pdid_het_bs"

. 
. foreach yvar of local yvars {
  2.     local bs_lbl "`yvar'"
  3.     if "`yvar'" == "n_grants"       local bs_lbl "Active NIH Research Gran
> ts"
  4.     if "`yvar'" == "nih_total_cost" local bs_lbl "NIH Award Dollars"
  5. 
.     foreach pair of local pairs {
  6.         local g1 : word 1 of `pair'
  7.         local g2 : word 2 of `pair'
  8. 
.         foreach v in Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1' _mu _z_work _dvar _f
> wlw _y_r _Z_r {
  9.             cap drop `v'
 10.         }
 11.         gen Z_`g1'  = Z_it       * `g1'
 12.         gen Z_`g2'  = Z_it       * `g2'
 13.         gen S_`g1'  = Z_share_it * `g1'
 14.         gen S_`g2'  = Z_share_it * `g2'
 15.         gen PT_`g1' = post       * `g1'
 16. 
.         di as text _n "==== pdid binscatter fit: `yvar' `g1' vs `g2' ===="
 17.         cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>             absorb(`fes') vce(cluster `vce_cl') d(_dvar)
 18.         if _rc {
 19.             di as error "run_age_nih_bs: `yvar' `g1'/`g2' joint fit failed
> ; skipping."
 20.             continue
 21.         }
 22.         local b_`g1'  = _b[Z_`g1']
 23.         local se_`g1' = _se[Z_`g1']
 24.         local b_`g2'  = _b[Z_`g2']
 25.         local se_`g2' = _se[Z_`g2']
 26. 
.         predict double _mu, mu
 27.         gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _m
> u > 0
 28.         gen double _fwlw   = _mu                          if !mi(_mu) & _m
> u > 0
 29. 
.         foreach grp in `g1' `g2' {
 30.             local other = cond("`grp'" == "`g1'", "`g2'", "`g1'")
 31.             foreach v in _y_r _Z_r {
 32.                 cap drop `v'
 33.             }
 34.             cap noi qui reghdfe _z_work Z_`other' S_`g1' S_`g2' PT_`g1' if
>  !mi(_fwlw) [pw=_fwlw], ///
>                 absorb(`fes') residuals(_y_r)
 35.             if _rc == 0 cap noi qui reghdfe Z_`grp' Z_`other' S_`g1' S_`g2
> ' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                 absorb(`fes') residuals(_Z_r)
 36.             if _rc {
 37.                 di as error "run_age_nih_bs FWL `grp' failed; skipping plo
> t."
 38.                 continue
 39.             }
 40.             gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 41.             local n_pis = r(unique)
 42.             gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 43.             local n_insts = r(unique)
 44.             local b_str  : dis %7.3f `b_`grp''
 45.             local se_str : dis %7.3f `se_`grp''
 46.             di as text "BS `yvar' `grp': beta=`b_str' se=`se_str' PIs=`n_p
> is' Insts=`n_insts'"
 47.             binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !m
> i(_Z_r), n(30) ///
>                 xtitle("Exposure x Post") ///
>                 ytitle("{&Delta} Log Expected `bs_lbl'") ///
>                 xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                 msymbol(O) mcolor(ebblue) ///
>                 note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `
> b_str' (SE: `se_str')", ///
>                      size(small) pos(7) ring(1) justification(left)) ///
>                 plotregion(margin(sides))
 48.             graph export ///
>                 ../output/figures/`samp'/ppml_pdid_het_bs/ppml_pdid_`yvar'_`g
> rp'_agenih`suf'.pdf, replace
 49.         }
 50.     }
 51. }

