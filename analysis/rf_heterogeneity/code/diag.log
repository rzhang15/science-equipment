. 
. * Combined heterogeneity diagnostics. Two parts:
. *   Part A: PI-level (LPM, R1/R2 composition, baseline productivity kdensity,
. *           age dist by hi/lo institutional characteristic)
. *   Part B: panel-level joint 2x2 pooled-DiD PPML (young x hi_char) across
. *           the reduced ic-char set, plus figures.
. *
. * PI-weighted median cutoffs by default. Set DIAG_INSTWTD 1 to also emit the
. * inst-weighted variants alongside for comparison.
. global DIAG_INSTWTD 0

. 
. * Reduced ic set (matches IC_ALIASES in analysis.do; keep in sync).
. local ic_aliases tfnd lsf endow

. 
. * IC display labels (match `ic_lbl_*' in analysis.do; keep in sync).
. local lbl_tfnd  "Total R&D Funding"

. local lbl_lsf   "Life-Sci Funding"

. local lbl_endow "Endowment"

. 
. * Loop over both samples: R1+R2 (public+private) and R1-only (public+private).
. * All output PDFs and tempfile paths get the sample suffix appended.
. foreach samp_suf in _r1_r2 _r1 {
  2. di as text _n(3) "============================================================" ///
>     _n "=== SAMPLE: `samp_suf'"                                                 ///
>     _n "============================================================" _n
  3. 
. use ../temp/es_all_jrnls`samp_suf', clear
  4. qui gunique athr_id
  5. di as text "Unique PIs in panel = " r(unique)
  6. 
. * Baseline grants-per-paper: pre-period NIH grants active per year (pre_nihg,
. * built in add_het_splits) over pre-period papers per year. Dropped from the
. * LPMs when either input is unavailable.
. local gppv
  7. cap drop pre_gpp
  8. cap confirm variable pre_nihg
  9. local rc_g = _rc
 10. cap confirm variable pre_ppr_cnt_avg
 11. local rc_p = _rc
 12. if `rc_g' == 0 & `rc_p' == 0 {
 13.     gen double pre_gpp = pre_nihg / pre_ppr_cnt_avg if pre_ppr_cnt_avg > 0 & !mi(pre_ppr_cnt_avg)
 14.     local gppv pre_gpp
 15. }
 16. else di as error "diag `samp_suf': pre_nihg or pre_ppr_cnt_avg missing -- pre_gpp SKIPPED in tabstat/LPMs."
 17. 
. * ============================================================
. * Part A: PI-level diagnostics (preserve for the joint 2x2 in Part B)
. * ============================================================
. preserve
 18. keep if athr_indicator == 1
 19. qui count
 20. di as text _n "Unique PIs after athr_indicator filter = " r(N)
 21. 
. * --- A1: R1 x young cross-tab + bar chart + age histogram by R1 ---
. di as text _n(2) "=== R1 x young cross-tab ==="
 22. tabulate r1 young, row col
 23. 
. qui count if r1 == 1
 24. local n_r1 = r(N)
 25. qui count if r1 == 0
 26. local n_r2 = r(N)
 27. 
. graph bar (mean) young, ///
>     over(r1, relabel(1 `"R2 (N=`n_r2')"' 2 `"R1 (N=`n_r1')"')) ///
>     ytitle("Share Young") bar(1, color(ebblue)) ///
>     blabel(bar, format(%4.3f) size(medium)) ///
>     plotregion(margin(sides))
 28. graph export ../output/figures/all_jrnls/diag_share_young_by_r1`samp_suf'.pdf, replace
 29. 
. tw histogram age_2014 if r1 == 1, freq lcolor(ebblue) fcolor(ebblue%30) width(2) || ///
>    histogram age_2014 if r1 == 0, freq lcolor(dkorange) fcolor(dkorange%30) width(2) ///
>    , xtitle("Age in 2014") ytitle("Frequency") ///
>      legend(order(1 "R1 (N=`n_r1')" 2 "R2 (N=`n_r2')") pos(2) ring(0) rows(2) size(small)) ///
>      plotregion(margin(sides))
 30. graph export ../output/figures/all_jrnls/diag_age_hist_by_r1`samp_suf'.pdf, replace
 31. 
. * --- A2: baseline productivity kdensity (young vs old) ---
. * Total pre-period papers and papers per pre-period year.
. qui count if young == 1
 32. local n_y = r(N)
 33. qui count if young == 0
 34. local n_o = r(N)
 35. local prod_src    pre_ppr_cnt_sum pre_ppr_cnt_avg
 36. local prod_alias  ppr_tot         ppr_yr
 37. local lbl_ppr_tot "Total Papers"
 38. local lbl_ppr_yr  "Papers per Year"
 39. local fmt_ppr_tot %6.1f
 40. local fmt_ppr_yr  %5.2f
 41. forvalues i = 1/2 {
 42.     local src : word `i' of `prod_src'
 43.     local a   : word `i' of `prod_alias'
 44.     local xlbl "`lbl_`a''"
 45.     local f   "`fmt_`a''"
 46.     cap confirm variable `src'
 47.     if _rc {
 48.         di as error "diag `samp_suf': `src' not found -- `a' kdensity SKIPPED."
 49.         continue
 50.     }
 51.     qui sum `src' if young == 1, d
 52.     local mu_y = strtrim(string(r(mean), "`f'"))
 53.     local md_y = strtrim(string(r(p50),  "`f'"))
 54.     qui sum `src' if young == 0, d
 55.     local mu_o = strtrim(string(r(mean), "`f'"))
 56.     local md_o = strtrim(string(r(p50),  "`f'"))
 57.     di as text "A2 `a': young mean=`mu_y' p50=`md_y' N=`n_y' | old mean=`mu_o' p50=`md_o' N=`n_o'"
 58.     cap drop ln_pre_`a'
 59.     gen double ln_pre_`a' = ln(1 + `src')
 60.     tw kdensity ln_pre_`a' if young == 1, lcolor(ebblue) lwidth(medthick) || ///
>        kdensity ln_pre_`a' if young == 0, lcolor(dkorange) lwidth(medthick) ///
>        , xtitle("ln(1 + Pre-Period `xlbl')") ///
>          ytitle("Density") ///
>          legend(order(1 "Young: mean=`mu_y', p50=`md_y', N=`n_y'" ///
>                       2 "Old: mean=`mu_o', p50=`md_o', N=`n_o'") ///
>                 pos(2) ring(0) rows(2) size(small)) ///
>          plotregion(margin(sides))
 61.     graph export ../output/figures/all_jrnls/diag_kd_pre_`a'_ln`samp_suf'.pdf, replace
 62. }
 63. 
. * --- A3: LPM of young on characteristics ---
. di as text _n(2) "=== Characteristic means by young / old ==="
 64. tabstat pre_ppr_cnt_sum `gppv' pre_team_avg pre_coauth_avg ///
>         age_2014 msa_size_at r1 ic_tfnd ic_fedf ic_endow, ///
>         by(young) stats(mean sd n) col(stats)
 65. 
. * Direct test: are young PIs different on baseline productivity / coauthors /
. * team size / grants-per-paper? Regress each char on the young dummy. Positive
. * young coef = young PIs have MORE of that char; negative = LESS.
. di as text _n(2) "=== Char ~ young (per-char reversed regression, cluster inst_id) ==="
 66. foreach c in pre_ppr_cnt_sum pre_coauth_avg pre_team_avg `gppv' msa_size_at {
 67.     di as text _n "--- reg `c' young, vce(cluster inst_id) ---"
 68.     reg `c' young, vce(cluster inst_id)
 69. }
 70. foreach a of local ic_aliases {
 71.     cap confirm variable ic_`a'
 72.     if _rc continue
 73.     di as text _n "--- reg ic_`a' young, vce(cluster inst_id) ---"
 74.     reg ic_`a' young, vce(cluster inst_id)
 75. }
 76. 
. * Standardize PI-level and ic vars so coefficients are directly comparable.
. foreach v of varlist pre_ppr_cnt_sum `gppv' pre_team_avg pre_coauth_avg ///
>                      msa_size_at {
 77.     qui sum `v'
 78.     gen double z_`v' = (`v' - r(mean)) / r(sd)
 79. }
 80. local z_gppv = cond("`gppv'" == "", "", "z_`gppv'")
 81. foreach a of local ic_aliases {
 82.     cap confirm variable ic_`a'
 83.     if _rc continue
 84.     qui sum ic_`a'
 85.     gen double z_ic_`a' = (ic_`a' - r(mean)) / r(sd)
 86. }
 87. 
. * Per-char LPMs: one regression per ic char so each uses its own max sample
. * (PIs missing that specific ic char drop; PIs with other missing chars stay).
. di as text _n "--- Per-char LPMs of young on standardized chars ---"
 88. foreach a of local ic_aliases {
 89.     cap confirm variable z_ic_`a'
 90.     if _rc continue
 91.     qui count if !mi(z_ic_`a')
 92.     di as text _n "-- young ~ PI chars + z_ic_`a' (N with z_ic_`a' non-mi = " r(N) ") --"
 93.     reg young z_pre_ppr_cnt_sum `z_gppv' z_pre_team_avg z_pre_coauth_avg ///
>               z_msa_size_at r1 z_ic_`a', vce(cluster inst_id)
 94.     di as text _n "-- same, R1 only --"
 95.     reg young z_pre_ppr_cnt_sum `z_gppv' z_pre_team_avg z_pre_coauth_avg ///
>               z_msa_size_at z_ic_`a' if r1 == 1, vce(cluster inst_id)
 96. }
 97. 
. * Kitchen-sink LPM using all standardized ic chars (subset with all non-missing).
. di as text _n "--- Kitchen-sink LPM: all 8 ic chars simultaneously (common sample) ---"
 98. local all_z
 99. foreach a of local ic_aliases {
100.     cap confirm variable z_ic_`a'
101.     if !_rc local all_z `all_z' z_ic_`a'
102. }
103. reg young z_pre_ppr_cnt_sum `z_gppv' z_pre_team_avg z_pre_coauth_avg ///
>           z_msa_size_at r1 `all_z', vce(cluster inst_id)
104. 
. * --- A4a: Age distribution by hi/lo baseline productivity ---
. * Tests whether "high_pre_ppr" is secretly an age proxy.
. local pi_split_specs `" "high_pre_ppr Baseline_Productivity" "'
105. foreach spec of local pi_split_specs {
106.     tokenize `"`spec'"'
107.     local dvar `1'
108.     local dlbl_raw `2'
109.     local dlbl : subinstr local dlbl_raw "_" " ", all
110.     cap confirm variable `dvar'
111.     if _rc continue
112.     qui count if `dvar' == 1
113.     local n_hi = r(N)
114.     qui count if `dvar' == 0 & !mi(`dvar')
115.     local n_lo = r(N)
116.     qui sum age_2014 if `dvar' == 1
117.     local mu_hi : dis %5.1f r(mean)
118.     qui sum age_2014 if `dvar' == 0
119.     local mu_lo : dis %5.1f r(mean)
120.     qui sum young if `dvar' == 1
