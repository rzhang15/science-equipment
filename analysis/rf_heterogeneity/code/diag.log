. * --- A6: Institution-level distribution of AVG papers PER YEAR, split by hiw_tfnd ---
. * For each institution, sum ppr_cnt across PIs by year, then average across
. * years so we get one number per institution (avg annual paper output),
. * independent of how many years each inst is observed. Compare log(1+.) across
. * hi_tfnd vs lo_tfnd institutions.
. preserve
211. cap confirm variable hiw_tfnd
212. if !_rc {
213.     gcollapse (sum) ppr_cnt (mean) hiw_tfnd ic_tfnd, by(inst_id year)
214.     gcollapse (mean) ppr_cnt (mean) hiw_tfnd ic_tfnd, by(inst_id)
215.     drop if mi(hiw_tfnd)
216.     gen double ln_ppr = ln(1 + ppr_cnt)
217. 
.     qui count if hiw_tfnd == 1
218.     local n_hi = r(N)
219.     qui count if hiw_tfnd == 0
220.     local n_lo = r(N)
221.     qui sum ppr_cnt if hiw_tfnd == 1
222.     local mu_hi : dis %8.1fc r(mean)
223.     qui sum ppr_cnt if hiw_tfnd == 0
224.     local mu_lo : dis %8.1fc r(mean)
225. 
.     tw kdensity ln_ppr if hiw_tfnd == 1, lcolor(ebblue) lwidth(medthick) || ///
>        kdensity ln_ppr if hiw_tfnd == 0, lcolor(dkorange) lwidth(medthick) ///
>        , xtitle("ln(1 + Avg Papers per Year at Institution)") ytitle("Density") ///
>          legend(order(1 "Hi Total R&D (N=`n_hi', mean=`mu_hi'/yr)" ///
>                       2 "Lo Total R&D (N=`n_lo', mean=`mu_lo'/yr)") ///
>                 pos(6) ring(1) rows(1) span size(small)) ///
>          plotregion(margin(sides))
226.     graph export ../output/figures/all_jrnls/diag_kd_ln_ppr_per_yr_by_hiw_tfnd`samp_suf'.pdf, replace
227.     di as text _n "-- inst-level avg papers per year by hiw_tfnd --" ///
>         _n "  Hi tfnd: N=`n_hi' mean=`mu_hi'/yr" ///
>         _n "  Lo tfnd: N=`n_lo' mean=`mu_lo'/yr"
228. }
229. else di as error "diag A6: hiw_tfnd not found; skipping."
230. restore
231. 
. * ============================================================
. * Part B: Joint 2x2 pooled-DiD PPML across ic chars
. * ============================================================
. gen post       = year >= 2014
232. gen Z_it       = exposure      * post
233. gen Z_share_it = mkt_spend_shr * post
234. 
. foreach wt of local wt_list {
235.     if "`wt'" == "instwtd" local hi hi
236.     else                    local hi hiw
237. 
.     tempname res
238.     postfile `res' str8 alias ///
>         double(n_yhi n_ylo n_ohi n_olo ///
>                b_yhi se_yhi b_ylo se_ylo b_ohi se_ohi b_olo se_olo ///
>                b_diff_hi se_diff_hi b_diff_ylo se_diff_ylo N ///
>                b_yhi_ns se_yhi_ns b_ylo_ns se_ylo_ns b_ohi_ns se_ohi_ns b_olo_ns se_olo_ns) ///
>         using ../temp/joint_split_`wt'_ppr_cnt`samp_suf'.dta, replace
239. 
.     foreach a of local ic_aliases {
240.         cap confirm variable `hi'_`a'
241.         if _rc {
242.             di as text "SKIP `a' `wt' -- `hi'_`a' unavailable"
243.             continue
244.         }
245.         cap drop y_hi y_lo o_hi o_lo Z_y_hi Z_y_lo Z_o_hi Z_o_lo S_y_hi S_y_lo S_o_hi S_o_lo
246.         gen byte y_hi = (young == 1 & `hi'_`a' == 1) if !mi(young) & !mi(`hi'_`a')
247.         gen byte y_lo = (young == 1 & `hi'_`a' == 0) if !mi(young) & !mi(`hi'_`a')
248.         gen byte o_hi = (young == 0 & `hi'_`a' == 1) if !mi(young) & !mi(`hi'_`a')
249.         gen byte o_lo = (young == 0 & `hi'_`a' == 0) if !mi(young) & !mi(`hi'_`a')
250. 
.         qui gunique athr_id if y_hi == 1
251.         local nyhi = r(unique)
252.         qui gunique athr_id if y_lo == 1
253.         local nylo = r(unique)
254.         qui gunique athr_id if o_hi == 1
255.         local nohi = r(unique)
256.         qui gunique athr_id if o_lo == 1
257.         local nolo = r(unique)
258. 
.         if `nyhi' < 100 | `nylo' < 100 | `nohi' < 100 | `nolo' < 100 {
259.             di as text "SKIP `a' `wt' -- thin cell (`nyhi'/`nylo'/`nohi'/`nolo')"
260.             continue
261.         }
262. 
.         gen Z_y_hi = Z_it       * y_hi
263.         gen Z_y_lo = Z_it       * y_lo
264.         gen Z_o_hi = Z_it       * o_hi
265.         gen Z_o_lo = Z_it       * o_lo
266.         gen S_y_hi = Z_share_it * y_hi
267.         gen S_y_lo = Z_share_it * y_lo
268.         gen S_o_hi = Z_share_it * o_hi
269.         gen S_o_lo = Z_share_it * o_lo
270. 
.         cap noi qui ppmlhdfe ppr_cnt Z_y_hi Z_y_lo Z_o_hi Z_o_lo S_y_hi S_y_lo S_o_hi S_o_lo, ///
>             absorb(athr_id year) vce(cluster athr_id)
271.         if _rc {
272.             di as error "FAIL `a' `wt' main -- rc=`_rc'"
273.             continue
274.         }
275.         local Nppml = e(N)
276.         local byhi  = _b[Z_y_hi]
277.         local seyhi = _se[Z_y_hi]
278.         local bylo  = _b[Z_y_lo]
279.         local seylo = _se[Z_y_lo]
280.         local bohi  = _b[Z_o_hi]
281.         local seohi = _se[Z_o_hi]
282.         local bolo  = _b[Z_o_lo]
283.         local seolo = _se[Z_o_lo]
284.         qui lincom Z_y_hi - Z_o_hi
285.         local bdh  = r(estimate)
286.         local sedh = r(se)
287.         qui lincom Z_y_hi - Z_y_lo
288.         local bdy  = r(estimate)
289.         local sedy = r(se)
290. 
.         cap noi qui ppmlhdfe ppr_cnt Z_y_hi Z_y_lo Z_o_hi Z_o_lo, ///
>             absorb(athr_id year) vce(cluster athr_id)
291.         local byhi_ns  = _b[Z_y_hi]
292.         local seyhi_ns = _se[Z_y_hi]
293.         local bylo_ns  = _b[Z_y_lo]
294.         local seylo_ns = _se[Z_y_lo]
295.         local bohi_ns  = _b[Z_o_hi]
296.         local seohi_ns = _se[Z_o_hi]
297.         local bolo_ns  = _b[Z_o_lo]
298.         local seolo_ns = _se[Z_o_lo]
299. 
.         di as text "`a' `wt': y_hi=" %6.3f `byhi' " y_lo=" %6.3f `bylo' ///
>                   " o_hi=" %6.3f `bohi' " o_lo=" %6.3f `bolo' ///
>                   "  [no-S] o_lo=" %6.3f `bolo_ns' " (se=" %5.3f `seolo_ns' ")"
300. 
.         post `res' ("`a'") (`nyhi') (`nylo') (`nohi') (`nolo') ///
>             (`byhi') (`seyhi') (`bylo') (`seylo') ///
>             (`bohi') (`seohi') (`bolo') (`seolo') ///
>             (`bdh') (`sedh') (`bdy') (`sedy') (`Nppml') ///
>             (`byhi_ns') (`seyhi_ns') (`bylo_ns') (`seylo_ns') ///
>             (`bohi_ns') (`seohi_ns') (`bolo_ns') (`seolo_ns')
301.     }
302.     postclose `res'
303. 
.     * ---- Figures for this weighting scheme ----
.     preserve
304.     use ../temp/joint_split_`wt'_ppr_cnt`samp_suf'.dta, clear
305.     gen ub_yhi = b_yhi + 1.96*se_yhi
306.     gen lb_yhi = b_yhi - 1.96*se_yhi
307.     gen ub_ohi = b_ohi + 1.96*se_ohi
308.     gen lb_ohi = b_ohi - 1.96*se_ohi
309.     gen ub_ylo = b_ylo + 1.96*se_ylo
310.     gen lb_ylo = b_ylo - 1.96*se_ylo
311.     gen ub_olo = b_olo + 1.96*se_olo
312.     gen lb_olo = b_olo - 1.96*se_olo
313. 
.     gsort b_diff_hi
314.     gen y_pos = _N + 1 - _n
315.     gen y_pos_off = y_pos - 0.2
316.     local ylabs
317.     forvalues i = 1/`=_N' {
318.         local aa = alias[`i']
319.         local pos = y_pos[`i']
320.         local ylabs `"`ylabs' `pos' "`aa'""'
321.     }
322.     local nrow = _N
323. 
.     * Cross-char coefplot: Young x Hi vs Old x Hi
.     tw rcap ub_yhi lb_yhi y_pos, horizontal lcolor(ebblue%60) msize(vsmall)     || ///
>        scatter y_pos b_yhi, mcolor(ebblue) msize(small)                          || ///
>        rcap ub_ohi lb_ohi y_pos_off, horizontal lcolor(dkorange%60) msize(vsmall)|| ///
>        scatter y_pos_off b_ohi, mcolor(dkorange) msymbol(D) msize(small) ///
>        , xline(0, lcolor(gs10) lpattern(solid)) ///
>          ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>          ytitle("") xtitle("β on Exposure x Post (ppr_cnt)", size(small)) ///
>          legend(order(2 "Young x Hi" 4 "Old x Hi") pos(11) ring(0) rows(2) size(small)) ///
>          ysize(`=max(6, `nrow'*0.5)') xsize(7) ///
>          plotregion(margin(sides))
324.     graph export ../output/figures/all_jrnls/diag_joint_`wt'_yhi_vs_ohi`samp_suf'.pdf, replace
325. 
.     * All 4 cells overlaid, one row per char
.     gen y_yhi = y_pos + 0.30
326.     gen y_ylo = y_pos + 0.10
327.     gen y_ohi = y_pos - 0.10
328.     gen y_olo = y_pos - 0.30
329.     tw rcap ub_yhi lb_yhi y_yhi, horizontal lcolor(ebblue%60) msize(vsmall)      || ///
>        scatter y_yhi b_yhi, mcolor(ebblue) msize(small)                           || ///
>        rcap ub_ylo lb_ylo y_ylo, horizontal lcolor(navy%60) msize(vsmall)         || ///
>        scatter y_ylo b_ylo, mcolor(navy) msymbol(T) msize(small)                  || ///
>        rcap ub_ohi lb_ohi y_ohi, horizontal lcolor(dkorange%60) msize(vsmall)     || ///
>        scatter y_ohi b_ohi, mcolor(dkorange) msymbol(D) msize(small)              || ///
>        rcap ub_olo lb_olo y_olo, horizontal lcolor(cranberry%60) msize(vsmall)    || ///
>        scatter y_olo b_olo, mcolor(cranberry) msymbol(S) msize(small)             ///
>        , xline(0, lcolor(gs10) lpattern(solid)) ///
>          ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>          ytitle("") xtitle("β on Exposure x Post (ppr_cnt)", size(small)) ///
>          legend(order(2 "Young x Hi" 4 "Young x Lo" 6 "Old x Hi" 8 "Old x Lo") ///
>                 pos(11) ring(0) rows(4) size(small)) ///
>          ysize(`=max(6, `nrow'*0.7)') xsize(8) ///
>          plotregion(margin(sides))
330.     graph export ../output/figures/all_jrnls/diag_joint_`wt'_4cells`samp_suf'.pdf, replace
331. 
.     * Per-char 4-cell coefplot (paper-ready, one PDF per char).
.     * Reloading results .dta each iteration to avoid nested preserve.
.     foreach a of local ic_aliases {
332.         qui use ../temp/joint_split_`wt'_ppr_cnt`samp_suf'.dta, clear
333.         qui keep if alias == "`a'"
334.         if _N == 0 continue
335.         local byhi  = b_yhi[1]
336.         local seyhi = se_yhi[1]
337.         local bylo  = b_ylo[1]
338.         local seylo = se_ylo[1]
339.         local bohi  = b_ohi[1]
340.         local seohi = se_ohi[1]
341.         local bolo  = b_olo[1]
342.         local seolo = se_olo[1]
343.         local nyhi  = n_yhi[1]
344.         local nylo  = n_ylo[1]
345.         local nohi  = n_ohi[1]
346.         local nolo  = n_olo[1]
347.         clear
348.         set obs 4
349.         gen y  = 5 - _n
350.         gen b  = .
351.         gen se = .
352.         replace b  = `byhi'  if y == 4
353.         replace se = `seyhi' if y == 4
354.         replace b  = `bylo'  if y == 3
355.         replace se = `seylo' if y == 3
356.         replace b  = `bohi'  if y == 2
357.         replace se = `seohi' if y == 2
358.         replace b  = `bolo'  if y == 1
359.         replace se = `seolo' if y == 1
360.         gen ub = b + 1.96*se
361.         gen lb = b - 1.96*se
362. 
.         tw rcap ub lb y if inlist(y, 4, 3), horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>            scatter y b if inlist(y, 4, 3), mcolor(ebblue) msize(medium)                   || ///
>            rcap ub lb y if inlist(y, 2, 1), horizontal lcolor(dkorange%70) msize(vsmall) || ///
>            scatter y b if inlist(y, 2, 1), mcolor(dkorange) msymbol(D) msize(medium)      ///
>            , xline(0, lcolor(gs10) lpattern(solid)) ///
>              ylabel(4 `"Young × Hi (N=`nyhi')"' ///
>                     3 `"Young × Lo (N=`nylo')"' ///
>                     2 `"Old × Hi (N=`nohi')"'   ///
>                     1 `"Old × Lo (N=`nolo')"',  ///
>                     angle(0) labsize(small) noticks nogrid) ///
>              ytitle("") xtitle("Exposure x Post", size(small)) ///
>              subtitle("Split on `hi'_`a'", size(small)) ///
>              legend(order(2 "Young" 4 "Old") pos(11) ring(0) rows(2) size(small)) ///
>              xsize(7) ysize(4) ///
>              plotregion(margin(sides))
363.         graph export ../output/figures/all_jrnls/coef_age_x_`a'_`wt'`samp_suf'.pdf, replace
364.     }
365.     restore
366. }
367. 
. * ============================================================
. * Part C: prppr x inst-char joint 2x2 -- hypothesis tests for
. * the "crossover" (LP x lo) cell.
. *   1. Is LP x lo_char coefficient significantly < 0 alone?
. *      If not, the crossover claim is not established.
. *   2. Blue-vs-orange at Lo row: HP x Lo - LP x Lo = 0 ?
. *      Tests whether HP differs from LP at low-intensity institutions.
. *   3. Blue-vs-orange at Hi row: HP x Hi - LP x Hi = 0 ?
. *   4. Triple interaction: (HP-LP)_Hi - (HP-LP)_Lo = 0 ?
. * Uses analytical cluster-robust SEs on athr_id via lincom. If these p-values
. * are non-significant, the wild-cluster bootstrap will not save them.
. * ============================================================
. 
. di as text _n(2) "=== Part C: crossover-test lincoms per inst char (PI-wtd cutoff) ==="
368. 
. foreach a of local ic_aliases {
369.     cap confirm variable hp_hi_`a'
370.     if _rc {
371.         di as error "  hp_hi_`a' not found; skipping."
372.         continue
373.     }
374.     foreach grp in hp_hi_`a' hp_lo_`a' lp_hi_`a' lp_lo_`a' {
375.         cap drop Z_`grp' S_`grp'
376.         gen Z_`grp' = Z_it       * `grp'
377.         gen S_`grp' = Z_share_it * `grp'
378.     }
379.     cap noi qui ppmlhdfe ppr_cnt Z_hp_hi_`a' Z_hp_lo_`a' Z_lp_hi_`a' Z_lp_lo_`a' ///
>                                  S_hp_hi_`a' S_hp_lo_`a' S_lp_hi_`a' S_lp_lo_`a', ///
>                                  absorb(athr_id year) vce(cluster athr_id)
380.     if _rc {
381.         di as error "  ppmlhdfe failed for `a'; skipping."
382.         continue
383.     }
384. 
.     di as text _n "-- `a' --"
385.     di as text "  H0: LP x Lo = 0    (is the crossover cell itself significant?)"
386.     qui lincom Z_lp_lo_`a'
387.     local b1 = r(estimate)
388.     local se1 = r(se)
389.     local t1 = `b1'/`se1'
390.     local p1 = 2*ttail(1e9, abs(`t1'))
391.     di as text "    b=" %8.4f `b1' "  se=" %6.4f `se1' "  t=" %6.2f `t1' "  p=" %5.3f `p1'
392. 
.     di as text "  H0: HP x Lo - LP x Lo = 0    (blue-vs-orange at Lo row)"
393.     qui lincom Z_hp_lo_`a' - Z_lp_lo_`a'
394.     local b2 = r(estimate)
395.     local se2 = r(se)
396.     local t2 = `b2'/`se2'
397.     local p2 = 2*ttail(1e9, abs(`t2'))
398.     di as text "    b=" %8.4f `b2' "  se=" %6.4f `se2' "  t=" %6.2f `t2' "  p=" %5.3f `p2'
399. 
.     di as text "  H0: HP x Hi - LP x Hi = 0    (blue-vs-orange at Hi row)"
400.     qui lincom Z_hp_hi_`a' - Z_lp_hi_`a'
401.     local b3 = r(estimate)
402.     local se3 = r(se)
403.     local t3 = `b3'/`se3'
404.     local p3 = 2*ttail(1e9, abs(`t3'))
405.     di as text "    b=" %8.4f `b3' "  se=" %6.4f `se3' "  t=" %6.2f `t3' "  p=" %5.3f `p3'
406. 
.     di as text "  H0: (HP-LP)_Hi - (HP-LP)_Lo = 0    (triple interaction)"
407.     qui lincom (Z_hp_hi_`a' - Z_lp_hi_`a') - (Z_hp_lo_`a' - Z_lp_lo_`a')
408.     local b4 = r(estimate)
409.     local se4 = r(se)
410.     local t4 = `b4'/`se4'
411.     local p4 = 2*ttail(1e9, abs(`t4'))
412.     di as text "    b=" %8.4f `b4' "  se=" %6.4f `se4' "  t=" %6.2f `t4' "  p=" %5.3f `p4'
413. }
414. 
. * ============================================================
. * Part D: prppr x age x inst-char joint 8-cell pooled-DiD PPML.
. * y-axis has Hi/Lo <char> rows (as in the joint_ae_prppr paired
. * coefplot); each row carries 4 dots -- LP x young, LP x old,
. * HP x young, HP x old -- from a single 8-way interaction fit.
. * ============================================================
. di as text _n(2) "=== Part D: prppr x age x inst-char 8-cell PPML (PI-wtd cutoff) ==="
415. 
. tempname resD
416. postfile `resD' str8 alias ///
>     double(n_yhphi n_ylphi n_ohphi n_olphi n_yhplo n_ylplo n_ohplo n_olplo ///
>            b_yhphi se_yhphi b_ylphi se_ylphi b_ohphi se_ohphi b_olphi se_olphi ///
>            b_yhplo se_yhplo b_ylplo se_ylplo b_ohplo se_ohplo b_olplo se_olplo ///
>            N) ///
>     using ../temp/joint_split_piwtd_prppr_age_ppr_cnt`samp_suf'.dta, replace
417. 
. foreach a of local ic_aliases {
418.     cap confirm variable hiw_`a'
419.     if _rc {
420.         di as text "SKIP `a' -- hiw_`a' unavailable"
421.         continue
422.     }
423.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
424.         cap drop _`cell' Z_`cell' S_`cell'
425.     }
426.     gen byte _yhphi = (young == 1 & high_pre_ppr == 1 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
427.     gen byte _ylphi = (young == 1 & high_pre_ppr == 0 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
428.     gen byte _ohphi = (young == 0 & high_pre_ppr == 1 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
429.     gen byte _olphi = (young == 0 & high_pre_ppr == 0 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
430.     gen byte _yhplo = (young == 1 & high_pre_ppr == 1 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
431.     gen byte _ylplo = (young == 1 & high_pre_ppr == 0 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
432.     gen byte _ohplo = (young == 0 & high_pre_ppr == 1 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
433.     gen byte _olplo = (young == 0 & high_pre_ppr == 0 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
434. 
.     local skip 0
435.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
436.         qui gunique athr_id if _`cell' == 1
437.         local n_`cell' = r(unique)
438.         if `n_`cell'' < 30 local skip 1
439.     }
440.     if `skip' {
441.         di as text "SKIP `a' -- thin cell " ///
>             "(y_hp_hi=`n_yhphi' y_lp_hi=`n_ylphi' o_hp_hi=`n_ohphi' o_lp_hi=`n_olphi' " ///
>             "y_hp_lo=`n_yhplo' y_lp_lo=`n_ylplo' o_hp_lo=`n_ohplo' o_lp_lo=`n_olplo')"
442.         continue
443.     }
444. 
.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
445.         gen Z_`cell' = Z_it       * _`cell'
446.         gen S_`cell' = Z_share_it * _`cell'
447.     }
448. 
.     cap noi qui ppmlhdfe ppr_cnt Z_yhphi Z_ylphi Z_ohphi Z_olphi ///
>                                   Z_yhplo Z_ylplo Z_ohplo Z_olplo ///
>                                   S_yhphi S_ylphi S_ohphi S_olphi ///
>                                   S_yhplo S_ylplo S_ohplo S_olplo, ///
>                                   absorb(athr_id year) vce(cluster athr_id)
449.     if _rc {
450.         di as error "FAIL `a' 8-cell ppml (rc=`_rc'); skipping."
451.         continue
452.     }
453.     local Nppml = e(N)
454.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
455.         local b_`cell'  = _b[Z_`cell']
456.         local se_`cell' = _se[Z_`cell']
457.     }
458. 
.     di as text "`a': [Hi `a'] y_hp=" %6.3f `b_yhphi' " y_lp=" %6.3f `b_ylphi' ///
>               " o_hp=" %6.3f `b_ohphi' " o_lp=" %6.3f `b_olphi' _n ///
>               _col(11) "[Lo `a'] y_hp=" %6.3f `b_yhplo' " y_lp=" %6.3f `b_ylplo' ///
>               " o_hp=" %6.3f `b_ohplo' " o_lp=" %6.3f `b_olplo'
459. 
.     post `resD' ("`a'") ///
>         (`n_yhphi') (`n_ylphi') (`n_ohphi') (`n_olphi') ///
>         (`n_yhplo') (`n_ylplo') (`n_ohplo') (`n_olplo') ///
>         (`b_yhphi') (`se_yhphi') (`b_ylphi') (`se_ylphi') ///
>         (`b_ohphi') (`se_ohphi') (`b_olphi') (`se_olphi') ///
>         (`b_yhplo') (`se_yhplo') (`b_ylplo') (`se_ylplo') ///
>         (`b_ohplo') (`se_ohplo') (`b_olplo') (`se_olplo') ///
>         (`Nppml')
460. }
461. postclose `resD'
462. 
. preserve
463. use ../temp/joint_split_piwtd_prppr_age_ppr_cnt`samp_suf'.dta, clear
464. if _N == 0 {
465.     di as error "Part D: no rows in joint_split_piwtd_prppr_age file; skipping plot."
466. }
467. else {
468.     gen char_idx = _n
469.     qui sum char_idx
470.     local nchars = r(max)
471.     gen double y_group = (`nchars' + 1 - char_idx) * 4.5
472. 
.     expand 8
473.     sort char_idx
474.     by char_idx: gen combo_idx = _n
475. 
.     gen double b_plot  = .
476.     gen double se_plot = .
477.     gen double y_plot  = .
478.     gen str3   series  = ""
479. 
.     * Two side-by-side panels split by baseline productivity (HP left, LP right);
.     * within each panel Young is blue and Old is orange, offset ±0.25 within
.     * each Hi/Lo row (young above, old below).
.     replace b_plot = b_yhphi   if combo_idx == 1
480.     replace se_plot = se_yhphi if combo_idx == 1
481.     replace y_plot = y_group + 1.2 + 0.25 if combo_idx == 1
482.     replace series = "yHP"     if combo_idx == 1
483. 
.     replace b_plot = b_ohphi   if combo_idx == 2
484.     replace se_plot = se_ohphi if combo_idx == 2
485.     replace y_plot = y_group + 1.2 - 0.25 if combo_idx == 2
486.     replace series = "oHP"     if combo_idx == 2
487. 
.     replace b_plot = b_ylphi   if combo_idx == 3
488.     replace se_plot = se_ylphi if combo_idx == 3
489.     replace y_plot = y_group + 1.2 + 0.25 if combo_idx == 3
490.     replace series = "yLP"     if combo_idx == 3
491. 
.     replace b_plot = b_olphi   if combo_idx == 4
492.     replace se_plot = se_olphi if combo_idx == 4
493.     replace y_plot = y_group + 1.2 - 0.25 if combo_idx == 4
494.     replace series = "oLP"     if combo_idx == 4
495. 
.     replace b_plot = b_yhplo   if combo_idx == 5
496.     replace se_plot = se_yhplo if combo_idx == 5
497.     replace y_plot = y_group - 1.2 + 0.25 if combo_idx == 5
498.     replace series = "yHP"     if combo_idx == 5
499. 
.     replace b_plot = b_ohplo   if combo_idx == 6
500.     replace se_plot = se_ohplo if combo_idx == 6
501.     replace y_plot = y_group - 1.2 - 0.25 if combo_idx == 6
502.     replace series = "oHP"     if combo_idx == 6
503. 
.     replace b_plot = b_ylplo   if combo_idx == 7
504.     replace se_plot = se_ylplo if combo_idx == 7
505.     replace y_plot = y_group - 1.2 + 0.25 if combo_idx == 7
506.     replace series = "yLP"     if combo_idx == 7
507. 
.     replace b_plot = b_olplo   if combo_idx == 8
508.     replace se_plot = se_olplo if combo_idx == 8
509.     replace y_plot = y_group - 1.2 - 0.25 if combo_idx == 8
510.     replace series = "oLP"     if combo_idx == 8
511. 
.     gen double ub = b_plot + 1.96*se_plot
512.     gen double lb = b_plot - 1.96*se_plot
513. 
.     local ylabs
514.     qui levelsof char_idx, local(cids)
515.     foreach cid of local cids {
516.         qui levelsof alias if char_idx == `cid' & combo_idx == 1, local(aa) clean
517.         local clbl = "`lbl_`aa''"
518.         if "`clbl'" == "" local clbl "`aa'"
519.         local base = (`nchars' + 1 - `cid') * 4.5
520.         local pos_hi = `base' + 1.2
521.         local pos_lo = `base' - 1.2
522.         local ylabs `"`ylabs' `pos_hi' "High `clbl'""'
523.         local ylabs `"`ylabs' `pos_lo' "Low `clbl'""'
524.     }
525. 
.     qui sum lb
526.     local xmin = floor(r(min)/0.5)*0.5
527.     qui sum ub
528.     local xmax = ceil(r(max)/0.5)*0.5
529. 
.     * Left panel: High Baseline Productivity PIs (Young blue, Old orange).
.     tw rcap ub lb y_plot if series == "yHP", horizontal lcolor(ebblue%50) msize(vsmall)   || ///
>        scatter y_plot b_plot if series == "yHP", mcolor(ebblue) msymbol(O) msize(small)   || ///
