. * ============================================================
. * Part B: Joint 2x2 pooled-DiD PPML across ic chars
. * ============================================================
. gen post       = year >= 2014
199. gen Z_it       = exposure      * post
200. gen Z_share_it = mkt_spend_shr * post
201. 
. foreach wt of local wt_list {
202.     if "`wt'" == "instwtd" local hi hi
203.     else                    local hi hiw
204. 
.     tempname res
205.     postfile `res' str8 alias ///
>         double(n_yhi n_ylo n_ohi n_olo ///
>                b_yhi se_yhi b_ylo se_ylo b_ohi se_ohi b_olo se_olo ///
>                b_diff_hi se_diff_hi b_diff_ylo se_diff_ylo N ///
>                b_yhi_ns se_yhi_ns b_ylo_ns se_ylo_ns b_ohi_ns se_ohi_ns b_olo_ns se_olo_ns) ///
>         using ../temp/joint_split_`wt'_ppr_cnt`samp_suf'.dta, replace
206. 
.     foreach a of local ic_aliases {
207.         cap confirm variable `hi'_`a'
208.         if _rc {
209.             di as text "SKIP `a' `wt' -- `hi'_`a' unavailable"
210.             continue
211.         }
212.         cap drop y_hi y_lo o_hi o_lo Z_y_hi Z_y_lo Z_o_hi Z_o_lo S_y_hi S_y_lo S_o_hi S_o_lo
213.         gen byte y_hi = (young == 1 & `hi'_`a' == 1) if !mi(young) & !mi(`hi'_`a')
214.         gen byte y_lo = (young == 1 & `hi'_`a' == 0) if !mi(young) & !mi(`hi'_`a')
215.         gen byte o_hi = (young == 0 & `hi'_`a' == 1) if !mi(young) & !mi(`hi'_`a')
216.         gen byte o_lo = (young == 0 & `hi'_`a' == 0) if !mi(young) & !mi(`hi'_`a')
217. 
.         qui gunique athr_id if y_hi == 1
218.         local nyhi = r(unique)
219.         qui gunique athr_id if y_lo == 1
220.         local nylo = r(unique)
221.         qui gunique athr_id if o_hi == 1
222.         local nohi = r(unique)
223.         qui gunique athr_id if o_lo == 1
224.         local nolo = r(unique)
225. 
.         if `nyhi' < 100 | `nylo' < 100 | `nohi' < 100 | `nolo' < 100 {
226.             di as text "SKIP `a' `wt' -- thin cell (`nyhi'/`nylo'/`nohi'/`nolo')"
227.             continue
228.         }
229. 
.         gen Z_y_hi = Z_it       * y_hi
230.         gen Z_y_lo = Z_it       * y_lo
231.         gen Z_o_hi = Z_it       * o_hi
232.         gen Z_o_lo = Z_it       * o_lo
233.         gen S_y_hi = Z_share_it * y_hi
234.         gen S_y_lo = Z_share_it * y_lo
235.         gen S_o_hi = Z_share_it * o_hi
236.         gen S_o_lo = Z_share_it * o_lo
237. 
.         cap noi qui ppmlhdfe ppr_cnt Z_y_hi Z_y_lo Z_o_hi Z_o_lo S_y_hi S_y_lo S_o_hi S_o_lo, ///
>             absorb(athr_id year) vce(cluster athr_id)
238.         if _rc {
239.             di as error "FAIL `a' `wt' main -- rc=`_rc'"
240.             continue
241.         }
242.         local Nppml = e(N)
243.         local byhi  = _b[Z_y_hi]
244.         local seyhi = _se[Z_y_hi]
245.         local bylo  = _b[Z_y_lo]
246.         local seylo = _se[Z_y_lo]
247.         local bohi  = _b[Z_o_hi]
248.         local seohi = _se[Z_o_hi]
249.         local bolo  = _b[Z_o_lo]
250.         local seolo = _se[Z_o_lo]
251.         qui lincom Z_y_hi - Z_o_hi
252.         local bdh  = r(estimate)
253.         local sedh = r(se)
254.         qui lincom Z_y_hi - Z_y_lo
255.         local bdy  = r(estimate)
256.         local sedy = r(se)
257. 
.         cap noi qui ppmlhdfe ppr_cnt Z_y_hi Z_y_lo Z_o_hi Z_o_lo, ///
>             absorb(athr_id year) vce(cluster athr_id)
258.         local byhi_ns  = _b[Z_y_hi]
259.         local seyhi_ns = _se[Z_y_hi]
260.         local bylo_ns  = _b[Z_y_lo]
261.         local seylo_ns = _se[Z_y_lo]
262.         local bohi_ns  = _b[Z_o_hi]
263.         local seohi_ns = _se[Z_o_hi]
264.         local bolo_ns  = _b[Z_o_lo]
265.         local seolo_ns = _se[Z_o_lo]
266. 
.         di as text "`a' `wt': y_hi=" %6.3f `byhi' " y_lo=" %6.3f `bylo' ///
>                   " o_hi=" %6.3f `bohi' " o_lo=" %6.3f `bolo' ///
>                   "  [no-S] o_lo=" %6.3f `bolo_ns' " (se=" %5.3f `seolo_ns' ")"
267. 
.         post `res' ("`a'") (`nyhi') (`nylo') (`nohi') (`nolo') ///
>             (`byhi') (`seyhi') (`bylo') (`seylo') ///
>             (`bohi') (`seohi') (`bolo') (`seolo') ///
>             (`bdh') (`sedh') (`bdy') (`sedy') (`Nppml') ///
>             (`byhi_ns') (`seyhi_ns') (`bylo_ns') (`seylo_ns') ///
>             (`bohi_ns') (`seohi_ns') (`bolo_ns') (`seolo_ns')
268.     }
269.     postclose `res'
270. 
.     * ---- Figures for this weighting scheme ----
.     preserve
271.     use ../temp/joint_split_`wt'_ppr_cnt`samp_suf'.dta, clear
272.     gen ub_yhi = b_yhi + 1.96*se_yhi
273.     gen lb_yhi = b_yhi - 1.96*se_yhi
274.     gen ub_ohi = b_ohi + 1.96*se_ohi
275.     gen lb_ohi = b_ohi - 1.96*se_ohi
276.     gen ub_ylo = b_ylo + 1.96*se_ylo
277.     gen lb_ylo = b_ylo - 1.96*se_ylo
278.     gen ub_olo = b_olo + 1.96*se_olo
279.     gen lb_olo = b_olo - 1.96*se_olo
280. 
.     gsort b_diff_hi
281.     gen y_pos = _N + 1 - _n
282.     gen y_pos_off = y_pos - 0.2
283.     local ylabs
284.     forvalues i = 1/`=_N' {
285.         local aa = alias[`i']
286.         local pos = y_pos[`i']
287.         local ylabs `"`ylabs' `pos' "`aa'""'
288.     }
289.     local nrow = _N
290. 
.     * Cross-char coefplot: Young x Hi vs Old x Hi
.     tw rcap ub_yhi lb_yhi y_pos, horizontal lcolor(ebblue%60) msize(vsmall)     || ///
>        scatter y_pos b_yhi, mcolor(ebblue) msize(small)                          || ///
>        rcap ub_ohi lb_ohi y_pos_off, horizontal lcolor(dkorange%60) msize(vsmall)|| ///
>        scatter y_pos_off b_ohi, mcolor(dkorange) msymbol(D) msize(small) ///
>        , xline(0, lcolor(gs10) lpattern(solid)) ///
>          ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>          ytitle("") xtitle("β on Exposure x Post (ppr_cnt)", size(small)) ///
>          legend(order(2 "Young x Hi" 4 "Old x Hi") pos(11) ring(0) rows(2) size(small)) ///
>          ysize(`=max(6, `nrow'*0.5)') xsize(7) ///
>          plotregion(margin(sides))
291.     graph export ../output/figures/all_jrnls/diag_joint_`wt'_yhi_vs_ohi`samp_suf'.pdf, replace
292. 
.     * All 4 cells overlaid, one row per char
.     gen y_yhi = y_pos + 0.30
293.     gen y_ylo = y_pos + 0.10
294.     gen y_ohi = y_pos - 0.10
295.     gen y_olo = y_pos - 0.30
296.     tw rcap ub_yhi lb_yhi y_yhi, horizontal lcolor(ebblue%60) msize(vsmall)      || ///
>        scatter y_yhi b_yhi, mcolor(ebblue) msize(small)                           || ///
>        rcap ub_ylo lb_ylo y_ylo, horizontal lcolor(navy%60) msize(vsmall)         || ///
>        scatter y_ylo b_ylo, mcolor(navy) msymbol(T) msize(small)                  || ///
>        rcap ub_ohi lb_ohi y_ohi, horizontal lcolor(dkorange%60) msize(vsmall)     || ///
>        scatter y_ohi b_ohi, mcolor(dkorange) msymbol(D) msize(small)              || ///
>        rcap ub_olo lb_olo y_olo, horizontal lcolor(cranberry%60) msize(vsmall)    || ///
>        scatter y_olo b_olo, mcolor(cranberry) msymbol(S) msize(small)             ///
>        , xline(0, lcolor(gs10) lpattern(solid)) ///
>          ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>          ytitle("") xtitle("β on Exposure x Post (ppr_cnt)", size(small)) ///
>          legend(order(2 "Young x Hi" 4 "Young x Lo" 6 "Old x Hi" 8 "Old x Lo") ///
>                 pos(11) ring(0) rows(4) size(small)) ///
>          ysize(`=max(6, `nrow'*0.7)') xsize(8) ///
>          plotregion(margin(sides))
297.     graph export ../output/figures/all_jrnls/diag_joint_`wt'_4cells`samp_suf'.pdf, replace
298. 
.     * Per-char 4-cell coefplot (paper-ready, one PDF per char).
.     * Reloading results .dta each iteration to avoid nested preserve.
.     foreach a of local ic_aliases {
299.         qui use ../temp/joint_split_`wt'_ppr_cnt`samp_suf'.dta, clear
300.         qui keep if alias == "`a'"
301.         if _N == 0 continue
302.         local byhi  = b_yhi[1]
303.         local seyhi = se_yhi[1]
304.         local bylo  = b_ylo[1]
305.         local seylo = se_ylo[1]
306.         local bohi  = b_ohi[1]
307.         local seohi = se_ohi[1]
308.         local bolo  = b_olo[1]
309.         local seolo = se_olo[1]
310.         local nyhi  = n_yhi[1]
311.         local nylo  = n_ylo[1]
312.         local nohi  = n_ohi[1]
313.         local nolo  = n_olo[1]
314.         clear
315.         set obs 4
316.         gen y  = 5 - _n
317.         gen b  = .
318.         gen se = .
319.         replace b  = `byhi'  if y == 4
320.         replace se = `seyhi' if y == 4
321.         replace b  = `bylo'  if y == 3
322.         replace se = `seylo' if y == 3
323.         replace b  = `bohi'  if y == 2
324.         replace se = `seohi' if y == 2
325.         replace b  = `bolo'  if y == 1
326.         replace se = `seolo' if y == 1
327.         gen ub = b + 1.96*se
328.         gen lb = b - 1.96*se
329. 
.         tw rcap ub lb y if inlist(y, 4, 3), horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>            scatter y b if inlist(y, 4, 3), mcolor(ebblue) msize(medium)                   || ///
>            rcap ub lb y if inlist(y, 2, 1), horizontal lcolor(dkorange%70) msize(vsmall) || ///
>            scatter y b if inlist(y, 2, 1), mcolor(dkorange) msymbol(D) msize(medium)      ///
>            , xline(0, lcolor(gs10) lpattern(solid)) ///
>              ylabel(4 `"Young × Hi (N=`nyhi')"' ///
>                     3 `"Young × Lo (N=`nylo')"' ///
>                     2 `"Old × Hi (N=`nohi')"'   ///
>                     1 `"Old × Lo (N=`nolo')"',  ///
>                     angle(0) labsize(small) noticks nogrid) ///
>              ytitle("") xtitle("Exposure x Post", size(small)) ///
>              subtitle("Split on `hi'_`a'", size(small)) ///
>              legend(order(2 "Young" 4 "Old") pos(11) ring(0) rows(2) size(small)) ///
>              xsize(7) ysize(4) ///
>              plotregion(margin(sides))
330.         graph export ../output/figures/all_jrnls/coef_age_x_`a'_`wt'`samp_suf'.pdf, replace
331.     }
332.     restore
333. }
334. 
. * ============================================================
. * Part C: prppr x inst-char joint 2x2 -- hypothesis tests for
. * the "crossover" (LP x lo) cell.
. *   1. Is LP x lo_char coefficient significantly < 0 alone?
. *      If not, the crossover claim is not established.
. *   2. Blue-vs-orange at Lo row: HP x Lo - LP x Lo = 0 ?
. *      Tests whether HP differs from LP at low-intensity institutions.
. *   3. Blue-vs-orange at Hi row: HP x Hi - LP x Hi = 0 ?
. *   4. Triple interaction: (HP-LP)_Hi - (HP-LP)_Lo = 0 ?
. * Uses analytical cluster-robust SEs on athr_id via lincom. If these p-values
. * are non-significant, the wild-cluster bootstrap will not save them.
. * ============================================================
. 
. di as text _n(2) "=== Part C: crossover-test lincoms per inst char (PI-wtd cutoff) ==="
335. 
. foreach a of local ic_aliases {
336.     cap confirm variable hp_hi_`a'
337.     if _rc {
338.         di as error "  hp_hi_`a' not found; skipping."
339.         continue
340.     }
341.     foreach grp in hp_hi_`a' hp_lo_`a' lp_hi_`a' lp_lo_`a' {
342.         cap drop Z_`grp' S_`grp'
343.         gen Z_`grp' = Z_it       * `grp'
344.         gen S_`grp' = Z_share_it * `grp'
345.     }
346.     cap noi qui ppmlhdfe ppr_cnt Z_hp_hi_`a' Z_hp_lo_`a' Z_lp_hi_`a' Z_lp_lo_`a' ///
>                                  S_hp_hi_`a' S_hp_lo_`a' S_lp_hi_`a' S_lp_lo_`a', ///
>                                  absorb(athr_id year) vce(cluster athr_id)
347.     if _rc {
348.         di as error "  ppmlhdfe failed for `a'; skipping."
349.         continue
350.     }
351. 
.     di as text _n "-- `a' --"
352.     di as text "  H0: LP x Lo = 0    (is the crossover cell itself significant?)"
353.     qui lincom Z_lp_lo_`a'
354.     local b1 = r(estimate)
355.     local se1 = r(se)
356.     local t1 = `b1'/`se1'
357.     local p1 = 2*ttail(1e9, abs(`t1'))
358.     di as text "    b=" %8.4f `b1' "  se=" %6.4f `se1' "  t=" %6.2f `t1' "  p=" %5.3f `p1'
359. 
.     di as text "  H0: HP x Lo - LP x Lo = 0    (blue-vs-orange at Lo row)"
360.     qui lincom Z_hp_lo_`a' - Z_lp_lo_`a'
361.     local b2 = r(estimate)
362.     local se2 = r(se)
363.     local t2 = `b2'/`se2'
364.     local p2 = 2*ttail(1e9, abs(`t2'))
365.     di as text "    b=" %8.4f `b2' "  se=" %6.4f `se2' "  t=" %6.2f `t2' "  p=" %5.3f `p2'
366. 
.     di as text "  H0: HP x Hi - LP x Hi = 0    (blue-vs-orange at Hi row)"
367.     qui lincom Z_hp_hi_`a' - Z_lp_hi_`a'
368.     local b3 = r(estimate)
369.     local se3 = r(se)
370.     local t3 = `b3'/`se3'
371.     local p3 = 2*ttail(1e9, abs(`t3'))
372.     di as text "    b=" %8.4f `b3' "  se=" %6.4f `se3' "  t=" %6.2f `t3' "  p=" %5.3f `p3'
373. 
.     di as text "  H0: (HP-LP)_Hi - (HP-LP)_Lo = 0    (triple interaction)"
374.     qui lincom (Z_hp_hi_`a' - Z_lp_hi_`a') - (Z_hp_lo_`a' - Z_lp_lo_`a')
375.     local b4 = r(estimate)
376.     local se4 = r(se)
377.     local t4 = `b4'/`se4'
378.     local p4 = 2*ttail(1e9, abs(`t4'))
379.     di as text "    b=" %8.4f `b4' "  se=" %6.4f `se4' "  t=" %6.2f `t4' "  p=" %5.3f `p4'
380. }
381. 
. * ============================================================
. * Part D: prppr x age x inst-char joint 8-cell pooled-DiD PPML.
. * y-axis has Hi/Lo <char> rows (as in the joint_ae_prppr paired
. * coefplot); each row carries 4 dots -- LP x young, LP x old,
. * HP x young, HP x old -- from a single 8-way interaction fit.
. * ============================================================
. di as text _n(2) "=== Part D: prppr x age x inst-char 8-cell PPML (PI-wtd cutoff) ==="
382. 
. tempname resD
383. postfile `resD' str8 alias ///
>     double(n_yhphi n_ylphi n_ohphi n_olphi n_yhplo n_ylplo n_ohplo n_olplo ///
>            b_yhphi se_yhphi b_ylphi se_ylphi b_ohphi se_ohphi b_olphi se_olphi ///
>            b_yhplo se_yhplo b_ylplo se_ylplo b_ohplo se_ohplo b_olplo se_olplo ///
>            N) ///
>     using ../temp/joint_split_piwtd_prppr_age_ppr_cnt`samp_suf'.dta, replace
384. 
. foreach a of local ic_aliases {
385.     cap confirm variable hiw_`a'
386.     if _rc {
387.         di as text "SKIP `a' -- hiw_`a' unavailable"
388.         continue
389.     }
390.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
391.         cap drop _`cell' Z_`cell' S_`cell'
392.     }
393.     gen byte _yhphi = (young == 1 & high_pre_ppr == 1 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
394.     gen byte _ylphi = (young == 1 & high_pre_ppr == 0 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
395.     gen byte _ohphi = (young == 0 & high_pre_ppr == 1 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
396.     gen byte _olphi = (young == 0 & high_pre_ppr == 0 & hiw_`a' == 1) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
397.     gen byte _yhplo = (young == 1 & high_pre_ppr == 1 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
398.     gen byte _ylplo = (young == 1 & high_pre_ppr == 0 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
399.     gen byte _ohplo = (young == 0 & high_pre_ppr == 1 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
400.     gen byte _olplo = (young == 0 & high_pre_ppr == 0 & hiw_`a' == 0) if !mi(young) & !mi(high_pre_ppr) & !mi(hiw_`a')
401. 
.     local skip 0
402.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
403.         qui gunique athr_id if _`cell' == 1
404.         local n_`cell' = r(unique)
405.         if `n_`cell'' < 30 local skip 1
406.     }
407.     if `skip' {
408.         di as text "SKIP `a' -- thin cell " ///
>             "(y_hp_hi=`n_yhphi' y_lp_hi=`n_ylphi' o_hp_hi=`n_ohphi' o_lp_hi=`n_olphi' " ///
>             "y_hp_lo=`n_yhplo' y_lp_lo=`n_ylplo' o_hp_lo=`n_ohplo' o_lp_lo=`n_olplo')"
409.         continue
410.     }
411. 
.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
412.         gen Z_`cell' = Z_it       * _`cell'
413.         gen S_`cell' = Z_share_it * _`cell'
414.     }
415. 
.     cap noi qui ppmlhdfe ppr_cnt Z_yhphi Z_ylphi Z_ohphi Z_olphi ///
>                                   Z_yhplo Z_ylplo Z_ohplo Z_olplo ///
>                                   S_yhphi S_ylphi S_ohphi S_olphi ///
>                                   S_yhplo S_ylplo S_ohplo S_olplo, ///
>                                   absorb(athr_id year) vce(cluster athr_id)
416.     if _rc {
417.         di as error "FAIL `a' 8-cell ppml (rc=`_rc'); skipping."
418.         continue
419.     }
420.     local Nppml = e(N)
421.     foreach cell in yhphi ylphi ohphi olphi yhplo ylplo ohplo olplo {
422.         local b_`cell'  = _b[Z_`cell']
423.         local se_`cell' = _se[Z_`cell']
424.     }
425. 
.     di as text "`a': [Hi `a'] y_hp=" %6.3f `b_yhphi' " y_lp=" %6.3f `b_ylphi' ///
>               " o_hp=" %6.3f `b_ohphi' " o_lp=" %6.3f `b_olphi' _n ///
>               _col(11) "[Lo `a'] y_hp=" %6.3f `b_yhplo' " y_lp=" %6.3f `b_ylplo' ///
>               " o_hp=" %6.3f `b_ohplo' " o_lp=" %6.3f `b_olplo'
426. 
.     post `resD' ("`a'") ///
>         (`n_yhphi') (`n_ylphi') (`n_ohphi') (`n_olphi') ///
>         (`n_yhplo') (`n_ylplo') (`n_ohplo') (`n_olplo') ///
>         (`b_yhphi') (`se_yhphi') (`b_ylphi') (`se_ylphi') ///
>         (`b_ohphi') (`se_ohphi') (`b_olphi') (`se_olphi') ///
>         (`b_yhplo') (`se_yhplo') (`b_ylplo') (`se_ylplo') ///
>         (`b_ohplo') (`se_ohplo') (`b_olplo') (`se_olplo') ///
>         (`Nppml')
427. }
428. postclose `resD'
429. 
. preserve
430. use ../temp/joint_split_piwtd_prppr_age_ppr_cnt`samp_suf'.dta, clear
431. if _N == 0 {
432.     di as error "Part D: no rows in joint_split_piwtd_prppr_age file; skipping plot."
433. }
434. else {
435.     gen char_idx = _n
436.     qui sum char_idx
437.     local nchars = r(max)
438.     gen double y_group = (`nchars' + 1 - char_idx) * 4.5
439. 
.     expand 8
440.     sort char_idx
441.     by char_idx: gen combo_idx = _n
442. 
.     gen double b_plot  = .
443.     gen double se_plot = .
444.     gen double y_plot  = .
445.     gen str3   series  = ""
446. 
.     * Two side-by-side panels split by baseline productivity (HP left, LP right);
.     * within each panel Young is blue and Old is orange, offset ±0.25 within
.     * each Hi/Lo row (young above, old below).
.     replace b_plot = b_yhphi   if combo_idx == 1
447.     replace se_plot = se_yhphi if combo_idx == 1
448.     replace y_plot = y_group + 1.2 + 0.25 if combo_idx == 1
449.     replace series = "yHP"     if combo_idx == 1
450. 
.     replace b_plot = b_ohphi   if combo_idx == 2
451.     replace se_plot = se_ohphi if combo_idx == 2
452.     replace y_plot = y_group + 1.2 - 0.25 if combo_idx == 2
453.     replace series = "oHP"     if combo_idx == 2
454. 
.     replace b_plot = b_ylphi   if combo_idx == 3
455.     replace se_plot = se_ylphi if combo_idx == 3
456.     replace y_plot = y_group + 1.2 + 0.25 if combo_idx == 3
457.     replace series = "yLP"     if combo_idx == 3
458. 
.     replace b_plot = b_olphi   if combo_idx == 4
459.     replace se_plot = se_olphi if combo_idx == 4
460.     replace y_plot = y_group + 1.2 - 0.25 if combo_idx == 4
461.     replace series = "oLP"     if combo_idx == 4
462. 
.     replace b_plot = b_yhplo   if combo_idx == 5
463.     replace se_plot = se_yhplo if combo_idx == 5
464.     replace y_plot = y_group - 1.2 + 0.25 if combo_idx == 5
465.     replace series = "yHP"     if combo_idx == 5
466. 
.     replace b_plot = b_ohplo   if combo_idx == 6
467.     replace se_plot = se_ohplo if combo_idx == 6
468.     replace y_plot = y_group - 1.2 - 0.25 if combo_idx == 6
469.     replace series = "oHP"     if combo_idx == 6
470. 
.     replace b_plot = b_ylplo   if combo_idx == 7
471.     replace se_plot = se_ylplo if combo_idx == 7
472.     replace y_plot = y_group - 1.2 + 0.25 if combo_idx == 7
473.     replace series = "yLP"     if combo_idx == 7
474. 
.     replace b_plot = b_olplo   if combo_idx == 8
475.     replace se_plot = se_olplo if combo_idx == 8
476.     replace y_plot = y_group - 1.2 - 0.25 if combo_idx == 8
477.     replace series = "oLP"     if combo_idx == 8
478. 
.     gen double ub = b_plot + 1.96*se_plot
479.     gen double lb = b_plot - 1.96*se_plot
480. 
.     local ylabs
481.     qui levelsof char_idx, local(cids)
482.     foreach cid of local cids {
483.         qui levelsof alias if char_idx == `cid' & combo_idx == 1, local(aa) clean
484.         local clbl = "`lbl_`aa''"
485.         if "`clbl'" == "" local clbl "`aa'"
486.         local base = (`nchars' + 1 - `cid') * 4.5
487.         local pos_hi = `base' + 1.2
488.         local pos_lo = `base' - 1.2
489.         local ylabs `"`ylabs' `pos_hi' "High `clbl'""'
490.         local ylabs `"`ylabs' `pos_lo' "Low `clbl'""'
491.     }
492. 
.     qui sum lb
493.     local xmin = floor(r(min)/0.5)*0.5
494.     qui sum ub
495.     local xmax = ceil(r(max)/0.5)*0.5
496. 
.     * Left panel: High Baseline Productivity PIs (Young blue, Old orange).
.     tw rcap ub lb y_plot if series == "yHP", horizontal lcolor(ebblue%50) msize(vsmall)   || ///
>        scatter y_plot b_plot if series == "yHP", mcolor(ebblue) msymbol(O) msize(small)   || ///
>        rcap ub lb y_plot if series == "oHP", horizontal lcolor(dkorange%50) msize(vsmall) || ///
>        scatter y_plot b_plot if series == "oHP", mcolor(dkorange) msymbol(O) msize(small)  ///
>        , xline(0, lcolor(gs10) lpattern(solid)) ///
>          ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>          ytitle("") xtitle("Exposure x Post", size(small)) ///
>          xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>          subtitle("High Baseline Productivity", size(small)) ///
>          legend(off) ///
>          yscale(range(3.04 .)) ///
>          plotregion(margin(l=zero r=zero b=zero t=vsmall)) ///
>          graphregion(margin(r=0)) ///
>          name(g_hp, replace) nodraw
497. 
.     * Right panel: Low Baseline Productivity PIs (Young blue, Old orange).
.     * Invisible (white) y-labels reserve the same horizontal space as the left
.     * panel so plot widths match; graphregion(margin(l=0)) pulls the reserved
.     * strip flush to the cell edge to minimise the visible gap between panels.
.     tw rcap ub lb y_plot if series == "yLP", horizontal lcolor(ebblue%50) msize(vsmall)   || ///
>        scatter y_plot b_plot if series == "yLP", mcolor(ebblue) msymbol(O) msize(small)   || ///
>        rcap ub lb y_plot if series == "oLP", horizontal lcolor(dkorange%50) msize(vsmall) || ///
>        scatter y_plot b_plot if series == "oLP", mcolor(dkorange) msymbol(O) msize(small)  ///
>        , xline(0, lcolor(gs10) lpattern(solid)) ///
>          ylabel(`ylabs', angle(0) labsize(small) labcolor(white) noticks nogrid) ///
>          ytitle("") xtitle("Exposure x Post", size(small)) ///
>          xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>          subtitle("Low Baseline Productivity", size(small)) ///
>          legend(order(2 "Early-Career" 4 "Late-Career") ///
>                 pos(6) ring(1) rows(1) span size(small)) ///
>          yscale(noline range(3.04 .)) ///
>          plotregion(margin(l=zero r=zero b=zero t=vsmall)) ///
>          graphregion(margin(l=0)) ///
>          name(g_lp, replace) nodraw
498. 
