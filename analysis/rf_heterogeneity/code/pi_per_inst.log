. di as text "  Hi tfnd: mean=" %5.2f r(mean) "  p50=" %5.1f r(p50)
  Hi tfnd: mean= 9.73  p50=  8.0

. qui sum pre_ppr_cnt_sum if athr_indicator == 1 & hiw_tfnd == 0, d

. di as text "  Lo tfnd: mean=" %5.2f r(mean) "  p50=" %5.1f r(p50)
  Lo tfnd: mean= 9.30  p50=  8.0

. 
. * Share HP at each type of inst
. di as text _n "Share HP (above overall PI-level median) by inst type:"

Share HP (above overall PI-level median) by inst type:

. qui sum high_pre_ppr if athr_indicator == 1 & hiw_tfnd == 1

. di as text "  Hi tfnd: share HP=" %5.3f r(mean)
  Hi tfnd: share HP=0.547

. qui sum high_pre_ppr if athr_indicator == 1 & hiw_tfnd == 0

