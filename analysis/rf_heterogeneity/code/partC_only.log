. local ic_aliases tfnd fedf instf lsf fdls endow basx applx

. 
. use ../temp/es_all_jrnls_r1_r2_public, clear

. gen post       = year >= 2014

. gen Z_it       = exposure      * post

. gen Z_share_it = mkt_spend_shr * post

. 
. di as text _n(2) "=== Part C: crossover-test lincoms per inst char (PI-wtd cu
> toff) ==="


=== Part C: crossover-test lincoms per inst char (PI-wtd cutoff) ===

. 
. foreach a of local ic_aliases {
  2.     cap confirm variable hp_hi_`a'
  3.     if _rc {
  4.         di as error "  hp_hi_`a' not found; skipping."
  5.         continue
  6.     }
  7.     foreach grp in hp_hi_`a' hp_lo_`a' lp_hi_`a' lp_lo_`a' {
  8.         cap drop Z_`grp' S_`grp'
  9.         gen Z_`grp' = Z_it       * `grp'
 10.         gen S_`grp' = Z_share_it * `grp'
 11.     }
 12.     cap noi qui ppmlhdfe ppr_cnt Z_hp_hi_`a' Z_hp_lo_`a' Z_lp_hi_`a' Z_lp_
> lo_`a' ///
>                                  S_hp_hi_`a' S_hp_lo_`a' S_lp_hi_`a' S_lp_lo_
> `a', ///
>                                  absorb(athr_id year) vce(cluster athr_id)
 13.     if _rc {
 14.         di as error "  ppmlhdfe failed for `a'; skipping."
 15.         continue
 16.     }
 17.     di as text _n "-- `a' --"
 18.     qui lincom Z_lp_lo_`a'
 19.     di as text "  H0: LP x Lo = 0             b=" %8.4f r(estimate) "  se=
> " %6.4f r(se) "  t=" %6.2f r(estimate)/r(se) "  p=" %5.3f 2*ttail(1e9, abs(r(
> estimate)/r(se)))
 20.     qui lincom Z_hp_lo_`a' - Z_lp_lo_`a'
 21.     di as text "  H0: HP-LP at Lo = 0         b=" %8.4f r(estimate) "  se=
> " %6.4f r(se) "  t=" %6.2f r(estimate)/r(se) "  p=" %5.3f 2*ttail(1e9, abs(r(
> estimate)/r(se)))
 22.     qui lincom Z_hp_hi_`a' - Z_lp_hi_`a'
 23.     di as text "  H0: HP-LP at Hi = 0         b=" %8.4f r(estimate) "  se=
> " %6.4f r(se) "  t=" %6.2f r(estimate)/r(se) "  p=" %5.3f 2*ttail(1e9, abs(r(
> estimate)/r(se)))
 24.     qui lincom (Z_hp_hi_`a' - Z_lp_hi_`a') - (Z_hp_lo_`a' - Z_lp_lo_`a')
 25.     di as text "  H0: triple = 0              b=" %8.4f r(estimate) "  se=
> " %6.4f r(se) "  t=" %6.2f r(estimate)/r(se) "  p=" %5.3f 2*ttail(1e9, abs(r(
> estimate)/r(se)))
 26. }
