. qui count if athr_indicator == 1 & y_shorttrain == 1

. di as text "short training (<= `train_med' yrs): " r(N)
short training (<= 5 yrs): 3511

. qui sum train_yrs if athr_indicator == 1 & y_longtrain == 1

. di as text "  mean yrs long = " %5.2f r(mean)
  mean yrs long = 11.13

. qui sum train_yrs if athr_indicator == 1 & y_shorttrain == 1

. di as text "  mean yrs short = " %5.2f r(mean)
  mean yrs short =  1.85

. qui sum min_year if athr_indicator == 1 & y_longtrain == 1

. di as text "  mean first last-author yr long = " %6.1f r(mean)
  mean first last-author yr long = 2006.5

. qui sum min_year if athr_indicator == 1 & y_shorttrain == 1

. di as text "  mean first last-author yr short = " %6.1f r(mean)
  mean first last-author yr short = 2005.7

. 
. gen post       = year >= 2014

. gen Z_it       = exposure      * post

. gen Z_share_it = mkt_spend_shr * post

. foreach pair in "y_longtrain y_shorttrain" {
  2.     local g1 : word 1 of `pair'
  3.     local g2 : word 2 of `pair'
  4.     gen Z_`g1'  = Z_it       * `g1'
  5.     gen Z_`g2'  = Z_it       * `g2'
  6.     gen S_`g1'  = Z_share_it * `g1'
  7.     gen S_`g2'  = Z_share_it * `g2'
  8.     gen PT_`g1' = post * `g1'
  9.     ppmlhdfe ppr_cnt Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', absorb(athr_id y
> ear) vce(cluster athr_id)
 10.     gunique athr_id if e(sample)
 11.     local npi = r(unique)
 12.     lincom Z_`g1' - Z_`g2'
 13.     di as result _n "== `pair': N=" e(N) " PIs=`npi'"
 14.     di as result "   `g1' = " %7.4f _b[Z_`g1'] " (" %6.4f _se[Z_`g1'] ")"
 15.     di as result "   `g2' = " %7.4f _b[Z_`g2'] " (" %6.4f _se[Z_`g2'] ")"
 16.     di as result "   diff = " %7.4f r(estimate) " (" %6.4f r(se) ")  p=" %
> 5.3f r(p)
 17. }
