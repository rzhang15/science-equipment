 opened on:   6 Aug 2026, 02:05:45

. 
. local samp   all_jrnls

. local sufs   _r1_r2 _r1_r2_public

. local fes    athr_id year

. local vce_cl athr_id

. local yvars  ppr_cnt cite_affl_wt

. 
. cap mkdir "../output/figures/`samp'"

. cap mkdir "../output/figures/`samp'/es_ppml"

. cap mkdir "../output/tables/`samp'"

. 
. global LBL_y_mg "Early-Career Scientists x Multiple NIH Grants at Baseline"

. global LBL_y_sg "Early-Career Scientists x Single NIH Grant at Baseline"

. global LBL_o_mg "Late-Career Scientists x Multiple NIH Grants at Baseline"

. global LBL_o_sg "Late-Career Scientists x Single NIH Grant at Baseline"

. 
. * Grant diversification at baseline: max number of NIH projects held
. * concurrently in any FY2010-2013 (distinct full_project_num per athr-FY).
. * multi = ever >= 2 overlapping awards pre-merger; single = never more than 1.
. * Restricted to PIs with at least one FY2010-2013 award: an unmatched PI's
. * zero is a failed name match and a matched PI funded only post-2013 was not
. * an NIH PI pre-merger, so neither is a single-grant lab. A grant-PI pair can
. * appear twice when the same name matches twice in pi_names, hence the dedup.
. use athr_id grant_id full_project_num fy using ../external/nih/nih_grants_by_athr_id, clear

. duplicates drop athr_id grant_id, force

Duplicates in terms of athr_id grant_id

(152 observations deleted)

. keep if inrange(fy, 2010, 2013)
(303,363 observations deleted)

. bys athr_id fy full_project_num: gen byte proj = _n == 1

. gcollapse (sum) n_active = proj, by(athr_id fy) fast

. gcollapse (max) max_active = n_active, by(athr_id) fast

. save ../temp/nih_pre_ngrants, replace
(file ../temp/nih_pre_ngrants.dta not found)
file ../temp/nih_pre_ngrants.dta saved

. 
. foreach suf of local sufs {
  2. 
. di as text _n(2) "################ run_age_ngrants: `samp'`suf' ################"
  3. 
. cap confirm file ../temp/es_`samp'`suf'.dta
  4. if _rc {
  5.     di as error "run_age_ngrants: ../temp/es_`samp'`suf'.dta not found -- run add_het_splits for this sample first; skipping."
  6.     continue
  7. }
  8. use ../temp/es_`samp'`suf', clear
  9. 
. cap confirm variable young
 10. if _rc {
 11.     di as error "run_age_ngrants`suf': young not in panel -- rerun add_het_splits; skipping."
 12.     continue
 13. }
 14. 
. cap drop _merge
 15. merge m:1 athr_id using ../temp/nih_pre_ngrants, keep(1 3)
 16. gen byte multi_g = max_active >= 2 if _merge == 3
 17. drop _merge
 18. 
. * 2x2 cells; missing off the pre-funded NIH sample, so every fit below drops
. * ineligible PIs rather than pooling them into the base category.
. gen byte y_mg = (young == 1 & multi_g == 1) if !mi(young) & !mi(multi_g)
 19. gen byte y_sg = (young == 1 & multi_g == 0) if !mi(young) & !mi(multi_g)
 20. gen byte o_mg = (young == 0 & multi_g == 1) if !mi(young) & !mi(multi_g)
 21. gen byte o_sg = (young == 0 & multi_g == 0) if !mi(young) & !mi(multi_g)
 22. 
. local skip 0
 23. foreach grp in y_mg y_sg o_mg o_sg {
 24.     qui sum `grp'
 25.     if r(N) == 0 | r(max) == 0 {
 26.         di as error "run_age_ngrants`suf': cell `grp' empty -- skipping this sample."
 27.         local skip 1
 28.     }
 29.     cap drop _tag
 30.     egen byte _tag = tag(athr_id) if `grp' == 1
 31.     qui count if _tag == 1
 32.     di as text "run_age_ngrants`suf': cell `grp' PIs = " r(N)
 33. }
 34. cap drop _tag
 35. if `skip' continue
 36. 
. gen rel = year - 2014
 37. qui sum rel, d
 38. local abs_lag  = abs(r(max))
 39. local abs_lead = abs(r(min))
 40. 
. forval i = 1/`abs_lead' {
 41.     gen int_lead`i'  = exposure      if rel == -`i'
 42.     gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 43. }
 44. forval i = 0/`abs_lag' {
 45.     gen int_lag`i'  = exposure      if rel == `i'
 46.     gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 47. }
 48. ds int_lead* int_lag* mshr_lead* mshr_lag*
 49. foreach var in `r(varlist)' {
 50.     replace `var' = 0 if mi(`var')
 51. }
 52. local int_leads
 53. local mshr_leads
 54. local int_lags
 55. local mshr_lags
 56. forval i = 2/`abs_lead' {
 57.     local int_leads  int_lead`i'  `int_leads'
 58.     local mshr_leads mshr_lead`i' `mshr_leads'
 59. }
 60. forval i = 0/`abs_lag' {
 61.     local int_lags  `int_lags'  int_lag`i'
 62.     local mshr_lags `mshr_lags' mshr_lag`i'
 63. }
 64. 
. gen post       = year >= 2014
 65. gen Z_it       = exposure      * post
 66. gen Z_share_it = mkt_spend_shr * post
 67. 
. foreach grp in y_mg y_sg o_mg o_sg {
 68.     * cleared per suffix: these accumulate, and stale terms from the
.     * previous sample would enter the next sample's ES spec.
.     local leads_`grp'
 69.     local lags_`grp'
 70.     local mleads_`grp'
 71.     local mlags_`grp'
 72.     foreach v of local int_leads {
 73.         gen `v'_`grp' = `v' * `grp'
 74.         local leads_`grp' `leads_`grp'' `v'_`grp'
 75.     }
 76.     foreach v of local int_lags {
 77.         gen `v'_`grp' = `v' * `grp'
 78.         local lags_`grp' `lags_`grp'' `v'_`grp'
 79.     }
 80.     foreach v of local mshr_leads {
 81.         gen `v'_`grp' = `v' * `grp'
 82.         local mleads_`grp' `mleads_`grp'' `v'_`grp'
 83.     }
 84.     foreach v of local mshr_lags {
 85.         gen `v'_`grp' = `v' * `grp'
 86.         local mlags_`grp' `mlags_`grp'' `v'_`grp'
 87.     }
 88.     gen int_lead1_`grp' = int_lead1 * `grp'
 89.     gen Z_`grp'  = Z_it       * `grp'
 90.     gen S_`grp'  = Z_share_it * `grp'
 91.     gen PT_`grp' = post       * `grp'
 92. }
 93. 
. tempname ph
 94. postfile `ph' str30 yvar str24 grp str24 split_type ///
>     double(post_b post_se p N r2_p n_pis) ///
>     using "../temp/age_ngrants_results`suf'", replace
 95. 
. foreach yvar of local yvars {
 96.     local ylab "`yvar'"
 97.     if "`yvar'" == "ppr_cnt"      local ylab "Publications"
 98.     if "`yvar'" == "cite_affl_wt" local ylab "Citation-Weighted Output"
 99.     local gap = cond(regexm("`yvar'", "^cite_affl_wt"), 0.2, 0.1)
100. 
.     di as text _n "==== pooled DiD PPML 2x2 age x ngrants: `yvar' (`suf') ===="
101.     * o_sg x post is the omitted base
.     cap noi ppmlhdfe `yvar' Z_y_mg Z_y_sg Z_o_mg Z_o_sg ///
>                             S_y_mg S_y_sg S_o_mg S_o_sg ///
>                             PT_y_mg PT_y_sg PT_o_mg, ///
>         absorb(`fes') vce(cluster `vce_cl')
102.     if _rc {
103.         di as error "run_age_ngrants`suf': pooled DiD `yvar' failed; skipping."
104.         continue
105.     }
106.     local Nppml  = e(N)
107.     local r2ppml = e(r2_p)
108.     foreach grp in y_mg y_sg o_mg o_sg {
109.         gunique athr_id if e(sample) & `grp' == 1
110.         local n_pis = r(unique)
111.         gunique inst_id if e(sample) & `grp' == 1
112.         local n_insts = r(unique)
113.         local b  = _b[Z_`grp']
114.         local se = _se[Z_`grp']
115.         di as text "PDID `yvar' `grp': b=" %8.4f `b' " se=" %8.4f `se' ///
>             "  N=" %9.0f `Nppml' " PIs=`n_pis' Insts=`n_insts'"
116.         post `ph' ("`yvar'") ("`grp'") ("joint_agengrants") ///
>             (`b') (`se') (.) (`Nppml') (`r2ppml') (`n_pis')
117.     }
118.     * Multi-vs-single grant within age and young-vs-old within grant tier.
.     foreach d in "y_diff_ng Z_y_mg Z_y_sg" "o_diff_ng Z_o_mg Z_o_sg" ///
>                  "mg_diff_age Z_y_mg Z_o_mg" "sg_diff_age Z_y_sg Z_o_sg" {
119.         local dname : word 1 of `d'
120.         local d1    : word 2 of `d'
121.         local d2    : word 3 of `d'
122.         cap noi lincom `d1' - `d2'
123.         if _rc continue
124.         local b_diff  = r(estimate)
125.         local se_diff = r(se)
126.         local p_diff  = r(p)
127.         di as text "DIFF `yvar' `dname': b=" %8.4f `b_diff' ///
>             " se=" %8.4f `se_diff' " p=" %6.4f `p_diff'
128.         post `ph' ("`yvar'") ("`dname'") ("joint_agengrants_diff") ///
>             (`b_diff') (`se_diff') (`p_diff') (`Nppml') (`r2ppml') (.)
129.     }
130. 
.     di as text _n "==== event study PPML 2x2 age x ngrants: `yvar' (`suf') ===="
131.     cap noi ppmlhdfe `yvar' ///
>         `leads_y_mg' `lags_y_mg' `leads_y_sg' `lags_y_sg' ///
>         `leads_o_mg' `lags_o_mg' `leads_o_sg' `lags_o_sg' ///
>         `mleads_y_mg' `mlags_y_mg' `mleads_y_sg' `mlags_y_sg' ///
>         `mleads_o_mg' `mlags_o_mg' `mleads_o_sg' `mlags_o_sg' ///
>         PT_y_mg PT_y_sg PT_o_mg, ///
>         absorb(`fes') vce(cluster `vce_cl')
132.     if _rc {
133.         di as error "run_age_ngrants`suf': ES `yvar' failed; skipping plots."
134.         continue
135.     }
136.     foreach grp in y_mg y_sg o_mg o_sg {
137.         local grp_label = "${LBL_`grp'}"
138.         gunique athr_id if e(sample) & `grp' == 1
139.         local num_athrs = r(unique)
140.         gunique inst_id if e(sample) & `grp' == 1
141.         local num_insts = r(unique)
142.         sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
143.         local pre_mean : dis %6.3f r(mean)
144.         preserve
145.         cap mat drop es
146.         foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
147.             if "`var'" == "int_lead1_`grp'" mat row = 0,0
148.             else mat row = _b[`var'], _se[`var']
149.             mat es = nullmat(es) \ row
150.         }
151.         svmat es
152.         keep es1 es2
153.         drop if mi(es1)
154.         rename (es1 es2) (b se)
155.         gen ub = b + 1.96*se
156.         qui sum ub
157.         local ymax = round(r(max), `gap')
158.         gen lb = b - 1.96*se
159.         qui sum lb
160.         local ymin = round(r(min), `gap')
161.         if `ymin' > 0 local ymin = 0
162.         gen rel = -`abs_lead' if _n == 1
163.         replace rel = rel[_n-1]+1 if _n > 1
164.         replace rel = rel + 1 if rel >= -1
165.         replace rel = -1 if rel == `abs_lag' + 1
166.         gen year = rel + 2014
167.         hashsort rel
168.         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>            scatter b year, mcolor(ebblue) || ///
>         scatteri `ymax' 2013.75 `ymax' 2014.25, bcolor(gs12%30) recast(area) base(`ymin') ///
>            xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>            ytitle("{&Delta} Log Expected `ylab'") ylab(`ymin'(`gap')`ymax') ///
>            subtitle("`grp_label'", pos(11) size(small)) ///
>            legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") ///
>                   pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>            yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
169.         graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'_agengrants.pdf, replace
170.         restore
171.     }
172. }
173. postclose `ph'
174. 
. use ../temp/age_ngrants_results`suf', clear
175. di as text _n "==== age_ngrants_results`suf' ===="
176. list, sepby(yvar) noobs
177. export delimited using "../output/tables/`samp'/age_ngrants_results`suf'.txt", replace delim(tab)
178. 
. }


