. * ---------- load panel ----------
. use ../temp/es_all_jrnls_r1_r2, clear

. qui sum year

. di as text _n "panel years: " r(min) " - " r(max)

panel years: 2010 - 2019

. 
. gen post       = year >= 2014

. gen Z_it       = exposure      * post

. gen Z_share_it = mkt_spend_shr * post

