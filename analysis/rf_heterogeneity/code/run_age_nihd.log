      name:  <unnamed>
       log:  /n/holylabs/pakes_lab/Lab/sci_eq/analysis/rf_heterogeneity/code/run_age_nihd.log
  log type:  text
 opened on:   4 Aug 2026, 18:57:30

. 
. local samp   all_jrnls

. local sufs   _r1_r2 _r1_r2_public

. local fes    athr_id year

. local vce_cl athr_id

. local yvars  ppr_cnt cite_affl_wt

. 
. cap mkdir "../output/figures/`samp'"

. cap mkdir "../output/figures/`samp'/es_ppml"

. cap mkdir "../output/figures/`samp'/coefplot_evavg"

. cap mkdir "../output/tables/`samp'"

. 
. global LBL_y_hn "Early-Career Scientists x More NIH Funding at Baseline"

. global LBL_y_ln "Early-Career Scientists x Less NIH Funding at Baseline"

. global LBL_o_hn "Late-Career Scientists x More NIH Funding at Baseline"

. global LBL_o_ln "Late-Career Scientists x Less NIH Funding at Baseline"

. 
. foreach suf of local sufs {
  2. 
. di as text _n(2) "################ run_age_nihd: `samp'`suf' ################"
  3. 
. cap confirm file ../temp/es_`samp'`suf'.dta
  4. if _rc {
  5.     di as error "run_age_nihd: ../temp/es_`samp'`suf'.dta not found -- run add_het_splits for this sample first; skipping."
  6.     continue
  7. }
  8. use ../temp/es_`samp'`suf', clear
  9. 
. local skip 0
 10. foreach v in young high_nihd {
 11.     cap confirm variable `v'
 12.     if _rc {
 13.         di as error "run_age_nihd`suf': `v' not in panel -- rerun add_het_splits; skipping."
 14.         local skip 1
 15.     }
 16. }
 17. if `skip' continue
 18. 
. * 2x2 cells; missing off the NIH-matched sample, so every fit below drops
. * unmatched PIs rather than pooling them into the base category.
. gen byte y_hn = (young == 1 & high_nihd == 1) if !mi(young) & !mi(high_nihd)
 19. gen byte y_ln = (young == 1 & high_nihd == 0) if !mi(young) & !mi(high_nihd)
 20. gen byte o_hn = (young == 0 & high_nihd == 1) if !mi(young) & !mi(high_nihd)
 21. gen byte o_ln = (young == 0 & high_nihd == 0) if !mi(young) & !mi(high_nihd)
 22. 
. foreach grp in y_hn y_ln o_hn o_ln {
 23.     qui sum `grp'
 24.     if r(N) == 0 | r(max) == 0 {
 25.         di as error "run_age_nihd`suf': cell `grp' empty -- skipping this sample."
 26.         local skip 1
 27.     }
 28. }
 29. if `skip' continue
 30. 
. gen rel = year - 2014
 31. qui sum rel, d
 32. local abs_lag  = abs(r(max))
 33. local abs_lead = abs(r(min))
 34. 
. forval i = 1/`abs_lead' {
 35.     gen int_lead`i'  = exposure      if rel == -`i'
 36.     gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 37. }
 38. forval i = 0/`abs_lag' {
 39.     gen int_lag`i'  = exposure      if rel == `i'
 40.     gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 41. }
 42. ds int_lead* int_lag* mshr_lead* mshr_lag*
 43. foreach var in `r(varlist)' {
 44.     replace `var' = 0 if mi(`var')
 45. }
 46. local int_leads
 47. local mshr_leads
 48. local int_lags
 49. local mshr_lags
 50. forval i = 2/`abs_lead' {
 51.     local int_leads  int_lead`i'  `int_leads'
 52.     local mshr_leads mshr_lead`i' `mshr_leads'
 53. }
 54. forval i = 0/`abs_lag' {
 55.     local int_lags  `int_lags'  int_lag`i'
 56.     local mshr_lags `mshr_lags' mshr_lag`i'
 57. }
 58. 
. gen post       = year >= 2014
 59. gen Z_it       = exposure      * post
 60. gen Z_share_it = mkt_spend_shr * post
 61. 
. foreach grp in y_hn y_ln o_hn o_ln {
 62.     * cleared per suffix: these accumulate, and stale terms from the
.     * previous sample would enter the next sample's ES spec.
.     local leads_`grp'
 63.     local lags_`grp'
 64.     local mleads_`grp'
 65.     local mlags_`grp'
 66.     foreach v of local int_leads {
 67.         gen `v'_`grp' = `v' * `grp'
 68.         local leads_`grp' `leads_`grp'' `v'_`grp'
 69.     }
 70.     foreach v of local int_lags {
 71.         gen `v'_`grp' = `v' * `grp'
 72.         local lags_`grp' `lags_`grp'' `v'_`grp'
 73.     }
 74.     foreach v of local mshr_leads {
 75.         gen `v'_`grp' = `v' * `grp'
 76.         local mleads_`grp' `mleads_`grp'' `v'_`grp'
 77.     }
 78.     foreach v of local mshr_lags {
 79.         gen `v'_`grp' = `v' * `grp'
 80.         local mlags_`grp' `mlags_`grp'' `v'_`grp'
 81.     }
 82.     gen int_lead1_`grp' = int_lead1 * `grp'
 83.     gen Z_`grp'  = Z_it       * `grp'
 84.     gen S_`grp'  = Z_share_it * `grp'
 85.     gen PT_`grp' = post       * `grp'
 86. }
 87. 
. tempname ph
 88. postfile `ph' str30 yvar str24 grp str18 split_type ///
>     double(post_b post_se p N r2_p n_pis) ///
>     using "../temp/age_nihd_results`suf'", replace
 89. 
. foreach yvar of local yvars {
 90.     local ylab "`yvar'"
 91.     if "`yvar'" == "ppr_cnt"      local ylab "Publications"
 92.     if "`yvar'" == "cite_affl_wt" local ylab "Citation-Weighted Output"
 93.     local gap = cond(regexm("`yvar'", "^cite_affl_wt"), 0.2, 0.1)
 94. 
.     di as text _n "==== pooled DiD PPML 2x2 age x nihd: `yvar' (`suf') ===="
 95.     * [H11] o_ln x post is the omitted base
.     cap noi ppmlhdfe `yvar' Z_y_hn Z_y_ln Z_o_hn Z_o_ln ///
>                             S_y_hn S_y_ln S_o_hn S_o_ln ///
>                             PT_y_hn PT_y_ln PT_o_hn, ///
>         absorb(`fes') vce(cluster `vce_cl')
 96.     if _rc {
 97.         di as error "run_age_nihd`suf': pooled DiD `yvar' failed; skipping."
 98.         continue
 99.     }
100.     local Nppml  = e(N)
101.     local r2ppml = e(r2_p)
102.     foreach grp in y_hn y_ln o_hn o_ln {
103.         gunique athr_id if e(sample) & `grp' == 1
104.         local n_pis = r(unique)
105.         gunique inst_id if e(sample) & `grp' == 1
106.         local n_insts = r(unique)
107.         local b  = _b[Z_`grp']
108.         local se = _se[Z_`grp']
109.         di as text "PDID `yvar' `grp': b=" %8.4f `b' " se=" %8.4f `se' ///
>             "  N=" %9.0f `Nppml' " PIs=`n_pis' Insts=`n_insts'"
110.         post `ph' ("`yvar'") ("`grp'") ("joint_agenih") ///
>             (`b') (`se') (.) (`Nppml') (`r2ppml') (`n_pis')
111.     }
112.     * Hi-vs-lo NIH funding within age and young-vs-old within funding tier.
.     foreach d in "y_diff_nihd Z_y_hn Z_y_ln" "o_diff_nihd Z_o_hn Z_o_ln" ///
>                  "hi_diff_age Z_y_hn Z_o_hn" "lo_diff_age Z_y_ln Z_o_ln" {
113.         local dname : word 1 of `d'
114.         local d1    : word 2 of `d'
115.         local d2    : word 3 of `d'
116.         cap noi lincom `d1' - `d2'
117.         if _rc continue
118.         local b_diff  = r(estimate)
119.         local se_diff = r(se)
120.         local p_diff  = r(p)
121.         di as text "DIFF `yvar' `dname': b=" %8.4f `b_diff' ///
>             " se=" %8.4f `se_diff' " p=" %6.4f `p_diff'
122.         post `ph' ("`yvar'") ("`dname'") ("joint_agenih_diff") ///
>             (`b_diff') (`se_diff') (`p_diff') (`Nppml') (`r2ppml') (.)
123.     }
124. 
.     di as text _n "==== event study PPML 2x2 age x nihd: `yvar' (`suf') ===="
125.     cap noi ppmlhdfe `yvar' ///
>         `leads_y_hn' `lags_y_hn' `leads_y_ln' `lags_y_ln' ///
>         `leads_o_hn' `lags_o_hn' `leads_o_ln' `lags_o_ln' ///
>         `mleads_y_hn' `mlags_y_hn' `mleads_y_ln' `mlags_y_ln' ///
>         `mleads_o_hn' `mlags_o_hn' `mleads_o_ln' `mlags_o_ln' ///
>         PT_y_hn PT_y_ln PT_o_hn, ///
>         absorb(`fes') vce(cluster `vce_cl')
126.     if _rc {
127.         di as error "run_age_nihd`suf': ES `yvar' failed; skipping plots."
128.         continue
129.     }
130.     foreach grp in y_hn y_ln o_hn o_ln {
131.         local grp_label = "${LBL_`grp'}"
132.         gunique athr_id if e(sample) & `grp' == 1
133.         local num_athrs = r(unique)
134.         gunique inst_id if e(sample) & `grp' == 1
135.         local num_insts = r(unique)
136.         sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
137.         local pre_mean : dis %6.3f r(mean)
138.         preserve
139.         cap mat drop es
140.         foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
141.             if "`var'" == "int_lead1_`grp'" mat row = 0,0
142.             else mat row = _b[`var'], _se[`var']
143.             mat es = nullmat(es) \ row
144.         }
145.         svmat es
146.         keep es1 es2
147.         drop if mi(es1)
148.         rename (es1 es2) (b se)
149.         gen ub = b + 1.96*se
150.         qui sum ub
151.         local ymax = round(r(max), `gap')
152.         gen lb = b - 1.96*se
153.         qui sum lb
154.         local ymin = round(r(min), `gap')
155.         if `ymin' > 0 local ymin = 0
156.         gen rel = -`abs_lead' if _n == 1
157.         replace rel = rel[_n-1]+1 if _n > 1
158.         replace rel = rel + 1 if rel >= -1
159.         replace rel = -1 if rel == `abs_lag' + 1
160.         gen year = rel + 2014
161.         hashsort rel
162.         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>            scatter b year, mcolor(ebblue) || ///
>         scatteri `ymax' 2013.75 `ymax' 2014.25, bcolor(gs12%30) recast(area) base(`ymin') ///
>            xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>            ytitle("{&Delta} Log Expected `ylab'") ylab(`ymin'(`gap')`ymax') ///
>            subtitle("`grp_label'", pos(11) size(small)) ///
>            legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") ///
>                   pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>            yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
163.         graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'_agenihd.pdf, replace
164.         restore
165.     }
166. }
167. postclose `ph'
168. 
. use ../temp/age_nihd_results`suf', clear
169. di as text _n "==== age_nihd_results`suf' ===="
170. list, sepby(yvar) noobs
171. export delimited using "../output/tables/`samp'/age_nihd_results`suf'.txt", replace delim(tab)
172. 
. }


