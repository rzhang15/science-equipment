. do "analysis.do" 

. set more off

. clear all

. capture log close

. program drop _all

. set scheme modern

. preliminaries

. version 17

. set maxvar 20000


. 
. global EXPOSURE_VERSION "hc"

. global EXPOSURE_FILTER  "_cf"

. global FE_MODE "author"

. global HET_RUN_OLS 0

. global DEBUG_YVAR "ppr_cnt"

. global HET_INCLUDE_INSTWTD 0

. global HET_RUN_QUARTILES 0

. global HET_IC_FULL 0

. 
. program main
  1.     gather_inst_chars
  2.     define_group_labels
  3.     local s all_jrnls
  4.     cap mkdir "../output/figures/`s'"
  5.     add_het_splits, samp(`s') r1r2(1) public(0)
  6.     desc_pre_output_by_age, samp(`s') r1r2(1) public(0)
  7.     event_study_het, samp(`s') r1r2(1) public(0)
  8.     output_het_tables, samp(`s') r1r2(1) public(0)
  9. 
.     add_het_splits, samp(all_jrnls) r1r2(1) public(1)
 10.     desc_pre_output_by_age, samp(all_jrnls) r1r2(1) public(1)
 11.     event_study_het, samp(all_jrnls) r1r2(1) public(1)
 12.     output_het_tables, samp(all_jrnls) r1r2(1) public(1)
 13. end

