. program gather_inst_chars
  1.     import delimited ../external/college/ipeds_openalex.csv, ///
>         clear varn(1) stringcols(_all)
  2.     keep ipeds_id inst_id
  3.     drop if inst_id == "" | ipeds_id == ""
  4.     destring ipeds_id, replace
  5.     duplicates drop
  6.     bys ipeds_id: gen _ndup = _N
  7.     qui count if _ndup > 1
  8.     if r(N) > 0 {
  9.         di as error "gather_inst_chars: " r(N) " rows with duplicate ipeds_id in crosswalk; keeping first inst_id per ipeds_id. VERIFY the crosswalk."
 10.         bys ipeds_id (inst_id): keep if _n == 1
 11.     }
 12.     drop _ndup
 13.     save ../temp/ipeds_openalex_xw, replace
 14. 
.     use ../external/inst_chars/combined_pre, clear
 15.     merge 1:1 ipeds_id using ../temp/ipeds_openalex_xw, keep(3) nogen
 16.     drop ipeds_id
 17.     bys inst_id: gen _ndup = _N
 18.     qui count if _ndup > 1
 19.     if r(N) > 0 {
 20.         di as error "gather_inst_chars: " r(N) " rows with duplicate inst_id after ipeds merge; keeping first row per inst_id. VERIFY the crosswalk."
 21.         bys inst_id: keep if _n == 1
 22.     }
 23.     drop _ndup
 24. 
.     rename contracts_fund      ic_contr
 25.     rename fed_ls_bio_fund     ic_fdlsb
 26.     rename fed_ls_fund         ic_fdls
 27.     rename fed_ls_hs_fund      ic_fdlsh
 28.     rename grants_fund         ic_gntsf
 29.     rename hhs_ls_bio_fund     ic_hhlsb
 30.     rename hhs_ls_fund         ic_hhls
 31.     rename hhs_ls_hs_fund      ic_hhlsh
 32.     rename nonfed_ls_bio_fund  ic_nflsb
 33.     rename nonfed_ls_fund      ic_nfls
 34.     rename nonfed_ls_hs_fund   ic_nflsh
 35.     rename subrecipient_fund   ic_subrf
 36.     rename tot_bus_fund        ic_busf
 37.     rename tot_fed_fund        ic_fedf
 38.     rename tot_fund            ic_tfnd
 39.     rename tot_inst_fund       ic_instf
 40.     rename tot_nonprof_fund    ic_nonpf
 41.     rename tot_state_fund      ic_statf
 42.     rename ls_fund             ic_lsf
 43.     rename hs_fund             ic_hsf
 44.     rename bio_fund            ic_biof
 45.     rename applied_expend      ic_applx
 46.     rename applied_fed_expend  ic_apfx
 47.     rename basic_expend        ic_basx
 48.     rename basic_fed_expend    ic_bfx
 49.     rename clin_trial_expend   ic_clinx
 50.     rename dev_expend          ic_devx
 51.     rename ls_cap_expend       ic_lscx
 52.     rename med_sch_expend      ic_medx
 53.     rename endowment           ic_endow
 54. 
.     order inst_id
 55.     compress
 56.     save ../temp/inst_chars_pre, replace
 57. end

. 
. * Reduced set: total R&D + total federal + institutional + life-sci + federal life-sci
. * (funding); endowment + basic + applied (expenditures).
. global IC_ALIASES tfnd lsf endow

. if $HET_IC_FULL == 1 {
.     global IC_ALIASES contr fdlsb fdls fdlsh gntsf hhlsb hhls hhlsh nflsb nfls nflsh subrf busf fedf tfnd instf nonpf statf lsf hsf biof applx apfx basx bfx clinx devx lscx medx endow
. }

. global PI_Q_BASES pre_ppr team nihg nihd

. 
. * Joint 2x2 axes for PI-split × inst-char paired coefplots. Each axis defines:
. *   SRC   -- 0/1 PI-level dummy (1 = "hi" side of the axis)
. *   HIPFX -- 2-char subgroup prefix for the "hi" side, used in dummy names
. *   LOPFX -- 2-char subgroup prefix for the "lo" side
. *   HILEG -- legend label for the "hi" side; LOLEG same for "lo" side
. global PI_CHAR_ALIASES   prppr

. global PI_CHAR_SRC_prppr   high_pre_ppr

. global PI_CHAR_HIPFX_prppr hp

. global PI_CHAR_LOPFX_prppr lp

. global PI_CHAR_HILEG_prppr "High Baseline Productivity"

. global PI_CHAR_LOLEG_prppr "Low Baseline Productivity"

. global PI_CHAR_SRC_team    big_team

. global PI_CHAR_HIPFX_team  bt

. global PI_CHAR_LOPFX_team  sm

. global PI_CHAR_HILEG_team  "Larger Team Size"

. global PI_CHAR_LOLEG_team  "Smaller Team Size"

. 
. program define_group_labels
  1.     global LBL_young        "Early-Career Scientists"
  2.     global LBL_old          "Late-Career Scientists"
  3.     global LBL_r1           "R1"
  4.     global LBL_r2           "R2"
  5.     global LBL_pub_inst     "Public"
  6.     global LBL_priv_inst    "Private"
  7.     global LBL_high_pre_ppr "More Productive at Baseline"
  8.     global LBL_low_pre_ppr  "Less Productive at Baseline"
  9.     global LBL_big_team     "Larger Team Size"
 10.     global LBL_small_team   "Smaller Team Size"
 11.     global LBL_high_nihg    "More NIH Grants at Baseline"
 12.     global LBL_low_nihg     "Fewer NIH Grants at Baseline"
 13.     global LBL_high_nihd    "More NIH Funding at Baseline"
 14.     global LBL_low_nihd     "Less NIH Funding at Baseline"
 15.     global LBL_young_nih    "Early-Career Scientists (NIH-Matched PIs)"
 16.     global LBL_old_nih      "Late-Career Scientists (NIH-Matched PIs)"
 17. 
.     global LBL_q1_pre_ppr   "Q1 Baseline Productivity"
 18.     global LBL_q4_pre_ppr   "Q4 Baseline Productivity"
 19.     global LBL_q1_team      "Q1 Team Size"
 20.     global LBL_q4_team      "Q4 Team Size"
 21.     global LBL_q1_nihg      "Q1 Baseline NIH Grants"
 22.     global LBL_q4_nihg      "Q4 Baseline NIH Grants"
 23.     global LBL_q1_nihd      "Q1 Baseline NIH Funding"
 24.     global LBL_q4_nihd      "Q4 Baseline NIH Funding"
 25. 
.     local ic_lbl_contr "Total Contract Funding"
 26.     local ic_lbl_fdlsb "Federal Life-Sci Biology Funding"
 27.     local ic_lbl_fdls  "Federal Life-Sci Funding"
 28.     local ic_lbl_fdlsh "Federal Life-Sci Health-Sci Funding"
 29.     local ic_lbl_gntsf "Grants Funding"
 30.     local ic_lbl_hhlsb "HHS Life-Sci Biology Funding"
 31.     local ic_lbl_hhls  "HHS Life-Sci Funding"
 32.     local ic_lbl_hhlsh "HHS Life-Sci Health-Sci Funding"
 33.     local ic_lbl_nflsb "Non-Federal Life-Sci Biology Funding"
 34.     local ic_lbl_nfls  "Non-Federal Life-Sci Funding"
 35.     local ic_lbl_nflsh "Non-Federal Life-Sci Health-Sci Funding"
 36.     local ic_lbl_subrf "Subrecipient Funding"
 37.     local ic_lbl_busf  "Business Funding"
 38.     local ic_lbl_fedf  "Total Federal Funding"
 39.     local ic_lbl_tfnd  "Total R&D Funding"
 40.     local ic_lbl_instf "Institutional Funding"
 41.     local ic_lbl_nonpf "Non-Profit Funding"
 42.     local ic_lbl_statf "State Funding"
 43.     local ic_lbl_lsf   "Life-Sci Funding"
 44.     local ic_lbl_hsf   "Health-Sci Funding"
 45.     local ic_lbl_biof  "Biology Funding"
 46.     local ic_lbl_applx "Applied Research Expenditures"
 47.     local ic_lbl_apfx  "Federal Applied Research Expenditures"
 48.     local ic_lbl_basx  "Basic Research Expenditures"
 49.     local ic_lbl_bfx   "Federal Basic Research Expenditures"
 50.     local ic_lbl_clinx "Clinical Trial Expenditures"
 51.     local ic_lbl_devx  "Development Expenditures"
 52.     local ic_lbl_lscx  "Life-Sci Capital Expenditures"
 53.     local ic_lbl_medx  "Medical School Expenditures"
 54.     local ic_lbl_endow "Endowment"
 55.     foreach a of global IC_ALIASES {
 56.         global LBL_ic_`a'   "`ic_lbl_`a''"
 57.         global LBL_hi_`a'   "High `ic_lbl_`a''"
 58.         global LBL_lo_`a'   "Low `ic_lbl_`a''"
 59.         global LBL_q1_`a'   "Q1 `ic_lbl_`a''"
 60.         global LBL_q4_`a'   "Q4 `ic_lbl_`a''"
 61.         global LBL_mid_`a'  "Mid `ic_lbl_`a''"
 62.         global LBL_hiw_`a'  "High `ic_lbl_`a''"
 63.         global LBL_low_`a'  "Low `ic_lbl_`a''"
 64.         global LBL_q1w_`a'  "Q1 `ic_lbl_`a''"
 65.         global LBL_q4w_`a'  "Q4 `ic_lbl_`a''"
 66.         global LBL_midw_`a' "Mid `ic_lbl_`a''"
 67.         global LBL_y_hi_`a' "Early-Career x Hi `ic_lbl_`a''"
 68.         global LBL_y_lo_`a' "Early-Career x Lo `ic_lbl_`a''"
 69.         global LBL_o_hi_`a' "Late-Career x Hi `ic_lbl_`a''"
 70.         global LBL_o_lo_`a' "Late-Career x Lo `ic_lbl_`a''"
 71.     }
 72. 
.     global IC_PAIRS_MED
 73.     global IC_PAIRS_MED_PW
 74.     global IC_PAIRS_Q
 75.     global IC_PAIRS_Q_PW
 76.     foreach a of global IC_ALIASES {
 77.         global IC_PAIRS_MED    `"${IC_PAIRS_MED} "hi_`a' lo_`a'" "'
 78.         global IC_PAIRS_MED_PW `"${IC_PAIRS_MED_PW} "hiw_`a' low_`a'" "'
 79.         global IC_PAIRS_Q      `"${IC_PAIRS_Q} "q4_`a' q1_`a'" "'
 80.         global IC_PAIRS_Q_PW   `"${IC_PAIRS_Q_PW} "q4w_`a' q1w_`a'" "'
 81.     }
 82.     global PI_PAIRS_Q
 83.     foreach b of global PI_Q_BASES {
 84.         global PI_PAIRS_Q `"${PI_PAIRS_Q} "q4_`b' q1_`b'" "'
 85.     }
 86. end

. 
. program add_het_splits
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     use ../external/prepped_samples/es_`samp'`suf', clear
  8. 
.     cap drop athr_indicator
  9.     bys athr_id : gen athr_indicator = _n == 1
 10. 
.     qui sum pre_ppr_cnt_sum if athr_indicator == 1, d
 11.     local ppr_cut = r(p50)
 12.     gen high_pre_ppr = pre_ppr_cnt_sum >= `ppr_cut' if !mi(pre_ppr_cnt_sum)
 13.     gen low_pre_ppr  = pre_ppr_cnt_sum <  `ppr_cut' if !mi(pre_ppr_cnt_sum)
 14. 
.     qui sum age_2014 if athr_indicator == 1, d
 15.     local age_med = r(p50)
 16.     di as text "add_het_splits `samp'`suf' age_2014 median = `age_med'"
 17.     gen young = age_2014 <  `age_med' if !mi(age_2014)
 18.     gen old   = age_2014 >= `age_med' if !mi(age_2014)
 19. 
.     gen r1 = type == "r1" if !mi(type)
 20.     gen r2 = type == "r2" if !mi(type)
 21. 
.     cap confirm variable public
 22.     if !_rc {
 23.         gen pub_inst  = public == 1 if !mi(public)
 24.         gen priv_inst = public == 0 if !mi(public)
 25.     }
 26.     else di as error "add_het_splits `samp'`suf': public not in panel -- pub_inst/priv_inst SKIPPED (rerun reduced_form/restrict_samp to add it)."
 27. 
.     cap confirm variable avg_team_size_last
 28.     if !_rc {
 29.         gen pre_team_yr = avg_team_size_last if year < 2014
 30.         bys athr_id: egen pre_team_avg = mean(pre_team_yr)
 31.         drop pre_team_yr
 32.         qui sum pre_team_avg if athr_indicator == 1, d
 33.         local team_med = r(p50)
 34.         di as text "add_het_splits `samp'`suf' pre-team median = `team_med'"
 35.         gen big_team   = pre_team_avg >= `team_med' if !mi(pre_team_avg)
 36.         gen small_team = pre_team_avg <  `team_med' if !mi(pre_team_avg)
 37.     }
 38.     else di as error "add_het_splits `samp'`suf': avg_team_size_last not in panel -- team split SKIPPED."
 39. 
.     * Baseline NIH scale: pre-2014 means of the derived author-year measures
.     * (n_grants, nih_total_cost from derived/nih/match_pi_athr). Both are missing
.     * for PIs excluded upstream, so the NIH splits estimate on the NIH sample.
.     local nih_src   n_grants nih_total_cost
 40.     local nih_alias nihg     nihd
 41.     forvalues i = 1/2 {
 42.         local src : word `i' of `nih_src'
 43.         local alias : word `i' of `nih_alias'
 44.         cap confirm variable `src'
 45.         if _rc {
 46.             di as error "add_het_splits `samp'`suf': `src' not in panel -- `alias' split SKIPPED (rerun reduced_form/restrict_samp)."
 47.             continue
 48.         }
 49.         gen pre_`alias'_yr = `src' if year < 2014
 50.         bys athr_id: egen pre_`alias' = mean(pre_`alias'_yr)
 51.         drop pre_`alias'_yr
 52.         local src pre_`alias'
 53.         qui sum `src' if athr_indicator == 1, d
 54.         local nih_n = r(N)
 55.         local nih_p50 = r(p50)
 56.         di as text "add_het_splits `samp'`suf' `alias' N_pi=`nih_n' p50=`nih_p50'"
 57.         gen byte high_`alias' = `src' >= `nih_p50' if !mi(`src')
 58.         gen byte low_`alias'  = `src' <  `nih_p50' if !mi(`src')
 59.     }
 60. 
.     * Age split restricted to PIs matched to RePORTER (n_grants non-missing).
.     * Dummies stay missing off the NIH sample, so every fit using them drops
.     * unmatched PIs rather than pooling them into the base category.
.     * nih_matched comes from reduced_form (RePORTER PI-name match). Fall back to
.     * an n_grants-based proxy only if the panel predates it.
.     cap drop nih_pi
 61.     cap confirm variable nih_matched
 62.     if !_rc {
 63.         bys athr_id: egen byte nih_pi = max(nih_matched == 1)
 64.     }
 65.     else {
 66.         cap confirm variable n_grants
 67.         if !_rc bys athr_id: egen byte nih_pi = max(!mi(n_grants))
 68.     }
 69.     cap confirm variable nih_pi
 70.     if !_rc {
 71.         qui count if nih_pi == 1 & athr_indicator == 1
 72.         di as text "add_het_splits `samp'`suf' NIH-matched PIs = " r(N)
 73.         gen byte young_nih = young if nih_pi == 1 & !mi(young)
 74.         gen byte old_nih   = old   if nih_pi == 1 & !mi(old)
 75.     }
 76.     else di as error "add_het_splits `samp'`suf': no NIH match flag in panel -- young_nih/old_nih SKIPPED."
 77. 
.     cap confirm variable avg_num_coathrs
 78.     if !_rc {
 79.         gen pre_coauth_yr = avg_num_coathrs if year < 2014
 80.         bys athr_id: egen pre_coauth_avg = mean(pre_coauth_yr)
 81.         drop pre_coauth_yr
 82.     }
 83. 
.     cap confirm variable msa_size
 84.     if !_rc {
 85.         gen msa_size_2014 = msa_size if year == 2014
 86.         bys athr_id: egen msa_size_at = max(msa_size_2014)
 87.         drop msa_size_2014
 88.     }
 89. 
.     merge m:1 inst_id using ../temp/inst_chars_pre, keep(1 3) nogen
 90.     cap drop inst_indicator
 91.     bys inst_id : gen inst_indicator = _n == 1
 92.     foreach a of global IC_ALIASES {
 93.         cap confirm variable ic_`a'
 94.         if _rc continue
 95.         * Inst-weighted cutoffs (each institution counts once).
.         qui sum ic_`a' if inst_indicator == 1, d
 96.         local ic_n = r(N)
 97.         local ic_p50 = r(p50)
 98.         local ic_p25 = r(p25)
 99.         local ic_p75 = r(p75)
100.         di as text "add_het_splits `samp'`suf' ic_`a' inst-wtd N_inst=`ic_n' p25=`ic_p25' p50=`ic_p50' p75=`ic_p75'"
101.         gen byte hi_`a'  = ic_`a' >= `ic_p50' if !mi(ic_`a')
102.         gen byte lo_`a'  = ic_`a' <  `ic_p50' if !mi(ic_`a')
103.         gen byte q1_`a'  = ic_`a' <= `ic_p25' if !mi(ic_`a')
104.         gen byte q4_`a'  = ic_`a' >= `ic_p75' if !mi(ic_`a')
105.         gen byte mid_`a' = (ic_`a' > `ic_p25' & ic_`a' < `ic_p75') if !mi(ic_`a')
106.         * PI-weighted cutoffs (each PI counts once; big institutions dominate).
.         qui sum ic_`a' if athr_indicator == 1, d
107.         local ic_p25w = r(p25)
108.         local ic_p50w = r(p50)
109.         local ic_p75w = r(p75)
110.         di as text "add_het_splits `samp'`suf' ic_`a' pi-wtd N_pi=" r(N) " p25=`ic_p25w' p50=`ic_p50w' p75=`ic_p75w'"
111.         gen byte hiw_`a'  = ic_`a' >= `ic_p50w' if !mi(ic_`a')
112.         gen byte low_`a'  = ic_`a' <  `ic_p50w' if !mi(ic_`a')
113.         gen byte q1w_`a'  = ic_`a' <= `ic_p25w' if !mi(ic_`a')
114.         gen byte q4w_`a'  = ic_`a' >= `ic_p75w' if !mi(ic_`a')
115.         gen byte midw_`a' = (ic_`a' > `ic_p25w' & ic_`a' < `ic_p75w') if !mi(ic_`a')
116.     }
117. 
.     local pi_q_source pre_ppr_cnt_sum pre_team_avg pre_nihg pre_nihd
118.     local pi_q_alias  pre_ppr        team         nihg     nihd
119.     local nq : word count `pi_q_alias'
120.     forvalues i = 1/`nq' {
121.         local src : word `i' of `pi_q_source'
122.         local alias : word `i' of `pi_q_alias'
123.         cap confirm variable `src'
124.         if _rc {
125.             di as error "add_het_splits `samp'`suf': `src' unavailable -- `alias' quartiles SKIPPED."
126.             continue
127.         }
128.         qui sum `src' if athr_indicator == 1, d
129.         local p25 = r(p25)
130.         local p75 = r(p75)
131.         di as text "add_het_splits `samp'`suf' `alias' p25=`p25' p75=`p75'"
132.         gen byte q1_`alias'  = `src' <= `p25' if !mi(`src')
133.         gen byte q4_`alias'  = `src' >= `p75' if !mi(`src')
134.         gen byte mid_`alias' = (`src' > `p25' & `src' < `p75') if !mi(`src')
135.     }
136. 
.     * Joint young x hiw_<char> 2x2 for every ic char (PI-weighted median cutoff).
.     foreach a of global IC_ALIASES {
137.         cap confirm variable hiw_`a'
138.         if _rc continue
139.         gen byte y_hi_`a' = (young == 1 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
140.         gen byte y_lo_`a' = (young == 1 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
141.         gen byte o_hi_`a' = (young == 0 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
142.         gen byte o_lo_`a' = (young == 0 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
143.     }
144. 
.     * Joint age x baseline-productivity 2x2 (no inst char). Four subgroups.
.     cap confirm variable high_pre_ppr
145.     if !_rc {
146.         gen byte y_hp = (young == 1 & high_pre_ppr == 1) if !mi(young) & !mi(high_pre_ppr)
147.         gen byte y_lp = (young == 1 & high_pre_ppr == 0) if !mi(young) & !mi(high_pre_ppr)
148.         gen byte o_hp = (young == 0 & high_pre_ppr == 1) if !mi(young) & !mi(high_pre_ppr)
149.         gen byte o_lp = (young == 0 & high_pre_ppr == 0) if !mi(young) & !mi(high_pre_ppr)
150.     }
151. 
.     * Joint PI-split x inst-char 2x2. For each axis (baseline productivity,
.     * coauthors), build 4 subgroup dummies per inst char keyed on the PI split
.     * and the PI-wtd inst-char hi/lo indicator.
.     foreach axis of global PI_CHAR_ALIASES {
152.         local src "${PI_CHAR_SRC_`axis'}"
153.         local hp  "${PI_CHAR_HIPFX_`axis'}"
154.         local lp  "${PI_CHAR_LOPFX_`axis'}"
155.         cap confirm variable `src'
156.         if _rc continue
157.         foreach a of global IC_ALIASES {
158.             cap confirm variable hiw_`a'
159.             if _rc continue
160.             gen byte `hp'_hi_`a' = (`src' == 1 & hiw_`a' == 1) if !mi(`src') & !mi(hiw_`a')
161.             gen byte `hp'_lo_`a' = (`src' == 1 & hiw_`a' == 0) if !mi(`src') & !mi(hiw_`a')
162.             gen byte `lp'_hi_`a' = (`src' == 0 & hiw_`a' == 1) if !mi(`src') & !mi(hiw_`a')
163.             gen byte `lp'_lo_`a' = (`src' == 0 & hiw_`a' == 0) if !mi(`src') & !mi(hiw_`a')
164.         }
165.     }
166. 
.     compress
167.     save ../temp/es_`samp'`suf', replace
168. end

. 
. program event_study_het
  1.     * Split-interaction PPML het regressions (+ OLS if HET_RUN_OLS=1).
.     * Writes ../temp/phet_results_<samp><suf>.dta.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     use ../temp/es_`samp'`suf', clear
 18. 
.     gen rel = year - 2014
 19.     qui sum rel, d
 20.     local abs_lag = abs(r(max))
 21.     local abs_lead = abs(r(min))
 22.     * [H8] only the observed window; unused time dummies removed
.     forval i = 1/`abs_lead' {
 23.         gen int_lead`i'  = exposure      if rel == -`i'
 24.         gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 25.     }
 26.     forval i = 0/`abs_lag' {
 27.         gen int_lag`i'  = exposure      if rel == `i'
 28.         gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 29.     }
 30.     ds int_lead* int_lag* mshr_lead* mshr_lag*
 31.     foreach var in `r(varlist)' {
 32.         replace `var' = 0 if mi(`var')
 33.     }
 34.     local int_leads
 35.     local mshr_leads
 36.     local int_lags
 37.     local mshr_lags
 38.     forval i = 2/`abs_lead' {
 39.         local int_leads int_lead`i' `int_leads'
 40.         local mshr_leads mshr_lead`i' `mshr_leads'
 41.     }
 42.     forval i = 0/`abs_lag' {
 43.         local int_lags `int_lags' int_lag`i'
 44.         local mshr_lags `mshr_lags' mshr_lag`i'
 45.     }
 46.     foreach v in ppr_cnt cite_affl_wt {
 47.         gen ln_`v' = ln(1+`v')
 48.     }
 49. 
.     * Skip dummies that are missing or degenerate (all 0 / all 1) so
.     * downstream loops don't try to fit collinear specs.
.     local het_groups young old r1 r2 pub_inst priv_inst high_pre_ppr low_pre_ppr ///
>                      big_team small_team high_nihg low_nihg high_nihd low_nihd ///
>                      young_nih old_nih
 50.     * Only groups the active config actually fits get lead/lag interactions.
.     foreach a of global IC_ALIASES {
 51.         local het_groups `het_groups' hiw_`a' low_`a'
 52.         if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' hi_`a' lo_`a'
 53.         if "$HET_RUN_QUARTILES" == "1" {
 54.             local het_groups `het_groups' q1w_`a' midw_`a' q4w_`a'
 55.             if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' q1_`a' mid_`a' q4_`a'
 56.         }
 57.     }
 58.     if "$HET_RUN_QUARTILES" == "1" {
 59.         foreach b of global PI_Q_BASES {
 60.             local het_groups `het_groups' q1_`b' mid_`b' q4_`b'
 61.         }
 62.     }
 63.     global HET_GROUPS_ACTIVE
 64.     foreach grp of local het_groups {
 65.         cap confirm variable `grp'
 66.         if _rc {
 67.             di as text "event_study_het `samp'`suf': dummy `grp' not built -- skipping."
 68.             continue
 69.         }
 70.         qui sum `grp'
 71.         if r(N) == 0 | r(min) == r(max) {
 72.             di as text "event_study_het `samp'`suf': dummy `grp' degenerate -- skipping."
 73.             continue
 74.         }
 75.         foreach v of local int_leads {
 76.             gen `v'_`grp' = `v' * `grp'
 77.         }
 78.         foreach v of local int_lags {
 79.             gen `v'_`grp' = `v' * `grp'
 80.         }
 81.         gen int_lead1_`grp' = int_lead1 * `grp'
 82.         foreach v of local mshr_leads {
 83.             gen `v'_`grp' = `v' * `grp'
 84.         }
 85.         foreach v of local mshr_lags {
 86.             gen `v'_`grp' = `v' * `grp'
 87.         }
 88.         local leads_`grp'
 89.         local lags_`grp'
 90.         local mleads_`grp'
 91.         local mlags_`grp'
 92.         foreach v of local int_leads {
 93.             local leads_`grp' `leads_`grp'' `v'_`grp'
 94.         }
 95.         foreach v of local int_lags {
 96.             local lags_`grp' `lags_`grp'' `v'_`grp'
 97.         }
 98.         foreach v of local mshr_leads {
 99.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
100.         }
101.         foreach v of local mshr_lags {
102.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
103.         }
104.         global HET_GROUPS_ACTIVE `"${HET_GROUPS_ACTIVE} `grp'"'
105.     }
106. 
.     if "$POSITION_OUTCOMES_AVAIL" == "" {
107.         cap confirm variable n_first_ppr
108.         global POSITION_OUTCOMES_AVAIL = cond(_rc == 0, 1, 0)
109.     }
110.     local position_outcomes ""
111.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
112.         local position_outcomes n_middle_ppr avg_position avg_team_size_last avg_team_size_notlast
113.     }
114. 
.     * Pooled DiD building blocks (used by the coefplot-feeding fits below).
.     cap drop post Z_it Z_share_it
115.     gen post       = year >= 2014
116.     gen Z_it       = exposure      * post
117.     gen Z_share_it = mkt_spend_shr * post
118. 
.     local pi_pairs `" "young old" "young_nih old_nih" "r1 r2" "pub_inst priv_inst" "high_pre_ppr low_pre_ppr" "big_team small_team" "high_nihg low_nihg" "high_nihd low_nihd" "'
119.     global DUMMY_PAIRS_MED    `" `pi_pairs' ${IC_PAIRS_MED} "'
120.     * PI-level splits included in both med and med_pi so PI-char coefplots
.     * still emit when HET_INCLUDE_INSTWTD=0 (only PI-weighted median runs).
.     global DUMMY_PAIRS_MED_PW `" `pi_pairs' ${IC_PAIRS_MED_PW} "'
121. 
.     * Skip PPML on avg_* outcomes (conditional means, not counts).
.     local ppml_het_skip avg_position avg_team_size_last avg_team_size_notlast
122. 
.     mat drop _all
123.     * Write per-yvar phet_results files (postfile has no append option); combine into
.     * master ../temp/phet_results_<samp><suf>.dta after the loop.
.     local yvar_list ppr_cnt cite_affl_wt avg_num_coathrs ///
>                     n_grants n_new_grants nih_total_cost ///
>                     `position_outcomes'
124.     if "$DEBUG_YVAR" != "" {
125.         local yvar_list $DEBUG_YVAR
126.         di as text "DEBUG_YVAR set -- restricting yvar loop to: $DEBUG_YVAR"
127.     }
128. 
.     foreach yvar of local yvar_list {
129.         tempname ph_handle
130.         postfile `ph_handle' str30 yvar str24 grp str12 spec str20 split_type ///
>             double(post_b post_se pre_b pre_se N r2_p) ///
>             using "../temp/phet_results_`samp'`suf'_`yvar'", replace
131.         local gap 0.5
132.         if regexm("`yvar'", "^cite_affl_wt") local gap 1
133. 
.         * ---- OLS median het (gated by $HET_RUN_OLS, headline outcomes only)
.         * leads_g1/lags_g1 are the differential vs the dummy=0 (`g2') group
.         * absorbed by un-interacted int_lead/int_lag.
.         if "$HET_RUN_OLS" == "1" & inlist("`yvar'", "ppr_cnt", "cite_affl_wt") {
134.             foreach pair of global DUMMY_PAIRS_MED {
135.                 local g1: word 1 of `pair'
136.                 local g2: word 2 of `pair'
137.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
138.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
139.                 local g1_label = "${LBL_`g1'}"
140.                 if "`g1_label'" == "" local g1_label "`g1'"
141.                 local mshr_ctrls `mshr_leads' `mshr_lags' `mleads_`g1'' `mlags_`g1''
142.                 local plot_suf "_mshrctrl"
143.                 cap drop PT_`g1'
144.                 gen PT_`g1' = post * `g1'
145.                 cap noi reghdfe `yvar' `int_leads' `int_lags' ///
>                                `leads_`g1'' `lags_`g1'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
146.                 local rc = _rc
147.                 if `rc' {
148.                     di as error "event_study_het `samp'`suf' `yvar' `g1' failed (rc=`rc'); skipping."
149.                     continue
150.                 }
151.                 gunique athr_id if e(sample) & `g1' == 1
152.                 local num_athrs = r(unique)
153.                 gunique inst_id if e(sample) & `g1' == 1
154.                 local num_insts = r(unique)
155.                 sum `yvar' if rel <= -1 & e(sample) & `g1' == 1, d
156.                 local pre_mean : dis %4.3f r(mean)
157.                 preserve
158.                 cap mat drop es
159.                 foreach var in `leads_`g1'' `lags_`g1'' int_lead1_`g1' {
160.                     if "`var'" == "int_lead1_`g1'" {
161.                         mat row = 0,0
162.                     }
163.                     else {
164.                         mat row = _b[`var'], _se[`var']
165.                     }
166.                     mat es = nullmat(es) \ row
167.                 }
168.                 svmat es
169.                 keep es1 es2
170.                 drop if mi(es1)
171.                 rename (es1 es2) (b se)
172.                 gen ub = b + 1.96*se
173.                 sum ub, d
174.                 local ymax = round(r(max),`gap')
175.                 gen lb = b - 1.96*se
176.                 sum lb, d
177.                 local ymin = round(r(min),`gap')
178.                 if `ymin' > 0 local ymin = 0
179.                 gen rel = -`abs_lead' if _n == 1
180.                 replace rel = rel[_n-1]+1 if _n > 1
181.                 replace rel = rel + 1 if rel >= -1
182.                 replace rel = -1 if rel == `abs_lag' + 1
183.                 gen year = rel + 2014
184.                 hashsort rel
185.                 tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>                   scatter b year, mcolor(ebblue) || ///
>                 scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                   xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                   ytitle("Exposure x Post") ylab(`ymin'(`gap')`ymax') ///
>                   subtitle("`g1_label'", pos(11) size(small)) ///
>                   legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>                   yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
186.                 graph export ../output/figures/`samp'/es_`yvar'`suf'_`g1'`plot_suf'.pdf, replace
187.                 save ../temp/es_`yvar'`suf'_`g1'`plot_suf', replace
188.                 restore
189.             }
190. 
.         }
191. 
.         * ---- PPML heterogeneity ----
.         * Posts "mshrctrl": joint pooled DiD with fully-interacted Z_it and Z_share_it
.         * on the full sample. grp coefficient = _b[Z_grp]; matches ppml_pdid_het_binscatter.
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
192.             cap mkdir "../output/figures/`samp'/es_ppml"
193.             * ---- PPML median split (inst-weighted + PI-weighted variants) ----
.             local mmethods pw
194.             if "$HET_INCLUDE_INSTWTD" == "1" local mmethods inst pw
195.             foreach mmethod of local mmethods {
196.             local pairs_current
197.             if "`mmethod'" == "inst" {
198.                 foreach pair of global DUMMY_PAIRS_MED {
199.                     local pairs_current `"`pairs_current' `"`pair'"' "'
200.                 }
201.                 local st_tag "med"
202.                 local mplot_suf "_ppml_mshrctrl"
203.             }
204.             else {
205.                 foreach pair of global DUMMY_PAIRS_MED_PW {
206.                     local pairs_current `"`pairs_current' `"`pair'"' "'
207.                 }
208.                 local st_tag "med_pi"
209.                 local mplot_suf "_ppml_medpi_mshrctrl"
210.             }
211.             foreach pair of local pairs_current {
212.                 local g1: word 1 of `pair'
213.                 local g2: word 2 of `pair'
214.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
215.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
216. 
.                 * --- Pooled-DiD PPML with fully-interacted Z and share; posted as "mshrctrl" ---
.                 * [H11] PT_`g1' absorbs the group-level post shift; `g2' x post is the base
.                 cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
217.                 gen Z_`g1' = Z_it       * `g1'
218.                 gen Z_`g2' = Z_it       * `g2'
219.                 gen S_`g1' = Z_share_it * `g1'
220.                 gen S_`g2' = Z_share_it * `g2'
221.                 gen PT_`g1' = post * `g1'
222.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
223.                 local rc = _rc
224.                 if `rc' {
225.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
226.                     continue
227.                 }
228.                 local Nppml = e(N)
229.                 local r2ppml = e(r2_p)
230.                 foreach grp in `g1' `g2' {
231.                     gunique athr_id if e(sample) & `grp' == 1
232.                     local num_athrs = r(unique)
233.                     gunique inst_id if e(sample) & `grp' == 1
234.                     local num_insts = r(unique)
235.                     local b_post  = _b[Z_`grp']
236.                     local se_post = _se[Z_`grp']
237.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
238.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
239.                 }
240. 
.                 * --- Joint event-study PPML for per-group ES PDFs only (not posted) ---
.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' `mleads_`g2'' `mlags_`g2''
241.                 local plot_suf "`mplot_suf'"
242.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g2'' `lags_`g2'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
243.                 if _rc {
244.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
245.                     continue
246.                 }
247.                 foreach grp in `g1' `g2' {
248.                     local grp_label = "${LBL_`grp'}"
249.                     if "`grp_label'" == "" local grp_label "`grp'"
250.                     gunique athr_id if e(sample) & `grp' == 1
251.                     local num_athrs = r(unique)
252.                     gunique inst_id if e(sample) & `grp' == 1
253.                     local num_insts = r(unique)
254.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
255.                     local pre_mean : dis %4.3f r(mean)
256.                     preserve
257.                     cap mat drop es
258.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
259.                         if "`var'" == "int_lead1_`grp'" {
260.                             mat row = 0,0
261.                         }
262.                         else {
263.                             mat row = _b[`var'], _se[`var']
264.                         }
265.                         mat es = nullmat(es) \ row
266.                     }
267.                     svmat es
268.                     keep es1 es2
269.                     drop if mi(es1)
270.                     rename (es1 es2) (b se)
271.                     gen ub = b + 1.96*se
272.                     sum ub, d
273.                     local ymax = round(r(max), 0.1)
274.                     gen lb = b - 1.96*se
275.                     sum lb, d
276.                     local ymin = round(r(min), 0.1)
277.                     if `ymin' > 0 local ymin = 0
278.                     gen rel = -`abs_lead' if _n == 1
279.                     replace rel = rel[_n-1]+1 if _n > 1
280.                     replace rel = rel + 1 if rel >= -1
281.                     replace rel = -1 if rel == `abs_lag' + 1
282.                     gen year = rel + 2014
283.                     hashsort rel
284.                     tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                       scatter b year, mcolor(ebblue) || ///
>                     scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                       xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                       ytitle("Exposure x Post") ylab(`ymin'(0.1)`ymax') ///
>                       subtitle("`grp_label'", pos(11) size(small)) ///
>                       legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>                       yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
285.                     graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
286.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
287.                     restore
288.                 }
289.             }
290.             }  // close foreach mmethod
291. 
.             * ---- PPML quartile split (inst-weighted + PI-weighted variants) ----
.             * Gated by HET_RUN_QUARTILES; off by default per user request.
.             local qmethods
292.             if "$HET_RUN_QUARTILES" == "1" local qmethods pw
293.             if "$HET_RUN_QUARTILES" == "1" & "$HET_INCLUDE_INSTWTD" == "1" local qmethods inst pw
294.             foreach qmethod of local qmethods {
295.             local quart_all
296.             if "`qmethod'" == "inst" {
297.                 foreach pair of global IC_PAIRS_Q {
298.                     local quart_all `"`quart_all' `"`pair'"' "'
299.                 }
300.                 local st_tag "quart"
301.                 local qplot_suf "_ppml_q_mshrctrl"
302.             }
303.             else {
304.                 foreach pair of global IC_PAIRS_Q_PW {
305.                     local quart_all `"`quart_all' `"`pair'"' "'
306.                 }
307.                 local st_tag "quart_pi"
308.                 local qplot_suf "_ppml_qpi_mshrctrl"
309.             }
310.             * PI-continuous quartiles run under BOTH methods (same dummies
.             * either way) so quart and quart_pi coefplots each fill their
.             * pi panel — mirrors pi_pairs in DUMMY_PAIRS_MED / _MED_PW.
.             foreach pair of global PI_PAIRS_Q {
311.                 local quart_all `"`quart_all' `"`pair'"' "'
312.             }
313.             foreach pair of local quart_all {
314.                 local g1: word 1 of `pair'
315.                 local g2: word 2 of `pair'
316.                 * mid-group name: q4w_<char> -> midw_<char>; q4_<base> -> mid_<base>
.                 if substr("`g1'", 1, 4) == "q4w_" {
317.                     local base = substr("`g1'", 5, .)
318.                     local gm "midw_`base'"
319.                 }
320.                 else {
321.                     local base = substr("`g1'", 4, .)
322.                     local gm "mid_`base'"
323.                 }
324.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
325.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
326.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `gm' ") == 0 continue
327. 
.                 * --- Pooled-DiD PPML with fully-interacted Z and share (Q4/Mid/Q1); posted as "mshrctrl" ---
.                 * [H11] Q1 x post is the omitted base
.                 cap drop Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm'
328.                 gen Z_`g1' = Z_it       * `g1'
329.                 gen Z_`g2' = Z_it       * `g2'
330.                 gen Z_`gm' = Z_it       * `gm'
331.                 gen S_`g1' = Z_share_it * `g1'
332.                 gen S_`g2' = Z_share_it * `g2'
333.                 gen S_`gm' = Z_share_it * `gm'
334.                 gen PT_`g1' = post * `g1'
335.                 gen PT_`gm' = post * `gm'
336.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
337.                 local rc = _rc
338.                 if `rc' {
339.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
340.                     continue
341.                 }
342.                 local Nppml = e(N)
343.                 local r2ppml = e(r2_p)
344.                 foreach grp in `g1' `g2' {
345.                     gunique athr_id if e(sample) & `grp' == 1
346.                     local num_athrs = r(unique)
347.                     gunique inst_id if e(sample) & `grp' == 1
348.                     local num_insts = r(unique)
349.                     local b_post  = _b[Z_`grp']
350.                     local se_post = _se[Z_`grp']
351.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
352.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
353.                 }
354. 
.                 * --- Joint event-study PPML for per-group ES PDFs only (not posted) ---
.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' ///
>                                  `mleads_`g2'' `mlags_`g2'' ///
>                                  `mleads_`gm'' `mlags_`gm''
355.                 local plot_suf "`qplot_suf'"
356.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' ///
>                                         `leads_`g2'' `lags_`g2'' ///
>                                         `leads_`gm'' `lags_`gm'' ///
>                                         `mshr_ctrls' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
357.                 if _rc {
358.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
359.                     continue
360.                 }
361.                 foreach grp in `g1' `g2' {
362.                     local grp_label = "${LBL_`grp'}"
363.                     if "`grp_label'" == "" local grp_label "`grp'"
364.                     gunique athr_id if e(sample) & `grp' == 1
365.                     local num_athrs = r(unique)
366.                     gunique inst_id if e(sample) & `grp' == 1
367.                     local num_insts = r(unique)
368.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
369.                     local pre_mean : dis %4.3f r(mean)
370.                     preserve
371.                     cap mat drop es
372.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
373.                         if "`var'" == "int_lead1_`grp'" {
374.                             mat row = 0,0
375.                         }
376.                         else {
377.                             mat row = _b[`var'], _se[`var']
378.                         }
379.                         mat es = nullmat(es) \ row
380.                     }
381.                     svmat es
382.                     keep es1 es2
383.                     drop if mi(es1)
384.                     rename (es1 es2) (b se)
385.                     gen ub = b + 1.96*se
386.                     sum ub, d
387.                     local ymax = round(r(max), 0.1)
388.                     gen lb = b - 1.96*se
389.                     sum lb, d
390.                     local ymin = round(r(min), 0.1)
391.                     if `ymin' > 0 local ymin = 0
392.                     gen rel = -`abs_lead' if _n == 1
393.                     replace rel = rel[_n-1]+1 if _n > 1
394.                     replace rel = rel + 1 if rel >= -1
395.                     replace rel = -1 if rel == `abs_lag' + 1
396.                     gen year = rel + 2014
397.                     hashsort rel
398.                     tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                       scatter b year, mcolor(ebblue) || ///
>                     scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                       xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                       ytitle("Exposure x Post") ylab(`ymin'(0.1)`ymax') ///
>                       subtitle("`grp_label'", pos(11) size(small)) ///
>                       legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small)) ///
>                       yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
399.                     graph export ../output/figures/`samp'/es_ppml/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
400.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
401.                     restore
402.                 }
403.             }
404.             }  // close foreach qmethod
405. 
.             * ---- PPML young x hiw_<char> joint 2x2 for every ic char.
.             * One pooled-DiD interaction fit per char; posts 4 rows per char.
.             foreach a of global IC_ALIASES {
406.                 cap confirm variable y_hi_`a'
407.                 if _rc continue
408.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
409.                     cap drop Z_`grp' S_`grp' PT_`grp'
410.                     gen Z_`grp' = Z_it       * `grp'
411.                     gen S_`grp' = Z_share_it * `grp'
412.                     gen PT_`grp' = post * `grp'
413.                 }
414.                 * [H11] o_lo x post is the omitted base (the four PTs sum to post)
.                 cap noi ppmlhdfe `yvar' Z_y_hi_`a' Z_y_lo_`a' Z_o_hi_`a' Z_o_lo_`a' ///
>                                         S_y_hi_`a' S_y_lo_`a' S_o_hi_`a' S_o_lo_`a' ///
>                                         PT_y_hi_`a' PT_y_lo_`a' PT_o_hi_`a', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
415.                 if _rc {
416.                     di as error "event_study_het `samp'`suf' `yvar' joint-ae `a' ppml failed; skipping."
417.                     continue
418.                 }
419.                 local Nppml = e(N)
420.                 local r2ppml = e(r2_p)
421.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
422.                     gunique athr_id if e(sample) & `grp' == 1
423.                     local num_athrs = r(unique)
424.                     gunique inst_id if e(sample) & `grp' == 1
425.                     local num_insts = r(unique)
426.                     local b_post  = _b[Z_`grp']
427.                     local se_post = _se[Z_`grp']
428.                     di as text "joint-ae PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
429.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_ae") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
430.                 }
431.                 * Hi-vs-Lo differential per age; SEs via lincom use full VCE.
.                 foreach age in y o {
432.                     cap noi lincom Z_`age'_hi_`a' - Z_`age'_lo_`a'
433.                     if _rc continue
434.                     local b_diff  = r(estimate)
435.                     local se_diff = r(se)
436.                     local p_diff  = r(p)
437.                     di as text "joint-ae DIFF `samp'`suf' `yvar' `age'_`a': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
438.                     post `ph_handle' ("`yvar'") ("`age'_diff_`a'") ("mshrctrl") ("joint_ae_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
439.                 }
440.             }
441. 
.             * ---- PPML joint 2x2 for each PI-split axis (baseline productivity,
.             * coauthors) crossed with each inst char. One fit per (axis, char).
.             foreach axis of global PI_CHAR_ALIASES {
442.                 local hp "${PI_CHAR_HIPFX_`axis'}"
443.                 local lp "${PI_CHAR_LOPFX_`axis'}"
444.                 foreach a of global IC_ALIASES {
445.                     cap confirm variable `hp'_hi_`a'
446.                     if _rc continue
447.                     foreach grp in `hp'_hi_`a' `hp'_lo_`a' `lp'_hi_`a' `lp'_lo_`a' {
448.                         cap drop Z_`grp' S_`grp' PT_`grp'
449.                         gen Z_`grp' = Z_it       * `grp'
450.                         gen S_`grp' = Z_share_it * `grp'
451.                         gen PT_`grp' = post * `grp'
452.                     }
453.                     * [H11] `lp'_lo x post is the omitted base
.                     cap noi ppmlhdfe `yvar' ///
>                         Z_`hp'_hi_`a' Z_`hp'_lo_`a' Z_`lp'_hi_`a' Z_`lp'_lo_`a' ///
>                         S_`hp'_hi_`a' S_`hp'_lo_`a' S_`lp'_hi_`a' S_`lp'_lo_`a' ///
>                         PT_`hp'_hi_`a' PT_`hp'_lo_`a' PT_`lp'_hi_`a', ///
>                         absorb(`fes') vce(cluster `vce_cl')
454.                     if _rc {
455.                         di as error "event_study_het `samp'`suf' `yvar' joint-ae-`axis' `a' ppml failed; skipping."
456.                         continue
457.                     }
458.                     local Nppml = e(N)
459.                     local r2ppml = e(r2_p)
460.                     foreach grp in `hp'_hi_`a' `hp'_lo_`a' `lp'_hi_`a' `lp'_lo_`a' {
461.                         gunique athr_id if e(sample) & `grp' == 1
462.                         local num_athrs = r(unique)
463.                         gunique inst_id if e(sample) & `grp' == 1
464.                         local num_insts = r(unique)
465.                         local b_post  = _b[Z_`grp']
466.                         local se_post = _se[Z_`grp']
467.                         di as text "joint-ae-`axis' PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
468.                         post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_ae_`axis'") ///
>                             (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
469.                     }
470.                     * Within-tier hp-vs-lp: low-res row is the thin cell that would carry the reversal claim.
.                     foreach side in hi lo {
471.                         cap noi lincom Z_`hp'_`side'_`a' - Z_`lp'_`side'_`a'
472.                         if _rc continue
473.                         local b_diff  = r(estimate)
474.                         local se_diff = r(se)
475.                         local t_diff  = cond(`se_diff' > 0, `b_diff'/`se_diff', .)
476.                         local p_diff  = r(p)
477.                         local ci_l    = r(lb)
478.                         local ci_h    = r(ub)
479.                         di as text "joint-ae-`axis' DIFF `samp'`suf' `yvar' `side'res_`a' (`hp'-`lp'): " ///
>                             "b=" %8.4f `b_diff' " se=" %8.4f `se_diff' ///
>                             " t=" %6.2f `t_diff' " p=" %6.4f `p_diff' ///
>                             " CI95=[" %6.3f `ci_l' "," %6.3f `ci_h' "]"
480.                         post `ph_handle' ("`yvar'") ("`side'res_diff_`a'") ("mshrctrl") ("joint_ae_`axis'_diff") ///
>                             (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
481.                     }
482.                 }
483.             }
484. 
.             * ---- Age x baseline-productivity 2x2 (no inst char). One PPML,
.             * four subgroup coefficients. Posts split_type = "joint_agepr".
.             cap confirm variable y_hp
485.             if !_rc {
486.                 foreach grp in y_hp y_lp o_hp o_lp {
487.                     cap drop Z_`grp' S_`grp' PT_`grp'
488.                     gen Z_`grp' = Z_it       * `grp'
489.                     gen S_`grp' = Z_share_it * `grp'
490.                     gen PT_`grp' = post * `grp'
491.                 }
492.                 * [H11] o_lp x post is the omitted base
.                 cap noi ppmlhdfe `yvar' Z_y_hp Z_y_lp Z_o_hp Z_o_lp ///
>                                         S_y_hp S_y_lp S_o_hp S_o_lp ///
>                                         PT_y_hp PT_y_lp PT_o_hp, ///
>                                         absorb(`fes') vce(cluster `vce_cl')
493.                 if _rc {
494.                     di as error "event_study_het `samp'`suf' `yvar' joint-agepr ppml failed; skipping."
495.                 }
496.                 else {
497.                     local Nppml = e(N)
498.                     local r2ppml = e(r2_p)
499.                     foreach grp in y_hp y_lp o_hp o_lp {
500.                         gunique athr_id if e(sample) & `grp' == 1
501.                         local num_athrs = r(unique)
502.                         gunique inst_id if e(sample) & `grp' == 1
503.                         local num_insts = r(unique)
504.                         local b_post  = _b[Z_`grp']
505.                         local se_post = _se[Z_`grp']
506.                         di as text "joint-agepr PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
507.                         post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_agepr") ///
>                             (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
508.                     }
509.                 }
510.             }
511. 
.         }
512.         postclose `ph_handle'
513. 
.         * pdid binscatter + coefplot for this yvar, so PDFs land continuously
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
514.             cap noi ppml_pdid_het_binscatter, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
515.         }
516.         cap noi ppml_het_coefplot, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
517.     }
518. 
.     * Combine per-yvar phet_results files into master (consumed by output_het_tables).
.     preserve
519.     clear
520.     foreach yvar of local yvar_list {
521.         cap append using ../temp/phet_results_`samp'`suf'_`yvar'
522.     }
523.     save ../temp/phet_results_`samp'`suf', replace
524.     restore
525. end

. 
. program ppml_pdid_het_binscatter
  1.     * Joint PPML pooled-DiD FWL binscatter of `yvar' on Z_it, mshr partialled.
.     * Fit ppmlhdfe on FULL sample with fully-interacted Z and share, then
.     * residualize _z_work and Z_grp against the sibling group + shares + FEs.
.     * On grp==1 rows the sibling interactions are 0 so FWL slope = _b[Z_grp].
.     * NOTE: residualization runs on the full sample while the plot keeps
.     * grp==1 rows, so the binned slope approximates the (exactly displayed)
.     * joint-fit coefficient.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     if "`yvar'" == "" local yvar ppr_cnt
  3.     local fes athr_id year
  4.     local vce_cl athr_id
  5.     if "$FE_MODE" == "inst_cluster" {
  6.         local fes inst_id cluster_30 year
  7.         local vce_cl inst_id
  8.     }
  9.     if "$FE_MODE" == "inst_cluster_fldyr" {
 10.         local fes inst_id i.cluster_30#i.year
 11.         local vce_cl inst_id
 12.     }
 13.     local suf ""
 14.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 15.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 16.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 17.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 18.     cap mkdir "../output/figures/`samp'/ppml_pdid_het_bs"
 19. 
.     * [H9] y-axis label per outcome (was hard-coded "Publications")
.     local bs_lbl "`yvar'"
 20.     if "`yvar'" == "ppr_cnt"           local bs_lbl "Publications"
 21.     if "`yvar'" == "cite_affl_wt"      local bs_lbl "Citation-Weighted Output"
 22.     if "`yvar'" == "avg_num_coathrs"   local bs_lbl "Coauthors"
 23.     if "`yvar'" == "n_grants"          local bs_lbl "Active NIH Research Grants"
 24.     if "`yvar'" == "n_new_grants"      local bs_lbl "New NIH Research Grants"
 25.     if "`yvar'" == "nih_total_cost"    local bs_lbl "NIH Award Dollars"
 26.     if "`yvar'" == "n_middle_ppr"      local bs_lbl "Middle-Author Papers"
 27. 
.     local dummy_pairs `" "young old" "young_nih old_nih" "r1 r2" "pub_inst priv_inst" "high_pre_ppr low_pre_ppr" "big_team small_team" "high_nihg low_nihg" "high_nihd low_nihd" ${IC_PAIRS_MED_PW} "'
 28.     if "$HET_INCLUDE_INSTWTD" == "1" local dummy_pairs `" `dummy_pairs' ${IC_PAIRS_MED} "'
 29. 
.     * Load panel once; per-pair vars are cap-dropped and rebuilt in place.
.     preserve
 30.         use ../temp/es_`samp'`suf', clear
 31.         gen post       = year >= 2014
 32.         gen Z_it       = exposure      * post
 33.         gen Z_share_it = mkt_spend_shr * post
 34. 
.         foreach pair of local dummy_pairs {
 35.             local g1 : word 1 of `pair'
 36.             local g2 : word 2 of `pair'
 37. 
.             * HET_GROUPS_ACTIVE (set by event_study_het before this is called)
.             * screens missing AND degenerate dummies — a no-obs group would
.             * crash binscatter and abort the remaining pairs.
.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
 38.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
 39. 
.             * one at a time — a `drop' list is all-or-nothing, and a missing
.             * Z_<grp> would leave _mu/_dvar alive to crash d() below
.             foreach v in Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1' _mu _z_work _dvar _fwlw _y_r _Z_r {
 40.                 cap drop `v'
 41.             }
 42.             gen Z_`g1' = Z_it       * `g1'
 43.             gen Z_`g2' = Z_it       * `g2'
 44.             gen S_`g1' = Z_share_it * `g1'
 45.             gen S_`g2' = Z_share_it * `g2'
 46.             gen PT_`g1' = post * `g1'
 47. 
.             * [H11] PT matches the posted pooled-DiD spec so displayed beta agrees
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
 48.             local rc = _rc
 49.             if `rc' {
 50.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `g1'/`g2' joint failed (rc=`rc'); skipping pair."
 51.                 continue
 52.             }
 53.             local b_`g1'  = _b[Z_`g1']
 54.             local se_`g1' = _se[Z_`g1']
 55.             local b_`g2'  = _b[Z_`g2']
 56.             local se_`g2' = _se[Z_`g2']
 57. 
.             * IRLS working response + FWL weight from the joint fit.
.             predict double _mu, mu
 58.             gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
 59.             gen double _fwlw = _mu if !mi(_mu) & _mu > 0
 60. 
.             foreach grp in `g1' `g2' {
 61.                 local other = cond("`grp'" == "`g1'", "`g2'", "`g1'")
 62. 
.                 foreach v in _y_r _Z_r {
 63.                     cap drop `v'
 64.                 }
 65.                 cap noi qui reghdfe _z_work Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_y_r)
 66.                 if _rc == 0 cap noi qui reghdfe Z_`grp' Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_Z_r)
 67.                 if _rc {
 68.                     di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
 69.                     continue
 70.                 }
 71.                 gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 72.                 local n_pis = r(unique)
 73.                 gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 74.                 local n_insts = r(unique)
 75.                 local b_str  : dis %7.3f `b_`grp''
 76.                 local se_str : dis %7.3f `se_`grp''
 77.                 binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                     xtitle("Exposure x Post") ///
>                     ytitle("{&Delta} Log Expected `bs_lbl'") ///
>                     xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                     msymbol(O) mcolor(ebblue) ///
>                     note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left)) ///
>                     plotregion(margin(sides))
 78.                 graph export ///
>                     ../output/figures/`samp'/ppml_pdid_het_bs/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf, ///
>                     replace
 79.             }
 80.         }
 81.     restore
 82. end

. 
. program desc_pre_output_by_age
  1.     * PI-level pre-period research-output densities, young vs old.
.     * Log-scale and raw (x capped at pooled p95) overlays per outcome.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir "../output/figures/`samp'"
  8. 
.     use ../temp/es_`samp'`suf', clear
  9.     keep if year < 2014
 10.     qui sum year
 11.     local y0 = r(min)
 12.     local y1 = r(max)
 13. 
.     * Productivity: total pre-period papers and papers per pre-period year.
.     * Citations and authorship-position counts ride along as totals.
.     local sum_src   ppr_cnt cite_affl_wt n_first_ppr n_last_ppr
 14.     local sum_alias ppr_tot cite         first       last
 15.     local mean_src   ppr_cnt
 16.     local mean_alias ppr_yr
 17.     local lbl_ppr_tot "Total Papers"
 18.     local lbl_ppr_yr  "Papers per Year"
 19.     local lbl_cite    "Affiliation-Weighted Citations"
 20.     local lbl_first   "First-Authored Papers"
 21.     local lbl_last    "Last-Authored Papers"
 22.     local fmt_ppr_tot %6.1f
 23.     local fmt_ppr_yr  %5.2f
 24.     local fmt_cite    %8.1f
 25.     local fmt_first   %6.1f
 26.     local fmt_last    %6.1f
 27. 
.     local coll_sum
 28.     local coll_mean
 29.     local keep_alias
 30.     foreach stat in sum mean {
 31.         local nsrc : word count ``stat'_src'
 32.         forvalues i = 1/`nsrc' {
 33.             local src : word `i' of ``stat'_src'
 34.             local a   : word `i' of ``stat'_alias'
 35.             cap confirm variable `src'
 36.             if _rc {
 37.                 di as error "desc_pre_output_by_age `samp'`suf': `src' not in panel -- `a' density SKIPPED."
 38.                 continue
 39.             }
 40.             local coll_`stat' `coll_`stat'' pre_`a'=`src'
 41.             local keep_alias `keep_alias' `a'
 42.         }
 43.     }
 44.     if "`keep_alias'" == "" {
 45.         di as error "desc_pre_output_by_age `samp'`suf': no outcomes available -- nothing plotted."
 46.         exit
 47.     }
 48.     local coll_sum_part = cond("`coll_sum'" == "", "", "(sum) `coll_sum'")
 49.     local coll_mean_part = cond("`coll_mean'" == "", "", "(mean) `coll_mean'")
 50. 
.     egen long inst_num = group(inst_id)
 51.     gcollapse `coll_sum_part' `coll_mean_part' (firstnm) young inst_num, by(athr_id)
 52.     drop if mi(young)
 53. 
.     qui count if young == 1
 54.     local n_y = r(N)
 55.     qui count if young == 0
 56.     local n_o = r(N)
 57.     di as text _n "desc_pre_output_by_age `samp'`suf': pre-period = `y0'-`y1', N young = `n_y', N old = `n_o'"
 58. 
.     foreach a of local keep_alias {
 59.         local f "`fmt_`a''"
 60.         qui sum pre_`a' if young == 1, d
 61.         local mu_y = strtrim(string(r(mean), "`f'"))
 62.         local md_y = strtrim(string(r(p50),  "`f'"))
 63.         qui sum pre_`a' if young == 0, d
 64.         local mu_o = strtrim(string(r(mean), "`f'"))
 65.         local md_o = strtrim(string(r(p50),  "`f'"))
 66.         local leg_y "Early-Career: mean=`mu_y', p50=`md_y', N=`n_y'"
 67.         local leg_o "Late-Career: mean=`mu_o', p50=`md_o', N=`n_o'"
 68.         di as text "  `a': young mean=`mu_y' p50=`md_y' | old mean=`mu_o' p50=`md_o'"
 69.         cap noi ksmirnov pre_`a', by(young)
 70.         qui reg pre_`a' young, vce(cluster inst_num)
 71.         di as text "  `a': young-old diff = " %8.3f _b[young] " (se " %8.3f _se[young] ")"
 72. 
.         gen double ln_pre_`a' = ln(1 + pre_`a')
 73.         tw kdensity ln_pre_`a' if young == 1, lcolor(ebblue) lwidth(medthick) || ///
>            kdensity ln_pre_`a' if young == 0, lcolor(dkorange) lwidth(medthick) ///
>            , xtitle("ln(1 + Pre-Period `lbl_`a'', `y0'-`y1')") ytitle("Density") ///
>              legend(order(1 "`leg_y'" 2 "`leg_o'") ///
>                     pos(2) ring(0) rows(2) size(small)) ///
>              plotregion(margin(sides))
 74.         graph export ../output/figures/`samp'/desc_kd_pre_`a'_ln`suf'.pdf, replace
 75. 
.         qui sum pre_`a', d
 76.         local xcap = r(p95)
 77.         tw kdensity pre_`a' if young == 1 & pre_`a' <= `xcap', lcolor(ebblue) lwidth(medthick) || ///
>            kdensity pre_`a' if young == 0 & pre_`a' <= `xcap', lcolor(dkorange) lwidth(medthick) ///
>            , xtitle("Pre-Period `lbl_`a'', `y0'-`y1' (x capped at pooled p95)") ytitle("Density") ///
>              legend(order(1 "`leg_y'" 2 "`leg_o'") ///
>                     pos(2) ring(0) rows(2) size(small)) ///
>              plotregion(margin(sides))
 78.         graph export ../output/figures/`samp'/desc_kd_pre_`a'_raw`suf'.pdf, replace
 79.     }
 80. 
.     save ../temp/desc_pre_output_`samp'`suf', replace
 81. end

. 
. program output_het_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir ../output/tables
  8.     cap mkdir ../output/tables/`samp'
  9. 
.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
 10.     if !_rc {
 11.         preserve
 12.         use "../temp/phet_results_`samp'`suf'.dta", clear
 13.         export delimited using "../output/tables/`samp'/phet_results`suf'.txt", replace delim(tab)
 14.         restore
 15.     }
 16. end

. 
. program ppml_het_coefplot
  1.     * Three panels per yvar (pi / ic_fund / ic_expx).
.     * If yvar() is supplied, plot only that outcome; otherwise loop all.
.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     * When called inline per-yvar, read the per-yvar postfile; otherwise the combined master.
.     if "`yvar'" != "" {
  8.         local resfile "../temp/phet_results_`samp'`suf'_`yvar'.dta"
  9.     }
 10.     else {
 11.         local resfile "../temp/phet_results_`samp'`suf'.dta"
 12.     }
 13.     cap confirm file "`resfile'"
 14.     if _rc {
 15.         di as error "ppml_het_coefplot: `resfile' not found -- skipping"
 16.         exit 0
 17.     }
 18. 
.     local ppml_het_yvars ppr_cnt cite_affl_wt avg_num_coathrs ///
>                         n_grants n_new_grants nih_total_cost ///
>                         n_middle_ppr
 19.     if "`yvar'" != "" local ppml_het_yvars `yvar'
 20. 
.     local ic_fund_aliases tfnd lsf
 21.     local ic_expx_aliases endow
 22.     if $HET_IC_FULL == 1 {
 23.         local ic_fund_aliases contr fdlsb fdls fdlsh gntsf hhlsb hhls hhlsh nflsb nfls nflsh subrf busf fedf tfnd instf nonpf statf lsf hsf biof
 24.         local ic_expx_aliases applx apfx basx bfx clinx devx lscx medx endow
 25.     }
 26. 
.     * joint_ae_<axis> types track PI_CHAR_ALIASES so dropping an axis there
.     * removes its coefplot too.
.     local axis_sts
 27.     foreach axis of global PI_CHAR_ALIASES {
 28.         local axis_sts `axis_sts' joint_ae_`axis'
 29.     }
 30.     local st_list med_pi joint_ae `axis_sts' joint_agepr
 31.     if "$HET_INCLUDE_INSTWTD" == "1" local st_list med `st_list'
 32.     if "$HET_RUN_QUARTILES" == "1" {
 33.         local st_list `st_list' quart_pi
 34.         if "$HET_INCLUDE_INSTWTD" == "1" local st_list `st_list' quart
 35.     }
 36.     foreach st of local st_list {
 37.         if "`st'" == "joint_ae" | "`st'" == "joint_agepr" | strpos("`st'", "joint_ae_") == 1 {
 38.             * Custom paired rendering used instead of the standard panel loop.
.             * Leaving all groups empty causes the standard loop to skip.
.             local groups_pi
 39.             local groups_ic_fund
 40.             local groups_ic_expx
 41.         }
 42.         else if "`st'" == "med" {
 43.             local groups_pi     young old young_nih old_nih r1 r2 pub_inst priv_inst ///
>                                 high_pre_ppr low_pre_ppr ///
>                                 big_team small_team ///
>                                 high_nihg low_nihg high_nihd low_nihd
 44.             local groups_ic_fund
 45.             foreach a of local ic_fund_aliases {
 46.                 local groups_ic_fund `groups_ic_fund' hi_`a' lo_`a'
 47.             }
 48.             local groups_ic_expx
 49.             foreach a of local ic_expx_aliases {
 50.                 local groups_ic_expx `groups_ic_expx' hi_`a' lo_`a'
 51.             }
 52.         }
 53.         else if "`st'" == "med_pi" {
 54.             * PI-weighted inst-char medians. PI-level splits are the same
.             * variables as under med so they render in the pi panel too.
.             local groups_pi     young old young_nih old_nih r1 r2 pub_inst priv_inst ///
>                                 high_pre_ppr low_pre_ppr ///
>                                 big_team small_team ///
>                                 high_nihg low_nihg high_nihd low_nihd
 55.             local groups_ic_fund
 56.             foreach a of local ic_fund_aliases {
 57.                 local groups_ic_fund `groups_ic_fund' hiw_`a' low_`a'
 58.             }
 59.             local groups_ic_expx
 60.             foreach a of local ic_expx_aliases {
 61.                 local groups_ic_expx `groups_ic_expx' hiw_`a' low_`a'
 62.             }
 63.         }
 64.         else if "`st'" == "quart" {
 65.             local groups_pi
 66.             foreach b of global PI_Q_BASES {
 67.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 68.             }
 69.             local groups_ic_fund
 70.             foreach a of local ic_fund_aliases {
 71.                 local groups_ic_fund `groups_ic_fund' q4_`a' q1_`a'
 72.             }
 73.             local groups_ic_expx
 74.             foreach a of local ic_expx_aliases {
 75.                 local groups_ic_expx `groups_ic_expx' q4_`a' q1_`a'
 76.             }
 77.         }
 78.         else {
 79.             * quart_pi -- PI-weighted quartiles for inst chars, PI-continuous
.             * quartiles for PI bases.
.             local groups_pi
 80.             foreach b of global PI_Q_BASES {
 81.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 82.             }
 83.             local groups_ic_fund
 84.             foreach a of local ic_fund_aliases {
 85.                 local groups_ic_fund `groups_ic_fund' q4w_`a' q1w_`a'
 86.             }
 87.             local groups_ic_expx
 88.             foreach a of local ic_expx_aliases {
 89.                 local groups_ic_expx `groups_ic_expx' q4w_`a' q1w_`a'
 90.             }
 91.         }
 92. 
.         foreach spec_tag in mshrctrl {
 93.             local spec_folder = cond($HET_IC_FULL == 1, "coefplot_evavg_full", "coefplot_evavg")
 94.             cap mkdir "../output/figures/`samp'/`spec_folder'"
 95. 
.         * Combined panel stacks pi + ic_fund + ic_expx so the paper can show
.         * one coefplot per (yvar, spec, st) instead of three per-panel PDFs.
.         local groups_all `groups_pi' `groups_ic_fund' `groups_ic_expx'
 96.         foreach panel in pi ic_fund ic_expx all {
 97.             local groups `groups_`panel''
 98.             local n_groups : word count `groups'
 99.             if `n_groups' == 0 continue
100. 
.             foreach yv of local ppml_het_yvars {
101.                 preserve
102.                 use "`resfile'", clear
103.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
104.                 if _N == 0 {
105.                     restore
106.                     continue
107.                 }
108. 
.                 * Groups come in high/low pairs; add a gap between pairs so
.                 * each pair reads as one block.
.                 local pair_gap 0.7
109.                 local npairs = ceil(`n_groups'/2)
110.                 gen double y = .
111.                 local ylabs ""
112.                 local i = 0
113.                 foreach g of local groups {
114.                     local ++i
115.                     local pair = int((`i'-1)/2)
116.                     local ypos = (`n_groups' - `i') + (`npairs' - 1 - `pair')*`pair_gap' + 1
117.                     qui replace y = `ypos' if grp == "`g'"
118.                     local lbl = "${LBL_`g'}"
119.                     if "`lbl'" == "" local lbl "`g'"
120.                     if length("`lbl'") > 40 local lbl = substr("`lbl'", 1, 37) + "..."
121.                     local ylabs `"`ylabs' `ypos' "`lbl'""'
122.                 }
123.                 drop if mi(y) | mi(post_b)
124.                 if _N == 0 {
125.                     restore
126.                     continue
127.                 }
128.                 gen ub = post_b + 1.96*post_se
129.                 gen lb = post_b - 1.96*post_se
130. 
.                 qui sum lb
131.                 local xmin = floor(r(min)/0.5)*0.5
132.                 qui sum ub
133.                 local xmax = ceil(r(max)/0.5)*0.5
134. 
.                 * Adaptive canvas: bigger for more rows. Matches old reduced_form format.
.                 local ysize 6
135.                 if `n_groups' > 20 local ysize 10
136.                 if `n_groups' > 40 local ysize 14
137.                 * Grow the canvas by the added inter-pair whitespace.
.                 local ysize = round(`ysize' * (`n_groups' + (`npairs'-1)*`pair_gap')/`n_groups', 0.1)
138.                 local labsize small
139.                 if `n_groups' > 20 local labsize vsmall
140. 
.                 tw rcap ub lb y, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>                    scatter y post_b, mcolor(ebblue) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(`labsize') noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(off) ///
>                      ysize(`ysize') xsize(7) ///
>                      yscale(range(0.9 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
141.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf", ///
>                     replace
142.                 di as text "wrote ../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf"
143.                 restore
144.             }
145.         }
146. 
.         * ----- Custom paired coefplot: inst chars on y-axis (High/Low rows),
.         *       one blue + one orange marker per row. Splitting axis and
.         *       prefix widths depend on `st':
.         *         joint_ae         -- age (1-char y/o prefix)
.         *         joint_ae_<axis>  -- PI split (2-char hp/lp or mc/fc prefix)
.         if "`st'" == "joint_ae" | strpos("`st'", "joint_ae_") == 1 {
147.             if "`st'" == "joint_ae" {
148.                 local pfx_len   1
149.                 local hi_pfx    y
150.                 local lo_pfx    o
151.                 local hi_leg    "Early-Career"
152.                 local lo_leg    "Late-Career"
153.                 local filename_stem joint_ae_paired
154.             }
155.             else {
156.                 local axis : subinstr local st "joint_ae_" "", all
157.                 local pfx_len   2
158.                 local hi_pfx    "${PI_CHAR_HIPFX_`axis'}"
159.                 local lo_pfx    "${PI_CHAR_LOPFX_`axis'}"
160.                 local hi_leg    "${PI_CHAR_HILEG_`axis'}"
161.                 local lo_leg    "${PI_CHAR_LOLEG_`axis'}"
162.                 local filename_stem "joint_ae_`axis'_paired"
163.             }
164.             local hilo_pos = `pfx_len' + 2
165.             local char_pos = `pfx_len' + 5
166.             foreach yv of local ppml_het_yvars {
167.                 preserve
168.                 use "`resfile'", clear
169.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
170.                 if _N == 0 {
171.                     restore
172.                     continue
173.                 }
174.                 gen str2  pfx_c  = substr(grp, 1, `pfx_len')
175.                 gen str2  hilo_c = substr(grp, `hilo_pos', 2)
176.                 gen str12 char_c = substr(grp, `char_pos', .)
177.                 gen byte  is_hi_side = (pfx_c == "`hi_pfx'")
178.                 gen char_idx = .
179.                 local ii = 0
180.                 foreach a of global IC_ALIASES {
181.                     local ++ii
182.                     qui replace char_idx = `ii' if char_c == "`a'"
183.                 }
184.                 qui drop if mi(char_idx)
185.                 if _N == 0 {
186.                     restore
187.                     continue
188.                 }
189.                 qui sum char_idx
190.                 local nchars = r(max)
191.                 * Row layout: within-pair (blue+orange same hi/lo) 0.6;
.                 * between hi-row and lo-row of same char = 0.8; between
.                 * chars = 1.2. Base spacing 3.2 per char.
.                 gen double y_group = (`nchars' + 1 - char_idx) * 3.2
192.                 gen double y_pos   = y_group ///
>                     + cond(hilo_c == "hi" & is_hi_side == 1,  1.0, ///
>                       cond(hilo_c == "hi" & is_hi_side == 0,  0.4, ///
>                       cond(hilo_c == "lo" & is_hi_side == 1, -0.4, -1.0)))
193.                 gen ub = post_b + 1.96*post_se
194.                 gen lb = post_b - 1.96*post_se
195. 
.                 local ylabs
196.                 forvalues i = 1/`nchars' {
197.                     qui levelsof char_c if char_idx == `i', local(cname) clean
198.                     local clbl = "${LBL_ic_`cname'}"
199.                     if "`clbl'" == "" local clbl "`cname'"
200.                     local base = (`nchars' + 1 - `i') * 3.2
201.                     local pos_hi = `base' + 1.0
202.                     local pos_lo = `base' - 0.4
203.                     local ylabs `"`ylabs' `pos_hi' "High `clbl'""'
204.                     local ylabs `"`ylabs' `pos_lo' "Low `clbl'""'
205.                 }
206. 
.                 qui sum lb
207.                 local xmin = floor(r(min)/0.5)*0.5
208.                 qui sum ub
209.                 local xmax = ceil(r(max)/0.5)*0.5
210. 
.                 tw rcap ub lb y_pos if is_hi_side == 1, horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>                    scatter y_pos post_b if is_hi_side == 1, mcolor(ebblue) msize(small)              || ///
>                    rcap ub lb y_pos if is_hi_side == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                    scatter y_pos post_b if is_hi_side == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(order(2 "`hi_leg'" 4 "`lo_leg'") pos(6) ring(1) rows(1) span size(small)) ///
>                      ysize(`=max(8, `nchars'*1.6)') xsize(9) ///
>                      yscale(range(2.1 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
211.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`filename_stem'`suf'.pdf", ///
>                     replace
212.                 di as text "wrote `filename_stem' coefplot for `yv' `spec_tag'"
213.                 restore
214.             }
215.         }
216. 
.         * ----- Age x baseline-productivity 2x2 (no inst char).
.         *       Two rows: High Baseline Productivity / Low Baseline Productivity.
.         *       Blue = Early-Career, Orange = Late-Career.
.         if "`st'" == "joint_agepr" {
217.             foreach yv of local ppml_het_yvars {
218.                 preserve
219.                 use "`resfile'", clear
220.                 keep if yvar == "`yv'" & split_type == "joint_agepr" & spec == "`spec_tag'"
221.                 if _N == 0 {
222.                     restore
223.                     continue
224.                 }
225.                 gen byte is_young = (substr(grp, 1, 1) == "y")
226.                 gen str2 pr_c    = substr(grp, 3, 2)
227.                 gen double y_pos = cond(pr_c == "hp",  2, 1) ///
>                                    + cond(is_young == 1,  0.3, -0.3)
228.                 gen ub = post_b + 1.96*post_se
229.                 gen lb = post_b - 1.96*post_se
230. 
.                 local ylabs `"2 "High Baseline Productivity" 1 "Low Baseline Productivity""'
231. 
.                 qui sum lb
232.                 local xmin = floor(r(min)/0.5)*0.5
233.                 qui sum ub
234.                 local xmax = ceil(r(max)/0.5)*0.5
235. 
.                 tw rcap ub lb y_pos if is_young == 1, horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>                    scatter y_pos post_b if is_young == 1, mcolor(ebblue) msize(small)              || ///
>                    rcap ub lb y_pos if is_young == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                    scatter y_pos post_b if is_young == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(order(2 "Early-Career" 4 "Late-Career") pos(6) ring(1) rows(1) span size(small)) ///
>                      ysize(5) xsize(7) ///
>                      yscale(range(0.62 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
236.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_joint_agepr`suf'.pdf", ///
>                     replace
237.                 di as text "wrote joint_agepr coefplot for `yv' `spec_tag'"
238.                 restore
239.             }
240.         }
241.         }  // close foreach spec_tag
242.     }
243. end

