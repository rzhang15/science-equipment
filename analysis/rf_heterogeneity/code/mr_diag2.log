.     qui sum pre_early if _one == 1, d

.     local cut = r(p50)

.     gen byte hp2 = pre_early >= `cut'

.     gen byte lp2 = pre_early <  `cut'

.     di as text "  cut = `cut';  N PIs hi/lo:"
