 40. 
.     local ic_lbl_contr "Total Contract Funding"
 41.     local ic_lbl_fdlsb "Federal Life-Sci Biology Funding"
 42.     local ic_lbl_fdls  "Federal Life-Sci Funding"
 43.     local ic_lbl_fdlsh "Federal Life-Sci Health-Sci Funding"
 44.     local ic_lbl_gntsf "Grants Funding"
 45.     local ic_lbl_hhlsb "HHS Life-Sci Biology Funding"
 46.     local ic_lbl_hhls  "HHS Life-Sci Funding"
 47.     local ic_lbl_hhlsh "HHS Life-Sci Health-Sci Funding"
 48.     local ic_lbl_nflsb "Non-Federal Life-Sci Biology Funding"
 49.     local ic_lbl_nfls  "Non-Federal Life-Sci Funding"
 50.     local ic_lbl_nflsh "Non-Federal Life-Sci Health-Sci Funding"
 51.     local ic_lbl_subrf "Subrecipient Funding"
