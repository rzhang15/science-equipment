. program main
  1.     gather_inst_chars
  2.     define_group_labels
  3.     local s all_jrnls
  4.     cap mkdir "../output/figures/`s'"
  5.     if $HET_HORSERACE_ONLY == 1 {
  6.         cap mkdir ../temp
  7.         cap confirm file ../temp/es_`s'_r1_r2.dta
  8.         if _rc add_het_splits, samp(`s') r1r2(1) public(0)
  9.         cap confirm file ../temp/es_`s'_r1_r2_public.dta
 10.         if _rc add_het_splits, samp(`s') r1r2(1) public(1)
 11.         desc_exposure_by_age, samp(`s') r1r2(1) public(0)
 12.         desc_exposure_by_age, samp(`s') r1r2(1) public(1)
 13.     }
 14.     if $HET_HORSERACE_ONLY == 0 {
 15.         add_het_splits, samp(`s') r1r2(1) public(0)
 16.         desc_pre_output_by_age, samp(`s') r1r2(1) public(0)
 17.         desc_exposure_by_age, samp(`s') r1r2(1) public(0)
 18.         event_study_het, samp(`s') r1r2(1) public(0)
 19.         ppml_age_gradient, samp(`s') r1r2(1) public(0)
 20.     }
 21.     horse_race_nih, samp(`s') r1r2(1) public(0)
 22.     output_het_tables, samp(`s') r1r2(1) public(0)
 23.     output_split_diff_tables, samp(`s') r1r2(1) public(0)
 24. 
.     if $HET_HORSERACE_ONLY == 0 {
 25.         add_het_splits, samp(all_jrnls) r1r2(1) public(1)
 26.         desc_pre_output_by_age, samp(all_jrnls) r1r2(1) public(1)
 27.         desc_exposure_by_age, samp(all_jrnls) r1r2(1) public(1)
 28.         event_study_het, samp(all_jrnls) r1r2(1) public(1)
 29.         ppml_age_gradient, samp(all_jrnls) r1r2(1) public(1)
 30.     }
 31.     horse_race_nih, samp(all_jrnls) r1r2(1) public(1)
 32.     output_het_tables, samp(all_jrnls) r1r2(1) public(1)
 33.     output_split_diff_tables, samp(all_jrnls) r1r2(1) public(1)
 34. end

