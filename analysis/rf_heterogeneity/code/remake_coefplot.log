.             local qmethods
465.             if "$HET_RUN_QUARTILES" == "1" local qmethods pw
466.             if "$HET_RUN_QUARTILES" == "1" & "$HET_INCLUDE_INSTWTD" == "1" local qmethods inst pw
467.             foreach qmethod of local qmethods {
