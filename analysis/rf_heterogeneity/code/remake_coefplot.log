. program gather_inst_chars
  1.     import delimited ../external/college/ipeds_openalex.csv, ///
>         clear varn(1) stringcols(_all)
  2.     keep ipeds_id inst_id
  3.     drop if inst_id == "" | ipeds_id == ""
  4.     destring ipeds_id, replace
  5.     duplicates drop
  6.     bys ipeds_id: gen _ndup = _N
  7.     qui count if _ndup > 1
  8.     if r(N) > 0 {
  9.         di as error "gather_inst_chars: " r(N) " rows with duplicate ipeds_id in crosswalk; keeping first inst_id per ipeds_id. VERIFY the crosswalk."
 10.         bys ipeds_id (inst_id): keep if _n == 1
 11.     }
 12.     drop _ndup
 13.     save ../temp/ipeds_openalex_xw, replace
 14. 
.     use ../external/inst_chars/combined_pre, clear
 15.     merge 1:1 ipeds_id using ../temp/ipeds_openalex_xw, keep(3) nogen
 16.     drop ipeds_id
 17.     bys inst_id: gen _ndup = _N
 18.     qui count if _ndup > 1
 19.     if r(N) > 0 {
 20.         di as error "gather_inst_chars: " r(N) " rows with duplicate inst_id after ipeds merge; keeping first row per inst_id. VERIFY the crosswalk."
 21.         bys inst_id: keep if _n == 1
 22.     }
 23.     drop _ndup
 24. 
.     rename contracts_fund      ic_contr
 25.     rename fed_ls_bio_fund     ic_fdlsb
 26.     rename fed_ls_fund         ic_fdls
 27.     rename fed_ls_hs_fund      ic_fdlsh
 28.     rename grants_fund         ic_gntsf
 29.     rename hhs_ls_bio_fund     ic_hhlsb
 30.     rename hhs_ls_fund         ic_hhls
 31.     rename hhs_ls_hs_fund      ic_hhlsh
 32.     rename nonfed_ls_bio_fund  ic_nflsb
 33.     rename nonfed_ls_fund      ic_nfls
 34.     rename nonfed_ls_hs_fund   ic_nflsh
 35.     rename subrecipient_fund   ic_subrf
 36.     rename tot_bus_fund        ic_busf
 37.     rename tot_fed_fund        ic_fedf
 38.     rename tot_fund            ic_tfnd
 39.     rename tot_inst_fund       ic_instf
 40.     rename tot_nonprof_fund    ic_nonpf
 41.     rename tot_state_fund      ic_statf
 42.     rename ls_fund             ic_lsf
 43.     rename hs_fund             ic_hsf
 44.     rename bio_fund            ic_biof
 45.     rename applied_expend      ic_applx
 46.     rename applied_fed_expend  ic_apfx
 47.     rename basic_expend        ic_basx
 48.     rename basic_fed_expend    ic_bfx
 49.     rename clin_trial_expend   ic_clinx
 50.     rename dev_expend          ic_devx
 51.     rename ls_cap_expend       ic_lscx
 52.     rename med_sch_expend      ic_medx
 53.     rename endowment           ic_endow
 54. 
.     order inst_id
 55.     compress
 56.     save ../temp/inst_chars_pre, replace
 57. end

. 
