475.             }
476.             else {
477.                 foreach pair of global IC_PAIRS_Q_PW {
478.                     local quart_all `"`quart_all' `"`pair'"' "'
479.                 }
480.                 local st_tag "quart_pi"
481.                 local qplot_suf "_ppml_qpi_mshrctrl"
482.             }
483.             foreach pair of global PI_PAIRS_Q {
484.                 local quart_all `"`quart_all' `"`pair'"' "'
485.             }
486.             foreach pair of local quart_all {
487.                 local g1: word 1 of `pair'
488.                 local g2: word 2 of `pair'
489.                 if substr("`g1'", 1, 4) == "q4w_" {
490.                     local base = substr("`g1'", 5, .)
491.                     local gm "midw_`base'"
492.                 }
493.                 else {
494.                     local base = substr("`g1'", 4, .)
495.                     local gm "mid_`base'"
496.                 }
497.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
498.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
499.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `gm' ") == 0 continue
500. 
.                 cap drop Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm'
501.                 gen Z_`g1' = Z_it       * `g1'
502.                 gen Z_`g2' = Z_it       * `g2'
503.                 gen Z_`gm' = Z_it       * `gm'
504.                 gen S_`g1' = Z_share_it * `g1'
505.                 gen S_`g2' = Z_share_it * `g2'
506.                 gen S_`gm' = Z_share_it * `gm'
507.                 gen PT_`g1' = post * `g1'
508.                 gen PT_`gm' = post * `gm'
509.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' Z_`gm' S_`g1' S_`g2' S_`gm' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
510.                 local rc = _rc
511.                 if `rc' {
512.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
513.                     continue
514.                 }
515.                 local Nppml = e(N)
516.                 local r2ppml = e(r2_p)
517.                 foreach grp in `g1' `g2' {
518.                     gunique athr_id if e(sample) & `grp' == 1
519.                     local num_athrs = r(unique)
520.                     gunique inst_id if e(sample) & `grp' == 1
521.                     local num_insts = r(unique)
522.                     local b_post  = _b[Z_`grp']
523.                     local se_post = _se[Z_`grp']
524.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
525.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
526.                 }
527. 
.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' ///
>                                  `mleads_`g2'' `mlags_`g2'' ///
>                                  `mleads_`gm'' `mlags_`gm''
528.                 local plot_suf "`qplot_suf'"
529.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' ///
>                                         `leads_`g2'' `lags_`g2'' ///
>                                         `leads_`gm'' `lags_`gm'' ///
>                                         `mshr_ctrls' PT_`g1' PT_`gm', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
530.                 if _rc {
531.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
532.                     continue
533.                 }
534.                 foreach grp in `g1' `g2' {
535.                     local grp_label = "${LBL_`grp'}"
536.                     if "`grp_label'" == "" local grp_label "`grp'"
537.                     gunique athr_id if e(sample) & `grp' == 1
538.                     local num_athrs = r(unique)
539.                     gunique inst_id if e(sample) & `grp' == 1
540.                     local num_insts = r(unique)
541.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
542.                     local pre_mean : dis %4.3f r(mean)
543.                     preserve
544.                     cap mat drop es
545.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
546.                         if "`var'" == "int_lead1_`grp'" {
547.                             mat row = 0,0
548.                         }
549.                         else {
550.                             mat row = _b[`var'], _se[`var']
551.                         }
552.                         mat es = nullmat(es) \ row
553.                     }
554.                     svmat es
555.                     keep es1 es2
556.                     drop if mi(es1)
557.                     rename (es1 es2) (b se)
558.                     gen ub = b + 1.96*se
559.                     gen lb = b - 1.96*se
560.                     local ymax = 1.2
561.                     local ymin = -2.2
562.                     local pgap 0.2
563.                     gen rel = -`abs_lead' if _n == 1
564.                     replace rel = rel[_n-1]+1 if _n > 1
565.                     replace rel = rel + 1 if rel >= -1
566.                     replace rel = -1 if rel == `abs_lag' + 1
567.                     gen year = rel + 2014
568.                     hashsort rel
569.                     local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
570.                     local fdir ../output/figures/`samp'/es_ppml
571.                     foreach fmode of global FIG_MODES {
572.                         if "`fmode'" == "paper" {
573.                             local stats_leg legend(off)
574.                             local fdir ../output/figures/`samp'/es_ppml/paper
575.                             cap mkdir "`fdir'"
576.                         }
577.                         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                           scatter b year, mcolor(ebblue) || ///
>                         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                           xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                           ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                           `stats_leg' ///
>                           yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
578.                         graph export `fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
579.                     }
580.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
581.                     restore
582.                 }
583.             }
584.             }
585. 
.             foreach a of global IC_ALIASES {
586.                 cap confirm variable y_hi_`a'
587.                 if _rc continue
588.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
589.                     cap drop Z_`grp' S_`grp' PT_`grp'
590.                     gen Z_`grp' = Z_it       * `grp'
591.                     gen S_`grp' = Z_share_it * `grp'
592.                     gen PT_`grp' = post * `grp'
593.                 }
594.                 cap noi ppmlhdfe `yvar' Z_y_hi_`a' Z_y_lo_`a' Z_o_hi_`a' Z_o_lo_`a' ///
>                                         S_y_hi_`a' S_y_lo_`a' S_o_hi_`a' S_o_lo_`a' ///
>                                         PT_y_hi_`a' PT_y_lo_`a' PT_o_hi_`a', ///
>                                         absorb(`fes') vce(cluster `vce_cl')
595.                 if _rc {
596.                     di as error "event_study_het `samp'`suf' `yvar' joint-ae `a' ppml failed; skipping."
597.                     continue
598.                 }
599.                 local Nppml = e(N)
600.                 local r2ppml = e(r2_p)
601.                 foreach grp in y_hi_`a' y_lo_`a' o_hi_`a' o_lo_`a' {
602.                     gunique athr_id if e(sample) & `grp' == 1
603.                     local num_athrs = r(unique)
604.                     gunique inst_id if e(sample) & `grp' == 1
605.                     local num_insts = r(unique)
606.                     local b_post  = _b[Z_`grp']
607.                     local se_post = _se[Z_`grp']
608.                     di as text "joint-ae PPML `samp'`suf' `yvar' `grp': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
609.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("joint_ae") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
610.                 }
611.                 foreach age in y o {
612.                     cap noi lincom Z_`age'_hi_`a' - Z_`age'_lo_`a'
613.                     if _rc continue
614.                     local b_diff  = r(estimate)
615.                     local se_diff = r(se)
616.                     local p_diff  = r(p)
617.                     di as text "joint-ae DIFF `samp'`suf' `yvar' `age'_`a': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
618.                     post `ph_handle' ("`yvar'") ("`age'_diff_`a'") ("mshrctrl") ("joint_ae_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
619.                 }
620.                 foreach hl in hi lo {
621.                     cap noi lincom Z_o_`hl'_`a' - Z_y_`hl'_`a'
622.                     if _rc continue
623.                     local b_gap  = r(estimate)
624.                     local se_gap = r(se)
625.                     local p_gap  = r(p)
626.                     di as text "joint-ae GAP `samp'`suf' `yvar' `hl'_`a' (late - early): b=" %8.4f `b_gap' ///
>                         " (se=" %8.4f `se_gap' ") p=" %6.4f `p_gap'
627.                     post `ph_handle' ("`yvar'") ("`hl'_gap_`a'") ("mshrctrl") ("joint_ae_gap") ///
>                         (`b_gap') (`se_gap') (`p_gap') (.) (`Nppml') (`r2ppml')
628.                 }
629.             }
630. 
.         }
631.         postclose `ph_handle'
632. 
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
633.             cap noi ppml_pdid_het_binscatter, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
634.         }
635.         cap noi ppml_het_coefplot, samp(`samp') r1r2(`r1r2') public(`public') r1_only(`r1_only') yvar(`yvar')
636.     }
637. 
.     preserve
638.     clear
639.     foreach yvar of local yvar_list {
640.         cap append using ../temp/phet_results_`samp'`suf'_`yvar'
641.     }
642.     save ../temp/phet_results_`samp'`suf', replace
643.     restore
644. end

