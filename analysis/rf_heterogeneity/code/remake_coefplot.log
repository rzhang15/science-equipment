. program add_het_splits
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     use ../external/prepped_samples/es_`samp'`suf', clear
  8. 
.     cap drop athr_indicator
  9.     bys athr_id : gen athr_indicator = _n == 1
 10. 
.     if "$LAB_CLOCK" == "athr_age" {
 11.         merge m:1 athr_id using ../external/athr_age/athr_age, ///
>             keep(1 3) keepusing(first_last) nogen
 12.         cap confirm variable min_year_nonsolo
 13.         if !_rc replace min_year = min(first_last, min_year_nonsolo)
 14.         else {
 15.             di as error "add_het_splits `samp'`suf': min_year_nonsolo not in panel -- lab clock = first_last only"
 16.             replace min_year = first_last
 17.         }
 18.         qui count if athr_indicator == 1 & mi(min_year)
 19.         di as text "add_het_splits `samp'`suf': lab clock = min(athr_age first_last, min_year_nonsolo); " ///
>             r(N) " PIs with neither drop from lab-age splits"
 20.         drop first_last
 21.     }
 22. 
.     qui sum pre_ppr_cnt_sum if athr_indicator == 1, d
 23.     local ppr_cut = r(p50)
 24.     gen high_pre_ppr = pre_ppr_cnt_sum >= `ppr_cut' if !mi(pre_ppr_cnt_sum)
 25.     gen low_pre_ppr  = pre_ppr_cnt_sum <  `ppr_cut' if !mi(pre_ppr_cnt_sum)
 26. 
.     qui sum min_year if athr_indicator == 1, d
 27.     local lastyr_med = r(p50)
 28.     di as text "add_het_splits `samp'`suf' min_year (first last-author yr) median = `lastyr_med'"
 29.     gen young = min_year >  `lastyr_med' if !mi(min_year)
 30.     gen old   = min_year <= `lastyr_med' if !mi(min_year)
 31. 
.     cap confirm variable min_year_nonsolo
 32.     if !_rc {
 33.         qui sum min_year_nonsolo if athr_indicator == 1, d
 34.         local nsyr_med = r(p50)
 35.         qui count if athr_indicator == 1 & mi(min_year_nonsolo)
 36.         di as text "add_het_splits `samp'`suf' min_year_nonsolo median = `nsyr_med'; " r(N) " PIs with no non-solo last-author paper"
 37.         gen byte young_ns = min_year_nonsolo >  `nsyr_med' if !mi(min_year_nonsolo)
 38.         gen byte old_ns   = min_year_nonsolo <= `nsyr_med' if !mi(min_year_nonsolo)
 39.         gen lab_age_ns_2014 = 2014 - min_year_nonsolo
 40.     }
 41.     else di as error "add_het_splits `samp'`suf': min_year_nonsolo not in panel -- young_ns/old_ns SKIPPED (rerun reduced_form/code/analysis.do)."
 42. 
.     cap confirm variable min_year_any
 43.     if !_rc {
 44.         qui sum min_year_any if athr_indicator == 1, d
 45.         local anyyr_med = r(p50)
 46.         di as text "add_het_splits `samp'`suf' min_year_any (first pub ever) median = `anyyr_med'"
 47.         gen byte young_any = min_year_any >  `anyyr_med' if !mi(min_year_any)
 48.         gen byte old_any   = min_year_any <= `anyyr_med' if !mi(min_year_any)
 49.     }
 50.     else di as error "add_het_splits `samp'`suf': min_year_any not in panel -- young_any/old_any SKIPPED."
 51. 
.     gen r1 = type == "r1" if !mi(type)
 52.     gen r2 = type == "r2" if !mi(type)
 53.     gen byte pub_inst  = public == 1 if !mi(public)
 54.     gen byte priv_inst = public == 0 if !mi(public)
 55. 
.     local nih_src   n_grants nih_total_cost
 56.     local nih_alias nihg     nihd
 57.     forvalues i = 1/2 {
 58.         local src : word `i' of `nih_src'
 59.         local alias : word `i' of `nih_alias'
 60.         cap confirm variable `src'
 61.         if _rc {
 62.             di as error "add_het_splits `samp'`suf': `src' not in panel -- `alias' split SKIPPED (rerun reduced_form/restrict_samp)."
 63.             continue
 64.         }
 65.         gen pre_`alias'_yr = `src' if year < 2014
 66.         bys athr_id: egen pre_`alias' = mean(pre_`alias'_yr)
 67.         drop pre_`alias'_yr
 68.         local src pre_`alias'
 69.         qui sum `src' if athr_indicator == 1, d
 70.         local nih_n = r(N)
 71.         local nih_p50 = r(p50)
 72.         di as text "add_het_splits `samp'`suf' `alias' N_pi=`nih_n' p50=`nih_p50'"
 73.         gen byte high_`alias' = `src' >= `nih_p50' if !mi(`src')
 74.         gen byte low_`alias'  = `src' <  `nih_p50' if !mi(`src')
 75.     }
 76. 
.     cap confirm variable pre_nihd
 77.     if !_rc {
 78.         qui sum pre_nihd if athr_indicator == 1 & young == 1, d
 79.         local ynih_n = r(N)
 80.         local ynih_med = r(p50)
 81.         local ynih_p25 = r(p25)
 82.         local ynih_p75 = r(p75)
 83.         di as text "add_het_splits `samp'`suf' young-only nihd N_pi=`ynih_n' p25=`ynih_p25' p50=`ynih_med' p75=`ynih_p75'"
 84.         gen byte yhigh_nihd = pre_nihd >= `ynih_med' if !mi(pre_nihd) & young == 1
 85.         gen byte ylow_nihd  = pre_nihd <  `ynih_med' if !mi(pre_nihd) & young == 1
 86.         gen byte yq4_nihd = pre_nihd >= `ynih_p75' if !mi(pre_nihd) & young == 1 ///
>                             & (pre_nihd >= `ynih_p75' | pre_nihd <= `ynih_p25')
 87.         gen byte yq1_nihd = 1 - yq4_nihd
 88.     }
 89. 
.     cap drop nih_pi
 90.     cap confirm variable nih_matched
 91.     if !_rc {
 92.         bys athr_id: egen byte nih_pi = max(nih_matched == 1)
 93.     }
 94.     else {
 95.         cap confirm variable n_grants
 96.         if !_rc bys athr_id: egen byte nih_pi = max(!mi(n_grants))
 97.     }
 98.     cap confirm variable nih_pi
 99.     if !_rc {
100.         qui count if nih_pi == 1 & athr_indicator == 1
101.         di as text "add_het_splits `samp'`suf' NIH-matched PIs = " r(N)
102.         gen byte young_nih = young if nih_pi == 1 & !mi(young)
103.         gen byte old_nih   = old   if nih_pi == 1 & !mi(old)
104.     }
105.     else di as error "add_het_splits `samp'`suf': no NIH match flag in panel -- young_nih/old_nih SKIPPED."
106. 
.     cap confirm variable msa_size
107.     if !_rc {
108.         gen msa_size_2014 = msa_size if year == 2014
109.         bys athr_id: egen msa_size_at = max(msa_size_2014)
110.         drop msa_size_2014
111.     }
112. 
.     merge m:1 inst_id using ../temp/inst_chars_pre, keep(1 3) nogen
113.     cap drop inst_indicator
114.     bys inst_id : gen inst_indicator = _n == 1
115.     foreach a of global IC_ALIASES {
116.         cap confirm variable ic_`a'
117.         if _rc continue
118.         qui sum ic_`a' if inst_indicator == 1, d
119.         local ic_n = r(N)
120.         local ic_p50 = r(p50)
121.         local ic_p25 = r(p25)
122.         local ic_p75 = r(p75)
123.         di as text "add_het_splits `samp'`suf' ic_`a' inst-wtd N_inst=`ic_n' p25=`ic_p25' p50=`ic_p50' p75=`ic_p75'"
124.         gen byte hi_`a'  = ic_`a' >= `ic_p50' if !mi(ic_`a')
125.         gen byte lo_`a'  = ic_`a' <  `ic_p50' if !mi(ic_`a')
126.         gen byte q1_`a'  = ic_`a' <= `ic_p25' if !mi(ic_`a')
127.         gen byte q4_`a'  = ic_`a' >= `ic_p75' if !mi(ic_`a')
128.         gen byte mid_`a' = (ic_`a' > `ic_p25' & ic_`a' < `ic_p75') if !mi(ic_`a')
129.         qui sum ic_`a' if athr_indicator == 1, d
130.         local ic_p25w = r(p25)
131.         local ic_p50w = r(p50)
132.         local ic_p75w = r(p75)
133.         di as text "add_het_splits `samp'`suf' ic_`a' pi-wtd N_pi=" r(N) " p25=`ic_p25w' p50=`ic_p50w' p75=`ic_p75w'"
134.         gen byte hiw_`a'  = ic_`a' >= `ic_p50w' if !mi(ic_`a')
135.         gen byte low_`a'  = ic_`a' <  `ic_p50w' if !mi(ic_`a')
136.         gen byte q1w_`a'  = ic_`a' <= `ic_p25w' if !mi(ic_`a')
137.         gen byte q4w_`a'  = ic_`a' >= `ic_p75w' if !mi(ic_`a')
138.         gen byte midw_`a' = (ic_`a' > `ic_p25w' & ic_`a' < `ic_p75w') if !mi(ic_`a')
139.     }
140. 
.     local pi_q_source pre_ppr_cnt_sum pre_nihg pre_nihd
141.     local pi_q_alias  pre_ppr        nihg     nihd
142.     local nq : word count `pi_q_alias'
143.     forvalues i = 1/`nq' {
144.         local src : word `i' of `pi_q_source'
145.         local alias : word `i' of `pi_q_alias'
146.         cap confirm variable `src'
147.         if _rc {
148.             di as error "add_het_splits `samp'`suf': `src' unavailable -- `alias' quartiles SKIPPED."
149.             continue
150.         }
151.         qui sum `src' if athr_indicator == 1, d
152.         local p25 = r(p25)
153.         local p75 = r(p75)
154.         di as text "add_het_splits `samp'`suf' `alias' p25=`p25' p75=`p75'"
155.         gen byte q1_`alias'  = `src' <= `p25' if !mi(`src')
156.         gen byte q4_`alias'  = `src' >= `p75' if !mi(`src')
157.         gen byte mid_`alias' = (`src' > `p25' & `src' < `p75') if !mi(`src')
158.     }
159. 
.     foreach a of global IC_ALIASES {
160.         cap confirm variable hiw_`a'
161.         if _rc continue
162.         gen byte y_hi_`a' = (young == 1 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
163.         gen byte y_lo_`a' = (young == 1 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
164.         gen byte o_hi_`a' = (young == 0 & hiw_`a' == 1) if !mi(young) & !mi(hiw_`a')
165.         gen byte o_lo_`a' = (young == 0 & hiw_`a' == 0) if !mi(young) & !mi(hiw_`a')
166.     }
167. 
.     cap confirm variable min_year
168.     if !_rc {
169.         gen lab_age_2014 = 2014 - min_year
170.         qui sum lab_age_2014 if athr_indicator == 1, d
171.         local lab_med = r(p50)
172.         di as text "add_het_splits `samp'`suf' lab_age median = `lab_med'"
173.         gen byte new_lab = lab_age_2014 <  `lab_med' if !mi(lab_age_2014)
174.         gen byte est_lab = lab_age_2014 >= `lab_med' if !mi(lab_age_2014)
175.         gen byte lab_lt10  = lab_age_2014 < 10             if !mi(lab_age_2014)
176.         gen byte lab_10_20 = inrange(lab_age_2014, 10, 19) if !mi(lab_age_2014)
177.         gen byte lab_20p   = lab_age_2014 >= 20            if !mi(lab_age_2014)
178.         qui sum lab_age_2014 if athr_indicator == 1, d
179.         di as text "add_het_splits `samp'`suf' lab_age quartile cuts: p25=" r(p25) " p50=" r(p50) " p75=" r(p75)
180.         xtile _labq_pi = lab_age_2014 if athr_indicator == 1, nq(4)
181.         bys athr_id: egen _labq = max(_labq_pi)
182.         forval q = 1/4 {
183.             gen byte q`q'_labage = _labq == `q' if !mi(_labq)
184.         }
185.         drop _labq_pi _labq
186.     }
187.     cap confirm variable msa_size_at
188.     if !_rc {
189.         qui sum msa_size_at if athr_indicator == 1, d
190.         local msa_med = r(p50)
191.         gen byte big_msa   = msa_size_at >= `msa_med' if !mi(msa_size_at)
192.         gen byte small_msa = msa_size_at <  `msa_med' if !mi(msa_size_at)
193.     }
194. 
.     compress
195.     save ../temp/es_`samp'`suf', replace
196. end

. 
. program event_study_het
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     use ../temp/es_`samp'`suf', clear
 18. 
.     gen rel = year - 2014
 19.     qui sum rel, d
 20.     local abs_lag = abs(r(max))
 21.     local abs_lead = abs(r(min))
 22.     forval i = 1/`abs_lead' {
 23.         gen int_lead`i'  = exposure      if rel == -`i'
 24.         gen mshr_lead`i' = mkt_spend_shr if rel == -`i'
 25.     }
 26.     forval i = 0/`abs_lag' {
 27.         gen int_lag`i'  = exposure      if rel == `i'
 28.         gen mshr_lag`i' = mkt_spend_shr if rel == `i'
 29.     }
 30.     ds int_lead* int_lag* mshr_lead* mshr_lag*
 31.     foreach var in `r(varlist)' {
 32.         replace `var' = 0 if mi(`var')
 33.     }
 34.     local int_leads
 35.     local mshr_leads
 36.     local int_lags
 37.     local mshr_lags
 38.     forval i = 2/`abs_lead' {
 39.         local int_leads int_lead`i' `int_leads'
 40.         local mshr_leads mshr_lead`i' `mshr_leads'
 41.     }
 42.     forval i = 0/`abs_lag' {
 43.         local int_lags `int_lags' int_lag`i'
 44.         local mshr_lags `mshr_lags' mshr_lag`i'
 45.     }
 46.     foreach v in ppr_cnt cite_affl_wt {
 47.         gen ln_`v' = ln(1+`v')
 48.     }
 49. 
.     local het_groups young old young_ns old_ns young_any old_any r1 r2 pub_inst priv_inst ///
>                      high_pre_ppr low_pre_ppr high_nihg low_nihg high_nihd low_nihd ///
>                      young_nih old_nih new_lab est_lab big_msa small_msa ///
>                      yhigh_nihd ylow_nihd yq4_nihd yq1_nihd ///
>                      lab_lt10 lab_10_20 lab_20p ///
>                      q1_labage q2_labage q3_labage q4_labage
 50.     foreach a of global IC_ALIASES {
 51.         local het_groups `het_groups' hiw_`a' low_`a'
 52.         if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' hi_`a' lo_`a'
 53.         if "$HET_RUN_QUARTILES" == "1" {
 54.             local het_groups `het_groups' q1w_`a' midw_`a' q4w_`a'
 55.             if "$HET_INCLUDE_INSTWTD" == "1" local het_groups `het_groups' q1_`a' mid_`a' q4_`a'
 56.         }
 57.     }
 58.     if "$HET_RUN_QUARTILES" == "1" {
 59.         foreach b of global PI_Q_BASES {
 60.             local het_groups `het_groups' q1_`b' mid_`b' q4_`b'
 61.         }
 62.     }
 63.     global HET_GROUPS_ACTIVE
 64.     foreach grp of local het_groups {
 65.         cap confirm variable `grp'
 66.         if _rc {
 67.             di as text "event_study_het `samp'`suf': dummy `grp' not built -- skipping."
 68.             continue
 69.         }
 70.         qui sum `grp'
 71.         if r(N) == 0 | r(min) == r(max) {
 72.             di as text "event_study_het `samp'`suf': dummy `grp' degenerate -- skipping."
 73.             continue
 74.         }
 75.         foreach v of local int_leads {
 76.             gen `v'_`grp' = `v' * `grp'
 77.         }
 78.         foreach v of local int_lags {
 79.             gen `v'_`grp' = `v' * `grp'
 80.         }
 81.         gen int_lead1_`grp' = int_lead1 * `grp'
 82.         foreach v of local mshr_leads {
 83.             gen `v'_`grp' = `v' * `grp'
 84.         }
 85.         foreach v of local mshr_lags {
 86.             gen `v'_`grp' = `v' * `grp'
 87.         }
 88.         local leads_`grp'
 89.         local lags_`grp'
 90.         local mleads_`grp'
 91.         local mlags_`grp'
 92.         foreach v of local int_leads {
 93.             local leads_`grp' `leads_`grp'' `v'_`grp'
 94.         }
 95.         foreach v of local int_lags {
 96.             local lags_`grp' `lags_`grp'' `v'_`grp'
 97.         }
 98.         foreach v of local mshr_leads {
 99.             local mleads_`grp' `mleads_`grp'' `v'_`grp'
100.         }
101.         foreach v of local mshr_lags {
102.             local mlags_`grp' `mlags_`grp'' `v'_`grp'
103.         }
104.         global HET_GROUPS_ACTIVE `"${HET_GROUPS_ACTIVE} `grp'"'
105.     }
106. 
.     if "$POSITION_OUTCOMES_AVAIL" == "" {
107.         cap confirm variable n_first_ppr
108.         global POSITION_OUTCOMES_AVAIL = cond(_rc == 0, 1, 0)
109.     }
110.     local position_outcomes ""
111.     if "$POSITION_OUTCOMES_AVAIL" == "1" {
112.         local position_outcomes n_middle_ppr avg_position avg_team_size_last avg_team_size_notlast
113.     }
114. 
.     cap drop post Z_it Z_share_it
115.     gen post       = year >= 2014
116.     gen Z_it       = exposure      * post
117.     gen Z_share_it = mkt_spend_shr * post
118. 
.     local pi_pairs `" "young old" "young_ns old_ns" "young_any old_any" "young_nih old_nih" "r1 r2" "pub_inst priv_inst" "high_pre_ppr low_pre_ppr" "high_nihg low_nihg" "high_nihd low_nihd" "new_lab est_lab" "big_msa small_msa" "yhigh_nihd ylow_nihd" "y
> q4_nihd yq1_nihd" "'
119.     global DUMMY_PAIRS_MED    `" `pi_pairs' ${IC_PAIRS_MED} "'
120.     global DUMMY_PAIRS_MED_PW `" `pi_pairs' ${IC_PAIRS_MED_PW} "'
121. 
.     local ppml_het_skip avg_position avg_team_size_last avg_team_size_notlast
122. 
.     mat drop _all
123.     local yvar_list ppr_cnt ppr_cnt_nonsolo cite_affl_wt avg_num_coathrs ///
>                     n_grants n_new_grants nih_total_cost ///
>                     `position_outcomes'
124.     if "$DEBUG_YVAR" != "" {
125.         local yvar_list $DEBUG_YVAR
126.         di as text "DEBUG_YVAR set -- restricting yvar loop to: $DEBUG_YVAR"
127.     }
128. 
.     foreach yvar of local yvar_list {
129.         tempname ph_handle
130.         postfile `ph_handle' str30 yvar str24 grp str12 spec str20 split_type ///
>             double(post_b post_se pre_b pre_se N r2_p) ///
>             using "../temp/phet_results_`samp'`suf'_`yvar'", replace
131.         local gap 0.5
132.         if regexm("`yvar'", "^cite_affl_wt") local gap 1
133.         local ppml_ytit "Output-Cost Elasticity"
134.         if "`yvar'" == "n_grants"       local ppml_ytit "{&Delta} Log Expected Active NIH Research Grants"
135.         if "`yvar'" == "n_new_grants"   local ppml_ytit "{&Delta} Log Expected New NIH Research Grants"
136.         if "`yvar'" == "nih_total_cost" local ppml_ytit "{&Delta} Log Expected NIH Award Dollars"
137. 
.         if "$HET_RUN_OLS" == "1" & inlist("`yvar'", "ppr_cnt", "cite_affl_wt") {
138.             foreach pair of global DUMMY_PAIRS_MED {
139.                 local g1: word 1 of `pair'
140.                 local g2: word 2 of `pair'
141.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
142.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
143.                 local g1_label = "${LBL_`g1'}"
144.                 if "`g1_label'" == "" local g1_label "`g1'"
145.                 local mshr_ctrls `mshr_leads' `mshr_lags' `mleads_`g1'' `mlags_`g1''
146.                 local plot_suf "_mshrctrl"
147.                 cap drop PT_`g1'
148.                 gen PT_`g1' = post * `g1'
149.                 cap noi reghdfe `yvar' `int_leads' `int_lags' ///
>                                `leads_`g1'' `lags_`g1'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
150.                 local rc = _rc
151.                 if `rc' {
152.                     di as error "event_study_het `samp'`suf' `yvar' `g1' failed (rc=`rc'); skipping."
153.                     continue
154.                 }
155.                 gunique athr_id if e(sample) & `g1' == 1
156.                 local num_athrs = r(unique)
157.                 gunique inst_id if e(sample) & `g1' == 1
158.                 local num_insts = r(unique)
159.                 sum `yvar' if rel <= -1 & e(sample) & `g1' == 1, d
160.                 local pre_mean : dis %4.3f r(mean)
161.                 preserve
162.                 cap mat drop es
163.                 foreach var in `leads_`g1'' `lags_`g1'' int_lead1_`g1' {
164.                     if "`var'" == "int_lead1_`g1'" {
165.                         mat row = 0,0
166.                     }
167.                     else {
168.                         mat row = _b[`var'], _se[`var']
169.                     }
170.                     mat es = nullmat(es) \ row
171.                 }
172.                 svmat es
173.                 keep es1 es2
174.                 drop if mi(es1)
175.                 rename (es1 es2) (b se)
176.                 gen ub = b + 1.96*se
177.                 sum ub, d
178.                 local ymax = round(r(max),`gap')
179.                 gen lb = b - 1.96*se
180.                 sum lb, d
181.                 local ymin = round(r(min),`gap')
182.                 if `ymin' > 0 local ymin = 0
183.                 gen rel = -`abs_lead' if _n == 1
184.                 replace rel = rel[_n-1]+1 if _n > 1
185.                 replace rel = rel + 1 if rel >= -1
186.                 replace rel = -1 if rel == `abs_lag' + 1
187.                 gen year = rel + 2014
188.                 hashsort rel
189.                 local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
190.                 local fdir ../output/figures/`samp'
191.                 foreach fmode of global FIG_MODES {
192.                     if "`fmode'" == "paper" {
193.                         local stats_leg legend(off)
194.                         local fdir ../output/figures/`samp'/paper
195.                         cap mkdir "`fdir'"
196.                     }
197.                     tw rcap ub lb year if year != 2013 , lcolor(ebblue%70) msize(vsmall) || ///
>                       scatter b year, mcolor(ebblue) || ///
>                     scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                       xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                       ytitle("Exposure x Post") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`gap')`ymax') ///
>                       `stats_leg' ///
>                       yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
198.                     graph export `fdir'/es_`yvar'`suf'_`g1'`plot_suf'.pdf, replace
199.                 }
200.                 save ../temp/es_`yvar'`suf'_`g1'`plot_suf', replace
201.                 restore
202.             }
203. 
.         }
204. 
.         if strpos(" `ppml_het_skip' ", " `yvar' ") == 0 {
205.             cap mkdir "../output/figures/`samp'/es_ppml"
206.             local mmethods pw
207.             if "$HET_INCLUDE_INSTWTD" == "1" local mmethods inst pw
208.             foreach mmethod of local mmethods {
209.             local pairs_current
210.             if "`mmethod'" == "inst" {
211.                 foreach pair of global DUMMY_PAIRS_MED {
212.                     local pairs_current `"`pairs_current' `"`pair'"' "'
213.                 }
214.                 local st_tag "med"
215.                 local mplot_suf "_ppml_mshrctrl"
216.             }
217.             else {
218.                 foreach pair of global DUMMY_PAIRS_MED_PW {
219.                     local pairs_current `"`pairs_current' `"`pair'"' "'
220.                 }
221.                 local st_tag "med_pi"
222.                 local mplot_suf "_ppml_medpi_mshrctrl"
223.             }
224.             foreach pair of local pairs_current {
225.                 local g1: word 1 of `pair'
226.                 local g2: word 2 of `pair'
227.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
228.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
229. 
.                 cap drop Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1'
230.                 gen Z_`g1' = Z_it       * `g1'
231.                 gen Z_`g2' = Z_it       * `g2'
232.                 gen S_`g1' = Z_share_it * `g1'
233.                 gen S_`g2' = Z_share_it * `g2'
234.                 gen PT_`g1' = post * `g1'
235.                 cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
236.                 local rc = _rc
237.                 if `rc' {
238.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' pooled-DiD int ppml failed (rc=`rc'); skipping pair."
239.                     continue
240.                 }
241.                 local Nppml = e(N)
242.                 local r2ppml = e(r2_p)
243.                 foreach grp in `g1' `g2' {
244.                     gunique athr_id if e(sample) & `grp' == 1
245.                     local num_athrs = r(unique)
246.                     gunique inst_id if e(sample) & `grp' == 1
247.                     local num_insts = r(unique)
248.                     local b_post  = _b[Z_`grp']
249.                     local se_post = _se[Z_`grp']
250.                     di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `st_tag': b=" %8.4f `b_post' ///
>                         " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
251.                     post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`st_tag'") ///
>                         (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
252.                 }
253. 
.                 cap noi lincom Z_`g1' - Z_`g2'
254.                 if !_rc {
255.                     local b_diff  = r(estimate)
256.                     local se_diff = r(se)
257.                     local p_diff  = r(p)
258.                     di as text "pooled-DiD int PPML DIFF `samp'`suf' `yvar' `g1'-`g2' `st_tag': b=" %8.4f `b_diff' ///
>                         " (se=" %8.4f `se_diff' ") p=" %6.4f `p_diff'
259.                     post `ph_handle' ("`yvar'") ("`g1'_diff") ("mshrctrl") ("`st_tag'_diff") ///
>                         (`b_diff') (`se_diff') (`p_diff') (.) (`Nppml') (`r2ppml')
260.                 }
261. 
.                 local mshr_ctrls `mleads_`g1'' `mlags_`g1'' `mleads_`g2'' `mlags_`g2''
262.                 local plot_suf "`mplot_suf'"
263.                 cap noi ppmlhdfe `yvar' `leads_`g1'' `lags_`g1'' `leads_`g2'' `lags_`g2'' ///
>                                `mshr_ctrls' PT_`g1', ///
>                                absorb(`fes') vce(cluster `vce_cl')
264.                 if _rc {
265.                     di as error "event_study_het `samp'`suf' `yvar' `g1'/`g2' `st_tag' joint ES for PDFs failed; skipping ES plots."
266.                     continue
267.                 }
268.                 foreach grp in `g1' `g2' {
269.                     local grp_label = "${LBL_`grp'}"
270.                     if "`grp_label'" == "" local grp_label "`grp'"
271.                     gunique athr_id if e(sample) & `grp' == 1
272.                     local num_athrs = r(unique)
273.                     gunique inst_id if e(sample) & `grp' == 1
274.                     local num_insts = r(unique)
275.                     sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
276.                     local pre_mean : dis %4.3f r(mean)
277.                     preserve
278.                     cap mat drop es
279.                     foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
280.                         if "`var'" == "int_lead1_`grp'" {
281.                             mat row = 0,0
282.                         }
283.                         else {
284.                             mat row = _b[`var'], _se[`var']
285.                         }
286.                         mat es = nullmat(es) \ row
287.                     }
288.                     svmat es
289.                     keep es1 es2
290.                     drop if mi(es1)
291.                     rename (es1 es2) (b se)
292.                     local pgap 0.2
293.                     gen ub = b + 1.96*se
294.                     gen lb = b - 1.96*se
295.                     local ymax = 1.2
296.                     local ymin = -2.2
297.                     gen rel = -`abs_lead' if _n == 1
298.                     replace rel = rel[_n-1]+1 if _n > 1
299.                     replace rel = rel + 1 if rel >= -1
300.                     replace rel = -1 if rel == `abs_lag' + 1
301.                     gen year = rel + 2014
302.                     hashsort rel
303.                     local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
304.                     local fdir ../output/figures/`samp'/es_ppml
305.                     foreach fmode of global FIG_MODES {
306.                         if "`fmode'" == "paper" {
307.                             local stats_leg legend(off)
308.                             local fdir ../output/figures/`samp'/es_ppml/paper
309.                             cap mkdir "`fdir'"
310.                         }
311.                         tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                           scatter b year, mcolor(ebblue) || ///
>                         scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                           xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                           ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                           `stats_leg' ///
>                           yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
312.                         graph export `fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
313.                     }
314.                     save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
315.                     restore
316.                 }
317.                 if "`g1'" == "young" & "`g2'" == "old" {
318.                     preserve
319.                     use ../temp/es_`yvar'`suf'_young`plot_suf', clear
320.                     gen grp = 1
321.                     append using ../temp/es_`yvar'`suf'_old`plot_suf'
322.                     replace grp = 2 if mi(grp)
323.                     replace year = year - 0.1 if grp == 1
324.                     replace year = year + 0.1 if grp == 2
325.                     local ymax = 1.2
326.                     local ymin = -2.2
327.                     local pgap 0.2
328.                     local fdir ../output/figures/`samp'/es_ppml
329.                     foreach fmode of global FIG_MODES {
330.                         if "`fmode'" == "paper" {
331.                             local fdir ../output/figures/`samp'/es_ppml/paper
332.                             cap mkdir "`fdir'"
333.                         }
334.                         foreach hide in 0 1 {
335.                             local ocol dkorange
336.                             local ocol_ci dkorange%70
337.                             local olbl "${LBL_old}"
338.                             local fsuf young_old
339.                             if `hide' {
340.                                 local ocol none
341.                                 local ocol_ci none
342.                                 local olbl " "
343.                                 local fsuf young_old_hideold
344.                             }
345.                             tw rcap ub lb year if rel != -1 & grp == 1, lcolor(ebblue%70) msize(vsmall) || ///
>                               scatter b year if grp == 1, mcolor(ebblue) || ///
>                               rcap ub lb year if rel != -1 & grp == 2, lcolor(`ocol_ci') msize(vsmall) || ///
>                               scatter b year if grp == 2, mcolor(`ocol') || ///
>                             scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                               xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                               ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                               legend(on order(2 "${LBL_young}" 4 "`olbl'") pos(6) ring(1) rows(1) size(small)) ///
>                               yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
346.                             graph export `fdir'/es_`yvar'`suf'_`fsuf'`plot_suf'.pdf, replace
347.                         }
348.                     }
349.                     restore
350.                 }
351.             }
352.             }
353. 
.             foreach aspec in age3 ageq4 {
354.                 if "`aspec'" == "age3"  local agrps lab_lt10 lab_10_20 lab_20p
355.                 if "`aspec'" == "ageq4" local agrps q1_labage q2_labage q3_labage q4_labage
356.                 local aok 1
357.                 foreach grp of local agrps {
358.                     if strpos(" ${HET_GROUPS_ACTIVE} ", " `grp' ") == 0 local aok 0
359.                 }
360.                 if `aok' {
361.                 local nb : word count `agrps'
362.                 local abase : word `nb' of `agrps'
363.                 local Zs
364.                 local Ss
365.                 local PTs
366.                 foreach grp of local agrps {
367.                     cap drop Z_`grp'
368.                     cap drop S_`grp'
369.                     cap drop PT_`grp'
370.                     gen Z_`grp' = Z_it       * `grp'
371.                     gen S_`grp' = Z_share_it * `grp'
372.                     local Zs `Zs' Z_`grp'
373.                     local Ss `Ss' S_`grp'
374.                     if "`grp'" != "`abase'" {
375.                         gen PT_`grp' = post * `grp'
376.                         local PTs `PTs' PT_`grp'
377.                     }
378.                 }
379.                 cap noi ppmlhdfe `yvar' `Zs' `Ss' `PTs', ///
>                                absorb(`fes') vce(cluster `vce_cl')
380.                 local rc = _rc
381.                 if `rc' {
382.                     di as error "event_study_het `samp'`suf' `yvar' `aspec' pooled-DiD int ppml failed (rc=`rc'); skipping."
383.                 }
384.                 else {
385.                     local Nppml = e(N)
386.                     local r2ppml = e(r2_p)
387.                     foreach grp of local agrps {
388.                         gunique athr_id if e(sample) & `grp' == 1
389.                         local num_athrs = r(unique)
390.                         gunique inst_id if e(sample) & `grp' == 1
391.                         local num_insts = r(unique)
392.                         local b_post  = _b[Z_`grp']
393.                         local se_post = _se[Z_`grp']
394.                         di as text "pooled-DiD int PPML `samp'`suf' `yvar' `grp' `aspec': b=" %8.4f `b_post' ///
>                             " (se=" %8.4f `se_post' ")   N=" %9.0f `Nppml' " PIs=`num_athrs' Insts=`num_insts'"
395.                         post `ph_handle' ("`yvar'") ("`grp'") ("mshrctrl") ("`aspec'") ///
>                             (`b_post') (`se_post') (.) (.) (`Nppml') (`r2ppml')
396.                     }
397. 
.                     local all_leads
398.                     local all_lags
399.                     local all_mshr
400.                     foreach grp of local agrps {
401.                         local all_leads `all_leads' `leads_`grp''
402.                         local all_lags  `all_lags'  `lags_`grp''
403.                         local all_mshr  `all_mshr'  `mleads_`grp'' `mlags_`grp''
404.                     }
405.                     local plot_suf "_ppml_`aspec'_mshrctrl"
406.                     cap noi ppmlhdfe `yvar' `all_leads' `all_lags' ///
>                                             `all_mshr' `PTs', ///
>                                             absorb(`fes') vce(cluster `vce_cl')
407.                     if _rc {
408.                         di as error "event_study_het `samp'`suf' `yvar' `aspec' joint ES for PDFs failed; skipping ES plots."
409.                     }
410.                     else {
411.                         foreach grp of local agrps {
412.                             local grp_label = "${LBL_`grp'}"
413.                             if "`grp_label'" == "" local grp_label "`grp'"
414.                             gunique athr_id if e(sample) & `grp' == 1
415.                             local num_athrs = r(unique)
416.                             gunique inst_id if e(sample) & `grp' == 1
417.                             local num_insts = r(unique)
418.                             sum `yvar' if rel <= -1 & e(sample) & `grp' == 1, d
419.                             local pre_mean : dis %4.3f r(mean)
420.                             preserve
421.                             cap mat drop es
422.                             foreach var in `leads_`grp'' `lags_`grp'' int_lead1_`grp' {
423.                                 if "`var'" == "int_lead1_`grp'" {
424.                                     mat row = 0,0
425.                                 }
426.                                 else {
427.                                     mat row = _b[`var'], _se[`var']
428.                                 }
429.                                 mat es = nullmat(es) \ row
430.                             }
431.                             svmat es
432.                             keep es1 es2
433.                             drop if mi(es1)
434.                             rename (es1 es2) (b se)
435.                             gen ub = b + 1.96*se
436.                             gen lb = b - 1.96*se
437.                             local ymax = 1.2
438.                             local ymin = -2.2
439.                             local pgap 0.2
440.                             gen rel = -`abs_lead' if _n == 1
441.                             replace rel = rel[_n-1]+1 if _n > 1
442.                             replace rel = rel + 1 if rel >= -1
443.                             replace rel = -1 if rel == `abs_lag' + 1
444.                             gen year = rel + 2014
445.                             hashsort rel
446.                             local stats_leg `"legend(on order(- "Num. PIs: `num_athrs'" "Num. Insts: `num_insts'" "Pre-Period Avg : `pre_mean'") pos(7) ring(1) rows(3) bmargin(zero) size(small))"'
447.                             local fdir ../output/figures/`samp'/es_ppml
448.                             foreach fmode of global FIG_MODES {
449.                                 if "`fmode'" == "paper" {
450.                                     local stats_leg legend(off)
451.                                     local fdir ../output/figures/`samp'/es_ppml/paper
452.                                     cap mkdir "`fdir'"
453.                                 }
454.                                 tw rcap ub lb year if year != 2013, lcolor(ebblue%70) msize(vsmall) || ///
>                                   scatter b year, mcolor(ebblue) || ///
>                                 scatteri `ymax' 2013.75 `ymax' 2014.25 , bcolor(gs12%30) recast(area) base(`ymin') ///
>                                   xlab(2010(1)2019, labsize(small)) xtitle("Year") ///
>                                   ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ylab(`ymin'(`pgap')`ymax') ytick(`ymin'(0.2)`ymax') ///
>                                   `stats_leg' ///
>                                   yline(0, lcolor(gs10) lpattern(solid)) plotregion(margin(sides))
455.                                 graph export `fdir'/es_`yvar'`suf'_`grp'`plot_suf'.pdf, replace
456.                             }
457.                             save ../temp/es_`yvar'`suf'_`grp'`plot_suf', replace
458.                             restore
459.                         }
460.                     }
461.                 }
462.                 }
463.             }
