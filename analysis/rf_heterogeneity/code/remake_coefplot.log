. program ppml_pdid_het_binscatter
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     if "`yvar'" == "" local yvar ppr_cnt
  3.     local fes athr_id year
  4.     local vce_cl athr_id
  5.     if "$FE_MODE" == "inst_cluster" {
  6.         local fes inst_id cluster_30 year
  7.         local vce_cl inst_id
  8.     }
  9.     if "$FE_MODE" == "inst_cluster_fldyr" {
 10.         local fes inst_id i.cluster_30#i.year
 11.         local vce_cl inst_id
 12.     }
 13.     local suf ""
 14.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 15.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 16.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 17.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 18.     cap mkdir "../output/figures/`samp'/ppml_pdid_het_bs"
 19. 
.     local bs_lbl "`yvar'"
 20.     if "`yvar'" == "ppr_cnt"           local bs_lbl "Publications"
 21.     if "`yvar'" == "cite_affl_wt"      local bs_lbl "Citation-Weighted Output"
 22.     if "`yvar'" == "avg_num_coathrs"   local bs_lbl "Coauthors"
 23.     if "`yvar'" == "n_grants"          local bs_lbl "Active NIH Research Grants"
 24.     if "`yvar'" == "n_new_grants"      local bs_lbl "New NIH Research Grants"
 25.     if "`yvar'" == "nih_total_cost"    local bs_lbl "NIH Award Dollars"
 26.     if "`yvar'" == "n_middle_ppr"      local bs_lbl "Middle-Author Papers"
 27.     if "`yvar'" == "ppr_cnt_nonsolo"   local bs_lbl "Publications (Excl. Solo)"
 28. 
.     local dummy_pairs `" "young old" "young_ns old_ns" "young_any old_any" "young_nih old_nih" "r1 r2" "pub_inst priv_inst" "high_pre_ppr low_pre_ppr" "high_nihg low_nihg" "high_nihd low_nihd" "new_lab est_lab" "big_msa small_msa" "yhigh_nihd ylow_nihd"
>  "yq4_nihd yq1_nihd" ${IC_PAIRS_MED_PW} "'
 29.     if "$HET_INCLUDE_INSTWTD" == "1" local dummy_pairs `" `dummy_pairs' ${IC_PAIRS_MED} "'
 30. 
.     preserve
 31.         use ../temp/es_`samp'`suf', clear
 32.         gen post       = year >= 2014
 33.         gen Z_it       = exposure      * post
 34.         gen Z_share_it = mkt_spend_shr * post
 35. 
.         foreach pair of local dummy_pairs {
 36.             local g1 : word 1 of `pair'
 37.             local g2 : word 2 of `pair'
 38. 
.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g1' ") == 0 continue
 39.             if strpos(" ${HET_GROUPS_ACTIVE} ", " `g2' ") == 0 continue
 40. 
.             foreach v in Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1' _mu _z_work _dvar _fwlw _y_r _Z_r {
 41.                 cap drop `v'
 42.             }
 43.             gen Z_`g1' = Z_it       * `g1'
 44.             gen Z_`g2' = Z_it       * `g2'
 45.             gen S_`g1' = Z_share_it * `g1'
 46.             gen S_`g2' = Z_share_it * `g2'
 47.             gen PT_`g1' = post * `g1'
 48. 
.             cap noi ppmlhdfe `yvar' Z_`g1' Z_`g2' S_`g1' S_`g2' PT_`g1', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
 49.             local rc = _rc
 50.             if `rc' {
 51.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `g1'/`g2' joint failed (rc=`rc'); skipping pair."
 52.                 continue
 53.             }
 54.             local b_`g1'  = _b[Z_`g1']
 55.             local se_`g1' = _se[Z_`g1']
 56.             local b_`g2'  = _b[Z_`g2']
 57.             local se_`g2' = _se[Z_`g2']
 58. 
.             predict double _mu, mu
 59.             gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
 60.             gen double _fwlw = _mu if !mi(_mu) & _mu > 0
 61. 
.             foreach grp in `g1' `g2' {
 62.                 local other = cond("`grp'" == "`g1'", "`g2'", "`g1'")
 63. 
.                 foreach v in _y_r _Z_r {
 64.                     cap drop `v'
 65.                 }
 66.                 cap noi qui reghdfe _z_work Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_y_r)
 67.                 if _rc == 0 cap noi qui reghdfe Z_`grp' Z_`other' S_`g1' S_`g2' PT_`g1' if !mi(_fwlw) [pw=_fwlw], ///
>                         absorb(`fes') residuals(_Z_r)
 68.                 if _rc {
 69.                     di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
 70.                     continue
 71.                 }
 72.                 gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 73.                 local n_pis = r(unique)
 74.                 gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
 75.                 local n_insts = r(unique)
 76.                 local b_str  : dis %7.3f `b_`grp''
 77.                 local se_str : dis %7.3f `se_`grp''
 78.                 local bs_note `"note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
 79.                 local fdir ../output/figures/`samp'/ppml_pdid_het_bs
 80.                 foreach fmode of global FIG_MODES {
 81.                     if "`fmode'" == "paper" {
 82.                         local bs_note `"note("{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
 83.                         local fdir ../output/figures/`samp'/ppml_pdid_het_bs/paper
 84.                         cap mkdir "`fdir'"
 85.                     }
 86.                     binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                         xtitle("Exposure x Post") ///
>                         ytitle("{&Delta} Log Expected `bs_lbl'") ysc(titlegap(0) outergap(0)) ///
>                         xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                         msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                         `bs_note' ///
>                         plotregion(margin(sides))
 87.                     graph export ///
>                         `fdir'/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf, ///
>                         replace
 88.                 }
 89.             }
 90.         }
 91. 
.         foreach aspec in age3 ageq4 {
 92.             if "`aspec'" == "age3"  local agrps lab_lt10 lab_10_20 lab_20p
 93.             if "`aspec'" == "ageq4" local agrps q1_labage q2_labage q3_labage q4_labage
 94.             local aok 1
 95.             foreach grp of local agrps {
 96.                 if strpos(" ${HET_GROUPS_ACTIVE} ", " `grp' ") == 0 local aok 0
 97.             }
 98.             if `aok' {
 99.             foreach v in _mu _z_work _dvar _fwlw _y_r _Z_r {
100.                 cap drop `v'
101.             }
102.             local nb : word count `agrps'
103.             local abase : word `nb' of `agrps'
104.             local Zs
105.             local Ss
106.             local PTs
107.             foreach grp of local agrps {
108.                 cap drop Z_`grp'
109.                 cap drop S_`grp'
110.                 cap drop PT_`grp'
111.                 gen Z_`grp' = Z_it       * `grp'
112.                 gen S_`grp' = Z_share_it * `grp'
113.                 local Zs `Zs' Z_`grp'
114.                 local Ss `Ss' S_`grp'
115.                 if "`grp'" != "`abase'" {
116.                     gen PT_`grp' = post * `grp'
117.                     local PTs `PTs' PT_`grp'
118.                 }
119.             }
120. 
.             cap noi ppmlhdfe `yvar' `Zs' `Ss' `PTs', ///
>                     absorb(`fes') vce(cluster `vce_cl') d(_dvar)
121.             local rc = _rc
122.             if `rc' {
123.                 di as error "ppml_pdid_het_bs `samp'`suf' `yvar' `aspec' joint failed (rc=`rc'); skipping."
124.             }
125.             else {
126.                 foreach grp of local agrps {
127.                     local b_`grp'  = _b[Z_`grp']
128.                     local se_`grp' = _se[Z_`grp']
129.                 }
130. 
.                 predict double _mu, mu
131.                 gen double _z_work = ln(_mu) + (`yvar' - _mu)/_mu if !mi(_mu) & _mu > 0
132.                 gen double _fwlw = _mu if !mi(_mu) & _mu > 0
133. 
.                 foreach grp of local agrps {
134.                     local others
135.                     foreach o of local agrps {
136.                         if "`o'" != "`grp'" local others `others' Z_`o'
137.                     }
138.                     foreach v in _y_r _Z_r {
139.                         cap drop `v'
140.                     }
141.                     cap noi qui reghdfe _z_work `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_y_r)
142.                     if _rc == 0 cap noi qui reghdfe Z_`grp' `others' `Ss' `PTs' if !mi(_fwlw) [pw=_fwlw], ///
>                             absorb(`fes') residuals(_Z_r)
143.                     if _rc {
144.                         di as error "ppml_pdid_het_bs FWL `grp' failed; skipping plot."
145.                         continue
146.                     }
147.                     gunique athr_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
148.                     local n_pis = r(unique)
149.                     gunique inst_id if `grp' == 1 & !mi(_y_r) & !mi(_Z_r)
150.                     local n_insts = r(unique)
151.                     local b_str  : dis %7.3f `b_`grp''
152.                     local se_str : dis %7.3f `se_`grp''
153.                     local bs_note `"note("Num. PIs: `n_pis'   Num. Insts: `n_insts'" "{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
154.                     local fdir ../output/figures/`samp'/ppml_pdid_het_bs
155.                     foreach fmode of global FIG_MODES {
156.                         if "`fmode'" == "paper" {
157.                             local bs_note `"note("{&beta} = `b_str' (SE: `se_str')", size(small) pos(7) ring(1) justification(left))"'
158.                             local fdir ../output/figures/`samp'/ppml_pdid_het_bs/paper
159.                             cap mkdir "`fdir'"
160.                         }
161.                         binscatter _y_r _Z_r [aw=_fwlw] if `grp' == 1 & !mi(_y_r) & !mi(_Z_r), n(30) ///
>                             xtitle("Exposure x Post") ///
>                             ytitle("{&Delta} Log Expected `bs_lbl'") ysc(titlegap(0) outergap(0)) ///
>                             xlab(-0.06(0.015)0.06, format(%5.3f)) ///
>                             msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>                             `bs_note' ///
>                             plotregion(margin(sides))
162.                         graph export ///
>                             `fdir'/ppml_pdid_`yvar'_`grp'_mshrctrl`suf'.pdf, ///
>                             replace
163.                     }
164.                 }
165.             }
166.             }
167.         }
168.     restore
169. end

. 
. program ppml_age_gradient
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17.     cap mkdir "../output/figures/`samp'"
 18. 
.     local yvar_list ppr_cnt cite_affl_wt
 19.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 20.     local ppml_skip avg_position avg_team_size_last avg_team_size_notlast
 21. 
.     use ../temp/es_`samp'`suf', clear
 22.     gen post       = year >= 2014
 23.     gen Z_it       = exposure      * post
 24.     gen Z_share_it = mkt_spend_shr * post
 25. 
.     local K = $HET_AGE_NBINS
 26.     foreach agevar in age_2014 lab_age_2014 lab_age_ns_2014 {
 27.     cap confirm variable `agevar'
 28.     if _rc {
 29.         di as error "ppml_age_gradient `samp'`suf': `agevar' not in panel -- skipped."
 30.         continue
 31.     }
 32.     local gpfx agegrad
 33.     local gtmp age_gradient
 34.     local gxtit "Career Age in 2014"
 35.     if "`agevar'" == "lab_age_2014" {
 36.         local gpfx labgrad
 37.         local gtmp lab_gradient
 38.         local gxtit "Years Running Lab in 2014"
 39.     }
 40.     if "`agevar'" == "lab_age_ns_2014" {
 41.         local gpfx labnsgrad
 42.         local gtmp lab_ns_gradient
 43.         local gxtit "Years Running Lab in 2014 (Excl. Solo Papers)"
 44.     }
 45.     cap drop agebin
 46.     xtile _agebin_pi = `agevar' if athr_indicator == 1, n(`K')
 47.     bys athr_id: egen agebin = max(_agebin_pi)
 48.     drop _agebin_pi
 49. 
.     local zvars
 50.     local svars
 51.     local bins_used
 52.     forval k = 1/`K' {
 53.         qui count if agebin == `k' & athr_indicator == 1
 54.         if r(N) == 0 {
 55.             di as error "ppml_age_gradient `samp'`suf': age bin `k' empty -- skipped."
 56.             continue
 57.         }
 58.         cap drop Z_a`k'
 59.         cap drop S_a`k'
 60.         gen Z_a`k' = Z_it       * (agebin == `k')
 61.         gen S_a`k' = Z_share_it * (agebin == `k')
 62.         local zvars `zvars' Z_a`k'
 63.         local svars `svars' S_a`k'
 64.         local bins_used `bins_used' `k'
 65.     }
 66.     local ptvars
 67.     local nb : word count `bins_used'
 68.     forval i = 1/`=`nb'-1' {
 69.         local k : word `i' of `bins_used'
 70.         cap drop PT_a`k'
 71.         gen PT_a`k' = post * (agebin == `k')
 72.         local ptvars `ptvars' PT_a`k'
 73.     }
 74. 
.     foreach yvar of local yvar_list {
 75.         if strpos(" `ppml_skip' ", " `yvar' ") > 0 {
 76.             di as text "ppml_age_gradient: `yvar' not a count outcome -- skipped."
 77.             continue
 78.         }
 79.         local ppml_ytit "Output-Cost Elasticity"
 80.         if "`yvar'" == "n_grants"       local ppml_ytit "{&Delta} Log Expected Active NIH Research Grants"
 81.         if "`yvar'" == "n_new_grants"   local ppml_ytit "{&Delta} Log Expected New NIH Research Grants"
 82.         if "`yvar'" == "nih_total_cost" local ppml_ytit "{&Delta} Log Expected NIH Award Dollars"
 83. 
.         cap noi ppmlhdfe `yvar' `zvars' `svars' `ptvars' if !mi(agebin), ///
>             absorb(`fes') vce(cluster `vce_cl')
 84.         local rc = _rc
 85.         if `rc' {
 86.             di as error "ppml_age_gradient `samp'`suf' `yvar' failed (rc=`rc'); skipping."
 87.             continue
 88.         }
 89.         gunique athr_id if e(sample)
 90.         local n_pis = r(unique)
 91.         gunique inst_id if e(sample)
 92.         local n_insts = r(unique)
 93.         cap mat drop AG
 94.         foreach k of local bins_used {
 95.             if _se[Z_a`k'] == 0 {
 96.                 di as error "ppml_age_gradient `samp'`suf' `yvar': Z_a`k' dropped/degenerate -- omitted from plot."
 97.                 continue
 98.             }
 99.             qui sum `agevar' if athr_indicator == 1 & agebin == `k'
100.             mat AG = nullmat(AG) \ (`k', r(mean), r(N), _b[Z_a`k'], _se[Z_a`k'])
101.         }
102.         preserve
103.         clear
104.         svmat AG
105.         rename (AG1 AG2 AG3 AG4 AG5) (bin age_mean n_pis b se)
106.         gen ub = b + 1.96*se
107.         gen lb = b - 1.96*se
108.         save ../temp/`gtmp'_`samp'`suf'_`yvar', replace
109.         local stats_leg `"legend(on order(- "Num. PIs: `n_pis'" "Num. Insts: `n_insts'") pos(7) ring(1) rows(2) bmargin(zero) size(small))"'
110.         local fdir ../output/figures/`samp'
111.         foreach fmode of global FIG_MODES {
112.             if "`fmode'" == "paper" {
113.                 local stats_leg legend(off)
114.                 local fdir ../output/figures/`samp'/paper
115.                 cap mkdir "`fdir'"
116.             }
117.             tw rcap ub lb age_mean, lcolor(ebblue%70) msize(vsmall) || ///
>                scatter b age_mean, mcolor(ebblue) || ///
>                lfit b age_mean [aw=1/(se*se)], lcolor(dkorange) lpattern(dash) ///
>                xtitle("`gxtit'") ytitle("`ppml_ytit'") ysc(titlegap(-6) outergap(0)) ///
>                yline(0, lcolor(gs10) lpattern(solid)) ///
>                `stats_leg' ///
>                plotregion(margin(sides))
118.             graph export `fdir'/`gpfx'_`yvar'`suf'_ppml_mshrctrl.pdf, replace
119.         }
120.         restore
121.     }
122.     }
123. end

. 
. program desc_exposure_by_age
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir "../output/figures/`samp'"
  8. 
.     use ../temp/es_`samp'`suf', clear
  9.     cap confirm variable nih_pi
 10.     if _rc gen byte nih_pi = .
 11.     egen long inst_num = group(inst_id)
 12.     gcollapse (firstnm) exposure young nih_pi inst_num, by(athr_id)
 13.     drop if mi(young) | mi(exposure)
 14. 
.     local tag_all ""
 15.     local tag_nih "_nih"
 16.     local cond_all "1"
 17.     local cond_nih "nih_pi == 1"
 18.     foreach s in all nih {
 19.         qui count if `cond_`s'' & young == 1
 20.         local n_y = r(N)
 21.         qui count if `cond_`s'' & young == 0
 22.         local n_o = r(N)
 23.         if `n_y' == 0 | `n_o' == 0 {
 24.             di as error "desc_exposure_by_age `samp'`suf' [`s']: empty group -- SKIPPED."
 25.             continue
 26.         }
 27.         qui sum exposure if `cond_`s'' & young == 1, d
 28.         local mu_y = strtrim(string(r(mean), "%6.3f"))
 29.         local md_y = strtrim(string(r(p50),  "%6.3f"))
 30.         qui sum exposure if `cond_`s'' & young == 0, d
 31.         local mu_o = strtrim(string(r(mean), "%6.3f"))
 32.         local md_o = strtrim(string(r(p50),  "%6.3f"))
 33.         di as text _n "desc_exposure_by_age `samp'`suf' [`s']: N young = `n_y' (mean=`mu_y' p50=`md_y'), N old = `n_o' (mean=`mu_o' p50=`md_o')"
 34.         cap noi ksmirnov exposure if `cond_`s'', by(young)
 35.         qui reg exposure young if `cond_`s'', vce(cluster inst_num)
 36.         di as text "  young-old diff = " %8.4f _b[young] " (se " %8.4f _se[young] ")"
 37. 
.         qui sum exposure if `cond_`s'', d
 38.         local xcap = r(p99)
 39.         cap drop _kx _kd_y _kd_o _kd_c
 40.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 41.         kdensity exposure if `cond_`s'' & young == 1 & exposure <= `xcap', at(_kx) gen(_kd_y) nograph
 42.         kdensity exposure if `cond_`s'' & young == 0 & exposure <= `xcap', at(_kx) gen(_kd_o) nograph
 43.         gen _kd_c = min(_kd_y, _kd_o)
 44.         local leg_y "Early-Career (N=`n_y'): mean=`mu_y'"
 45.         local leg_o "Late-Career (N=`n_o'): mean=`mu_o'"
 46.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 47.         local fdir ../output/figures/`samp'
 48.         foreach fmode of global FIG_MODES {
 49.             if "`fmode'" == "paper" {
 50.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
 51.                 local fdir ../output/figures/`samp'/paper
 52.                 cap mkdir "`fdir'"
 53.             }
 54.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("Exposure Measure") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
 55.             graph export `fdir'/desc_kd_exposure`tag_`s''`suf'.pdf, replace
 56.         }
 57.         cap drop _kx _kd_y _kd_o _kd_c
 58.     }
 59. end

. 
. program desc_pre_output_by_age
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir "../output/figures/`samp'"
  8. 
.     use ../temp/es_`samp'`suf', clear
  9.     keep if year < 2014
 10.     qui sum year
 11.     local y0 = r(min)
 12.     local y1 = r(max)
 13. 
.     local sum_src   ppr_cnt cite_affl_wt n_first_ppr n_last_ppr
 14.     local sum_alias ppr_tot cite         first       last
 15.     local mean_src   ppr_cnt
 16.     local mean_alias ppr_yr
 17.     local lbl_ppr_tot "Total Papers"
 18.     local lbl_ppr_yr  "Papers per Year"
 19.     local lbl_cite    "Affiliation-Weighted Citations"
 20.     local lbl_first   "First-Authored Papers"
 21.     local lbl_last    "Last-Authored Papers"
 22.     local fmt_ppr_tot %6.1f
 23.     local fmt_ppr_yr  %5.2f
 24.     local fmt_cite    %8.1f
 25.     local fmt_first   %6.1f
 26.     local fmt_last    %6.1f
 27. 
.     local coll_sum
 28.     local coll_mean
 29.     local keep_alias
 30.     foreach stat in sum mean {
 31.         local nsrc : word count ``stat'_src'
 32.         forvalues i = 1/`nsrc' {
 33.             local src : word `i' of ``stat'_src'
 34.             local a   : word `i' of ``stat'_alias'
 35.             cap confirm variable `src'
 36.             if _rc {
 37.                 di as error "desc_pre_output_by_age `samp'`suf': `src' not in panel -- `a' density SKIPPED."
 38.                 continue
 39.             }
 40.             local coll_`stat' `coll_`stat'' pre_`a'=`src'
 41.             local keep_alias `keep_alias' `a'
 42.         }
 43.     }
 44.     if "`keep_alias'" == "" {
 45.         di as error "desc_pre_output_by_age `samp'`suf': no outcomes available -- nothing plotted."
 46.         exit
 47.     }
 48.     local coll_sum_part = cond("`coll_sum'" == "", "", "(sum) `coll_sum'")
 49.     local coll_mean_part = cond("`coll_mean'" == "", "", "(mean) `coll_mean'")
 50. 
.     egen long inst_num = group(inst_id)
 51.     gcollapse `coll_sum_part' `coll_mean_part' (firstnm) young inst_num, by(athr_id)
 52.     drop if mi(young)
 53. 
.     qui count if young == 1
 54.     local n_y = r(N)
 55.     qui count if young == 0
 56.     local n_o = r(N)
 57.     di as text _n "desc_pre_output_by_age `samp'`suf': pre-period = `y0'-`y1', N young = `n_y', N old = `n_o'"
 58. 
.     foreach a of local keep_alias {
 59.         local f "`fmt_`a''"
 60.         qui sum pre_`a' if young == 1, d
 61.         local mu_y = strtrim(string(r(mean), "`f'"))
 62.         local md_y = strtrim(string(r(p50),  "`f'"))
 63.         qui sum pre_`a' if young == 0, d
 64.         local mu_o = strtrim(string(r(mean), "`f'"))
 65.         local md_o = strtrim(string(r(p50),  "`f'"))
 66.         local leg_y "Early-Career (N=`n_y'): mean=`mu_y'"
 67.         local leg_o "Late-Career (N=`n_o'): mean=`mu_o'"
 68.         di as text "  `a': young mean=`mu_y' p50=`md_y' | old mean=`mu_o' p50=`md_o'"
 69.         cap noi ksmirnov pre_`a', by(young)
 70.         qui reg pre_`a' young, vce(cluster inst_num)
 71.         di as text "  `a': young-old diff = " %8.3f _b[young] " (se " %8.3f _se[young] ")"
 72. 
.         gen double ln_pre_`a' = ln(1 + pre_`a')
 73.         qui sum ln_pre_`a'
 74.         cap drop _kx _kd_y _kd_o _kd_c
 75.         gen _kx = r(min) + (r(max) - r(min)) * (_n - 1) / 199 if _n <= 200
 76.         kdensity ln_pre_`a' if young == 1, at(_kx) gen(_kd_y) nograph
 77.         kdensity ln_pre_`a' if young == 0, at(_kx) gen(_kd_o) nograph
 78.         gen _kd_c = min(_kd_y, _kd_o)
 79.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 80.         local fdir ../output/figures/`samp'
 81.         foreach fmode of global FIG_MODES {
 82.             if "`fmode'" == "paper" {
 83.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
 84.                 local fdir ../output/figures/`samp'/paper
 85.                 cap mkdir "`fdir'"
 86.             }
 87.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("ln(1 + Pre-Period `lbl_`a'', `y0'-`y1')") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
 88.             graph export `fdir'/desc_kd_pre_`a'_ln`suf'.pdf, replace
 89.         }
 90. 
.         qui sum pre_`a', d
 91.         local xcap = r(p95)
 92.         cap drop _kx _kd_y _kd_o _kd_c
 93.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 94.         kdensity pre_`a' if young == 1 & pre_`a' <= `xcap', at(_kx) gen(_kd_y) nograph
 95.         kdensity pre_`a' if young == 0 & pre_`a' <= `xcap', at(_kx) gen(_kd_o) nograph
 96.         gen _kd_c = min(_kd_y, _kd_o)
 97.         local kd_leg `"legend(order(3 "`leg_y'" 4 "`leg_o'") pos(2) ring(0) rows(2) size(small))"'
 98.         local fdir ../output/figures/`samp'
 99.         foreach fmode of global FIG_MODES {
100.             if "`fmode'" == "paper" {
101.                 local kd_leg `"legend(order(3 "${LBL_young}" 4 "${LBL_old}") pos(2) ring(0) rows(2) size(small))"'
102.                 local fdir ../output/figures/`samp'/paper
103.                 cap mkdir "`fdir'"
104.             }
105.             tw (rarea _kd_c _kd_y _kx, color(ebblue*0.3) lwidth(none)) ///
>                (rarea _kd_c _kd_o _kx, color(dkorange*0.3) lwidth(none)) ///
>                (line _kd_y _kx, lcolor(ebblue) lwidth(medthick)) ///
>                (line _kd_o _kx, lcolor(dkorange) lwidth(medthick)) ///
>                , xtitle("Pre-Period `lbl_`a'', `y0'-`y1' (x capped at pooled p95)") ytitle("Density") ysc(titlegap(-6) outergap(0)) ///
>                  `kd_leg' ///
>                  plotregion(margin(sides))
106.             graph export `fdir'/desc_kd_pre_`a'_raw`suf'.pdf, replace
107.         }
108.         cap drop _kx _kd_y _kd_o _kd_c
109.     }
110. 
.     save ../temp/desc_pre_output_`samp'`suf', replace
111. end

. 
. program horse_race_nih
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local fes athr_id year
  3.     local vce_cl athr_id
  4.     if "$FE_MODE" == "inst_cluster" {
  5.         local fes inst_id cluster_30 year
  6.         local vce_cl inst_id
  7.     }
  8.     if "$FE_MODE" == "inst_cluster_fldyr" {
  9.         local fes inst_id i.cluster_30#i.year
 10.         local vce_cl inst_id
 11.     }
 12.     local suf ""
 13.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
 14.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
 15.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
 16.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
 17. 
.     cap confirm file "../temp/es_`samp'`suf'.dta"
 18.     if _rc {
 19.         di as error "horse_race_nih `samp'`suf': ../temp/es_`samp'`suf'.dta not found -- run add_het_splits first."
 20.         exit
 21.     }
 22.     use ../temp/es_`samp'`suf', clear
 23.     foreach v in young low_nihd nih_pi {
 24.         cap confirm variable `v'
 25.         if _rc {
 26.             di as error "horse_race_nih `samp'`suf': `v' not in panel -- SKIPPED."
 27.             exit
 28.         }
 29.     }
 30.     keep if nih_pi == 1 & !mi(young) & !mi(low_nihd)
 31.     foreach v in young low_nihd {
 32.         qui sum `v'
 33.         if r(N) == 0 | r(min) == r(max) {
 34.             di as error "horse_race_nih `samp'`suf': `v' degenerate on the NIH-matched sample -- SKIPPED."
 35.             exit
 36.         }
 37.     }
 38. 
.     gen post       = year >= 2014
 39.     gen Z_it       = exposure      * post
 40.     gen Z_share_it = mkt_spend_shr * post
 41.     gen Z_early    = Z_it * young
 42.     gen Z_lownih   = Z_it * low_nihd
 43.     gen PT_early   = post * young
 44.     gen PT_lownih  = post * low_nihd
 45. 
.     local yvar_list ppr_cnt cite_affl_wt
 46.     if "$DEBUG_YVAR" != "" local yvar_list $DEBUG_YVAR
 47.     local nyv : word count `yvar_list'
 48. 
.     mat hrace`suf' = J(22, `nyv', .)
 49.     mat rownames hrace`suf' = b_z_base_career se_z_base_career b_z_early_alone se_z_early_alone ///
>                               b_z_base_fund se_z_base_fund b_z_lownih_alone se_z_lownih_alone ///
>                               b_z_base se_z_base b_z_early se_z_early b_z_lownih se_z_lownih ///
>                               early_shift lownih_shift b_diff se_diff p_eq ///
>                               N n_pis n_pis_early
 50.     mat colnames hrace`suf' = `yvar_list'
 51. 
.     local col 0
 52.     foreach yvar of local yvar_list {
 53.         local ++col
 54.         cap drop hr_samp
 55.         cap noi ppmlhdfe `yvar' Z_it Z_early Z_lownih PT_early PT_lownih Z_share_it, ///
>             absorb(`fes') vce(cluster `vce_cl')
 56.         local rc = _rc
 57.         if `rc' {
 58.             di as error "horse_race_nih `samp'`suf' `yvar' joint spec failed (rc=`rc'); column left missing."
 59.             continue
 60.         }
 61.         gen byte hr_samp = e(sample)
 62.         local Nppml = e(N)
 63.         local b_base     = _b[Z_it]
 64.         local se_base    = _se[Z_it]
 65.         local b_early    = _b[Z_early]
 66.         local se_early   = _se[Z_early]
 67.         local b_lownih   = _b[Z_lownih]
 68.         local se_lownih  = _se[Z_lownih]
 69.         qui lincom Z_early - Z_lownih
 70.         local b_diff  = r(estimate)
 71.         local se_diff = r(se)
 72.         qui test Z_early = Z_lownih
 73.         local p_eq = r(p)
 74.         gunique athr_id if hr_samp
 75.         local n_pis = r(unique)
 76.         gunique athr_id if hr_samp & young == 1
 77.         local n_early = r(unique)
 78. 
.         cap noi ppmlhdfe `yvar' Z_it Z_early PT_early Z_share_it if hr_samp, ///
>             absorb(`fes') vce(cluster `vce_cl')
 79.         local rc = _rc
 80.         if `rc' {
 81.             di as error "horse_race_nih `samp'`suf' `yvar' career-only spec failed (rc=`rc'); column left missing."
 82.             continue
 83.         }
 84.         local b_base_c   = _b[Z_it]
 85.         local se_base_c  = _se[Z_it]
 86.         local b_early_a  = _b[Z_early]
 87.         local se_early_a = _se[Z_early]
 88. 
.         cap noi ppmlhdfe `yvar' Z_it Z_lownih PT_lownih Z_share_it if hr_samp, ///
>             absorb(`fes') vce(cluster `vce_cl')
 89.         local rc = _rc
 90.         if `rc' {
 91.             di as error "horse_race_nih `samp'`suf' `yvar' funding-only spec failed (rc=`rc'); column left missing."
 92.             continue
 93.         }
 94.         local b_base_f    = _b[Z_it]
 95.         local se_base_f   = _se[Z_it]
 96.         local b_lownih_a  = _b[Z_lownih]
 97.         local se_lownih_a = _se[Z_lownih]
 98. 
.         mat hrace`suf'[1,`col']  = `b_base_c'
 99.         mat hrace`suf'[2,`col']  = `se_base_c'
100.         mat hrace`suf'[3,`col']  = `b_early_a'
101.         mat hrace`suf'[4,`col']  = `se_early_a'
102.         mat hrace`suf'[5,`col']  = `b_base_f'
103.         mat hrace`suf'[6,`col']  = `se_base_f'
104.         mat hrace`suf'[7,`col']  = `b_lownih_a'
105.         mat hrace`suf'[8,`col']  = `se_lownih_a'
106.         mat hrace`suf'[9,`col']  = `b_base'
107.         mat hrace`suf'[10,`col'] = `se_base'
108.         mat hrace`suf'[11,`col'] = `b_early'
109.         mat hrace`suf'[12,`col'] = `se_early'
110.         mat hrace`suf'[13,`col'] = `b_lownih'
111.         mat hrace`suf'[14,`col'] = `se_lownih'
112.         mat hrace`suf'[15,`col'] = `b_early' - `b_early_a'
113.         mat hrace`suf'[16,`col'] = `b_lownih' - `b_lownih_a'
114.         mat hrace`suf'[17,`col'] = `b_diff'
115.         mat hrace`suf'[18,`col'] = `se_diff'
116.         mat hrace`suf'[19,`col'] = `p_eq'
117.         mat hrace`suf'[20,`col'] = `Nppml'
118.         mat hrace`suf'[21,`col'] = `n_pis'
119.         mat hrace`suf'[22,`col'] = `n_early'
120. 
.         mat hrp_`yvar' = (`b_early_a', `se_early_a' \ `b_lownih_a', `se_lownih_a' \ ///
>                           `b_early', `se_early' \ `b_lownih', `se_lownih')
121. 
.         di as text "horse_race_nih `samp'`suf' `yvar' (NIH-matched sample, N = " %9.0f `Nppml' ", PIs = `n_pis', early = `n_early'):"
122.         di as text "  career only   : Z x Early     = " %9.4f `b_early_a'  "  (se " %7.4f `se_early_a' ")"
123.         di as text "  funding only  : Z x LowNIH    = " %9.4f `b_lownih_a' "  (se " %7.4f `se_lownih_a' ")"
124.         di as text "  horse race    : Z x Early     = " %9.4f `b_early'    "  (se " %7.4f `se_early' ")   shift = " %8.4f `=`b_early' - `b_early_a''
125.         di as text "                  Z x LowNIH    = " %9.4f `b_lownih'   "  (se " %7.4f `se_lownih' ")   shift = " %8.4f `=`b_lownih' - `b_lownih_a''
126.         di as text "  early - lownih (joint) = " %9.4f `b_diff' "  (se " %7.4f `se_diff' ")   p(equal) = " %6.4f `p_eq'
127.     }
128. 
.     cap mkdir ../output/tables
129.     cap mkdir ../output/tables/`samp'
130.     qui matrix_to_txt, saving("../output/tables/`samp'/horse_race_nih`suf'.txt") ///
>         matrix(hrace`suf') title(<tab:horse_race_nih`suf'>) format(%20.4f) replace
131. 
.     cap mkdir "../output/figures/`samp'/coefplot_evavg"
132.     clear
133.     foreach yvar of local yvar_list {
134.         cap confirm matrix hrp_`yvar'
135.         if _rc continue
136.         clear
137.         svmat double hrp_`yvar', names(col)
138.         rename (c1 c2) (b se)
139.         gen ub = b + 1.96*se
140.         gen lb = b - 1.96*se
141.         gen byte career = inlist(_n, 1, 3)
142.         gen y = cond(_n == 1, 4.7, cond(_n == 2, 3.7, cond(_n == 3, 2, 1)))
143.         qui sum lb
144.         local xmin = floor(r(min)/0.5)*0.5
145.         qui sum ub
146.         local xmax = ceil(r(max)/0.5)*0.5
147.         local ylabs `"4.7 "Early-Career {&minus} Late-Career PIs" 3.7 "Below {&minus} Above Median NIH Funding" 2 "Early-Career {&minus} Late-Career PIs, Given Funding" 1 "Below {&minus} Above Median NIH, Given Career Stage""'
148.         tw rcap ub lb y if career == 1, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>            scatter y b if career == 1, mcolor(ebblue) msize(small) || ///
>            rcap ub lb y if career == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>            scatter y b if career == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>            , xline(0, lcolor(gs10) lpattern(solid)) ///
>              yline(2.85, lcolor(gs12) lpattern(dash)) ///
>              ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>              ytitle("") xtitle("Exposure x Post", size(small)) ///
>              xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>              legend(off) ///
>              ysize(4) xsize(8) yscale(range(0.6 5.1)) ///
>              plotregion(margin(l=zero r=zero b=zero t=vsmall))
149.         graph export "../output/figures/`samp'/coefplot_evavg/horse_race_nih_coefplot_`yvar'`suf'.pdf", replace
150.         di as text "wrote ../output/figures/`samp'/coefplot_evavg/horse_race_nih_coefplot_`yvar'`suf'.pdf"
151.     }
152. end

. 
. program output_het_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap mkdir ../output/tables
  8.     cap mkdir ../output/tables/`samp'
  9. 
.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
 10.     if !_rc {
 11.         preserve
 12.         use "../temp/phet_results_`samp'`suf'.dta", clear
 13.         export delimited using "../output/tables/`samp'/phet_results`suf'.txt", replace delim(tab)
 14.         restore
 15.     }
 16. end

. 
. program output_split_diff_tables
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7.     cap confirm file "../temp/phet_results_`samp'`suf'.dta"
  8.     if _rc {
  9.         di as error "output_split_diff_tables `samp'`suf': phet_results not found -- skipping."
 10.         exit 0
 11.     }
 12.     cap mkdir ../output/tables
 13.     cap mkdir ../output/tables/`samp'
 14. 
.     local pairs `"${COEFPLOT_PI_PAIRS}"'
 15.     foreach a of global IC_ALIASES {
 16.         local pairs `"`pairs' "hiw_`a' low_`a'" "'
 17.     }
 18. 
.     foreach yvar in ppr_cnt cite_affl_wt {
 19.         preserve
 20.         use "../temp/phet_results_`samp'`suf'.dta", clear
 21.         keep if yvar == "`yvar'" & spec == "mshrctrl" & inlist(split_type, "med_pi", "med_pi_diff")
 22.         cap mat drop sdiff
 23.         local rows
 24.         foreach pair of local pairs {
 25.             local g1 : word 1 of `pair'
 26.             local g2 : word 2 of `pair'
 27.             qui count if grp == "`g1'_diff" & split_type == "med_pi_diff"
 28.             if r(N) == 0 continue
 29.             foreach g in `g1' `g2' {
 30.                 qui sum post_b  if grp == "`g'" & split_type == "med_pi"
 31.                 local b_`g'  = r(mean)
 32.                 qui sum post_se if grp == "`g'" & split_type == "med_pi"
 33.                 local se_`g' = r(mean)
 34.             }
 35.             qui sum post_b  if grp == "`g1'_diff" & split_type == "med_pi_diff"
 36.             local b_diff = r(mean)
 37.             qui sum post_se if grp == "`g1'_diff" & split_type == "med_pi_diff"
 38.             local se_diff = r(mean)
 39.             qui sum pre_b   if grp == "`g1'_diff" & split_type == "med_pi_diff"
 40.             local p_diff = r(mean)
 41.             qui sum N       if grp == "`g1'_diff" & split_type == "med_pi_diff"
 42.             local Nfit = r(mean)
 43.             mat sdiff = nullmat(sdiff) \ ///
>                 (`b_`g1'', `se_`g1'', `b_`g2'', `se_`g2'', `b_diff', `se_diff', `p_diff', `Nfit')
 44.             local rows `rows' `g1'
 45.         }
 46.         restore
 47.         if "`rows'" == "" continue
 48.         mat colnames sdiff = b_g1 se_g1 b_g2 se_g2 b_diff se_diff p_diff N
 49.         mat rownames sdiff = `rows'
 50.         di as result _n "== split_diff `samp'`suf' `yvar': g1 - g2 off the joint VCE (rows = g1 of each coefplot pair) =="
 51.         matlist sdiff, format(%9.4f) lines(oneline)
 52.         qui matrix_to_txt, saving("../output/tables/`samp'/split_diff_`yvar'`suf'.txt") ///
>             matrix(sdiff) title(<tab:split_diff_`yvar'`suf'>) format(%20.4f) replace
 53.     }
 54. end

. 
. program ppml_het_coefplot
  1.     syntax, samp(string) [, r1r2(int 0) public(int 0) r1_only(int 0) yvar(string)]
  2.     local suf ""
  3.     if (`r1r2' == 1 & `public' == 0 & `r1_only' == 0) local suf "_r1_r2"
  4.     if (`r1r2' == 1 & `public' == 1 & `r1_only' == 0) local suf "_r1_r2_public"
  5.     if (`r1_only' == 1 & `public' == 0) local suf "_r1"
  6.     if (`r1_only' == 1 & `public' == 1) local suf "_r1_public"
  7. 
.     if "`yvar'" != "" {
  8.         local resfile "../temp/phet_results_`samp'`suf'_`yvar'.dta"
  9.     }
 10.     else {
 11.         local resfile "../temp/phet_results_`samp'`suf'.dta"
 12.     }
 13.     cap confirm file "`resfile'"
 14.     if _rc {
 15.         di as error "ppml_het_coefplot: `resfile' not found -- skipping"
 16.         exit 0
 17.     }
 18. 
.     local ppml_het_yvars ppr_cnt ppr_cnt_nonsolo cite_affl_wt avg_num_coathrs ///
>                         n_grants n_new_grants nih_total_cost ///
>                         n_middle_ppr
 19.     if "`yvar'" != "" local ppml_het_yvars `yvar'
 20. 
.     local ic_fund_aliases tfnd lsf
 21.     local ic_expx_aliases endow
 22.     if $HET_IC_FULL == 1 {
 23.         local ic_fund_aliases contr fdlsb fdls fdlsh gntsf hhlsb hhls hhlsh nflsb nfls nflsh subrf busf fedf tfnd instf nonpf statf lsf hsf biof
 24.         local ic_expx_aliases applx apfx basx bfx clinx devx lscx medx endow
 25.     }
 26. 
.     local st_list med_pi joint_ae
 27.     if "$HET_INCLUDE_INSTWTD" == "1" local st_list med `st_list'
 28.     if "$HET_RUN_QUARTILES" == "1" {
 29.         local st_list `st_list' quart_pi
 30.         if "$HET_INCLUDE_INSTWTD" == "1" local st_list `st_list' quart
 31.     }
 32.     foreach st of local st_list {
 33.         local groups_core
 34.         if strpos("`st'", "joint_") == 1 {
 35.             local groups_pi
 36.             local groups_ic_fund
 37.             local groups_ic_expx
 38.         }
 39.         else if "`st'" == "med" {
 40.             local groups_pi
 41.             foreach pair of global COEFPLOT_PI_PAIRS {
 42.                 local groups_pi `groups_pi' `pair'
 43.             }
 44.             local groups_ic_fund
 45.             foreach a of local ic_fund_aliases {
 46.                 local groups_ic_fund `groups_ic_fund' hi_`a' lo_`a'
 47.             }
 48.             local groups_ic_expx
 49.             foreach a of local ic_expx_aliases {
 50.                 local groups_ic_expx `groups_ic_expx' hi_`a' lo_`a'
 51.             }
 52.             local groups_core young old high_nihd low_nihd hi_tfnd lo_tfnd hi_endow lo_endow
 53.         }
 54.         else if "`st'" == "med_pi" {
 55.             local groups_pi
 56.             foreach pair of global COEFPLOT_PI_PAIRS {
 57.                 local groups_pi `groups_pi' `pair'
 58.             }
 59.             local groups_ic_fund
 60.             foreach a of local ic_fund_aliases {
 61.                 local groups_ic_fund `groups_ic_fund' hiw_`a' low_`a'
 62.             }
 63.             local groups_ic_expx
 64.             foreach a of local ic_expx_aliases {
 65.                 local groups_ic_expx `groups_ic_expx' hiw_`a' low_`a'
 66.             }
 67.             local groups_core young old high_nihd low_nihd hiw_tfnd low_tfnd hiw_endow low_endow
 68.         }
 69.         else if "`st'" == "quart" {
 70.             local groups_pi
 71.             foreach b of global PI_Q_BASES {
 72.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 73.             }
 74.             local groups_ic_fund
 75.             foreach a of local ic_fund_aliases {
 76.                 local groups_ic_fund `groups_ic_fund' q4_`a' q1_`a'
 77.             }
 78.             local groups_ic_expx
 79.             foreach a of local ic_expx_aliases {
 80.                 local groups_ic_expx `groups_ic_expx' q4_`a' q1_`a'
 81.             }
 82.         }
 83.         else {
 84.             local groups_pi
 85.             foreach b of global PI_Q_BASES {
 86.                 local groups_pi `groups_pi' q4_`b' q1_`b'
 87.             }
 88.             local groups_ic_fund
 89.             foreach a of local ic_fund_aliases {
 90.                 local groups_ic_fund `groups_ic_fund' q4w_`a' q1w_`a'
 91.             }
 92.             local groups_ic_expx
 93.             foreach a of local ic_expx_aliases {
 94.                 local groups_ic_expx `groups_ic_expx' q4w_`a' q1w_`a'
 95.             }
 96.         }
 97. 
.         foreach spec_tag in mshrctrl {
 98.             local spec_folder = cond($HET_IC_FULL == 1, "coefplot_evavg_full", "coefplot_evavg")
 99.             cap mkdir "../output/figures/`samp'/`spec_folder'"
100. 
.         local groups_all `groups_pi' `groups_ic_fund' `groups_ic_expx'
101.         foreach panel in pi ic_fund ic_expx core all {
102.             local groups `groups_`panel''
103.             local n_groups : word count `groups'
104.             if `n_groups' == 0 continue
105. 
.             foreach yv of local ppml_het_yvars {
106.                 preserve
107.                 use "`resfile'", clear
108.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
109.                 if _N == 0 {
110.                     restore
111.                     continue
112.                 }
113. 
.                 local groups_present
114.                 foreach g of local groups {
115.                     qui count if grp == "`g'" & !mi(post_b)
116.                     if r(N) > 0 local groups_present `groups_present' `g'
117.                 }
118.                 local groups `groups_present'
119.                 local n_groups : word count `groups'
120.                 if `n_groups' == 0 {
121.                     restore
122.                     continue
123.                 }
124. 
.                 local pair_gap 0.3
125.                 local npairs = ceil(`n_groups'/2)
126.                 gen double y = .
127.                 local ylabs ""
128.                 local i = 0
129.                 foreach g of local groups {
130.                     local ++i
131.                     local pair = int((`i'-1)/2)
132.                     local ypos = (`n_groups' - `i') + (`npairs' - 1 - `pair')*`pair_gap' + 1
133.                     qui replace y = `ypos' if grp == "`g'"
134.                     local lbl = "${LBL_`g'}"
135.                     if "`lbl'" == "" local lbl "`g'"
136.                     if length("`lbl'") > 40 local lbl = substr("`lbl'", 1, 37) + "..."
137.                     local ylabs `"`ylabs' `ypos' "`lbl'""'
138.                 }
139.                 drop if mi(y) | mi(post_b)
140.                 if _N == 0 {
141.                     restore
142.                     continue
143.                 }
144.                 gen ub = post_b + 1.96*post_se
145.                 gen lb = post_b - 1.96*post_se
146. 
.                 qui sum lb
147.                 local xmin = floor(r(min)/0.5)*0.5
148.                 qui sum ub
149.                 local xmax = ceil(r(max)/0.5)*0.5
150. 
.                 local ysize = round(0.38 * (`n_groups' + (`npairs'-1)*`pair_gap'), 0.1)
151.                 local ysize = max(3, min(14, `ysize'))
152.                 local labsize small
153.                 if `n_groups' > 20 local labsize vsmall
154. 
.                 gen byte hl = inlist(grp, "young", "old") & "`panel'" == "core"
155.                 local hl_plots
156.                 qui count if hl == 1
157.                 if r(N) > 0 {
158.                     local hl_plots `" || rcap ub lb y if hl == 1, horizontal lcolor(dkorange%70) msize(vsmall) || scatter y post_b if hl == 1, mcolor(dkorange) msize(small)"'
159.                 }
160. 
.                 tw rcap ub lb y if hl == 0, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>                    scatter y post_b if hl == 0, mcolor(ebblue) msize(small) `hl_plots' ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(`labsize') noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(off) ///
>                      ysize(`ysize') xsize(7) ///
>                      yscale(range(0.9 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
161.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf", ///
>                     replace
162.                 di as text "wrote ../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`st'_`panel'`suf'.pdf"
163.                 restore
164.             }
165.         }
166. 
.         if "`st'" == "joint_ae" {
167.             local pfx_len   1
168.             local hi_pfx    y
169.             local lo_pfx    o
170.             local hi_leg    "Early-Career"
171.             local lo_leg    "Late-Career"
172.             local filename_stem joint_ae_paired
173.             local hilo_pos = `pfx_len' + 2
174.             local char_pos = `pfx_len' + 5
175.             foreach yv of local ppml_het_yvars {
176.                 preserve
177.                 use "`resfile'", clear
178.                 keep if yvar == "`yv'" & split_type == "`st'" & spec == "`spec_tag'"
179.                 if _N == 0 {
180.                     restore
181.                     continue
182.                 }
183.                 gen str2  pfx_c  = substr(grp, 1, `pfx_len')
184.                 gen str2  hilo_c = substr(grp, `hilo_pos', 2)
185.                 gen str12 char_c = substr(grp, `char_pos', .)
186.                 gen byte  is_hi_side = (pfx_c == "`hi_pfx'")
187.                 gen char_idx = .
188.                 local ii = 0
189.                 foreach a of global IC_ALIASES {
190.                     local ++ii
191.                     qui replace char_idx = `ii' if char_c == "`a'"
192.                 }
193.                 qui drop if mi(char_idx)
194.                 if _N == 0 {
195.                     restore
196.                     continue
197.                 }
198.                 qui sum char_idx
199.                 local nchars = r(max)
200.                 gen double y_group = (`nchars' + 1 - char_idx) * 3.2
201.                 gen double y_pos   = y_group ///
>                     + cond(hilo_c == "hi" & is_hi_side == 1,  1.0, ///
>                       cond(hilo_c == "hi" & is_hi_side == 0,  0.4, ///
>                       cond(hilo_c == "lo" & is_hi_side == 1, -0.4, -1.0)))
202.                 gen ub = post_b + 1.96*post_se
203.                 gen lb = post_b - 1.96*post_se
204. 
.                 local ylabs
205.                 forvalues i = 1/`nchars' {
206.                     qui levelsof char_c if char_idx == `i', local(cname) clean
207.                     local clbl = "${LBL_ic_`cname'}"
208.                     if "`clbl'" == "" local clbl "`cname'"
209.                     local base = (`nchars' + 1 - `i') * 3.2
210.                     local pos_hi = `base' + 1.0
211.                     local pos_lo = `base' - 0.4
212.                     local ylabs `"`ylabs' `pos_hi' "High `clbl'""'
213.                     local ylabs `"`ylabs' `pos_lo' "Low `clbl'""'
214.                 }
215. 
.                 qui sum lb
216.                 local xmin = floor(r(min)/0.5)*0.5
217.                 qui sum ub
218.                 local xmax = ceil(r(max)/0.5)*0.5
219. 
.                 tw rcap ub lb y_pos if is_hi_side == 1, horizontal lcolor(ebblue%70) msize(vsmall)   || ///
>                    scatter y_pos post_b if is_hi_side == 1, mcolor(ebblue) msize(small)              || ///
>                    rcap ub lb y_pos if is_hi_side == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                    scatter y_pos post_b if is_hi_side == 0, mcolor(dkorange) msymbol(D) msize(small) ///
>                    , xline(0, lcolor(gs10) lpattern(solid)) ///
>                      ylabel(`ylabs', angle(0) labsize(small) noticks nogrid) ///
>                      ytitle("") xtitle("Exposure x Post", size(small)) ///
>                      xlabel(`xmin'(0.5)`xmax', labsize(small)) ///
>                      legend(order(2 "`hi_leg'" 4 "`lo_leg'") pos(6) ring(1) rows(1) span size(small)) ///
>                      ysize(`=max(8, `nchars'*1.6)') xsize(9) ///
>                      yscale(range(2.1 .)) ///
>                      plotregion(margin(l=zero r=zero b=zero t=vsmall))
220.                 graph export ///
>                     "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_`filename_stem'`suf'.pdf", ///
>                     replace
221.                 di as text "wrote `filename_stem' coefplot for `yv' `spec_tag'"
222.                 restore
223.             }
224.             joint_ae_panel_coefplot, resfile("`resfile'") yvars(`ppml_het_yvars') samp(`samp') ///
>                 suf(`suf') spec_folder(`spec_folder') spec_tag(`spec_tag')
225.         }
226. 
.         }
227.     }
228. end

. 
. program joint_ae_panel_coefplot
  1.     syntax, resfile(string) yvars(string) samp(string) spec_folder(string) spec_tag(string) [suf(string)]
  2.     foreach a of global IC_ALIASES {
  3.         local clbl = "${LBL_ic_`a'}"
  4.         if "`clbl'" == "" local clbl "`a'"
  5.         foreach yv of local yvars {
  6.             preserve
  7.             use "`resfile'", clear
  8.             keep if yvar == "`yv'" & spec == "`spec_tag'" & inlist(split_type, "joint_ae", "joint_ae_gap")
  9.             keep if inlist(grp, "y_hi_`a'", "o_hi_`a'", "y_lo_`a'", "o_lo_`a'", "hi_gap_`a'", "lo_gap_`a'")
 10.             qui count if split_type == "joint_ae" & !mi(post_b)
 11.             if r(N) < 4 {
 12.                 restore
 13.                 continue
 14.             }
 15.             foreach hl in hi lo {
 16.                 qui sum post_b if grp == "y_`hl'_`a'"
 17.                 local b_y = r(mean)
 18.                 qui sum post_b if grp == "o_`hl'_`a'"
 19.                 local b_o = r(mean)
 20.                 local gap : di %4.2f `b_o' - `b_y'
 21.                 local gaptxt_`hl' "gap {&asymp} `gap'"
 22.                 qui count if grp == "`hl'_gap_`a'"
 23.                 if r(N) > 0 {
 24.                     qui sum pre_b if grp == "`hl'_gap_`a'"
 25.                     local pgap : di %4.2f r(mean)
 26.                     local gaptxt_`hl' "gap = `gap' (p = `pgap')"
 27.                 }
 28.             }
 29.             keep if split_type == "joint_ae"
 30.             gen double y_pos = cond(grp == "y_hi_`a'", 5.3, cond(grp == "o_hi_`a'", 4.5, ///
>                                cond(grp == "y_lo_`a'", 2.3, 1.5)))
 31.             gen byte early = substr(grp, 1, 1) == "y"
 32.             gen ub = post_b + 1.96*post_se
 33.             gen lb = post_b - 1.96*post_se
 34.             qui sum lb
 35.             local xmin = floor(r(min)/0.5)*0.5
 36.             qui sum ub
 37.             local xmax = ceil(r(max)/0.5)*0.5
 38.             local xl = `xmin' - 1.2
 39.             local xr = `xmax' + 1.4
 40.             local n0 = _N
 41.             qui set obs `=`n0' + 2'
 42.             gen double bx = `xl' in `=`n0' + 1'
 43.             replace bx = `xr' in `=`n0' + 2'
 44.             gen double ab_lo = 4.0 if !mi(bx)
 45.             gen double ab_hi = 6.6 if !mi(bx)
 46.             gen double be_lo = 1.0 if !mi(bx)
 47.             gen double be_hi = 3.6 if !mi(bx)
 48.             local xhdr = `xl' + 0.1
 49.             local xlab = `xmin' - 0.15
 50.             local xgap = `xmax' + 0.15
 51. 
.             tw rarea ab_hi ab_lo bx, color(gs15) lwidth(none) || ///
>                rarea be_hi be_lo bx, color(gs15) lwidth(none) || ///
>                rcap ub lb y_pos if early == 1, horizontal lcolor(ebblue%70) msize(vsmall) || ///
>                scatter y_pos post_b if early == 1, mcolor(ebblue) msize(medium) || ///
>                rcap ub lb y_pos if early == 0, horizontal lcolor(dkorange%70) msize(vsmall) || ///
>                scatter y_pos post_b if early == 0, mcolor(dkorange) msize(medium) ///
>                , xline(0, lcolor(gs10) lpattern(solid)) ///
>                  text(6.2 `xhdr' "{bf:Above-median `clbl'}", place(e) size(medsmall) color(black)) ///
>                  text(3.2 `xhdr' "{bf:Below-median `clbl'}", place(e) size(medsmall) color(black)) ///
>                  text(5.3 `xlab' "${LBL_young}", place(w) size(small) color(ebblue)) ///
>                  text(4.5 `xlab' "${LBL_old}",   place(w) size(small) color(dkorange)) ///
>                  text(2.3 `xlab' "${LBL_young}", place(w) size(small) color(ebblue)) ///
>                  text(1.5 `xlab' "${LBL_old}",   place(w) size(small) color(dkorange)) ///
>                  text(4.9 `xgap' "`gaptxt_hi'", place(e) size(small) color(gs6)) ///
>                  text(1.9 `xgap' "`gaptxt_lo'", place(e) size(small) color(gs6)) ///
>                  ylabel(none) yscale(off range(0.8 6.8)) ytitle("") ///
>                  xlabel(`xmin'(0.5)`xmax', labsize(small)) xscale(range(`xl' `xr')) ///
>                  xtitle("Exposure x Post", size(small)) ///
>                  legend(off) ysize(5) xsize(9) ///
>                  plotregion(margin(zero)) graphregion(margin(small))
 52.             graph export ///
>                 "../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_joint_ae_panel_`a'`suf'.pdf", ///
>                 replace
 53.             di as text "wrote ../output/figures/`samp'/`spec_folder'/ppml_het_coefplot_`yv'_joint_ae_panel_`a'`suf'.pdf"
 54.             restore
 55.         }
 56.     }
 57. end

. 
