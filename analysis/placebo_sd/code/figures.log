. program main
  1.     foreach s in "" "_all3" {
  2.         global suffix `s'
  3.         cap mat drop placebo_sd_test
  4.         foreach o in price spend {
  5.             sd_test, outcome(`o')
  6.         }
  7.         output_tables
  8.     }
  9. end

. 
. program sd_test
  1.     syntax, outcome(str)
  2. 
.     use ../external/real/did_coefs_`outcome'$suffix, clear
  3.     qui sum b
  4.     local sd_r   = r(sd)
  5.     local n_r    = r(N)
  6.     local mean_r = r(mean)
  7.     if `n_r' < 2 | missing(`sd_r') {
  8.         di as error "Real coefficients must contain at least two valid estimates."
  9.         exit 459
 10.     }
 11.     qui sum se
 12.     local se_r = r(mean)
 13.     keep b
 14.     gen sample = 1
 15.     save ../temp/real_b_`outcome'$suffix, replace
 16. 
.     use ../output/placebo_sd_coefs$suffix, clear
 17.     isid iter cid
 18.     assert !missing(iter, cid)
 19.     // An omitted coefficient (SE = 0) is not a successfully estimated effect.
.     gen byte valid_estimate = !missing(b_`outcome', se_`outcome') & se_`outcome' > 0
 20.     gcollapse (sd) sd_b = b_`outcome' (mean) mean_b = b_`outcome' (mean) mean_se = se_`outcome' ///
>         (count) n_mkts = b_`outcome' (sum) n_valid = valid_estimate, by(iter)
 21.     // Fail rather than condition the placebo distribution on regression success.
.     count if n_mkts != `n_r' | n_valid != `n_r' | missing(sd_b)
 22.     if r(N) > 0 {
 23.         di as error "Incomplete or invalid placebo draws for `outcome'$suffix: " r(N)
 24.         list iter n_mkts n_valid sd_b if n_mkts != `n_r' | n_valid != `n_r' | missing(sd_b), noobs
 25.         exit 459
 26.     }
 27.     if _N == 0 {
 28.         di as error "No placebo draws available."
 29.         exit 459
 30.     }
 31.     save ../output/placebo_sd_iters_`outcome'$suffix, replace
 32. 
.     count
 33.     local n_draws = r(N)
 34.     count if !missing(sd_b) & sd_b >= `sd_r'
 35.     local n_exceed = r(N)
 36.     local p_sd = `n_exceed' / `n_draws'
 37.     // Exact binomial interval describes Monte Carlo uncertainty, including zero hits.
.     quietly cii proportions `n_draws' `n_exceed', exact level(95)
 38.     local p_mc_lb = r(lb)
 39.     local p_mc_ub = r(ub)
 40.     qui sum sd_b, d
 41.     local sd_p_mean = r(mean)
 42.     local sd_p_p5   = r(p5)
 43.     local sd_p_p50  = r(p50)
 44.     local sd_p_p95  = r(p95)
 45.     local sd_p_max  = r(max)
 46.     qui sum mean_se
 47.     local se_p = r(mean)
 48.     qui sum n_mkts
 49.     local n_mkts_p = r(mean)
 50. 
.     mat col = (`sd_r' \ `n_r' \ `se_r' \ `n_draws' \ `n_mkts_p' \ `sd_p_mean' \ `sd_p_p5' \ `sd_p_p50' \ `sd_p_p95' \ `sd_p_max' \ `se_p' \ `p_sd' \ `n_exceed' \ `p_mc_lb' \ `p_mc_ub')
 51.     mat rownames col = treated_sd n_treated treated_mean_se n_draws placebo_n_mkts placebo_sd_mean placebo_sd_p5 placebo_sd_p50 placebo_sd_p95 placebo_sd_max placebo_mean_se p_value n_exceed p_mc_lb p_mc_ub
 52.     mat colnames col = `outcome'
 53.     mat placebo_sd_test = nullmat(placebo_sd_test), col
 54. 
.     local sd_r_lab : di %5.3f `sd_r'
 55.     local sd_p_lab : di %5.3f `sd_p_mean'
 56.     local p_lab : di "= " %5.3f `p_sd'
 57.     local p_ci_lab : di "[" %5.3f `p_mc_lb' ", " %5.3f `p_mc_ub' "]"
 58. 
.     local xmax = max(`sd_p_max', `sd_r') * 1.05
 59.     tw histogram sd_b, color(gs10%80) width(0.005) start(0) ///
>        xtitle("SD of DiD coefficients across placebo-treated markets (log `outcome')") ///
>        ytitle("Density") ///
>        xsc(range(0 `xmax')) ///
>        xline(`sd_r', lcolor(ebblue) lwidth(medthick)) ///
>        legend(on order(- "Treated SD = `sd_r_lab' (N = `n_r')" ///
>                          "Placebo SD mean = `sd_p_lab' (draws = `n_draws')" ///
>                          "Placebo p `p_lab' (`n_exceed'/`n_draws' exceedances)" ///
>                          "95% Monte Carlo CI `p_ci_lab'") ///
>               pos(1) ring(0) region(fcolor(none)) size(small))
 60.     graph export ../output/figures/placebo_sd_hist_`outcome'$suffix.pdf, replace
 61. 
.     use ../output/placebo_sd_coefs$suffix, clear
 62.     keep b_`outcome'
 63.     rename b_`outcome' b
 64.     drop if mi(b)
 65.     gen sample = 2
 66.     append using ../temp/real_b_`outcome'$suffix
 67. 
.     qui sum b if sample == 1
 68.     local mean_r_lab : di %6.3f r(mean)
 69.     qui sum b if sample == 2
 70.     local N_p = r(N)
 71.     local mean_p_lab : di %6.3f r(mean)
 72.     local sd_pool_lab : di %6.3f r(sd)
 73. 
.     qui sum b
 74.     local gmin  = r(min)
 75.     local gmax  = r(max)
 76.     local xmin  = floor(`gmin' * 10) / 10
 77.     local xmax  = ceil(`gmax' * 10) / 10
 78.     local xstep = cond(`xmax' - `xmin' > 1.5, 0.2, 0.1)
 79.     local ngrid = 400
 80.     if _N < `ngrid' set obs `ngrid'
 81.     gen xgrid = `gmin' + (`gmax' - `gmin') * (_n - 1) / (`ngrid' - 1) in 1/`ngrid'
 82.     kdensity b if sample == 1, nograph at(xgrid) gen(dens_r)
 83.     kdensity b if sample == 2, nograph at(xgrid) gen(dens_p)
 84.     gen lo = min(dens_r, dens_p)
 85. 
.     local modes $exhibit_mode
 86.     if "$exhibit_mode" == "both" local modes presentation paper
 87.     foreach mode in `modes' {
 88.         local figdir ../output/figures
 89.         local stats_note `"- "Placebo SD test p `p_lab' (`n_exceed'/`n_draws' exceedances)" "95% Monte Carlo CI `p_ci_lab'""'
 90.         if "`mode'" == "paper" {
 91.             local figdir ../output/figures/paper
 92.             local stats_note
 93.         }
 94.         tw rarea dens_r lo xgrid, color(ebblue%25) lwidth(none) || ///
>            rarea dens_p lo xgrid, color(gs12%50) lwidth(none) || ///
>            line dens_r xgrid, color(ebblue%70) lwidth(medthick) || ///
>            line dens_p xgrid, color(gs10%80) lwidth(medthick) lpattern(dash) ///
>            xtitle("DiD Coefficient (log `outcome')") ///
>            ytitle("Density") ///
>            xlab(`xmin'(`xstep')`xmax') ///
>            xline(0, lcolor(gs6) lpattern(dash)) ///
>            xline(`mean_r', lcolor(ebblue) lpattern(solid) lwidth(medthin)) ///
>            legend(on order(3 "Actual Treatment Effects (N=`n_r', mean=`mean_r_lab', sd=`sd_r_lab')" ///
>                            4 "Placebo Treatment Effects (N=`N_p', mean=`mean_p_lab', sd=`sd_pool_lab')" ///
>                            `stats_note') ///
>                   pos(7) ring(1) region(fcolor(none)) size(small))
 95.         graph export `figdir'/did_coefs_overlay_kdens_sd_`outcome'$suffix.pdf, replace
 96.     }
 97. end

. 
. program output_tables
  1.     foreach tab in placebo_sd_test {
  2.         qui matrix_to_txt, saving("../output/tables/`tab'$suffix.txt") matrix(`tab') ///
>             title(<tab:`tab'>) format(%20.4f) replace
  3.     }
  4. end

. 
