. 
. foreach v in lab_spend tot_spend {
  2.     if "`v'" == "tot_spend" local xtitle "Annual total spend ($, PI-year)"
  3.     if "`v'" == "lab_spend" local xtitle "Annual lab spend ($, PI-year)"
  4.     local w 5000
  5.     local wlab "$5,000"
  6.     qui sum `v', d
  7.     local xcap = r(p95)
  8.     qui sum `v' if young == 1, d
  9.     local mean_y = strtrim("`: di %9.0fc r(mean)'")
 10.     local p50_y  = strtrim("`: di %9.0fc r(p50)'")
 11.     local n_y    = r(N)
 12.     qui sum `v' if young == 0, d
 13.     local mean_o = strtrim("`: di %9.0fc r(mean)'")
 14.     local p50_o  = strtrim("`: di %9.0fc r(p50)'")
 15.     local n_o    = r(N)
 16.     cap drop _kx_y _kd_y _kx_o _kd_o _kp_y _kp_o
 17.     kdensity `v' if young == 1 & `v' <= `xcap', gen(_kx_y _kd_y) n(200) nograph
 18.     kdensity `v' if young == 0 & `v' <= `xcap', gen(_kx_o _kd_o) n(200) nograph
 19.     gen _kp_y = _kd_y * `w' * 100
 20.     gen _kp_o = _kd_o * `w' * 100
 21.     tw (line _kp_y _kx_y if inrange(_kx_y, 0, `xcap'), lcolor(ebblue)) ///
>        (line _kp_o _kx_o if inrange(_kx_o, 0, `xcap'), lcolor(dkorange)), ///
>        xtitle("`xtitle'") ytitle("Percent of PI-years (per `wlab' bin)") ///
>        legend(order(1 "Young: mean=`mean_y', p50=`p50_y', N=`n_y' (PIs=`npi_y')" ///
>                     2 "Old: mean=`mean_o', p50=`p50_o', N=`n_o' (PIs=`npi_o')") ///
>            pos(1) ring(0) cols(1) size(small) region(fcolor(none))) ///
>        plotregion(margin(sides))
 22.     graph export ../output/figures/kd_`v'_by_age_piyr.pdf, replace
 23.     graph export `scratch'/kd_`v'_piyr.png, replace width(1200)
 24.     cap drop _kx_y _kd_y _kx_o _kd_o _kp_y _kp_o
 25. }
