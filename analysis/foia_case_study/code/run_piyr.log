. do /tmp/run_piyr.do 

. set more off

. clear all

. set scheme modern

. preliminaries

. version 17

. local scratch /tmp/claude-67049/-n-holylabs-pakes-lab-Lab-sci-eq/593c86b4-6d7b-46e4-a29b-a5b5aeb79839/scratchpad

. 
. use ../external/samp/merged_foias_with_pis, clear

. drop if mi(athr_id)
(82,800 observations deleted)

. gen year = year(date(date, "YMD"))

. drop if year > 2013
(322,872 observations deleted)

. merge m:1 category using ../external/categories/categories_tfidf, keep(1 3)

    Result                      Number of obs
    -----------------------------------------
    Not matched                        28,242
        from master                    28,242  (_merge==1)
        from using                          0  (_merge==2)

    Matched                            99,809  (_merge==3)
    -----------------------------------------

. rename _merge nonlab

. replace nonlab = 0 if nonlab == 3
(99,809 real changes made)

. replace keep = 2 if keep == .
(28,242 real changes made)

. gen hq = keep == 1 | (bad_control == 1 & support >= 25 & precision >= 0.8 & recall >= 0.8)

. gen nonlab_spend = spend if nonlab == 1
(102,608 missing values generated)

. gen lab_spend    = spend if nonlab == 0
(31,351 missing values generated)

. gen hq_labspend  = lab_spend if hq == 1
(58,172 missing values generated)

. collapse (sum) tot_spend = spend nonlab_spend lab_spend hq_labspend, by(athr_id year)

. gen perc_lab_spend = lab_spend / tot_spend * 100
(127 missing values generated)

. save ../temp/spend_athr_yr, replace
(file ../temp/spend_athr_yr.dta not found)
file ../temp/spend_athr_yr.dta saved

. 
. merge m:1 athr_id using ../temp/foia_pi_age, keep(3) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                               240  
    -----------------------------------------

. egen _tag = tag(athr_id)

. qui sum age_2014 if _tag, d

. local med_age = r(p50)

. gen young = age_2014 < `med_age'

. count if _tag & young == 1
  32

. local npi_y = r(N)

. count if _tag & young == 0
  36

. local npi_o = r(N)

. di "median age = `med_age'"
median age = 54

. 
. di _n "===== YOUNG PI-years (PIs=`npi_y') ====="

===== YOUNG PI-years (PIs=32) =====

. tabstat tot_spend lab_spend nonlab_spend hq_labspend perc_lab_spend if young == 1, stat(mean p25 p50 p75 n) columns(stat) format(%12.1f)

