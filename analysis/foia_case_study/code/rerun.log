. program boe
  1.     use ../external/samp/merged_foias_with_pis,  clear
  2.     keep if inlist(uni , "utdallas", "umich")
  3.     drop if mi(athr_id)
  4.     gen year = year(date(date, "YMD"))
  5.     drop if year > 2013
  6.     merge m:1 category using ../external/categories/categories_tfidf, keep(1 3) 
  7.     rename _merge nonlab
  8.     replace nonlab = 0 if nonlab == 3
  9.     sum spend, d
 10.     local total_spend = r(sum)
 11.     sum spend if nonlab == 0
 12.     local lab_spend = r(sum)
 13.     di "% lab spend = " `lab_spend'/`total_spend'*100
 14.     sum spend if keep == 1 & nonlab == 0 | bad_control == 1
 15.     local spend_in_sample = r(sum)
 16.     di "%lab spend classified as high quality= "  `spend_in_sample'/`lab_spend'*100
 17.     replace keep = 2 if keep ==.
 18.     gen nonlab_spend = spend if nonlab == 1 
 19.     gen lab_spend = spend if nonlab == 0
 20.     gen hq = keep == 1 | (bad_control == 1 & support >= 25 & precision >= 0.8 & recall >= 0.8)
 21.     collapse (sum) spend nonlab_spend lab_spend , by(athr_id year hq)
 22.     gen hq_labspend = lab_spend if hq == 1
 23.     gen lq_labspend = lab_spend if hq == 0
 24.     collapse (sum) tot_spend = spend nonlab_spend lab_spend hq_labspend lq_labspend  , by(athr_id year)
 25.     gen perc_lab_spend = lab_spend/tot_spend* 100
 26.     gen perc_nonlab_spend = nonlab_spend/tot_spend* 100
 27.     sum lab_spend if lab_spend >50, d
 28.     local mean_lab_spend : di %6.2f r(mean)
 29.     local sd_lab_spend : di %6.2f r(sd)
 30.     local min_lab_spend : di %6.2f r(min)
 31.     local max_lab_spend : di %10.2f r(max)
 32.     local N_lab_spend : di %6.0f r(N)
 33.     local q1_lab_spend : di %6.2f r(p25)
 34.     local q3_lab_spend : di %6.2f r(p75)
 35.     local median_lab_spend : di %6.2f r(p50)
 36.    tw hist lab_spend if lab_spend >50,  color(edkblue) frac width(5000) xlab(0(7500)150000, angle(45)) ///
>        xtitle("Consumables expenditure ($)") ytitle("Fraction of PI-years") legend(on order(- "N = `N_lab_spend'" "Mean = `mean_lab_spend'" "SD = `sd_lab_spend'" "Min = `min_lab_spend'" "Q1 = `q1_lab_spend'" "Median = `median_lab_spend'" "Q3 = `q3_lab_s
> pend'" "Max = `max_lab_spend'") pos(1) ring(0) region(fcolor(none)) size(small))
 37.    fig_export, path("../output/figures/lab_spend.pdf")
 38.     sum hq_labspend if hq_labspend >50, d
 39.     local mean_hq : di %6.2f r(mean)
 40.     local sd_hq : di %6.2f r(sd)
 41.     local min_hq : di %6.2f r(min)
 42.     local max_hq : di %10.2f r(max)
 43.     local N_hq : di %6.0f r(N)
 44.     local q1_hq : di %6.2f r(p25)
 45.     local q3_hq : di %6.2f r(p75)
 46.     local median_hq : di %6.2f r(p50)
 47.    tw hist hq_labspend if hq_labspend >50 & hq_labspend <= 75000,  color(edkblue) frac width(5000) xlab(0(7500)75000, angle(45)) ///
>        xtitle("High-confidence consumables expenditure ($)") ytitle("Fraction of PI-years") legend(on order(- "N = `N_hq'" "Mean = `mean_hq'" "SD = `sd_hq'" "Min = `min_hq'" "Q1 = `q1_hq'" "Median = `median_hq'" "Q3 = `q3_hq'" "Max = `max_hq'") pos(1) r
> ing(0) region(fcolor(none)) size(small))
 48.    fig_export, path("../output/figures/hq_labspend.pdf")
 49.     collapse (mean) tot_spend nonlab_spend lab_spend hq_labspend lq_labspend perc_lab_spend perc_nonlab_spend, by(athr_id)
 50.     sum hq_labspend if hq_labspend >50, d
 51.     local mean_hq : di %6.2f r(mean)
 52.     local sd_hq : di %6.2f r(sd)
 53.     local min_hq : di %6.2f r(min)
 54.     local max_hq : di %10.2f r(max)
 55.     local N_hq : di %6.0f r(N)
 56.     local q1_hq : di %6.2f r(p25)
 57.     local q3_hq : di %6.2f r(p75)
 58.     local median_hq : di %6.2f r(p50)
 59.    tw hist hq_labspend if hq_labspend >50 & hq_labspend <= 75000,  color(edkblue) frac width(5000) xlab(0(7500)75000, angle(45)) ///
>        xtitle("Avg annual high-confidence consumables expenditure ($)") ytitle("Fraction of PIs") legend(on order(- "N = `N_hq'" "Mean = `mean_hq'" "SD = `sd_hq'" "Min = `min_hq'" "Q1 = `q1_hq'" "Median = `median_hq'" "Q3 = `q3_hq'" "Max = `max_hq'") po
> s(1) ring(0) region(fcolor(none)) size(small))
 60.    fig_export, path("../output/figures/hq_labspend_pi.pdf")
 61.     graph bar lab_spend nonlab_spend, over(athr_id ,sort((mean) tot_spend) descending) stack bar(1, color(lavender%70)) bar(2, color(dkorange%70)) legend(on order(- "Lab spend" - "Non-lab spend") pos(1) ring(0) size(small) region(fcolor(none))) ytitl
> e("Average annual spend ($)") plotregion(margin(sides))
 62.     fig_export, path("../output/figures/avg_spend_by_athr.pdf")
 63.    kdensity perc_lab_spend
 64.    fig_export, path("../output/figures/perc_lab_spend.pdf")
 65.    kdensity perc_nonlab_spend
 66.    fig_export, path("../output/figures/perc_nonlab_spend.pdf")
 67.    bs_stats, y(perc_lab_spend) x(lab_spend) ///
>        ytitle(Lab share of spend (%)) xtitle(Avg annual lab spend ($)) ///
>        out(../output/figures/bs_perc_lab_spend_by_lab_spend.pdf)
 68.    bs_stats, y(perc_lab_spend) x(tot_spend) ///
>        ytitle(Lab share of spend (%)) xtitle(Avg annual total spend ($)) ///
>        out(../output/figures/bs_perc_lab_spend_by_tot_spend.pdf)
 69.    bs_stats, y(perc_nonlab_spend) x(nonlab_spend) ///
>        ytitle(Non-lab share of spend (%)) xtitle(Avg annual non-lab spend ($)) ///
>        out(../output/figures/bs_perc_nonlab_spend_by_lab_spend.pdf)
 70.    bs_stats, y(lab_spend) x(tot_spend) ///
>        ytitle(Avg annual lab spend ($)) xtitle(Avg annual total spend ($)) ///
>        out(../output/figures/bs_lab_spend_by_tot_spend.pdf)
 71. end

