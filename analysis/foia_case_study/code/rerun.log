. program consumables_intensity
  1.     syntax [, suf(string)]
  2.     cap mkdir ../output/tables
  3.     cap mkdir ../output/figures
  4. 
.     use athr_id athr_indicator foia_athr nih_pi_name ///
>         using ../external/pi_samp/pi_desc_all_jrnls_r1_r2`suf', clear
  5.     keep if athr_indicator == 1 & foia_athr == 1
  6.     gen byte nih_matched = !mi(nih_pi_name)
  7.     keep athr_id nih_matched
  8.     save ../temp/foia_pi_nih`suf', replace
  9. 
.     use ../temp/spend_athr_yr, clear
 10.     keep if inrange(year, 2010, 2013)
 11.     merge m:1 athr_id using ../temp/foia_pi_age`suf', keep(3) nogen
 12.     merge m:1 athr_id using ../temp/foia_pi_nih`suf', keep(3) nogen
 13.     merge 1:1 athr_id year using ../temp/nih_athr_yr, keep(1 3) nogen
 14.     replace nih_amt = 0 if mi(nih_amt)
 15.     egen _tag = tag(athr_id)
 16.     qui count if _tag
 17.     local n_foia = r(N)
 18.     keep if nih_matched == 1
 19.     qui count if _tag
 20.     local n_match = r(N)
 21.     qui sum min_year if _tag, d
 22.     local med_yr = r(p50)
 23.     gen young = min_year > `med_yr' if !mi(min_year)
 24.     qui count if _tag & young == 1
 25.     local npi_y = r(N)
 26.     qui count if _tag & young == 0
 27.     local npi_o = r(N)
 28.     drop _tag
 29.     foreach v in lab_spend hq_labspend tot_spend {
 30.         gen double `v'_pct_nih = `v' / nih_amt * 100 if nih_amt > 0
 31.     }
 32.     di as text "consumables_intensity`suf': `n_foia' FOIA PIs with 2010-2013 spend -> " ///
>         "`n_match' matched to RePORTER; median min_year = `med_yr'; PIs young/old = `npi_y'/`npi_o'"
 33.     keep athr_id year min_year lab_age_2014 young tot_spend lab_spend hq_labspend ///
>          nih_amt nih_active *_pct_nih
 34.     save ../output/consumables_intensity_piyrs`suf', replace
 35. 
.     cap mat drop cons_piyr
 36.     qui count if young == 1
 37.     local nyr_y = r(N)
 38.     qui count if young == 0
 39.     local nyr_o = r(N)
 40.     foreach g in 1 0 {
 41.         qui count if young == `g' & nih_amt == 0
 42.         local nzero_`g' = r(N)
 43.         foreach v in lab_spend hq_labspend tot_spend {
 44.             qui sum `v' if young == `g' & nih_amt > 0
 45.             local num = r(sum)
 46.             qui sum nih_amt if young == `g' & nih_amt > 0
 47.             local agg_`v'_`g' = `num' / r(sum) * 100
 48.         }
 49.     }
 50.     mat cons_piyr = (`npi_y', ., `npi_y', `npi_o', ., `npi_o')
 51.     mat cons_piyr = cons_piyr \ (`nyr_y', ., `nyr_y', `nyr_o', ., `nyr_o')
 52.     mat cons_piyr = cons_piyr \ (`nzero_1', ., `nzero_1', `nzero_0', ., `nzero_0')
 53.     local rownames "n_pis n_pi_yrs n_pi_yrs_zero_nih"
 54.     foreach v in lab_spend hq_labspend tot_spend nih_amt ///
>                  lab_spend_pct_nih hq_labspend_pct_nih tot_spend_pct_nih {
 55.         qui sum `v' if young == 1, d
 56.         local y_mean = r(mean)
 57.         local y_p50  = r(p50)
 58.         local y_N    = r(N)
 59.         qui sum `v' if young == 0, d
 60.         mat cons_piyr = cons_piyr \ (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
 61.         local rownames "`rownames' `v'"
 62.     }
 63.     foreach v in lab_spend hq_labspend tot_spend {
 64.         mat cons_piyr = cons_piyr \ (`agg_`v'_1', ., ., `agg_`v'_0', ., .)
 65.         local rownames "`rownames' agg_`v'_pct_nih"
 66.     }
 67.     mat colnames cons_piyr = young_mean young_p50 young_N old_mean old_p50 old_N
 68.     mat rownames cons_piyr = `rownames'
 69.     qui matrix_to_txt, saving("../output/tables/consumables_intensity_piyr`suf'.txt") ///
>         matrix(cons_piyr) title(<tab:consumables_intensity_piyr`suf'>) format(%14.4f) replace
 70. 
.     kd_young_old lab_spend_pct_nih, xtitle(Lab consumables spend as % of NIH funding (PI-year)) ///
>         w(1) wlab("1pp") unit(PI-years) fmt(%9.2f) cluster(athr_id) ///
>         out(../output/figures/kd_lab_spend_pct_nih_by_age_piyr`suf'.pdf)
 71.     kd_young_old hq_labspend_pct_nih, ///
>         xtitle(High-confidence lab spend as % of NIH funding (PI-year)) ///
>         w(1) wlab("1pp") unit(PI-years) fmt(%9.2f) cluster(athr_id) ///
>         out(../output/figures/kd_hq_labspend_pct_nih_by_age_piyr`suf'.pdf)
 72. 
.     collapse (mean) tot_spend lab_spend hq_labspend nih_amt nih_active ///
>              (count) n_yrs = year (first) min_year lab_age_2014 young, by(athr_id)
 73.     qui count
 74.     local n_pis = r(N)
 75.     keep if nih_amt >= 10000
 76.     qui count
 77.     local n_kept = r(N)
 78.     di as text "consumables_intensity`suf': `n_pis' PIs -> `n_kept' above the $10k/yr NIH floor"
 79.     foreach v in lab_spend hq_labspend tot_spend {
 80.         gen double `v'_pct_nih = `v' / nih_amt * 100
 81.     }
 82.     save ../output/consumables_intensity_pis`suf', replace
 83. 
.     cap mat drop cons_pi
 84.     qui count if young == 1
 85.     local n_young = r(N)
 86.     qui count if young == 0
 87.     local n_old = r(N)
 88.     foreach g in 1 0 {
 89.         foreach v in lab_spend hq_labspend tot_spend {
 90.             qui sum `v' if young == `g'
 91.             local num = r(sum)
 92.             qui sum nih_amt if young == `g'
 93.             local agg_`v'_`g' = `num' / r(sum) * 100
 94.         }
 95.     }
 96.     mat cons_pi = (`n_young', ., `n_young', `n_old', ., `n_old')
 97.     local rownames "n_pis"
 98.     foreach v in min_year n_yrs lab_spend hq_labspend tot_spend nih_amt nih_active ///
>                  lab_spend_pct_nih hq_labspend_pct_nih tot_spend_pct_nih {
 99.         qui sum `v' if young == 1, d
100.         local y_mean = r(mean)
101.         local y_p50  = r(p50)
102.         local y_N    = r(N)
103.         qui sum `v' if young == 0, d
104.         mat cons_pi = cons_pi \ (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
105.         local rownames "`rownames' `v'"
106.     }
107.     foreach v in lab_spend hq_labspend tot_spend {
108.         mat cons_pi = cons_pi \ (`agg_`v'_1', ., ., `agg_`v'_0', ., .)
109.         local rownames "`rownames' agg_`v'_pct_nih"
110.     }
111.     mat colnames cons_pi = young_mean young_p50 young_N old_mean old_p50 old_N
112.     mat rownames cons_pi = `rownames'
113.     qui matrix_to_txt, saving("../output/tables/consumables_intensity`suf'.txt") ///
>         matrix(cons_pi) title(<tab:consumables_intensity`suf'>) format(%14.4f) replace
114. 
.     kd_young_old lab_spend_pct_nih, ///
>         xtitle(Avg annual lab consumables spend as % of NIH funding, 2010-2013) ///
>         w(1) wlab("1pp") unit(PIs) fmt(%9.2f) ///
>         out(../output/figures/kd_lab_spend_pct_nih_by_age`suf'.pdf)
115.     kd_young_old hq_labspend_pct_nih, ///
>         xtitle(Avg annual high-confidence lab spend as % of NIH funding, 2010-2013) ///
>         w(1) wlab("1pp") unit(PIs) fmt(%9.2f) ///
>         out(../output/figures/kd_hq_labspend_pct_nih_by_age`suf'.pdf)
116. 
.     gen double ln_lab_spend_pct_nih = ln(lab_spend_pct_nih) if lab_spend_pct_nih > 0
117.     foreach v in lab_spend_pct_nih hq_labspend_pct_nih ln_lab_spend_pct_nih {
118.         if "`v'" == "lab_spend_pct_nih"    local ytitle "Lab consumables spend as % of NIH funding"
119.         if "`v'" == "hq_labspend_pct_nih"  local ytitle "High-confidence lab spend as % of NIH funding"
120.         if "`v'" == "ln_lab_spend_pct_nih" local ytitle "Log lab consumables spend as % of NIH funding"
121.         bs_stats, y(`v') x(lab_age_2014) ///
>             xtitle(Lab age in 2014 (yrs since first last-author pub)) ///
>             ytitle(`ytitle') ///
>             out(../output/figures/bs_`v'_by_age`suf'.pdf)
122.     }
123. end

