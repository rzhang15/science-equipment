. program gather_nih
  1.     use athr_id grant_id full_project_num fy total_cost_pi project_start ///
>         using ../external/nih/nih_grants_by_athr_id, clear
  2.     duplicates drop athr_id grant_id, force
  3.     gen double amt = total_cost_pi
  4.     bys athr_id fy full_project_num: gen byte proj = _n == 1
  5.     gen byte new_grant = proj & year(project_start) == fy
  6.     gcollapse (sum) nih_amt        = amt ///
>               (sum) nih_active     = proj ///
>               (sum) nih_new_grants = new_grant, by(athr_id fy) fast
  7.     rename fy year
  8.     save ../temp/nih_athr_yr, replace
  9. 
.     keep if inrange(year, 2010, 2013)
 10.     preserve
 11.         collapse (sum) nih_amt nih_active nih_new_grants, by(athr_id)
 12.         gen double nih_amt_yr    = nih_amt        / 4
 13.         gen double nih_active_yr = nih_active     / 4
 14.         gen double nih_new_yr    = nih_new_grants / 4
 15.         keep athr_id nih_amt_yr nih_active_yr nih_new_yr
 16.         save ../temp/nih_pre_amt, replace
 17.     restore
 18.     bys athr_id: keep if _n == 1
 19.     keep athr_id
 20.     save ../temp/nih_pre_pis, replace
 21. end

