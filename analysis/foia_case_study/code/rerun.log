. program nih_by_age_piyr
  1.     syntax, samp(string) [suf(string)]
  2. 
.     use ../temp/nih_age_pis_`samp'`suf', clear
  3.     qui sum min_year, d
  4.     local med_yr = r(p50)
  5.     keep if nih_matched == 1
  6.     merge 1:1 athr_id using ../temp/nih_pre_pis, keep(3) nogen
  7.     expand 4
  8.     bys athr_id: gen int year = 2009 + _n
  9.     merge 1:1 athr_id year using ../temp/nih_athr_yr, keep(1 3) nogen
 10.     foreach v in nih_amt nih_active nih_new_grants {
 11.         replace `v' = 0 if mi(`v')
 12.     }
 13. 
.     gen young = min_year > `med_yr' if !mi(min_year)
 14.     egen _tag = tag(athr_id)
 15.     qui count if _tag & young == 1
 16.     local npi_y = r(N)
 17.     qui count if _tag & young == 0
 18.     local npi_o = r(N)
 19.     drop _tag
 20.     di as text "nih_by_age_piyr `samp'`suf': median min_year = `med_yr'; PIs young/old = `npi_y'/`npi_o'"
 21. 
.     keep athr_id year min_year lab_age_2014 young nih_amt nih_active nih_new_grants
 22.     save ../output/nih_by_age_piyrs_`samp'`suf', replace
 23. 
.     cap mat drop nih_age_piyr
 24.     qui count if young == 1
 25.     local nyr_y = r(N)
 26.     qui count if young == 0
 27.     local nyr_o = r(N)
 28.     foreach g in 1 0 {
 29.         qui count if young == `g' & nih_amt == 0
 30.         local nzero_`g' = r(N)
 31.     }
 32.     mat nih_age_piyr = (`npi_y', ., `npi_y', `npi_o', ., `npi_o')
 33.     mat nih_age_piyr = nih_age_piyr \ (`nyr_y', ., `nyr_y', `nyr_o', ., `nyr_o')
 34.     mat nih_age_piyr = nih_age_piyr \ (`nzero_1', ., `nzero_1', `nzero_0', ., `nzero_0')
 35.     local rownames "n_pis n_pi_yrs n_pi_yrs_zero"
 36.     foreach v in nih_amt nih_active nih_new_grants {
 37.         qui sum `v' if young == 1, d
 38.         local y_mean = r(mean)
 39.         local y_p50  = r(p50)
 40.         local y_N    = r(N)
 41.         qui sum `v' if young == 0, d
 42.         mat nih_age_piyr = nih_age_piyr \ ///
>             (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
 43.         local rownames "`rownames' `v'"
 44.     }
 45.     mat colnames nih_age_piyr = young_mean young_p50 young_N old_mean old_p50 old_N
 46.     mat rownames nih_age_piyr = `rownames'
 47.     qui matrix_to_txt, saving("../output/tables/nih_by_age_piyr_`samp'`suf'.txt") ///
>         matrix(nih_age_piyr) title(<tab:nih_by_age_piyr_`samp'`suf'>) format(%14.2f) replace
 48. 
.     kd_young_old nih_amt, xtitle(Annual NIH funding ($, PI-year)) ///
>         w(100000) wlab("$100,000") unit(PI-years) cluster(athr_id) ///
>         out(../output/figures/kd_nih_amt_by_age_piyr_`samp'`suf'.pdf)
 49.     kd_young_old nih_active, xtitle(# active NIH grants (PI-year)) ///
>         w(1) wlab("1 grant") unit(PI-years) fmt(%9.2f) cluster(athr_id) ///
>         out(../output/figures/kd_nih_active_by_age_piyr_`samp'`suf'.pdf)
 50. end

