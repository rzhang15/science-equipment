. program pubs_by_age
  1.     syntax, samp(string) [suf(string)]
  2.     cap mkdir ../output/tables
  3.     cap mkdir ../output/figures
  4. 
.     use ../temp/pubs_pre_pis`suf', clear
  5.     if "`samp'" == "foia" keep if foia_athr == 1
  6.     drop foia_athr nih_matched
  7. 
.     qui sum min_year, d
  8.     local med_yr = r(p50)
  9.     gen young = min_year > `med_yr' if !mi(min_year)
 10.     qui count
 11.     di as text "pubs_by_age `samp'`suf': `r(N)' PIs, median min_year = `med_yr' (young = after median)"
 12. 
.     save ../output/pubs_by_age_pis_`samp'`suf', replace
 13. 
.     cap mat drop pubs_age
 14.     qui count if young == 1
 15.     local n_young = r(N)
 16.     qui count if young == 0
 17.     local n_old = r(N)
 18.     mat pubs_age = (`n_young', ., `n_young', `n_old', ., `n_old')
 19.     local rownames "n_pis"
 20.     foreach v in min_year pre_ppr_sum pre_ppr_avg pre_ppr_any_sum pre_ppr_any_avg {
 21.         qui sum `v' if young == 1, d
 22.         local y_mean = r(mean)
 23.         local y_p50  = r(p50)
 24.         local y_N    = r(N)
 25.         qui sum `v' if young == 0, d
 26.         mat pubs_age = nullmat(pubs_age) \ ///
>             (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
 27.         local rownames "`rownames' `v'"
 28.     }
 29.     mat colnames pubs_age = young_mean young_p50 young_N old_mean old_p50 old_N
 30.     mat rownames pubs_age = `rownames'
 31.     qui matrix_to_txt, saving("../output/tables/pubs_by_age_`samp'`suf'.txt") ///
>         matrix(pubs_age) title(<tab:pubs_by_age_`samp'`suf'>) format(%14.2f) replace
 32. 
.     kd_young_old pre_ppr_sum, xtitle(Total pubs 2010-2013) ///
>         w(2) wlab("2 pubs") unit(PIs) fmt(%9.1f) ///
>         out(../output/figures/kd_pre_ppr_sum_by_age_`samp'`suf'.pdf)
 33.     kd_young_old pre_ppr_avg, xtitle(Avg pubs per year, 2010-2013) ///
>         w(0.5) wlab("0.5 pubs") unit(PIs) fmt(%9.2f) ///
>         out(../output/figures/kd_pre_ppr_avg_by_age_`samp'`suf'.pdf)
 34.     kd_young_old pre_ppr_any_sum, xtitle(Total pubs 2010-2013 (any position)) ///
>         w(5) wlab("5 pubs") unit(PIs) fmt(%9.1f) ///
>         out(../output/figures/kd_pre_ppr_any_sum_by_age_`samp'`suf'.pdf)
 35.     kd_young_old pre_ppr_any_avg, xtitle(Avg pubs per year, 2010-2013 (any position)) ///
>         w(1) wlab("1 pub") unit(PIs) fmt(%9.2f) ///
>         out(../output/figures/kd_pre_ppr_any_avg_by_age_`samp'`suf'.pdf)
 36. 
.     foreach v in pre_ppr_sum pre_ppr_avg pre_ppr_any_sum pre_ppr_any_avg {
 37.         if "`v'" == "pre_ppr_sum"      local ytitle "Total pubs 2010-2013 (last author)"
 38.         if "`v'" == "pre_ppr_avg"      local ytitle "Avg pubs per year, 2010-2013 (last author)"
 39.         if "`v'" == "pre_ppr_any_sum"  local ytitle "Total pubs 2010-2013 (any position)"
 40.         if "`v'" == "pre_ppr_any_avg"  local ytitle "Avg pubs per year, 2010-2013 (any position)"
 41.         bs_stats, y(`v') x(lab_age_2014) ///
>             xtitle(Lab age in 2014 (yrs since first last-author pub)) ///
>             ytitle(`ytitle') ///
>             out(../output/figures/bs_`v'_by_age_`samp'`suf'.pdf)
 42.     }
 43. end

. 
. program prod_per_dollar
  1.     syntax, samp(string) [suf(string)]
  2.     cap mkdir ../output/tables
  3.     cap mkdir ../output/figures
  4. 
.     use ../temp/pubs_pre_pis`suf', clear
  5.     if "`samp'" == "foia" keep if foia_athr == 1
  6.     qui count
  7.     local n_start = r(N)
  8. 
.     qui sum min_year, d
  9.     local med_yr = r(p50)
 10.     gen young = min_year > `med_yr' if !mi(min_year)
 11. 
.     keep if nih_matched == 1
 12.     qui count
 13.     local n_match = r(N)
 14.     merge 1:1 athr_id using ../temp/nih_pre_amt, keep(1 3)
 15.     qui count if _merge == 3
 16.     local n_grant = r(N)
 17.     keep if _merge == 3 & nih_amt_yr > 0
 18.     drop _merge
 19.     qui count
 20.     local n_pos = r(N)
 21. 
.     keep if nih_amt_yr >= 10000
 22.     qui count
 23.     local n_floor = r(N)
 24. 
.     local dvars nih_amt_yr
 25.     if "`samp'" == "foia" {
 26.         merge 1:1 athr_id using ../temp/spend_pi_avg, keep(3) nogen
 27.         keep if tot_spend >= 1000
 28.         gen double comb_dollars_yr = nih_amt_yr + tot_spend
 29.         local dvars nih_amt_yr tot_spend comb_dollars_yr
 30.     }
 31.     qui count
 32.     local n_kept = r(N)
 33.     di as text "prod_per_dollar `samp'`suf': `n_start' PIs -> `n_match' NIH-matched -> " ///
>         "`n_grant' with 2010-2013 grants -> `n_pos' with positive funding -> " ///
>         "`n_floor' above the $10k/yr floor -> `n_kept' kept"
 34.     di as text "prod_per_dollar `samp'`suf': median min_year = `med_yr' (young = after median)"
 35. 
.     gen double ppr_per_100k_nih     = pre_ppr_avg     / (nih_amt_yr / 100000)
 36.     gen double ppr_any_per_100k_nih = pre_ppr_any_avg / (nih_amt_yr / 100000)
 37.     gen double nih_per_ppr          = nih_amt_yr / pre_ppr_avg if pre_ppr_avg > 0
 38.     local vars ppr_per_100k_nih ppr_any_per_100k_nih nih_per_ppr
 39.     if "`samp'" == "foia" {
 40.         gen double ppr_per_10k_spend  = pre_ppr_avg / (tot_spend / 10000)
 41.         gen double spend_per_ppr      = tot_spend   / pre_ppr_avg if pre_ppr_avg > 0
 42.         gen double ppr_per_100k_comb  = pre_ppr_avg / (comb_dollars_yr / 100000)
 43.         gen double comb_per_ppr       = comb_dollars_yr / pre_ppr_avg if pre_ppr_avg > 0
 44.         local vars `vars' ppr_per_10k_spend spend_per_ppr ppr_per_100k_comb comb_per_ppr
 45.     }
 46. 
.     * Section 5.1: pooled dollars/publications and the untrimmed PI ratio tail.
.     quietly summarize nih_amt_yr
 47.     local funding = r(sum)
 48.     quietly summarize pre_ppr_avg
 49.     local nih_per_paper = `funding' / r(sum)
 50.     quietly summarize nih_per_ppr, detail
 51.     local p1 = r(p1)
 52.     local n_ratios = r(N)
 53.     quietly count if nih_per_ppr > 10500 & !mi(nih_per_ppr)
 54.     local share_above = r(N) / `n_ratios'
 55.     tempname stats
 56.     file open `stats' using ../output/tables/section51_`samp'`suf'.csv, write replace
 57.     file write `stats' "nih_per_paper,p1,share_above_10500,n_ratios" _n
 58.     file write `stats' %21.10f (`nih_per_paper') "," %21.10f (`p1') "," ///
>         %21.10f (`share_above') "," %9.0f (`n_ratios') _n
 59.     file close `stats'
 60. 
.     save ../output/prod_per_dollar_pis_`samp'`suf', replace
 61. 
.     local aggnm  ppr_per_100k_nih ppr_any_per_100k_nih
 62.     local aggnum pre_ppr_avg      pre_ppr_any_avg
 63.     local aggden nih_amt_yr       nih_amt_yr
 64.     local aggscl 100000           100000
 65.     if "`samp'" == "foia" {
 66.         local aggnm  `aggnm'  ppr_per_10k_spend ppr_per_100k_comb
 67.         local aggnum `aggnum' pre_ppr_avg       pre_ppr_avg
 68.         local aggden `aggden' tot_spend         comb_dollars_yr
 69.         local aggscl `aggscl' 10000             100000
 70.     }
 71.     local nagg : word count `aggnm'
 72.     forvalues i = 1/`nagg' {
 73.         local nm : word `i' of `aggnm'
 74.         local nu : word `i' of `aggnum'
 75.         local de : word `i' of `aggden'
 76.         local sc : word `i' of `aggscl'
 77.         foreach g in 1 0 {
 78.             qui sum `nu' if young == `g'
 79.             local num = r(sum)
 80.             qui sum `de' if young == `g'
 81.             local agg_`nm'_`g' = `num' / r(sum) * `sc'
 82.         }
 83.     }
 84. 
.     foreach v of local vars {
 85.         qui sum `v', d
 86.         qui replace `v' = r(p99) if `v' > r(p99) & !mi(`v')
 87.     }
 88. 
.     cap mat drop prod
 89.     qui count if young == 1
 90.     local n_young = r(N)
 91.     qui count if young == 0
 92.     local n_old = r(N)
 93.     mat prod = (`n_young', ., `n_young', `n_old', ., `n_old')
 94.     local rownames "n_pis"
 95.     foreach v in min_year pre_ppr_avg pre_ppr_any_avg `dvars' `vars' {
 96.         qui sum `v' if young == 1, d
 97.         local y_mean = r(mean)
 98.         local y_p50  = r(p50)
 99.         local y_N    = r(N)
100.         qui sum `v' if young == 0, d
101.         mat prod = nullmat(prod) \ ///
>             (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
102.         local rownames "`rownames' `v'"
103.     }
104.     forvalues i = 1/`nagg' {
105.         local nm : word `i' of `aggnm'
106.         mat prod = prod \ (`agg_`nm'_1', ., ., `agg_`nm'_0', ., .)
107.         local rownames "`rownames' agg_`nm'"
108.     }
109.     mat colnames prod = young_mean young_p50 young_N old_mean old_p50 old_N
110.     mat rownames prod = `rownames'
111.     qui matrix_to_txt, saving("../output/tables/prod_per_dollar_`samp'`suf'.txt") ///
>         matrix(prod) title(<tab:prod_per_dollar_`samp'`suf'>) format(%14.4f) replace
112. 
.     kd_young_old ppr_per_100k_nih, ///
>         xtitle(Pubs per year per $100k NIH funding, 2010-2013) ///
>         w(0.5) wlab("0.5 pubs") unit(PIs) fmt(%9.2f) ///
>         out(../output/figures/kd_ppr_per_100k_nih_`samp'`suf'.pdf)
113.     kd_young_old ppr_any_per_100k_nih, ///
>         xtitle(Pubs per year per $100k NIH funding, 2010-2013 (any position)) ///
>         w(1) wlab("1 pub") unit(PIs) fmt(%9.2f) ///
>         out(../output/figures/kd_ppr_any_per_100k_nih_`samp'`suf'.pdf)
114.     if "`samp'" == "foia" {
115.         kd_young_old ppr_per_10k_spend, ///
>             xtitle(Pubs per year per $10k FOIA spend, 2010-2013) ///
>             w(0.5) wlab("0.5 pubs") unit(PIs) fmt(%9.2f) ///
>             out(../output/figures/kd_ppr_per_10k_spend_`samp'`suf'.pdf)
116.         kd_young_old ppr_per_100k_comb, ///
>             xtitle(Pubs per year per $100k NIH + FOIA, 2010-2013) ///
>             w(0.5) wlab("0.5 pubs") unit(PIs) fmt(%9.2f) ///
>             out(../output/figures/kd_ppr_per_100k_comb_`samp'`suf'.pdf)
117.     }
118. 
.     foreach v of local vars {
119.         if "`v'" == "ppr_per_100k_nih"     local ytitle "Pubs per yr per $100k NIH (last author)"
120.         if "`v'" == "ppr_any_per_100k_nih" local ytitle "Pubs per yr per $100k NIH (any position)"
121.         if "`v'" == "nih_per_ppr"          local ytitle "NIH $ per pub"
122.         if "`v'" == "ppr_per_10k_spend"     local ytitle "Pubs per yr per $10k FOIA spend"
123.         if "`v'" == "spend_per_ppr"         local ytitle "FOIA $ per pub"
124.         if "`v'" == "ppr_per_100k_comb"     local ytitle "Pubs per yr per $100k NIH + FOIA"
125.         if "`v'" == "comb_per_ppr"          local ytitle "NIH + FOIA $ per pub"
126.         bs_stats, y(`v') x(lab_age_2014) ///
>             xtitle(Lab age in 2014 (yrs since first last-author pub)) ///
>             ytitle(`ytitle') ///
>             out(../output/figures/bs_`v'_by_age_`samp'`suf'.pdf)
127.     }
128. end

. 
. program bs_stats
  1.     syntax, y(string) x(string) ytitle(string) xtitle(string) out(string)
  2.     qui reg `y' `x'
  3.     local b_s  = strtrim("`: di %12.4g _b[`x']'")
  4.     local se_s = strtrim("`: di %12.4g _se[`x']'")
  5.     qui corr `y' `x'
  6.     local r_s = strtrim("`: di %5.3f r(rho)'")
  7.     local n_s = r(N)
  8.     binscatter `y' `x', n(20) msymbol(O) mcolors(gs6) lcolors(ebblue) ///
>         xtitle("`xtitle'") ytitle("`ytitle'") ///
>         legend(on order(- "Slope = `b_s' (SE: `se_s')" "Corr = `r_s', N = `n_s'") ///
>             pos(1) ring(0) region(fcolor(none)) size(small)) ///
>         plotregion(margin(sides))
  9.     fig_export, path("`out'")
 10. end

. 
. program spend_by_age
  1.     syntax [, suf(string)]
  2.     cap mkdir ../output/tables
  3.     cap mkdir ../output/figures
  4. 
.     use ../external/pi_samp/pi_desc_all_jrnls_r1_r2`suf', clear
  5.     keep if athr_indicator == 1 & foia_athr == 1
  6.     gen lab_age_2014 = 2014 - min_year
  7.     keep athr_id min_year lab_age_2014
  8.     save ../temp/foia_pi_age`suf', replace
  9. 
.     use ../external/samp/merged_foias_with_pis, clear
 10.     drop if mi(athr_id)
 11.     gen year = year(date(date, "YMD"))
 12.     drop if year > 2013
 13.     merge m:1 category using ../external/categories/categories_tfidf, keep(1 3)
 14.     rename _merge nonlab
 15.     replace nonlab = 0 if nonlab == 3
 16.     replace keep = 2 if keep == .
 17.     gen hq = keep == 1 | (bad_control == 1 & support >= 25 & precision >= 0.8 & recall >= 0.8)
 18.     gen nonlab_spend = spend if nonlab == 1
 19.     gen lab_spend    = spend if nonlab == 0
 20.     gen hq_labspend  = lab_spend if hq == 1
 21.     collapse (sum) tot_spend = spend nonlab_spend lab_spend hq_labspend, by(athr_id year)
 22.     gen perc_lab_spend = lab_spend / tot_spend * 100
 23.     save ../temp/spend_athr_yr, replace
 24.     collapse (mean) tot_spend nonlab_spend lab_spend hq_labspend perc_lab_spend ///
>              (count) n_yrs = year, by(athr_id)
 25.     save ../temp/spend_pi_avg, replace
 26. 
.     merge 1:1 athr_id using ../temp/foia_pi_age`suf', keep(1 3)
 27.     qui count
 28.     local n_all = r(N)
 29.     qui count if _merge == 3
 30.     local n_aged = r(N)
 31.     di as text "spend_by_age`suf': `n_aged' of `n_all' FOIA PIs with spend data matched to analysis-sample age"
 32.     keep if _merge == 3
 33.     drop _merge
 34. 
.     qui sum min_year, d
 35.     local med_yr = r(p50)
 36.     gen young = min_year > `med_yr' if !mi(min_year)
 37.     di as text "spend_by_age`suf': median min_year = `med_yr' (young = after median)"
 38. 
.     preserve
 39.         keep athr_id min_year lab_age_2014 young tot_spend lab_spend nonlab_spend ///
>              hq_labspend perc_lab_spend n_yrs
 40.         save ../output/spend_by_age_pis`suf', replace
 41.     restore
 42. 
.     cap mat drop spend_age
 43.     qui count if young == 1
 44.     local n_young = r(N)
 45.     qui count if young == 0
 46.     local n_old = r(N)
 47.     mat spend_age = (`n_young', ., `n_young', `n_old', ., `n_old')
 48.     local rownames "n_pis"
 49.     foreach v in min_year tot_spend lab_spend nonlab_spend hq_labspend perc_lab_spend n_yrs {
 50.         qui sum `v' if young == 1, d
 51.         local y_mean = r(mean)
 52.         local y_p50  = r(p50)
 53.         local y_N    = r(N)
 54.         qui sum `v' if young == 0, d
 55.         mat spend_age = nullmat(spend_age) \ ///
>             (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
 56.         local rownames "`rownames' `v'"
 57.     }
 58.     mat colnames spend_age = young_mean young_p50 young_N old_mean old_p50 old_N
 59.     mat rownames spend_age = `rownames'
 60.     qui matrix_to_txt, saving("../output/tables/spend_by_age`suf'.txt") ///
>         matrix(spend_age) title(<tab:spend_by_age`suf'>) format(%14.2f) replace
 61. 
.     foreach v in tot_spend lab_spend hq_labspend nonlab_spend perc_lab_spend {
 62.         if "`v'" == "tot_spend"      local xtitle "Avg annual total spend ($)"
 63.         if "`v'" == "lab_spend"      local xtitle "Avg annual lab spend ($)"
 64.         if "`v'" == "hq_labspend"    local xtitle "Avg annual high-confidence lab spend ($)"
 65.         if "`v'" == "nonlab_spend"   local xtitle "Avg annual non-lab spend ($)"
 66.         if "`v'" == "perc_lab_spend" local xtitle "Lab share of spend (%)"
 67.         local w 5000
 68.         local wlab "$5,000"
 69.         if "`v'" == "perc_lab_spend" {
 70.             local w 5
 71.             local wlab "5pp"
 72.         }
 73.         qui sum `v', d
 74.         local xcap = r(p95)
 75.         if "`v'" == "perc_lab_spend" local xcap = 100
 76. 
.         qui sum `v' if young == 1, d
 77.         local mean_y = strtrim("`: di %9.0fc r(mean)'")
 78.         local n_y    = r(N)
 79.         qui sum `v' if young == 0, d
 80.         local mean_o = strtrim("`: di %9.0fc r(mean)'")
 81.         local n_o    = r(N)
 82. 
.         kd_tests `v'
 83.         local diff = strtrim("`: di %9.0fc r(diff)'")
 84.         local p_t  = r(p_t)
 85.         local p_ks = r(p_ks)
 86.         pfmt `p_t'
 87.         local pt_s `r(s)'
 88.         pfmt `p_ks'
 89.         local pks_s `r(s)'
 90.         local ptxt "Early-career - late-career = `diff'; t-test p = `pt_s'; K-S p = `pks_s'"
 91.         di as text "`v': `ptxt'"
 92. 
.         preserve
 93.         if _N < 200 qui set obs 200
 94.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 95.         kdensity `v' if young == 1 & `v' <= `xcap', at(_kx) gen(_kd_y) nograph
 96.         kdensity `v' if young == 0 & `v' <= `xcap', at(_kx) gen(_kd_o) nograph
 97.         gen _kp_y = _kd_y * `w' * 100
 98.         gen _kp_o = _kd_o * `w' * 100
 99.         gen _kp_c = min(_kp_y, _kp_o)
100.         tw (rarea _kp_c _kp_y _kx, color(ebblue*0.3) lwidth(none)) ///
>            (rarea _kp_c _kp_o _kx, color(dkorange*0.3) lwidth(none)) ///
>            (line _kp_y _kx, lcolor(ebblue)) ///
>            (line _kp_o _kx, lcolor(dkorange)), ///
>            xtitle("`xtitle'") ytitle("Percent of PIs (per `wlab' bin)") ///
>            legend(order(3 "Early-career (N=`n_y'): mean=`mean_y'" ///
>                         4 "Late-career (N=`n_o'): mean=`mean_o'") ///
>                pos(1) ring(0) cols(1) size(small) region(fcolor(none))) ///
>            note("`ptxt'", size(small)) ///
>            plotregion(margin(sides))
101.         fig_export, path("../output/figures/kd_`v'_by_age`suf'.pdf")
102.         restore
103.     }
104. 
.     gen double ln_lab_spend = ln(lab_spend) if lab_spend > 0
105.     gen double ln_tot_spend = ln(tot_spend) if tot_spend > 0
106.     foreach v in lab_spend hq_labspend tot_spend ln_lab_spend ln_tot_spend {
107.         if "`v'" == "lab_spend"    local ytitle "Avg annual lab spend ($)"
108.         if "`v'" == "hq_labspend"  local ytitle "Avg annual high-confidence lab spend ($)"
109.         if "`v'" == "tot_spend"    local ytitle "Avg annual total spend ($)"
110.         if "`v'" == "ln_lab_spend" local ytitle "Log avg annual lab spend"
111.         if "`v'" == "ln_tot_spend" local ytitle "Log avg annual total spend"
112.         bs_stats, y(`v') x(lab_age_2014) ///
>             xtitle(Lab age in 2014 (yrs since first last-author pub)) ///
>             ytitle(`ytitle') ///
>             out(../output/figures/bs_`v'_by_age`suf'.pdf)
113.     }
114. end

. 
. program spend_by_age_piyr
  1.     syntax [, suf(string)]
  2.     use ../temp/spend_athr_yr, clear
  3.     merge m:1 athr_id using ../temp/foia_pi_age`suf', keep(3) nogen
  4. 
.     egen _tag = tag(athr_id)
  5.     qui sum min_year if _tag, d
  6.     local med_yr = r(p50)
  7.     gen young = min_year > `med_yr' if !mi(min_year)
  8.     qui count if _tag & young == 1
  9.     local npi_y = r(N)
 10.     qui count if _tag & young == 0
 11.     local npi_o = r(N)
 12.     drop _tag
 13.     di as text "spend_by_age_piyr`suf': median min_year = `med_yr'; PIs young/old = `npi_y'/`npi_o'"
 14. 
.     preserve
 15.         keep athr_id year min_year lab_age_2014 young tot_spend lab_spend nonlab_spend ///
>              hq_labspend perc_lab_spend
 16.         save ../output/spend_by_age_piyrs`suf', replace
 17.     restore
 18. 
.     cap mat drop spend_age_piyr
 19.     qui count if young == 1
 20.     local nyr_y = r(N)
 21.     qui count if young == 0
 22.     local nyr_o = r(N)
 23.     mat spend_age_piyr = (`npi_y', ., `npi_y', `npi_o', ., `npi_o')
 24.     mat spend_age_piyr = spend_age_piyr \ (`nyr_y', ., `nyr_y', `nyr_o', ., `nyr_o')
 25.     local rownames "n_pis n_pi_yrs"
 26.     foreach v in tot_spend lab_spend nonlab_spend hq_labspend perc_lab_spend {
 27.         qui sum `v' if young == 1, d
 28.         local y_mean = r(mean)
 29.         local y_p50  = r(p50)
 30.         local y_N    = r(N)
 31.         qui sum `v' if young == 0, d
 32.         mat spend_age_piyr = spend_age_piyr \ ///
>             (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
 33.         local rownames "`rownames' `v'"
 34.     }
 35.     mat colnames spend_age_piyr = young_mean young_p50 young_N old_mean old_p50 old_N
 36.     mat rownames spend_age_piyr = `rownames'
 37.     qui matrix_to_txt, saving("../output/tables/spend_by_age_piyr`suf'.txt") ///
>         matrix(spend_age_piyr) title(<tab:spend_by_age_piyr`suf'>) format(%14.2f) replace
 38. 
.     foreach v in tot_spend lab_spend hq_labspend nonlab_spend perc_lab_spend {
 39.         if "`v'" == "tot_spend"      local xtitle "Annual total spend ($, PI-year)"
 40.         if "`v'" == "lab_spend"      local xtitle "Annual lab spend ($, PI-year)"
 41.         if "`v'" == "hq_labspend"    local xtitle "Annual high-confidence lab spend ($, PI-year)"
 42.         if "`v'" == "nonlab_spend"   local xtitle "Annual non-lab spend ($, PI-year)"
 43.         if "`v'" == "perc_lab_spend" local xtitle "Lab share of spend (%, PI-year)"
 44.         local w 5000
 45.         local wlab "$5,000"
 46.         if "`v'" == "perc_lab_spend" {
 47.             local w 5
 48.             local wlab "5pp"
 49.         }
 50.         qui sum `v', d
 51.         local xcap = r(p95)
 52.         if "`v'" == "perc_lab_spend" local xcap = 100
 53. 
.         qui sum `v' if young == 1, d
 54.         local mean_y = strtrim("`: di %9.0fc r(mean)'")
 55.         local n_y    = r(N)
 56.         qui sum `v' if young == 0, d
 57.         local mean_o = strtrim("`: di %9.0fc r(mean)'")
 58.         local n_o    = r(N)
 59. 
.         kd_tests `v', cluster(athr_id)
 60.         local diff = strtrim("`: di %9.0fc r(diff)'")
 61.         local p_t  = r(p_t)
 62.         local p_ks = r(p_ks)
 63.         pfmt `p_t'
 64.         local pt_s `r(s)'
 65.         pfmt `p_ks'
 66.         local pks_s `r(s)'
 67.         local ptxt "Early-career - late-career = `diff'; t-test p = `pt_s' (PI-clustered); K-S p = `pks_s'"
 68.         di as text "`v': `ptxt'"
 69. 
.         preserve
 70.         if _N < 200 qui set obs 200
 71.         gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 72.         kdensity `v' if young == 1 & `v' <= `xcap', at(_kx) gen(_kd_y) nograph
 73.         kdensity `v' if young == 0 & `v' <= `xcap', at(_kx) gen(_kd_o) nograph
 74.         gen _kp_y = _kd_y * `w' * 100
 75.         gen _kp_o = _kd_o * `w' * 100
 76.         tw (line _kp_y _kx, lcolor(ebblue)) ///
>            (line _kp_o _kx, lcolor(dkorange)), ///
>            xtitle("`xtitle'") ytitle("Percent of PI-years (per `wlab' bin)") ///
>            legend(order(1 "Early-career (N=`n_y', PIs=`npi_y'): mean=`mean_y'" ///
>                         2 "Late-career (N=`n_o', PIs=`npi_o'): mean=`mean_o'") ///
>                pos(1) ring(0) cols(1) size(small) region(fcolor(none))) ///
>            note("`ptxt'", size(small)) ///
>            plotregion(margin(sides))
 77.         fig_export, path("../output/figures/kd_`v'_by_age_piyr`suf'.pdf")
 78.         restore
 79.     }
 80. end

