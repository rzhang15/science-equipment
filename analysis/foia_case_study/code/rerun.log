. program nih_by_age
  1.     syntax, samp(string) [suf(string)]
  2.     cap mkdir ../output/tables
  3.     cap mkdir ../output/figures
  4. 
.     use ../external/pi_samp/pi_desc_all_jrnls_r1_r2`suf', clear
  5.     keep if athr_indicator == 1
  6.     if "`samp'" == "foia" keep if foia_athr == 1
  7.     gen byte nih_matched = !mi(nih_pi_name)
  8.     gen lab_age_2014 = 2014 - min_year
  9.     keep athr_id min_year lab_age_2014 nih_matched
 10.     save ../temp/nih_age_pis_`samp'`suf', replace
 11. 
.     use ../temp/nih_pre_amt, clear
 12.     merge 1:1 athr_id using ../temp/nih_age_pis_`samp'`suf', keep(2 3)
 13.     qui count
 14.     local n_pis = r(N)
 15.     qui count if nih_matched == 1
 16.     local n_match = r(N)
 17.     qui count if _merge == 3
 18.     local n_grants_pi = r(N)
 19.     di as text "nih_by_age `samp'`suf': `n_pis' PIs, `n_match' matched to RePORTER, " ///
>         "`n_grants_pi' with grant records in 2010-2013"
 20. 
.     qui sum min_year, d
 21.     local med_yr = r(p50)
 22.     gen young = min_year > `med_yr' if !mi(min_year)
 23.     di as text "nih_by_age `samp'`suf': median min_year (first last-author yr) = `med_yr' (young = after median)"
 24. 
.     foreach g in 1 0 {
 25.         qui count if young == `g'
 26.         local n_samp_`g' = r(N)
 27.         qui count if young == `g' & nih_matched == 0
 28.         local n_drop_`g' = r(N)
 29.         qui count if young == `g' & nih_matched == 1 & _merge == 2
 30.         local n_nogrant_`g' = r(N)
 31.     }
 32. 
.     keep if nih_matched == 1 & _merge == 3
 33.     drop _merge
 34.     save ../output/nih_by_age_pis_`samp'`suf', replace
 35. 
.     cap mat drop nih_age
 36.     qui count if young == 1
 37.     local n_young = r(N)
 38.     qui count if young == 0
 39.     local n_old = r(N)
 40.     foreach g in 1 0 {
 41.         qui count if young == `g' & nih_amt_yr == 0
 42.         local n_zero_`g' = r(N)
 43.     }
 44.     mat nih_age = (`n_samp_1', ., `n_samp_1', `n_samp_0', ., `n_samp_0')
 45.     mat nih_age = nih_age \ (`n_drop_1', ., `n_drop_1', `n_drop_0', ., `n_drop_0')
 46.     mat nih_age = nih_age \ ///
>         (`n_nogrant_1', ., `n_nogrant_1', `n_nogrant_0', ., `n_nogrant_0')
 47.     mat nih_age = nih_age \ (`n_young', ., `n_young', `n_old', ., `n_old')
 48.     mat nih_age = nih_age \ (`n_zero_1', ., `n_zero_1', `n_zero_0', ., `n_zero_0')
 49.     local rownames "n_pis_sample n_pis_unmatched_dropped n_pis_nopregrant_dropped"
 50.     local rownames "`rownames' n_pis_kept n_pis_zero_amt"
 51.     foreach v in min_year nih_amt_yr nih_active_yr nih_new_yr {
 52.         qui sum `v' if young == 1, d
 53.         local y_mean = r(mean)
 54.         local y_p50  = r(p50)
 55.         local y_N    = r(N)
 56.         qui sum `v' if young == 0, d
 57.         mat nih_age = nullmat(nih_age) \ ///
>             (`y_mean', `y_p50', `y_N', r(mean), r(p50), r(N))
 58.         local rownames "`rownames' `v'"
 59.     }
 60.     mat colnames nih_age = young_mean young_p50 young_N old_mean old_p50 old_N
 61.     mat rownames nih_age = `rownames'
 62.     qui matrix_to_txt, saving("../output/tables/nih_by_age_`samp'`suf'.txt") ///
>         matrix(nih_age) title(<tab:nih_by_age_`samp'`suf'>) format(%14.2f) replace
 63. 
.     kd_young_old nih_amt_yr, xtitle(Avg annual NIH funding, 2010-2013 ($)) ///
>         w(100000) wlab("$100,000") unit(PIs) ///
>         out(../output/figures/kd_nih_amt_by_age_`samp'`suf'.pdf)
 64.     kd_young_old nih_active_yr, xtitle(Avg # active NIH grants per year, 2010-2013) ///
>         w(0.5) wlab("0.5 grants") unit(PIs) fmt(%9.2f) ///
>         out(../output/figures/kd_nih_active_by_age_`samp'`suf'.pdf)
 65. 
.     bs_stats, y(nih_amt_yr) x(lab_age_2014) ///
>         xtitle(Lab age in 2014 (yrs since first last-author pub)) ///
>         ytitle(Avg annual NIH funding, 2010-2013 ($)) ///
>         out(../output/figures/bs_nih_amt_by_age_`samp'`suf'.pdf)
 66.     bs_stats, y(nih_active_yr) x(lab_age_2014) ///
>         xtitle(Lab age in 2014 (yrs since first last-author pub)) ///
>         ytitle(Avg # active NIH grants per year, 2010-2013) ///
>         out(../output/figures/bs_nih_active_by_age_`samp'`suf'.pdf)
 67. end

