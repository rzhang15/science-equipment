. program kd_tests, rclass
  1.     syntax varname [, cluster(varname)]
  2.     local v `varlist'
  3.     if "`cluster'" == "" {
  4.         qui ttest `v', by(young) unequal
  5.         return scalar diff = r(mu_2) - r(mu_1)
  6.         return scalar p_t  = r(p)
  7.     }
  8.     else {
  9.         qui reg `v' young, cluster(`cluster')
 10.         return scalar diff = _b[young]
 11.         return scalar p_t  = 2 * ttail(e(df_r), abs(_b[young] / _se[young]))
 12.     }
 13.     qui ksmirnov `v', by(young)
 14.     return scalar p_ks = cond(mi(r(p_exact)), r(p), r(p_exact))
 15. end

. 
. program pfmt, rclass
  1.     syntax anything(name=p)
  2.     return local s = cond(`p' < 0.001, "<0.001", string(`p', "%5.3f"))
  3. end

. 
. program kd_young_old
  1.     syntax varname, xtitle(string) w(real) wlab(string) unit(string) ///
>         out(string) [xcap(real -1) fmt(string) cluster(varname)]
  2.     local v `varlist'
  3.     if "`fmt'" == "" local fmt %9.0fc
  4.     if `xcap' < 0 {
  5.         qui sum `v', d
  6.         local xcap = r(p95)
  7.     }
  8.     qui sum `v' if young == 1, d
  9.     local mean_y = strtrim("`: di `fmt' r(mean)'")
 10.     local n_y    = r(N)
 11.     qui sum `v' if young == 0, d
 12.     local mean_o = strtrim("`: di `fmt' r(mean)'")
 13.     local n_o    = r(N)
 14. 
.     if "`cluster'" != "" local clopt cluster(`cluster')
 15.     kd_tests `v', `clopt'
 16.     local diff = strtrim("`: di `fmt' r(diff)'")
 17.     local p_t  = r(p_t)
 18.     local p_ks = r(p_ks)
 19.     pfmt `p_t'
 20.     local pt_s `r(s)'
 21.     pfmt `p_ks'
 22.     local pks_s `r(s)'
 23.     if "`cluster'" != "" local ptxt "Early-career - late-career = `diff'; t-test p = `pt_s' (`cluster'-clustered); K-S p = `pks_s'"
 24.     else                 local ptxt "Early-career - late-career = `diff'; t-test p = `pt_s'; K-S p = `pks_s'"
 25.     di as text "`v': `ptxt'"
 26. 
.     preserve
 27.     if _N < 200 qui set obs 200
 28.     gen _kx = `xcap' * (_n - 1) / 199 if _n <= 200
 29.     kdensity `v' if young == 1 & `v' <= `xcap', at(_kx) gen(_kd_y) nograph
 30.     kdensity `v' if young == 0 & `v' <= `xcap', at(_kx) gen(_kd_o) nograph
 31.     gen _kp_y = _kd_y * `w' * 100
 32.     gen _kp_o = _kd_o * `w' * 100
 33.     gen _kp_c = min(_kp_y, _kp_o)
 34.     tw (rarea _kp_c _kp_y _kx, color(ebblue*0.3) lwidth(none)) ///
>        (rarea _kp_c _kp_o _kx, color(dkorange*0.3) lwidth(none)) ///
>        (line _kp_y _kx, lcolor(ebblue)) ///
>        (line _kp_o _kx, lcolor(dkorange)), ///
>        xtitle("`xtitle'") ytitle("Percent of `unit' (per `wlab' bin)") ///
>        legend(order(3 "Early-career (N=`n_y'): mean=`mean_y'" ///
>                     4 "Late-career (N=`n_o'): mean=`mean_o'") ///
>            pos(1) ring(0) cols(1) size(small) region(fcolor(none))) ///
>        note("`ptxt'", size(small)) ///
>        plotregion(margin(sides))
 35.     fig_export, path("`out'")
 36.     restore
 37. end

