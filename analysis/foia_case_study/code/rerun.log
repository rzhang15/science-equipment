. program fig_export
  1.     syntax, path(string) [mode(string) xsize(real 6) ysize(real 4)]
  2.     local p : subinstr local path "/paper/" "/", all
  3.     local p : subinstr local p "/pres/" "/", all
  4.     local k = strpos("`p'", "figures/")
  5.     if `k' > 0 {
  6.         local base = substr("`p'", 1, `k' + 7)
  7.         local rest = substr("`p'", `k' + 8, .)
  8.     }
  9.     else {
 10.         local slash = strrpos("`p'", "/")
 11.         local base = substr("`p'", 1, `slash')
 12.         local rest = substr("`p'", `slash' + 1, .)
 13.     }
 14.     local tscale = cond(`xsize' >= `ysize', (2/3) * `xsize' / min(`xsize', `ysize'), 1)
 15.     if "`mode'" == "presentation" local mode pres
 16.     foreach m in paper pres {
 17.         if "`mode'" != "" & "`mode'" != "`m'" continue
 18.         local dir "`base'`m'"
 19.         cap mkdir "`dir'"
 20.         local sub "`rest'"
 21.         while strpos("`sub'", "/") > 0 {
 22.             local seg = substr("`sub'", 1, strpos("`sub'", "/") - 1)
 23.             local dir "`dir'/`seg'"
 24.             cap mkdir "`dir'"
 25.             local sub = substr("`sub'", strpos("`sub'", "/") + 1, .)
 26.         }
 27.         local s = cond("`m'" == "pres", `tscale' * $PRES_SCALE, `tscale')
 28.         graph display, scale(`s')
 29.         graph export "`base'`m'/`rest'", replace
 30.     }
 31. end

