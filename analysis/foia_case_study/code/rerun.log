. program gather_pubs
  1.     syntax [, suf(string)]
  2.     use athr_id year min_year athr_indicator foia_athr nih_pi_name ppr_cnt_any ///
>         pre_ppr_cnt_sum pre_ppr_cnt_avg ///
>         using ../external/pi_samp/pi_desc_all_jrnls_r1_r2`suf', clear
  3.     gen lab_age_2014 = 2014 - min_year
  4.     gen pre_any = ppr_cnt_any if year < 2014
  5.     bys athr_id: egen pre_ppr_any_sum = total(pre_any)
  6.     bys athr_id: egen pre_ppr_any_avg = mean(pre_any)
  7.     keep if athr_indicator == 1
  8.     replace foia_athr = 0 if mi(foia_athr)
  9.     gen byte nih_matched = !mi(nih_pi_name)
 10.     rename (pre_ppr_cnt_sum pre_ppr_cnt_avg) (pre_ppr_sum pre_ppr_avg)
 11.     keep athr_id min_year lab_age_2014 foia_athr nih_matched ///
>          pre_ppr_sum pre_ppr_avg pre_ppr_any_sum pre_ppr_any_avg
 12.     save ../temp/pubs_pre_pis`suf', replace
 13. end

